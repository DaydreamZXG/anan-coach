    },
    {
      "id": "exact-cause-input-refs",
      "expected": ["exact_projection_ref", "exact_formula_id_and_latex_fingerprint", "no_dynamic_head_for_frozen_formula_refs"]
    },
    {
      "id": "historical-no-formula-ref",
      "expected": ["dynamic_current_formula_compatibility", "legacy_scratch_reasoning_alias"]
    },
    {
      "id": "unanchored-freehand",
      "expected": ["semantic_unknown", "no_ocr_claim", "no_automatic_medium_strength"]
    }
  ]
}
