# Explicit architecture mode. Keep canonical until the reviewed private deployment is ready.
WEKNORA_PRIVATE_KNOWLEDGE_MODE=canonical

# Required together when mode=weknora. Never commit the API key.
WEKNORA_BASE_URL=https://weknora.internal.example
# Three distinct keys are mandatory; do not use a full-access or shared key.
WEKNORA_MANAGE_API_KEY=
WEKNORA_INGEST_API_KEY=
WEKNORA_RETRIEVE_API_KEY=
WEKNORA_RELEASE_ID=
WEKNORA_HTTPS_HOST_ALLOWLIST=weknora.internal.example

WEKNORA_REQUEST_TIMEOUT_SECONDS=30
WEKNORA_SEARCH_BATCH_SIZE=500
REQUIRED_DATABASE_REVISION=20260721_50
