# Install as /etc/gongkao-dazi/worker-essay-review.env, owned by root:root
# with mode 0600. Every credential must be limited to the named immutable
# grading-plan release; do not expose these four provider keys to other workers.
AI_PROVIDER_BASE_URL=https://tokenrhythm.studio/v1
AI_API_KEY=
AI_ESSAY_PRIMARY_BASE_URL=https://REPLACE_WITH_APPROVED_PRIMARY_ESSAY_PROVIDER/v1
AI_ESSAY_PRIMARY_API_KEY=
AI_ESSAY_REVIEW_MODEL=gemini-3.5-flash
AI_ESSAY_RUBRIC_GENERATOR_MODEL=
AI_ESSAY_RUBRIC_CRITIC_MODEL=
AI_ESSAY_RUBRIC_PROVIDER_RELEASE_ID=
AI_ESSAY_RUBRIC_MAX_INPUT_BYTES=8388608
AI_ESSAY_RUBRIC_MAX_OUTPUT_BYTES=2097152
AI_ESSAY_REVIEW_PROVIDER_RELEASE_ID=
AI_ESSAY_REVIEW_PROVIDER_HTTPS_HOST_ALLOWLIST=
AI_ESSAY_REVIEW_PROVIDER_DPA_CONFIRMED=false
AI_ESSAY_REVIEW_PROVIDER_IDEMPOTENCY_CAPABILITY=
AI_ESSAY_REVIEW_PROVIDER_IDEMPOTENCY_KEY_HEADER=
AI_ESSAY_REVIEW_PROVIDER_REQUEST_ID_HEADER=
AI_ESSAY_REVIEW_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_ESSAY_REVIEW_MAX_INPUT_BYTES=8388608
AI_ESSAY_REVIEW_MAX_OUTPUT_BYTES=2097152

AI_ESSAY_TOKENRHYTHM_BASE_URL=https://tokenrhythm.studio/v1
AI_ESSAY_TOKENRHYTHM_API_KEY=
AI_ESSAY_TOKENRHYTHM_MODEL=deepseek-v4-flash
AI_ESSAY_TOKENRHYTHM_PROVIDER_RELEASE_ID=tokenrhythm-deepseek-v4-flash
AI_ESSAY_TOKENRHYTHM_PROVIDER_HTTPS_HOST_ALLOWLIST=tokenrhythm.studio
AI_ESSAY_TOKENRHYTHM_PROVIDER_DPA_CONFIRMED=false
AI_ESSAY_TOKENRHYTHM_PROVIDER_IDEMPOTENCY_CAPABILITY=nonreplayable_audited
AI_ESSAY_TOKENRHYTHM_PROVIDER_IDEMPOTENCY_KEY_HEADER=
AI_ESSAY_TOKENRHYTHM_PROVIDER_REQUEST_ID_HEADER=x-trace-id
AI_ESSAY_TOKENRHYTHM_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_ESSAY_TOKENRHYTHM_MAX_INPUT_BYTES=8388608
AI_ESSAY_TOKENRHYTHM_MAX_OUTPUT_BYTES=2097152

CLOUDBASE_ENV_ID=
CLOUDBASE_API_KEY=
CLOUDBASE_HUNYUAN_FUNCTION_NAME=hunyuan-essay-grader
CLOUDBASE_HUNYUAN_RELEASE_ID=
CLOUDBASE_HUNYUAN_MODEL=hunyuan-2.0-instruct-20251111
CLOUDBASE_HUNYUAN_MAX_INPUT_BYTES=196608
CLOUDBASE_HUNYUAN_MAX_OUTPUT_BYTES=262144

AI_ESSAY_ADJUDICATOR_BASE_URL=https://REPLACE_WITH_APPROVED_ADJUDICATOR/v1
AI_ESSAY_ADJUDICATOR_API_KEY=
AI_ESSAY_ADJUDICATOR_PROVIDER_RELEASE_ID=
AI_ESSAY_ADJUDICATOR_MODEL=
AI_ESSAY_ADJUDICATOR_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
AI_ESSAY_ADJUDICATOR_REQUEST_ID_HEADER=
AI_ESSAY_ADJUDICATOR_IDEMPOTENCY_CAPABILITY=
AI_ESSAY_ADJUDICATOR_MAX_INPUT_BYTES=8388608
AI_ESSAY_ADJUDICATOR_MAX_OUTPUT_BYTES=2097152

AI_ESSAY_GRADING_PLAN_RELEASE_ID=
AI_ESSAY_GRADING_PRICE_CARDS_JSON=
AI_ESSAY_CHECKPOINT_ACTIVE_KEY_ID=
AI_ESSAY_CHECKPOINT_KEYS_JSON=
AI_ESSAY_CHECKPOINT_TTL_SECONDS=
ESSAY_REVIEW_WORKER_ENABLED=false
ESSAY_REVIEW_WORKER_POLL_SECONDS=1
ESSAY_REVIEW_WORKER_STALE_RECOVERY_SECONDS=60
