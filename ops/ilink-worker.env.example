# Worker-only external recognition settings. Keep this file out of the API
# service so enabling photo recognition cannot change API readiness.
# Inject production values through the root-owned secret configuration.
RECOGNITION_PROCESSOR_ENABLED=false
RECOGNITION_PROCESSOR_ENDPOINT=
RECOGNITION_PROCESSOR_TOKEN=
RECOGNITION_PROCESSOR_RELEASE_ID=
RECOGNITION_PROCESSOR_ADAPTER=grok_vision_chat_completions
RECOGNITION_PROCESSOR_MODEL=
RECOGNITION_PROCESSOR_ACTUAL_MODEL=
RECOGNITION_PROCESSOR_MAX_INPUT_BYTES=10485760
RECOGNITION_PROCESSOR_MAX_OUTPUT_BYTES=4194304
RECOGNITION_PROCESSOR_MAX_PAGES=1
RECOGNITION_PROCESSOR_HTTPS_HOST_ALLOWLIST=
RECOGNITION_PROCESSOR_APPROVALS_JSON='[]'
