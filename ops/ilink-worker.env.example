# Install as /etc/gongkao-dazi/ilink-worker.env, owned by root:root with mode
# 0600. Keep this worker-only file out of the API service. Use independent,
# least-privilege object-storage and provider credentials.
TOS_BUCKET=gongkao-dazi-prod
TOS_REGION=cn-guangzhou
TOS_ENDPOINT=https://tos-cn-guangzhou.ivolces.com
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

RECOGNITION_PROCESSOR_ENABLED=false
RECOGNITION_PROCESSOR_ENDPOINT=
RECOGNITION_PROCESSOR_TOKEN=
RECOGNITION_PROCESSOR_RELEASE_ID=
RECOGNITION_PROCESSOR_ADAPTER=mineru_ocr
RECOGNITION_PROCESSOR_MODEL=MinerU-VLM
RECOGNITION_PROCESSOR_ACTUAL_MODEL=MinerU-VLM
RECOGNITION_PROCESSOR_MAX_INPUT_BYTES=10485760
RECOGNITION_PROCESSOR_MAX_OUTPUT_BYTES=4194304
RECOGNITION_PROCESSOR_MAX_PAGES=1
RECOGNITION_PROCESSOR_HTTPS_HOST_ALLOWLIST=
RECOGNITION_PROCESSOR_APPROVALS_JSON='[]'

MATCHING_POLICY_VERSION=external-hybrid-match-v1
MATCHING_SIMILAR_THRESHOLD=0.86
MATCHING_AMBIGUITY_MARGIN=0.03
MATCHING_TEXT_WEIGHT=0.75
MATCHING_VISUAL_WEIGHT=0.25
MATCHING_ESSAY_MIN_PROMPT_CHARS=30
MATCHING_ESSAY_REQUIRE_MATERIAL=true
MATCHING_MAXIMUM_CANDIDATES=8
MATCHING_SQL_PREFILTER_THRESHOLD=0.20
MATCHING_SQL_PREFETCH_FACTOR=5
MATCHING_SQL_MAXIMUM_PREFETCH=100

# Primary answer provider. Unmatched questions fail closed unless this and the
# independent secondary provider in ilink-channel.env are both approved.
AI_PROVIDER_BASE_URL=https://REPLACE_WITH_APPROVED_ILINK_PRIMARY_PROVIDER/v1
AI_API_KEY=
AI_HIGH_CAPABILITY_MODEL=
AI_COMPANION_TRANSPORT=openai_compatible
AI_COMPANION_PROVIDER_RELEASE_ID=
AI_COMPANION_PROVIDER_HTTPS_HOST_ALLOWLIST=
AI_COMPANION_PROVIDER_DPA_CONFIRMED=false
AI_COMPANION_PROVIDER_IDEMPOTENCY_CAPABILITY=
AI_COMPANION_PROVIDER_IDEMPOTENCY_KEY_HEADER=
AI_COMPANION_PROVIDER_REQUEST_ID_HEADER=
AI_COMPANION_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_COMPANION_MAX_INPUT_BYTES=1048576
AI_COMPANION_MAX_OUTPUT_BYTES=262144
