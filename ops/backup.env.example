# Copy to /etc/gongkao-dazi/backup.env with mode 0600.
# This example contains no usable secret and must never be activated as-is.
BACKUP_ENABLED=true
BACKUP_DATABASE_URL=postgresql://gongkao@127.0.0.1:5432/gongkao
# gongkao-backup owns this exact mode-0600 file. Other PG* variables are forbidden.
PGPASSFILE=/etc/gongkao-dazi/secrets/backup.pgpass
BACKUP_DIRECTORY=/var/backups/gongkao-dazi/encrypted
AGE_RECIPIENT=age1REPLACE_WITH_CROSS_DOMAIN_RECIPIENT
BACKUP_SIGNING_PRIVATE_KEY_FILE=/etc/gongkao-dazi/secrets/backup-signing.pem
BACKUP_SOURCE_ENVIRONMENT_ID=REPLACE_WITH_UNIQUE_SOURCE_ENVIRONMENT
# Root-owned, non-symlink, exact mode-0444 JSON. It binds targetId,
# source machine/environment, canonical backup directory, and the live Linux
# mount point/device/filesystem/mount-source digest. BACKUP_TARGET_ID is forbidden.
BACKUP_TARGET_AUTHORITY_FILE=/etc/gongkao-dazi/backup-target-authority.json
REQUIRED_DATABASE_REVISION=20260730_88
# Observation/alert threshold only. backup.sh never deletes published history.
BACKUP_RETENTION_DAYS=30
BACKUP_METRICS_FILE=/var/lib/gongkao-backup/metrics/anan-backup.prom

# Restore rehearsal variables belong on the isolated restore host only.
AGE_IDENTITY_FILE=/etc/gongkao-dazi/secrets/backup-age-identity.txt
BACKUP_SIGNING_PUBLIC_KEY_FILE=/etc/gongkao-dazi/backup-signing-public.pem
RESTORE_REPORT_SIGNING_PRIVATE_KEY_FILE=/etc/gongkao-dazi/secrets/restore-report-signing.pem
RESTORE_TARGET_ENVIRONMENT_ID=REPLACE_WITH_ISOLATED_RESTORE_ENVIRONMENT
# Root-owned, non-group/world-writable JSON binding purpose, environment,
# /etc/machine-id digest, database name, and PostgreSQL system-identifier digest.
RESTORE_TARGET_IDENTITY_FILE=/etc/gongkao-dazi/restore-target-authority.json
RESTORE_REPORT_DIRECTORY=/var/lib/gongkao-dazi/restore-reports
RESTORE_METRICS_FILE=/var/lib/node_exporter/textfile_collector/anan-restore.prom
