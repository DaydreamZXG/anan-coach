# Install as /etc/gongkao-dazi/worker-heartbeat-coach-notification.env.
# Required ownership/mode: root:root 0600.
WORKER_HEARTBEAT_DATABASE_URL=postgresql+psycopg://gongkao_worker_heartbeat_coach_notification_login:REPLACE_WITH_COACH_NOTIFICATION_HEARTBEAT_SECRET@127.0.0.1:5432/gongkao_dazi?sslmode=verify-full&sslrootcert=/etc/gongkao-dazi/db-ca.pem
