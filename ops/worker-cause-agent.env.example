# Install as /etc/gongkao-dazi/worker-cause-agent.env, owned by root:root
# with mode 0600. The API key must be scoped to this approved cause-analysis
# release and must not be reused by a sibling worker.
COMMERCIAL_MODE=free_cold_start
USAGE_ACCESS_MODE=unlimited
AI_PROVIDER_BASE_URL=https://REPLACE_WITH_APPROVED_CAUSE_PROVIDER/v1
AI_API_KEY=
AI_XINGCE_CAUSE_MODEL=
AI_XINGCE_CAUSE_PROVIDER_RELEASE_ID=
AI_XINGCE_CAUSE_PROVIDER_HTTPS_HOST_ALLOWLIST=
AI_XINGCE_CAUSE_PROVIDER_DPA_CONFIRMED=false
AI_XINGCE_CAUSE_PROVIDER_IDEMPOTENCY_CAPABILITY=
AI_XINGCE_CAUSE_PROVIDER_IDEMPOTENCY_KEY_HEADER=
AI_XINGCE_CAUSE_PROVIDER_REQUEST_ID_HEADER=
AI_XINGCE_CAUSE_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_XINGCE_CAUSE_MAX_INPUT_BYTES=1048576
AI_XINGCE_CAUSE_MAX_OUTPUT_BYTES=262144
AI_PRICE_VERSION=
AI_INPUT_CNY_PER_MILLION_TOKENS=
AI_CACHED_INPUT_CNY_PER_MILLION_TOKENS=
AI_OUTPUT_CNY_PER_MILLION_TOKENS=
