# Install as /etc/gongkao-dazi/worker-cause-agent.env, owned by root:root
# with mode 0600. The API key must be scoped to this approved cause-analysis
# release and must not be reused by a sibling worker.
COMMERCIAL_MODE=free_cold_start
USAGE_ACCESS_MODE=unlimited
AI_PROVIDER_BASE_URL=https://tokenrhythm.studio/v1
AI_API_KEY=
AI_XINGCE_CAUSE_MODEL=deepseek-v4-pro
AI_XINGCE_CAUSE_PROVIDER_RELEASE_ID=tokenrhythm-deepseek-v4-pro
AI_XINGCE_CAUSE_PROVIDER_HTTPS_HOST_ALLOWLIST=tokenrhythm.studio
AI_XINGCE_CAUSE_PROVIDER_DPA_CONFIRMED=false
AI_XINGCE_CAUSE_PROVIDER_IDEMPOTENCY_CAPABILITY=nonreplayable_audited
AI_XINGCE_CAUSE_PROVIDER_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
AI_XINGCE_CAUSE_PROVIDER_REQUEST_ID_HEADER=body:id
AI_XINGCE_CAUSE_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_XINGCE_CAUSE_MAX_INPUT_BYTES=1048576
AI_XINGCE_CAUSE_MAX_OUTPUT_BYTES=262144
AI_XINGCE_CAUSE_TIMEOUT_SECONDS=30
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_BASE_URL=https://api.deepseek.com
AI_XINGCE_CAUSE_DEEPSEEK_API_KEY=
AI_XINGCE_CAUSE_DEEPSEEK_MODEL=deepseek-v4-pro
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_RELEASE_ID=deepseek-official-v4-pro
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_HTTPS_HOST_ALLOWLIST=api.deepseek.com
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_IDEMPOTENCY_CAPABILITY=nonreplayable_audited
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_REQUEST_ID_HEADER=body:id
AI_XINGCE_CAUSE_DEEPSEEK_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_XINGCE_CAUSE_DEEPSEEK_TIMEOUT_SECONDS=45
AI_XINGCE_CAUSE_RELAY_PROVIDER_BASE_URL=https://ergouapi.co/v1
AI_XINGCE_CAUSE_RELAY_API_KEY=
AI_XINGCE_CAUSE_RELAY_MODEL=deepseek-v4-flash-free
AI_XINGCE_CAUSE_RELAY_PROVIDER_RELEASE_ID=ergouapi-deepseek-v4-flash-free
AI_XINGCE_CAUSE_RELAY_PROVIDER_HTTPS_HOST_ALLOWLIST=ergouapi.co
AI_XINGCE_CAUSE_RELAY_PROVIDER_IDEMPOTENCY_CAPABILITY=nonreplayable_audited
AI_XINGCE_CAUSE_RELAY_PROVIDER_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
AI_XINGCE_CAUSE_RELAY_PROVIDER_REQUEST_ID_HEADER=body:id
AI_XINGCE_CAUSE_RELAY_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_XINGCE_CAUSE_RELAY_TIMEOUT_SECONDS=45
AI_PRICE_VERSION=
AI_INPUT_CNY_PER_MILLION_TOKENS=
AI_CACHED_INPUT_CNY_PER_MILLION_TOKENS=
AI_OUTPUT_CNY_PER_MILLION_TOKENS=
