WECHAT_MINI_APP_ID=wx42824c7f7bfbf4b2
WECHAT_API_BASE_URL=https://api.weixin.qq.com
# Exact published subscription-message release. Do not use a placeholder template ID.
COACH_NOTIFICATIONS_ENABLED=false
# WECHAT_COACH_TEMPLATE_RELEASE_JSON={"releaseId":"...","templateId":"...","fields":{"title":"thing1","reminderTime":"time2","action":"thing3"}}
WECHAT_COACH_MINIPROGRAM_STATE=formal
COACH_NOTIFICATION_WORKER_POLL_SECONDS=2
COACH_NOTIFICATION_EVALUATION_INTERVAL_SECONDS=1800
COACH_NOTIFICATION_EVALUATION_BATCH_SIZE=100
COACH_NOTIFICATION_STALE_CLAIM_SECONDS=300
WECHAT_VIRTUAL_PAY_ENV=0
WECHAT_PAY_ORDER_EXPIRY_SECONDS=1800
PRIVACY_EXPORT_EXPIRY_SECONDS=86400
# Database backup stays off until every value below is set from real production
# evidence and one signed restore report has been archived outside the DB host.
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=
BACKUP_SOURCE_ENVIRONMENT_ID=
BACKUP_TARGET_AUTHORITY_FILE=
# libpq URL only; omit the password and supply it through a mode-0600 PGPASSFILE.
BACKUP_DATABASE_URL=
BACKUP_DIRECTORY=
AGE_RECIPIENT=
BACKUP_SIGNING_PRIVATE_KEY_FILE=
RESTORE_TARGET_ENVIRONMENT_ID=
RESTORE_TARGET_IDENTITY_FILE=
RESTORE_REPORT_DIRECTORY=
AGE_IDENTITY_FILE=
BACKUP_SIGNING_PUBLIC_KEY_FILE=
RESTORE_REPORT_SIGNING_PRIVATE_KEY_FILE=
