MYSCRIPT_HTTPS_HOST_ALLOWLIST=cloud.myscript.com
MYSCRIPT_PROVIDER_RELEASE_ID=
MYSCRIPT_MODEL_RELEASE=iink-math-v4.4
MYSCRIPT_PRICE_VERSION=
MYSCRIPT_UNIT_PRICE_CNY=
MYSCRIPT_DEPLOYMENT_ID=
# Xfyun vector-to-image formula recognition remains unavailable until these
# non-secret release, measured price and evaluated deployment facts are set.
XFYUN_FORMULA_PROVIDER_RELEASE_ID=
XFYUN_FORMULA_PRICE_VERSION=
XFYUN_FORMULA_UNIT_PRICE_CNY=
XFYUN_FORMULA_DEPLOYMENT_ID=
# Compatibility assertion for backup/release tooling. API and worker readiness
# derive this value from the artifact's single Alembic head.
REQUIRED_DATABASE_REVISION=20260817_115
# Knowledge-map publication is an activation prerequisite. These three values
# identify one immutable publication attempt and must be set for every release;
# activation does not synthesize a version or freshness window.
GONGKAO_KNOWLEDGE_MAP_RELEASE_VERSION=
GONGKAO_KNOWLEDGE_MAP_SOURCE_DATA_VERSION=
GONGKAO_KNOWLEDGE_MAP_FRESH_UNTIL=
# The commercial data publisher derives the psql URL from
# MIGRATION_DATABASE_URL and rejects a second database authority.

# WeKnora is a private, derived retrieval projection. Activation requires a
# reviewed private HTTPS deployment and three distinct capability-scoped keys.
WEKNORA_PRIVATE_KNOWLEDGE_MODE=canonical
GONGKAO_POSITION_RELEASE_EXAM_YEAR=2026
GONGKAO_POSITION_RULE_SET_VERSION=replace-with-audited-rule-version
GONGKAO_POSITION_DATA_VERSION=replace-with-audited-position-data-version
GONGKAO_POSITION_RELEASE_WINDOW_MANIFEST=/etc/gongkao-dazi/position-release-windows.json
WEKNORA_BASE_URL=
WEKNORA_MANAGE_API_KEY=
WEKNORA_INGEST_API_KEY=
WEKNORA_RETRIEVE_API_KEY=
WEKNORA_RELEASE_ID=
WEKNORA_HTTPS_HOST_ALLOWLIST=
WEKNORA_REQUEST_TIMEOUT_SECONDS=30
WEKNORA_SEARCH_BATCH_SIZE=500
# Daily opening stays unavailable until each provider's external evidence is complete.
WEATHERKIT_ENABLED=false
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_PRIVATE_KEY_PATH=
WEATHERKIT_BASE_URL=https://weatherkit.apple.com
WEATHERKIT_LANGUAGE=zh-Hans
LUCKIN_MCP_ENABLED=false
LUCKIN_MCP_ENDPOINT=https://gwmcp.lkcoffee.com/order/user/mcp
LUCKIN_TOKEN_KEY_ID=
LUCKIN_TOKEN_ENCRYPTION_KEY=
SUPPORT_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
SUPPORT_JWT_ISSUER=https://identity.example.com/
SUPPORT_JWT_AUDIENCE=gongkao-dazi-support

# Secrets are intentionally omitted:
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=
# UPLOAD_SCANNER_API_KEY=
# RECOGNITION_PROCESSOR_TOKEN=
# XFYUN_API_KEY=
# XFYUN_API_SECRET=
# MYSCRIPT_APPLICATION_KEY=
# MYSCRIPT_HMAC_KEY=
# PACKET_RENDERER_API_KEY=
# AI_API_KEY=
# AI_ESSAY_TOKENRHYTHM_API_KEY=
# AI_ESSAY_ADJUDICATOR_API_KEY=
# CLOUDBASE_API_KEY=
# WECHAT_MINI_APP_SECRET=
# WECHAT_VIRTUAL_PAY_OFFER_ID=
# WECHAT_VIRTUAL_PAY_APP_KEY=
# WECHAT_VIRTUAL_PAY_MESSAGE_TOKEN=
# WECHAT_VIRTUAL_PAY_MESSAGE_ENCODING_AES_KEY=
# OPERATIONS_METRICS_TOKEN=
# WEATHERKIT private key material is file-mounted and never stored in this file.
# LUCKIN_TOKEN_ENCRYPTION_KEY= base64url-encoded 32-byte AES key.
# SQLAlchemy URL for the API runtime, for example:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/gongkao_dazi
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=12
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=120000
# Migration runs under a schema-owning account, separate from the API role.
# Explicit, passwordless libpq URL. Host, port, database and user are mandatory;
# keep the password only in the migration OS user's mode-0600 pgpass file.
MIGRATION_DATABASE_URL=postgresql+psycopg://gongkao_migrator@127.0.0.1:5432/gongkao_dazi?sslmode=verify-full&sslrootcert=/etc/gongkao-dazi/db-ca.pem
MIGRATION_DATABASE_OS_USER=postgres
MIGRATION_PGPASSFILE=/etc/gongkao-dazi/migration.pgpass
