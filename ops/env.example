APP_ENV=production
API_BASE_URL=https://kg.xingguoxian.cn
TOS_BUCKET=gongkao-dazi-prod
TOS_REGION=cn-guangzhou
AI_PROVIDER_BASE_URL=https://ai-provider.example.com/v1
AI_MODEL=gemini-3.5-flash
# These settings only validate the provider contract; they do not constitute a
# production release approval. Paid Companion routes must remain unexposed until
# provider-status lookup, scheduled reconciliation, an audited operator state
# transition, and timeout-through-expiry drills exist. The NullPool checkpoint
# also requires a reviewed DB connection budget and enforced API concurrency
# limit; see backend/README.md. A header name alone is not sufficient approval.
AI_COMPANION_PROVIDER_RELEASE_ID=companion-contract-2026-07-13
AI_COMPANION_PROVIDER_HTTPS_HOST_ALLOWLIST=ai-provider.example.com
AI_COMPANION_PROVIDER_DPA_CONFIRMED=false
AI_COMPANION_PROVIDER_IDEMPOTENCY_CAPABILITY=replayable_queryable
AI_COMPANION_PROVIDER_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
AI_COMPANION_PROVIDER_REQUEST_ID_HEADER=X-Request-Id
# Verified minimum same-key replay/status-lookup retention (at least 7 days).
AI_COMPANION_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_COMPANION_MAX_INPUT_BYTES=0
AI_COMPANION_MAX_OUTPUT_BYTES=0
AI_ESSAY_REVIEW_MODEL=gemini-3.5-flash
AI_ESSAY_RUBRIC_GENERATOR_MODEL=provider-rubric-generator-model
AI_ESSAY_RUBRIC_CRITIC_MODEL=provider-rubric-critic-model
AI_ESSAY_RUBRIC_PROVIDER_RELEASE_ID=rubric-contract-2026-07-13
AI_ESSAY_RUBRIC_MAX_INPUT_BYTES=0
AI_ESSAY_RUBRIC_MAX_OUTPUT_BYTES=0
AI_ESSAY_REVIEW_PROVIDER_RELEASE_ID=provider-contract-2026-07-13
AI_ESSAY_REVIEW_PROVIDER_HTTPS_HOST_ALLOWLIST=ai-provider.example.com
# Set true only after the production provider/data-processing agreement is approved.
AI_ESSAY_REVIEW_PROVIDER_DPA_CONFIRMED=false
# Set only for a provider release whose same-key replay and status lookup were verified.
AI_ESSAY_REVIEW_PROVIDER_IDEMPOTENCY_CAPABILITY=replayable_queryable
AI_ESSAY_REVIEW_PROVIDER_IDEMPOTENCY_KEY_HEADER=Idempotency-Key
AI_ESSAY_REVIEW_PROVIDER_REQUEST_ID_HEADER=X-Request-Id
AI_ESSAY_REVIEW_MAX_INPUT_BYTES=0
AI_ESSAY_REVIEW_MAX_OUTPUT_BYTES=0
# Fail-closed placeholders: replace with the approved provider price card.
AI_PRICE_VERSION=provider-price-version
AI_INPUT_CNY_PER_MILLION_TOKENS=0
AI_CACHED_INPUT_CNY_PER_MILLION_TOKENS=0
AI_OUTPUT_CNY_PER_MILLION_TOKENS=0
WECHAT_MINI_APP_ID=wxa02a883c1807927b
WECHAT_API_BASE_URL=https://api.weixin.qq.com

# Secrets are intentionally omitted:
# TOS_ACCESS_KEY_ID=
# TOS_SECRET_ACCESS_KEY=
# AI_API_KEY=
# WECHAT_MINI_APP_SECRET=
# SQLAlchemy URL for the API runtime, for example:
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/gongkao_dazi
