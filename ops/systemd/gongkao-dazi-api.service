[Unit]
Description=Gongkao Dazi API
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/gongkao-dazi/backend
EnvironmentFile=/etc/gongkao-dazi/api.env
EnvironmentFile=/etc/gongkao-dazi/db.env
ExecStart=/srv/gongkao-dazi/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
