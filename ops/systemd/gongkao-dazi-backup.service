[Unit]
Description=Gongkao Dazi encrypted database backup
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
EnvironmentFile=/etc/gongkao-dazi/db.env
EnvironmentFile=/etc/gongkao-dazi/backup.env
ExecStart=/srv/gongkao-dazi/current/ops/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
