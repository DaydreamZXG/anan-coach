[Unit]
Description=Gongkao Dazi encrypted database backup
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=gongkao-backup
Group=gongkao-backup
EnvironmentFile=/etc/gongkao-dazi/backup.env
ExecStart=/srv/gongkao-dazi/current/ops/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=/etc/gongkao-dazi/backup-target-authority.json
ReadOnlyPaths=/etc/gongkao-dazi/secrets/backup.pgpass
ReadOnlyPaths=/etc/gongkao-dazi/secrets/backup-signing.pem
ReadWritePaths=/var/backups/gongkao-dazi/encrypted
ReadWritePaths=/var/lib/gongkao-backup/metrics
InaccessiblePaths=-/etc/gongkao-dazi/api.env
InaccessiblePaths=-/etc/gongkao-dazi/db.env
