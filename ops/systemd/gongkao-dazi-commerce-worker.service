[Unit]
Description=Gongkao Dazi WeChat commerce reconciliation worker
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/gongkao-dazi/current/backend
EnvironmentFile=/etc/gongkao-dazi/api.env
EnvironmentFile=/etc/gongkao-dazi/db.env
EnvironmentFile=/etc/gongkao-dazi/release-runtime.env
ExecStart=/srv/gongkao-dazi/current/backend/.venv/bin/python -m app.workers.commerce
Restart=always
RestartSec=3
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
