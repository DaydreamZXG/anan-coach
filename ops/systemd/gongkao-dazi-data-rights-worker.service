[Unit]
Description=Gongkao Dazi Data Rights Worker
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/gongkao-dazi/current/backend
EnvironmentFile=/etc/gongkao-dazi/api.env
EnvironmentFile=/etc/gongkao-dazi/db.env
ExecStart=/srv/gongkao-dazi/current/backend/.venv/bin/python -m app.workers.data_rights
Restart=always
RestartSec=3
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
