[Unit]
Description=Gongkao Dazi Data Rights Worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=gongkao-wkr-data
Group=gongkao-wkr-data
WorkingDirectory=/srv/gongkao-dazi/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/gongkao-dazi/worker-data-rights.env
EnvironmentFile=/etc/gongkao-dazi/db.env
EnvironmentFile=/etc/gongkao-dazi/worker-heartbeat-data-rights.env
EnvironmentFile=/etc/gongkao-dazi/release-runtime.env
ExecStart=/srv/gongkao-dazi/current/backend/.venv/bin/python -m app.workers.data_rights
Restart=always
RestartSec=3
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
