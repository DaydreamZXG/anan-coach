# Install as /etc/gongkao-dazi/worker-ilink-object-deletion.env, owned by
# root:root with mode 0600. This worker only deletes expired private objects;
# it has no WeChat bot token, model credential, OCR credential, or reply path.
TOS_BUCKET=gongkao-dazi-prod
TOS_REGION=cn-guangzhou
TOS_ENDPOINT=https://tos-cn-guangzhou.ivolces.com
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
PRIVATE_OBJECT_TRANSIENT_RETENTION_SECONDS=900
PRIVATE_QUERY_RETENTION_DAYS=30
