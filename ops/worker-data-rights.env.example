# Install as /etc/gongkao-dazi/worker-data-rights.env, owned by root:root
# with mode 0600. Use a TOS IAM key restricted to the private learner-object
# prefixes needed for export/deletion; do not reuse an API or sibling-worker key.
PRIVACY_EXPORT_EXPIRY_SECONDS=86400
TOS_BUCKET=gongkao-dazi-prod
TOS_REGION=cn-guangzhou
TOS_ENDPOINT=https://tos-cn-guangzhou.ivolces.com
TOS_PRESIGN_ENDPOINT=https://tos-cn-guangzhou.volces.com
TOS_QUARANTINE_PREFIX=private/quarantine/external-learning
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
