# Install as /etc/gongkao-dazi/worker-external-learning.env, owned by
# root:root with mode 0600. Provision distinct least-privilege credentials for
# object storage, malware scanning, rendering, AI answering and private
# knowledge; never copy the API's complete environment into this file.
COMMERCIAL_MODE=free_cold_start
USAGE_ACCESS_MODE=unlimited

TOS_BUCKET=gongkao-dazi-prod
TOS_REGION=cn-guangzhou
TOS_ENDPOINT=https://tos-cn-guangzhou.ivolces.com
TOS_PRESIGN_ENDPOINT=https://tos-cn-guangzhou.volces.com
TOS_QUARANTINE_PREFIX=private/quarantine/external-learning
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

UPLOAD_QUOTA_POLICY_VERSION=external-upload-quota-v1
UPLOAD_MAXIMUM_PENDING_BYTES_PER_USER=524288000
UPLOAD_MAXIMUM_STORED_BYTES_PER_USER=5368709120
UPLOAD_SCANNER_BASE_URL=https://REPLACE_WITH_APPROVED_SCANNER
UPLOAD_SCANNER_API_KEY=
UPLOAD_SCANNER_RELEASE_ID=
UPLOAD_SCANNER_HTTPS_HOST_ALLOWLIST=
UPLOAD_SCANNER_ROUTE=mainland-private-object-v1
UPLOAD_SCANNER_POLICY_VERSION=
UPLOAD_SCANNER_DPA_VERSION=
UPLOAD_SCANNER_MAINLAND_ONLY=true
UPLOAD_SCANNER_MAXIMUM_DEFINITION_AGE_SECONDS=86400

PACKET_RENDERER_BASE_URL=https://REPLACE_WITH_APPROVED_PACKET_RENDERER
PACKET_RENDERER_API_KEY=
PACKET_RENDERER_RELEASE_ID=
PACKET_RENDERER_HTTPS_HOST_ALLOWLIST=
PACKET_RENDERER_DPA_CONFIRMED=false
PACKET_RENDERER_IDEMPOTENCY_HEADER=Idempotency-Key
PACKET_RENDERER_REQUEST_ID_HEADER=X-Request-Id
PACKET_ACCESS_TTL_SECONDS=300

EXTERNAL_LEARNING_WORKER_POLL_SECONDS=1
EXTERNAL_LEARNING_MAINTENANCE_INTERVAL_SECONDS=30
EXTERNAL_LEARNING_UPLOAD_RECOVERY_AGE_SECONDS=60
EXTERNAL_LEARNING_STALE_CLAIM_SECONDS=900
EXTERNAL_LEARNING_MAINTENANCE_BATCH_SIZE=100
RECOGNITION_OPERATION_RECONCILIATION_AGE_SECONDS=900
RECOGNITION_OPERATION_RECONCILIATION_BATCH_SIZE=100

# Xfyun formula recognition used while enriching OCR output.
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

AI_PROVIDER_BASE_URL=https://REPLACE_WITH_APPROVED_ANSWER_PROVIDER/v1
AI_API_KEY=
AI_HIGH_CAPABILITY_MODEL=
AI_COMPANION_TRANSPORT=openai_compatible
AI_COMPANION_PROVIDER_RELEASE_ID=
AI_COMPANION_PROVIDER_HTTPS_HOST_ALLOWLIST=
AI_COMPANION_PROVIDER_DPA_CONFIRMED=false
AI_COMPANION_PROVIDER_IDEMPOTENCY_CAPABILITY=
AI_COMPANION_PROVIDER_IDEMPOTENCY_KEY_HEADER=
AI_COMPANION_PROVIDER_REQUEST_ID_HEADER=
AI_COMPANION_PROVIDER_REPLAY_RETENTION_SECONDS=0
AI_COMPANION_MAX_INPUT_BYTES=1048576
AI_COMPANION_MAX_OUTPUT_BYTES=262144
AI_PRICE_VERSION=
AI_INPUT_CNY_PER_MILLION_TOKENS=
AI_CACHED_INPUT_CNY_PER_MILLION_TOKENS=
AI_OUTPUT_CNY_PER_MILLION_TOKENS=

WEKNORA_PRIVATE_KNOWLEDGE_MODE=canonical
WEKNORA_BASE_URL=
WEKNORA_MANAGE_API_KEY=
WEKNORA_INGEST_API_KEY=
WEKNORA_RETRIEVE_API_KEY=
WEKNORA_RELEASE_ID=
WEKNORA_HTTPS_HOST_ALLOWLIST=
WEKNORA_REQUEST_TIMEOUT_SECONDS=30
WEKNORA_SEARCH_BATCH_SIZE=500
