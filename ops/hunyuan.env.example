# CloudBase Hunyuan transport. Secrets are intentionally omitted.
# This release permits formal essay candidate scoring through the server-owned contract.
CLOUDBASE_ENV_ID=replace-with-cloudbase-environment-id
CLOUDBASE_HUNYUAN_FUNCTION_NAME=hunyuan-essay-grader
CLOUDBASE_HUNYUAN_RELEASE_ID=hunyuan-cloud-function-2026-07-18.1
CLOUDBASE_HUNYUAN_MODEL=hunyuan-2.0-instruct-20251111
CLOUDBASE_HUNYUAN_MAX_INPUT_BYTES=196608
CLOUDBASE_HUNYUAN_MAX_OUTPUT_BYTES=262144

# 岸岸问答临时使用混元。以后切回 Gemini 只需将
# AI_COMPANION_TRANSPORT 改回 openai_compatible。
AI_COMPANION_TRANSPORT=cloudbase_hunyuan
CLOUDBASE_HUNYUAN_COMPANION_FUNCTION_NAME=hunyuan-essay-grader
CLOUDBASE_HUNYUAN_COMPANION_RELEASE_ID=hunyuan-cloud-function-companion-2026-07-28.1
CLOUDBASE_HUNYUAN_COMPANION_MODEL=hunyuan-2.0-instruct-20251111
CLOUDBASE_HUNYUAN_COMPANION_MAX_INPUT_BYTES=196608
CLOUDBASE_HUNYUAN_COMPANION_MAX_OUTPUT_BYTES=262144

# Secret:
# CLOUDBASE_API_KEY=
# CLOUDBASE_COMPANION_API_KEY=  # optional; defaults to CLOUDBASE_API_KEY
