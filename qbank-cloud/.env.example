QBANK_DATABASE_PATH=./qbank-cloud.sqlite3
QBANK_CATALOG_MODE=demo
QBANK_API_KEY_SECRET=replace-with-at-least-32-random-characters
QBANK_RATE_LIMIT_PER_MINUTE=60

# Live payment stays disabled unless every value below is supplied and a live
# WeChat gateway implementation is selected by the deployer.
SKILLHUB_DEVELOPER_ID=sh-replace-me
SKILLHUB_PUBLIC_KEY_ID=replace-me
SKILLHUB_PRIVATE_KEY_PATH=/run/secrets/skillhub-rsa-private.pem
