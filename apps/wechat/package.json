{
  "name": "@gongkao/wechat-mini-program",
  "version": "0.1.0",
  "private": true,
  "description": "AI 国考上岸教练微信小程序",
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run tokens:validate && npm run interactions:validate && npm run controls:validate && npm run design:validate && npm run navigation:validate && npm run structure:validate && npm run visual:validate && npm run interaction-coverage:validate && npm run package:validate && npm run api:check && npm run test:node && npm run test && npm run test:cloud",
    "api:check": "node scripts/generate-api.mjs --check",
    "api:generate": "node scripts/generate-api.mjs",
    "controls:validate": "node scripts/validate-control-alignment.mjs",
    "design:validate": "node scripts/validate-design-source.mjs",
    "format": "prettier --write \"**/*.{ts,js,json,mjs,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,mjs,md,html,css}\"",
    "interaction-coverage:validate": "node scripts/validate-interaction-coverage.mjs",
    "interactions:validate": "node scripts/validate-interactions.mjs",
    "lint": "eslint . --max-warnings 0",
    "minitest:package": "python3 scripts/build-minium-cloud-case.py",
    "navigation:validate": "node scripts/validate-navigation.mjs",
    "package:validate": "node scripts/validate-package-boundaries.mjs && node scripts/analyze-package-runtime.mjs --check && node scripts/sync-subpackage-shared.mjs --check",
    "subpackage-shared:check": "node scripts/sync-subpackage-shared.mjs --check",
    "subpackage-shared:sync": "node scripts/sync-subpackage-shared.mjs",
    "structure:validate": "node scripts/validate-structure.mjs",
    "test": "vitest run",
    "test:cloud": "node --test cloudfunctions/hunyuan-essay-grader/runtime.test.js",
    "test:node": "node --test scripts/*.node-test.mjs",
    "tokens:validate": "node scripts/validate-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "visual:validate": "node scripts/validate-visual-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "10.7.0",
    "miniprogram-api-typings": "5.2.2",
    "miniprogram-automator": "0.12.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.17",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "jpeg-js": "0.4.4",
    "minimist": "1.2.8",
    "phin": "3.7.1"
  },
  "engines": {
    "node": ">=24"
  }
}
