<view class="ink-pad">
  <canvas
    id="mathInkCanvas"
    type="2d"
    class="ink-canvas"
    disable-scroll="true"
    bindtouchstart="startStroke"
    bindtouchmove="moveStroke"
    bindtouchend="endStroke"
    bindtouchcancel="endStroke"
  ></canvas>
  <view class="ink-actions">
    <button hover-class="item--hover" class="ink-clear" bindtap="clear">清空</button>
    <button hover-class="item--hover" class="ink-recognize" loading="{{recognizing}}" disabled="{{recognizing || !hasInk || !canvasReady}}" bindtap="recognize">识别公式</button>
  </view>
</view>
