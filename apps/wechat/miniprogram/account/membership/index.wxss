.membership-state-view {
  display: block;
  margin-top: calc(28 * var(--rpx));
}
.founder-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}
.founder-duration {
  margin-top: calc(16 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-title-lg);
  font-weight: 800;
}
.founder-price {
  color: var(--color-muted);
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.feature-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: calc(44 * var(--rpx));
  height: calc(44 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-weight: 800;
}
.policy-row {
  align-items: flex-start;
}
.policy-version {
  flex: 0 0 calc(120 * var(--rpx));
  overflow: hidden;
  color: var(--color-muted);
  font-size: var(--text-micro);
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.accept-row {
  display: flex;
  align-items: center;
  gap: calc(16 * var(--rpx));
  margin: calc(24 * var(--rpx)) calc(4 * var(--rpx)) 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
}
.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: calc(42 * var(--rpx));
  height: calc(42 * var(--rpx));
  border: calc(2 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-12);
  color: var(--color-surface);
}
.checkbox.checked {
  border-color: var(--color-primary);
  background: var(--color-primary);
}
.reward-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(16 * var(--rpx));
}
.reward-card {
  min-width: 0;
  padding: calc(28 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
}
.reward-value {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 800;
}
.reward-title {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-micro);
  font-weight: 800;
}
.reward-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.45;
}
.refund-button {
  margin-top: calc(24 * var(--rpx));
  padding: 0;
  background: transparent;
  color: var(--color-primary-deep);
  font-size: var(--text-caption);
  font-weight: 800;
  text-align: left;
}
.payment-disclosure {
  margin-top: calc(16 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.5;
}
