<view class="s9-page s9-page--with-dock membership-page">
  <view class="s9-hero">
    <view class="s9-title">{{freeColdStart ? '公测期免费使用' : '第一次付钱，也可以安心试'}}</view>
    <view class="s9-subtitle">{{freeColdStart ? '当前不需要开通会员，本页只说明公测和未来的收费方案，不会发起购买或扣款。' : (offer ? offer.subtitle : '服务期和退款规则，付款前都会给你看清楚。')}}</view>
    <view wx:if="{{!freeColdStart}}" class="s9-chip-row">
      <view class="s9-chip s9-chip--gold">创始体验官</view>
      <view class="s9-chip s9-chip--primary">{{offer ? offer.remainingLabel : '名额待确认'}}</view>
    </view>
    <view wx:else class="s9-chip-row">
      <view class="s9-chip s9-chip--primary">无需开通</view>
      <view class="s9-chip">公测中</view>
    </view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" custom-class="membership-state-view" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" custom-class="membership-state-view" state="error" title="会员信息没加载出来" description="{{errorMessage}}" request-id="{{requestId}}" action-text="再试一次" bind:action="retry" />

  <block wx:elif="{{freeColdStart}}">
    <view class="s9-stack">
      <view class="s9-card s9-card--primary founder-card">
        <view class="s9-card-kicker">当前服务状态</view>
        <view class="s9-card-title">不用开通会员</view>
        <view class="s9-card-copy">岗位、训练、申论批改、拍照搜题、报告和学习档案可以直接使用。</view>
        <view class="s9-card-meta">没有购买按钮 · 不会发起扣款</view>
      </view>

      <view class="s9-card guarantee-card">
        <view class="s9-card-kicker">创始用户权益方案</view>
        <view class="s9-card-title">正式价预计 ¥29.90 / 30 天</view>
        <view class="s9-card-copy">计划为公测期加入的用户保留 7 折创始价，即 ¥20.90 / 30 天。公测期内仍然是 0 元，不需要先买。</view>
        <view class="s9-card-meta">正式开放前，会再明示价格、权益期限和退款规则</view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">当前服务范围</view><view class="s9-section-meta">{{entitlementPeriod}}</view></view>
      <view class="s9-list">
        <view class="s9-list-row"><view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">当前是会员说明入口</view><view class="s9-list-copy">可以查看公测和收费方案，但不会创建订单；正式开放时必须由你再次确认。</view></view></view>
        <view class="s9-list-row"><view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">你的学习数据不会被会员影响</view><view class="s9-list-copy">作答、档案、计划、私人资料和导出属于你的学习数据。</view></view></view>
        <view class="s9-list-row"><view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">服务规则照常生效</view><view class="s9-list-copy">批量爬题、脚本刷题、恶意文件和账号共用，仍会被系统拦下来。</view></view></view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="s9-stack">
      <view class="s9-card s9-card--primary founder-card">
        <view class="s9-card-kicker">创始体验</view>
        <view class="founder-head">
          <view>
            <view class="s9-card-title">{{offer ? offer.title : '岸岸会员'}}</view>
            <view class="founder-duration type-data">{{offer ? offer.serviceDays + ' 天' : '天数待确认'}}</view>
          </view>
          <view wx:if="{{offer}}" class="founder-price type-data">{{offer.amountLabel}}</view>
        </view>
        <view class="s9-card-copy">买到的就是下面列的，没做好的功能不会写进来卖。</view>
        <view class="s9-card-meta">{{offer ? offer.remainingLabel : entitlementPeriod}} · 一次付费 · 不自动续费</view>
        <view class="payment-disclosure">{{paymentDisclosure}}</view>
      </view>

      <view class="s9-card guarantee-card">
        <view class="s9-card-kicker">保障规则</view>
        <view class="s9-card-title">{{refundPolicyTitle}}</view>
        <view class="s9-card-copy">{{refundPolicyLabel || '现在还没有明确的退款规则，暂时不开放付费。'}}</view>
        <view class="s9-card-meta">具体规则会在你付钱前完整展示，并一直留档</view>
      </view>
    </view>

    <view wx:if="{{offer}}" class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">你会得到什么</view><view class="s9-section-meta">当前是：{{entitlementLabel}}</view></view>
      <view class="s9-list">
        <view class="s9-list-row" wx:for="{{offer.featureHighlights}}" wx:key="*this">
          <view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">{{item}}</view></view>
        </view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">购买与退款规则</view><view class="s9-section-meta">以付款时确认为准</view></view>
      <view class="s9-list">
        <view class="s9-list-row policy-row" wx:for="{{policies}}" wx:key="policyVersion">
          <view class="s9-list-main"><view class="s9-list-title">{{item.title}}</view><view class="s9-list-copy">{{item.contentLabel}}</view></view>
          <view class="policy-version">付款前确认</view>
        </view>
      </view>
      <view hover-class="item--hover" wx:if="{{paymentEnabled}}" class="accept-row" bindtap="toggleAccepted"><view class="checkbox {{accepted ? 'checked' : ''}}">{{accepted ? '✓' : ''}}</view><view>我已看过并同意当前规则</view></view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">学习过程奖励</view><view class="s9-section-meta">不会读取你的成绩</view></view>
      <view class="reward-grid">
        <view class="reward-card"><view class="reward-value type-data">{{effectiveDays}}/{{effectiveDaysRequired || '—'}}</view><view class="reward-title">有效学习日</view><view class="reward-copy">达标后按开通时确认的规则发放</view></view>
        <view class="reward-card"><view class="reward-value type-data">{{weeklyReflections}}/{{weeklyReflectionsRequired || '—'}}</view><view class="reward-title">周复盘</view><view class="reward-copy">达标后按开通时确认的规则发放</view></view>
        <view class="reward-card"><view class="reward-value type-data">{{coreRatioLabel}}</view><view class="reward-title">核心任务</view><view class="reward-copy">按开通时确认的条件解锁</view></view>
      </view>
    </view>

    <view wx:if="{{dashboard.refundEligibility}}" class="s9-section">
      <view class="s9-card {{dashboard.refundEligibility.eligible ? 's9-card--primary' : ''}}">
        <view class="s9-card-kicker">退款状态</view>
        <view class="s9-card-title">现在能不能退款</view>
        <view class="s9-card-copy">按当时确认的规则算；已经返过的过程奖励，会计入退回的总金额。</view>
        <button hover-class="item--hover" wx:if="{{dashboard.refundEligibility.eligible}}" class="refund-button" loading="{{refunding}}" bindtap="requestRefund">申请退款</button>
        <view wx:else class="s9-card-meta">现在还退不了：{{refundBlockingLabel}}</view>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="s9-inline-error">{{errorMessage}}</view>

    <view wx:if="{{offer && paymentEnabled}}" class="s9-action-dock">
      <button hover-class="item--hover" class="s9-primary-button {{!accepted || offer.recruitmentState === 'paused' || offer.recruitmentState === 'sold_out' ? 's9-primary-button--disabled' : ''}}" loading="{{paying}}" disabled="{{!accepted || offer.recruitmentState === 'paused' || offer.recruitmentState === 'sold_out'}}" bindtap="buy">{{accepted ? '安全支付 ' + offer.amountLabel : '阅读并确认规则后购买'}}</button>
    </view>
  </block>
</view>
