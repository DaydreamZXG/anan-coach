.privacy-page {
  padding-bottom: calc(96 * var(--rpx));
}
.privacy-state-view {
  display: block;
  margin-top: calc(28 * var(--rpx));
}
.privacy-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(88 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 800;
}
.export-copy {
  margin-top: 0;
}
.export-state {
  margin-top: calc(20 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 700;
}
.danger-heading .s9-section-title,
.danger-heading .s9-section-meta {
  color: var(--color-danger);
}
.deletion-copy {
  display: flex;
  gap: calc(16 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.danger-dot {
  flex: 0 0 auto;
  width: calc(9 * var(--rpx));
  height: calc(9 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  border-radius: 50%;
  background: var(--color-danger);
}
.phrase-label {
  margin-top: calc(28 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.phrase-label__value {
  color: var(--color-danger);
  font-weight: 800;
}
.phrase-input {
  box-sizing: border-box;
  height: calc(88 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(213, 70, 79, 0.22);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  font-size: var(--text-caption);
}
.delete-button {
  margin-top: calc(24 * var(--rpx));
  padding: 0;
  background: transparent;
  color: var(--color-danger);
  font-size: var(--text-caption);
  font-weight: 800;
  text-align: left;
}
.delete-button--disabled {
  color: var(--color-faint);
}

/* 告别句：离开的人最后看到的一行字，安静、不挽留。 */
.deletion-farewell {
  margin-top: calc(24 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-caption);
  text-align: center;
}
