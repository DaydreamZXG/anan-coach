<view class="s9-page privacy-page">
  <view class="s9-hero">
    <view class="s9-title">你的学习数据，由你决定</view>
    <view class="s9-subtitle">资料只用于你的诊断、计划和反馈，用在哪里都能查得到。</view>
    <view class="s9-chip-row"><view class="s9-chip s9-chip--primary">可导出</view><view class="s9-chip">可删除</view></view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" custom-class="privacy-state-view" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" custom-class="privacy-state-view" state="error" title="数据清单没加载出来" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />

  <block wx:else>
    <view class="s9-stack">
      <view class="s9-card">
        <view class="s9-card-kicker">数据用途</view>
        <view class="s9-card-title">都用在你的学习上</view>
        <view class="s9-card-copy">讲义、笔记和模考卷只用于分析你的学习情况，不会公开。</view>
        <view class="s9-card-meta">上传前都会告诉你用途和保存多久</view>
      </view>
      <view class="s9-card s9-card--primary">
        <view class="s9-card-kicker">控制权</view>
        <view class="s9-card-title">看、导出、删除，都由你说了算</view>
        <view class="s9-card-copy">{{overview.rawMaterialRetention}}</view>
        <view class="s9-card-meta">删除账户前建议先导出个人数据</view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">我的数据清单</view><view class="s9-section-meta">实时更新</view></view>
      <view class="s9-list">
        <view class="s9-list-row" wx:for="{{categories}}" wx:key="category"><view class="s9-list-main"><view class="s9-list-title">{{item.title}}</view><view class="s9-list-copy">{{item.retention}}</view></view><view class="s9-list-value type-data">{{item.countLabel}}</view></view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">岸岸的记忆</view><view class="s9-section-meta">你可控</view></view>
      <navigator hover-class="item--hover" class="s9-card" url="/account/memory/index">
        <view class="s9-card-title">查看岸岸记住了什么</view>
        <view class="s9-card-copy">长期记忆只来自你主动添加的偏好；会话记忆 2 小时后自动过期。</view>
        <view class="s9-card-meta">管理记忆 →</view>
      </navigator>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">导出个人数据</view><view class="s9-section-meta">生成后 24 小时过期</view></view>
      <view class="s9-card export-card">
        <view class="s9-card-copy export-copy">包括账户、资格岗位、学习记录、原始资料、报告、订单和会员信息；不包括密钥和第三方支付凭据。</view>
        <button hover-class="item--hover" wx:if="{{!exportRequest}}" class="privacy-secondary" loading="{{exporting || restoringExport}}" bindtap="createExport">导出我的数据</button>
        <block wx:else>
          <view class="export-state">{{exportStateLabel}}</view>
          <button hover-class="item--hover" wx:if="{{exportCanRefresh}}" class="privacy-secondary" loading="{{restoringExport}}" bindtap="refreshExport">查看生成进度</button>
          <button hover-class="item--hover" wx:elif="{{exportCanOpen}}" class="privacy-secondary" loading="{{openingExport}}" bindtap="openExport">保存或转发导出文件</button>
          <button hover-class="item--hover" wx:elif="{{exportCanRestart}}" class="privacy-secondary" loading="{{exporting}}" bindtap="restartExport">重新生成</button>
        </block>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head danger-heading"><view class="s9-section-title">删除账户</view><view class="s9-section-meta">不可恢复</view></view>
      <view class="s9-card s9-card--danger deletion-card">
        <view class="deletion-copy" wx:for="{{overview.accountDeletionEffect}}" wx:key="*this"><text class="danger-dot"></text><text>{{item}}</text></view>
        <view class="phrase-label">请完整输入：<text class="phrase-label__value">{{confirmationPhrase}}</text></view>
        <input class="phrase-input" value="{{deletionPhrase}}" placeholder="输入上面这行字" bindinput="onDeletionPhraseInput" />
        <button hover-class="item--hover" class="delete-button {{deletionPhrase !== confirmationPhrase ? 'delete-button--disabled' : ''}}" disabled="{{deletionPhrase !== confirmationPhrase}}" loading="{{deleting}}" bindtap="requestDeletion">删除我的账户</button>
        <view class="deletion-farewell">祝你上岸——无论哪一边的岸。</view>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="s9-inline-error">{{errorMessage}}</view>
  </block>
</view>
