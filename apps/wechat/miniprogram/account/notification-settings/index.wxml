<view class="s9-page coach-settings-page">
  <view class="coach-hero">
    <view class="coach-hero__copy">
      <view class="s9-card-kicker">岸岸 · AI 督学</view>
      <view class="s9-title">提醒你回来，不替你完成</view>
      <view class="s9-subtitle">只围绕已确认任务、复盘、复测、模考和周总结；微信消息不展示岗位、分数、错题或私人资料。</view>
    </view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" custom-class="coach-state" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" custom-class="coach-state" state="error" title="督学设置没加载出来" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />

  <block wx:else>
    <view class="s9-card master-card">
      <view class="setting-row setting-row--top"><view class="setting-copy"><view class="setting-title">启用 AI 督学</view><view class="setting-description">提醒会跟随小程序里的今日任务</view></view><ui-toggle label="启用 AI 督学" checked="{{draft.enabled}}" bind:change="toggleMaster" /></view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">提醒范围</view><view class="s9-section-meta">可以一类一类关</view></view>
      <view class="s9-list">
        <view class="setting-row"><view class="setting-copy"><view class="setting-title">今日任务</view><view class="setting-description">还有确认好的事情没做完时</view></view><ui-toggle label="今日任务提醒" checked="{{draft.taskRemindersEnabled}}" data-field="taskRemindersEnabled" bind:change="toggleCategory" /></view>
        <view class="setting-row"><view class="setting-copy"><view class="setting-title">复盘</view><view class="setting-description">有错因、评阅或改写还没处理时</view></view><ui-toggle label="复盘提醒" checked="{{draft.reflectionRemindersEnabled}}" data-field="reflectionRemindersEnabled" bind:change="toggleCategory" /></view>
        <view class="setting-row"><view class="setting-copy"><view class="setting-title">复测</view><view class="setting-description">有到期该复测的任务时</view></view><ui-toggle label="复测提醒" checked="{{draft.retestRemindersEnabled}}" data-field="retestRemindersEnabled" bind:change="toggleCategory" /></view>
        <view class="setting-row"><view class="setting-copy"><view class="setting-title">模考</view><view class="setting-description">有确认好的模考要开始时</view></view><ui-toggle label="模考提醒" checked="{{draft.mockRemindersEnabled}}" data-field="mockRemindersEnabled" bind:change="toggleCategory" /></view>
        <view class="setting-row"><view class="setting-copy"><view class="setting-title">周总结</view><view class="setting-description">周末有本周学习记录时</view></view><ui-toggle label="周总结提醒" checked="{{draft.weeklySummaryEnabled}}" data-field="weeklySummaryEnabled" bind:change="toggleCategory" /></view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">时间与频率</view><view class="s9-section-meta">中国标准时间</view></view>
      <view class="s9-card timing-card">
        <view class="time-grid">
          <picker mode="time" value="{{draft.receiveStart}}" bindchange="chooseReceiveStart"><view class="time-field"><view class="time-label">接收开始</view><view class="time-value">{{draft.receiveStart || '请选择'}}</view></view></picker>
          <picker mode="time" value="{{draft.receiveEnd}}" bindchange="chooseReceiveEnd"><view class="time-field"><view class="time-label">接收结束</view><view class="time-value">{{draft.receiveEnd || '请选择'}}</view></view></picker>
        </view>
        <view class="limit-row"><view><view class="setting-title">每日频率上限</view><view class="setting-description">实际发送还要看任务情况和你允许的次数</view></view><input class="limit-input type-data" type="number" value="{{draft.dailyLimit}}" bindinput="updateDailyLimit" /></view>
        <view class="quiet-head"><view><view class="setting-title">免打扰</view><view class="setting-description">可以跨过午夜</view></view><ui-toggle label="免打扰" checked="{{draft.quietEnabled}}" bind:change="toggleQuiet" /></view>
        <view wx:if="{{draft.quietEnabled}}" class="time-grid quiet-grid">
          <picker mode="time" value="{{draft.quietStart}}" bindchange="chooseQuietStart"><view class="time-field"><view class="time-label">免打扰开始</view><view class="time-value">{{draft.quietStart || '请选择'}}</view></view></picker>
          <picker mode="time" value="{{draft.quietEnd}}" bindchange="chooseQuietEnd"><view class="time-field"><view class="time-label">免打扰结束</view><view class="time-value">{{draft.quietEnd || '请选择'}}</view></view></picker>
        </view>
        <button hover-class="item--hover" class="s9-primary-button save-button" loading="{{saving}}" bindtap="save">保存提醒设置</button>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">微信提醒次数</view><view class="s9-section-meta">可发送 {{availableGrants}} 次</view></view>
      <view class="s9-card grant-card">
        <view wx:if="{{templateConfigured}}">
          <view class="grant-status"><view class="grant-count type-data">{{availableGrants}}</view><view><view class="setting-title">还能发送的次数</view><view class="setting-description">每次你点允许，就多一次发送机会</view></view></view>
          <view class="grant-last">{{lastResultLabel}}</view>
          <button hover-class="item--hover" class="s9-primary-button" loading="{{authorizing}}" bindtap="requestWechatAuthorization">增加 1 次提醒机会</button>
          <button hover-class="item--hover" class="s9-secondary-button wechat-setting-button" loading="{{syncing}}" bindtap="openWechatSettings">去微信里管理提醒</button>
        </view>
        <view wx:else class="template-blocked"><view class="setting-title">微信提醒还没准备好</view><view class="setting-description">你可以先把提醒设置存好；等后台准备好，这里就能开通了。</view></view>
      </view>
    </view>

    <view wx:if="{{history.length}}" class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">最近发送记录</view><view class="s9-section-meta">发送 ≠ 打开 ≠ 完成</view></view>
      <view class="s9-list">
        <view wx:for="{{history}}" wx:key="deliveryId" class="history-row"><view><view class="setting-title">{{item.categoryLabel}}</view><view class="setting-description">{{item.timeLabel}}</view></view><view class="history-state">{{item.stateLabel}}</view></view>
      </view>
      <view class="fact-note">{{deliveryFactNote}}</view>
    </view>

    <view wx:if="{{message}}" class="coach-message">{{message}}</view>
    <button hover-class="item--hover" class="disable-button" loading="{{disabling}}" bindtap="requestDisable">关闭全部 AI 督学提醒</button>
  </block>
</view>
