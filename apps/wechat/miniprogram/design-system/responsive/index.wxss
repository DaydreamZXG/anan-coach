/*
 * One responsive product, not a second tablet UI.
 * Phone rules remain the default. Tablet rules use px so rpx does not enlarge
 * typography and controls with the physical width of the device.
 */
@media (min-width: 768px) {
  page {
    --space-page-x: var(--layout-tablet-gutter);
    --space-page-top: 28px;
    --space-section: 32px;
    --radius-hero: 32px;
    --radius-card: 32px;
    --radius-control: 20px;
    --radius-compact: 16px;
    --shadow-card: 0 8px 15px rgba(0, 0, 0, 0.04);
    --shadow-primary: 0 7px 18px rgba(17, 24, 39, 0.16);
    font-size: 16px;
  }

  .page,
  .s9-page {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
    padding: 28px var(--layout-tablet-gutter) calc(48px + env(safe-area-inset-bottom));
  }

  .s9-page--with-dock {
    padding-bottom: calc(112px + env(safe-area-inset-bottom));
  }

  .s9-hero {
    margin-top: 8px;
  }

  .s9-title {
    max-width: 680px;
    font-size: 36px;
    letter-spacing: -0.7px;
  }

  .s9-subtitle {
    max-width: 680px;
    margin-top: 12px;
    font-size: 16px;
  }

  .s9-stack {
    gap: 16px;
    margin-top: 20px;
  }

  .s9-card {
    padding: 22px 24px;
    border-width: 1px;
  }

  .s9-card-kicker,
  .s9-section-meta,
  .s9-list-copy,
  .s9-card-meta {
    font-size: 13px;
  }

  .s9-card-title,
  .s9-section-title {
    font-size: 20px;
  }

  .s9-card-copy,
  .s9-list-title,
  .s9-list-value {
    font-size: 16px;
  }

  .s9-metric {
    font-size: 38px;
  }

  .s9-section {
    margin-top: 28px;
  }

  .s9-list-row {
    min-height: 72px;
    padding: 14px 20px;
  }

  .s9-primary-button,
  .s9-secondary-button {
    min-height: 52px;
    padding: 0 20px;
    font-size: 17px;
  }

  .s9-action-dock {
    right: 50%;
    left: auto;
    width: min(100%, var(--layout-readable-max));
    padding: 14px var(--layout-tablet-gutter) calc(14px + env(safe-area-inset-bottom));
    transform: translateX(50%);
  }
}

@media (min-width: 1024px) {
  .tablet-workbench {
    width: 100%;
    max-width: var(--layout-workbench-max);
    margin-right: auto;
    margin-left: auto;
  }
}
