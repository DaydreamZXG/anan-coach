/*
 * One responsive product, not a second tablet UI.
 * Phone rules remain the default. Tablet rules use px so rpx does not enlarge
 * typography and controls with the physical width of the device.
 */
/* 600px starts tablet density; layout-specific columns keep their own wider breakpoints. */
@media (min-width: 600px) {
  page {
    --space-page-x: var(--layout-tablet-gutter);
    --space-page-top: 28px;
    --space-section: 32px;
    --radius-hero: 32px;
    --radius-card: 32px;
    --radius-control: 20px;
    --radius-compact: 16px;
    --shadow-card: 0 8px 15px rgba(0, 0, 0, 0.04);
    --shadow-primary: 0 7px 18px rgba(17, 24, 39, 0.16);
    font-size: 16px;
  }

  .page,
  .s9-page {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
    padding: 28px var(--layout-tablet-gutter) calc(48px + env(safe-area-inset-bottom));
  }

  .s9-page--with-dock {
    padding-bottom: calc(112px + env(safe-area-inset-bottom));
  }

  .s9-body {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
    padding: 12px var(--layout-tablet-gutter) calc(48px + env(safe-area-inset-bottom));
  }

  .s9-body--with-dock {
    padding-bottom: calc(112px + env(safe-area-inset-bottom));
  }

  .s9-hero {
    margin-top: 8px;
  }

  .s9-title {
    max-width: 680px;
    font-size: 36px;
    letter-spacing: -0.7px;
  }

  .s9-subtitle {
    max-width: 680px;
    margin-top: 12px;
    font-size: 16px;
  }

  .s9-stack {
    gap: 16px;
    margin-top: 20px;
  }

  .s9-card {
    padding: 22px 24px;
    border-width: 1px;
  }

  .s9-card-kicker,
  .s9-section-meta,
  .s9-list-copy,
  .s9-card-meta {
    font-size: 13px;
  }

  .s9-card-title,
  .s9-section-title {
    font-size: 20px;
  }

  .s9-card-copy,
  .s9-list-title,
  .s9-list-value {
    font-size: 16px;
  }

  .s9-metric {
    font-size: 38px;
  }

  .s9-section {
    margin-top: 28px;
  }

  .s9-list-row {
    min-height: 72px;
    padding: 14px 20px;
  }

  .s9-primary-button,
  .s9-secondary-button {
    min-height: 52px;
    padding: 0 20px;
    font-size: 17px;
  }

  .s9-action-dock {
    right: 50%;
    left: auto;
    width: min(100%, var(--layout-readable-max));
    padding: 14px var(--layout-tablet-gutter) calc(14px + env(safe-area-inset-bottom));
    border-top: 0;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
    pointer-events: none;
    transform: translateX(50%);
  }

  .s9-action-dock > button,
  .s9-action-dock > .s9-action-row {
    pointer-events: auto;
  }
}

@media (min-width: 1024px) {
  .tablet-workbench {
    width: 100%;
    max-width: var(--layout-workbench-max);
    margin-right: auto;
    margin-left: auto;
  }
}

/*
 * 大屏去放大层（2026-07-26，官方大屏适配指南）：
 * rpx 随屏宽等比放大，iPad 上一切 rpx 尺寸约为手机两倍。
 * 全部锁定阶梯 token 在平板断点整体切换为 px 手机等效值，
 * 让字号、圆角、间距回到物理合理尺寸；页面内的 rpx 字面量
 * 仅剩留白性质，放大后无碍阅读。
 */
@media (min-width: 600px) {
  page {
    /* 大屏去放大总开关：全部 calc(N * var(--rpx)) 尺寸回到手机等效物理值。 */
    --rpx: 0.5px;

    /* 字号 13 档（手机等效 px，正文微调 +1px 适配平板视距） */
    --text-tab: 11px;
    --text-micro: 12px;
    --text-caption: 13px;
    --text-body: 14px;
    --text-body-lg: 15px;
    --text-section: 17px;
    --text-title-sm: 19px;
    --text-title: 21px;
    --text-title-lg: 25px;
    --text-hero: 29px;
    --text-stat: 33px;
    --text-display: 37px;
    --text-stat-lg: 41px;

    /* 圆角 */
    --radius-8: 4px;
    --radius-12: 6px;
    --radius-16: 8px;
    --radius-24: 12px;
    --radius-32: 16px;
    --radius-40: 20px;
    --radius-48: 24px;
    --radius-64: 32px;

    /* Figma 镜像间距/圆角的平板等效值 */
    --figma-space-2: 2px;
    --figma-space-4: 4px;
    --figma-space-6: 6px;
    --figma-space-8: 8px;
    --figma-space-10: 10px;
    --figma-space-12: 12px;
    --figma-space-16: 16px;
    --figma-space-20: 20px;
    --figma-space-24: 24px;
    --figma-space-32: 32px;
    --figma-space-40: 40px;
    --figma-space-48: 48px;
    --figma-page-inset: 24px;
    --figma-section-gap: 28px;
    --figma-bottom-navigation-height: 88px;
    --figma-radius-card-xlarge: 36px;
    --figma-radius-card-large: 32px;
    --figma-radius-card-medium: 30px;
    --figma-radius-card: 24px;
    --figma-radius-control: 20px;
    --figma-radius-compact: 16px;
    --figma-radius-small: 12px;
    --figma-radius-xsmall: 8px;
  }
}

@media (min-width: 600px) {
  /* 控件高度回到 44px 档，避免 88rpx 在平板放大成 90px 巨钮。 */
  .ui-button,
  button.s9-primary-button,
  button.s9-secondary-button {
    min-height: 44px;
    font-size: var(--text-body-lg);
    line-height: 44px;
  }
}

@media (min-width: 1024px) and (orientation: landscape) {
  /* 320px 工具栏保留成对入口；短标签横排比纵向堆叠更符合平板扫视路径。 */
  .today-col--side-b .tool-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .today-col--side-b .tool-link {
    justify-content: center;
    white-space: nowrap;
  }

  .today-col--side-b .settlement-button {
    white-space: nowrap;
  }
}

/*
 * 粉笔式做题双栏（1024px+）：选项从手机卡片壳降为轻量文本行——
 * 描边圆字母 + 纯文本，无边框阴影，选中用青色浅底；密度对齐粉笔平板端。
 */
@media (min-width: 1024px) {
  .option-list {
    gap: 6px;
  }

  .option-row {
    grid-template-columns: minmax(0, 1fr) 40px;
    gap: 8px;
  }

  .option-card {
    padding: 10px 12px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    box-shadow: none;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 12px;
  }

  .option-card--selected {
    border: 0;
    background: var(--color-primary-soft);
    box-shadow: none;
  }

  .option-card--eliminated {
    border: 0;
    background: transparent;
  }

  .option-label {
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-line-strong);
    background: transparent;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 26px;
  }

  .option-card--selected .option-label {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .option-copy {
    padding-top: 2px;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
  }

  .eliminate-action {
    width: 40px;
    min-width: 40px;
    border: 0;
    background: transparent;
    box-shadow: none;
    opacity: 0.55;
  }

  .question-stem {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.7;
  }
}

/* 排版总纲·列表模板第一批：已有网格类的页面在宽屏升 2 列。 */
@media (min-width: 1024px) {
  .report-grid,
  .brain-grid {
    display: grid;
    align-items: stretch;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* 列表模板第二批：学习包/掌握队列/私人资料宽屏 2 列。 */
@media (min-width: 1024px) {
  .packet-grid,
  .mastery-grid,
  .source-grid {
    display: grid;
    align-items: stretch;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .packet-grid .packet-card,
  .mastery-grid .mastery-card {
    height: 100%;
    box-sizing: border-box;
  }
}
