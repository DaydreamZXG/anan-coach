.ui-sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: var(--color-mask);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.ui-sheet-mask--shown {
  opacity: 1;
  pointer-events: auto;
}

.ui-sheet-mask--sheet {
  z-index: var(--z-sheet);
}

.ui-sheet-mask--overlay {
  z-index: var(--z-overlay);
}

.ui-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  padding: 16rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--color-surface);
  box-shadow: 0 -20rpx 60rpx rgba(17, 24, 39, 0.14);
  opacity: 0;
  transform: translateY(36rpx);
  transition:
    transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.25s ease;
  will-change: transform, opacity;
}

.ui-sheet--shown {
  opacity: 1;
  transform: translateY(0);
}

.ui-sheet--canvas {
  background: var(--color-canvas);
}

.ui-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: var(--color-line-strong);
}

.ui-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ui-sheet__head-main {
  flex: 1;
  min-width: 0;
}

.ui-sheet__title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 820;
  line-height: 1.4;
}

.ui-sheet__copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.ui-sheet__close {
  flex: none;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 22rpx;
  line-height: 44rpx;
}

.ui-sheet__close::after {
  border: 0;
}

@media (min-width: 768px) {
  .ui-sheet-mask {
    align-items: center;
    justify-content: center;
    padding: 32px;
  }

  .ui-sheet {
    max-width: 720px;
    padding: 24px;
    border-radius: 22px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ui-sheet-mask,
  .ui-sheet {
    transition-duration: 0.01ms;
  }
}
