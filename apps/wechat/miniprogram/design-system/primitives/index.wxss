@import "interaction.wxss";

.eyebrow {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: calc(2 * var(--rpx));
}

.page-title {
  margin-top: calc(8 * var(--rpx));
  font-size: var(--text-title-lg);
  font-weight: 800;
  letter-spacing: calc(-1 * var(--rpx));
}

.page-subtitle {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-body);
  line-height: 1.6;
}

.ui-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: var(--space-section) calc(4 * var(--rpx)) calc(18 * var(--rpx));
}

.section-title {
  font-size: var(--text-section);
  font-weight: 700;
}

.section-meta {
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.card {
  box-sizing: border-box;
  padding: var(--figma-card-padding-compact);
  border: 0;
  border-radius: var(--figma-radius-card);
  background: var(--color-surface);
  box-shadow: var(--figma-shadow-surface);
}

.card + .card {
  margin-top: calc(20 * var(--rpx));
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.muted {
  color: var(--color-muted);
}

.caption {
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: calc(44 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 600;
}

.pill--success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.pill--warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

button.primary-button,
button.secondary-button {
  box-sizing: border-box;
  min-height: calc(88 * var(--rpx));
  padding: 0 calc(32 * var(--rpx));
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(88 * var(--rpx));
}

button.primary-button {
  border-radius: var(--radius-32);
  background: var(--color-ink);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-elevated);
}

button.secondary-button {
  border-radius: var(--radius-control);
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface-glass);
  color: var(--color-ink);
}

.skeleton {
  height: calc(168 * var(--rpx));
  border-radius: var(--radius-card);
  background: var(--gradient-skeleton);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.state-card {
  padding: calc(48 * var(--rpx)) calc(32 * var(--rpx));
  text-align: center;
}

.state-title {
  font-size: var(--text-section);
  font-weight: 700;
}

.state-copy {
  margin: calc(16 * var(--rpx)) auto calc(28 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.card--hover,
.option--hover,
.primary-button--hover,
.secondary-button--hover {
  transform: scale(0.985);
  opacity: 0.88;
  transition:
    transform 0.08s cubic-bezier(0.2, 0, 0.2, 1),
    opacity 0.08s cubic-bezier(0.2, 0, 0.2, 1);
}

.card--hover {
  transform: scale(0.99);
  background: var(--color-surface-soft);
}

.option--hover {
  transform: scale(0.985);
  background: var(--color-primary-a08) !important;
  border-color: var(--color-primary-a24) !important;
}

.tap-tactile {
  transform-origin: center;
  transition:
    transform 0.08s cubic-bezier(0.2, 0, 0.2, 1),
    opacity 0.08s cubic-bezier(0.2, 0, 0.2, 1);
  will-change: transform;
}

.motion-mask {
  animation: motion-mask-in 0.2s ease both;
}

.motion-sheet {
  animation: motion-sheet-in 0.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  will-change: transform, opacity;
}

.fade-slide-in {
  animation: fade-slide-in 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.fade-slide-in--2 {
  animation-delay: 0.06s;
}

.fade-slide-in--3 {
  animation-delay: 0.12s;
}

.fade-slide-in--4 {
  animation-delay: 0.18s;
}

@keyframes motion-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes motion-sheet-in {
  from {
    opacity: 0;
    transform: translateY(calc(36 * var(--rpx)));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-slide-in {
  from {
    opacity: 0;
    transform: translateY(calc(20 * var(--rpx)));
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tap-tactile,
  .motion-mask,
  .motion-sheet,
  .fade-slide-in {
    animation-duration: 0.01ms;
    animation-delay: 0ms;
    transition-duration: 0.01ms;
  }
}
