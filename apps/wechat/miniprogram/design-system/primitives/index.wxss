@import "interaction.wxss";

.eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 8rpx;
  font-size: var(--font-title);
  font-weight: 800;
  letter-spacing: -1rpx;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.ui-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: var(--space-section) 4rpx 18rpx;
}

.section-title {
  font-size: var(--font-section);
  font-weight: 750;
}

.section-meta {
  color: var(--color-muted);
  font-size: var(--font-caption);
}

.card {
  box-sizing: border-box;
  padding: var(--figma-card-padding-compact);
  border: 0;
  border-radius: var(--figma-radius-card);
  background: var(--color-surface);
  box-shadow: var(--figma-shadow-surface);
}

.card + .card {
  margin-top: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: var(--color-muted);
}

.caption {
  color: var(--color-muted);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 650;
}

.pill--success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.pill--warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

button.primary-button,
button.secondary-button {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 30rpx;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 88rpx;
}

button.primary-button {
  border-radius: 36rpx;
  background: var(--color-ink);
  color: var(--color-on-primary);
  box-shadow: 0 14rpx 32rpx rgba(17, 24, 39, 0.16);
}

button.secondary-button {
  border-radius: var(--radius-control);
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface-glass);
  color: var(--color-ink);
}

.skeleton {
  height: 168rpx;
  border-radius: var(--radius-card);
  background: var(--gradient-skeleton);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}

.state-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.state-title {
  font-size: var(--font-section);
  font-weight: 750;
}

.state-copy {
  margin: 14rpx auto 26rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.card--hover,
.option--hover,
.primary-button--hover,
.secondary-button--hover {
  transform: scale(0.985);
  opacity: 0.88;
  transition:
    transform 0.08s cubic-bezier(0.2, 0, 0.2, 1),
    opacity 0.08s cubic-bezier(0.2, 0, 0.2, 1);
}

.card--hover {
  transform: scale(0.99);
  background: var(--color-surface-soft);
}

.option--hover {
  transform: scale(0.985);
  background: var(--color-primary-a08) !important;
  border-color: var(--color-primary-a24) !important;
}

.tap-tactile {
  transform-origin: center;
  transition:
    transform 0.08s cubic-bezier(0.2, 0, 0.2, 1),
    opacity 0.08s cubic-bezier(0.2, 0, 0.2, 1);
  will-change: transform;
}

.motion-mask {
  animation: motion-mask-in 0.2s ease both;
}

.motion-sheet {
  animation: motion-sheet-in 0.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  will-change: transform, opacity;
}

.fade-slide-in {
  animation: fade-slide-in 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.fade-slide-in--2 {
  animation-delay: 0.06s;
}

.fade-slide-in--3 {
  animation-delay: 0.12s;
}

.fade-slide-in--4 {
  animation-delay: 0.18s;
}

@keyframes motion-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes motion-sheet-in {
  from {
    opacity: 0;
    transform: translateY(36rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-slide-in {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tap-tactile,
  .motion-mask,
  .motion-sheet,
  .fade-slide-in {
    animation-duration: 0.01ms;
    animation-delay: 0ms;
    transition-duration: 0.01ms;
  }
}
