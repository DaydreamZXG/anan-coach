.ui-button {
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 0 30rpx;
  border: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-body);
  font-weight: 750;
  line-height: 88rpx;
}

.ui-button::after {
  border: 0;
}

.ui-button--block {
  width: 100%;
}

.ui-button--primary {
  background: var(--gradient-brand);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.ui-button--secondary {
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-glass);
  color: var(--color-ink);
}

.ui-button--wechat {
  background: var(--color-wechat);
  color: var(--color-on-primary);
}

.ui-button--danger {
  background: var(--color-danger);
  color: var(--color-on-primary);
}

.ui-button--text {
  background: transparent;
  color: var(--color-primary);
  box-shadow: none;
}

.ui-button[disabled] {
  opacity: 0.5;
}
