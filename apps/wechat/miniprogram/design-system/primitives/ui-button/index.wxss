.ui-button {
  box-sizing: border-box;
  min-height: calc(88 * var(--rpx));
  margin: 0;
  padding: 0 calc(32 * var(--rpx));
  border: 0;
  border-radius: var(--radius-control);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(88 * var(--rpx));
}

.ui-button::after {
  border: 0;
}

button.ui-button.ui-button--block {
  width: 100%;
}

.ui-button--primary {
  border-radius: var(--radius-32);
  background: var(--color-ink);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-elevated);
}

.ui-button--secondary {
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface-glass);
  color: var(--color-ink);
}

.ui-button--wechat {
  background: var(--color-wechat);
  color: var(--color-on-primary);
}

.ui-button--danger {
  background: var(--color-danger);
  color: var(--color-on-primary);
}

.ui-button--text {
  background: transparent;
  color: var(--color-primary);
  box-shadow: none;
}

.ui-button--hover {
  transform: scale(0.982);
  opacity: 0.88;
  transition:
    transform 0.08s cubic-bezier(0.2, 0, 0.2, 1),
    opacity 0.08s cubic-bezier(0.2, 0, 0.2, 1);
}

.ui-button--disabled {
  opacity: 0.5;
}
