<button
  class="ui-button ui-button--{{variant}} {{block ? 'ui-button--block' : ''}} {{disabled ? 'ui-button--disabled' : ''}} custom-class"
  loading="{{loading}}"
  disabled="{{disabled}}"
  form-type="{{formType}}"
  hover-class="ui-button--hover"
  bindtap="handleTap"
>
  <slot wx:if="{{!label}}"></slot>
  <text wx:else>{{label}}</text>
</button>
