button.ui-toggle {
  position: relative;
  display: block;
  width: 92rpx;
  min-width: 92rpx;
  height: 52rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
  transition:
    background 180ms ease,
    box-shadow 180ms ease;
}

.ui-toggle::after {
  border: 0;
}

.ui-toggle--checked {
  background: var(--color-primary);
  box-shadow: 0 8rpx 22rpx var(--color-primary-a18);
}

.ui-toggle__thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: var(--shadow-control);
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ui-toggle--checked .ui-toggle__thumb {
  transform: translateX(40rpx);
}

.ui-toggle--hover {
  opacity: 0.84;
}

.ui-toggle--disabled {
  opacity: 0.45;
}
