.state-view {
  box-sizing: border-box;
  width: 100%;
}

.state-view--loading {
  display: grid;
  gap: calc(20 * var(--rpx));
}

.state-skeleton {
  height: calc(150 * var(--rpx));
  border-radius: var(--radius-card);
  background: var(--gradient-skeleton-cool);
  background-size: 400% 100%;
  animation: state-shimmer 1.4s ease infinite;
}

.state-skeleton--hero {
  height: calc(260 * var(--rpx));
}

.state-view:not(.state-view--loading) {
  padding: calc(48 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface-glass);
  text-align: center;
  box-shadow: var(--shadow-card);
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  margin: 0 auto calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
}

.state-view--error .state-icon {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.state-view--stale .state-icon {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.state-title {
  font-size: var(--text-section);
  font-weight: 700;
}

.state-description {
  margin: calc(16 * var(--rpx)) auto 0;
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.state-request {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-faint);
  font-family: monospace;
  font-size: var(--text-micro);
}

.state-action {
  margin-top: calc(28 * var(--rpx));
}

@keyframes state-shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
