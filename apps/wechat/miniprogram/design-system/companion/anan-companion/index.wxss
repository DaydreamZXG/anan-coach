.anan {
  position: relative;
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 0;
}

.anan--small {
  width: calc(56 * var(--rpx));
  height: calc(56 * var(--rpx));
}

.anan--medium {
  width: calc(88 * var(--rpx));
  height: calc(88 * var(--rpx));
}

.anan--large {
  width: calc(180 * var(--rpx));
  height: calc(180 * var(--rpx));
}

.anan--avatar-32 {
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
}

.anan--inline-64 {
  width: calc(128 * var(--rpx));
  height: calc(128 * var(--rpx));
}

.anan--animated-120 {
  width: calc(240 * var(--rpx));
  height: calc(240 * var(--rpx));
}

.anan--card-160 {
  width: calc(320 * var(--rpx));
  height: calc(320 * var(--rpx));
}

.anan--hero-240 {
  width: calc(480 * var(--rpx));
  height: calc(480 * var(--rpx));
}

.anan__viewport,
.anan__static,
.anan__embedded {
  display: block;
  width: 100%;
  height: 100%;
}

.anan__viewport {
  overflow: hidden;
}

.anan__sheet {
  display: block;
  height: 100%;
  transition: none;
  will-change: transform;
}

.anan__static {
  object-fit: contain;
}
