@import "../tokens/component-host.tokens.wxss";

.structured-visual {
  box-sizing: border-box;
  width: 100%;
  color: var(--figma-color-ink, #101828);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.structured-visual__ready {
  width: 100%;
}

.structured-visual__title {
  padding: 0 calc(8 * var(--rpx)) calc(12 * var(--rpx));
  font-size: calc(28 * var(--rpx));
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
}

.structured-visual__canvas {
  display: block;
  width: 100%;
  min-height: 220px;
}

.structured-visual__evidence {
  display: flex;
  align-items: flex-start;
  gap: calc(10 * var(--rpx));
  margin-top: calc(8 * var(--rpx));
  padding: calc(14 * var(--rpx)) calc(18 * var(--rpx));
  border-left: calc(4 * var(--rpx)) solid #ff6900;
  border-radius: var(--radius-8, calc(8 * var(--rpx)));
  background: #fff7ed;
  color: #9a3412;
  font-size: calc(22 * var(--rpx));
  line-height: 1.5;
}

.structured-visual__evidence-mark {
  flex: 0 0 auto;
  font-family: "Maple Mono CN", "DIN Alternate", monospace;
  font-weight: 700;
}

.structured-visual__state {
  box-sizing: border-box;
  width: 100%;
  padding: calc(48 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-line, #f3f4f6);
  border-radius: calc(32 * var(--rpx));
  background: var(--figma-color-surface, #ffffff);
  text-align: center;
}

.structured-visual__state-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  margin: 0 auto calc(20 * var(--rpx));
  border-radius: calc(24 * var(--rpx));
  background: #fef2f2;
  color: #e7000b;
  font-size: calc(32 * var(--rpx));
  font-weight: 800;
}

.structured-visual__state--empty .structured-visual__state-mark {
  background: #ecfeff;
  color: #0092b8;
}

.structured-visual__state-title {
  font-size: calc(32 * var(--rpx));
  font-weight: 700;
}

.structured-visual__state-description {
  max-width: 560px;
  margin: calc(16 * var(--rpx)) auto 0;
  color: #6a7282;
  font-size: calc(24 * var(--rpx));
  line-height: 1.6;
  overflow-wrap: anywhere;
}

@media (min-width: 600px) {
  .component-token-host {
    --rpx: 0.5px;
  }

  .structured-visual__title {
    font-size: 16px;
  }

  .structured-visual__evidence {
    gap: 6px;
    padding: 8px 10px;
    border-left-width: 2px;
    border-radius: 6px;
    font-size: 12px;
  }

  .structured-visual__state {
    padding: 28px 24px;
    border-width: 1px;
    border-radius: 24px;
  }

  .structured-visual__state-mark {
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 14px;
    font-size: 18px;
  }

  .structured-visual__state-title {
    font-size: 17px;
  }

  .structured-visual__state-description {
    margin-top: 8px;
    font-size: 13px;
  }
}
