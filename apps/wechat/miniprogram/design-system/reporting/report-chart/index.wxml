<view class="report-chart" aria-label="{{chart.title}}">
  <view class="report-chart__head">
    <view>
      <view class="report-chart__title">{{chart.title}}</view>
      <view class="report-chart__meta">{{chart.period}} · {{chart.unit}} · {{confidenceLabel}}</view>
    </view>
    <view class="report-chart__evidence">{{evidenceCount}} 条证据</view>
  </view>
  <view class="report-chart__definition">{{chart.definition}}</view>
  <view wx:if="{{rows.length}}" class="report-chart__plot">
    <view wx:for="{{rows}}" wx:key="key" class="report-chart__row">
      <view class="report-chart__row-head">
        <view class="report-chart__label">{{item.label}}</view>
        <view class="report-chart__value type-data">{{item.primary}}</view>
      </view>
      <view class="report-chart__rail" aria-hidden="true">
        <view class="report-chart__bar report-chart__bar--{{item.tone}}" style="width: {{item.width}}"></view>
      </view>
      <view class="report-chart__row-copy">{{item.marker}} · {{item.secondary}}</view>
    </view>
  </view>
  <view wx:else class="report-chart__empty">数据还不够画这张图。</view>
  <view class="report-chart__summary">{{chart.summary}}</view>
  <view wx:if="{{chart.partialReasons.length}}" class="report-chart__partial">证据缺口 {{chart.partialReasons.length}} 项，图表已按部分状态展示。</view>
</view>
