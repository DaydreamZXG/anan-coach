.s9-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 0%, rgba(240, 163, 92, 0.12), transparent 28%),
    var(--color-canvas);
  color: var(--color-ink);
}

.s9-page--with-dock {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.s9-hero {
  margin-top: 14rpx;
}

.s9-title {
  max-width: 686rpx;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1.4rpx;
  line-height: 1.42;
}

.s9-subtitle {
  max-width: 686rpx;
  margin-top: 16rpx;
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.s9-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.s9-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  font-weight: 700;
}

.s9-chip--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.s9-chip--gold {
  box-sizing: border-box;
  border: 1rpx solid var(--color-gold);
  background: var(--color-gold-soft);
  color: var(--color-warning);
}

.s9-stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 26rpx;
}

.s9-card {
  box-sizing: border-box;
  padding: 30rpx 32rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.s9-card--primary {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.s9-card--danger {
  border-color: rgba(213, 70, 79, 0.24);
  background: var(--color-danger-soft);
}

.s9-card-kicker {
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.s9-card-title {
  margin-top: 12rpx;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.s9-card-copy {
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  line-height: 1.58;
}

.s9-card-meta {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.s9-metric {
  margin-top: 12rpx;
  color: var(--color-primary-deep);
  font-family: var(--font-family-data);
  font-size: 56rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
  line-height: 1.1;
}

.s9-section {
  margin-top: 38rpx;
}

.s9-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.s9-section-title {
  font-size: 30rpx;
  font-weight: 800;
}

.s9-section-meta {
  color: var(--color-muted);
  font-size: 21rpx;
}

.s9-list {
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.s9-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 104rpx;
  padding: 18rpx 28rpx;
}

.s9-list-row + .s9-list-row {
  border-top: 1rpx solid var(--color-line);
}

.s9-list-main {
  flex: 1;
  min-width: 0;
}

.s9-list-title {
  font-size: 26rpx;
  font-weight: 750;
}

.s9-list-copy {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.45;
}

.s9-list-value {
  flex: 0 0 auto;
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 750;
  text-align: right;
}

.s9-action-dock {
  position: fixed;
  z-index: var(--z-footer);
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: var(--color-surface-glass);
  box-shadow: 0 -14rpx 30rpx rgba(190, 120, 60, 0.07);
}

.s9-action-row {
  display: flex;
  gap: 16rpx;
}

.s9-action-row .s9-primary-button,
.s9-action-row .s9-secondary-button {
  flex: 1;
  min-width: 0;
}

.s9-primary-button,
.s9-secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-control);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.s9-primary-button {
  border-radius: 999rpx;
  background: var(--gradient-brand);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.s9-primary-button--disabled {
  background: #eccdb4;
  box-shadow: none;
  color: rgba(255, 255, 255, 0.88);
}

.s9-secondary-button {
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink);
}

.s9-inline-error {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 22rpx;
  line-height: 1.55;
}

.s9-empty-space {
  min-height: 38rpx;
}
