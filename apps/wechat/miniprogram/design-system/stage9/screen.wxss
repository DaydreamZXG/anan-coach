.s9-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--color-canvas);
  color: var(--color-ink);
}

.s9-page--with-dock {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

/*
 * Custom-navigation variant (workbench-nav pages).
 * s9-screen is the page base without top padding; s9-body is the content
 * column below the navigation with the standard inset.
 */
.s9-screen {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-canvas);
  color: var(--color-ink);
}

.s9-body {
  box-sizing: border-box;
  padding: 16rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

.s9-body--with-dock {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.s9-hero {
  margin-top: 16rpx;
}

.s9-title {
  max-width: 686rpx;
  font-size: var(--text-hero);
  font-weight: 800;
  letter-spacing: -1.8rpx;
  line-height: 1.28;
}

.s9-subtitle {
  max-width: 686rpx;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: var(--text-body);
  line-height: 1.55;
}

.s9-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.s9-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.s9-chip--primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.s9-chip--gold {
  box-sizing: border-box;
  border: 1rpx solid var(--color-gold);
  background: var(--color-gold-soft);
  color: var(--color-warning);
}

.s9-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 28rpx;
}

.s9-card {
  box-sizing: border-box;
  padding: 32rpx 32rpx;
  border: 1rpx solid rgba(240, 242, 246, 0.88);
  border-radius: var(--radius-card);
  background: var(--color-surface-glass);
  box-shadow: var(--shadow-card);
}

.s9-card--primary {
  border-color: rgba(224, 231, 255, 0.8);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(238, 242, 255, 0.72));
}

.s9-card--danger {
  border-color: rgba(213, 70, 79, 0.24);
  background: var(--color-danger-soft);
}

.s9-card-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.s9-card-title {
  margin-top: 12rpx;
  font-size: var(--text-section);
  font-weight: 800;
  line-height: 1.35;
}

.s9-card-copy {
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.58;
}

.s9-card-meta {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.s9-metric {
  margin-top: 12rpx;
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-size: var(--text-hero);
  font-variant-numeric: tabular-nums;
  font-weight: 800;
  line-height: 1.1;
}

.s9-section {
  margin-top: 40rpx;
}

.s9-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.s9-section-title {
  font-size: var(--text-section);
  font-weight: 800;
}

.s9-section-meta {
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.s9-list {
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface-glass);
  box-shadow: var(--shadow-card);
}

.s9-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 20rpx 28rpx;
}

.s9-list-row + .s9-list-row {
  border-top: 1rpx solid var(--color-line);
}

.s9-list-main {
  flex: 1;
  min-width: 0;
}

.s9-list-title {
  font-size: var(--text-body);
  font-weight: 700;
}

.s9-list-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.45;
}

.s9-list-value {
  flex: 0 0 auto;
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
  text-align: right;
}

.s9-action-dock {
  position: fixed;
  z-index: var(--z-footer);
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: rgba(255, 255, 255, 0.9);
  box-shadow: var(--shadow-dock);
  backdrop-filter: blur(26rpx);
}

.s9-action-row {
  display: flex;
  gap: 16rpx;
}

.s9-action-row .s9-primary-button,
.s9-action-row .s9-secondary-button {
  flex: 1;
  min-width: 0;
}

button.s9-primary-button.s9-primary-button,
button.s9-secondary-button.s9-secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-control);
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.2;
}

button.s9-primary-button {
  border-radius: var(--radius-40);
  background: var(--color-ink);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-elevated);
}

.s9-primary-button--disabled {
  background: var(--figma-color-line-emphasis);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.88);
}

button.s9-secondary-button {
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink);
}

.s9-inline-error {
  margin-top: 20rpx;
  padding: 24rpx 24rpx;
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.s9-empty-space {
  min-height: 38rpx;
}
