page {
  /* AI 光感学习舱：安静学习底色 + 青蓝智能光 + 少量暖色行动点 */
  --color-canvas: #f3f8f7;
  --color-surface: #ffffff;
  --color-surface-glass: rgba(255, 255, 255, 0.9);
  --color-surface-soft: #eaf4f2;
  --color-surface-ai: #edf4ff;
  --color-ink: #102823;
  --color-ink-secondary: #3f5d58;
  --color-muted: #6f8581;
  --color-faint: #9eb0ad;
  --color-line: #dce9e6;
  --color-line-strong: #c6d9d5;
  --color-primary: #0b9f8c;
  --color-primary-deep: #087468;
  --color-primary-soft: #e0f4f0;
  --color-primary-a08: rgba(11, 159, 140, 0.08);
  --color-primary-a16: rgba(11, 159, 140, 0.16);
  --color-primary-a24: rgba(11, 159, 140, 0.24);
  --color-companion: #238bd4;
  --color-cyan: #23b7c6;
  --color-ai-blue: #2d7fe7;
  --color-ai-violet: #6b61dc;
  --color-ai-soft: #edf2ff;
  --color-action: #ef9142;
  --color-action-deep: #d97228;
  --color-success: #268f68;
  --color-success-soft: #e3f4ec;
  --color-warning: #b97928;
  --color-warning-soft: #fdf3e3;
  --color-danger: #d5464f;
  --color-danger-soft: #fcedee;
  --color-wechat: #07c160;
  --color-on-primary: #ffffff;
  --color-gold: #d9a12f;
  --color-gold-soft: #fcf4df;
  --color-mask: rgba(12, 37, 33, 0.5);
  --gradient-brand: linear-gradient(135deg, #0ba790 0%, #258bd5 100%);
  --gradient-ai: linear-gradient(135deg, #675edc 0%, #2f84e6 48%, #0ba790 100%);
  --gradient-aurora: linear-gradient(135deg, rgba(11, 167, 144, 0.2), rgba(45, 127, 231, 0.16) 52%, rgba(107, 97, 220, 0.14));
  --gradient-companion: linear-gradient(135deg, #ebfaf6 0%, #edf3ff 56%, #f3efff 100%);
  --gradient-action: linear-gradient(135deg, #f2a253 0%, #e77c32 100%);
  --shadow-card: 0 14rpx 44rpx rgba(21, 78, 70, 0.08);
  --shadow-card-strong: 0 24rpx 70rpx rgba(27, 91, 105, 0.14);
  --shadow-primary: 0 20rpx 44rpx rgba(25, 127, 164, 0.24);
  --shadow-ai: 0 24rpx 60rpx rgba(63, 104, 195, 0.2);
  --radius-hero: 40rpx;
  --radius-card: 32rpx;
  --radius-control: 26rpx;
  --radius-compact: 14rpx;
  --space-page-x: 28rpx;
  --space-page-top: 32rpx;
  --space-section: 40rpx;
  --font-title: 48rpx;
  --font-section: 30rpx;
  --font-body: 28rpx;
  --font-caption: 22rpx;
  --font-family-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-reading: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-data: "Maple Mono CN", "DIN Alternate", -apple-system, BlinkMacSystemFont, monospace;
  --layout-readable-max: 720px;
  --layout-workbench-max: 1280px;
  --layout-tablet-gutter: 32px;
  --layout-wide-gutter: 40px;
  /* 层级统一出口：弹层/遮罩一律引用，禁止再写魔法数字 */
  --z-footer: 20;
  --z-sticky: 30;
  --z-sheet: 70;
  --z-overlay: 100;
  --z-blocker: 110;
}
