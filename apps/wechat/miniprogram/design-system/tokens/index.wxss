@import "design-file.tokens.wxss";

/*
 * Runtime semantic aliases.
 *
 * Every visual value that exists in the approved Design File resolves to the
 * mirrored --figma-* token above. Product-only semantics remain named here so
 * page code does not duplicate raw values.
 */
page {
  --color-canvas: var(--figma-color-canvas);
  --color-surface: var(--figma-color-surface);
  --color-surface-glass: var(--figma-color-surface);
  --color-surface-soft: var(--figma-color-surface-subtle);
  --color-surface-ai: var(--figma-color-primary-soft);
  --color-ink: var(--figma-color-ink);
  --color-ink-secondary: var(--figma-color-ink-secondary);
  --color-muted: var(--figma-color-muted);
  --color-faint: var(--figma-color-faint);
  --color-line: var(--figma-color-line);
  --color-line-strong: var(--figma-color-line-strong);
  --color-primary: var(--figma-color-primary);
  --color-primary-deep: var(--figma-color-primary-deep);
  --color-primary-soft: var(--figma-color-primary-soft);
  --color-primary-a08: rgba(97, 95, 255, 0.08);
  --color-primary-a11: rgba(97, 95, 255, 0.11);
  --color-primary-a16: rgba(97, 95, 255, 0.16);
  --color-primary-a18: rgba(79, 70, 229, 0.18);
  --color-primary-a24: rgba(97, 95, 255, 0.24);
  --color-companion: var(--figma-color-primary);
  --color-cyan: var(--figma-color-cyan);
  --color-ai-blue: var(--figma-color-primary);
  --color-ai-violet: var(--figma-color-ai-violet);
  --color-ai-pink: var(--figma-color-ai-pink);
  --color-ai-soft: var(--figma-color-primary-soft);
  --color-action: var(--figma-color-ink);
  --color-action-deep: var(--figma-color-device-frame);
  --color-success: var(--figma-color-success);
  --color-success-soft: var(--figma-color-success-soft);
  --color-warning: var(--figma-color-warning);
  --color-warning-deep: var(--figma-color-warning-deep);
  --color-warning-soft: var(--figma-color-warning-soft);
  --color-danger: var(--figma-color-danger);
  --color-danger-soft: var(--figma-color-danger-soft);
  --color-wechat: #07c160;
  --color-on-primary: var(--figma-color-on-dark);
  --color-gold: #d9a12f;
  --color-gold-soft: #fcf4df;
  --color-mask: rgba(17, 24, 39, 0.36);
  --color-mask-soft: rgba(17, 24, 39, 0.34);
  --color-mask-strong: rgba(17, 20, 38, 0.52);
  --color-surface-a74: rgba(255, 255, 255, 0.74);
  --color-surface-a90: rgba(255, 255, 255, 0.9);
  --color-surface-a94: rgba(255, 255, 255, 0.94);
  --color-surface-a95: rgba(255, 255, 255, 0.95);
  --color-surface-a96: rgba(255, 255, 255, 0.96);
  --color-surface-soft-a82: rgba(244, 240, 223, 0.82);
  --color-line-a84: rgba(240, 242, 246, 0.84);
  --color-line-strong-a56: rgba(229, 231, 235, 0.56);
  --color-primary-soft-a52: rgba(238, 242, 255, 0.52);
  --color-primary-soft-a55: rgba(238, 242, 255, 0.55);
  --color-primary-soft-a64: rgba(238, 242, 255, 0.64);
  --color-cyan-soft-a58: rgba(236, 254, 255, 0.58);
  --color-warning-a42: rgba(185, 141, 47, 0.42);

  --gradient-brand: var(--figma-gradient-ai);
  --gradient-ai: var(--figma-gradient-ai);
  --gradient-aurora: linear-gradient(
    135deg,
    rgba(97, 95, 255, 0.1),
    rgba(173, 70, 255, 0.08) 52%,
    rgba(246, 51, 154, 0.07)
  );
  --gradient-companion: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 56%, #fdf2f8 100%);
  --gradient-action: var(--figma-gradient-dark);
  --gradient-skeleton: linear-gradient(90deg, #eceef3 25%, #fafbfc 50%, #eceef3 75%);
  --gradient-skeleton-cool: linear-gradient(90deg, #eceef7 25%, #f9faff 50%, #eceef7 75%);
  --gradient-warning: linear-gradient(90deg, #e9963f, #f4c568);

  --shadow-card: var(--figma-shadow-card);
  --shadow-card-strong: var(--figma-shadow-card-strong);
  --shadow-primary: 0 14rpx 36rpx rgba(17, 24, 39, 0.16);
  --shadow-ai: 0 18rpx 48rpx rgba(173, 70, 255, 0.2);
  --shadow-toolbar: 0 8rpx 30rpx rgba(17, 24, 39, 0.025);
  --shadow-toolbar-action: 0 8rpx 20rpx rgba(124, 58, 237, 0.2);
  --shadow-dock: 0 -12rpx 36rpx rgba(17, 24, 39, 0.04);
  --shadow-dock-strong: 0 -20rpx 80rpx rgba(17, 24, 39, 0.12);
  --shadow-reader: 0 -18rpx 60rpx rgba(21, 27, 62, 0.16);
  --shadow-overlay: 0 -20rpx 70rpx rgba(17, 20, 38, 0.22);
  --shadow-primary-soft: 0 12rpx 30rpx rgba(79, 70, 229, 0.18);
  --shadow-community: 0 12rpx 34rpx rgba(45, 52, 94, 0.06);
  --shadow-brain-card: 0 9rpx 34rpx rgba(17, 24, 39, 0.034);
  --shadow-workbench-wide: 0 10px 32px rgba(190, 120, 60, 0.08);
  --gradient-brain-halo: radial-gradient(
    circle at 88% 0%,
    rgba(199, 210, 254, 0.34),
    transparent 27%
  );

  --radius-hero: var(--figma-radius-card-large);
  --radius-card: var(--figma-radius-card-large);
  --radius-control: var(--figma-radius-control);
  --radius-compact: var(--figma-radius-compact);

  --space-page-x: var(--figma-page-inset);
  --space-page-top: var(--figma-space-16);
  --space-section: var(--figma-section-gap);

  --font-title: var(--figma-font-title-large);
  --font-section: var(--figma-font-body-large);
  --font-body: var(--figma-font-body);
  --font-caption: var(--figma-font-micro);
  --font-family-ui: var(--figma-font-family);
  --font-family-reading: var(--figma-font-family);
  --font-family-data: "Maple Mono CN", "DIN Alternate", -apple-system, BlinkMacSystemFont,
    monospace;

  --layout-readable-max: 720px;
  --layout-workbench-max: 1280px;
  --layout-tablet-gutter: 32px;
  --layout-wide-gutter: 40px;

  --z-footer: 20;
  --z-sticky: 30;
  --z-sheet: 70;
  --z-overlay: 100;
  --z-blocker: 110;
}
