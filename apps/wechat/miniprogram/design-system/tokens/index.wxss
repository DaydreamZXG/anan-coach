page {
  --color-canvas: #f3f5fb;
  --color-surface: #ffffff;
  --color-surface-glass: rgba(255, 255, 255, 0.84);
  --color-surface-soft: #f7f8fd;
  --color-ink: #111426;
  --color-ink-secondary: #34384f;
  --color-muted: #7c8199;
  --color-faint: #a7abbd;
  --color-line: rgba(52, 61, 102, 0.11);
  --color-primary: #5268ff;
  --color-primary-deep: #252c72;
  --color-primary-soft: #edf0ff;
  --color-companion: #8b5cf6;
  --color-cyan: #4de2d0;
  --color-success: #168363;
  --color-success-soft: #e5fbf4;
  --color-warning: #a35820;
  --color-warning-soft: #fff3e8;
  --color-danger: #c83f56;
  --color-danger-soft: #fff0f3;
  --color-wechat: #07c160;
  --color-on-primary: #ffffff;
  --gradient-brand: linear-gradient(135deg, #252c72 0%, #5268ff 64%, #7156e9 110%);
  --gradient-companion: linear-gradient(135deg, #edf0ff 0%, #f5f2ff 55%, #e5fbf4 100%);
  --shadow-card: 0 18rpx 54rpx rgba(42, 49, 102, 0.1);
  --shadow-primary: 0 16rpx 38rpx rgba(82, 104, 255, 0.24);
  --radius-hero: 44rpx;
  --radius-card: 32rpx;
  --radius-control: 26rpx;
  --radius-compact: 18rpx;
  --space-page-x: 28rpx;
  --space-page-top: 32rpx;
  --space-section: 40rpx;
  --font-title: 48rpx;
  --font-section: 30rpx;
  --font-body: 28rpx;
  --font-caption: 22rpx;
  --font-family-reading: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-family-data: "Maple Mono Data", "SFMono-Regular", Menlo, Consolas, monospace;
}
