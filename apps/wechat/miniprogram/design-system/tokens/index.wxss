page {
  --color-canvas: #f7f9fc;
  --color-surface: #ffffff;
  --color-surface-glass: rgba(255, 255, 255, 0.92);
  --color-surface-soft: #f7f9fc;
  --color-surface-ai: #eef2ff;
  --color-ink: #101828;
  --color-ink-secondary: #364153;
  --color-muted: #6a7282;
  --color-faint: #99a1af;
  --color-line: #f3f4f6;
  --color-line-strong: #e5e7eb;
  --color-primary: #615fff;
  --color-primary-deep: #4f39f6;
  --color-primary-soft: #eef2ff;
  --color-primary-a08: rgba(97, 95, 255, 0.08);
  --color-primary-a16: rgba(97, 95, 255, 0.16);
  --color-primary-a24: rgba(97, 95, 255, 0.24);
  --color-companion: #615fff;
  --color-cyan: #06b6d4;
  --color-ai-blue: #615fff;
  --color-ai-violet: #ad46ff;
  --color-ai-pink: #f6339a;
  --color-ai-soft: #eef2ff;
  --color-action: #101828;
  --color-action-deep: #030712;
  --color-success: #00a63e;
  --color-success-soft: #ecfdf5;
  --color-warning: #f97316;
  --color-warning-soft: #fff7ed;
  --color-danger: #fb2c36;
  --color-danger-soft: #fef2f2;
  --color-wechat: #07c160;
  --color-on-primary: #ffffff;
  --color-gold: #d9a12f;
  --color-gold-soft: #fcf4df;
  --color-mask: rgba(17, 24, 39, 0.36);
  --gradient-brand: linear-gradient(135deg, #615fff 0%, #ad46ff 50%, #f6339a 100%);
  --gradient-ai: linear-gradient(135deg, #615fff 0%, #ad46ff 50%, #f6339a 100%);
  --gradient-aurora: linear-gradient(135deg, rgba(97, 95, 255, 0.1), rgba(173, 70, 255, 0.08) 52%, rgba(246, 51, 154, 0.07));
  --gradient-companion: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 56%, #fdf2f8 100%);
  --gradient-action: linear-gradient(135deg, #111827 0%, #030712 100%);
  --shadow-card: 0 8rpx 30rpx rgba(17, 24, 39, 0.04);
  --shadow-card-strong: 0 16rpx 60rpx rgba(17, 24, 39, 0.08);
  --shadow-primary: 0 14rpx 36rpx rgba(17, 24, 39, 0.16);
  --shadow-ai: 0 18rpx 48rpx rgba(173, 70, 255, 0.2);
  --radius-hero: 56rpx;
  --radius-card: 64rpx;
  --radius-control: 40rpx;
  --radius-compact: 32rpx;
  --space-page-x: 40rpx;
  --space-page-top: 32rpx;
  --space-section: 48rpx;
  --font-title: 48rpx;
  --font-section: 30rpx;
  --font-body: 28rpx;
  --font-caption: 22rpx;
  --font-family-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-reading: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-data: "Maple Mono CN", "DIN Alternate", -apple-system, BlinkMacSystemFont, monospace;
  --layout-readable-max: 720px;
  --layout-workbench-max: 1280px;
  --layout-tablet-gutter: 32px;
  --layout-wide-gutter: 40px;
  /* 层级统一出口：弹层/遮罩一律引用，禁止再写魔法数字 */
  --z-footer: 20;
  --z-sticky: 30;
  --z-sheet: 70;
  --z-overlay: 100;
  --z-blocker: 110;
}
