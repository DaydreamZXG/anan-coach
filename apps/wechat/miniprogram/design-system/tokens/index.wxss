page {
  --color-canvas: #edf3f1;
  --color-surface: #ffffff;
  --color-surface-glass: rgba(255, 255, 255, 0.94);
  --color-surface-soft: #f3f7f5;
  --color-ink: #17211f;
  --color-ink-secondary: #354541;
  --color-muted: #70827d;
  --color-faint: #9aaba6;
  --color-line: #dde6e3;
  --color-line-strong: #c7d7d2;
  --color-primary: #00978b;
  --color-primary-deep: #006e66;
  --color-primary-soft: #e7f7f3;
  --color-companion: #00978b;
  --color-cyan: #16b8aa;
  --color-success: #087c61;
  --color-success-soft: #e7f7f3;
  --color-warning: #9a6719;
  --color-warning-soft: #fff4df;
  --color-danger: #d93853;
  --color-danger-soft: #fff0f3;
  --color-wechat: #07c160;
  --color-on-primary: #ffffff;
  --color-gold: #e2a542;
  --color-gold-soft: #fff4df;
  --gradient-brand: linear-gradient(135deg, #007e74 0%, #00a497 100%);
  --gradient-companion: linear-gradient(135deg, #e7f7f3 0%, #f5faf8 100%);
  --shadow-card: 0 16rpx 34rpx rgba(32, 67, 58, 0.08);
  --shadow-primary: 0 18rpx 36rpx rgba(0, 151, 139, 0.2);
  --radius-hero: 40rpx;
  --radius-card: 32rpx;
  --radius-control: 26rpx;
  --radius-compact: 14rpx;
  --space-page-x: 28rpx;
  --space-page-top: 32rpx;
  --space-section: 40rpx;
  --font-title: 48rpx;
  --font-section: 30rpx;
  --font-body: 28rpx;
  --font-caption: 22rpx;
  --font-family-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-reading: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-data: "Maple Mono CN", "DIN Alternate", -apple-system, BlinkMacSystemFont, monospace;
  --layout-readable-max: 720px;
  --layout-workbench-max: 1280px;
  --layout-tablet-gutter: 32px;
  --layout-wide-gutter: 40px;
}
