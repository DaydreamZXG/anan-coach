page {
  /* C 方向 · 温暖陪伴：奶油底 + 柿子橙 + 暖墨字 */
  --color-canvas: #faf3ea;
  --color-surface: #ffffff;
  --color-surface-glass: rgba(255, 251, 245, 0.94);
  --color-surface-soft: #f5ede1;
  --color-ink: #2e2418;
  --color-ink-secondary: #5b4a35;
  --color-muted: #8a7357;
  --color-faint: #b3a189;
  --color-line: #f0e3d0;
  --color-line-strong: #ead9c4;
  --color-primary: #e0601f;
  --color-primary-deep: #c2502e;
  --color-primary-soft: #fdeee2;
  --color-primary-a08: rgba(224, 96, 31, 0.08);
  --color-primary-a16: rgba(224, 96, 31, 0.16);
  --color-primary-a24: rgba(224, 96, 31, 0.24);
  --color-companion: #e0601f;
  --color-cyan: #f07b2d;
  --color-success: #2f9e6e;
  --color-success-soft: #e6f4ec;
  --color-warning: #b98d2f;
  --color-warning-soft: #fdf6e3;
  --color-danger: #d5464f;
  --color-danger-soft: #fcedee;
  --color-wechat: #07c160;
  --color-on-primary: #ffffff;
  --color-gold: #e0a01f;
  --color-gold-soft: #fdf3e0;
  --color-mask: rgba(46, 36, 24, 0.45);
  --gradient-brand: linear-gradient(135deg, #f07b2d 0%, #e0601f 100%);
  --gradient-companion: linear-gradient(135deg, #fff8ef 0%, #ffeedd 100%);
  --shadow-card: 0 12rpx 40rpx rgba(190, 120, 60, 0.08);
  --shadow-primary: 0 20rpx 40rpx rgba(224, 96, 31, 0.28);
  --radius-hero: 40rpx;
  --radius-card: 32rpx;
  --radius-control: 26rpx;
  --radius-compact: 14rpx;
  --space-page-x: 28rpx;
  --space-page-top: 32rpx;
  --space-section: 40rpx;
  --font-title: 48rpx;
  --font-section: 30rpx;
  --font-body: 28rpx;
  --font-caption: 22rpx;
  --font-family-ui: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-reading: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --font-family-data: "Maple Mono CN", "DIN Alternate", -apple-system, BlinkMacSystemFont, monospace;
  --layout-readable-max: 720px;
  --layout-workbench-max: 1280px;
  --layout-tablet-gutter: 32px;
  --layout-wide-gutter: 40px;
  /* 层级统一出口：弹层/遮罩一律引用，禁止再写魔法数字 */
  --z-footer: 20;
  --z-sticky: 30;
  --z-sheet: 70;
  --z-overlay: 100;
  --z-blocker: 110;
}
