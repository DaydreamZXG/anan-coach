<view class="tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{active === item.key ? 'active' : ''}} {{item.key === 'anan' ? 'anan' : ''}}"
    data-path="{{item.pagePath}}"
    data-key="{{item.key}}"
    bindtap="onTap"
  >
    <view class="tab-dot" aria-hidden="true"></view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
