<view class="tab-bar" role="tablist" aria-label="主导航">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{active === item.key ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    data-key="{{item.key}}"
    role="tab"
    aria-label="{{item.text}}"
    aria-selected="{{active === item.key}}"
    hover-class="tab-item--pressed"
    bindtap="onTap"
  >
    <view class="tab-icon-wrap">
      <image
        class="tab-icon"
        src="{{active === item.key ? item.activeIcon : item.icon}}"
        mode="aspectFit"
        aria-hidden="true"
      />
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
