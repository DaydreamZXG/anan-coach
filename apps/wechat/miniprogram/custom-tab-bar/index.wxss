.dock-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(247, 248, 250, 0.96) 55%, rgba(247, 248, 250, 0));
}

.dock {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(16, 19, 27, 0.1);
  border-radius: 44rpx;
  padding: 14rpx;
  box-shadow: 0 20rpx 60rpx rgba(16, 19, 27, 0.14);
}

.slot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 0 8rpx;
  border-radius: 30rpx;
}

.slot--pressed {
  opacity: 0.7;
}

/* 注意：自定义 tabBar 不继承 page 上的 CSS 变量，这里必须用字面量 */

.slot__tile {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #9aa3b8;
  background: transparent;
}

.slot__label {
  font-size: 20rpx;
  color: #9aa3b8;
  letter-spacing: 0.04em;
}

.slot--on {
  background: rgba(91, 95, 244, 0.09);
}

.slot--on .slot__tile {
  background: linear-gradient(120deg, #5b5ff4 0%, #8b5cf6 55%, #22d3ee 130%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(91, 95, 244, 0.4);
}

.slot--on .slot__label {
  color: #10131b;
  font-weight: 700;
}
