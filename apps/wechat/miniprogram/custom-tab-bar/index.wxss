.tab-bar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(env(safe-area-inset-bottom, 16px) + 24rpx);
  display: flex;
  align-items: center;
  width: calc(100% - 48rpx);
  max-width: 420px;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 48rpx rgba(41, 72, 125, 0.18);
  padding: 10rpx;
  box-sizing: border-box;
  z-index: 100;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}
.tab-dot {
  display: none;
}
.tab-text {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  color: #9ea8b5;
  padding: 18rpx 0;
  border-radius: 999rpx;
  transition: all 0.2s;
}
.tab-item.active .tab-text {
  color: #3d7eff;
  font-weight: 700;
  background: #ecf2ff;
}
.tab-item.anan.active .tab-text {
  color: #e8833a;
  background: #fbf0e6;
}
