.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e9ecf0;
  padding-bottom: env(safe-area-inset-bottom);
  height: 112rpx;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tab-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: transparent;
  transition: background 0.2s;
}
.tab-text {
  font-size: 26rpx;
  color: #9aa3ae;
  transition: color 0.2s;
}
.tab-item.active .tab-text { color: #2b6cb0; font-weight: 600; }
.tab-item.active .tab-dot { background: #2b6cb0; }
.tab-item.anan.active .tab-text { color: #e8833a; }
.tab-item.anan.active .tab-dot { background: #e8833a; }
