@import "../design-system/tokens/component-host.tokens.wxss";

.tab-bar {
  position: fixed;
  z-index: var(--z-sticky);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: calc(26 * var(--rpx)) calc(48 * var(--rpx))
    max(calc(64 * var(--rpx)), env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--figma-color-line);
  background: var(--figma-color-surface);
}

.tab-item {
  position: relative;
  display: flex;
  width: calc(128 * var(--rpx));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(12 * var(--rpx));
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  width: calc(48 * var(--rpx));
  height: calc(48 * var(--rpx));
  align-items: center;
  justify-content: center;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: calc(48 * var(--rpx));
  height: calc(48 * var(--rpx));
}

.tab-text {
  color: var(--figma-color-faint);
  font-size: var(--text-tab);
  font-weight: 500;
  line-height: calc(30 * var(--rpx));
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: var(--figma-color-ink);
}

.tab-item--pressed {
  opacity: 0.72;
}

/* 平板：底部悬浮胶囊 Tab（居中、圆角全包、轻投影）。 */
@media (min-width: 600px) {
  .tab-bar {
    right: 50%;
    bottom: calc(16px + env(safe-area-inset-bottom));
    left: auto;
    width: auto;
    gap: 6px;
    padding: 6px 10px;
    border: 1px solid var(--figma-color-line);
    border-top: 1px solid var(--figma-color-line);
    border-radius: 999px;
    box-shadow: var(--shadow-dock-strong);
    transform: translateX(50%);
  }

  .tab-item {
    width: 84px;
    padding: 8px 0;
    border-radius: 999px;
  }

  .tab-item.active {
    background: var(--color-primary-soft);
  }
}
