@import "../design-system/tokens/component-host.tokens.wxss";

.tab-bar {
  position: fixed;
  z-index: var(--z-sticky);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: calc(26 * var(--rpx)) calc(48 * var(--rpx))
    max(calc(64 * var(--rpx)), env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--figma-color-line);
  background: var(--figma-color-surface);
}

.tab-item {
  position: relative;
  display: flex;
  width: calc(128 * var(--rpx));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(12 * var(--rpx));
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  width: calc(48 * var(--rpx));
  height: calc(48 * var(--rpx));
  align-items: center;
  justify-content: center;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: calc(48 * var(--rpx));
  height: calc(48 * var(--rpx));
}

.tab-text {
  color: var(--figma-color-faint);
  font-size: var(--text-tab);
  font-weight: 500;
  line-height: calc(30 * var(--rpx));
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: var(--figma-color-ink);
}

.tab-item--pressed {
  opacity: 0.72;
}

/* 平板：底栏变左侧导航轨（粉笔式三段布局的第一段）。 */
@media (min-width: 768px) {
  .tab-bar {
    top: 0;
    right: auto;
    bottom: 0;
    left: 0;
    width: var(--layout-tab-rail, 96px);
    flex-direction: column;
    justify-content: flex-start;
    gap: 12px;
    padding: calc(28px + env(safe-area-inset-top)) 10px calc(20px + env(safe-area-inset-bottom));
    border-top: 0;
    border-right: calc(1 * var(--rpx)) solid var(--figma-color-line);
  }

  .tab-item {
    width: 100%;
    padding: 12px 0;
    border-radius: 14px;
  }

  .tab-item.active {
    background: var(--color-primary-soft);
  }
}
