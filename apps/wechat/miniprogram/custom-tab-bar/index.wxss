.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: none;
  box-shadow: 0 -6rpx 24rpx rgba(41, 72, 125, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  height: 112rpx;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}
.tab-dot {
  display: none;
}
.tab-text {
  font-size: 28rpx;
  color: #9ea8b5;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  transition: all 0.2s;
}
.tab-item.active .tab-text {
  color: #3d7eff;
  font-weight: 700;
  background: #ecf2ff;
}
.tab-item.anan.active .tab-text {
  color: #e8833a;
  background: #fbf0e6;
}
