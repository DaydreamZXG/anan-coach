.tab-bar {
  position: fixed;
  z-index: var(--z-sticky);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 26rpx 48rpx max(64rpx, env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--figma-color-line);
  background: rgba(255, 255, 255, 0.8);
}

.tab-item {
  position: relative;
  display: flex;
  width: 128rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  position: relative;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  color: var(--figma-color-faint);
  font-size: var(--figma-font-tab);
  font-weight: 500;
  line-height: 30rpx;
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: var(--figma-color-ink);
}

.tab-item--pressed {
  opacity: 0.72;
}

@media (min-width: 768px) {
  .tab-bar {
    right: 50%;
    left: auto;
    width: min(100%, 720px);
    transform: translateX(50%);
  }
}
