/* 报告中心：骨架、卡片与按钮来自 s9；保留卷面状态、外部入口
 * 与报告网格等页面特有节点。 */

.center-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.center-time {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.paper-list,
.report-grid {
  display: grid;
  gap: 20rpx;
}

.paper-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.paper-status {
  padding: 8rpx 12rpx;
  border-radius: var(--radius-capsule);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.paper-version {
  max-width: 62%;
  color: var(--color-faint);
  font-size: var(--text-micro);
  text-align: right;
}

.paper-title,
.external-title,
.latest-title,
.report-card__title {
  margin-top: 16rpx;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.paper-meta,
.paper-definition,
.external-copy,
.latest-meta,
.report-card__copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.paper-action,
.report-card__arrow {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-weight: 600;
}

.external-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: var(--color-primary-soft);
}

.external-arrow {
  color: var(--color-muted);
  font-size: var(--text-hero);
}

.latest-label,
.report-card__state {
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.report-grid {
  grid-template-columns: 1fr 1fr;
}

.report-card--ready {
  border-top: 5rpx solid var(--color-primary);
}

.report-card--partial {
  border-top: 5rpx solid var(--figma-color-warning);
}

.report-card--empty {
  border-top: 5rpx solid var(--figma-color-line-emphasis);
}

@media (min-width: 1024px) {
  .paper-list,
  .report-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
