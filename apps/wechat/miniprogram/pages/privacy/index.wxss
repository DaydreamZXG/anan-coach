.privacy-page { padding-bottom: 92rpx; }
.privacy-state-view { display: block; margin-top: 28rpx; }
.privacy-secondary { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 24rpx; border: 1rpx solid var(--color-line-strong); border-radius: 24rpx; background: #fff; color: var(--color-ink); font-size: 25rpx; font-weight: 800; }
.export-copy { margin-top: 0; }
.export-state { margin-top: 20rpx; color: var(--color-primary-deep); font-size: 23rpx; font-weight: 750; }
.danger-heading .s9-section-title, .danger-heading .s9-section-meta { color: var(--color-danger); }
.deletion-copy { display: flex; gap: 14rpx; margin-top: 12rpx; color: var(--color-ink-secondary); font-size: 22rpx; line-height: 1.55; }
.danger-dot { flex: 0 0 auto; width: 9rpx; height: 9rpx; margin-top: 13rpx; border-radius: 50%; background: var(--color-danger); }
.phrase-label { margin-top: 28rpx; color: var(--color-muted); font-size: 21rpx; }
.phrase-label__value { color: var(--color-danger); font-weight: 800; }
.phrase-input { box-sizing: border-box; height: 88rpx; margin-top: 14rpx; padding: 0 22rpx; border: 1rpx solid rgba(217,56,83,.22); border-radius: 20rpx; background: #fff; font-size: 24rpx; }
.delete-button { margin-top: 22rpx; padding: 0; background: transparent; color: var(--color-danger); font-size: 24rpx; font-weight: 800; text-align: left; }
.delete-button--disabled { color: var(--color-faint); }
