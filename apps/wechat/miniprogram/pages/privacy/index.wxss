.privacy-page {
  padding-bottom: 96rpx;
}
.privacy-state-view {
  display: block;
  margin-top: 28rpx;
}
.privacy-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 800;
}
.export-copy {
  margin-top: 0;
}
.export-state {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 700;
}
.danger-heading .s9-section-title,
.danger-heading .s9-section-meta {
  color: var(--color-danger);
}
.deletion-copy {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.danger-dot {
  flex: 0 0 auto;
  width: 9rpx;
  height: 9rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-danger);
}
.phrase-label {
  margin-top: 28rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.phrase-label__value {
  color: var(--color-danger);
  font-weight: 800;
}
.phrase-input {
  box-sizing: border-box;
  height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(213, 70, 79, 0.22);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  font-size: var(--text-caption);
}
.delete-button {
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  color: var(--color-danger);
  font-size: var(--text-caption);
  font-weight: 800;
  text-align: left;
}
.delete-button--disabled {
  color: var(--color-faint);
}
