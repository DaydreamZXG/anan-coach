<view class="s9-page privacy-page">
  <view class="s9-hero">
    <view class="s9-title">你的学习数据，由你决定</view>
    <view class="s9-subtitle">资料只用于个人诊断、计划与反馈，所有授权都可追溯。</view>
    <view class="s9-chip-row"><view class="s9-chip s9-chip--primary">可导出</view><view class="s9-chip">可删除</view></view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" custom-class="privacy-state-view" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" custom-class="privacy-state-view" state="error" title="数据清单没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />

  <block wx:else>
    <view class="s9-stack">
      <view class="s9-card">
        <view class="s9-card-kicker">数据用途</view>
        <view class="s9-card-title">只服务你的学习闭环</view>
        <view class="s9-card-copy">讲义、笔记和模考卷只用于分析你的学习情况，不会公开。</view>
        <view class="s9-card-meta">上传前明确告知用途 · {{overview.policyVersion}}</view>
      </view>
      <view class="s9-card s9-card--primary">
        <view class="s9-card-kicker">控制权</view>
        <view class="s9-card-title">查看、导出与删除都由你发起</view>
        <view class="s9-card-copy">{{overview.rawMaterialRetention}}</view>
        <view class="s9-card-meta">删除账户前建议先导出个人数据</view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">我的数据清单</view><view class="s9-section-meta">实时更新</view></view>
      <view class="s9-list">
        <view class="s9-list-row" wx:for="{{categories}}" wx:key="category"><view class="s9-list-main"><view class="s9-list-title">{{item.title}}</view><view class="s9-list-copy">{{item.retention}}</view></view><view class="s9-list-value type-data">{{item.countLabel}}</view></view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">导出个人数据</view><view class="s9-section-meta">生成后 24 小时过期</view></view>
      <view class="s9-card export-card">
        <view class="s9-card-copy export-copy">包含账户、资格岗位、学习证据、原始材料元数据、报告、订单和权益；不包含密钥和第三方支付凭据。</view>
        <button wx:if="{{!exportRequest}}" class="privacy-secondary" loading="{{exporting}}" bindtap="createExport">生成数据导出</button>
        <block wx:else><view class="export-state">当前状态：{{exportRequest.state}}</view><button wx:if="{{exportRequest.state !== 'completed'}}" class="privacy-secondary" bindtap="refreshExport">刷新生成状态</button><button wx:else class="privacy-secondary" loading="{{openingExport}}" bindtap="openExport">保存或转发导出文件</button></block>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head danger-heading"><view class="s9-section-title">删除账户</view><view class="s9-section-meta">不可恢复</view></view>
      <view class="s9-card s9-card--danger deletion-card">
        <view class="deletion-copy" wx:for="{{overview.accountDeletionEffect}}" wx:key="*this"><text class="danger-dot"></text><text>{{item}}</text></view>
        <view class="phrase-label">请完整输入：<text class="phrase-label__value">{{confirmationPhrase}}</text></view>
        <input class="phrase-input" value="{{deletionPhrase}}" placeholder="输入确认短语" bindinput="onDeletionPhraseInput" />
        <button class="delete-button {{deletionPhrase !== confirmationPhrase ? 'delete-button--disabled' : ''}}" disabled="{{deletionPhrase !== confirmationPhrase}}" loading="{{deleting}}" bindtap="requestDeletion">删除我的账户</button>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="s9-inline-error">{{errorMessage}}</view>
  </block>
</view>
