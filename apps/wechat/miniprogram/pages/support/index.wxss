.support-page {
  padding-bottom: calc(96 * var(--rpx));
}
.support-hero {
  padding: calc(28 * var(--rpx)) calc(4 * var(--rpx)) calc(8 * var(--rpx));
}
.support-title {
  max-width: calc(620 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-title-lg);
  font-weight: 800;
  line-height: 1.18;
}
.support-copy {
  max-width: calc(640 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.72;
}
.qr-card {
  margin-top: calc(28 * var(--rpx));
  text-align: center;
}
.group-qr {
  display: block;
  width: calc(440 * var(--rpx));
  height: calc(440 * var(--rpx));
  margin: calc(24 * var(--rpx)) auto 0;
  border-radius: var(--radius-32);
  background: var(--color-surface);
}
button.qr-action {
  width: 100%;
  margin-top: calc(24 * var(--rpx));
}
.support-note {
  margin-top: calc(24 * var(--rpx));
}
button.support-contact {
  width: 100%;
  margin-top: calc(24 * var(--rpx));
}
