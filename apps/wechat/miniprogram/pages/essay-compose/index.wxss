@import "../../features/essay-workbench/page-shell.wxss";
.compose-page {
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}
.compose-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-surface-soft);
}
.compose-action-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: var(--color-surface-a96);
  box-shadow: var(--shadow-dock);
}
.compose-action-grid {
  margin-top: 0;
}
.compose-action-grid .workbench-action {
  width: 100%;
  margin-top: 0;
}

@media (min-width: 768px) {
  .compose-page {
    padding-bottom: calc(128px + env(safe-area-inset-bottom));
  }
  .compose-action-dock {
    right: 50%;
    left: auto;
    width: calc(100% - 64px);
    max-width: 760px;
    padding: 14px 32px calc(14px + env(safe-area-inset-bottom));
    transform: translateX(50%);
  }
}

@media (min-width: 1024px) {
  .compose-action-dock {
    width: calc(100% - 80px);
    max-width: 1120px;
    padding-right: 40px;
    padding-left: 40px;
  }
}

/* 平板宽屏：要点与提纲并列两列，正文与操作坞满宽（申论编辑器本体在 H5 内）。 */
@media (min-width: 1024px) {
  .compose-page {
    display: grid;
    align-content: start;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
  }

  .compose-page > .workbench-hero,
  .compose-page > .workbench-card--full,
  .compose-page > .compose-action-dock,
  .compose-page > state-view {
    grid-column: 1 / -1;
  }
}
