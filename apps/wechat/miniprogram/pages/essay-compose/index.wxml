<view class="workbench-page compose-page">
  <view class="workbench-hero"><view class="workbench-kicker">申论作答工作台</view><view class="workbench-title">自己的要点，先于 AI 的答案</view><view class="workbench-copy">先保存找点、结构与正文，再进入评阅；提交前不会用参考答案覆盖你的判断。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="作答工作台没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="{{retryAllowed ? '重新加载' : ''}}" bind:action="retryLoad" />
  <block wx:elif="{{workspace}}">
    <view class="workbench-card"><view class="workbench-section-title">我的要点</view><view wx:if="{{!points.length}}" class="workbench-note">还没有整理出要点。</view><view wx:for="{{points}}" wx:key="pointId" class="compose-row"><view class="workbench-row-title">{{item.order}}. {{item.statement}}</view><view class="workbench-meta">{{item.category}} · {{item.sourceCount}} 个材料锚点</view></view></view>
    <view class="workbench-card"><view class="workbench-section-title">我的提纲</view><view wx:if="{{!outline.length}}" class="workbench-note">还没有列出提纲。</view><view wx:for="{{outline}}" wx:key="sectionId" class="compose-row"><view class="workbench-row-title">{{item.order}}. {{item.heading}}</view><view class="workbench-note">{{item.argument}}</view><view class="workbench-meta">计划 {{item.plannedWords}} 字</view></view></view>
    <view class="workbench-card"><view class="workbench-section-title">正文版本</view><block wx:if="{{answer}}"><view class="workbench-grid"><view class="workbench-metric"><view class="workbench-meta">实时字数</view><text class="workbench-metric__value">{{answer.wordCount}} / {{workspace.task.wordLimit}}</text></view><view class="workbench-metric"><view class="workbench-meta">录入来源</view><text class="workbench-metric__value">{{answer.sourceLabel}}</text></view></view><view class="workbench-text">{{answer.text}}</view><button wx:if="{{answer.hasOriginal}}" class="workbench-secondary-action {{openingOriginal ? 'workbench-secondary-action--disabled' : ''}}" loading="{{openingOriginal}}" disabled="{{openingOriginal}}" bindtap="openOriginal">查看已确认手写原图</button></block><view wx:else class="workbench-note">还没有定稿的正文。</view></view>
    <view class="compose-action-dock"><view class="workbench-grid compose-action-grid"><button class="workbench-action {{!outlineUrl ? 'workbench-action--disabled' : ''}}" disabled="{{!outlineUrl}}" bindtap="openOutline">编辑提纲</button><button class="workbench-action {{!draftingUrl ? 'workbench-action--disabled' : ''}}" disabled="{{!draftingUrl}}" bindtap="openDrafting">进入正文</button></view></view>
  </block>
</view>
