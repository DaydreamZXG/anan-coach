.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 220rpx;
}

.is-pressed {
  opacity: 0.75;
}

.nav {
  padding: 0 32rpx 32rpx;
}

.nav__bar {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.nav__back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__title {
  padding-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.field {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
}

.field__label {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option {
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  color: var(--ink-2);
}

.option.is-active {
  border: 1rpx solid transparent;
  background:
    linear-gradient(var(--surface), var(--surface)) padding-box,
    var(--grad-main) border-box;
  color: var(--ink);
  font-weight: 600;
}

.input {
  height: 92rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--bg);
  font-size: 28rpx;
}

.input__ph {
  color: var(--ink-3);
  font-size: 26rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 250, 0), var(--bg) 45%);
}
