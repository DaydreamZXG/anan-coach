.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.75;
}

.nav {
  padding: 0 32rpx 32rpx;
}

.nav__bar {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.nav__back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__title {
  padding-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.sec {
  margin: 8rpx 32rpx 24rpx;
}

.pos {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
}

.pos__name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}

.pos__name--sm {
  font-size: 28rpx;
}

.pos__meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.pos__score {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--r-sm);
  background: var(--bg);
}

.pos__score-label {
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 0.08em;
}

.pos__score-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.pos__evidence {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
