.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.75;
}

.nav {
  padding: 0 32rpx;
}

.nav__bar {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.nav__back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink-2);
  line-height: 1;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 56rpx;
}

.brand__logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: var(--grad-main);
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
}

.brand__name {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.brand__ver {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.intro {
  margin: 0 32rpx 24rpx;
  padding: 28rpx;
}

.intro__text {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.9;
}

.links {
  margin: 0 32rpx;
  overflow: hidden;
}

.link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.link:last-child {
  border-bottom: none;
}

.link__name {
  font-size: 28rpx;
  font-weight: 600;
}

.link__arrow {
  font-size: 32rpx;
  color: var(--ink-3);
  line-height: 1;
}

.foot {
  margin-top: 64rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}
