.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.75;
}

.nav {
  padding: 0 32rpx 32rpx;
}

.nav__bar {
  display: flex;
  align-items: center;
  height: 72rpx;
}

.nav__back {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__title {
  padding-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.group {
  margin: 0 32rpx 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row__text {
  flex: 1;
}

.row__name {
  font-size: 28rpx;
  font-weight: 600;
}

.row__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}
