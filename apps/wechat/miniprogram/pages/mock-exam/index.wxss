.page-state {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.capability-state {
  margin-top: calc(80 * var(--rpx));
  padding: calc(40 * var(--rpx));
}
.capability-mark {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 0.12em;
}
.capability-title {
  margin-top: calc(16 * var(--rpx));
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.capability-copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-muted);
  line-height: 1.7;
}
.capability-action {
  margin-top: calc(28 * var(--rpx));
}

.mock-paper {
  min-height: 100%;
  font-size: var(--text-body-lg);
  transition:
    background 180ms ease,
    font-size 180ms ease;
}
.mock-paper--large {
  font-size: var(--text-section);
}
.mock-paper--eye-care {
  margin: calc(-30 * var(--rpx)) calc(var(--space-page-x) * -1) 0;
  padding: calc(30 * var(--rpx)) var(--space-page-x);
  background: var(--good-soft);
}
.inline-warning {
  margin-bottom: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-compact);
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.exam-status-card {
  display: grid;
  grid-template-columns: repeat(3, auto) 1fr;
  align-items: center;
  gap: calc(20 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.exam-status-card .type-data {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 800;
}
.deadline-copy {
  text-align: right;
}

.material-panel {
  margin-top: calc(24 * var(--rpx));
  padding: calc(28 * var(--rpx));
}
.material-head,
.draft-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
}
.material-eyebrow {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 0.12em;
}
.material-title,
.draft-title {
  margin-top: calc(4 * var(--rpx));
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.material-copy {
  margin-top: calc(24 * var(--rpx));
  color: var(--color-ink-secondary);
  font-family: var(--font-family-reading);
  font-size: var(--text-body-lg);
  line-height: 1.9;
  text-align: justify;
  white-space: pre-wrap;
}

.question-card {
  padding: calc(32 * var(--rpx)) calc(4 * var(--rpx)) calc(24 * var(--rpx));
}
.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 题型胶囊与行测做题页同款（Figma 2:77）。 */
.module-pill {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  overflow: hidden;
  padding: calc(8 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-64);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(33 * var(--rpx));
  text-overflow: ellipsis;
  white-space: nowrap;
}
.question-position {
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.question-stem {
  margin-top: calc(24 * var(--rpx));
  color: var(--color-ink);
  font-size: inherit;
  font-weight: 600;
  line-height: 1.75;
}
/* 选项区与行测做题页同源（Figma 2:142–2:166），整卷只在计时/答题卡上有差异。 */
.option-list {
  display: grid;
  gap: calc(24 * var(--rpx));
  grid-auto-rows: 1fr;
}
.option-list--locked {
  pointer-events: none;
  opacity: 0.65;
}
.option-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) calc(96 * var(--rpx));
  align-items: stretch;
  gap: calc(16 * var(--rpx));
}
.option-card {
  display: grid;
  grid-template-columns: calc(48 * var(--rpx)) minmax(0, 1fr);
  align-items: center;
  gap: calc(24 * var(--rpx));
  min-height: 0;
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-line);
  border-radius: var(--radius-40);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-crisp);
}
.option-card--selected {
  border-color: var(--color-primary-soft-strong);
  background: var(--color-primary-soft-a64);
  box-shadow: var(--shadow-crisp);
}
.option-card--eliminated {
  border-color: var(--figma-color-line-strong);
  background: transparent;
  box-shadow: none;
  opacity: 0.4;
}
.option-label {
  display: flex;
  width: calc(48 * var(--rpx));
  height: calc(48 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--figma-color-muted);
  background: var(--figma-color-line);
  font-family: var(--font-family-data);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(39 * var(--rpx));
}
.option-card--selected .option-label {
  color: var(--color-on-primary);
  background: var(--color-primary);
}
.option-card--eliminated .option-label {
  color: var(--figma-color-faint);
  background: var(--figma-color-line-strong);
}
.option-copy {
  padding-top: calc(4 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 500;
  line-height: calc(48.75 * var(--rpx));
  /* 选项两行时均衡断行，消除句尾单字孤行（不支持的内核自动回退）。 */
  --content-text-wrap: balance;
}
.option-card--eliminated .option-copy {
  color: var(--figma-color-muted);
  font-weight: 400;
  text-decoration: line-through;
}
.eliminate-action {
  display: flex;
  width: calc(96 * var(--rpx));
  min-width: calc(96 * var(--rpx));
  height: auto;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: calc(1 * var(--rpx)) solid var(--figma-color-line);
  border-radius: var(--radius-40);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-crisp);
}
.eliminate-action::after {
  border: 0;
}
.eliminate-action--active {
  border-color: transparent;
  background: var(--figma-color-line-strong);
  box-shadow: none;
}
.eliminate-action__icon {
  display: block;
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

.draft-card {
  margin-top: calc(28 * var(--rpx));
  padding: calc(28 * var(--rpx));
}
.draft-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.mark-button {
  margin: 0;
  padding: 0 calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.mark-button--active {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.draft-input {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(180 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-compact);
  background: var(--color-surface-soft);
  font-family: var(--font-family-data);
  font-size: var(--text-caption);
  line-height: 1.65;
}
.help-sheet {
  padding: 0 0 calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
}

.draft-input--sheet {
  min-height: calc(320 * var(--rpx));
}

.mock-timer-notice {
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-compact);
  color: var(--color-muted);
  background: var(--color-surface-soft);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.draft-sheet-action {
  width: 100%;
  margin-top: calc(24 * var(--rpx));
}
.sheet-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: calc(12 * var(--rpx));
  padding-bottom: calc(40 * var(--rpx));
}
.sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: calc(66 * var(--rpx));
  margin: 0;
  padding: 0;
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-12);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}
.sheet-item--answered {
  border-color: rgba(22, 131, 99, 0.35);
  background: var(--color-success-soft);
  color: var(--color-success);
}
.sheet-item--marked {
  border-color: rgba(185, 141, 47, 0.35);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.sheet-item--active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 calc(3 * var(--rpx)) var(--color-primary-a16);
}

.display-tools {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}
.tool-chip,
.tool-row {
  margin: 0;
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-compact);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
}
.tool-chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}
.tool-row {
  margin-top: calc(16 * var(--rpx));
  text-align: left;
}
.tool-row--submit {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
.help-result {
  margin: 0 calc(32 * var(--rpx)) calc(28 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-compact);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.help-result--error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.dispute-categories {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(12 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}
.dispute-description {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(220 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-compact);
  background: var(--color-surface-soft);
  font-size: var(--text-caption);
  line-height: 1.65;
}
.dispute-body .help-result {
  margin: calc(20 * var(--rpx)) 0;
}
.dispute-body .primary-button {
  margin-top: calc(20 * var(--rpx));
}

.footer-actions,
.footer-next {
  width: 100%;
}
.footer-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  gap: calc(16 * var(--rpx));
}
.footer-previous {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(88 * var(--rpx));
  margin: 0;
  border: 0;
  border-radius: var(--radius-32);
  background: var(--color-canvas);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(88 * var(--rpx));
}
.footer-previous::after {
  border: 0;
}
.footer-previous--disabled {
  opacity: 0.38;
}
.submitted-workspace {
  padding: calc(20 * var(--rpx)) 0 calc(64 * var(--rpx));
}
.submitted-hero {
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx));
  border-radius: var(--radius-hero);
  border: calc(1 * var(--rpx)) solid var(--primary-soft);
  background:
    radial-gradient(circle at 84% 8%, rgba(199, 210, 254, 0.5), transparent 30%),
    var(--color-surface);
  color: var(--ink);
  text-align: center;
  box-shadow: var(--shadow-primary);
}
.submitted-mark {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 0.12em;
}
.submitted-score {
  margin-top: calc(20 * var(--rpx));
  font-size: var(--text-body-lg);
}
.submitted-score__value {
  font-family: var(--font-family-data);
  font-size: var(--text-stat-lg);
  font-weight: 800;
}
.submitted-source {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-micro);
  line-height: 1.5;
  color: var(--ink-2);
}
.submitted-note,
.module-result,
.next-week {
  margin-top: calc(20 * var(--rpx));
  padding: calc(28 * var(--rpx));
}
.submitted-note-title {
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.submitted-note-copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}
.module-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.module-result-data {
  color: var(--color-muted);
}
.next-week {
  color: var(--color-ink-secondary);
  line-height: 1.7;
}
.submitted-workspace > .primary-button {
  margin-top: calc(24 * var(--rpx));
}

@media (min-width: 768px) {
  .mock-paper,
  .submitted-workspace,
  .page-state,
  .capability-state {
    max-width: 820px;
    margin-right: auto;
    margin-left: auto;
  }

  .mock-paper {
    font-size: 17px;
  }

  .mock-paper--large {
    font-size: 20px;
  }

  .exam-status-card {
    gap: 16px;
    padding: 16px 18px;
    font-size: 13px;
  }

  .exam-status-card .type-data {
    font-size: 16px;
  }

  .question-card {
    padding: 24px 4px 18px;
  }

  .module-pill,
  .question-position {
    font-size: 13px;
  }

  .question-stem {
    margin-top: 16px;
  }

  .option-list {
    gap: 12px;
  }

  .option-card {
    grid-template-columns: 38px minmax(0, 1fr) 44px;
    gap: 12px;
    min-height: 72px;
    padding: 12px;
    border-width: 1px;
    border-radius: 15px;
  }

  .option-label {
    width: 36px;
    height: 36px;
  }

  .eliminate-action {
    width: 44px;
    min-width: 44px;
    height: 44px;
    border-radius: 14px;
    font-size: 21px;
    line-height: 1;
  }

  .sheet-grid {
    grid-template-columns: repeat(12, 1fr);
    gap: 8px;
  }

  .sheet-item {
    height: 44px;
    border-radius: 9px;
    font-size: 13px;
  }
}

@media (min-width: 1024px) {
  .mock-paper {
    max-width: none;
  }

  .mock-workspace {
    display: grid;
    grid-template-columns: minmax(360px, 0.95fr) minmax(0, 1.15fr);
    align-items: start;
    gap: 32px;
  }

  .mock-workspace--single .mock-question-pane {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 800px;
    justify-self: center;
  }

  .mock-material-pane {
    position: sticky;
    top: 84px;
    min-width: 0;
    max-height: calc(100vh - 180px);
    overflow-y: auto;
  }

  .mock-question-pane {
    min-width: 0;
  }
}

/* ===== Figma 98:173-98:203 · 模考交卷确认面板 ===== */

.mock-submit {
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
}

/* Figma 98:173：轻遮罩，背景试卷仍可辨认。 */
.mock-submit__mask {
  position: absolute;
  inset: 0;
  background: rgb(15 23 42 / 12%);
}

/* Figma 98:174：h372 顶部圆角 28 的白色面板。 */
.mock-submit__sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: calc(20 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(56 * var(--rpx)) + env(safe-area-inset-bottom));
  border-radius: var(--radius-48) var(--radius-48) 0 0;
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-overlay);
}

.mock-submit__grabber {
  width: calc(96 * var(--rpx));
  height: calc(8 * var(--rpx));
  margin: 0 auto;
  border-radius: calc(4 * var(--rpx));
  background: var(--figma-color-line-emphasis);
}

.mock-submit__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(24 * var(--rpx));
}

/* Figma 98:176 */
.mock-submit__title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  line-height: calc(60 * var(--rpx));
}

/* Figma 98:177 */
.mock-submit__time {
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-32);
  color: var(--ink-2);
  background: var(--bg);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: calc(36 * var(--rpx));
}

/* Figma 98:179：琥珀警示条。 */
.mock-submit__warning {
  display: flex;
  min-height: calc(116 * var(--rpx));
  align-items: center;
  gap: calc(24 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: 0 calc(32 * var(--rpx));
  border-radius: var(--radius-32);
  color: var(--ink);
  background: var(--color-warning-soft);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: calc(40 * var(--rpx));
}

.mock-submit__warning--ready {
  background: var(--figma-color-success-soft);
}

.mock-submit__warning-dot {
  width: calc(16 * var(--rpx));
  height: calc(16 * var(--rpx));
  flex: none;
  border-radius: 50%;
  background: var(--figma-color-warning);
}

.mock-submit__warning-dot--ready {
  background: var(--figma-color-success);
}

/* Figma 98:182/185/188：三块统计。 */
.mock-submit__stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}

.mock-submit__stat {
  box-sizing: border-box;
  display: flex;
  height: calc(136 * var(--rpx));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(2 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--bg);
}

.mock-submit__stat--warning {
  border-color: transparent;
  background: var(--color-warning-soft);
}

.mock-submit__stat-value {
  color: var(--ink);
  font-family: var(--font-family-data);
  font-size: var(--text-title);
  font-weight: 700;
  line-height: calc(60 * var(--rpx));
}

.mock-submit__stat-value--warning {
  color: var(--figma-color-warning);
}

.mock-submit__stat-label {
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: calc(40 * var(--rpx));
}

/* Figma 98:191 */
.mock-submit__missing-title {
  margin-top: calc(28 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: calc(44 * var(--rpx));
}

/* Figma 98:192：36px 圆形题号，可点回去检查。 */
.mock-submit__missing {
  display: flex;
  flex-wrap: wrap;
  gap: calc(20 * var(--rpx));
  max-height: calc(200 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  overflow-y: auto;
}

.mock-submit__missing-item {
  box-sizing: border-box;
  display: flex;
  width: calc(72 * var(--rpx));
  min-width: calc(72 * var(--rpx));
  height: calc(72 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: 50%;
  color: var(--ink);
  background: var(--figma-color-surface);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
  font-weight: 600;
}

/* Figma 98:200/98:202：返回检查 + 确认交卷；面板 padding-bottom 保住约 28px 呼吸空间。 */
.mock-submit__actions {
  display: grid;
  grid-template-columns: 132fr 206fr;
  gap: calc(24 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.mock-submit__back,
.mock-submit__confirm {
  box-sizing: border-box;
  display: flex;
  height: calc(104 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-48);
  font-size: var(--text-body-lg);
  font-weight: 600;
}

.mock-submit__back {
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  color: var(--ink);
  background: var(--bg);
}

.mock-submit__confirm {
  color: var(--figma-color-on-dark);
  background: var(--ink);
}

.mock-submit__missing-item::after,
.mock-submit__back::after,
.mock-submit__confirm::after {
  border: 0;
}

button.mock-submit__back,
button.mock-submit__confirm {
  width: 100%;
}

.mock-submit__soul {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-caption);
}
