.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.mock { display: flex; flex-direction: column; min-height: 100vh; }

.m-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.m-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.m-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.m-timer { flex: 1; text-align: right; font-size: 36rpx; font-weight: 700; color: var(--primary); padding-right: 16rpx; }

.m-loading { padding: 120rpx 0; text-align: center; }
.m-body { flex: 1; min-height: 0; }

.m-brief { display: flex; flex-direction: column; gap: 32rpx; }
.m-brief-row { display: flex; gap: 48rpx; }
.m-brief-stat { display: flex; flex-direction: column; gap: 4rpx; }
.m-brief-num { font-size: 56rpx; font-weight: 700; color: var(--ink); }
.m-blueprint { display: flex; flex-direction: column; gap: 16rpx; border-top: 1rpx dashed var(--line); padding-top: 24rpx; }
.m-bp-row { display: flex; justify-content: space-between; }
.m-bp-name { font-size: 28rpx; color: var(--ink-2); }
.m-bp-count { font-size: 28rpx; color: var(--ink); }

.m-progress-bar { display: flex; justify-content: space-between; padding: 8rpx 8rpx 16rpx; }

.m-q { display: flex; flex-direction: column; gap: 24rpx; }
.r-chip {
  align-self: flex-start;
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 6rpx 20rpx;
}
.m-stem { font-size: 30rpx; line-height: 1.6; color: var(--ink); }
.m-options { display: flex; flex-direction: column; gap: 16rpx; }
.opt {
  display: flex; gap: 20rpx; align-items: flex-start;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
}
.opt-on { border-color: var(--primary); background: var(--primary-soft); }
.opt-label { font-size: 28rpx; font-weight: 600; color: var(--primary); flex-shrink: 0; }
.opt-text { flex: 1; font-size: 28rpx; line-height: 1.5; color: var(--ink); }

.m-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.m-foot-btn { width: 100%; }
.m-foot-row { display: flex; gap: 20rpx; }
.m-nav-btn { flex: 1; }

.demo-tip { text-align: center; padding-bottom: 16rpx; }
