.page-state {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.capability-state {
  margin-top: 80rpx;
  padding: 40rpx;
}
.capability-mark {
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}
.capability-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 850;
}
.capability-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  line-height: 1.7;
}
.capability-action {
  margin-top: 28rpx;
}

.mock-paper {
  min-height: 100%;
  font-size: 28rpx;
  transition:
    background 180ms ease,
    font-size 180ms ease;
}
.mock-paper--large {
  font-size: 32rpx;
}
.mock-paper--eye-care {
  margin: -30rpx calc(var(--space-page-x) * -1) 0;
  padding: 30rpx var(--space-page-x);
  background: #eef3df;
}
.inline-warning {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-compact);
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 22rpx;
  line-height: 1.55;
}

.exam-status-card {
  display: grid;
  grid-template-columns: repeat(3, auto) 1fr;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}
.exam-status-card .type-data {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 800;
}
.deadline-copy {
  text-align: right;
}

.material-panel {
  margin-top: 22rpx;
  padding: 28rpx;
}
.material-head,
.draft-head,
.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.material-eyebrow {
  color: var(--color-primary);
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
}
.material-title,
.draft-title,
.sheet-title {
  margin-top: 4rpx;
  font-size: 29rpx;
  font-weight: 820;
}
.material-copy {
  margin-top: 24rpx;
  color: var(--color-ink-secondary);
  line-height: 1.85;
}
.text-action {
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 22rpx;
}
.text-action::after {
  border: 0;
}

.question-card {
  padding: 34rpx 4rpx 24rpx;
}
.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.module-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 20rpx;
  font-weight: 750;
}
.question-position {
  color: var(--color-muted);
  font-size: 21rpx;
}
.question-stem {
  margin-top: 24rpx;
  color: var(--color-ink);
  font-size: inherit;
  font-weight: 640;
  line-height: 1.75;
}
.question-asset image {
  display: block;
  width: 100%;
  margin-top: 22rpx;
  border-radius: var(--radius-compact);
}
.asset-caption {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  text-align: center;
}

.option-list {
  display: grid;
  gap: 16rpx;
}
.option-list--locked {
  pointer-events: none;
  opacity: 0.65;
}
.option-card {
  display: grid;
  grid-template-columns: 64rpx 1fr auto;
  align-items: center;
  min-height: 100rpx;
  padding: 18rpx 18rpx 18rpx 14rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface);
  box-shadow: 0 8rpx 24rpx rgba(42, 49, 102, 0.05);
}
.option-card--selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  box-shadow: 0 12rpx 28rpx rgba(82, 104, 255, 0.14);
}
.option-card--eliminated {
  opacity: 0.5;
}
.option-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--color-surface-soft);
  color: var(--color-primary-deep);
  font-family: var(--font-family-data);
  font-weight: 800;
}
.option-card--selected .option-label {
  background: var(--color-primary);
  color: #fff;
}
.option-copy {
  padding: 0 16rpx;
  line-height: 1.6;
}
.option-card--eliminated .option-copy {
  text-decoration: line-through;
}
.eliminate-action {
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 19rpx;
}
.eliminate-action::after {
  border: 0;
}

.draft-card {
  margin-top: 26rpx;
  padding: 28rpx;
}
.draft-copy,
.sheet-copy {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}
.mark-button {
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: 21rpx;
}
.mark-button--active {
  border-color: var(--color-warning);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.draft-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: var(--radius-compact);
  background: var(--color-surface-soft);
  font-family: var(--font-family-data);
  font-size: 23rpx;
  line-height: 1.65;
}
.question-navigation {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.overlay-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 20, 38, 0.48);
}
.bottom-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 80vh;
  padding: 32rpx;
  border-radius: 38rpx 38rpx 0 0;
  background: var(--color-surface);
  box-shadow: 0 -20rpx 60rpx rgba(17, 20, 38, 0.18);
}
.answer-sheet {
  height: 72vh;
}
.sheet-scroll {
  height: calc(72vh - 120rpx);
  margin-top: 24rpx;
}
.sheet-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
  padding-bottom: 40rpx;
}
.sheet-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-line);
  border-radius: 14rpx;
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-size: 19rpx;
}
.sheet-item--answered {
  border-color: rgba(22, 131, 99, 0.35);
  background: var(--color-success-soft);
  color: var(--color-success);
}
.sheet-item--marked {
  border-color: rgba(163, 88, 32, 0.35);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.sheet-item--active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3rpx rgba(82, 104, 255, 0.16);
}

.display-tools {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 26rpx;
}
.tool-chip,
.tool-row {
  margin: 0;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-compact);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: 22rpx;
}
.tool-chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}
.tool-row {
  margin-top: 16rpx;
  text-align: left;
}
.help-result {
  margin: 0 32rpx 28rpx;
  padding: 20rpx;
  border-radius: var(--radius-compact);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 22rpx;
  line-height: 1.55;
}
.help-result--error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.dispute-categories { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 24rpx; }
.dispute-description { box-sizing: border-box; width: 100%; min-height: 220rpx; margin-top: 20rpx; padding: 22rpx; border-radius: var(--radius-compact); background: var(--color-surface-soft); font-size: 24rpx; line-height: 1.65; }
.dispute-sheet .help-result { margin: 18rpx 0; }
.dispute-sheet > .primary-button { margin-top: 20rpx; }

.footer-actions,
.footer-actions .primary-button {
  width: 100%;
}
.submitted-workspace {
  padding: 20rpx 0 60rpx;
}
.submitted-hero {
  padding: 48rpx 36rpx;
  border-radius: var(--radius-hero);
  background: var(--gradient-brand);
  color: #fff;
  text-align: center;
  box-shadow: var(--shadow-primary);
}
.submitted-mark {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  opacity: 0.8;
}
.submitted-score {
  margin-top: 18rpx;
  font-size: 28rpx;
}
.submitted-score text {
  font-family: var(--font-family-data);
  font-size: 86rpx;
  font-weight: 850;
}
.submitted-source {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.5;
  opacity: 0.82;
}
.submitted-note,
.module-result,
.next-week {
  margin-top: 20rpx;
  padding: 26rpx;
}
.submitted-note-title {
  font-size: 27rpx;
  font-weight: 800;
}
.submitted-note-copy {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.65;
}
.module-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.module-result-data {
  color: var(--color-primary-deep);
}
.next-week {
  color: var(--color-ink-secondary);
  line-height: 1.7;
}
.submitted-workspace > .primary-button {
  margin-top: 24rpx;
}
