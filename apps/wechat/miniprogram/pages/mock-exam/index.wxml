<task-shell
  id="runtime-task-shell"
  title="{{title}}"
  modeLabel="正式整卷 · 限时计时"
  current="{{current}}"
  total="{{total || 1}}"
  elapsedLabel="{{remainingLabel}}"
  syncLabel="{{syncLabel}}"
  materialAvailable="{{false}}"
  answerSheetAvailable="{{status === 'ready'}}"
  draftAvailable="{{status === 'ready' && question ? true : false}}"
  marked="{{question ? question.marked : false}}"
  toolsAvailable="{{status === 'ready'}}"
  footerAvailable="{{status === 'ready'}}"
  bindexit="exit"
  bindmaterial="toggleMaterial"
  bindanswersheet="toggleAnswerSheet"
  binddraft="toggleDraft"
  bindmark="toggleMarked"
  bindtools="toggleTools"
>
  <view wx:if="{{status === 'loading'}}" class="page-state">
    <state-view state="loading" title="正在恢复整卷" description="正在准备试卷，恢复你上次的进度。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" actionText="重新恢复" bindaction="retry" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="capability-state card">
    <view class="capability-mark">先确认整卷条件</view>
    <view class="capability-title">{{errorTitle}}</view>
    <view class="capability-copy">{{errorMessage}}</view>
    <button hover-class="item--hover" wx:if="{{showLoginAction}}" class="secondary-button capability-action" bindtap="goLogin">去登录</button>
  </view>

  <view wx:elif="{{status === 'submitted' && receipt}}" class="submitted-workspace">
    <view class="submitted-hero">
      <view class="submitted-mark">交卷了。深呼吸，成绩不会跑</view>
      <view class="submitted-score"><text class="submitted-score__value">{{receipt.review.performanceIndex}}</text> 表现点</view>
      <view class="submitted-source">样本区间 {{receipt.review.performanceRange.lower}}–{{receipt.review.performanceRange.upper}} 表现点</view>
      <view class="submitted-source">{{receipt.review.metricDefinition}}</view>
    </view>
    <view class="submitted-note card">
      <view class="submitted-note-title">交卷前未提供解析、公式卡或解题 AI</view>
      <view class="submitted-note-copy">本页先看整卷结果。逐题解析和方法总结会收进正式模考报告。</view>
    </view>
    <view class="module-result card" wx:for="{{receipt.review.modules}}" wx:key="moduleName">
      <view>{{item.moduleName}}</view>
      <view class="module-result-data type-data">{{item.correct}} / {{item.total}} · 正确率 {{item.accuracy * 100}}%</view>
    </view>
    <view class="next-week card">{{receipt.review.nextWeekReason}}</view>
    <button hover-class="item--hover" class="primary-button" bindtap="openMockReport">查看正式模考报告</button>
    <button hover-class="item--hover" class="secondary-button" bindtap="returnToday">返回今日计划</button>
  </view>

  <view wx:elif="{{status === 'submitted'}}" class="page-state">
    <state-view state="empty" title="本场模考已经交卷" description="答案解析只在正式报告页按权限展示。" />
    <button hover-class="item--hover" wx:if="{{reportSessionId}}" class="primary-button" bindtap="openMockReport">查看正式模考报告</button>
    <view wx:else class="inline-warning">找不到这场模考的记录，请从报告中心重新进入。</view>
    <button hover-class="item--hover" class="secondary-button" bindtap="returnToday">返回今日计划</button>
  </view>

  <view wx:elif="{{status === 'ready' && question}}" class="mock-paper mock-paper--{{fontScale}} {{eyeCare ? 'mock-paper--eye-care' : ''}}">
    <view wx:if="{{errorMessage}}" class="inline-warning">{{errorMessage}}</view>

    <view class="exam-status-card card">
      <view><text class="type-data">{{answered}}</text> 已答</view>
      <view><text class="type-data">{{unanswered}}</text> 未答</view>
      <view><text class="type-data">{{marked}}</text> 标记</view>
      <view class="deadline-copy">离开页面也不会暂停</view>
    </view>

    <view class="mock-workspace {{question.material ? 'mock-workspace--with-material' : 'mock-workspace--single'}}">
      <material-reader
        wx:if="{{question.material}}"
        class="mock-material-pane"
        title="{{question.material.title || '共享材料'}}"
        blocks="{{question.material.content}}"
        anchors="{{question.material.anchors}}"
        state="{{materialReaderState}}"
        bindstatechange="updateMaterialReaderState"
        bindpositionchange="updateMaterialPosition"
      />

      <view class="mock-question-pane">
        <view class="question-card">
          <view class="question-meta">
            <view class="module-pill">{{question.moduleName}}</view>
            <view class="question-position type-data">{{current}} / {{total}}</view>
          </view>
          <view class="question-stem">
            <content-renderer
              blocks="{{question.stemContent}}"
              zoom="1"
              preferences="{{contentPreferences}}"
              freeze-first-column
              freeze-header
            />
          </view>
        </view>

        <view class="option-list {{interactionLocked ? 'option-list--locked' : ''}}">
          <view wx:for="{{question.options}}" wx:key="optionId" class="option-row">
            <view
              hover-class="option--hover"
              class="option-card {{item.selected ? 'option-card--selected' : ''}} {{item.eliminated ? 'option-card--eliminated' : ''}}"
              data-optionid="{{item.optionId}}"
              bindtap="selectOption"
            >
              <view class="option-label">{{item.label}}</view>
              <view class="option-copy">
                <content-renderer
                  blocks="{{item.content}}"
                  zoom="1"
                  preferences="{{contentPreferences}}"
                  freeze-first-column
                  freeze-header
                />
              </view>
            </view>
            <button hover-class="item--hover"
              class="eliminate-action {{item.eliminated ? 'eliminate-action--active' : ''}}"
              aria-label="{{item.eliminated ? '撤销排除选项 ' + item.label : '排除选项 ' + item.label}}"
              data-optionid="{{item.optionId}}"
              catchtap="toggleEliminated"
            >
              <image
                class="eliminate-action__icon"
                src="{{item.eliminated ? '/assets/icons/task/eliminate.svg' : '/assets/icons/task/eliminate-faint.svg'}}"
                mode="aspectFit"
                aria-hidden="true"
              />
            </button>
          </view>
        </view>

      </view>
    </view>
  </view>

  <ui-sheet
    visible="{{answerSheetOpen}}"
    title="整卷答题卡"
    copy="{{answered}} 已答 · {{unanswered}} 未答 · {{marked}} 标记"
    show-close
    max-height="80vh"
    bindclose="toggleAnswerSheet"
  >
    <view class="sheet-grid">
      <button hover-class="item--hover"
        wx:for="{{answerSheetItems}}"
        wx:key="index"
        class="sheet-item sheet-item--{{item.state}} {{item.active ? 'sheet-item--active' : ''}}"
        data-index="{{item.index}}"
        bindtap="selectQuestion"
      >{{item.label}}</button>
    </view>
  </ui-sheet>

  <ui-sheet
    visible="{{draftOpen && question}}"
    title="草稿纸"
    copy="当前第 {{current}} / {{total}} 题 · 自动保存"
    max-height="80vh"
    bindclose="toggleDraft"
  >
    <button hover-class="item--hover" slot="action" class="mark-button {{question.marked ? 'mark-button--active' : ''}}" bindtap="toggleMarked">{{question.marked ? '已标记' : '标记'}}</button>
    <textarea cursor-spacing="24" class="draft-input draft-input--sheet" value="{{question.draftText}}" maxlength="4000" placeholder="记录计算、排除过程或检查点……" bindinput="inputDraft"></textarea>
    <view class="mock-timer-notice">模考按统一结束时间计时，看草稿不暂停。</view>
    <button hover-class="item--hover" class="primary-button draft-sheet-action" bindtap="toggleDraft">收起草稿，继续作答</button>
  </ui-sheet>

  <ui-sheet
    visible="{{toolsOpen}}"
    title="模考工具"
    copy="交卷前不提供解析、公式卡或解题 AI。"
    show-close
    level="overlay"
    max-height="86vh"
    bindclose="toggleTools"
  >
    <view class="display-tools">
      <button hover-class="item--hover" class="tool-chip {{fontScale === 'standard' ? 'tool-chip--active' : ''}}" data-scale="standard" bindtap="setFontScale">标准字号</button>
      <button hover-class="item--hover" class="tool-chip {{fontScale === 'large' ? 'tool-chip--active' : ''}}" data-scale="large" bindtap="setFontScale">大字号</button>
      <button hover-class="item--hover" class="tool-chip {{eyeCare ? 'tool-chip--active' : ''}}" bindtap="toggleEyeCare">护眼显示</button>
    </view>
    <button hover-class="item--hover" class="tool-row" bindtap="reportDispute">题面异常 / 争议上报</button>
    <button hover-class="item--hover" class="tool-row" bindtap="openHelp">操作与故障帮助</button>
    <button hover-class="item--hover" class="tool-row tool-row--submit" disabled="{{interactionLocked}}" bindtap="submitExam">提前交卷</button>
  </ui-sheet>

  <ui-sheet
    visible="{{helpOpen && pageObjectReference}}"
    level="overlay"
    show-handle="{{false}}"
    sheet-class="help-sheet"
    max-height="86vh"
    bindclose="closeHelp"
  >
    <global-help
      pageObjectReference="{{pageObjectReference}}"
      syncState="{{syncLabel === '已保存' ? 'saved' : syncLabel === '正在保存' ? 'saving' : 'pending'}}"
      bindsubmit="submitHelp"
      bindclose="closeHelp"
    />
    <view wx:if="{{helpMessage}}" class="help-result help-result--{{helpStatus}}">{{helpMessage}}</view>
  </ui-sheet>

  <ui-sheet
    visible="{{disputeOpen && question}}"
    title="题面异常 / 争议上报"
    copy="报错只带题目信息，不带你的答案。"
    show-close
    level="overlay"
    max-height="86vh"
    bindclose="closeDispute"
  >
    <view class="dispute-body">
      <view class="dispute-categories">
        <button hover-class="item--hover"
          wx:for="{{disputeCategories}}"
          wx:key="value"
          class="tool-chip {{disputeCategory === item.value ? 'tool-chip--active' : ''}}"
          data-category="{{item.value}}"
          bindtap="selectDisputeCategory"
        >{{item.label}}</button>
      </view>
      <textarea cursor-spacing="24"
        class="dispute-description"
        value="{{disputeDescription}}"
        maxlength="2000"
        disabled="{{disputeStatus === 'submitting' || disputeStatus === 'resolved'}}"
        placeholder="请说明具体哪里有问题，至少两个字。"
        bindinput="inputDisputeDescription"
      ></textarea>
      <view wx:if="{{disputeMessage}}" class="help-result help-result--{{disputeStatus}}">{{disputeMessage}}</view>
      <button hover-class="item--hover"
        class="primary-button"
        disabled="{{disputeDescription.length < 2 || disputeStatus === 'submitting' || disputeStatus === 'resolved'}}"
        bindtap="submitDispute"
      >{{disputeStatus === 'submitting' ? '正在提交' : disputeStatus === 'resolved' ? '已提交' : '提交争议'}}</button>
    </view>
  </ui-sheet>

  <view slot="footer" wx:if="{{status === 'ready'}}" class="footer-actions">
    <button hover-class="item--hover"
      class="footer-previous {{current === 1 || interactionLocked ? 'footer-previous--disabled' : ''}}"
      disabled="{{current === 1 || interactionLocked}}"
      bindtap="previousQuestion"
    >上一题</button>
    <button hover-class="item--hover"
      wx:if="{{current < total}}"
      class="primary-button footer-next"
      disabled="{{interactionLocked}}"
      bindtap="nextQuestion"
    >下一题</button>
    <button hover-class="item--hover"
      wx:else
      class="primary-button footer-next"
      disabled="{{interactionLocked}}"
      bindtap="submitExam"
    >交卷并查看结果</button>
  </view>

  <!-- Figma 98:173-98:203：模考交卷底部确认面板。 -->
  <view wx:if="{{submitConfirmOpen}}" class="mock-submit motion-mask" catchtouchmove="noop">
    <view class="mock-submit__mask" catchtap="closeSubmitConfirm" aria-label="返回检查"></view>
    <view class="mock-submit__sheet">
      <view class="mock-submit__grabber" aria-hidden="true"></view>
      <view class="mock-submit__head">
        <view class="mock-submit__title">准备交卷</view>
        <view class="mock-submit__time">已用时 {{submitElapsedLabel}}</view>
      </view>

      <view wx:if="{{unanswered > 0}}" class="mock-submit__warning">
        <view class="mock-submit__warning-dot" aria-hidden="true"></view>
        <text>还有 {{unanswered}} 题未作答，交卷后不能继续修改</text>
      </view>
      <view wx:else class="mock-submit__warning mock-submit__warning--ready">
        <view class="mock-submit__warning-dot mock-submit__warning-dot--ready" aria-hidden="true"></view>
        <text>全部题目已作答，交卷后不能继续修改</text>
      </view>

      <view class="mock-submit__stats">
        <view class="mock-submit__stat">
          <view class="mock-submit__stat-value">{{answered}}</view>
          <view class="mock-submit__stat-label">已答</view>
        </view>
        <view class="mock-submit__stat mock-submit__stat--warning">
          <view class="mock-submit__stat-value mock-submit__stat-value--warning">{{unanswered}}</view>
          <view class="mock-submit__stat-label">未答</view>
        </view>
        <view class="mock-submit__stat">
          <view class="mock-submit__stat-value">{{marked}}</view>
          <view class="mock-submit__stat-label">已标记</view>
        </view>
      </view>

      <block wx:if="{{submitMissingLabels.length}}">
        <view class="mock-submit__missing-title">未答题号</view>
        <view class="mock-submit__missing">
          <button hover-class="item--hover"
            wx:for="{{submitMissingLabels}}"
            wx:key="*this"
            class="mock-submit__missing-item"
            aria-label="回到第 {{item}} 题检查"
            data-index="{{item - 1}}"
            bindtap="selectQuestion"
          >{{item}}</button>
        </view>
      </block>

      <view class="mock-submit__actions">
        <button hover-class="item--hover" class="mock-submit__back" bindtap="closeSubmitConfirm">返回检查</button>
        <button hover-class="item--hover" class="mock-submit__confirm" disabled="{{interactionLocked}}" bindtap="confirmSubmitExam">确认交卷</button>
      </view>
    </view>
  </view>
</task-shell>
