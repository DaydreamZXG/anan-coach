<task-shell
  title="{{title}}"
  modeLabel="正式整卷 · 服务端绝对计时"
  current="{{current}}"
  total="{{total || 1}}"
  elapsedLabel="{{remainingLabel}}"
  syncLabel="{{syncLabel}}"
  materialAvailable="{{status === 'ready' && question && question.material ? true : false}}"
  answerSheetAvailable="{{status === 'ready'}}"
  draftAvailable="{{status === 'ready' && question ? true : false}}"
  toolsAvailable="{{status === 'ready'}}"
  footerAvailable="{{status === 'ready'}}"
  bindexit="exit"
  bindmaterial="toggleMaterial"
  bindanswersheet="toggleAnswerSheet"
  binddraft="toggleDraft"
  bindtools="toggleTools"
>
  <view wx:if="{{status === 'loading'}}" class="page-state">
    <state-view state="loading" title="正在恢复整卷" description="读取固定题面、服务端截止时间与最新断点。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" actionText="重新恢复" bindaction="retry" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="capability-state card">
    <view class="capability-mark">整卷证据门禁</view>
    <view class="capability-title">{{errorTitle}}</view>
    <view class="capability-copy">{{errorMessage}}</view>
    <button wx:if="{{showLoginAction}}" class="secondary-button capability-action" bindtap="goLogin">去登录</button>
  </view>

  <view wx:elif="{{status === 'submitted' && receipt}}" class="submitted-workspace">
    <view class="submitted-hero">
      <view class="submitted-mark">整卷已交卷</view>
      <view class="submitted-score"><text class="submitted-score__value">{{receipt.review.performanceIndex}}</text> 表现点</view>
      <view class="submitted-source">样本区间 {{receipt.review.performanceRange.lower}}–{{receipt.review.performanceRange.upper}} 表现点</view>
      <view class="submitted-source">{{receipt.review.metricDefinition}}</view>
    </view>
    <view class="submitted-note card">
      <view class="submitted-note-title">交卷前未提供解析、公式卡或解题 AI</view>
      <view class="submitted-note-copy">本页只显示整卷聚合结果。逐题解析与方法卡将在正式模考报告中按提交状态解锁。</view>
    </view>
    <view class="module-result card" wx:for="{{receipt.review.modules}}" wx:key="moduleName">
      <view>{{item.moduleName}}</view>
      <view class="module-result-data type-data">{{item.correct}} / {{item.total}} · 正确率 {{item.accuracy * 100}}%</view>
    </view>
    <view class="next-week card">{{receipt.review.nextWeekReason}}</view>
    <button class="primary-button" bindtap="openMockReport">查看正式模考报告</button>
    <button class="secondary-button" bindtap="returnToday">返回今日计划</button>
  </view>

  <view wx:elif="{{status === 'submitted'}}" class="page-state">
    <state-view state="empty" title="本场模考已经交卷" description="答案解析只在正式报告页按权限展示。" />
    <button wx:if="{{reportSessionId}}" class="primary-button" bindtap="openMockReport">查看正式模考报告</button>
    <view wx:else class="inline-warning">缺少本场模考会话编号，不能打开正式报告。请从报告中心或今日计划重新进入。</view>
    <button class="secondary-button" bindtap="returnToday">返回今日计划</button>
  </view>

  <view wx:elif="{{status === 'ready' && question}}" class="mock-paper mock-paper--{{fontScale}} {{eyeCare ? 'mock-paper--eye-care' : ''}}">
    <view wx:if="{{errorMessage}}" class="inline-warning">{{errorMessage}}</view>

    <view class="exam-status-card card">
      <view><text class="type-data">{{answered}}</text> 已答</view>
      <view><text class="type-data">{{unanswered}}</text> 未答</view>
      <view><text class="type-data">{{marked}}</text> 标记</view>
      <view class="deadline-copy">离开页面也不会暂停</view>
    </view>

    <view class="mock-workspace {{materialOpen && question.material ? 'mock-workspace--with-material' : 'mock-workspace--single'}}">
      <material-reader
        wx:if="{{materialOpen && question.material}}"
        class="mock-material-pane"
        title="{{question.material.title || '共享材料'}}"
        blocks="{{question.material.content}}"
        anchors="{{question.material.anchors}}"
        state="{{materialReaderState}}"
        bindstatechange="updateMaterialReaderState"
        bindpositionchange="updateMaterialPosition"
      />

      <view class="mock-question-pane">
        <view class="question-card">
          <view class="question-meta">
            <view class="module-pill">{{question.moduleName}}</view>
            <view class="question-position type-data">{{current}} / {{total}}</view>
          </view>
          <view class="question-stem">
            <content-renderer
              blocks="{{question.stemContent}}"
              zoom="1"
              preferences="{{contentPreferences}}"
              freeze-first-column
              freeze-header
            />
          </view>
        </view>

        <view class="option-list {{interactionLocked ? 'option-list--locked' : ''}}">
          <view
            wx:for="{{question.options}}"
            wx:key="optionId"
            class="option-card {{item.selected ? 'option-card--selected' : ''}} {{item.eliminated ? 'option-card--eliminated' : ''}}"
            data-optionid="{{item.optionId}}"
            bindtap="selectOption"
          >
            <view class="option-label">{{item.label}}</view>
            <view class="option-copy">
              <content-renderer
                blocks="{{item.content}}"
                zoom="1"
                preferences="{{contentPreferences}}"
                freeze-first-column
                freeze-header
              />
            </view>
            <button class="eliminate-action" data-optionid="{{item.optionId}}" catchtap="toggleEliminated">{{item.eliminated ? '撤销排除' : '排除'}}</button>
          </view>
        </view>

        <view class="question-navigation">
          <button class="secondary-button" disabled="{{current === 1 || interactionLocked}}" bindtap="previousQuestion">上一题</button>
          <button class="secondary-button" disabled="{{current === total || interactionLocked}}" bindtap="nextQuestion">下一题</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{answerSheetOpen}}" class="overlay-mask" catchtap="toggleAnswerSheet">
    <view class="bottom-sheet answer-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-title">整卷答题卡</view>
          <view class="sheet-copy">{{answered}} 已答 · {{unanswered}} 未答 · {{marked}} 标记</view>
        </view>
        <button class="text-action" bindtap="toggleAnswerSheet">关闭</button>
      </view>
      <scroll-view class="sheet-scroll" scroll-y enhanced>
        <view class="sheet-grid">
          <button
            wx:for="{{answerSheetItems}}"
            wx:key="index"
            class="sheet-item sheet-item--{{item.state}} {{item.active ? 'sheet-item--active' : ''}}"
            data-index="{{item.index}}"
            bindtap="selectQuestion"
          >{{item.label}}</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{draftOpen && question}}" class="overlay-mask" catchtap="toggleDraft" catchtouchmove="noop">
    <view class="bottom-sheet draft-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-title">草稿纸</view>
          <view class="sheet-copy">当前第 {{current}} / {{total}} 题 · 随断点自动保存</view>
        </view>
        <button class="mark-button {{question.marked ? 'mark-button--active' : ''}}" bindtap="toggleMarked">{{question.marked ? '已标记' : '标记'}}</button>
      </view>
      <textarea class="draft-input draft-input--sheet" value="{{question.draftText}}" maxlength="4000" placeholder="记录计算、排除过程或检查点……" bindinput="inputDraft"></textarea>
      <view class="mock-timer-notice">整卷模考使用服务端绝对截止时间，打开草稿不会暂停计时。</view>
      <button class="primary-button draft-sheet-action" bindtap="toggleDraft">收起草稿，继续作答</button>
    </view>
  </view>

  <view wx:if="{{toolsOpen}}" class="overlay-mask" catchtap="toggleTools">
    <view class="bottom-sheet tools-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-title">模考工具</view>
          <view class="sheet-copy">交卷前不提供解析、公式卡或解题 AI。</view>
        </view>
        <button class="text-action" bindtap="toggleTools">关闭</button>
      </view>
      <view class="display-tools">
        <button class="tool-chip {{fontScale === 'standard' ? 'tool-chip--active' : ''}}" data-scale="standard" bindtap="setFontScale">标准字号</button>
        <button class="tool-chip {{fontScale === 'large' ? 'tool-chip--active' : ''}}" data-scale="large" bindtap="setFontScale">大字号</button>
        <button class="tool-chip {{eyeCare ? 'tool-chip--active' : ''}}" bindtap="toggleEyeCare">护眼显示</button>
      </view>
      <button class="tool-row" bindtap="reportDispute">题面异常 / 争议上报</button>
      <button class="tool-row" bindtap="openHelp">操作与故障帮助</button>
    </view>
  </view>

  <view wx:if="{{helpOpen && pageObjectReference}}" class="overlay-mask" catchtap="closeHelp">
    <view class="bottom-sheet" catchtap="noop">
      <global-help
        pageObjectReference="{{pageObjectReference}}"
        syncState="{{syncLabel === '已保存' ? 'saved' : syncLabel === '正在保存' ? 'saving' : 'pending'}}"
        bindsubmit="submitHelp"
        bindclose="closeHelp"
      />
      <view wx:if="{{helpMessage}}" class="help-result help-result--{{helpStatus}}">{{helpMessage}}</view>
    </view>
  </view>

  <view wx:if="{{disputeOpen && question}}" class="overlay-mask" catchtap="closeDispute">
    <view class="bottom-sheet dispute-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-title">题面异常 / 争议上报</view>
          <view class="sheet-copy">绑定本场会话、题目与固定内容版本，不上传你的答案或草稿。</view>
        </view>
        <button class="text-action" disabled="{{disputeStatus === 'submitting'}}" bindtap="closeDispute">关闭</button>
      </view>
      <view class="dispute-categories">
        <button
          wx:for="{{disputeCategories}}"
          wx:key="value"
          class="tool-chip {{disputeCategory === item.value ? 'tool-chip--active' : ''}}"
          data-category="{{item.value}}"
          bindtap="selectDisputeCategory"
        >{{item.label}}</button>
      </view>
      <textarea
        class="dispute-description"
        value="{{disputeDescription}}"
        maxlength="2000"
        disabled="{{disputeStatus === 'submitting' || disputeStatus === 'resolved'}}"
        placeholder="请说明具体哪里有问题，至少两个字。"
        bindinput="inputDisputeDescription"
      ></textarea>
      <view wx:if="{{disputeMessage}}" class="help-result help-result--{{disputeStatus}}">{{disputeMessage}}</view>
      <button
        class="primary-button"
        disabled="{{disputeDescription.length < 2 || disputeStatus === 'submitting' || disputeStatus === 'resolved'}}"
        bindtap="submitDispute"
      >{{disputeStatus === 'submitting' ? '正在提交' : disputeStatus === 'resolved' ? '已提交' : '提交争议'}}</button>
    </view>
  </view>

  <view slot="footer" wx:if="{{status === 'ready'}}" class="footer-actions">
    <button class="primary-button" disabled="{{interactionLocked}}" bindtap="submitExam">交卷</button>
  </view>
</task-shell>
