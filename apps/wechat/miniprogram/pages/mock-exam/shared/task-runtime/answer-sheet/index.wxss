@import "../../../../../design-system/primitives/interaction.wxss";

.answer-card {
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
}
.answer-card__mask {
  position: absolute;
  inset: 0;
  background: rgb(16 24 40 / 30%);
}
.answer-card__sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(40 * var(--rpx)) + env(safe-area-inset-bottom));
  border-radius: var(--radius-48) var(--radius-48) 0 0;
  background: var(--figma-color-surface);
}
.answer-card__handle-row {
  display: flex;
  height: calc(24 * var(--rpx));
  align-items: center;
  justify-content: center;
}
.answer-card__handle {
  width: calc(84 * var(--rpx));
  height: calc(8 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--figma-color-line-emphasis);
}
.answer-card__header {
  display: flex;
  height: calc(96 * var(--rpx));
  align-items: center;
  justify-content: space-between;
}
.answer-card__title {
  color: var(--figma-color-ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
  line-height: calc(50 * var(--rpx));
}
.answer-card__subtitle {
  margin-top: calc(2 * var(--rpx));
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: calc(30 * var(--rpx));
}
.answer-card__close {
  box-sizing: border-box;
  display: flex;
  width: calc(68 * var(--rpx));
  min-width: calc(68 * var(--rpx));
  height: calc(68 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: var(--figma-color-canvas);
  font-size: var(--text-title);
  line-height: 1;
}
.answer-card__close::after,
.answer-card__question::after,
.answer-card__submit::after {
  border: 0;
}
.answer-card__legend {
  box-sizing: border-box;
  display: flex;
  min-height: calc(100 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  padding: calc(16 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--figma-color-canvas);
}
.answer-card__legend-item {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 600;
}
.answer-card__legend-dot {
  box-sizing: border-box;
  width: calc(18 * var(--rpx));
  height: calc(18 * var(--rpx));
  flex: none;
  border-radius: 50%;
}
.answer-card__legend-dot--answered,
.answer-card__legend-dot--current {
  background: var(--color-primary-deep);
}
.answer-card__legend-dot--unanswered {
  border: calc(2 * var(--rpx)) solid var(--figma-color-line-emphasis);
  background: var(--figma-color-surface);
}
.answer-card__legend-dot--marked {
  background: var(--figma-color-warning);
}
.answer-card__section {
  display: flex;
  flex-direction: column;
  gap: calc(28 * var(--rpx));
  padding: calc(12 * var(--rpx)) 0 calc(8 * var(--rpx));
}
.answer-card__module-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.answer-card__module-name {
  color: var(--figma-color-ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}
.answer-card__module-counts {
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
}
.answer-card__grid {
  display: grid;
  max-height: 40vh;
  grid-template-columns: repeat(auto-fill, calc(88 * var(--rpx)));
  justify-content: space-between;
  gap: calc(28 * var(--rpx)) calc(16 * var(--rpx));
  overflow-y: auto;
}
.answer-card__cell {
  position: relative;
  width: calc(88 * var(--rpx));
  height: calc(88 * var(--rpx));
}
.answer-card__question {
  box-sizing: border-box;
  display: flex;
  width: calc(88 * var(--rpx));
  height: calc(88 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  font-family: var(--font-family-data);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1;
}
.answer-card__question--answered {
  color: var(--color-muted);
  background: var(--color-primary-soft);
}
.answer-card__question--current {
  color: var(--figma-color-on-dark);
  background: var(--color-primary-deep);
}
.answer-card__question--unanswered,
.answer-card__question--skipped {
  border: calc(3 * var(--rpx)) solid var(--figma-color-line-emphasis);
  color: var(--figma-color-muted);
  background: var(--figma-color-surface);
}
.answer-card__question--marked {
  border: calc(3 * var(--rpx)) solid var(--figma-color-warning);
  color: var(--figma-color-ink);
  background: var(--figma-color-surface);
}
.answer-card__marked-badge {
  position: absolute;
  top: calc(-7 * var(--rpx));
  right: 0;
  box-sizing: border-box;
  display: flex;
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
  align-items: center;
  justify-content: center;
  border: calc(4 * var(--rpx)) solid var(--figma-color-surface);
  border-radius: var(--radius-12);
  color: var(--figma-color-on-dark);
  background: var(--figma-color-warning);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1;
}
.answer-card__hint {
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
}
.answer-card__insight {
  box-sizing: border-box;
  display: flex;
  min-height: calc(128 * var(--rpx));
  align-items: center;
  gap: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--color-primary-soft);
}
.answer-card__insight-icon {
  width: calc(68 * var(--rpx));
  height: calc(68 * var(--rpx));
  flex: none;
}
.answer-card__insight-title {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}
.answer-card__insight-sub {
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: calc(28 * var(--rpx));
}
.answer-card__submit {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: calc(108 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-40);
  font-size: var(--text-section);
  font-weight: 700;
}
.answer-card__submit {
  color: var(--color-surface);
  background: var(--color-primary);
}

/* Host layout tiers: compact <600, medium >=600, wide >=1024. */
@media (min-width: 600px) {
  .answer-card__sheet {
    right: 50%;
    left: auto;
    width: 100%;
    max-width: 560px;
    padding: 8px 20px calc(20px + env(safe-area-inset-bottom));
    border-radius: 28px 28px 0 0;
    transform: translateX(50%);
  }
  .answer-card__grid {
    grid-template-columns: repeat(auto-fill, 44px);
    gap: 14px 8px;
  }
  .answer-card__cell,
  .answer-card__question {
    width: 44px;
    height: 44px;
  }
}
