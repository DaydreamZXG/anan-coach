@import "../../../../../design-system/primitives/interaction.wxss";

.task-shell {
  --task-status-bar-height: 0px;
  --task-navigation-height: 44px;
  --task-menu-bottom: 0px;
  --task-capsule-reserve: 0px;
  --task-toolbar-surface: var(--color-surface-a94);
  --task-toolbar-control: var(--bg);
  --task-toolbar-line: var(--line);
  --task-toolbar-ink: var(--color-ink-secondary);
  --task-toolbar-brand: var(--color-primary);
  --task-toolbar-brand-soft: var(--primary-soft);
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--task-status-bar-height) var(--space-page-x) calc(158 * var(--rpx));
  background: var(--color-canvas);
}

.task-shell--no-footer {
  padding-bottom: calc(56 * var(--rpx));
}

.task-shell--no-header {
  padding-top: var(--task-menu-bottom);
}

.task-header {
  position: sticky;
  z-index: var(--z-sticky);
  top: var(--task-status-bar-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: calc(64 * var(--rpx));
  margin: 0 calc(var(--space-page-x) * -1);
  padding: calc(12 * var(--rpx)) calc(calc(20 * var(--rpx)) + var(--task-capsule-reserve))
    calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--color-line-a84);
  background: var(--task-toolbar-surface);
  box-shadow: var(--shadow-toolbar);
  backdrop-filter: blur(calc(30 * var(--rpx)));
}

.task-header-actions {
  display: flex;
  flex: 0 1 auto;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: calc(12 * var(--rpx));
}

.task-header-title {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: baseline;
  gap: var(--figma-space-6);
  margin-left: var(--figma-space-8);
}

.task-header-title__main {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-header-title__progress {
  flex: none;
  color: var(--ink-3);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
  font-weight: 600;
}

.task-header-button,
.task-question-control,
.task-timer-control,
.task-tool-button {
  box-sizing: border-box;
  min-height: calc(58 * var(--rpx));
  margin: 0;
  padding: 0;
  border: calc(1 * var(--rpx)) solid transparent;
  color: var(--task-toolbar-ink);
  background: var(--task-toolbar-control);
  line-height: normal;
}

.task-header-button::after,
.task-question-control::after,
.task-timer-control::after,
.task-tool-button::after {
  border: 0;
}

.task-header-button {
  display: flex;
  flex: 0 0 calc(58 * var(--rpx));
  width: calc(58 * var(--rpx));
  min-width: calc(58 * var(--rpx));
  max-width: calc(58 * var(--rpx));
  height: calc(58 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-16);
}

.task-header-button--back {
  flex: none;
  /* 与右侧工具组保持缓冲，避免退出误触到答题卡/计时。 */
  margin-right: calc(16 * var(--rpx));
  background: transparent;
}

.task-header-button--material {
  color: var(--ink-2);
}

.task-header-button--mark-active {
  color: var(--figma-color-warning);
  background: var(--figma-color-warning-soft);
}

.task-header-button--anan {
  color: var(--color-surface);
  background: var(--gradient-ai);
  box-shadow: var(--shadow-toolbar-action);
}

.task-question-control,
.task-timer-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(12 * var(--rpx));
  border-radius: var(--radius-capsule);
}

.task-question-control {
  /* 130 题整卷时计数器是「130/130」六位，宽度必须随内容伸展。 */
  flex: 0 0 auto;
  width: auto;
  min-width: calc(90 * var(--rpx));
  max-width: none;
  height: calc(58 * var(--rpx));
  padding: 0 calc(12 * var(--rpx));
}

.task-timer-control {
  flex: 0 0 calc(148 * var(--rpx));
  width: calc(148 * var(--rpx));
  min-width: calc(148 * var(--rpx));
  max-width: calc(148 * var(--rpx));
  height: calc(58 * var(--rpx));
  padding: 0 calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  background: var(--bg);
}

.task-timer-control--paused {
  border-color: var(--color-warning-a42);
  color: var(--color-warning);
  background: var(--color-warning-soft);
}

.task-timer-control--read-only {
  flex: 0 0 auto;
  width: auto;
  min-width: calc(104 * var(--rpx));
  max-width: none;
}

.task-header-divider {
  width: calc(1 * var(--rpx));
  height: calc(34 * var(--rpx));
  margin: 0 calc(3 * var(--rpx));
  background: var(--color-line-strong);
}

.task-progress-label,
.task-timer {
  flex: none;
  font-family: var(--font-family-data);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  white-space: nowrap;
}

.task-progress-label {
  color: var(--color-ink);
  font-size: var(--text-micro);
}

.task-timer {
  font-size: var(--text-micro);
  letter-spacing: calc(0.4 * var(--rpx));
}

.task-sync-dot {
  flex: none;
  width: calc(6 * var(--rpx));
  height: calc(6 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--task-toolbar-brand);
}

.task-sync-dot--saving {
  background: var(--color-gold);
}

.task-sync-dot--pending {
  background: var(--color-faint);
}

.task-sync-dot--error {
  background: var(--color-danger);
}

.task-icon {
  position: relative;
  display: block;
  flex: none;
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
  color: currentcolor;
}

.task-icon--back::before {
  position: absolute;
  top: calc(7 * var(--rpx));
  left: calc(9 * var(--rpx));
  width: calc(13 * var(--rpx));
  height: calc(13 * var(--rpx));
  transform: rotate(45deg);
  border-bottom: calc(3 * var(--rpx)) solid currentcolor;
  border-left: calc(3 * var(--rpx)) solid currentcolor;
  border-radius: calc(2 * var(--rpx));
  content: "";
}

.task-icon--material {
  box-sizing: border-box;
  border: calc(2 * var(--rpx)) solid currentcolor;
  border-radius: var(--radius-8);
}

.task-icon-material-line {
  position: absolute;
  left: calc(6 * var(--rpx));
  height: calc(2 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: currentcolor;
}

.task-icon-material-line--one {
  top: calc(7 * var(--rpx));
  width: calc(14 * var(--rpx));
}

.task-icon-material-line--two {
  top: calc(13 * var(--rpx));
  width: calc(14 * var(--rpx));
}

.task-icon-material-line--three {
  top: calc(19 * var(--rpx));
  width: calc(10 * var(--rpx));
}

.task-icon--grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: calc(4 * var(--rpx));
}

.task-icon--grid .task-icon__shape {
  box-sizing: border-box;
  border: calc(2 * var(--rpx)) solid currentcolor;
  border-radius: calc(3 * var(--rpx));
}

.task-icon-draft-pencil {
  position: absolute;
  top: calc(4 * var(--rpx));
  left: calc(12 * var(--rpx));
  width: calc(6 * var(--rpx));
  height: calc(21 * var(--rpx));
  transform: rotate(45deg);
  border: calc(2 * var(--rpx)) solid currentcolor;
  border-radius: calc(4 * var(--rpx));
}

.task-icon-draft-line {
  position: absolute;
  right: calc(2 * var(--rpx));
  bottom: calc(3 * var(--rpx));
  left: calc(2 * var(--rpx));
  height: calc(2 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: currentcolor;
}

.task-icon--pause {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(4 * var(--rpx));
}

.task-icon--pause .task-icon__shape {
  width: calc(2 * var(--rpx));
  height: calc(14 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: currentcolor;
}

.task-icon--play::before {
  position: absolute;
  top: calc(6 * var(--rpx));
  left: calc(9 * var(--rpx));
  width: 0;
  height: 0;
  border-top: calc(8 * var(--rpx)) solid transparent;
  border-bottom: calc(8 * var(--rpx)) solid transparent;
  border-left: calc(13 * var(--rpx)) solid currentcolor;
  content: "";
}

.task-icon--clock {
  box-sizing: border-box;
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
  border: calc(2 * var(--rpx)) solid currentcolor;
  border-radius: 50%;
}

.task-icon-clock-hand {
  position: absolute;
  top: calc(5 * var(--rpx));
  left: calc(10 * var(--rpx));
  width: calc(2 * var(--rpx));
  height: calc(7 * var(--rpx));
  transform-origin: bottom;
  transform: rotate(-24deg);
  border-radius: var(--radius-capsule);
  background: currentcolor;
}

.task-icon-clock-hand::after {
  position: absolute;
  bottom: calc(-4 * var(--rpx));
  left: 0;
  width: calc(6 * var(--rpx));
  height: calc(2 * var(--rpx));
  transform: rotate(48deg);
  transform-origin: left center;
  border-radius: var(--radius-capsule);
  background: currentcolor;
  content: "";
}

.task-icon--bookmark {
  box-sizing: border-box;
  width: calc(22 * var(--rpx));
  height: calc(28 * var(--rpx));
  border: calc(2 * var(--rpx)) solid currentcolor;
  border-bottom: 0;
  border-radius: calc(4 * var(--rpx)) calc(4 * var(--rpx)) 0 0;
}

.task-icon--bookmark::after {
  position: absolute;
  right: calc(2 * var(--rpx));
  bottom: calc(-7 * var(--rpx));
  left: calc(2 * var(--rpx));
  height: calc(14 * var(--rpx));
  transform: rotate(45deg);
  border-right: calc(2 * var(--rpx)) solid currentcolor;
  border-bottom: calc(2 * var(--rpx)) solid currentcolor;
  background: inherit;
  content: "";
}

.task-icon--spark {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
}

.task-icon__spark-main,
.task-icon__spark-small {
  position: absolute;
  transform: rotate(45deg);
  border-radius: calc(3 * var(--rpx));
  background: currentcolor;
}

.task-icon__spark-main {
  top: calc(5 * var(--rpx));
  left: calc(5 * var(--rpx));
  width: calc(15 * var(--rpx));
  height: calc(15 * var(--rpx));
}

.task-icon__spark-main::after {
  position: absolute;
  top: calc(5 * var(--rpx));
  left: calc(-4 * var(--rpx));
  width: calc(23 * var(--rpx));
  height: calc(5 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: inherit;
  content: "";
}

.task-icon__spark-small {
  right: calc(1 * var(--rpx));
  bottom: calc(1 * var(--rpx));
  width: calc(7 * var(--rpx));
  height: calc(7 * var(--rpx));
}

.task-content {
  min-height: calc(520 * var(--rpx));
  padding-top: calc(24 * var(--rpx));
}

.task-footer {
  position: fixed;
  z-index: var(--z-footer);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: calc(16 * var(--rpx)) var(--space-page-x)
    calc(calc(16 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: 0;
  background: transparent;
  box-shadow: none;
  pointer-events: none;
}

.task-tool-button {
  flex: none;
  width: calc(84 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-compact);
  color: var(--color-muted);
  background: var(--color-surface);
  font-size: var(--text-micro);
  line-height: calc(68 * var(--rpx));
}

.task-footer-main {
  flex: 1;
  min-width: 0;
  pointer-events: auto;
}

@media (min-width: 600px) {
  .task-shell {
    width: 100%;
    max-width: var(--layout-workbench-max);
    margin: 0 auto;
    padding: var(--task-status-bar-height) var(--layout-tablet-gutter) 104px;
  }

  .task-shell--no-footer {
    padding-bottom: 40px;
  }

  .task-shell--no-header {
    padding-top: var(--task-menu-bottom);
  }

  .task-header {
    min-height: 48px;
    margin: 0 calc(var(--layout-tablet-gutter) * -1);
    padding: 10px calc(var(--layout-tablet-gutter) + var(--task-capsule-reserve)) 10px
      var(--layout-tablet-gutter);
    box-shadow: var(--shadow-workbench-wide);
  }

  .task-header-actions {
    gap: 6px;
  }

  .task-header-title {
    gap: 6px;
    margin-left: 8px;
  }

  .task-header-title__main {
    font-size: 16px;
  }

  .task-header-title__progress {
    font-size: 12px;
  }

  .task-header-button,
  .task-question-control,
  .task-timer-control,
  .task-tool-button {
    min-height: 48px;
    border-width: 1px;
  }

  .task-header-button {
    flex-basis: 48px;
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    height: 48px;
  }

  .task-header-button--back {
    border-radius: 14px;
  }

  .task-question-control {
    flex-basis: 112px;
    width: 112px;
    min-width: 112px;
    max-width: 112px;
    height: 48px;
    padding: 0 8px;
  }

  .task-timer-control {
    flex-basis: 128px;
    width: 128px;
    min-width: 128px;
    max-width: 128px;
    height: 48px;
    padding: 0 10px;
  }

  .task-timer-control--read-only {
    width: auto;
    min-width: 92px;
  }

  .task-progress-label {
    font-size: 14px;
  }

  .task-timer {
    font-size: 15px;
  }

  .task-sync-dot {
    width: 6px;
    height: 6px;
  }

  .task-icon {
    width: 22px;
    height: 22px;
  }

  .task-icon--back::before {
    top: 5px;
    left: 7px;
    width: 10px;
    height: 10px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .task-icon--material {
    border-width: 2px;
    border-radius: 4px;
  }

  .task-icon-material-line {
    left: 5px;
    height: 2px;
  }

  .task-icon-material-line--one {
    top: 5px;
    width: 10px;
  }

  .task-icon-material-line--two {
    top: 9px;
    width: 10px;
  }

  .task-icon-material-line--three {
    top: 13px;
    width: 7px;
  }

  .task-icon--grid {
    gap: 3px;
  }

  .task-icon--grid .task-icon__shape {
    border-width: 2px;
    border-radius: 3px;
  }

  .task-icon-draft-pencil {
    top: 3px;
    left: 9px;
    width: 5px;
    height: 16px;
    border-width: 2px;
    border-radius: 3px;
  }

  .task-icon-draft-line {
    height: 2px;
  }

  .task-icon--pause {
    gap: 4px;
  }

  .task-icon--pause .task-icon__shape {
    width: 2px;
    height: 15px;
  }

  .task-icon--play::before {
    top: 4px;
    left: 7px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-left-width: 11px;
  }

  .task-content {
    min-height: 420px;
    padding-top: 24px;
  }

  .task-footer {
    right: auto;
    left: 50%;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--layout-workbench-max);
    gap: 14px;
    padding: 12px var(--layout-tablet-gutter) calc(12px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
  }

  .task-tool-button {
    width: 64px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 46px;
  }
}

@media (min-width: 1024px) {
  .task-shell {
    padding-right: var(--layout-wide-gutter);
    padding-left: var(--layout-wide-gutter);
  }

  .task-header {
    margin-right: calc(var(--layout-wide-gutter) * -1);
    margin-left: calc(var(--layout-wide-gutter) * -1);
    padding-right: calc(var(--layout-wide-gutter) + var(--task-capsule-reserve));
    padding-left: var(--layout-wide-gutter);
  }

  .task-footer {
    padding-right: var(--layout-wide-gutter);
    padding-left: var(--layout-wide-gutter);
  }
}

/*
 * 行测工作台使用微信胶囊左侧的整段导航空间。这里保留 task-shell 的
 * 状态机与事件合同，只改变该变体的几何关系；申论继续走 standard，
 * 行测练习与行测模考共用 xingce 工作台。
 *
 * 该变体按 Figma 2:2 组成固定高度的三段式：状态栏留白 + 导航行(2:27)
 * + 可滚动正文 + 固定底栏(2:199)。正文内部的材料区与题目区各自滚动，
 * 底栏永远在滚动区域之外，避免 D 选项被盖住。
 */
.task-shell--xingce {
  display: flex;
  height: 100vh;
  flex-direction: column;
  padding: var(--task-status-bar-height) 0 0;
  overflow: hidden;
}

.task-shell--xingce.task-shell--no-footer {
  padding-bottom: 0;
}

.task-shell--xingce.task-shell--no-header {
  padding-top: var(--task-menu-bottom);
}

/* 导航行只避让 getMenuButtonBoundingClientRect 实测出的胶囊矩形。 */
.task-shell--xingce .task-header {
  /* 基础规则里的 sticky + top 会把 relative 元素整体下移一行，必须归零。 */
  position: relative;
  top: 0;
  box-sizing: border-box;
  height: var(--task-navigation-height);
  min-height: var(--task-navigation-height);
  flex: none;
  align-items: center;
  margin: 0;
  padding: 0 var(--task-capsule-reserve) 0 calc(32 * var(--rpx));
  justify-content: flex-start;
  border-bottom: 0;
  background: var(--figma-color-surface);
  box-shadow: none;
  backdrop-filter: none;
}

.task-shell--xingce .task-header-actions {
  flex: 1;
  min-width: 0;
  gap: calc(32 * var(--rpx));
  justify-content: flex-start;
}

.task-shell--xingce .task-header-button,
.task-shell--xingce .task-question-control,
.task-shell--xingce .task-timer-control {
  min-height: calc(56 * var(--rpx));
  border: 0;
  background: transparent;
}

.task-shell--xingce .task-header-button {
  flex: 0 0 calc(56 * var(--rpx));
  width: calc(56 * var(--rpx));
  min-width: calc(56 * var(--rpx));
  max-width: calc(56 * var(--rpx));
  height: calc(56 * var(--rpx));
  border-radius: var(--radius-16);
}

.task-shell--xingce .task-header-button--back {
  flex: 0 0 calc(48 * var(--rpx));
  width: calc(48 * var(--rpx));
  min-width: calc(48 * var(--rpx));
  max-width: calc(48 * var(--rpx));
  height: calc(56 * var(--rpx));
  margin-right: 0;
}

/* 题号：list 图标 16px + 6px 间距 + 3/5 文本。 */
.task-shell--xingce .task-question-control {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: none;
  height: calc(56 * var(--rpx));
  gap: calc(12 * var(--rpx));
  padding: 0;
}

/* 计时胶囊 2:44：#f9fafb，圆角 30px，内距 8/4。 */
.task-shell--xingce .task-timer-control {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: none;
  height: calc(60 * var(--rpx));
  gap: calc(12 * var(--rpx));
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-64);
  background: var(--figma-color-surface-subtle);
}

.task-shell--xingce .task-timer-control--paused {
  color: var(--color-warning);
  background: var(--color-warning-soft);
}

.task-shell--xingce .task-header-divider,
.task-shell--xingce .task-sync-dot {
  display: none;
}

/* 行测最后一个会话级动作落在胶囊左侧，不使用 margin-left:auto。 */
.task-shell--xingce .task-header-button--tool,
.task-shell--xingce .task-header-button--companion {
  flex: 0 0 calc(56 * var(--rpx));
  width: calc(56 * var(--rpx));
  min-width: calc(56 * var(--rpx));
  max-width: calc(56 * var(--rpx));
  height: calc(56 * var(--rpx));
  border-radius: var(--radius-16);
  background: transparent;
}

.task-shell--xingce .task-header-button--companion {
  flex: 0 0 44px;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  height: 44px;
  min-height: 44px;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
}

/* 保留 44px 易点热区，视觉仍是原版 56rpx 紫粉圆与 13px 星芒。 */
.task-companion-mark {
  display: flex;
  width: calc(56 * var(--rpx));
  height: calc(56 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--color-on-primary);
  background: var(--figma-gradient-ai);
  box-shadow: var(--shadow-ai);
}

.task-shell--xingce .task-progress-label {
  color: var(--figma-color-ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.task-shell--xingce .task-timer {
  color: var(--figma-color-ink-secondary);
  font-size: var(--text-body);
  letter-spacing: calc(1.3 * var(--rpx));
}

.task-shell--xingce .task-content {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  padding-top: 0;
}

/* 底栏 2:199 是列布局的最后一段，不参与滚动也不覆盖正文。 */
.task-shell--xingce .task-footer {
  box-sizing: border-box;
  position: relative;
  right: auto;
  bottom: auto;
  left: auto;
  width: 100%;
  max-width: none;
  flex: none;
  padding: calc(26 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--figma-color-line);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-dock);
  backdrop-filter: none;
  /* 清掉平板公共 fixed footer 的居中位移；当前变体已回到 flex 文档流。 */
  transform: none;
}

.task-asset-icon {
  display: block;
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

.task-asset-icon--list {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}

.task-asset-icon--clock {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
}

.task-asset-icon--pause {
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
}

.task-asset-icon--anan {
  width: calc(26 * var(--rpx));
  height: calc(26 * var(--rpx));
}

.task-asset-icon--back {
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
}

.task-asset-icon--tool {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

@media (min-width: 600px) {
  .task-shell--xingce {
    padding-right: 0;
    padding-left: 0;
  }

  .task-shell--xingce .task-header {
    margin: 0;
    padding-right: var(--task-capsule-reserve);
    padding-left: var(--layout-tablet-gutter);
  }

  .task-shell--xingce .task-header-button--back {
    margin-right: 12px;
  }

  .task-shell--xingce .task-header-actions {
    gap: 18px;
  }

  .task-shell--xingce .task-content {
    padding-top: 0;
  }
}

/* 平板宽屏：顶栏舒展（更大热区与间距），底栏内容居中限宽。 */
@media (min-width: 1024px) {
  .task-header {
    min-height: 56px;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .task-header-button {
    width: 38px;
    min-width: 38px;
    max-width: 38px;
    height: 38px;
    border-radius: 12px;
  }

  .task-header-actions {
    gap: 14px;
  }

  .task-progress-label {
    font-size: 14px;
  }

  .task-footer {
    justify-content: center;
  }

  .task-footer-main {
    max-width: 640px;
    flex: 0 1 640px;
  }
}
