<view class="s9-page s9-page--with-dock briefing-page">
  <block wx:if="{{status === 'default' || status === 'loading'}}">
    <state-view custom-class="briefing-state-view" state="loading" title="正在读取任务说明" description="先看看说明，不会开始计时。" />
  </block>

  <block wx:elif="{{status === 'error'}}">
    <state-view
      custom-class="briefing-state-view"
      state="error"
      title="{{errorTitle}}"
      description="{{errorMessage}}"
      request-id="{{requestId}}"
      action-text="{{canRetry ? '重新读取' : ''}}"
      bind:action="retry"
    />
    <view wx:if="{{!canRetry}}" class="briefing-fallback-actions">
      <ui-button custom-class="briefing-state-action" label="返回今日计划" bind:action="returnToday" />
    </view>
  </block>

  <view wx:elif="{{status === 'expired'}}" class="expired-state">
    <state-view custom-class="briefing-state-view" state="error" title="{{errorTitle}}" description="{{errorMessage}}" request-id="{{requestId}}" />
    <ui-button custom-class="briefing-state-action" label="重新加载" variant="secondary" bind:action="retry" />
    <ui-button custom-class="briefing-state-action" label="返回今日计划" bind:action="returnToday" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="account-gate">
    <state-view custom-class="briefing-state-view" state="error" title="{{errorTitle}}" description="{{errorMessage}}" />
    <ui-button wx:if="{{showLoginAction}}" custom-class="briefing-state-action" label="重新登录" bind:action="goLogin" />
  </view>

  <block wx:elif="{{status === 'ready'}}">
    <view wx:if="{{recovered}}" class="recovery-note">已加载最新说明。</view>
    <view class="s9-hero">
      <view class="s9-title">这组题只验证一个问题</view>
      <view class="s9-subtitle">先知道为什么做、做多长、完成后看什么，再进入训练。</view>
      <view class="s9-chip-row">
        <view class="s9-chip s9-chip--primary">{{view.scopeLabel}}</view>
        <view class="s9-chip">{{view.targetTimeLabel}}</view>
      </view>
    </view>

    <view class="s9-stack">
      <view class="s9-card s9-card--primary">
        <view class="s9-card-kicker">本次目标 · {{view.modeLabel}}</view>
        <view class="s9-card-title">{{view.title}}</view>
        <view class="s9-metric">{{view.questionCountLabel}}</view>
        <view class="s9-card-copy">{{view.reason}}</view>
        <view class="s9-card-meta">单题参考 {{view.perQuestionTimeLabel}} · {{view.validUntilLabel}}</view>
      </view>

      <view wx:if="{{view.verificationStageLabel}}" class="s9-card">
        <view class="s9-card-kicker">本次复测阶段</view>
        <view class="s9-card-title">{{view.verificationStageLabel}}</view>
        <view class="s9-card-copy">{{view.sourceMasteryLabel}}</view>
      </view>

      <view class="s9-card">
        <view class="s9-card-kicker">完成后</view>
        <view class="s9-card-title">只复盘最有价值的题</view>
        <view class="evidence-grid">
          <view wx:for="{{view.evidenceItems}}" wx:key="code" class="evidence-chip">{{item.label}}</view>
        </view>
        <view class="s9-card-copy">一次正确不会直接标记稳定掌握；主动放弃也不会自动算成知识错误。</view>
      </view>
    </view>

    <view class="s9-action-dock">
      <button hover-class="item--hover" class="s9-primary-button" loading="{{starting}}" bindtap="startTask">开始专项训练</button>
    </view>
  </block>
</view>
