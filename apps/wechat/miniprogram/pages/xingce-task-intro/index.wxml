<view class="page briefing-page">
  <view wx:if="{{status === 'default' || status === 'loading'}}">
    <state-view state="loading" title="正在读取任务说明" description="载入说明不会创建作答会话，也不会开始计时。" />
  </view>

  <state-view
    wx:elif="{{status === 'error'}}"
    state="error"
    title="{{errorTitle}}"
    description="{{errorMessage}}"
    request-id="{{requestId}}"
    action-text="重新读取"
    bind:action="retry"
  />

  <view wx:elif="{{status === 'expired'}}" class="expired-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" request-id="{{requestId}}" />
    <ui-button label="重新读取服务端说明" variant="secondary" bind:action="retry" />
    <ui-button label="返回今日计划" bind:action="returnToday" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="account-gate">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" />
    <ui-button wx:if="{{showLoginAction}}" label="重新登录" bind:action="goLogin" />
  </view>

  <block wx:else>
    <view wx:if="{{recovered}}" class="recovery-note">已恢复并读取当前服务端权威说明。</view>

    <view class="briefing-hero">
      <view class="hero-topline">
        <view class="mode-pill">{{view.modeLabel}}</view>
        <view class="scope-label">{{view.scopeLabel}}</view>
      </view>
      <view class="hero-title">{{view.title}}</view>
      <view class="hero-reason">{{view.reason}}</view>
      <view class="hero-metrics">
        <view><text>{{view.questionCountLabel}}</text><small>固定题量</small></view>
        <view><text>{{view.targetTimeLabel}}</text><small>建议时长</small></view>
        <view><text>{{view.perQuestionTimeLabel}}</text><small>仅作参考</small></view>
      </view>
    </view>

    <view wx:if="{{view.verificationStageLabel}}" class="verification-card briefing-card">
      <view class="section-eyebrow">本次复测阶段</view>
      <view class="section-title">{{view.verificationStageLabel}}</view>
      <view class="section-copy">{{view.sourceMasteryLabel}}</view>
    </view>

    <view class="briefing-card">
      <view class="section-eyebrow">本次验收证据</view>
      <view class="section-title">不只看 3 题做对几题</view>
      <view class="evidence-grid">
        <view wx:for="{{view.evidenceItems}}" wx:key="code" class="evidence-chip">{{item.label}}</view>
      </view>
      <view class="section-copy">一次正确不会直接标记稳定掌握；仍需通过延时验证。</view>
    </view>

    <view class="briefing-card abandonment-card">
      <view class="section-eyebrow">主动放弃的含义</view>
      <view class="section-title">不会自动算成知识错误</view>
      <view class="section-copy">只有你明确点击“放弃”才会记录。它会保留为时间或策略证据，但不会被岸岸擅自归因为不会。</view>
    </view>

    <view class="timing-note">
      <view class="timing-mark">计时</view>
      <view>
        <view class="timing-title">建议时长，不是强制倒计时</view>
        <view class="timing-copy">超过单题参考时间会如实记录，但不会中断作答或自动交卷。</view>
      </view>
    </view>

    <view class="version-note type-data">
      <view>{{view.validUntilLabel}}</view>
      <view>{{view.planVersionLabel}}</view>
    </view>

    <ui-button label="开始任务" loading="{{starting}}" bind:action="startTask" />
    <view class="start-boundary">点击后才进入真实作答并由服务端创建或恢复会话。</view>
  </block>
</view>
