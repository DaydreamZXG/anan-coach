.briefing-page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.briefing-state-view {
  display: block;
  margin-top: 30rpx;
}

.expired-state,
.account-gate {
  padding-top: 12rpx;
}

.briefing-state-action {
  display: block;
  margin-top: 16rpx;
}

.recovery-note {
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(22, 119, 94, 0.15);
  border-radius: 18rpx;
  background: var(--color-primary-soft);
  color: var(--color-success);
  font-size: 21rpx;
}

.briefing-hero {
  overflow: hidden;
  padding: 38rpx 34rpx;
  border-radius: 34rpx;
  background: var(--color-primary-soft);
  box-shadow: var(--shadow-card);
  color: var(--color-surface);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mode-pill {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 227, 200, 0.34);
  border-radius: var(--figma-radius-pill);
  background: rgba(255, 227, 200, 0.14);
  color: var(--figma-color-warning-soft);
  font-size: 20rpx;
  font-weight: 780;
}

.scope-label {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.65);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 860;
  line-height: 1.38;
}

.hero-reason {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 23rpx;
  line-height: 1.7;
}

.briefing-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 26rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 34rpx rgba(45, 52, 94, 0.05);
}

.verification-card {
  border-color: var(--color-primary-a24);
  background: linear-gradient(145deg, var(--color-surface-soft), var(--color-surface));
}

.abandonment-card {
  border-color: rgba(185, 141, 47, 0.14);
  background: var(--figma-color-warning-soft);
}

.section-eyebrow {
  color: var(--color-primary);
  font-size: 19rpx;
  font-weight: 780;
  letter-spacing: 2rpx;
}

.abandonment-card .section-eyebrow {
  color: var(--color-warning);
}

.section-title {
  margin-top: 10rpx;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 820;
}

.section-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.7;
}

.evidence-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.evidence-chip {
  padding: 10rpx 15rpx;
  border-radius: var(--figma-radius-pill);
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-soft);
  color: var(--color-primary-deep);
  font-size: 20rpx;
  font-weight: 720;
}

.timing-note {
  display: flex;
  gap: 18rpx;
  margin: 20rpx 0 28rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: var(--figma-color-warning-soft);
}

.timing-mark {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--color-success);
  color: var(--color-surface);
  font-size: 20rpx;
  font-weight: 800;
}

.timing-title {
  color: var(--good);
  font-size: 24rpx;
  font-weight: 800;
}

.timing-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.6;
}

.version-note {
  display: grid;
  gap: 6rpx;
  margin-bottom: 22rpx;
  color: var(--color-faint);
  font-size: 18rpx;
  word-break: break-all;
}

.start-boundary {
  margin-top: 12rpx;
  color: var(--color-faint);
  font-size: 19rpx;
  line-height: 1.55;
  text-align: center;
}
