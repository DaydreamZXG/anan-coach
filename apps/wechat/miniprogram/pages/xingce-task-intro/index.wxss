.briefing-page {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.briefing-state-view {
  display: block;
  margin-top: 32rpx;
}

.expired-state,
.account-gate {
  padding-top: 12rpx;
}

.briefing-state-action {
  display: block;
  margin-top: 16rpx;
}

.recovery-note {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(22, 119, 94, 0.15);
  border-radius: var(--radius-16);
  background: var(--color-primary-soft);
  color: var(--color-success);
  font-size: var(--text-micro);
}

.briefing-hero {
  overflow: hidden;
  padding: 40rpx 32rpx;
  border-radius: var(--radius-32);
  background: var(--color-primary-soft);
  box-shadow: var(--shadow-card);
  color: var(--color-surface);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mode-pill {
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255, 227, 200, 0.34);
  border-radius: var(--figma-radius-pill);
  background: rgba(255, 227, 200, 0.14);
  color: var(--figma-color-warning-soft);
  font-size: var(--text-micro);
  font-weight: 800;
}

.scope-label {
  overflow: hidden;
  color: rgba(255, 255, 255, 0.65);
  font-size: var(--text-micro);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-title {
  margin-top: 28rpx;
  font-size: var(--text-title);
  font-weight: 800;
  line-height: 1.38;
}

.hero-reason {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: var(--text-caption);
  line-height: 1.7;
}

.briefing-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.verification-card {
  border-color: var(--color-primary-a24);
  background: linear-gradient(145deg, var(--color-surface-soft), var(--color-surface));
}

.abandonment-card {
  border-color: rgba(185, 141, 47, 0.14);
  background: var(--figma-color-warning-soft);
}

.section-eyebrow {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.abandonment-card .section-eyebrow {
  color: var(--color-warning);
}

.section-title {
  margin-top: 12rpx;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
}

.section-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.7;
}

.evidence-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.evidence-chip {
  padding: 12rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.timing-note {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 0 28rpx;
  padding: 24rpx;
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
}

.timing-mark {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-24);
  background: var(--color-success);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 800;
}

.timing-title {
  color: var(--good);
  font-size: var(--text-caption);
  font-weight: 800;
}

.timing-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.version-note {
  display: grid;
  gap: 8rpx;
  margin-bottom: 24rpx;
  color: var(--color-faint);
  font-size: var(--text-micro);
  word-break: break-all;
}

.start-boundary {
  margin-top: 12rpx;
  color: var(--color-faint);
  font-size: var(--text-micro);
  line-height: 1.55;
  text-align: center;
}
