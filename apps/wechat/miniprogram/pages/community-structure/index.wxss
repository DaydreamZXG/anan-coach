@import "../../features/community-method-cards/page-shell.wxss";

.compact-area {
  min-height: calc(132 * var(--rpx));
}

.rights-row {
  display: flex;
  align-items: center;
  gap: calc(20 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
}

.rights-row--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.rights-radio {
  display: flex;
  width: calc(38 * var(--rpx));
  height: calc(38 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border: calc(2 * var(--rpx)) solid var(--color-primary);
  border-radius: 50%;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
}

.check-row {
  display: grid;
  grid-template-columns: calc(64 * var(--rpx)) 1fr;
  margin-top: calc(12 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
}

.check-row__number {
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-weight: 800;
}
