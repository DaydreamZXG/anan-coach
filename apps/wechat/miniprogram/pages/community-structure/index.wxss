@import "../../features/community-method-cards/page-shell.wxss";

.compact-area {
  min-height: 132rpx;
}

.rights-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
}

.rights-row--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.rights-radio {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-primary);
  border-radius: 50%;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
}

.check-row {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  margin-top: 12rpx;
  padding: 20rpx 20rpx;
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
}

.check-row__number {
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-weight: 800;
}
