.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.pd { display: flex; flex-direction: column; min-height: 100vh; }
.pd-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.pd-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.pd-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.pd-loading { padding: 120rpx 0; text-align: center; }
.pd-body { flex: 1; min-height: 0; }

.pd-head { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }
.pd-name { line-height: 1.4; }

.pd-score { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 8rpx; border-left: 6rpx solid var(--primary); }
.pd-score-main { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.pd-score-num { font-size: 64rpx; font-weight: 700; color: var(--primary); line-height: 1.1; }
.pd-entry { line-height: 1.6; }

.pd-section { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-3); padding: 28rpx 8rpx 16rpx; }

.pd-rows { display: flex; flex-direction: column; gap: 24rpx; }
.pd-row { display: flex; justify-content: space-between; gap: 24rpx; }
.pd-row-label { font-size: 28rpx; color: var(--ink-3); flex-shrink: 0; }
.pd-row-value { font-size: 28rpx; color: var(--ink); text-align: right; }

.pd-remark { line-height: 1.7; }

.pd-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.pd-foot-btn { width: 100%; }
.demo-tip { text-align: center; padding: 16rpx 0; }
