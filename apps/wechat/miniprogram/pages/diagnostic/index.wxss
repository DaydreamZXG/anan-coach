.stem { margin: 54rpx 4rpx 38rpx; font-size: 34rpx; font-weight: 700; line-height: 1.65; }
.diagnostic-progress { font-family: var(--font-family-data); font-variant-numeric: tabular-nums; }
.answer { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding: 24rpx; border: 1rpx solid var(--color-line); border-radius: 20rpx; background: var(--color-surface); }
.answer--selected { border: 2rpx solid var(--color-primary); background: var(--color-primary-soft); }
.answer-label { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 16rpx; background: var(--color-canvas); color: var(--color-primary); font-weight: 800; }
.confidence-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.confidence { padding: 20rpx 10rpx; border: 1rpx solid var(--color-line); border-radius: 16rpx; background: var(--color-surface); text-align: center; font-size: 23rpx; }
.confidence--selected { border-color: var(--color-primary); background: var(--color-primary); color: #ffffff; }
.submit { margin-top: 38rpx; }
.complete { margin-top: 100rpx; }
.result-mark { display: inline-flex; margin-bottom: 24rpx; padding: 12rpx 20rpx; border-radius: 99rpx; background: var(--color-success-soft); color: var(--color-success); font-weight: 750; }
