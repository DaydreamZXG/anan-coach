<view class="page">
  <block wx:if="{{!complete}}">
    <view class="row">
      <view class="pill">{{questions[index].module}}</view>
      <view class="caption"><text class="diagnostic-progress">{{index + 1}} / {{questions.length}}</text> · 原型短测</view>
    </view>
    <view class="stem">{{questions[index].stem}}</view>
    <view class="options">
      <view wx:for="{{questions[index].options}}" wx:key="*this" class="answer {{selected === index ? 'answer--selected' : ''}}" data-index="{{index}}" bindtap="selectAnswer">
        <view class="answer-label">{{['A','B','C','D'][index]}}</view>
        <view>{{item}}</view>
      </view>
    </view>
    <view class="section-heading"><view class="section-title">你有多确定？</view></view>
    <view class="confidence-row">
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="confidence {{confidence === item ? 'confidence--selected' : ''}}" data-value="{{item}}" bindtap="selectConfidence">{{['蒙的','不太确定','比较确定','非常确定'][index]}}</view>
    </view>
    <button class="primary-button submit" bindtap="next">下一题</button>
  </block>

  <view wx:else class="card state-card complete">
    <view class="result-mark">完成</view>
    <view class="state-title">这是低置信起点，不是最终分数</view>
    <view class="state-copy">系统会结合后续练习、模考、用时和复盘持续缩小估分区间。</view>
    <button class="primary-button" bindtap="backToday">查看今日计划</button>
  </view>
</view>
