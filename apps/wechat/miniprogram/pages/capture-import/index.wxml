<view class="capture-page {{state && state.status === 'idle' ? 'capture-page--camera' : ''}}">
  <view class="capture-nav">
    <view class="capture-nav__side" role="button" aria-label="返回" bindtap="goBack">‹</view>
    <view class="capture-nav__title">
      {{state && state.status === 'review' ? '确认识别结果' : (state && state.status === 'success' ? '搜题结果' : '拍照搜题')}}
    </view>
    <view class="capture-nav__side capture-nav__side--text" role="button" bindtap="chooseCamera">{{state && state.status === 'review' ? '重拍' : ''}}</view>
  </view>

  <state-view
    wx:if="{{configurationError}}"
    state="error"
    title="导入服务未完成配置"
    description="{{configurationError}}"
  />

  <block wx:elif="{{state}}">
    <block wx:if="{{state.status === 'idle'}}">
      <view class="capture-mode-switch">
        <view class="capture-mode {{mode === 'search' ? 'capture-mode--active' : ''}}" data-mode="search" bindtap="chooseMode">单题搜题</view>
        <view class="capture-mode {{mode === 'import' ? 'capture-mode--active' : ''}}" data-mode="import" bindtap="chooseMode">单题资料导入</view>
      </view>

      <view wx:if="{{mode === 'search'}}" class="ilink-card">
        <view class="ilink-card__head">
          <view>
            <view class="ilink-card__eyebrow">微信发图搜题</view>
            <view class="ilink-card__title">不打开小程序，也能把题发给岸岸</view>
          </view>
          <view wx:if="{{channelStatus === 'ready'}}" class="ilink-card__refresh" role="button" aria-label="刷新连接状态" bindtap="loadChannel">↻</view>
        </view>

        <view wx:if="{{channelStatus === 'loading'}}" class="ilink-card__state">正在核对连接状态…</view>
        <view wx:elif="{{channelStatus === 'unavailable'}}">
          <view class="ilink-card__disabled">微信发图入口暂未开放，请先用下方小程序拍照搜题。</view>
        </view>
        <view wx:elif="{{channelStatus === 'error'}}">
          <view class="ilink-card__error">{{channelError}}</view>
          <button class="ilink-card__button ilink-card__button--quiet" bindtap="loadChannel">重新加载</button>
        </view>
        <block wx:elif="{{channelView}}">
          <view wx:if="{{channelView.linkState === 'unbound' || channelView.linkState === 'revoked'}}">
            <view class="ilink-card__copy">生成一次性连接码，把它发给岸岸；码有效期内只可绑定一个微信入口。</view>
            <button class="ilink-card__button" loading="{{channelWriting}}" bindtap="issueChannelCode">生成连接码</button>
          </view>
          <view wx:elif="{{channelView.linkState === 'pending'}}">
            <view class="ilink-card__status {{channelExpired ? 'ilink-card__status--warning' : ''}}">
              {{channelExpired ? '连接码已过期' : '等待在微信里确认连接'}}
            </view>
            <view wx:if="{{!channelExpired}}" class="ilink-code" role="button" aria-label="复制连接码" bindtap="copyChannelCode">
              <text class="ilink-code__value type-data">{{channelView.bindingCode}}</text>
              <text class="ilink-code__action">复制</text>
            </view>
            <view wx:if="{{!channelExpired}}" class="ilink-card__hint">把上面的码原样发给岸岸。到期时间：{{channelView.expiresAt}}</view>
            <button class="ilink-card__button ilink-card__button--quiet" loading="{{channelWriting}}" bindtap="replaceChannelCode">{{channelExpired ? '重新生成' : '作废并换一个码'}}</button>
            <button class="ilink-card__link" loading="{{channelWriting}}" bindtap="revokeChannelLink">取消连接</button>
          </view>
          <view wx:elif="{{channelView.linkState === 'bound'}}">
            <view class="ilink-card__status">● 已连接</view>
            <view class="ilink-card__copy">现在可在微信里发送裁剪好的单题图片。已查询 {{channelView.queryCount}} 次，个人收录 {{channelView.collectionCount}} 道。</view>
            <view class="ilink-card__boundary">{{channelView.evidenceCopy}}</view>
            <button class="ilink-card__link ilink-card__link--danger" loading="{{channelWriting}}" bindtap="revokeChannelLink">解除连接</button>
          </view>
          <view wx:if="{{channelError}}" class="ilink-card__error">{{channelError}}</view>
        </block>
      </view>

      <view class="camera-stage">
        <view class="camera-chip">自动识别行测 / 申论</view>
        <view class="camera-document">
          <view class="camera-document__label">题目区域</view>
          <view class="camera-document__line camera-document__line--wide"></view>
          <view class="camera-document__line"></view>
          <view class="camera-document__line camera-document__line--short"></view>
          <view class="camera-options">A　　B　　C　　D</view>
          <view class="scan-corner scan-corner--tl"></view>
          <view class="scan-corner scan-corner--tr"></view>
          <view class="scan-corner scan-corner--bl"></view>
          <view class="scan-corner scan-corner--br"></view>
        </view>
        <view class="camera-hint">
          {{mode === 'search' ? '将题干、材料和选项完整放入画面' : '可导入多页材料或多题 PDF，系统会逐题拆分和确认'}}
        </view>
      </view>

      <view class="capture-note">✓　先确认识别内容，再发起搜索</view>
      <view class="capture-track-row">
        <view class="capture-track {{state.learningTrack === 'xingce' ? 'capture-track--active' : ''}}" data-value="xingce" bindtap="chooseTrack">行测</view>
        <view class="capture-track {{state.learningTrack === 'essay' ? 'capture-track--active' : ''}}" data-value="essay" bindtap="chooseTrack">申论</view>
      </view>

      <view wx:if="{{mode === 'search'}}" class="capture-controls">
        <view class="capture-control" role="button" aria-label="从相册选择题目" bindtap="chooseAlbum"><view class="capture-control__icon">▧</view><text>相册</text></view>
        <view class="capture-shutter" role="button" aria-label="打开相机拍题" bindtap="chooseCamera"><view class="capture-shutter__core"></view></view>
        <view class="capture-control capture-control--quiet"><view class="capture-control__icon">✓</view><text>原图</text></view>
      </view>
      <view wx:else class="import-actions">
        <button class="import-action" bindtap="chooseAlbum">从相册选择图片</button>
        <button class="import-action import-action--primary" bindtap="choosePdf">导入 PDF</button>
      </view>
      <view wx:if="{{state.validationError}}" class="capture-error">{{state.validationError}}</view>
      <view class="capture-privacy">图片仅用于本次识别与个人学习，不进入公共题库或模型训练；微信发图查询也遵循同一边界</view>
    </block>

    <block wx:elif="{{state.status === 'uploading'}}">
      <view class="capture-content">
        <view class="s9-hero">
          <view class="s9-kicker">安全上传</view>
          <view class="s9-title">正在读取题面</view>
          <view class="s9-subtitle">原图会先完成完整性、安全与归属校验，再进入 OCR。</view>
        </view>
        <view class="capture-progress-card">
          <view class="capture-progress-number type-data">{{state.uploadProgress ? state.uploadProgress.percent : 0}}%</view>
          <view class="capture-progress-track"><view class="capture-progress-bar" style="width: {{state.uploadProgress ? state.uploadProgress.percent : 0}}%"></view></view>
          <view class="capture-progress-file">{{state.selectedFile.displayName}}</view>
        </view>
      </view>
    </block>

    <view wx:elif="{{state.status === 'processing'}}" class="capture-content">
      <state-view state="processing" title="正在识别题面" description="{{state.workspace && state.workspace.processingLabel ? state.workspace.processingLabel : '正在分页、分区并识别文字。'}}" request-id="{{state.workspace ? state.workspace.requestId : ''}}" />
    </view>

    <view wx:elif="{{state.status === 'expired'}}" class="capture-content">
      <state-view state="stale" title="这次识别已过期" description="过期结果不能继续确认，请重新拍摄原题。" action-text="重新选择题目" bind:action="restart" />
    </view>

    <view wx:elif="{{state.status === 'quarantined'}}" class="capture-content">
      <state-view state="error" title="文件没有通过安全检查" description="该文件不会进入 OCR、匹配或学习诊断。" request-id="{{state.workspace ? state.workspace.requestId : ''}}" action-text="选择其他文件" bind:action="restart" />
    </view>

    <view wx:elif="{{state.status === 'error'}}" class="capture-content">
      <state-view state="error" title="{{state.error ? state.error.title : '处理没有完成'}}" description="{{state.error ? state.error.message : '请重新拍摄或刷新当前版本。'}}" request-id="{{state.error ? state.error.requestId : ''}}" action-text="{{state.pendingRecovery || state.workspace ? '恢复当前操作' : '重新选择题目'}}" bind:action="handleErrorAction" />
      <view wx:if="{{state.error && !state.error.retryable}}" class="capture-boundary capture-boundary--error">当前错误不会自动重试，避免把题图、答案或资料发送到未放行链路；可以返回手动录入、已确认题库或私人资料能力。</view>
    </view>

    <block wx:elif="{{state.status === 'review'}}">
      <view class="capture-content capture-content--review">
        <view class="source-preview">
          <image wx:if="{{state.selectedFile && state.selectedFile.mimeType !== 'application/pdf'}}" class="source-preview__image" src="{{state.selectedFile.localPath}}" mode="aspectFill" />
          <view wx:else class="source-preview__pdf">PDF</view>
          <view class="source-preview__quality"><text class="source-preview__quality-title">画面已读取</text><text>请核对文字和题型</text></view>
        </view>

        <view class="recognized-type-card">
          <view class="recognized-type-copy"><text class="recognized-type-copy__label">识别题型</text><text class="recognized-type-copy__value">{{state.learningTrack === 'xingce' ? '行测' : '申论'}} · {{state.workspace.recognition.recognitionKind}}</text></view>
          <view class="recognized-type-actions">
            <text class="recognized-type-action {{state.learningTrack === 'xingce' ? 'is-active' : ''}}" data-value="xingce" bindtap="chooseTrack">行测</text>
            <text class="recognized-type-action {{state.learningTrack === 'essay' ? 'is-active' : ''}}" data-value="essay" bindtap="chooseTrack">申论</text>
          </view>
        </view>

        <view class="ocr-card">
          <view class="ocr-card__head"><text class="ocr-card__title">识别文字</text><text class="ocr-card__count">{{state.segments.length}} 个片段</text></view>
          <view wx:for="{{state.segments}}" wx:key="segmentId" class="ocr-segment">
            <view class="ocr-segment__meta"><text>第 {{item.pageNo}} 页 · 片段 {{item.ordinal}}</text><text class="status-{{item.tone}}">{{item.confidenceLabel}}</text></view>
            <textarea class="ocr-segment__input" value="{{item.text}}" disabled="{{state.submitting || state.reviewStep === 'match'}}" data-id="{{item.segmentId}}" aria-label="第 {{item.ordinal}} 个 OCR 文本" bindinput="inputSegment" />
          </view>
        </view>

        <view wx:if="{{state.reviewStep === 'recognition'}}" class="capture-completeness">✓　请确认题干、材料和选项都已识别完整</view>

        <block wx:else>
          <view class="capture-completeness">✓　已拆分 {{state.workspace.questionUnits.length}} 道题，每题独立确认</view>
          <view class="question-unit-tabs">
            <view wx:for="{{state.workspace.questionUnits}}" wx:key="questionUnitId" class="question-unit-tab {{index === state.activeQuestionUnitIndex ? 'is-active' : ''}}" data-index="{{index}}" bindtap="selectQuestionUnit">{{item.ordinal}}</view>
          </view>
          <view wx:if="{{state.activeQuestionUnit && state.activeQuestionUnit.state === 'unmatched' && !state.activeQuestionUnit.aiAnswer}}" class="capture-warning">题库未命中。可以申请 AI 估算解析，它不是官方答案，确认后也只供参考。</view>
          <block wx:if="{{state.activeQuestionUnit && state.activeQuestionUnit.match}}">
            <view wx:for="{{state.activeQuestionUnit.match.candidates}}" wx:key="contentVersionId" class="match-choice {{state.selectedContentVersionId === item.contentVersionId ? 'match-choice--selected' : ''}}" data-id="{{item.contentVersionId}}" bindtap="selectMatch">
              <view class="match-choice__copy"><text class="match-choice__kind">{{item.matchKind === 'exact' ? '精确匹配' : '相似题目'}}</text><text class="match-choice__version type-data">{{item.contentVersionId}}</text></view>
              <view class="match-choice__score type-data">{{item.score}}</view>
            </view>
          </block>
          <button wx:if="{{state.activeQuestionUnit && state.activeQuestionUnit.state === 'unmatched' && !state.activeQuestionUnit.aiAnswer}}" class="capture-secondary" loading="{{state.submitting}}" bindtap="requestAIAnswer">申请 AI 估算解析</button>
          <view wx:if="{{state.activeQuestionUnit && state.activeQuestionUnit.aiAnswer && (state.activeQuestionUnit.aiAnswer.state === 'requested' || state.activeQuestionUnit.aiAnswer.state === 'processing')}}" class="capture-warning">AI 正在解题，页面会自动刷新。</view>
          <view wx:if="{{state.activeQuestionUnit && state.activeQuestionUnit.aiAnswer && (state.activeQuestionUnit.aiAnswer.state === 'candidate' || state.activeQuestionUnit.aiAnswer.state === 'confirmed')}}" class="result-answer-card">
            <text class="result-answer-card__label">AI 估算解析 · 不是官方答案</text>
            <text class="result-answer-card__title">{{state.activeQuestionUnit.aiAnswer.answerText}}</text>
            <text class="result-reason-card__copy">{{state.activeQuestionUnit.aiAnswer.explanation}}</text>
            <button wx:if="{{state.activeQuestionUnit.aiAnswer.state === 'candidate'}}" class="capture-secondary" loading="{{state.submitting}}" bindtap="confirmAIAnswer">我已核对，仅作参考</button>
          </view>
        </block>

        <view wx:if="{{state.validationError}}" class="capture-error">{{state.validationError}}</view>
        <view class="capture-boundary">确认前不会写入能力画像、错因或今日计划。</view>
      </view>
      <view class="capture-dock">
        <button wx:if="{{state.reviewStep === 'recognition' || (state.activeQuestionUnit && state.activeQuestionUnit.state === 'match_review')}}" class="capture-primary" loading="{{state.submitting}}" bindtap="confirmImport">
          {{state.reviewStep === 'recognition' ? '确认识别文字' : '确认并查看结果'}}
        </button>
      </view>
    </block>

    <block wx:elif="{{state.status === 'success'}}">
      <view class="capture-content capture-content--result">
        <view class="matched-banner"><text class="matched-banner__title">{{state.workspace.questionUnits.length}} 道题已逐题完成</text><text class="matched-banner__note">结果只在你的账户内使用</text></view>
        <view class="result-question-card">
          <view class="result-chip">{{state.learningTrack === 'xingce' ? '行测' : '申论'}}</view>
          <view wx:for="{{state.segments}}" wx:key="segmentId" class="result-segment">{{item.text}}</view>
        </view>
        <view wx:for="{{state.workspace.questionUnits}}" wx:key="questionUnitId" class="result-answer-card {{item.referenceAnswer || item.aiAnswer ? '' : 'result-answer-card--empty'}}">
          <text class="result-answer-card__label">第 {{item.ordinal}} 题 · {{item.referenceAnswer ? '授权参考答案' : 'AI 估算解析'}}</text>
          <text class="result-answer-card__title">{{item.referenceAnswer ? item.referenceAnswer.answerText : (item.aiAnswer ? item.aiAnswer.answerText : '当前暂无可展示的答案')}}</text>
          <view class="result-answer-card__version type-data">{{item.referenceAnswer ? (item.referenceAnswer.matchKind === 'exact' ? '原题精确匹配 · 仅供核对' : '相似题匹配 · 请结合题面核对') : 'AI 生成 · 不是官方答案'}}</view>
        </view>
        <view class="result-reason-card">
          <text class="result-reason-card__title">这次匹配如何产生</text>
          <text class="result-reason-card__copy">系统先识别题面，再在当前授权范围内比较题干、选项、材料与图片特征；最终版本由你亲自确认。</text>
        </view>
        <view class="capture-boundary">参考答案不会冒充你的作答，也不会写入能力画像；录入你的真实答案后才会形成学习证据。</view>
        <button class="capture-primary" bindtap="openLearningPackets">生成这道题的学习包</button>
        <button class="capture-secondary" bindtap="openAnswerIngestion">录入已有学习包答案</button>
        <button class="capture-secondary" bindtap="restart">继续拍下一题</button>
      </view>
    </block>
  </block>
</view>
