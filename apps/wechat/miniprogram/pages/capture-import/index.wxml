<view class="capture-page {{permissionDenied || (state && state.status === 'idle') ? 'capture-page--dark' : ''}} {{!permissionDenied && state && state.status === 'idle' && captureStage === 'camera' ? 'capture-page--camera' : ''}}">
  <block wx:if="{{configurationError}}">
    <workbench-nav id="runtime-workbench-nav" title="拍照搜题" back-behavior="emit" bind:back="goBack" />
    <state-view
      state="error"
      title="拍照识别暂时无法使用"
      description="{{configurationError}}"
    />
  </block>

  <block wx:elif="{{permissionDenied}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="相机权限"
      tone="dark"
      back-behavior="emit"
      bind:back="goBack"
    />
    <view class="permission-screen">
      <view class="permission-icon"><text class="camera-glyph"></text></view>
      <view class="permission-title">需要相机权限</view>
      <view class="permission-copy">岸岸需要使用相机拍摄你选择的题目和材料，请在系统设置中允许授权。</view>
      <button hover-class="item--hover" class="capture-cyan-button" bindtap="retryCameraPermission">去开启相机权限</button>
      <button hover-class="item--hover" class="capture-dark-quiet" bindtap="goBack">返回</button>
    </view>
  </block>

  <block wx:elif="{{receiptVisible}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="处理结果"
      back-behavior="emit"
      bind:back="goBack"
    />
    <view class="receipt-screen">
      <view class="receipt-icon">✓</view>
      <view class="receipt-title">处理完成</view>
      <view class="receipt-card">
        <view class="receipt-row"><text>记录位置</text><text>仅本次查看</text></view>
        <view class="receipt-divider"></view>
        <view class="receipt-row"><text>画像影响</text><text class="receipt-row__muted">未计入能力画像</text></view>
        <view class="receipt-divider"></view>
        <view class="receipt-row"><text>检索记录</text><text>已保留在你的账户</text></view>
      </view>
      <button hover-class="item--hover" class="capture-primary-button tap-tactile" bindtap="goBack">返回解析</button>
      <button hover-class="item--hover" class="capture-secondary-button" bindtap="restart">继续搜题</button>
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'idle' && captureStage === 'crop'}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="确认图片"
      tone="dark"
      back-behavior="emit"
      bind:back="goBack"
    />
    <view class="crop-stage">
      <image
        class="crop-image"
        src="{{pendingFile.localPath}}"
        mode="aspectFit"
        bindtap="editPendingImage"
      />
      <view class="crop-edit-hint">点按图片可重新裁剪</view>
    </view>
    <view class="crop-actions">
      <button hover-class="item--hover" class="control-center crop-actions__quiet" bindtap="discardPendingImage">重拍</button>
      <button hover-class="item--hover" class="control-center crop-actions__tool" bindtap="editPendingImage">重新裁剪</button>
      <button hover-class="item--hover" class="control-center crop-actions__confirm tap-tactile" bindtap="confirmPendingImage">确认</button>
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'idle'}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="拍照搜题"
      tone="dark"
      back-behavior="emit"
      bind:back="goBack"
    />
    <view class="capture-camera-tools">
      <view class="capture-mode-switch">
        <button hover-class="item--hover" class="capture-mode {{mode === 'search' ? 'capture-mode--active' : ''}}" data-mode="search" bindtap="chooseMode">单题</button>
        <button hover-class="item--hover" class="capture-mode {{mode === 'import' ? 'capture-mode--active' : ''}}" data-mode="import" bindtap="chooseMode">共享材料</button>
      </view>
      <button hover-class="item--hover" class="capture-channel-entry" bindtap="openChannelSheet">微信发图</button>
    </view>

    <view class="camera-workspace">
      <view class="camera-frame {{mode === 'import' ? 'camera-frame--material' : ''}}">
        <camera
          class="camera-preview"
          device-position="back"
          flash="auto"
          mode="normal"
          resolution="high"
          bindinitdone="handleCameraInit"
          binderror="handleCameraError"
        ></camera>
        <view class="camera-preview-shade"></view>
        <view class="camera-corner camera-corner--tl"></view>
        <view class="camera-corner camera-corner--tr"></view>
        <view class="camera-corner camera-corner--bl"></view>
        <view class="camera-corner camera-corner--br"></view>
        <view class="camera-frame__copy">
          <view class="camera-frame__title">{{mode === 'search' ? '请将题干与选项完整对齐' : '请拍摄完整共享材料或导入 PDF'}}</view>
          <view wx:if="{{mode === 'import'}}" class="camera-frame__hint">支持多页材料与多题拆分</view>
        </view>
      </view>
      <view class="camera-track">
        <button hover-class="item--hover" class="camera-track__item {{state.learningTrack === 'xingce' ? 'camera-track__item--active' : ''}}" data-value="xingce" bindtap="chooseTrack">行测</button>
        <button hover-class="item--hover" class="camera-track__item {{state.learningTrack === 'essay' ? 'camera-track__item--active' : ''}}" data-value="essay" bindtap="chooseTrack">申论</button>
      </view>
    </view>

    <view class="camera-bottom-panel">
      <view wx:if="{{cameraError || state.validationError}}" class="camera-error">{{cameraError || state.validationError}}</view>
      <view wx:if="{{mode === 'search'}}" class="camera-controls">
        <button hover-class="item--hover" class="camera-control" bindtap="chooseAlbum"><text class="album-glyph">▧</text><text>相册</text></button>
        <button hover-class="item--hover" class="camera-shutter tap-tactile" disabled="{{!cameraReady}}" bindtap="chooseCamera"><text class="camera-shutter__core"></text></button>
        <view class="camera-control camera-control--placeholder"></view>
      </view>
      <view wx:else class="material-actions">
        <button hover-class="item--hover" class="control-center material-action" disabled="{{!cameraReady}}" bindtap="chooseCamera">拍摄材料</button>
        <button hover-class="item--hover" class="control-center material-action" bindtap="chooseAlbum">相册</button>
        <button hover-class="item--hover" class="control-center material-action material-action--primary tap-tactile" bindtap="choosePdf">导入 PDF</button>
      </view>
      <view class="camera-privacy">题图只用于本次识别与个人检索，不进入公共题库，不用于训练基础模型。</view>
    </view>
  </block>

  <block wx:elif="{{state && (state.status === 'uploading' || state.status === 'processing')}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="识别处理中"
      show-back="{{false}}"
    />
    <view class="searching-screen">
      <view class="searching-spinner"></view>
      <view class="searching-title">{{state.status === 'uploading' ? '正在读取题面...' : '在五万道真题里找这一道...'}}</view>
      <view class="searching-copy">{{state.status === 'uploading' ? '上传进度 ' + (state.uploadProgress ? state.uploadProgress.percent : 0) + '%' : (state.workspace.processingLabel || '找到原题，就把当年的解析一并带给你')}}</view>
    </view>
  </block>

  <block wx:elif="{{state && (state.status === 'expired' || state.status === 'quarantined' || state.status === 'error')}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="拍照搜题"
      back-behavior="emit"
      bind:back="goBack"
    />
    <view class="capture-state-wrap">
      <state-view
        state="{{state.status === 'expired' ? 'stale' : 'error'}}"
        title="{{state.status === 'expired' ? '这次识别已过期' : (state.status === 'quarantined' ? '文件没有通过安全检查' : (state.error ? state.error.title : '处理没有完成'))}}"
        description="{{state.status === 'expired' ? '过期结果不能继续确认，请重新拍摄原题。' : (state.status === 'quarantined' ? '这份文件不会继续识别，也不会写入你的学习记录。' : (state.error ? state.error.message : '请重新拍摄，或恢复刚才的操作。'))}}"
        request-id="{{state.error ? state.error.requestId : (state.workspace ? state.workspace.requestId : '')}}"
        action-text="{{state.pendingRecovery || state.workspace && state.status === 'error' ? '恢复当前操作' : '重新选择题目'}}"
        bind:action="handleErrorAction"
      />
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'review' && state.reviewStep === 'recognition'}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="核对识别内容"
      back-behavior="emit"
      bind:back="restart"
    />
    <view class="capture-page-action-row">
      <button hover-class="item--hover" class="control-center capture-page-action" bindtap="chooseCamera">重拍</button>
    </view>

    <view class="ocr-source-preview">
      <image wx:if="{{state.selectedFile && state.selectedFile.mimeType !== 'application/pdf'}}" class="ocr-source-preview__image" src="{{state.selectedFile.localPath}}" mode="aspectFill" />
      <view wx:else class="ocr-source-preview__pdf">PDF</view>
      <view class="ocr-source-preview__label">对照原图</view>
    </view>

    <view class="ocr-content">
      <view class="recognized-type-card">
        <view>
          <text class="recognized-type-card__label">自动识别</text>
          <text class="recognized-type-card__value">{{state.learningTrack === 'xingce' ? '行测考题' : '申论材料'}}</text>
        </view>
        <button hover-class="item--hover" class="recognized-type-card__switch" data-value="{{state.learningTrack === 'xingce' ? 'essay' : 'xingce'}}" bindtap="chooseTrack">{{state.learningTrack === 'xingce' ? '改为申论' : '改为行测'}}</button>
      </view>

      <view wx:for="{{state.segments}}" wx:key="segmentId" class="ocr-card">
        <view class="ocr-card__header">
          <text>{{item.ordinal === 1 ? '题干与材料' : '识别片段 ' + item.ordinal}}</text>
          <text class="ocr-card__confidence ocr-card__confidence--{{item.tone}}">{{item.confidenceLabel}}</text>
        </view>
        <textarea
          cursor-spacing="24"
          class="ocr-card__input"
          value="{{item.text}}"
          disabled="{{state.submitting}}"
          data-id="{{item.segmentId}}"
          aria-label="第 {{item.ordinal}} 段识别文字"
          bindinput="inputSegment"
        />
        <view wx:if="{{item.requiresCorrection}}" class="ocr-card__warning">! 这段文字需要你确认或修改</view>
      </view>
      <view class="ocr-completeness">✓ 请确认题干、材料和选项都已识别完整</view>
      <view wx:if="{{state.validationError}}" class="capture-inline-error">{{state.validationError}}</view>
      <view class="ocr-bottom-spacer"></view>
    </view>
    <view class="capture-bottom-dock">
      <button hover-class="item--hover" class="capture-primary-button tap-tactile" loading="{{state.submitting}}" bindtap="confirmImport">确认无误，开始搜索 →</button>
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'review' && state.reviewStep === 'match' && state.activeQuestionUnit && state.activeQuestionUnit.aiAnswer && (state.activeQuestionUnit.aiAnswer.state === 'requested' || state.activeQuestionUnit.aiAnswer.state === 'processing')}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="AI 独立推理"
      show-back="{{false}}"
    />
    <view class="searching-screen">
      <view class="searching-spinner searching-spinner--cyan"></view>
      <view class="searching-title">岸岸在独立推这道题，不抄题库也不编答案</view>
      <view class="searching-copy">题库没有原题——正在给你写一份可以逐步核对的解析</view>
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'review' && state.reviewStep === 'match' && state.activeQuestionUnit && state.activeQuestionUnit.aiAnswer && state.activeQuestionUnit.aiAnswer.state === 'failed'}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="拍照搜题"
      back-behavior="emit"
      bind:back="restart"
    />
    <view class="capture-state-wrap">
      <state-view
        state="error"
        title="这次 AI 解析没有完成"
        description="请重新申请解析；如果仍然失败，请重新拍摄更清晰、完整的题目。"
        request-id="{{state.workspace ? state.workspace.requestId : ''}}"
        action-text="重新申请 AI 解析"
        bind:action="requestAIAnswer"
      />
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'review' && state.reviewStep === 'match' && !state.activeQuestionUnit}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="拍照搜题"
      back-behavior="emit"
      bind:back="restart"
    />
    <view class="capture-state-wrap">
      <state-view
        state="empty"
        title="没有识别出可核对的题目"
        description="请重新拍摄，并确保题干、材料和选项完整进入画面。"
        request-id="{{state.workspace ? state.workspace.requestId : ''}}"
        action-text="重新拍摄"
        bind:action="restart"
      />
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'review' && state.reviewStep === 'match' && state.activeQuestionUnit && state.activeQuestionUnit.state === 'unmatched' && !state.activeQuestionUnit.aiAnswer}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="拍照搜题"
      back-behavior="emit"
      bind:back="restart"
    />
    <view class="no-hit-screen">
      <view class="no-hit-icon"><text class="search-glyph"></text></view>
      <view class="no-hit-title">未在题库中找到完全一致的题目</view>
      <view class="no-hit-copy">这可能是一道新题或小众考卷题。岸岸可以独立进行 AI 推理，但不会冒充题库标准答案。</view>
      <button hover-class="item--hover" class="capture-ai-button" loading="{{state.submitting}}" bindtap="requestAIAnswer">使用 AI 独立解题</button>
      <button hover-class="item--hover" class="capture-secondary-button" bindtap="restart">重新拍摄</button>
    </view>
  </block>

  <block wx:elif="{{state && state.status === 'review' && state.reviewStep === 'match' && state.activeQuestionUnit && state.activeQuestionUnit.match && !state.activeQuestionUnit.aiAnswer}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="匹配题目"
      back-behavior="emit"
      bind:back="restart"
    />
    <view class="match-content">
      <view class="match-title">{{state.activeQuestionUnit.match.candidates.length > 1 ? '找到相似题目' : '找到匹配题目'}}</view>
      <view class="match-copy">{{state.activeQuestionUnit.match.candidates.length > 1 ? '题库中存在多道相似考题，请确认你要找的是哪一道。' : '请核对题面，确认是否为同一道题。'}}</view>
      <view class="question-unit-tabs" wx:if="{{state.workspace.questionUnits.length > 1}}">
        <button hover-class="item--hover" wx:for="{{state.workspace.questionUnits}}" wx:key="questionUnitId" class="control-center question-unit-tab {{index === state.activeQuestionUnitIndex ? 'question-unit-tab--active' : ''}}" data-index="{{index}}" bindtap="selectQuestionUnit">{{item.ordinal}}</button>
      </view>
      <view class="match-list">
        <button hover-class="item--hover"
          wx:for="{{matchCandidates}}"
          wx:key="contentVersionId"
          class="match-card {{state.selectedContentVersionId === item.contentVersionId ? 'match-card--selected' : ''}}"
          data-id="{{item.contentVersionId}}"
          bindtap="selectMatch"
        >
          <view class="match-card__badge">{{item.matchKind === 'exact' ? '原题精确匹配' : '相似题目'}}</view>
          <view class="match-card__score">匹配度 {{item.scoreLabel}}</view>
          <view class="match-card__copy">点击选择并核对这条题库记录</view>
          <view class="match-card__evidence">
            <view wx:for="{{item.evidenceSummaries}}" wx:for-item="evidence" wx:key="*this" class="match-card__evidence-line">{{evidence}}</view>
          </view>
        </button>
      </view>
      <view wx:if="{{state.validationError}}" class="capture-inline-error">{{state.validationError}}</view>
      <view class="match-bottom-spacer"></view>
    </view>
    <view class="capture-bottom-dock">
      <button hover-class="item--hover" class="capture-primary-button tap-tactile" loading="{{state.submitting}}" bindtap="confirmImport">确认并查看解析</button>
    </view>
  </block>

  <block wx:elif="{{state && (state.status === 'success' || (state.status === 'review' && state.activeQuestionUnit && state.activeQuestionUnit.aiAnswer && (state.activeQuestionUnit.aiAnswer.state === 'candidate' || state.activeQuestionUnit.aiAnswer.state === 'confirmed')))}}">
    <workbench-nav
      id="runtime-workbench-nav"
      title="题目解析"
      back-behavior="emit"
      bind:back="restart"
    />
    <view class="capture-page-action-row">
      <button hover-class="item--hover" class="control-center capture-page-action" bindtap="restart">继续拍题</button>
    </view>

    <view class="solution-content">
      <view wx:if="{{state.workspace.questionUnits.length > 1}}" class="question-unit-tabs">
        <button hover-class="item--hover" wx:for="{{state.workspace.questionUnits}}" wx:key="questionUnitId" class="control-center question-unit-tab {{index === state.activeQuestionUnitIndex ? 'question-unit-tab--active' : ''}}" data-index="{{index}}" bindtap="selectQuestionUnit">{{item.ordinal}}</button>
      </view>

      <view wx:if="{{state.activeQuestionUnit.aiAnswer}}" class="ai-solution-banner">
        <text class="ai-solution-banner__mark">✦</text>
        <view>
          <view class="ai-solution-banner__title">AI 根据图片独立推理</view>
          <view class="ai-solution-banner__copy">这不是题库标准答案，请结合推理过程自行判断。</view>
        </view>
      </view>

      <view class="solution-question">
        <view class="solution-tags">
          <text class="solution-tag">{{state.learningTrack === 'xingce' ? '行测' : '申论'}}</text>
          <text class="solution-tag">{{state.activeQuestionUnit.referenceAnswer ? '题库匹配' : '用户上传图片'}}</text>
        </view>
        <view wx:for="{{state.segments}}" wx:key="segmentId" class="solution-question__segment">{{item.text}}</view>
      </view>

      <view class="solution-answer-card {{state.activeQuestionUnit.aiAnswer ? 'solution-answer-card--ai' : ''}}">
        <view class="solution-answer-card__badge">{{state.activeQuestionUnit.aiAnswer ? 'AI 推理答案' : '题库参考答案'}}</view>
        <view class="solution-answer-card__answer">{{state.activeQuestionUnit.referenceAnswer ? state.activeQuestionUnit.referenceAnswer.answerText : (state.activeQuestionUnit.aiAnswer.answerText || '正在生成答案')}}</view>
        <view class="solution-answer-card__source">{{state.activeQuestionUnit.referenceAnswer ? (state.activeQuestionUnit.referenceAnswer.matchKind === 'exact' ? '原题精确匹配' : '相似题匹配，请结合题面核对') : 'AI 生成 · 不是官方答案'}}</view>
      </view>

      <view wx:if="{{state.activeQuestionUnit.aiAnswer && state.activeQuestionUnit.aiAnswer.explanation}}" class="solution-explanation">
        <view class="solution-section-title">✦ AI 推理过程</view>
        <view class="solution-explanation__copy">{{state.activeQuestionUnit.aiAnswer.explanation}}</view>
        <view wx:for="{{state.activeQuestionUnit.aiAnswer.keyPoints}}" wx:key="*this" class="solution-keypoint"><text class="solution-keypoint__dot"></text><text>{{item}}</text></view>
        <view wx:for="{{state.activeQuestionUnit.aiAnswer.limitations}}" wx:key="*this" class="solution-limitation">注意：{{item}}</view>
      </view>

      <view wx:if="{{state.activeQuestionUnit.referenceAnswer}}" class="solution-explanation">
        <view class="solution-section-title">题库解析</view>
        <view class="solution-explanation__copy">已核对题库答案与授权来源。详细精讲会保存在这道题的个人学习包中。</view>
        <button hover-class="item--hover" class="solution-inline-action" bindtap="openLearningPackets">生成这道题的学习包 ›</button>
      </view>

      <button hover-class="item--hover" class="anan-solution-action" bindtap="askAnan"><text>✦</text><text>继续追问岸岸</text><text>›</text></button>
      <view class="solution-boundary">查看参考答案不会自动改变能力画像；只有你确认的真实作答才会成为学习证据。</view>
      <view class="solution-bottom-spacer"></view>
    </view>

    <view class="capture-bottom-dock">
      <button hover-class="item--hover" wx:if="{{state.activeQuestionUnit.aiAnswer && state.activeQuestionUnit.aiAnswer.state === 'candidate'}}" class="capture-primary-button tap-tactile" loading="{{state.submitting}}" bindtap="confirmAIAnswer">我已核对，仅作参考</button>
      <button hover-class="item--hover" wx:else class="capture-primary-button tap-tactile" bindtap="openRecordSheet">这道题该如何处理？</button>
    </view>
  </block>

  <view wx:if="{{recordSheetOpen}}" class="capture-sheet-mask motion-mask" catchtouchmove="noop" bindtap="closeRecordSheet"></view>
  <view wx:if="{{recordSheetOpen}}" class="capture-sheet motion-sheet">
    <view class="capture-sheet__handle"></view>
    <view class="capture-sheet__header">
      <view class="capture-sheet__title">收录与个人画像边界</view>
      <button hover-class="item--hover" class="capture-sheet__close" bindtap="closeRecordSheet">×</button>
    </view>
    <view class="capture-sheet__copy">拍照搜题不能证明你会做或不会做，请明确选择这次如何处理。</view>
    <button hover-class="item--hover" class="record-option" bindtap="finishViewing">
      <view class="record-option__title">仅本次查看</view>
      <view class="record-option__copy">不进入学习证据，不改变能力画像。</view>
    </button>
    <button hover-class="item--hover" wx:if="{{state.activeQuestionUnit.referenceAnswer}}" class="record-option" bindtap="openLearningPackets">
      <view class="record-option__title">生成错题学习包</view>
      <view class="record-option__copy">保存为个人复练材料，不直接改变当前能力。</view>
    </button>
    <button hover-class="item--hover" wx:if="{{state.activeQuestionUnit.referenceAnswer}}" class="record-option record-option--primary tap-tactile" bindtap="openAnswerIngestion">
      <view class="record-option__title">记录我的真实作答</view>
      <view class="record-option__copy">先选择个人学习包，再录入答案，确认后才计入画像。</view>
    </button>
    <view wx:else class="record-option record-option--disabled">
      <view class="record-option__title">AI 解析暂不能直接计入画像</view>
      <view class="record-option__copy">请在正式练习或答题卡导入中完成真实作答。</view>
    </view>
  </view>

  <ilink-bot-sheet visible="{{channelSheetOpen}}" bindclose="closeChannelSheet" />
