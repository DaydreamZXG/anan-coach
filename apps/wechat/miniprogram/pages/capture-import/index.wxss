.capture-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.capture-page--dark {
  background: var(--ink);
  color: var(--color-surface);
}

.capture-channel-entry,
.capture-sheet__close {
  min-height: 72rpx;
  color: inherit;
}

.capture-camera-tools {
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) 96rpx;
  align-items: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 32rpx;
  background: var(--ink);
}

.capture-channel-entry {
  grid-column: 3;
  overflow: hidden;
  color: var(--figma-color-cyan-soft);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-camera-tools__side {
  grid-column: 3;
  min-height: 72rpx;
}

.capture-mode-switch {
  display: flex;
  align-items: center;
  justify-self: center;
  grid-column: 2;
  box-sizing: border-box;
  padding: 6rpx;
  border: 1rpx solid var(--color-ink-secondary);
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.82);
}

.capture-page-action-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-width: 900px;
  justify-content: flex-end;
  margin: 0 auto;
  padding: 16rpx 40rpx 0;
}

.capture-page-action {
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 700;
}

.capture-page-action::after {
  border: 0;
}

.capture-mode {
  min-width: 96rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 700;
}

.capture-mode--active {
  background: var(--color-ink-secondary);
  color: var(--color-surface);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.22);
}

.permission-screen,
.receipt-screen,
.no-hit-screen,
.searching-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 120rpx);
  padding: 64rpx;
  text-align: center;
}

.permission-icon,
.no-hit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 48rpx;
  border-radius: 50%;
}

.permission-icon {
  background: var(--ink);
}

.camera-glyph {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: 58rpx;
  height: 42rpx;
  border: 5rpx solid var(--ink-3);
  border-radius: 10rpx;
}

.camera-glyph::before {
  position: absolute;
  top: -14rpx;
  left: 12rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: var(--ink-3);
  content: "";
}

.camera-glyph::after {
  position: absolute;
  top: 7rpx;
  left: 15rpx;
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--ink-3);
  border-radius: 50%;
  content: "";
}

.permission-title,
.no-hit-title,
.searching-title {
  color: inherit;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  line-height: 1.35;
}

.permission-copy,
.no-hit-copy,
.searching-copy {
  max-width: 580rpx;
  margin-top: 20rpx;
  color: var(--ink-3);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.7;
}

.permission-copy {
  margin-bottom: 72rpx;
  color: var(--ink-3);
}

.capture-cyan-button,
.capture-primary-button,
.capture-secondary-button,
.capture-dark-quiet {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.capture-cyan-button {
  background: var(--figma-color-cyan-deep);
  color: var(--color-surface);
  box-shadow: 0 16rpx 40rpx rgba(6, 182, 212, 0.28);
}

.capture-primary-button {
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 16rpx 60rpx rgba(16, 24, 40, 0.14);
}

.capture-secondary-button {
  margin-top: 20rpx;
  border: 2rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--figma-color-ink-tertiary);
}

.capture-dark-quiet {
  margin-top: 32rpx;
  color: var(--ink-2);
}

.receipt-screen {
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.receipt-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 48rpx;
  border: 1rpx solid var(--line);
  border-radius: 56rpx;
  background: var(--color-surface);
  color: var(--good);
  font-size: 72rpx;
  font-weight: 500;
  box-shadow: 0 16rpx 60rpx rgba(16, 24, 40, 0.05);
}

.receipt-title {
  margin-bottom: 64rpx;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.receipt-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 72rpx;
  padding: 48rpx;
  border: 1rpx solid var(--line);
  border-radius: 64rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.025);
}

.receipt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  text-align: right;
}

.receipt-row__muted {
  color: var(--ink-3);
}

.receipt-divider {
  height: 1rpx;
  margin: 34rpx 0;
  background: var(--line);
}

.crop-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: calc(100vh - 300rpx - env(safe-area-inset-bottom));
  padding: 48rpx;
  overflow: hidden;
  background: var(--ink);
}

.crop-image {
  width: 100%;
  height: 100%;
  border: 1rpx solid var(--color-ink-secondary);
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--figma-color-ink-strong), var(--ink));
}

.crop-frame {
  position: absolute;
  top: 110rpx;
  right: 80rpx;
  bottom: 110rpx;
  left: 80rpx;
  border: 4rpx solid var(--figma-color-cyan-deep);
  background: rgba(34, 211, 238, 0.08);
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.56);
}

.crop-corner,
.camera-corner {
  position: absolute;
  box-sizing: border-box;
  width: 48rpx;
  height: 48rpx;
}

.crop-corner {
  width: 28rpx;
  height: 28rpx;
  border: 5rpx solid var(--color-surface);
  border-radius: 50%;
  background: var(--figma-color-cyan-deep);
  transform: translate(-50%, -50%);
}

.crop-corner--tl {
  top: 0;
  left: 0;
}

.crop-corner--tr {
  top: 0;
  right: -28rpx;
}

.crop-corner--bl {
  bottom: -28rpx;
  left: 0;
}

.crop-corner--br {
  right: -28rpx;
  bottom: -28rpx;
}

.crop-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: center;
  box-sizing: border-box;
  min-height: 188rpx;
  padding: 30rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--figma-color-ink-strong);
  background: var(--ink);
}

.crop-actions__quiet,
.crop-actions__tool,
.crop-actions__confirm {
  min-height: 80rpx;
  color: var(--color-surface);
  font-size: 27rpx;
  font-weight: 700;
}

.crop-actions__tool {
  justify-self: center;
  width: 80rpx;
  border-radius: 50%;
  background: var(--figma-color-ink-strong);
  font-size: 23rpx;
}

.crop-actions__confirm {
  justify-self: end;
  min-width: 136rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--figma-color-cyan-deep);
  box-shadow: 0 8rpx 30rpx rgba(6, 182, 212, 0.3);
}

.camera-workspace {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 430rpx - env(safe-area-inset-bottom));
  padding: 24rpx 56rpx;
}

.camera-frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  height: min(760rpx, 54vh);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 48rpx;
  background: rgba(17, 24, 39, 0.26);
}

.camera-frame--material {
  border-color: rgba(34, 211, 238, 0.52);
  background: rgba(8, 145, 178, 0.12);
}

.camera-corner {
  border-color: var(--color-surface);
  border-style: solid;
}

.camera-corner--tl {
  top: 32rpx;
  left: 32rpx;
  border-width: 4rpx 0 0 4rpx;
  border-radius: 16rpx 0 0;
}

.camera-corner--tr {
  top: 32rpx;
  right: 32rpx;
  border-width: 4rpx 4rpx 0 0;
  border-radius: 0 16rpx 0 0;
}

.camera-corner--bl {
  bottom: 32rpx;
  left: 32rpx;
  border-width: 0 0 4rpx 4rpx;
  border-radius: 0 0 0 16rpx;
}

.camera-corner--br {
  right: 32rpx;
  bottom: 32rpx;
  border-width: 0 4rpx 4rpx 0;
  border-radius: 0 0 16rpx;
}

.camera-frame__copy {
  max-width: 520rpx;
  padding: 40rpx;
  text-align: center;
}

.camera-frame__title {
  color: rgba(255, 255, 255, 0.82);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.55;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
}

.camera-frame__hint {
  margin-top: 16rpx;
  color: rgba(103, 232, 249, 0.82);
  font-size: 22rpx;
  font-weight: 600;
}

.camera-track {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.camera-track__item {
  min-width: 116rpx;
  padding: 14rpx 28rpx;
  border: 1rpx solid var(--color-ink-secondary);
  border-radius: 999rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 700;
}

.camera-track__item--active {
  border-color: var(--figma-color-cyan-deep);
  background: rgba(6, 182, 212, 0.16);
  color: var(--figma-color-cyan-soft);
}

.camera-controls {
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  min-height: 196rpx;
  padding: 18rpx 80rpx calc(26rpx + env(safe-area-inset-bottom));
  background: var(--ink);
}

.camera-control {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 96rpx;
  min-height: 96rpx;
  border: 1rpx solid var(--figma-color-ink-strong);
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 20rpx;
  font-weight: 600;
}

.camera-control--placeholder {
  border-color: transparent;
  background: transparent;
}

.album-glyph {
  font-size: 30rpx;
}

.camera-shutter {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 144rpx;
  height: 144rpx;
  padding: 8rpx;
  border: 8rpx solid var(--color-surface);
  border-radius: 50%;
}

.camera-shutter__core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-surface);
}

.material-actions {
  display: flex;
  gap: 24rpx;
  box-sizing: border-box;
  min-height: 150rpx;
  padding: 24rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
}

.material-action {
  flex: 1;
  min-height: 88rpx;
  border: 1rpx solid var(--color-ink-secondary);
  border-radius: 44rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 27rpx;
  font-weight: 700;
}

.material-action--primary {
  border-color: var(--figma-color-cyan-deep);
  background: var(--figma-color-cyan-deep);
}

.camera-error {
  position: absolute;
  right: 48rpx;
  bottom: 154rpx;
  left: 48rpx;
  z-index: 3;
  padding: 18rpx 24rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.42);
  border-radius: 999rpx;
  background: rgba(120, 53, 15, 0.46);
  color: var(--figma-color-warning);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.camera-privacy {
  position: absolute;
  right: 40rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  left: 40rpx;
  color: var(--color-ink-secondary);
  font-size: 18rpx;
  line-height: 1.45;
  text-align: center;
}

.searching-screen {
  min-height: 100vh;
}

.searching-spinner {
  box-sizing: border-box;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 48rpx;
  border: 8rpx solid var(--figma-color-primary-soft-strong);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: capture-spin 1.6s linear infinite;
}

.searching-spinner--cyan {
  border-color: var(--figma-color-cyan-soft);
  border-top-color: var(--figma-color-cyan-deep);
}

@keyframes capture-spin {
  100% {
    transform: rotate(360deg);
  }
}

.capture-state-wrap {
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

.ocr-source-preview {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 340rpx;
  overflow: hidden;
  border-bottom: 1rpx solid var(--color-line-strong);
  background: var(--ink);
}

.ocr-source-preview__image {
  width: 100%;
  height: 100%;
  opacity: 0.72;
}

.ocr-source-preview__pdf {
  color: var(--figma-color-ink-tertiary);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 72rpx;
  font-weight: 800;
}

.ocr-source-preview__label {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.62);
  color: var(--color-surface);
  font-size: 22rpx;
  font-weight: 700;
}

.ocr-content,
.match-content,
.solution-content {
  box-sizing: border-box;
  min-height: calc(100vh - 112rpx);
  padding: 40rpx 40rpx 0;
}

.recognized-type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 40rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 20rpx rgba(16, 24, 40, 0.02);
}

.recognized-type-card__label {
  display: inline-block;
  margin-right: 14rpx;
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
}

.recognized-type-card__value {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.recognized-type-card__switch {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--line);
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 700;
}

.ocr-card {
  position: relative;
  margin-bottom: 28rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.02);
}

.ocr-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  font-weight: 700;
}

.ocr-card__confidence {
  color: var(--ink-2);
  font-size: 20rpx;
}

.ocr-card__confidence--warning,
.ocr-card__confidence--danger {
  color: var(--figma-color-warning);
}

.ocr-card__confidence--success {
  color: var(--good);
}

.ocr-card__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: 32rpx;
  background: transparent;
  color: var(--figma-color-ink-strong);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.75;
}

.ocr-card__warning {
  padding: 22rpx 32rpx;
  border-top: 1rpx solid var(--figma-color-warning-soft);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.ocr-completeness {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--figma-color-cyan-soft);
  color: var(--figma-color-cyan-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.capture-inline-error {
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 700;
}

.ocr-bottom-spacer,
.match-bottom-spacer,
.solution-bottom-spacer {
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.capture-bottom-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 28rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(242, 244, 247, 0.94);
  background: rgba(255, 255, 255, 0.96);
}

.no-hit-icon {
  border: 1rpx solid var(--line);
  background: var(--color-surface);
  box-shadow: 0 4rpx 20rpx rgba(16, 24, 40, 0.025);
}

.search-glyph {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  border: 6rpx solid var(--figma-color-line-emphasis);
  border-radius: 50%;
}

.search-glyph::after {
  position: absolute;
  right: -18rpx;
  bottom: -12rpx;
  width: 26rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--figma-color-line-emphasis);
  content: "";
  transform: rotate(45deg);
}

.no-hit-copy {
  margin-bottom: 72rpx;
}

.match-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.match-copy {
  margin-top: 18rpx;
  margin-bottom: 40rpx;
  color: var(--ink-2);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.65;
}

.question-unit-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
  overflow-x: auto;
}

.question-unit-tab {
  flex: 0 0 auto;
  min-width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 20rpx;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 700;
}

.question-unit-tab--active {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.match-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 210rpx;
  padding: 44rpx 36rpx 32rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
  border-radius: 48rpx;
  background: var(--color-surface);
  color: var(--ink);
  text-align: left;
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.03);
}

.match-card--selected {
  border-color: var(--figma-color-primary-bright);
  box-shadow: 0 10rpx 40rpx rgba(99, 102, 241, 0.1);
}

.match-card__badge {
  display: inline-block;
  padding: 7rpx 14rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 700;
}

.match-card__score {
  position: absolute;
  top: 0;
  right: 0;
  padding: 12rpx 22rpx;
  border-radius: 0 0 0 28rpx;
  background: var(--primary);
  color: var(--color-surface);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 20rpx;
  font-weight: 700;
}

.match-card__copy {
  margin-top: 28rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.6;
}

.match-card__evidence {
  display: flex;
  flex-wrap: wrap;
  gap: var(--figma-space-6);
  margin-top: var(--figma-space-10);
}

.match-card__evidence-line {
  padding: var(--figma-space-4) var(--figma-space-8);
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--figma-font-minimum);
  font-weight: 600;
  line-height: 1.4;
}

.solution-content {
  padding-top: 16rpx;
}

.ai-solution-banner {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, var(--figma-color-cyan-deep), var(--figma-color-info));
  color: var(--color-surface);
  box-shadow: 0 8rpx 30rpx rgba(6, 182, 212, 0.2);
}

.ai-solution-banner__mark {
  flex: 0 0 auto;
  font-size: 34rpx;
}

.ai-solution-banner__title {
  font-size: 25rpx;
  font-weight: 700;
}

.ai-solution-banner__copy {
  margin-top: 6rpx;
  color: var(--figma-color-cyan-soft);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.55;
}

.solution-question {
  margin-bottom: 44rpx;
}

.solution-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.solution-tag {
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.02);
}

.solution-question__segment {
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.72;
}

.solution-answer-card {
  position: relative;
  margin-top: 52rpx;
  margin-bottom: 54rpx;
  padding: 54rpx 38rpx 36rpx;
  border: 1rpx solid var(--line);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.025);
}

.solution-answer-card__badge {
  position: absolute;
  top: -28rpx;
  left: 36rpx;
  padding: 12rpx 24rpx;
  border: 4rpx solid var(--color-surface);
  border-radius: var(--figma-radius-pill);
  background: var(--good);
  color: var(--color-surface);
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(16, 24, 40, 0.08);
}

.solution-answer-card--ai .solution-answer-card__badge {
  background: var(--figma-color-cyan-deep);
}

.solution-answer-card__answer {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.55;
  white-space: pre-wrap;
}

.solution-answer-card__source {
  margin-top: 18rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 600;
}

.solution-explanation {
  margin-bottom: 32rpx;
  padding: 34rpx;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 30rpx rgba(16, 24, 40, 0.018);
}

.solution-section-title {
  margin-bottom: 24rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.solution-explanation__copy {
  color: var(--color-ink-secondary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.8;
  white-space: pre-wrap;
}

.solution-keypoint {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.65;
}

.solution-keypoint__dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--figma-color-cyan-deep);
}

.solution-limitation {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
}

.solution-inline-action {
  margin-top: 28rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.anan-solution-action {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--figma-color-primary-soft-strong);
  border-radius: 32rpx;
  background: var(--color-surface);
  color: var(--primary);
  font-size: 25rpx;
  font-weight: 700;
  text-align: left;
}

.solution-boundary {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: var(--line);
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.6;
}

.capture-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(16, 24, 40, 0.42);
}

.capture-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  box-sizing: border-box;
  max-height: 84vh;
  padding: 16rpx 48rpx calc(46rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 64rpx 64rpx 0 0;
  background: var(--bg);
  box-shadow: 0 -20rpx 80rpx rgba(16, 24, 40, 0.12);
}

.capture-sheet--channel {
  background: var(--color-surface);
}

.capture-sheet__handle {
  width: 96rpx;
  height: 12rpx;
  margin: 0 auto 36rpx;
  border-radius: 999rpx;
  background: var(--color-line-strong);
}

.capture-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.capture-sheet__title {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.capture-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  min-height: 64rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--line);
  color: var(--ink-2);
  font-size: 38rpx;
  font-weight: 400;
}

.capture-sheet__copy {
  margin: 24rpx 0 32rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.65;
}

.record-option {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 34rpx;
  border: 3rpx solid transparent;
  border-radius: 48rpx;
  background: var(--color-surface);
  color: var(--ink);
  text-align: left;
  box-shadow: 0 4rpx 18rpx rgba(16, 24, 40, 0.02);
}

.record-option--primary {
  border-color: var(--figma-color-primary-bright);
  background: rgba(238, 242, 255, 0.55);
  color: var(--primary-deep);
}

.record-option--disabled {
  opacity: 0.58;
}

.record-option__title {
  font-size: 29rpx;
  font-weight: 700;
}

.record-option__copy {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.55;
}

.channel-state,
.channel-bound {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.55;
}

.channel-state--error {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.channel-code {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border: 2rpx solid var(--figma-color-primary-bright);
  border-radius: 28rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-family: "SF Mono", Menlo, monospace;
  font-size: 27rpx;
  font-weight: 700;
}

.channel-bound {
  margin-bottom: 18rpx;
  background: var(--good-soft);
  color: var(--good);
}

.capture-danger-link {
  width: 100%;
  min-height: 76rpx;
  margin-top: 20rpx;
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 700;
}

button.capture-channel-entry {
  width: 100%;
}

button.capture-mode,
button.capture-page-action,
button.camera-track__item,
button.recognized-type-card__switch,
button.question-unit-tab,
button.solution-inline-action {
  width: auto;
}

button.capture-cyan-button,
button.capture-primary-button,
button.capture-secondary-button,
button.capture-dark-quiet,
button.match-card,
button.anan-solution-action,
button.record-option,
button.capture-danger-link {
  width: 100%;
}

button.crop-actions__quiet {
  width: 100%;
}

button.crop-actions__tool {
  width: 80rpx;
}

button.crop-actions__confirm {
  width: auto;
}

button.camera-control {
  width: 96rpx;
}

button.camera-shutter {
  width: 144rpx;
}

button.material-action {
  width: auto;
}

button.capture-sheet__close {
  width: 64rpx;
}

@media (min-width: 700px) {
  .ocr-content,
  .match-content,
  .solution-content {
    box-sizing: border-box;
    width: 100%;
    max-width: 900px;
    margin-right: auto;
    margin-left: auto;
    padding-right: 40px;
    padding-left: 40px;
  }

  .capture-bottom-dock {
    right: auto;
    left: 50%;
    box-sizing: border-box;
    width: 100%;
    max-width: 900px;
    padding-right: 40px;
    padding-left: 40px;
    transform: translateX(-50%);
  }

  .camera-workspace {
    padding-right: max(56rpx, calc((100vw - 720px) / 2));
    padding-left: max(56rpx, calc((100vw - 720px) / 2));
  }

  .capture-sheet {
    right: calc((100vw - 720px) / 2);
    left: calc((100vw - 720px) / 2);
    border-radius: 64rpx 64rpx 0 0;
  }
}
