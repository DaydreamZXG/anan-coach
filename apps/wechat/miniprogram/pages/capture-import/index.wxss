.capture-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.capture-page--dark {
  background: var(--ink);
  color: var(--color-surface);
}

.capture-page--camera {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
}

.capture-page--permission {
  height: 100vh;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
}

.capture-channel-entry,
.capture-sheet__close {
  min-height: calc(72 * var(--rpx));
  color: inherit;
}

.capture-camera-tools {
  display: grid;
  grid-template-columns: calc(96 * var(--rpx)) minmax(0, 1fr) calc(96 * var(--rpx));
  align-items: center;
  box-sizing: border-box;
  min-height: calc(88 * var(--rpx));
  padding: 0 calc(32 * var(--rpx));
  background: var(--ink);
}

.capture-channel-entry {
  grid-column: 3;
  overflow: hidden;
  color: var(--color-primary-soft);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(72 * var(--rpx));
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-camera-tools__side {
  grid-column: 3;
  min-height: calc(72 * var(--rpx));
}

.capture-mode-switch {
  display: flex;
  align-items: center;
  justify-self: center;
  grid-column: 2;
  box-sizing: border-box;
  padding: calc(8 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-ink-secondary);
  border-radius: var(--radius-capsule);
  background: rgba(17, 24, 39, 0.82);
}

.capture-page-action-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-width: 900px;
  justify-content: flex-end;
  margin: 0 auto;
  padding: calc(16 * var(--rpx)) calc(40 * var(--rpx)) 0;
}

.capture-page-action {
  width: auto;
  min-height: calc(64 * var(--rpx));
  margin: 0;
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 700;
}

.capture-page-action::after {
  border: 0;
}

.capture-mode {
  min-width: calc(96 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
}

.capture-mode--active {
  background: var(--color-ink-secondary);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.permission-screen,
.receipt-screen,
.no-hit-screen,
.searching-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - calc(120 * var(--rpx)));
  padding: calc(64 * var(--rpx));
  text-align: center;
}

.capture-page--permission .permission-screen {
  min-height: calc(100vh - calc(120 * var(--rpx)));
  padding-bottom: calc(calc(64 * var(--rpx)) + env(safe-area-inset-bottom));
}

.permission-icon,
.no-hit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(160 * var(--rpx));
  height: calc(160 * var(--rpx));
  margin-bottom: calc(48 * var(--rpx));
  border-radius: 50%;
}

.permission-icon {
  background: var(--ink);
}

.camera-glyph {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: calc(58 * var(--rpx));
  height: calc(42 * var(--rpx));
  border: calc(5 * var(--rpx)) solid var(--ink-3);
  border-radius: var(--radius-12);
}

.camera-glyph::before {
  position: absolute;
  top: calc(-14 * var(--rpx));
  left: calc(12 * var(--rpx));
  width: calc(24 * var(--rpx));
  height: calc(12 * var(--rpx));
  border-radius: var(--radius-8) var(--radius-8) 0 0;
  background: var(--ink-3);
  content: "";
}

.camera-glyph::after {
  position: absolute;
  top: calc(7 * var(--rpx));
  left: calc(15 * var(--rpx));
  box-sizing: border-box;
  width: calc(18 * var(--rpx));
  height: calc(18 * var(--rpx));
  border: calc(4 * var(--rpx)) solid var(--ink-3);
  border-radius: 50%;
  content: "";
}

.permission-title,
.no-hit-title,
.searching-title {
  color: inherit;
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.8 * var(--rpx));
  line-height: 1.35;
}

.permission-copy,
.no-hit-copy,
.searching-copy {
  max-width: calc(580 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.7;
}

.permission-copy {
  margin-bottom: calc(80 * var(--rpx));
  color: var(--ink-3);
}

.permission-privacy {
  max-width: calc(580 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
  color: var(--color-faint);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.capture-cyan-button,
.capture-ai-button,
.capture-primary-button,
.capture-secondary-button,
.capture-dark-quiet {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: max(calc(96 * var(--rpx)), 44px);
  border-radius: var(--radius-48);
  font-size: var(--text-section);
  font-weight: 700;
}

.capture-cyan-button {
  background: var(--color-primary-bright);
  color: var(--color-surface);
  box-shadow: var(--shadow-primary-soft);
}

.capture-ai-button {
  background: var(--gradient-ai);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-ai);
}

.capture-primary-button {
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.capture-secondary-button {
  margin-top: calc(20 * var(--rpx));
  border: calc(2 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
}

.capture-dark-quiet {
  margin-top: calc(32 * var(--rpx));
  color: var(--ink-2);
}

.receipt-screen {
  padding-right: calc(48 * var(--rpx));
  padding-left: calc(48 * var(--rpx));
}

.receipt-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(160 * var(--rpx));
  height: calc(160 * var(--rpx));
  margin-bottom: calc(48 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  color: var(--good);
  font-size: var(--text-display);
  font-weight: 500;
  box-shadow: var(--shadow-card-strong);
}

.receipt-title {
  margin-bottom: calc(64 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1 * var(--rpx));
}

.receipt-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: calc(80 * var(--rpx));
  padding: calc(48 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.receipt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(32 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-align: right;
}

.receipt-row__muted {
  color: var(--ink-3);
}

.receipt-divider {
  height: calc(1 * var(--rpx));
  margin: calc(32 * var(--rpx)) 0;
  background: var(--line);
}

.crop-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: calc(100vh - calc(300 * var(--rpx)) - env(safe-area-inset-bottom));
  padding: calc(48 * var(--rpx));
  overflow: hidden;
  background: var(--ink);
}

.crop-image {
  width: 100%;
  height: 100%;
  border: calc(1 * var(--rpx)) solid var(--color-ink-secondary);
  border-radius: var(--radius-24);
  background: linear-gradient(135deg, var(--figma-color-ink-strong), var(--ink));
}

.crop-edit-hint {
  position: absolute;
  right: calc(72 * var(--rpx));
  bottom: calc(72 * var(--rpx));
  left: calc(72 * var(--rpx));
  padding: calc(18 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(255, 255, 255, 0.16);
  border-radius: var(--radius-pill);
  color: var(--color-surface);
  background: rgba(13, 24, 40, 0.82);
  font-size: var(--text-caption);
  font-weight: 700;
  text-align: center;
  pointer-events: none;
}

.crop-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  align-items: center;
  box-sizing: border-box;
  min-height: calc(188 * var(--rpx));
  padding: calc(30 * var(--rpx)) calc(48 * var(--rpx))
    calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--figma-color-ink-strong);
  background: var(--ink);
}

.crop-actions__quiet,
.crop-actions__tool,
.crop-actions__confirm {
  min-height: calc(88 * var(--rpx));
  color: var(--color-surface);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.crop-actions__tool {
  justify-self: center;
  width: auto;
  min-width: 0;
  padding: 0 calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--figma-color-ink-strong);
  font-size: var(--text-caption);
  white-space: nowrap;
}

.crop-actions__confirm {
  justify-self: end;
  min-width: calc(136 * var(--rpx));
  padding: 0 calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-primary-bright);
  box-shadow: var(--shadow-primary-soft);
}

.camera-workspace {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - calc(430 * var(--rpx)) - env(safe-area-inset-bottom));
  padding: calc(24 * var(--rpx)) calc(56 * var(--rpx));
}

.capture-page--camera .camera-workspace {
  flex: 1 1 auto;
  min-height: 0;
}

.camera-frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  max-width: calc(640 * var(--rpx));
  height: min(calc(760 * var(--rpx)), 54vh);
  border: calc(1 * var(--rpx)) solid rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-48);
  background: rgba(17, 24, 39, 0.26);
  overflow: hidden;
}

.camera-preview,
.camera-preview-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.camera-preview-shade {
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(15, 23, 42, 0.08) 0%,
    rgba(15, 23, 42, 0.02) 54%,
    rgba(15, 23, 42, 0.62) 100%
  );
  pointer-events: none;
}

.camera-frame--material {
  border-color: rgba(124, 134, 255, 0.52);
  background: rgba(8, 145, 178, 0.12);
}

.camera-corner {
  position: absolute;
  box-sizing: border-box;
  width: calc(48 * var(--rpx));
  height: calc(48 * var(--rpx));
  z-index: 2;
  border-color: var(--color-surface);
  border-style: solid;
}

.camera-corner--tl {
  top: calc(32 * var(--rpx));
  left: calc(32 * var(--rpx));
  border-width: calc(4 * var(--rpx)) 0 0 calc(4 * var(--rpx));
  border-radius: var(--radius-16) 0 0;
}

.camera-corner--tr {
  top: calc(32 * var(--rpx));
  right: calc(32 * var(--rpx));
  border-width: calc(4 * var(--rpx)) calc(4 * var(--rpx)) 0 0;
  border-radius: 0 var(--radius-16) 0 0;
}

.camera-corner--bl {
  bottom: calc(32 * var(--rpx));
  left: calc(32 * var(--rpx));
  border-width: 0 0 calc(4 * var(--rpx)) calc(4 * var(--rpx));
  border-radius: 0 0 0 var(--radius-16);
}

.camera-corner--br {
  right: calc(32 * var(--rpx));
  bottom: calc(32 * var(--rpx));
  border-width: 0 calc(4 * var(--rpx)) calc(4 * var(--rpx)) 0;
  border-radius: 0 0 var(--radius-16);
}

.camera-frame__copy {
  position: absolute;
  right: calc(24 * var(--rpx));
  bottom: calc(24 * var(--rpx));
  left: calc(24 * var(--rpx));
  z-index: 2;
  max-width: calc(520 * var(--rpx));
  margin: 0 auto;
  padding: calc(20 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: rgba(15, 23, 42, 0.56);
  text-align: center;
}

.camera-frame__title {
  color: rgba(255, 255, 255, 0.82);
  font-size: var(--text-body-lg);
  font-weight: 700;
  letter-spacing: calc(2 * var(--rpx));
  line-height: 1.55;
  text-shadow: 0 calc(2 * var(--rpx)) calc(8 * var(--rpx)) rgba(0, 0, 0, 0.6);
}

.camera-frame__hint {
  margin-top: calc(16 * var(--rpx));
  color: rgba(103, 232, 249, 0.82);
  font-size: var(--text-micro);
  font-weight: 600;
}

.camera-track {
  display: flex;
  gap: calc(16 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.camera-track__item {
  min-width: calc(116 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-ink-secondary);
  border-radius: var(--radius-capsule);
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
}

.camera-track__item--active {
  border-color: var(--color-primary-bright);
  background: rgba(97, 95, 255, 0.16);
  color: var(--color-primary-soft);
}

.camera-controls {
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  min-height: calc(196 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(80 * var(--rpx)) calc(12 * var(--rpx));
  background: var(--ink);
}

.camera-control {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(8 * var(--rpx));
  width: calc(96 * var(--rpx));
  min-height: calc(96 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-ink-strong);
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 600;
}

.camera-control--placeholder {
  border-color: transparent;
  background: transparent;
}

.album-glyph {
  font-size: var(--text-section);
}

.camera-shutter {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: calc(144 * var(--rpx));
  height: calc(144 * var(--rpx));
  padding: calc(8 * var(--rpx));
  border: calc(8 * var(--rpx)) solid var(--color-surface);
  border-radius: 50%;
}

.camera-shutter__core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-surface);
}

.camera-shutter[disabled] {
  opacity: 0.45;
}

.material-actions {
  display: flex;
  gap: calc(24 * var(--rpx));
  box-sizing: border-box;
  min-height: calc(150 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(48 * var(--rpx))
    calc(calc(28 * var(--rpx)) + env(safe-area-inset-bottom));
}

.material-action {
  flex: 1;
  min-height: calc(88 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-ink-secondary);
  border-radius: var(--radius-40);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.material-action--primary {
  border-color: var(--color-primary-bright);
  background: var(--color-primary-bright);
}

.material-action[disabled] {
  opacity: 0.45;
}

.camera-bottom-panel {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  background: var(--ink);
}

.camera-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(20 * var(--rpx));
  box-sizing: border-box;
  width: calc(100% - calc(96 * var(--rpx)));
  max-width: 720px;
  margin: 0 auto;
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(251, 191, 36, 0.42);
  border-radius: var(--radius-capsule);
  background: rgba(120, 53, 15, 0.46);
  color: var(--figma-color-warning);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
  text-align: center;
}

.camera-error__copy {
  min-width: 0;
}

.camera-error__action {
  flex: none;
  min-height: 44px;
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(251, 191, 36, 0.5);
  border-radius: var(--radius-capsule);
  background: rgba(15, 23, 42, 0.52);
  color: var(--figma-color-warning);
  font-size: var(--text-micro);
  font-weight: 800;
}

.camera-privacy {
  padding: calc(12 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(12 * var(--rpx)) + env(safe-area-inset-bottom));
  background: var(--ink);
  color: var(--color-faint);
  font-size: var(--text-micro);
  line-height: 1.45;
  text-align: center;
}

.searching-screen {
  min-height: 100vh;
}

.searching-spinner {
  box-sizing: border-box;
  width: calc(128 * var(--rpx));
  height: calc(128 * var(--rpx));
  margin-bottom: calc(48 * var(--rpx));
  border: calc(8 * var(--rpx)) solid var(--color-primary-soft-strong);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: capture-spin 1.6s linear infinite;
}

.searching-spinner--cyan {
  border-color: var(--color-primary-soft);
  border-top-color: var(--color-primary-bright);
}

@keyframes capture-spin {
  100% {
    transform: rotate(360deg);
  }
}

.capture-state-wrap {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(32 * var(--rpx));
}

.ocr-source-preview {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: calc(340 * var(--rpx));
  overflow: hidden;
  border-bottom: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--ink);
}

.ocr-source-preview__image {
  width: 100%;
  height: 100%;
  opacity: 0.72;
}

.ocr-source-preview__pdf {
  color: var(--color-ink-secondary);
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--text-display);
  font-weight: 800;
}

.ocr-source-preview__label {
  position: absolute;
  right: calc(24 * var(--rpx));
  bottom: calc(24 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-16);
  background: rgba(0, 0, 0, 0.62);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 700;
}

.ocr-content,
.match-content,
.solution-content {
  box-sizing: border-box;
  min-height: calc(100vh - calc(112 * var(--rpx)));
  padding: calc(40 * var(--rpx)) calc(40 * var(--rpx)) 0;
}

.recognized-type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  margin-bottom: calc(40 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.recognized-type-card__label {
  display: inline-block;
  margin-right: calc(16 * var(--rpx));
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-8);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.recognized-type-card__value {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.recognized-type-card__switch {
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--line);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.ocr-card {
  position: relative;
  margin-bottom: calc(28 * var(--rpx));
  overflow: hidden;
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.ocr-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(24 * var(--rpx)) calc(32 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
}

.ocr-card__confidence {
  color: var(--ink-2);
  font-size: var(--text-micro);
}

.ocr-card__confidence--warning,
.ocr-card__confidence--danger {
  color: var(--figma-color-warning);
}

.ocr-card__confidence--success {
  color: var(--good);
}

.ocr-card__input {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(220 * var(--rpx));
  padding: calc(32 * var(--rpx));
  background: transparent;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.75;
}

.ocr-card__warning {
  padding: calc(24 * var(--rpx)) calc(32 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--figma-color-warning-soft);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}

.ocr-completeness {
  padding: calc(24 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--color-primary-soft);
  color: var(--color-primary-bright);
  font-size: var(--text-caption);
  font-weight: 700;
}

.capture-inline-error {
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-micro);
  font-weight: 700;
}

.ocr-bottom-spacer,
.match-bottom-spacer,
.solution-bottom-spacer {
  height: calc(calc(150 * var(--rpx)) + env(safe-area-inset-bottom));
}

.capture-bottom-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: calc(28 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid rgba(242, 244, 247, 0.94);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(calc(26 * var(--rpx)));
}

.no-hit-icon {
  border: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.search-glyph {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: calc(52 * var(--rpx));
  height: calc(52 * var(--rpx));
  border: calc(6 * var(--rpx)) solid var(--figma-color-line-emphasis);
  border-radius: 50%;
}

.search-glyph::after {
  position: absolute;
  right: calc(-18 * var(--rpx));
  bottom: calc(-12 * var(--rpx));
  width: calc(26 * var(--rpx));
  height: calc(6 * var(--rpx));
  border-radius: calc(4 * var(--rpx));
  background: var(--figma-color-line-emphasis);
  content: "";
  transform: rotate(45deg);
}

.no-hit-copy {
  margin-bottom: calc(80 * var(--rpx));
}

.match-title {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1 * var(--rpx));
  line-height: 1.25;
}

.match-copy {
  margin-top: calc(20 * var(--rpx));
  margin-bottom: calc(40 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.65;
}

.question-unit-tabs {
  display: flex;
  gap: calc(12 * var(--rpx));
  margin-bottom: calc(28 * var(--rpx));
  overflow-x: auto;
}

.question-unit-tab {
  flex: 0 0 auto;
  min-width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 700;
}

.question-unit-tab--active {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
}

.match-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(210 * var(--rpx));
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(32 * var(--rpx));
  overflow: hidden;
  border: calc(2 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  color: var(--ink);
  text-align: left;
  box-shadow: var(--shadow-card);
}

.match-card--selected {
  border-color: var(--color-primary-bright);
  box-shadow: var(--shadow-ai);
}

.match-card__badge {
  display: inline-block;
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.match-card__score {
  position: absolute;
  top: 0;
  right: 0;
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: 0 0 0 var(--radius-32);
  background: var(--primary);
  color: var(--color-surface);
  font-family: "SF Mono", Menlo, monospace;
  font-size: var(--text-micro);
  font-weight: 700;
}

.match-card__copy {
  margin-top: calc(28 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.6;
}

.match-card__evidence {
  display: flex;
  flex-wrap: wrap;
  gap: var(--figma-space-6);
  margin-top: var(--figma-space-10);
}

.match-card__evidence-line {
  padding: var(--figma-space-4) var(--figma-space-8);
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.4;
}

.solution-content {
  padding-top: calc(16 * var(--rpx));
}

.ai-solution-banner {
  display: flex;
  align-items: flex-start;
  gap: calc(20 * var(--rpx));
  margin-bottom: calc(40 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--figma-gradient-ai);
  color: var(--color-surface);
  box-shadow: var(--shadow-primary-soft);
}

.ai-solution-banner__mark {
  flex: 0 0 auto;
  font-size: var(--text-title-sm);
}

.ai-solution-banner__title {
  font-size: var(--text-body);
  font-weight: 700;
}

.ai-solution-banner__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-primary-soft);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.solution-question {
  margin-bottom: calc(48 * var(--rpx));
}

.solution-tags {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-bottom: calc(24 * var(--rpx));
}

.solution-tag {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
  box-shadow: var(--shadow-crisp);
}

.solution-question__segment {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.72;
}

.solution-answer-card {
  position: relative;
  margin-top: calc(56 * var(--rpx));
  margin-bottom: calc(56 * var(--rpx));
  padding: calc(56 * var(--rpx)) calc(40 * var(--rpx)) calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.solution-answer-card__badge {
  position: absolute;
  top: calc(-28 * var(--rpx));
  left: calc(36 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(4 * var(--rpx)) solid var(--color-surface);
  border-radius: var(--figma-radius-pill);
  background: var(--good);
  color: var(--color-surface);
  font-size: var(--text-caption);
  font-weight: 700;
  box-shadow: var(--shadow-soft);
}

.solution-answer-card--ai .solution-answer-card__badge {
  background: var(--color-primary-bright);
}

.solution-answer-card__answer {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
  line-height: 1.55;
  white-space: pre-wrap;
}

.solution-answer-card__source {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.solution-explanation {
  margin-bottom: calc(32 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.solution-section-title {
  margin-bottom: calc(24 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.solution-explanation__copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.8;
  white-space: pre-wrap;
}

.solution-keypoint {
  display: flex;
  align-items: flex-start;
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: 1.65;
}

.solution-keypoint__dot {
  flex: 0 0 auto;
  width: calc(12 * var(--rpx));
  height: calc(12 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary-bright);
}

.solution-limitation {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.6;
}

.solution-inline-action {
  margin-top: calc(28 * var(--rpx));
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.anan-solution-action {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: calc(16 * var(--rpx));
  box-sizing: border-box;
  width: 100%;
  min-height: calc(92 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: 0 calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  color: var(--primary);
  font-size: var(--text-body);
  font-weight: 700;
  text-align: left;
}

.solution-boundary {
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--line);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.6;
}

.capture-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(16, 24, 40, 0.42);
}

.capture-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  box-sizing: border-box;
  max-height: 84vh;
  padding: calc(16 * var(--rpx)) calc(48 * var(--rpx))
    calc(calc(46 * var(--rpx)) + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: var(--radius-64) var(--radius-64) 0 0;
  background: var(--bg);
  box-shadow: var(--shadow-overlay);
}

.capture-sheet__handle {
  width: calc(96 * var(--rpx));
  height: calc(12 * var(--rpx));
  margin: 0 auto calc(40 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
}

.capture-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(28 * var(--rpx));
}

.capture-sheet__title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.8 * var(--rpx));
}

.capture-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: calc(64 * var(--rpx));
  min-height: calc(64 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--line);
  color: var(--ink-2);
  font-size: var(--text-title);
  font-weight: 400;
}

.capture-sheet__copy {
  margin: calc(24 * var(--rpx)) 0 calc(32 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.65;
}

.record-option {
  box-sizing: border-box;
  width: 100%;
  margin-top: calc(20 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(3 * var(--rpx)) solid transparent;
  border-radius: var(--radius-48);
  background: var(--color-surface);
  color: var(--ink);
  text-align: left;
  box-shadow: var(--shadow-soft);
}

.record-option--primary {
  border-color: var(--color-primary-bright);
  background: rgba(238, 242, 255, 0.55);
  color: var(--color-muted);
}

.record-option--disabled {
  opacity: 0.58;
}

.record-option__title {
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.record-option__copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.55;
}

button.capture-channel-entry {
  width: 100%;
}

button.capture-mode,
button.capture-page-action,
button.camera-track__item,
button.recognized-type-card__switch,
button.question-unit-tab,
button.solution-inline-action {
  width: auto;
}

button.capture-cyan-button,
button.capture-ai-button,
button.capture-primary-button,
button.capture-secondary-button,
button.capture-dark-quiet,
button.match-card,
button.anan-solution-action,
button.record-option {
  width: 100%;
}

button.crop-actions__quiet {
  width: 100%;
}

button.crop-actions__tool {
  width: auto;
}

button.crop-actions__confirm {
  width: auto;
}

button.camera-control {
  width: calc(96 * var(--rpx));
}

button.camera-shutter {
  width: calc(144 * var(--rpx));
}

button.camera-error__action {
  width: auto;
}

button.material-action {
  width: auto;
}

button.capture-sheet__close {
  width: calc(64 * var(--rpx));
}

@media (min-width: 700px) {
  /*
   * 平板拍摄态占满一屏分配空间：顶部模式、取景、快门和隐私说明共同参与
   * 布局，避免手机尺寸的取景框悬在大块空白中，也不把快门推到屏幕外。
   */
  .ocr-content,
  .match-content,
  .solution-content {
    box-sizing: border-box;
    width: 100%;
    max-width: 900px;
    margin-right: auto;
    margin-left: auto;
    padding-right: 40px;
    padding-left: 40px;
  }

  .capture-bottom-dock {
    right: auto;
    left: 50%;
    box-sizing: border-box;
    width: 100%;
    max-width: 900px;
    padding-right: 40px;
    padding-left: 40px;
    transform: translateX(-50%);
  }

  .camera-workspace {
    flex: 1 1 auto;
    min-height: 0;
    padding-top: 20px;
    padding-right: max(calc(56 * var(--rpx)), calc((100vw - 720px) / 2));
    padding-bottom: 16px;
    padding-left: max(calc(56 * var(--rpx)), calc((100vw - 720px) / 2));
  }

  .camera-frame {
    flex: 1 1 auto;
    width: min(72vw, 680px);
    max-width: 680px;
    height: auto;
    max-height: 780px;
  }

  .camera-track {
    flex: 0 0 auto;
    margin-top: 16px;
  }

  .camera-controls,
  .material-actions,
  .camera-error,
  .camera-privacy {
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 720px;
    margin-right: auto;
    margin-left: auto;
  }

  .capture-sheet {
    right: calc((100vw - 720px) / 2);
    left: calc((100vw - 720px) / 2);
    border-radius: var(--radius-64) var(--radius-64) 0 0;
  }
}
