.capture-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: var(--color-canvas);
  color: var(--color-ink);
}

.capture-page--camera {
  background: #13211f;
  color: #ffffff;
}

.capture-nav {
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  min-height: 76rpx;
}

.capture-nav__side {
  min-height: 68rpx;
  color: inherit;
  font-size: 54rpx;
  line-height: 62rpx;
}

.capture-nav__side--text {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: right;
}

.capture-page--camera .capture-nav__side--text {
  color: rgba(255, 255, 255, 0.72);
}

.capture-nav__title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.capture-content {
  padding-top: 24rpx;
}

.capture-mode-switch {
  display: inline-flex;
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 7rpx;
  border-radius: 26rpx;
  background: #eef2f0;
}

.capture-mode {
  min-width: 176rpx;
  padding: 17rpx 20rpx;
  border-radius: 20rpx;
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  font-weight: 650;
  text-align: center;
}

.capture-mode--active {
  background: #ffffff;
  color: var(--color-primary-deep);
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(20, 52, 48, 0.08);
}

.ilink-card {
  box-sizing: border-box;
  margin-top: 22rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(94, 214, 193, 0.22);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.09);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.ilink-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.ilink-card__eyebrow {
  color: #5ed6c1;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.ilink-card__title {
  margin-top: 7rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.ilink-card__refresh {
  min-width: 54rpx;
  min-height: 54rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 36rpx;
  line-height: 54rpx;
  text-align: center;
}

.ilink-card__state,
.ilink-card__copy,
.ilink-card__hint,
.ilink-card__boundary,
.ilink-card__error {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.55;
}

.ilink-card__status {
  width: max-content;
  margin-top: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 195, 178, 0.18);
  color: #78e4d1;
  font-size: 20rpx;
  font-weight: 800;
}

.ilink-card__status--warning {
  background: rgba(236, 178, 75, 0.16);
  color: #f0c36e;
}

.ilink-code {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(94, 214, 193, 0.32);
  border-radius: 20rpx;
  background: rgba(10, 31, 29, 0.42);
}

.ilink-code__value {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 850;
  letter-spacing: 5rpx;
}

.ilink-code__action {
  color: #78e4d1;
  font-size: 21rpx;
  font-weight: 800;
}

.ilink-card__boundary {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.62);
}

.ilink-card__error {
  color: #ffb0ad;
}

.ilink-card__button {
  min-height: 76rpx;
  margin: 22rpx 0 0;
  border: 0;
  border-radius: 20rpx;
  background: #16a88f;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.ilink-card__button::after,
.ilink-card__link::after {
  border: 0;
}

.ilink-card__button--quiet {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.82);
}

.ilink-card__link {
  min-height: 58rpx;
  margin: 10rpx 0 0;
  border: 0;
  background: transparent;
  color: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
  line-height: 58rpx;
}

.ilink-card__link--danger {
  color: #ffaaa6;
}

.camera-stage {
  box-sizing: border-box;
  height: 730rpx;
  margin-top: 22rpx;
  padding: 34rpx 30rpx 24rpx;
  border-radius: 42rpx;
  background: #173b38;
}

.camera-chip {
  width: max-content;
  margin: 0 auto;
  padding: 13rpx 34rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 22rpx;
  font-weight: 750;
}

.camera-document {
  position: relative;
  box-sizing: border-box;
  width: 88%;
  height: 500rpx;
  margin: 34rpx auto 0;
  padding: 50rpx 34rpx;
  border-radius: 24rpx;
  background: #fbfcfb;
  color: var(--color-ink);
}

.camera-document__label {
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 800;
}

.camera-document__line {
  width: 86%;
  height: 18rpx;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: #dbe2df;
}

.camera-document__line--wide {
  width: 100%;
}

.camera-document__line--short {
  width: 66%;
}

.camera-options {
  margin-top: 54rpx;
  color: var(--color-ink-secondary);
  font-size: 23rpx;
  word-spacing: 24rpx;
}

.scan-corner {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  border-color: #21c7b5;
  border-style: solid;
}

.scan-corner--tl { top: -9rpx; left: -9rpx; border-width: 7rpx 0 0 7rpx; border-radius: 30rpx 0 0; }
.scan-corner--tr { top: -9rpx; right: -9rpx; border-width: 7rpx 7rpx 0 0; border-radius: 0 30rpx 0 0; }
.scan-corner--bl { bottom: -9rpx; left: -9rpx; border-width: 0 0 7rpx 7rpx; border-radius: 0 0 0 30rpx; }
.scan-corner--br { right: -9rpx; bottom: -9rpx; border-width: 0 7rpx 7rpx 0; border-radius: 0 0 30rpx; }

.camera-hint {
  margin-top: 34rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.capture-note {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 23rpx;
  font-weight: 650;
}

.capture-track-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.capture-track {
  min-width: 110rpx;
  padding: 11rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 21rpx;
  text-align: center;
}

.capture-track--active {
  border-color: #25c3b2;
  background: rgba(0, 151, 139, 0.24);
  color: #ffffff;
  font-weight: 750;
}

.capture-controls {
  display: grid;
  grid-template-columns: 1fr 150rpx 1fr;
  align-items: center;
  margin-top: 24rpx;
}

.capture-control {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #ffffff;
  font-size: 21rpx;
}

.capture-control--quiet {
  color: rgba(255, 255, 255, 0.68);
}

.capture-control__icon {
  font-size: 38rpx;
  line-height: 1;
}

.capture-shutter {
  box-sizing: border-box;
  width: 124rpx;
  height: 124rpx;
  margin: 0 auto;
  padding: 10rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
}

.capture-shutter__core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-primary);
}

.import-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.import-action {
  min-height: 92rpx;
  margin: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 92rpx;
}

.import-action--primary {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.capture-privacy {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.38);
  font-size: 19rpx;
  line-height: 1.55;
  text-align: center;
}

.capture-error,
.capture-warning,
.capture-boundary {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.capture-error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.capture-warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.capture-boundary {
  background: #eef2f0;
  color: var(--color-ink-secondary);
}

.capture-progress-card,
.recognized-type-card,
.ocr-card,
.result-question-card,
.result-reason-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(41, 73, 65, 0.08);
  border-radius: 32rpx;
  background: #ffffff;
}

.capture-progress-number {
  color: var(--color-primary-deep);
  font-size: 68rpx;
  font-weight: 850;
}

.capture-progress-track {
  height: 14rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--color-line);
}

.capture-progress-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.capture-progress-file {
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.capture-content--review,
.capture-content--result {
  padding-bottom: 140rpx;
}

.source-preview {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 144rpx;
  gap: 20rpx;
  height: 280rpx;
  padding: 28rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #142421;
}

.source-preview__image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
  background: #ffffff;
}

.source-preview__pdf {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--color-primary);
  font-size: 50rpx;
  font-weight: 850;
}

.source-preview__quality {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 14rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.45;
}

.source-preview__quality-title {
  color: #83ded3;
  font-size: 22rpx;
}

.recognized-type-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.recognized-type-copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.recognized-type-copy__label {
  color: var(--color-muted);
  font-size: 20rpx;
}

.recognized-type-copy__value {
  font-size: 28rpx;
  font-weight: 750;
}

.recognized-type-actions {
  display: flex;
  gap: 10rpx;
}

.recognized-type-action {
  padding: 10rpx 15rpx;
  border-radius: 999rpx;
  color: var(--color-muted);
}

.recognized-type-actions .is-active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 750;
}

.ocr-card__head,
.ocr-segment__meta,
.match-choice,
.matched-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ocr-card__title {
  font-size: 28rpx;
}

.ocr-card__count,
.ocr-segment__meta {
  color: var(--color-muted);
  font-size: 20rpx;
}

.ocr-segment {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-line);
}

.ocr-segment__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 14rpx;
  padding: 0;
  color: var(--color-ink);
  font-size: 25rpx;
  line-height: 1.65;
}

.status-warning { color: var(--color-warning); }
.status-success { color: var(--color-primary); }

.capture-completeness,
.matched-banner {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.question-unit-tabs {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0;
  overflow-x: auto;
}

.question-unit-tab {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 20rpx;
  color: var(--color-ink-secondary);
  background: #ffffff;
}

.question-unit-tab.is-active {
  border-color: var(--color-primary);
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.match-choice {
  margin-top: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  background: #ffffff;
}

.match-choice--selected {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.match-choice__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 9rpx;
}

.match-choice__version {
  overflow: hidden;
  color: var(--color-muted);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-choice__kind,
.matched-banner__title {
  font-weight: 750;
}

.match-choice__score {
  color: var(--color-primary-deep);
  font-size: 28rpx;
  font-weight: 850;
}

.capture-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 46rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(237, 243, 241, 0.94);
  box-shadow: 0 -18rpx 40rpx rgba(18, 55, 50, 0.08);
  backdrop-filter: blur(20rpx);
}

.capture-primary,
.capture-secondary {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin: 20rpx 0 0;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 96rpx;
}

.capture-primary {
  border: 0;
  background: linear-gradient(155deg, #00978b, #08a89a);
  color: #ffffff;
  box-shadow: 0 20rpx 36rpx rgba(0, 151, 139, 0.2);
}

.capture-primary--disabled {
  box-shadow: none;
  opacity: 0.45;
}

.capture-secondary {
  border: 1rpx solid var(--color-line-strong);
  background: #ffffff;
  color: var(--color-primary-deep);
}

.matched-banner {
  align-items: flex-start;
}

.matched-banner__note {
  font-size: 20rpx;
  font-weight: 500;
}

.result-chip {
  display: inline-flex;
  padding: 11rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 750;
}

.result-segment {
  margin-top: 22rpx;
  color: var(--color-ink);
  font-size: 25rpx;
  line-height: 1.65;
}

.result-answer-card {
  margin-top: 24rpx;
  padding: 30rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: var(--color-primary);
  color: #ffffff;
}

.result-answer-card--empty {
  background: #58656b;
}

.result-answer-card__label,
.result-answer-card__title,
.result-answer-card__version {
  display: block;
}

.result-answer-card__label {
  font-size: 21rpx;
}

.result-answer-card__title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.result-answer-card__title--empty {
  font-size: 28rpx;
  line-height: 1.5;
}

.result-answer-card__version {
  margin-top: 18rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.74);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-reason-card__title,
.result-reason-card__copy {
  display: block;
}

.result-reason-card__title {
  font-size: 28rpx;
  font-weight: 750;
}

@media (min-width: 768px) {
  .capture-page {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: calc(52px + env(safe-area-inset-top)) 32px calc(36px + env(safe-area-inset-bottom));
  }

  .capture-nav {
    grid-template-columns: 48px 1fr 48px;
    min-height: 52px;
  }

  .capture-nav__title {
    font-size: 22px;
  }

  .capture-nav__side--text,
  .capture-mode,
  .camera-chip,
  .camera-hint,
  .capture-note,
  .capture-track,
  .capture-control,
  .import-action,
  .capture-privacy {
    font-size: 14px;
  }

  .camera-stage {
    height: 500px;
    margin-top: 18px;
    padding: 24px;
    border-radius: 24px;
  }

  .camera-document {
    width: 72%;
    height: 330px;
    margin-top: 24px;
    padding: 34px 28px;
    border-radius: 16px;
  }

  .capture-controls {
    grid-template-columns: 1fr 96px 1fr;
    margin-top: 18px;
  }

  .capture-shutter {
    width: 80px;
    height: 80px;
    padding: 7px;
    border-width: 4px;
  }

  .capture-progress-card,
  .recognized-type-card,
  .ocr-card,
  .result-question-card,
  .result-reason-card {
    margin-top: 18px;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .capture-dock {
    right: 50%;
    left: auto;
    width: 100%;
    max-width: 900px;
    padding: 12px 32px calc(12px + env(safe-area-inset-bottom));
    transform: translateX(50%);
  }

  .capture-primary,
  .capture-secondary {
    min-height: 54px;
    margin-top: 14px;
    border-radius: 16px;
    font-size: 17px;
    line-height: 54px;
  }
}

.result-reason-card__copy {
  margin-top: 18rpx;
  color: var(--color-ink-secondary);
  font-size: 23rpx;
  line-height: 1.7;
}
