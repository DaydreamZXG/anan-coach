<view class="brain-page">
  <view class="brain-hero"><view class="brain-kicker">当日调整</view><view class="brain-title">时间变了，目标不用推倒重来</view><view class="brain-copy">告诉岸岸今天还能学多久，系统重排任务而不丢证据。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error' && !dashboard}}" state="error" title="容量没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{dashboard}}">
    <view class="brain-card"><view class="brain-label">今日可用分钟</view><input class="minute-input type-data" type="number" value="{{minutes}}" bindinput="inputMinutes" /><button class="brain-action brain-action--secondary" bindtap="markUnavailable">今天确实无法学习</button></view>
    <view class="brain-card">
      <view class="scale-section">
        <view class="brain-row-title">精力 · <text class="type-data">{{energy}}</text>/5</view>
        <view class="scale-row"><button wx:for="{{options}}" wx:key="*this" class="scale-option {{energy === item ? 'scale-option--active' : ''}}" data-field="energy" data-value="{{item}}" bindtap="chooseScale">{{item}}</button></view>
      </view>
      <view class="scale-section">
        <view class="brain-row-title">压力 · <text class="type-data">{{stress}}</text>/5</view>
        <view class="scale-row"><button wx:for="{{options}}" wx:key="*this" class="scale-option {{stress === item ? 'scale-option--active' : ''}}" data-field="stress" data-value="{{item}}" bindtap="chooseScale">{{item}}</button></view>
      </view>
      <view class="scale-section">
        <view class="brain-row-title">时间把握 · <text class="type-data">{{confidenceLevel}}</text>/5</view>
        <view class="scale-row"><button wx:for="{{options}}" wx:key="*this" class="scale-option {{confidenceLevel === item ? 'scale-option--active' : ''}}" data-field="confidenceLevel" data-value="{{item}}" bindtap="chooseScale">{{item}}</button></view>
      </view>
      <view class="brain-warning">情绪与压力只调整今日负荷，不会改写长期能力证据。</view>
      <view wx:if="{{errorMessage}}" class="brain-warning">{{errorMessage}}</view>
      <view wx:if="{{successMessage}}" class="success-note">{{successMessage}}</view>
      <button class="brain-action" loading="{{submitting}}" bindtap="submit">确认并生成新计划版本</button>
    </view>
  </block>
</view>
