.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

/* ── 顶部导航 ── */
.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
  flex-shrink: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 表单卡 ── */
.field {
  margin: 8rpx 32rpx 24rpx;
  padding: 32rpx;
}

.field__label {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--ink-3);
}

.field__current {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
}

.field__help {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.field__ghost {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-sm);
  padding: 20rpx 0;
}

/* ── 时长横滑条 ── */
.strip {
  margin-top: 24rpx;
  white-space: nowrap;
}

.strip__inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 2rpx;
}

.strip__option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 132rpx;
  padding: 18rpx 16rpx;
  border-radius: var(--r-sm);
  background: #f4f5fb;
  border: 1rpx solid transparent;
  box-sizing: border-box;
}

.strip__option--active {
  background: rgba(91, 95, 244, 0.1);
  border-color: var(--indigo);
}

.strip__label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.strip__caption {
  font-size: 18rpx;
  color: var(--ink-3);
}

/* ── 状态量表 ── */
.scale + .scale {
  margin-top: 32rpx;
}

.scale__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.scale__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.scale__value {
  font-size: 22rpx;
  color: var(--ink-2);
}

.scale__row {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.scale__option {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-3);
  background: #f4f5fb;
  border: 1rpx solid transparent;
  border-radius: var(--r-sm);
  padding: 18rpx 0;
}

.scale__option--active {
  color: var(--indigo);
  background: rgba(91, 95, 244, 0.1);
  border-color: var(--indigo);
}

/* ── 提示与反馈 ── */
.hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--amber);
  background: rgba(217, 127, 6, 0.08);
  border: 1rpx solid rgba(217, 127, 6, 0.28);
  border-radius: var(--r-sm);
  padding: 18rpx 22rpx;
  line-height: 1.7;
}

.hint--error {
  color: var(--red);
  background: rgba(224, 82, 82, 0.08);
  border-color: rgba(224, 82, 82, 0.3);
}

.hint--success {
  color: var(--green);
  background: rgba(13, 159, 110, 0.08);
  border-color: rgba(13, 159, 110, 0.3);
}

.submit {
  margin-top: 32rpx;
}
