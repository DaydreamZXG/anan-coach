.adjustment-page {
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.adjustment-nav {
  display: flex;
  box-sizing: border-box;
  height: 64rpx;
  align-items: center;
  padding: 0 32rpx;
}

button.adjustment-back {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  border: 1rpx solid rgba(229, 231, 235, 0.5);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.05);
}

.adjustment-back__icon {
  position: absolute;
  top: 21rpx;
  left: 24rpx;
  width: 19rpx;
  height: 19rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid var(--ink);
  border-left: 4rpx solid var(--ink);
}

.adjustment-content {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-width: 1520rpx;
  min-height: calc(100vh - 180rpx);
  flex-direction: column;
  gap: 64rpx;
  margin: 0 auto;
  padding: 54rpx 40rpx calc(220rpx + env(safe-area-inset-bottom));
}

.adjustment-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1.3rpx;
  line-height: 1.3;
}

.adjustment-copy {
  margin-top: 24rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.65;
}

.current-card,
.time-card,
.change-card,
.impact-card,
.change-empty {
  box-sizing: border-box;
  border: 1rpx solid rgba(243, 244, 246, 0.92);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.025);
}

.current-card {
  position: relative;
  overflow: hidden;
  padding: 40rpx;
}

.current-card__accent {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 8rpx;
  background: linear-gradient(180deg, var(--figma-color-info-bright), var(--figma-color-cyan-deep));
}

.current-card__label {
  margin-left: 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  font-weight: 700;
}

.current-card__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0 0 16rpx;
}

.current-chip {
  padding: 8rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--line);
  color: var(--figma-color-ink-tertiary);
  font-size: 26rpx;
  font-weight: 700;
}

.current-chip--blue {
  background: var(--figma-color-info-soft);
  color: var(--figma-color-info);
}

.current-card__focus {
  margin: 24rpx 0 0 16rpx;
  color: var(--color-ink-secondary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.55;
}

.current-card__focus-value {
  color: var(--ink);
  font-weight: 700;
}

.adjustment-section__title {
  margin: 0 8rpx 32rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.time-card {
  padding: 40rpx;
}

.time-stepper {
  display: flex;
  box-sizing: border-box;
  min-height: 128rpx;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--bg);
}

button.stepper-button {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex: none;
  margin: 0;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.05);
}

.control-disabled {
  opacity: 0.35;
}

.minus-icon,
.plus-icon {
  position: absolute;
  top: 38rpx;
  left: 25rpx;
  width: 30rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--figma-color-ink-tertiary);
}

.plus-icon::after {
  position: absolute;
  top: -13rpx;
  left: 13rpx;
  width: 4rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: var(--ink);
  content: "";
}

.time-value {
  display: flex;
  min-width: 220rpx;
  align-items: baseline;
  justify-content: center;
}

.time-value__number {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.time-presets {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 40rpx;
}

.time-preset {
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--figma-color-ink-tertiary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.time-preset--active {
  background: var(--ink);
  color: var(--color-surface);
}

.energy-options {
  display: flex;
  gap: 24rpx;
}

.energy-option {
  min-width: 0;
  min-height: 92rpx;
  flex: 1;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--color-surface);
  color: var(--figma-color-ink-tertiary);
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 20rpx rgba(16, 24, 40, 0.025);
}

.energy-option--active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.2);
}

button.time-preset {
  width: 100%;
}

button.energy-option {
  width: auto;
}

.suggestion-card {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  margin-top: 32rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(165, 243, 252, 0.55);
  border-radius: 48rpx;
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.85), rgba(236, 254, 255, 0.85));
}

.suggestion-card__aurora {
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(103, 232, 249, 0.2);
  filter: blur(44rpx);
}

.suggestion-card__content {
  position: relative;
  z-index: 1;
}

.suggestion-card__heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--figma-color-cyan-deep);
  font-size: 32rpx;
  font-weight: 700;
}

.suggestion-card__spark {
  color: var(--figma-color-cyan-deep);
  font-size: 36rpx;
}

.suggestion-card__headline {
  margin-top: 24rpx;
  color: var(--figma-color-cyan-deep);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.suggestion-card__copy {
  margin-top: 12rpx;
  color: rgba(22, 78, 99, 0.88);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.65;
}

.change-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.change-card {
  padding: 32rpx;
}

.change-card--orange {
  background: var(--bg);
}

.change-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.change-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  font-size: 22rpx;
  font-weight: 700;
}

.change-tag--blue {
  background: var(--figma-color-info-soft);
  color: var(--figma-color-info);
}

.change-tag--cyan {
  background: var(--figma-color-cyan-soft);
  color: var(--figma-color-cyan-deep);
}

.change-tag--indigo {
  background: var(--primary-soft);
  color: var(--primary);
}

.change-tag--green {
  background: var(--good-soft);
  color: var(--good);
}

.change-tag--orange {
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
}

.change-duration {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.change-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.change-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.55;
}

.change-empty {
  padding: 36rpx;
  color: var(--ink-2);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.6;
}

.impact-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 40rpx;
}

.impact-card__icon {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  margin-top: 4rpx;
}

.impact-card__title {
  font-size: 30rpx;
  font-weight: 700;
}

.impact-card__copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.adjustment-note {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 32rpx;
  border-radius: 40rpx;
  background: var(--bg);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.adjustment-note__icon {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  margin-top: 3rpx;
  border: 3rpx solid var(--ink-3);
  border-radius: 50%;
  color: var(--ink-3);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.adjustment-error {
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--color-danger-soft);
  border-radius: 28rpx;
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.55;
}

.adjustment-footer {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  width: 100%;
  max-width: 1520rpx;
  margin: 0 auto;
  padding: 32rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(40rpx);
}

.adjustment-footer__actions {
  display: flex;
  gap: 24rpx;
}

.adjustment-primary,
.adjustment-secondary {
  min-height: 104rpx;
  margin: 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
}

button.adjustment-primary {
  width: 100%;
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 16rpx 60rpx rgba(16, 24, 40, 0.12);
}

button.adjustment-primary--grow {
  width: auto;
  min-width: 0;
  flex: 1;
}

button.adjustment-secondary {
  width: 240rpx;
  flex: none;
  border: 1rpx solid var(--line);
  background: var(--bg);
  color: var(--color-ink-secondary);
}

@media (min-width: 768px) {
  .adjustment-content {
    max-width: 1120rpx;
  }

  .adjustment-footer {
    max-width: 1120rpx;
    border-right: 1rpx solid var(--line);
    border-left: 1rpx solid var(--line);
  }
}
