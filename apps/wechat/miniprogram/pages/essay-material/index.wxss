.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.essay { display: flex; flex-direction: column; min-height: 100vh; }

.e-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.e-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.e-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.e-score { font-size: 28rpx; color: var(--ink-3); padding-right: 16rpx; }

.e-loading { padding: 120rpx 0; text-align: center; }

.e-body { flex: 1; min-height: 0; }

.e-prompt { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; border-left: 6rpx solid var(--primary); }
.e-prompt-text { font-size: 30rpx; line-height: 1.6; font-weight: 600; color: var(--ink); }

.e-segment { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 24rpx; }
.e-segment-order { font-size: 24rpx; font-weight: 600; color: var(--primary); }
.e-segment-text { font-size: 29rpx; line-height: 1.7; color: var(--ink-2); }

.e-write { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 24rpx; }
.e-write-head { display: flex; align-items: center; justify-content: space-between; }
.e-section-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.e-textarea { width: 100%; min-height: 320rpx; font-size: 29rpx; line-height: 1.7; color: var(--ink); }
.e-placeholder { color: var(--ink-3); }

.e-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.e-foot-btn { width: 100%; }

.e-grading { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding-top: 160rpx; }
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.anan-avatar-lg { width: 112rpx; height: 112rpx; font-size: 48rpx; margin-bottom: 16rpx; }

.e-pending { display: flex; flex-direction: column; gap: 16rpx; }

.e-finding { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 24rpx; }
.e-finding-head { display: flex; align-items: center; gap: 16rpx; }
.e-sev {
  font-size: 22rpx; font-weight: 600;
  border-radius: 999rpx; padding: 6rpx 20rpx;
}
.e-sev.is-high { color: var(--danger); background: #fdecec; }
.e-sev.is-mid { color: #b45309; background: #fef3e2; }
.e-sev.is-low { color: var(--ink-2); background: var(--bg); }
.e-diagnosis { font-size: 29rpx; line-height: 1.6; color: var(--ink); }
.e-action {
  display: flex; flex-direction: column; gap: 8rpx;
  background: var(--primary-soft);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
}
.e-action-label { font-size: 22rpx; font-weight: 600; color: var(--primary); }
.e-action-text { font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }

.demo-tip { text-align: center; padding-bottom: 16rpx; }
