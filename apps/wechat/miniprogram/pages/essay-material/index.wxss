.material-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  color: var(--color-ink);
}

.material-directory__item,
.selection-toolbar__action,
.material-return {
  margin: 0;
  border: 0;
}

.material-directory__item::after,
.selection-toolbar__action::after,
.material-return::after {
  border: 0;
}

.material-directory {
  width: 100%;
  border-bottom: 1rpx solid var(--color-line);
  background: var(--color-surface);
  white-space: nowrap;
}

.material-directory__inner {
  display: inline-flex;
  gap: var(--figma-space-8);
  padding: var(--figma-space-10) var(--space-page-x);
}

.material-directory__item {
  min-height: 56rpx;
  padding: 0 var(--figma-space-12);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--figma-font-caption);
  line-height: 56rpx;
}

.material-instruction {
  box-sizing: border-box;
  width: 100%;
  max-width: 720px;
  margin: var(--figma-space-16) auto 0;
  padding: 0 var(--space-page-x);
  color: var(--color-faint);
  font-size: var(--figma-font-micro);
  line-height: 1.6;
}

.material-reader {
  box-sizing: border-box;
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: var(--figma-space-20) var(--space-page-x) var(--figma-space-48);
}

.material-paragraph {
  display: grid;
  grid-template-columns: 40rpx minmax(0, 1fr);
  gap: var(--figma-space-12);
  padding: var(--figma-space-12) 0;
  scroll-margin-top: 180rpx;
}

.material-paragraph--selected .material-paragraph__text {
  background: var(--figma-color-cyan-soft-strong);
  box-shadow: inset 0 -3rpx 0 var(--figma-color-cyan-dark);
}

.material-paragraph__number {
  padding-top: var(--figma-space-4);
  color: var(--color-faint);
  font-family: var(--font-family-data);
  font-size: var(--figma-font-micro);
}

.material-paragraph__body {
  min-width: 0;
}

.material-paragraph__text {
  color: var(--figma-color-ink-strong);
  font-family: var(--font-family-reading);
  font-size: var(--figma-font-body);
  letter-spacing: 0.5rpx;
  line-height: 1.95;
  text-align: justify;
}

.material-annotation {
  margin-top: var(--figma-space-12);
  padding: var(--figma-space-12);
  border-left: 4rpx solid var(--color-primary);
  border-radius: 0 var(--figma-radius-xsmall) var(--figma-radius-xsmall) 0;
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--figma-font-caption);
  line-height: 1.65;
}

.material-annotation__label {
  margin-bottom: var(--figma-space-4);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.material-annotation__quote {
  margin-top: var(--figma-space-8);
  color: var(--color-muted);
}

.selection-toolbar {
  position: fixed;
  z-index: var(--z-sheet);
  right: var(--space-page-x);
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  left: var(--space-page-x);
  display: flex;
  max-width: 640px;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  gap: var(--figma-space-8);
  margin: 0 auto;
  padding: 0 var(--figma-space-12);
  border-radius: var(--figma-radius-small);
  background: var(--color-action);
  box-shadow: var(--figma-shadow-elevated);
}

.selection-toolbar__mode,
.selection-toolbar__action {
  color: var(--color-on-primary);
  font-size: var(--figma-font-caption);
  font-weight: 650;
  white-space: nowrap;
}

.selection-toolbar__action {
  min-height: 56rpx;
  padding: 0 var(--figma-space-8);
  background: none;
  line-height: 56rpx;
}

.selection-toolbar__action--muted {
  color: var(--color-faint);
}

.selection-toolbar__divider {
  width: 1rpx;
  height: 28rpx;
  background: var(--color-muted);
}

.material-dock {
  position: fixed;
  z-index: var(--z-footer);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: center;
  padding: var(--figma-space-16) var(--space-page-x)
    calc(var(--figma-space-20) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: var(--color-surface);
}

.material-return {
  min-width: 280rpx;
  min-height: 80rpx;
  padding: 0 var(--figma-space-20);
  border-radius: var(--figma-radius-pill);
  background: var(--color-action);
  color: var(--color-on-primary);
  font-size: var(--figma-font-body-compact);
  font-weight: 720;
  line-height: 80rpx;
  box-shadow: var(--figma-shadow-elevated);
}

button.material-directory__item,
button.selection-toolbar__action {
  width: auto;
}

button.material-return {
  width: 280rpx;
}

@media (min-width: 768px) {
  .material-paragraph {
    grid-template-columns: 48px minmax(0, 1fr);
    gap: var(--figma-space-16);
  }

  .material-paragraph__text {
    font-size: var(--figma-font-body-large);
  }
}
