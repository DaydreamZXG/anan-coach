<view class="material-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="{{activeMaterialLabel || '申论材料'}}"
    back-behavior="emit"
    bind:back="returnToWriter"
  />

  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{status === 'error'}}"
    state="error"
    title="材料没有加载成功"
    description="{{errorMessage}}"
    request-id="{{requestId}}"
    action-text="{{retryAllowed ? '重新加载' : ''}}"
    bind:action="retryLoad"
  />

  <block wx:elif="{{workspace}}">
    <scroll-view class="material-directory" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="material-directory__inner">
        <button
          wx:for="{{directory}}"
          wx:key="materialOrder"
          class="material-directory__item"
          hover-class="item--hover"
          data-anchor="{{item.firstAnchorId}}"
          data-material-order="{{item.materialOrder}}"
          bindtap="scrollToMaterial"
        >
          {{item.label}} · {{item.segmentCount}} 段
        </button>
      </view>
    </scroll-view>

    <view class="material-instruction">轻点段落可划线，再选择加入提纲、引用或复制。</view>

    <view class="material-reader">
      <view
        hover-class="item--hover"
        wx:for="{{segments}}"
        wx:key="segmentId"
        id="{{item.anchorId}}"
        class="material-paragraph {{selectedParagraphId === item.displayParagraphId ? 'material-paragraph--selected' : ''}}"
        data-segment-id="{{item.segmentId}}"
        data-paragraph-id="{{item.displayParagraphId}}"
        data-material-order="{{item.materialOrder}}"
        data-text="{{item.text}}"
        bindtap="selectSegment"
      >
        <view class="material-paragraph__body">
          <text class="material-paragraph__text" user-select>{{item.text}}</text>
          <block wx:for="{{annotations}}" wx:for-item="annotation" wx:key="segmentId">
            <view wx:if="{{item.showAnnotation && annotation.segmentId === item.segmentId}}" class="material-annotation">
              <view class="material-annotation__label">已有材料标注</view>
              <view>{{annotation.summary}}</view>
              <view wx:if="{{annotation.evidenceQuote}}" class="material-annotation__quote">
                “{{annotation.evidenceQuote}}”
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{selectedSegmentId}}" class="selection-toolbar">
    <view class="selection-toolbar__mode">划线</view>
    <view class="selection-toolbar__divider"></view>
    <button wx:if="{{insertMode}}" hover-class="item--hover" class="selection-toolbar__action" bindtap="addSelectionToOutline">加入提纲</button>
    <button wx:if="{{insertMode}}" hover-class="item--hover" class="selection-toolbar__action" bindtap="quoteSelection">引用</button>
    <button hover-class="item--hover" class="selection-toolbar__action" bindtap="copySelection">复制</button>
    <button hover-class="item--hover" class="selection-toolbar__action selection-toolbar__action--muted" bindtap="clearSelection">取消</button>
  </view>

  <view wx:if="{{workspace}}" class="material-dock">
    <button hover-class="item--hover" class="material-return tap-tactile" bindtap="returnToWriter">⌄　返回作答</button>
  </view>
</view>
