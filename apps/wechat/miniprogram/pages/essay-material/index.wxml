<view class="workbench-page">
  <view class="workbench-hero"><view class="workbench-kicker">申论材料地图</view><view class="workbench-title">先看材料关系，再急着下笔</view><view class="workbench-copy">按主体、问题、原因、做法与案例建立可追溯材料地图，每个结论都能回到原文。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="材料没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="{{retryAllowed ? '重新加载' : ''}}" bind:action="retryLoad" />
  <block wx:elif="{{workspace}}">
    <view class="workbench-card"><view class="workbench-section-title">题目要求</view><view class="workbench-text">{{workspace.task.prompt}}</view><view class="workbench-note">{{workspace.task.requirements}}</view></view>
    <view class="workbench-card"><view class="workbench-section-title">材料目录</view><view hover-class="item--hover" wx:for="{{directory}}" wx:key="materialOrder" class="directory-row" data-anchor="{{item.firstAnchorId}}" bindtap="scrollToMaterial"><text>{{item.label}}</text><text class="workbench-meta">{{item.segmentCount}} 段 ›</text></view></view>
    <view wx:for="{{workspace.material.segments}}" wx:key="segmentId" id="material-{{item.materialOrder}}" class="workbench-card"><view class="workbench-pill">材料 {{item.materialOrder}} · 第 {{item.segmentOrder}} 段</view><view class="workbench-text">{{item.text}}</view><block wx:for="{{annotations}}" wx:for-item="annotation" wx:key="segmentId"><view wx:if="{{annotation.segmentId === item.segmentId}}" class="evidence-quote">标注：{{annotation.summary}}<text wx:if="{{annotation.evidenceQuote}}">｜原句：{{annotation.evidenceQuote}}</text></view></block></view>
    <button class="workbench-action {{!writerUrl ? 'workbench-action--disabled' : ''}}" disabled="{{!writerUrl}}" bindtap="openWriter">带着材料地图作答</button>
    <view wx:if="{{!writerUrl}}" class="workbench-note">当前为只读材料入口；从今日计划进入后才允许写入版本化标注。</view>
  </block>
</view>
