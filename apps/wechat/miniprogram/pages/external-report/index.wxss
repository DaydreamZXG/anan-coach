/* 外部模考单：骨架、卡片与按钮来自 s9；保留识别核对表单、
 * 回执网格与成功态等页面特有节点。 */

.external-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.progress {
  height: 14rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.source-image {
  width: 100%;
  margin-top: 20rpx;
  border-radius: var(--radius-16);
}

.span-card--checked {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.span-head {
  display: flex;
  justify-content: space-between;
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
}

.confidence {
  color: var(--ink-2);
}

.form-control,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  margin-top: 12rpx;
  padding: 20rpx 20rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-16);
  background: var(--bg);
  font-size: var(--text-body);
}

.form-textarea {
  min-height: 130rpx;
}

button.check-button {
  min-height: 80rpx;
  margin-top: 16rpx;
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--text-body);
  line-height: 80rpx;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 600;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.chip {
  flex: 1;
  padding: 12rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
}

.chip--active {
  background: var(--color-primary);
  color: var(--color-surface);
}

.score-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.boundary-note {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: var(--radius-16);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.receipt-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.receipt-cell {
  padding: 20rpx;
  border-radius: var(--radius-16);
  background: var(--figma-color-warning-soft);
}

.receipt-label,
.receipt-value {
  display: block;
}

.receipt-label {
  color: var(--color-faint);
  font-size: var(--text-micro);
}

.receipt-value {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: var(--text-caption);
}

.success-card {
  text-align: center;
}

.success-mark {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-title-lg);
  line-height: 84rpx;
}

.success-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}

.success-impact {
  margin-top: 16rpx;
  color: var(--color-ink-secondary);
}

.link-action {
  margin: 16rpx auto 0;
  padding: 12rpx 20rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.4;
}

.link-action::after {
  border: 0;
}

.error-card {
  color: var(--danger);
  line-height: 1.6;
}

.request-id {
  margin: 12rpx 0;
  color: var(--ink-2);
  font-size: var(--text-micro);
}
