<view class="external-page">
  <view class="external-hero"><view class="external-kicker">外部模考单</view><view class="external-title">外部模考，也能进入同一套学习档案</view><view class="external-copy">上传成绩页或答题卡后，先确认识别结果再生成分析；确认前不会影响能力判断。</view></view>

  <view wx:if="{{workflow.phase === 'idle'}}" class="step-card"><view class="step-no">01</view><view class="step-title">选择成绩截图</view><view class="step-copy">仅接受相机或相册图片；成绩单会使用单独的识别流程，避免和题目、答题卡混淆。</view><view class="button-row"><button class="primary" bindtap="chooseCamera">拍摄截图</button><button class="secondary" bindtap="chooseAlbum">从相册选择</button></view></view>

  <view wx:elif="{{workflow.phase === 'uploading'}}" class="step-card"><state-view state="processing" title="正在识别成绩单" description="{{workflow.message}}" /><view class="progress"><view class="progress-bar" style="width: {{workflow.progressPercent}}%"></view></view></view>

  <block wx:elif="{{workflow.phase === 'ocr_review'}}">
    <view class="step-card"><view class="step-no">02</view><view class="step-title">逐段核对识别文字</view><view class="step-copy">{{workflow.message}}</view><image class="source-image" src="{{workflow.localImagePath}}" mode="widthFix" /></view>
    <view wx:for="{{workflow.spans}}" wx:key="spanId" class="span-card {{item.checked ? 'span-card--checked' : ''}}"><view class="span-head"><view>文字块 {{index + 1}}</view><view class="confidence">识别置信 {{item.confidenceLabel}}</view></view><textarea cursor-spacing="24" class="form-control form-textarea" value="{{item.text}}" data-id="{{item.spanId}}" maxlength="500" bindinput="editSpan"></textarea><button class="check-button" data-id="{{item.spanId}}" bindtap="toggleSpan">{{item.checked ? '已对照原图核对' : '点击确认这一段'}}</button></view>
    <button class="primary full" loading="{{submitting}}" bindtap="confirmRecognition">确认全部识别文字</button>
  </block>

  <view wx:elif="{{workflow.phase === 'structured_form'}}" class="step-card"><view class="step-no">03</view><view class="step-title">核对结构化字段</view><view class="step-copy">{{workflow.message}}</view>
    <view class="field"><view class="field-label">平台名称</view><input class="form-control" value="{{form.platformName}}" data-field="platformName" bindinput="updateField" /></view>
    <view class="field"><view class="field-label">模考名称</view><input class="form-control" value="{{form.examName}}" data-field="examName" placeholder="例：2026 国考第 18 季模考" bindinput="updateField" /></view>
    <view class="field"><view class="field-label">作答日期</view><picker mode="date" value="{{form.occurredDate}}" bindchange="updateDate"><view class="picker-value">{{form.occurredDate}}</view></picker></view>
    <view class="field"><view class="field-label">计时状态</view><view class="chip-row"><button class="chip {{form.timedStatus === 'timed' ? 'chip--active' : ''}}" data-value="timed" bindtap="setTimedStatus">计时</button><button class="chip {{form.timedStatus === 'untimed' ? 'chip--active' : ''}}" data-value="untimed" bindtap="setTimedStatus">未计时</button><button class="chip {{form.timedStatus === 'unknown' ? 'chip--active' : ''}}" data-value="unknown" bindtap="setTimedStatus">不确定</button></view></view>
    <view wx:if="{{form.timedStatus === 'timed'}}" class="field"><view class="field-label">作答时长（分钟）</view><input class="form-control" type="digit" value="{{form.durationMinutes}}" data-field="durationMinutes" bindinput="updateField" /></view>
    <view class="score-grid"><view class="field"><view class="field-label">总分</view><input class="form-control" type="digit" value="{{form.totalScore}}" data-field="totalScore" bindinput="updateField" /></view><view class="field"><view class="field-label">行测分</view><input class="form-control" type="digit" value="{{form.xingceScore}}" data-field="xingceScore" bindinput="updateField" /></view><view class="field"><view class="field-label">申论分</view><input class="form-control" type="digit" value="{{form.shenlunScore}}" data-field="shenlunScore" bindinput="updateField" /></view></view>
    <view class="field"><view class="field-label">行测模块分（可选）</view><textarea cursor-spacing="24" class="form-control form-textarea" value="{{form.moduleScoresText}}" data-field="moduleScoresText" placeholder="资料分析:70, 判断推理:65" bindinput="updateField"></textarea></view>
    <view class="boundary-note">这一步先保存草稿，还不算进能力分析。</view><button class="primary full" loading="{{submitting}}" bindtap="createCandidate">生成最终确认单</button>
  </view>

  <view wx:elif="{{workflow.phase === 'final_review' && candidate}}" class="step-card"><view class="step-no">04</view><view class="step-title">最终确认</view><view class="step-copy">请核对下列字段。点击确认前，这条记录不会进入能力分析。</view><view class="receipt-grid"><view class="receipt-cell"><text class="receipt-label">平台</text><text class="receipt-value">{{candidate.platformName}}</text></view><view class="receipt-cell"><text class="receipt-label">模考</text><text class="receipt-value">{{candidate.examName}}</text></view><view class="receipt-cell"><text class="receipt-label">总分</text><text class="receipt-value">{{candidate.totalScore || '未填'}}</text></view><view class="receipt-cell"><text class="receipt-label">行测 / 申论</text><text class="receipt-value">{{candidate.xingceScore || '—'}} / {{candidate.shenlunScore || '—'}}</text></view><view class="receipt-cell"><text class="receipt-label">计时</text><text class="receipt-value">{{candidate.timedStatus === 'timed' ? '计时作答' : candidate.timedStatus === 'untimed' ? '未计时' : '不确定'}} {{candidate.durationMinutes ? candidate.durationMinutes + ' 分钟' : ''}}</text></view><view class="receipt-cell"><text class="receipt-label">当前影响</text><text class="receipt-value">{{abilityLabel}}</text></view></view><view class="boundary-note">{{candidate.confirmationMessage}}</view><button class="primary full" loading="{{submitting}}" bindtap="confirmCandidate">我已核对，确认这条成绩</button></view>

  <view wx:elif="{{workflow.phase === 'confirmed' && candidate}}" class="success-card"><view class="success-mark">✓</view><view class="success-title">外部模考单已确认</view><view class="success-copy">{{candidate.confirmationMessage}}</view><view class="success-pill">{{evidenceLabel}}</view><view class="success-impact">{{abilityLabel}}</view><button class="primary full" bindtap="openLearningProfile">查看更新后的学习档案</button><button class="secondary full" bindtap="returnToday">回到今日计划</button><button class="link-action" bindtap="restart">再录入一条</button></view>

  <view wx:if="{{errorMessage}}" class="error-card"><view>{{errorMessage}}</view><view wx:if="{{requestId}}" class="request-id">问题编号 · {{requestId}}</view><button class="secondary" bindtap="restart">重新开始</button></view>
</view>
