<view class="report-page">
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="报告没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{report}}">
    <view class="report-hero"><view class="report-kicker">{{report.title}}</view><view class="report-title">{{kind === 'single_set' ? '这一组题，暴露了什么' : kind === 'position_gap' ? '离目标岗位，还差在哪里' : '这一周，哪些变化值得继续'}}</view><view class="report-copy">时间、训练、错题、申论和岗位目标，都在这份报告里。</view><view class="report-meta"><view class="report-meta__item">{{generatedAtLabel}}</view><view class="report-meta__item">{{evidenceCount}} 条学习记录</view></view></view>
    <view wx:if="{{partial}}" class="report-banner">当前只能生成部分结论，缺失项不会被猜测填充。</view>
    <state-view wx:if="{{empty}}" class="report-state" state="empty" title="还没有这类记录" description="完成对应任务后，报告会按当时的记录生成。" />
    <view class="report-conclusion"><view class="report-conclusion__label">当前结论</view><view class="report-conclusion__headline">{{report.conclusion.headline}}</view><view class="report-conclusion__detail">{{report.conclusion.detail}}</view><view class="report-next">{{report.conclusion.nextAction}} · 计划引用 {{planEvidenceCount}} 条</view><button class="report-next-action" bindtap="openNextAction">回到今日计划</button></view>
    <view class="report-chart-list"><report-chart wx:for="{{report.charts}}" wx:key="chartId" chart="{{item}}" /></view>
  </block>
</view>
