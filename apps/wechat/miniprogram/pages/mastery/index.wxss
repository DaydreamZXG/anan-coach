.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

.foot-space {
  height: 80rpx;
}

/* ── 顶部导航 ── */

.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__text {
  flex: 1;
  min-width: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 状态迁移 hero ── */

.hero {
  margin: 8rpx 32rpx 28rpx;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.hero__cap {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.08em;
}

.hero__flow {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.hero__num {
  font-size: 52rpx;
  font-weight: 800;
  color: #ffffff;
}

.hero__num--amber {
  color: #fbbf24;
}

.hero__num--cyan {
  color: #22d3ee;
}

.hero__num--green {
  color: #4ade80;
}

.hero__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.hero__arrow {
  flex-shrink: 0;
  padding: 0 8rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.3);
}

.hero__foot {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ── 区块标题（section-head 用全局样式） ── */

.section-head {
  margin: 0 32rpx 20rpx;
}

/* ── 模块分布卡 ── */

.mod {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.mod__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.mod__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.mod__total {
  font-size: 22rpx;
  color: var(--ink-3);
}

.mod__bar {
  margin-top: 18rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(16, 19, 27, 0.05);
  display: flex;
  overflow: hidden;
}

.mod__seg--stable {
  background: var(--green);
}

.mod__seg--due {
  background: var(--cyan);
}

.mod__seg--pending {
  background: var(--amber);
}

.mod__seg--invalid {
  background: rgba(16, 19, 27, 0.18);
}

.mod__legend {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.mod__chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.mod__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
}

.mod__dot--stable {
  background: var(--green);
}

.mod__dot--due {
  background: var(--cyan);
}

.mod__dot--pending {
  background: var(--amber);
}

.mod__dot--invalid {
  background: rgba(16, 19, 27, 0.18);
}

/* ── 失效记录 ── */

.inv {
  margin: 0 32rpx 20rpx;
  padding: 8rpx 28rpx;
}

.inv__row {
  padding: 20rpx 0;
}

.inv__row + .inv__row {
  border-top: 1rpx solid var(--line);
}

.inv__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.inv__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 空态与页脚 ── */

.empty {
  margin: 60rpx 32rpx;
  display: flex;
  justify-content: center;
}

.empty__text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.gen {
  margin-top: 28rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}
