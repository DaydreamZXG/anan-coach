<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav__back" hover-class="is-pressed" bind:tap="onBack">‹</view>
    <view class="nav__text">
      <view class="nav__title">掌握度详情</view>
      <view class="nav__sub">错题走完「复盘 → 验证 → 稳定」的完整迁移</view>
    </view>
  </view>

  <state-view wx:if="{{viewState === 'loading'}}" type="loading" title="正在汇总掌握状态…" />
  <state-view
    wx:elif="{{viewState === 'error'}}"
    type="error"
    title="掌握度尚未载入"
    desc="{{errorDesc}}"
    request-id="{{requestId}}"
    action-text="重试"
    bind:action="onRetry"
  />

  <block wx:else>
    <!-- 状态迁移总览 -->
    <view class="hero">
      <view class="hero__cap">状态迁移</view>
      <view class="hero__flow">
        <view class="hero__step">
          <view class="hero__num hero__num--amber">{{pendingCount}}</view>
          <view class="hero__label">待复盘</view>
        </view>
        <view class="hero__arrow">→</view>
        <view class="hero__step">
          <view class="hero__num hero__num--cyan">{{dueCount}}</view>
          <view class="hero__label">待验证</view>
        </view>
        <view class="hero__arrow">→</view>
        <view class="hero__step">
          <view class="hero__num hero__num--green">{{stableCount}}</view>
          <view class="hero__label">已稳定</view>
        </view>
      </view>
      <view class="hero__foot">
        <text wx:if="{{invalidatedCount > 0}}">另有 {{invalidatedCount}} 条已失效（内容撤回，不再进入掌握判断）</text>
        <text wx:else>没有失效记录，所有证据都在掌握链路里</text>
      </view>
    </view>

    <!-- 模块分布 -->
    <view class="section-head">
      <view class="section-title">各模块掌握分布</view>
      <view class="section-extra">{{modules.length}} 个模块</view>
    </view>

    <view wx:if="{{modules.length === 0}}" class="empty">
      <view class="empty__text">还没有掌握记录，先去完成一组训练</view>
    </view>

    <view wx:for="{{modules}}" wx:key="name" class="card mod">
      <view class="mod__head">
        <view class="mod__name">{{item.name}}</view>
        <view class="mod__total">{{item.totalQuestions}} 题</view>
      </view>
      <view class="mod__bar">
        <view wx:if="{{item.segStable > 0}}" class="mod__seg mod__seg--stable" style="width: {{item.segStable}}%"></view>
        <view wx:if="{{item.segDue > 0}}" class="mod__seg mod__seg--due" style="width: {{item.segDue}}%"></view>
        <view wx:if="{{item.segPending > 0}}" class="mod__seg mod__seg--pending" style="width: {{item.segPending}}%"></view>
        <view wx:if="{{item.segInvalidated > 0}}" class="mod__seg mod__seg--invalid" style="width: {{item.segInvalidated}}%"></view>
      </view>
      <view class="mod__legend">
        <view wx:if="{{item.stableCount > 0}}" class="mod__chip">
          <view class="mod__dot mod__dot--stable"></view>已稳定 {{item.stableCount}}
        </view>
        <view wx:if="{{item.dueCount > 0}}" class="mod__chip">
          <view class="mod__dot mod__dot--due"></view>待验证 {{item.dueCount}}
        </view>
        <view wx:if="{{item.pendingCount > 0}}" class="mod__chip">
          <view class="mod__dot mod__dot--pending"></view>待复盘 {{item.pendingCount}}
        </view>
        <view wx:if="{{item.invalidatedCount > 0}}" class="mod__chip">
          <view class="mod__dot mod__dot--invalid"></view>已失效 {{item.invalidatedCount}}
        </view>
      </view>
    </view>

    <!-- 失效记录 -->
    <block wx:if="{{invalidated.length > 0}}">
      <view class="section-head">
        <view class="section-title">失效记录</view>
        <view class="section-extra">{{invalidated.length}} 条</view>
      </view>
      <view class="card inv">
        <view wx:for="{{invalidated}}" wx:key="itemId" class="inv__row">
          <view class="inv__main">
            <view class="inv__title">{{item.module}} · {{item.questionCount}} 题</view>
            <view class="inv__meta">{{item.dateLabel}} · 内容已撤回</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{generatedAtLabel}}" class="gen">{{generatedAtLabel}}</view>
    <view class="foot-space"></view>
  </block>
</view>
