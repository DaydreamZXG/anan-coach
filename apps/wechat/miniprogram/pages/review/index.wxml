<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav__back" hover-class="is-pressed" bind:tap="onBack">‹</view>
    <view class="nav__text">
      <view class="nav__title">复盘中心</view>
      <view class="nav__sub">错题走完「复盘 → 验证 → 稳定」才算真正掌握</view>
    </view>
  </view>

  <view class="summary" wx:if="{{summary}}">
    <view class="summary__cell">
      <view class="summary__num summary__num--amber">{{summary.pendingReflectionCount}}</view>
      <view class="summary__label">待复盘</view>
    </view>
    <view class="summary__divider"></view>
    <view class="summary__cell">
      <view class="summary__num summary__num--cyan">{{summary.dueVerificationCount}}</view>
      <view class="summary__label">待验证</view>
    </view>
    <view class="summary__divider"></view>
    <view class="summary__cell">
      <view class="summary__num summary__num--green">{{summary.stableMasteryCount}}</view>
      <view class="summary__label">已稳定</view>
    </view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="bucket"
      class="tabs__item {{activeBucket === item.bucket ? 'tabs__item--on' : ''}}"
      data-bucket="{{item.bucket}}"
      bind:tap="onTab"
    >
      {{item.label}}<text class="tabs__count" wx:if="{{item.count > 0}}">{{item.count}}</text>
    </view>
  </view>

  <state-view wx:if="{{viewState === 'loading'}}" type="loading" text="正在拉取队列…" />
  <state-view
    wx:elif="{{viewState === 'error'}}"
    type="error"
    text="队列加载失败"
    buttonText="重试"
    bind:retry="onRetry"
  />

  <block wx:else>
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty__glyph">✓</view>
      <view class="empty__text">这一栏是空的，很好</view>
    </view>
    <view
      wx:for="{{items}}"
      wx:key="itemId"
      class="item"
      hover-class="is-pressed"
      data-bucket="{{item.bucket}}"
      data-plan-task-id="{{item.planTaskId}}"
      data-session-id="{{item.sessionId}}"
      data-review-id="{{item.reviewId}}"
      data-actionable="{{item.actionable}}"
      bind:tap="onItem"
    >
      <view class="item__main">
        <view class="item__title">{{item.module}} · {{item.questionCount}} 题</view>
        <view class="item__meta">{{item.timeLabel}}</view>
      </view>
      <view class="item__action {{item.actionable ? 'item__action--ready' : ''}}">
        {{item.actionable ? item.actionLabel : item.bucket === "stable_mastery" ? "已稳定" : "待生成"}}
      </view>
    </view>
  </block>
</view>
