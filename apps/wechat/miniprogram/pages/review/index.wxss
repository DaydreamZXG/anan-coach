.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

/* ── 顶部导航 ── */

.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 汇总 hero ── */

.summary {
  margin: 8rpx 32rpx 0;
  background: var(--grad-space);
  border-radius: var(--radius-xl);
  padding: 34rpx 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.summary__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary__num {
  font-size: 52rpx;
  font-weight: 800;
  color: #ffffff;
}

.summary__num--amber {
  color: #fbbf24;
}

.summary__num--cyan {
  color: #22d3ee;
}

.summary__num--green {
  color: #4ade80;
}

.summary__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.summary__divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ── 桶切换 ── */

.tabs {
  margin: 28rpx 32rpx 0;
  display: flex;
  gap: 12rpx;
}

.tabs__item {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  font-size: 26rpx;
  color: var(--ink-3);
  box-shadow: var(--shadow-soft);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tabs__item--on {
  background: var(--ink);
  color: #ffffff;
  font-weight: 700;
}

.tabs__count {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(91, 95, 244, 0.16);
  color: var(--indigo);
}

.tabs__item--on .tabs__count {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

/* ── 列表项 ── */

.item {
  margin: 20rpx 32rpx 0;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--shadow-soft);
}

.item__main {
  flex: 1;
  min-width: 0;
}

.item__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.item__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.item__action {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  background: rgba(16, 19, 27, 0.05);
}

.item__action--ready {
  background: var(--grad-main);
  color: #ffffff;
  font-weight: 700;
}

/* ── 空态 ── */

.empty {
  margin: 80rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty__glyph {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.12);
  color: #16a34a;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty__text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.is-pressed {
  opacity: 0.72;
  transform: scale(0.98);
}
