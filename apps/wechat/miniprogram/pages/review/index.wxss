.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.review { display: flex; flex-direction: column; min-height: 100vh; }

.r-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.r-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.r-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.r-progress { font-size: 28rpx; color: var(--ink-3); padding-right: 16rpx; }

.r-loading { padding: 120rpx 0; text-align: center; }

.r-anan {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.anan-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--warm);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.r-anan-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: #5c4a35; }

.r-body { flex: 1; min-height: 0; }
.r-card { display: flex; flex-direction: column; gap: 24rpx; }

.r-chips { display: flex; gap: 12rpx; }
.r-chip {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.r-chip-world { color: var(--ink-2); background: var(--bg); }

.r-card-title { font-size: 34rpx; font-weight: 700; color: var(--ink); }

.r-narrative {
  background: var(--bg);
  border-left: 6rpx solid var(--primary);
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
}
.r-narrative-text { font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }

.r-stem { font-size: 30rpx; line-height: 1.6; color: var(--ink); }

.r-options { display: flex; flex-direction: column; gap: 16rpx; }
.opt {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
}
.opt-on { border-color: var(--primary); background: var(--primary-soft); }
.opt-label { font-size: 28rpx; font-weight: 600; color: var(--primary); flex-shrink: 0; }
.opt-text { flex: 1; font-size: 28rpx; line-height: 1.5; color: var(--ink); }

.r-verdict {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed var(--line);
}
.r-stamp {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transform: rotate(-12deg);
}
.r-stamp.is-pass { border-color: var(--good); background: var(--good-soft); }
.r-stamp.is-fail { border-color: var(--danger); background: #fdecec; }
.r-stamp-char { font-size: 48rpx; font-weight: 700; }
.is-pass .r-stamp-char { color: var(--good); }
.is-fail .r-stamp-char { color: var(--danger); }
.r-verdict-line { flex: 1; font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }

.r-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.r-foot-btn { width: 100%; }

.r-done { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding-top: 96rpx; }
.r-done-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  border: 8rpx solid var(--primary);
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}
.r-done-num { font-size: 80rpx; font-weight: 700; color: var(--primary); line-height: 1.9; }
.r-done-unit { font-size: 32rpx; color: var(--primary); }
.r-done-btn { margin-top: 32rpx; width: 100%; }

.r-empty { display: flex; flex-direction: column; align-items: center; gap: 32rpx; padding-top: 160rpx; }

.demo-tip { text-align: center; padding-bottom: 16rpx; }
