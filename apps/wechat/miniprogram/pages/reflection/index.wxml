<task-shell
  title="真实作答复盘"
  modeLabel="岸岸 · 用户原话"
  current="{{phase === 'reflection' ? 1 : phase === 'completed' ? 3 : 2}}"
  total="3"
  elapsedLabel="--:--"
  syncLabel="{{pendingMessage || (phase === 'completed' ? '证据已结算' : '等待你的确认')}}"
  answerSheetAvailable="{{false}}"
  toolsAvailable="{{false}}"
  footerAvailable="{{false}}"
  bindexit="exit"
>
  <view wx:if="{{status === 'loading'}}" class="page-state">
    <state-view state="loading" title="正在恢复复盘版本" description="用户原话、错因决定与今日任务保持同一条证据链。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" actionText="按原命令重试" bindaction="retry" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="capability-state card">
    <view class="capability-mark">真实学习档案门禁</view>
    <view class="capability-title">{{errorTitle}}</view>
    <view class="capability-copy">{{errorMessage}}</view>
    <button wx:if="{{showLoginAction}}" class="secondary-button capability-action" bindtap="goLogin">重新登录</button>
  </view>

  <view wx:elif="{{status === 'ready'}}" class="reflection-workspace">
    <view class="reflection-hero">
      <view class="hero-orbit hero-orbit--one"></view>
      <view class="hero-orbit hero-orbit--two"></view>
      <view class="hero-eyebrow">复盘不是认错，是让岸岸真正认识你</view>
      <view class="hero-title">先保留你当时真实的判断</view>
      <view class="hero-copy">不会把一次答对直接算成掌握，岸岸也不会用猜测替代你的原话。</view>
      <view wx:if="{{result}}" class="hero-score"><text class="hero-score__value">{{result.correctCount}}</text> / {{result.totalCount}} 题答对</view>
    </view>

    <view wx:if="{{result && result.availability === 'legacy_result_unavailable'}}" class="legacy-result-notice card">
      <view class="legacy-result-title">历史结果只读</view>
      <view class="legacy-result-copy">这次作答没有冻结的逐题事实拆分，因此不提供“方法正确但计算错误”选择，也不追溯补算。</view>
      <view class="legacy-result-code type-data">legacy_result_unavailable</view>
    </view>

    <view wx:if="{{hasPendingWrite}}" class="pending-write card">
      <view class="pending-title">上次提交结果还不能确认</view>
      <view class="pending-copy">{{pendingMessage}}</view>
      <button class="secondary-button" bindtap="retry">按原命令重试</button>
    </view>

    <block wx:if="{{phase === 'reflection'}}">
      <view class="section-heading">
        <view>
          <view class="section-title">你当时是怎么想的？</view>
          <view class="section-meta">必填 · 原话进入个人学习档案</view>
        </view>
      </view>
      <textarea class="thought-input" value="{{rawText}}" maxlength="4000" disabled="{{interactionLocked}}" placeholder="例如：我先排除了 A、D，但把题目问的‘不符合’看成了‘符合’……" bindinput="inputRawText"></textarea>

      <view class="voice-card card">
        <view class="voice-header">
          <view>
            <view class="voice-title">补充语音复盘 <text class="voice-title__optional">选填</text></view>
            <view class="voice-copy">最多 3 段，单段最长 3 分钟，总计不超过 15MB。</view>
          </view>
          <view class="voice-count">{{voiceSummary.segmentCountLabel}}</view>
        </view>

        <view wx:if="{{recordPermission === 'denied'}}" class="voice-permission">
          <view class="voice-permission-title">麦克风权限已被拒绝</view>
          <view class="voice-permission-copy">岸岸不会伪造已录制内容。需要你在设置中明确开启后才能继续。</view>
          <button class="voice-setting" disabled="{{interactionLocked || voiceBusy}}" bindtap="openRecordPermission">去设置开启</button>
        </view>

        <button wx:if="{{isRecording}}" class="record-button record-button--active" bindtap="stopVoiceRecording">
          <view class="record-dot"></view>
          结束录制
        </button>
        <button wx:else class="record-button" disabled="{{interactionLocked || voiceBusy || !voiceSummary.canRecord}}" bindtap="startVoiceRecording">
          <view class="record-dot"></view>
          {{voiceSummary.canRecord ? '开始录一段' : '已达 3 段上限'}}
        </button>

        <view wx:if="{{voiceSegments.length > 0}}" class="voice-list">
          <view wx:for="{{voiceSegments}}" wx:key="segmentId" class="voice-item">
            <view class="voice-item-main">
              <button class="voice-play" data-id="{{item.segmentId}}" disabled="{{voiceBusy}}" bindtap="playVoice">{{playingVoiceId === item.segmentId ? '停' : '听'}}</button>
              <view class="voice-item-copy">
                <view class="voice-item-title">{{item.sequenceLabel}} · {{item.durationLabel}} · {{item.sizeLabel}}</view>
                <view class="voice-state voice-state--{{item.stateTone}}">{{item.stateLabel}}</view>
              </view>
            </view>
            <view wx:if="{{item.failureMessage}}" class="voice-failure">{{item.failureMessage}}</view>
            <view class="voice-actions">
              <button class="voice-action-button" data-id="{{item.segmentId}}" disabled="{{interactionLocked || voiceBusy || !item.canOperate}}" bindtap="rerecordVoice">重录</button>
              <button class="voice-action-button" data-id="{{item.segmentId}}" disabled="{{interactionLocked || voiceBusy || !item.canOperate}}" bindtap="deleteVoice">删除</button>
            </view>
          </view>
        </view>

        <view class="voice-summary">当前草稿 {{voiceSummary.totalSizeLabel}}</view>
        <view wx:if="{{voiceMessage}}" class="voice-message">{{voiceMessage}}</view>
        <button wx:if="{{voiceSegments.length > 0 && voiceSummary.hasUnready}}" class="voice-upload" loading="{{voiceBusy}}" disabled="{{interactionLocked || voiceBusy || isRecording}}" bindtap="uploadVoiceSegments">
          {{voiceBusy ? '正在上传并等待检查' : '上传并完成安全检查'}}
        </button>
      </view>

      <view class="section-heading compact-heading">
        <view>
          <view class="section-title">给这次思路打标签</view>
          <view class="section-meta">至少选择 1 项，可多选</view>
        </view>
      </view>
      <view class="tag-grid">
        <button wx:for="{{tagOptions}}" wx:key="code" class="tag-chip {{item.selected ? 'tag-chip--active' : ''}}" data-code="{{item.code}}" disabled="{{interactionLocked}}" bindtap="toggleTag">{{item.label}}</button>
      </view>

      <view wx:if="{{interpretationOptions.length > 0}}" class="interpretation-card card">
        <view class="interpretation-title">哪些错题是“方法正确，但计算错了”？</view>
        <view class="interpretation-copy">选填，最多 3 题。这是逐题事实，不会从“计算失误”标签自动推断。</view>
        <button
          wx:for="{{interpretationOptions}}"
          wx:key="questionId"
          class="interpretation-item {{item.selected ? 'interpretation-item--selected' : ''}}"
          data-questionid="{{item.questionId}}"
          disabled="{{interactionLocked}}"
          bindtap="toggleMethodInterpretation"
        >
          <view class="interpretation-check">{{item.selected ? '已选' : '选择'}}</view>
          <view class="interpretation-body">
            <view class="interpretation-position">{{item.positionLabel}}</view>
            <view class="interpretation-answer">{{item.answerLabel}}</view>
          </view>
        </button>
      </view>

      <view class="detail-card card">
        <view class="field-label">下次准备怎么做 <text class="field-label__optional">选填</text></view>
        <textarea class="detail-input" value="{{strategyNote}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="写下一个具体动作，例如：先圈题目问法，再看选项。" bindinput="inputStrategyNote"></textarea>
        <view class="field-label">仍然没想通的点 <text class="field-label__optional">选填</text></view>
        <textarea class="detail-input" value="{{doubtNote}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="保留疑问，后续可交给岸岸继续跟进。" bindinput="inputDoubtNote"></textarea>
      </view>
      <button class="primary-button main-action" disabled="{{interactionLocked || voiceBusy || isRecording}}" bindtap="submitReflection">保存原话复盘</button>
    </block>

    <block wx:elif="{{phase === 'cause_processing'}}">
      <view class="cause-state card">
        <view class="boundary-icon">岸</view>
        <view class="boundary-body">
          <view class="boundary-title">{{causeCandidate.stateLabel}}</view>
          <view class="boundary-copy">{{causeCandidate.stateDescription}}</view>
          <view class="boundary-meta">复盘原话已保存 · 不会伪造已确认错因</view>
        </view>
      </view>
      <button class="secondary-button main-action" disabled="{{interactionLocked}}" bindtap="refreshCauseCandidate">立即刷新证据状态</button>
    </block>

    <block wx:elif="{{phase === 'cause_followup'}}">
      <view class="cause-state card">
        <view class="boundary-icon">岸</view>
        <view class="boundary-body">
          <view class="boundary-title">{{causeCandidate.stateLabel}}</view>
          <view class="boundary-copy">{{causeCandidate.stateDescription}}</view>
          <view class="boundary-meta">{{causeCandidate.candidateVersionLabel}}</view>
        </view>
      </view>
      <view class="followup-card card">
        <view class="followup-label">岸岸追问</view>
        <view class="followup-question">{{causeCandidate.question}}</view>
        <textarea class="cause-input" value="{{followupAnswer}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="按当时真实想法回答，不需要迎合候选。" bindinput="inputFollowupAnswer"></textarea>
        <button class="primary-button main-action" disabled="{{interactionLocked}}" bindtap="submitCauseFollowup">提交追问回答</button>
      </view>
    </block>

    <block wx:elif="{{phase === 'cause_decision' || phase === 'cause_insufficient' || phase === 'cause_terminated'}}">
      <view class="cause-state card">
        <view class="boundary-icon">岸</view>
        <view class="boundary-body">
          <view class="boundary-title">{{causeCandidate.stateLabel}}</view>
          <view class="boundary-copy">{{causeCandidate.stateDescription}}</view>
          <view class="boundary-meta">{{causeCandidate.candidateVersionLabel}}</view>
        </view>
      </view>

      <view wx:if="{{causeCandidate.summary || causeCandidate.explanation || causeCandidate.improvement}}" class="candidate-card card">
        <view wx:if="{{causeCandidate.summary}}" class="candidate-section">
          <view class="candidate-label">候选错因</view>
          <view class="candidate-copy">{{causeCandidate.summary}}</view>
        </view>
        <view wx:if="{{causeCandidate.explanation}}" class="candidate-section">
          <view class="candidate-label">证据说明</view>
          <view class="candidate-copy">{{causeCandidate.explanation}}</view>
        </view>
        <view wx:if="{{causeCandidate.improvement}}" class="candidate-section">
          <view class="candidate-label">改进动作</view>
          <view class="candidate-copy">{{causeCandidate.improvement}}</view>
        </view>
        <view wx:if="{{causeCandidate.rationale}}" class="candidate-section">
          <view class="candidate-label">推理依据</view>
          <view class="candidate-copy">{{causeCandidate.rationale}}</view>
        </view>
      </view>

      <view wx:if="{{causeCandidate.missingEvidence.length > 0}}" class="evidence-card card">
        <view class="candidate-label">缺失证据</view>
        <view wx:for="{{causeCandidate.missingEvidence}}" wx:key="*this" class="evidence-line">· {{item}}</view>
      </view>
      <view wx:if="{{causeCandidate.limitations.length > 0}}" class="evidence-card card">
        <view class="candidate-label">当前限制</view>
        <view wx:for="{{causeCandidate.limitations}}" wx:key="*this" class="evidence-line">· {{item}}</view>
      </view>

      <view wx:if="{{causeCandidate.canDecide}}" class="section-heading">
        <view>
          <view class="section-title">错因决定权留给你</view>
          <view class="section-meta">每个决定都会绑定当前候选版本</view>
        </view>
      </view>
      <button wx:if="{{causeCandidate.canConfirm}}" class="primary-button main-action" disabled="{{interactionLocked}}" bindtap="confirmCause">确认这个错因</button>
      <button wx:if="{{causeCandidate.canDecide}}" class="reject-cause" disabled="{{interactionLocked}}" bindtap="rejectCause">否定候选，不确认错因</button>
      <textarea wx:if="{{causeCandidate.canDecide}}" class="cause-input" value="{{replacementCause}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="也可以用一句话写下你认可的错因。" bindinput="inputReplacementCause"></textarea>
      <button wx:if="{{causeCandidate.canDecide}}" class="secondary-button main-action" disabled="{{interactionLocked}}" bindtap="replaceCause">采用我补充的错因</button>
      <button wx:if="{{causeCandidate.canDecide}}" class="defer-cause" disabled="{{interactionLocked}}" bindtap="deferCause">稍后处理，保留当前证据</button>
      <view wx:else class="legacy-cause-readonly card">这是没有可绑定候选版本的历史状态，当前仅供查看，不会发送旧版跳过命令。</view>
    </block>

    <view wx:else class="completed-card card">
      <view class="completed-mark">证据链完成</view>
      <view class="completed-title">这次作答与复盘已经结算</view>
      <view class="completed-copy">今日计划已按真实完成证据重排；本次记录不等于掌握，也不会虚构能力提升。</view>
      <button class="primary-button main-action" bindtap="returnToday">查看新的今日计划</button>
    </view>
  </view>
</task-shell>
