<view class="s9-screen reflection-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="{{phase === 'summary' ? '本次训练总结' : phase === 'completed' ? '这轮复盘记下了' : phase === 'reflection' ? '单题错因复盘' + (reviewItems.length ? ' · ' + (currentReviewIndex + 1) + '/' + reviewItems.length : '') : '岸岸判断'}}"
    back-behavior="emit"
    bind:back="handleBack"
  />

  <view wx:if="{{status === 'loading'}}" class="reflection-state">
    <state-view state="loading" title="正在恢复你的复盘" description="别急，正在把你的作答、原话和错因对上号。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="reflection-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" action-text="重新读取" bind:action="retry" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="reflection-state">
    <state-view state="blocked" title="{{errorTitle}}" description="{{errorMessage}}" />
    <button hover-class="item--hover" wx:if="{{showLoginAction}}" class="reflection-primary tap-tactile" bindtap="goLogin">重新登录</button>
  </view>

  <block wx:elif="{{status === 'ready'}}">
    <view wx:if="{{hasPendingWrite}}" class="pending-write">
      <view class="pending-write__title">上次提交的结果还没确认</view>
      <view class="pending-write__copy">{{pendingMessage}}</view>
      <button hover-class="item--hover" class="pending-write__action" bindtap="retry">继续确认上次提交</button>
    </view>

    <view wx:if="{{phase === 'summary' && result}}" class="summary-content">
      <view class="summary-intro">
        <view class="summary-title">这组做完了</view>
        <!-- Figma 13:20：错题数用真实数据填充。 -->
        <view wx:if="{{result.totalCount - result.correctCount > 0}}" class="summary-copy">{{result.correctCount}}/{{result.totalCount}}。让你上岸的从来是错题——先把丢掉的 {{result.totalCount - result.correctCount}} 题问明白。</view>
        <view wx:else class="summary-copy">比起 {{result.correctCount}}/{{result.totalCount}}，把这组的作答过程留下来才更要紧。</view>
      </view>

      <view class="summary-card">
        <view class="summary-metrics">
          <view wx:for="{{result.metrics}}" wx:key="code" class="summary-metric summary-metric--{{item.tone}}">
            <view class="summary-metric__value type-data">{{item.value}}</view>
            <view class="summary-metric__label">{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{result.confidenceCalibration.length}}" class="summary-confidence">
          <view class="summary-confidence__title">信心准不准</view>
          <view class="summary-confidence__list">
            <view wx:for="{{result.confidenceCalibration}}" wx:key="code" class="summary-confidence__row">
              <view class="summary-confidence__label">
                <view class="summary-confidence__dot summary-confidence__dot--{{item.tone}}"></view>
                <text>{{item.label}}</text>
              </view>
              <view class="summary-confidence__value type-data">{{item.value}} 题</view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{result.group}}" class="summary-insight">
        <view class="summary-insight__head"><text class="summary-insight__spark">✦</text><text>岸岸结论</text></view>
        <view class="summary-insight__title">{{result.group.outcomeLabel}}</view>
        <view class="summary-insight__copy">{{result.group.description}}</view>
        <view wx:if="{{summaryBasisOpen}}" class="summary-insight__basis">
          <view wx:for="{{result.group.counts}}" wx:key="code" class="summary-insight__basis-row">
            <text>{{item.label}}</text><text class="type-data">{{item.value}}</text>
          </view>
          <view class="summary-insight__next">{{result.group.nextActionLabel}}</view>
          <view wx:if="{{result.verification}}" class="summary-insight__verification">{{result.verification.stageLabel}} · {{result.verification.evidenceLabel}} · {{result.verification.evidenceDescription}}</view>
        </view>
        <button hover-class="item--hover" class="summary-insight__toggle" bindtap="toggleSummaryBasis">{{summaryBasisOpen ? '收起依据' : '看看依据'}}⌄</button>
      </view>
      <view wx:elif="{{result.availability === 'legacy_result_unavailable'}}" class="summary-legacy">
        <view class="summary-legacy__title">这是旧版的结果</view>
        <view class="summary-legacy__copy">只保留当时的成绩，不再重新推测缺失的作答过程。</view>
      </view>

      <!-- 题号一览按客观结果分色：答错红、猜对/计算失误橙、稳定答对绿、证据未记录灰。 -->
      <view wx:if="{{result.items.length}}" class="summary-question-strip">
        <view wx:for="{{result.items}}" wx:key="questionId" class="summary-question-strip__item">
          <view class="summary-question-dot summary-question-dot--{{item.resultTone}}">{{item.positionNumber}}</view>
          <view class="summary-question-label summary-question-label--{{item.resultTone}}">{{item.resultLabel}}</view>
        </view>
      </view>

      <view class="summary-actions">
        <view class="summary-actions__row">
          <button hover-class="item--hover" class="summary-secondary" bindtap="exit">稍后复盘</button>
          <button hover-class="item--hover" class="summary-anan" bindtap="askAnanAboutGroup">带着本组问岸岸</button>
        </view>
      </view>
      <view class="summary-boundary">这组新增了 {{result.totalCount}} 条真实作答。一次练习成不了稳定水平，做完复测再确认也不迟。</view>
      <view class="reflection-bottom-spacer"></view>
    </view>

    <view
      wx:elif="{{phase === 'reflection'}}"
      class="review-content"
      bindtouchstart="onReviewTouchStart"
      bindtouchmove="onReviewTouchMove"
      bindtouchend="onReviewTouchEnd"
      bindtouchcancel="onReviewTouchEnd"
    >
      <view wx:if="{{result && result.availability === 'legacy_result_unavailable'}}" class="legacy-notice">
        <view class="legacy-notice__title">这是旧版的结果</view>
        <view class="legacy-notice__copy">没有逐题过程记录，只保留原始成绩，不再追溯当时的用时、信心或计算过程。</view>
      </view>

      <view wx:if="{{reviewItems.length > 1}}" class="review-tabs">
        <button hover-class="item--hover"
          wx:for="{{reviewItems}}"
          wx:key="questionId"
          class="control-center review-tab {{index === currentReviewIndex ? 'review-tab--active' : ''}}"
          data-index="{{index}}"
          bindtap="selectReviewItem"
        >{{item.positionNumber}}</button>
      </view>

      <!-- Figma 14:2：共享材料收起为入口条，点开进入沉浸阅读，不在页内堆满长材料。 -->
      <button
        wx:if="{{activeReviewItem && activeReviewItem.material}}"
        hover-class="item--hover"
        class="review-material-entry"
        bindtap="openReviewMaterial"
      >
        <view class="review-material-entry__icon" aria-hidden="true">≡</view>
        <text class="review-material-entry__label">共享材料 · 点击展开</text>
        <view class="review-material-entry__chevron" aria-hidden="true"></view>
      </button>

      <view wx:if="{{activeReviewItem && activeReviewItem.material && materialReaderState.mode !== 'question_first'}}" class="review-material-reader">
        <material-reader
          title="{{activeReviewItem.material.title || '共享材料'}}"
          subtitle="{{activeReviewItem.positionLabel}}"
          returnLabel="回到复盘"
          blocks="{{activeReviewItem.material.content || emptyRichContentBlocks}}"
          anchors="{{activeReviewItem.material.anchors || emptyContentAnchors}}"
          state="{{materialReaderState}}"
          bindstatechange="updateMaterialReader"
        />
      </view>

      <view wx:if="{{activeReviewItem}}" class="question-review">
        <view class="question-review__stem">
          <content-renderer
            blocks="{{activeReviewItem.stemContent || emptyRichContentBlocks}}"
            zoom="{{1}}"
            preferences="{{displayPreferences}}"
          />
        </view>
        <!-- Figma 14:36/14:44：红绿答案卡。 -->
        <view class="answer-compare {{activeReviewItem.selectedLabel === activeReviewItem.correctLabel ? 'answer-compare--right' : 'answer-compare--wrong'}}">
          <view class="answer-compare__line">
            <text class="answer-compare__label">你的答案</text>
            <view class="answer-compare__content">
              <text class="answer-compare__value">{{activeReviewItem.selectedLabel}}</text>
              <text class="answer-compare__text">{{activeReviewItem.selectedAnswerText}}</text>
            </view>
          </view>
          <view wx:if="{{activeReviewItem.selectedLabel === activeReviewItem.correctLabel}}" class="answer-compare__mark answer-compare__mark--right">✓</view>
          <view wx:else class="answer-compare__mark answer-compare__mark--wrong">×</view>
        </view>
        <view class="answer-compare answer-compare--right">
          <view class="answer-compare__line">
            <text class="answer-compare__label">正确答案</text>
            <view class="answer-compare__content">
              <text class="answer-compare__value">{{activeReviewItem.correctLabel}}</text>
              <text class="answer-compare__text">{{activeReviewItem.correctAnswerText}}</text>
            </view>
          </view>
          <view class="answer-compare__mark answer-compare__mark--right">✓</view>
        </view>
        <view class="answer-facts">
          <view wx:for="{{activeReviewItem.factChips}}" wx:key="code" class="answer-fact answer-fact--{{item.tone}}">{{item.label}}</view>
        </view>
      </view>

      <!-- Figma 14:70：岸岸结构化解析，层级：正确结论 → 最短解题路径 → 你的具体错点。 -->
      <view wx:if="{{activeReviewItem}}" class="structured-review">
        <view class="structured-review__head"><text class="structured-review__spark">✦</text><text>岸岸讲解</text></view>
        <view class="structured-review__section structured-review__section--answer">
          <view class="structured-review__label">正确结论</view>
          <view class="structured-review__answer">{{activeReviewItem.correctLabel}} · {{activeReviewItem.correctAnswerText}}</view>
        </view>
        <view class="structured-review__section">
          <view class="structured-review__label">最短解题路径</view>
          <view class="structured-review__copy">{{activeReviewItem.explanation}}</view>
          <view class="structured-review__source">讲解来源 · {{activeReviewItem.explanationSource}}</view>
        </view>
        <view class="structured-review__section">
          <view class="structured-review__label">你的作答对照</view>
          <view class="structured-review__copy">你选了 {{activeReviewItem.selectedLabel}} · {{activeReviewItem.selectedAnswerText}}</view>
        </view>
        <view wx:if="{{activeReviewItem.timingExceeded}}" class="structured-review__errorpoint">
          <view class="structured-review__errorpoint-title">你的具体错点</view>
          <view class="structured-review__errorpoint-copy">这题超过建议用时了；这里只记下事实，不自动把“超时”当成错因。</view>
        </view>

        <!-- Figma 75:2/78:2 的两个真实入口：只有会话真的留下轨迹时才出现。 -->
        <view wx:if="{{activeReviewItem.trajectoryAvailable}}" class="structured-review__trajectory">
          <button hover-class="item--hover" class="structured-review__trajectory-link" bindtap="openReplay">回放我当时的作答</button>
          <button hover-class="item--hover" class="structured-review__trajectory-link" bindtap="openActionAnalysis">岸岸看到的动作</button>
        </view>
      </view>

      <view class="reason-card">
        <view class="reason-card__head">
          <view class="reason-card__title">你也可以补充</view>
          <button hover-class="item--hover" class="reason-card__read" disabled="{{interactionLocked || speechBusy || !rawText}}" bindtap="readRawText">{{speechPlaying ? '朗读中' : '朗读文字'}}</button>
        </view>
        <view class="reason-card__copy">标签和文字都选填。不填也没关系，岸岸会先用你的用时、改选、排除、草稿和作答来判断。</view>
        <view class="tag-grid">
          <button hover-class="item--hover"
            wx:for="{{tagOptions}}"
            wx:key="code"
            class="control-center tag-chip {{item.selected ? 'tag-chip--active' : ''}}"
            data-code="{{item.code}}"
            disabled="{{interactionLocked}}"
            bindtap="toggleTag"
          >{{item.label}}</button>
        </view>
        <textarea
          cursor-spacing="24"
          class="reason-textarea"
          value="{{rawText}}"
          maxlength="4000"
          disabled="{{interactionLocked}}"
          placeholder="选填：写下当时真实的判断，例如我把“不符合”看成了“符合”"
          bindinput="inputRawText"
        />
      </view>

      <view wx:if="{{interpretationOptions.length}}" class="method-card">
        <view class="method-card__title">哪些题是“方法正确，但计算错了”？</view>
        <view class="method-card__copy">这道题只记事实，不会因为选了“计算失误”就自动认定。</view>
        <button hover-class="item--hover"
          wx:for="{{interpretationOptions}}"
          wx:key="questionId"
          class="method-option {{item.selected ? 'method-option--selected' : ''}}"
          data-questionid="{{item.questionId}}"
          disabled="{{interactionLocked}}"
          bindtap="toggleMethodInterpretation"
        >
          <view>
            <view class="method-option__position">{{item.positionLabel}}</view>
            <view class="method-option__answer">{{item.answerLabel}}</view>
          </view>
          <view class="method-option__state">{{item.selected ? '已选' : '选择'}}</view>
        </button>
      </view>

      <button hover-class="item--hover" class="more-evidence-toggle" bindtap="toggleMoreEvidence">
        <text>补语音、写下步改进或没想通的点</text>
        <text>{{moreEvidenceOpen ? '收起' : '展开'}}⌄</text>
      </button>

      <view wx:if="{{moreEvidenceOpen}}" class="more-evidence-panel">
        <view class="voice-head">
          <view>
            <view class="voice-head__title">语音记录 <text class="voice-head__optional">选填</text></view>
            <view class="voice-head__copy">最多 3 段，单段最长 60 秒；录完可转成文字并继续修改。</view>
          </view>
          <view class="voice-head__count">{{voiceSummary.segmentCountLabel}}</view>
        </view>

        <view wx:if="{{recordPermission === 'denied'}}" class="voice-permission">
          <view class="voice-permission__title">需要麦克风权限</view>
          <view class="voice-permission__copy">在系统设置里打开权限，才能录语音。</view>
          <button hover-class="item--hover" class="voice-permission__action" bindtap="openRecordPermission">去设置</button>
        </view>

        <button hover-class="item--hover" wx:if="{{isRecording}}" class="record-button record-button--active" bindtap="stopVoiceRecording"><text class="record-dot"></text>结束录制</button>
        <button hover-class="item--hover" wx:else class="record-button" disabled="{{interactionLocked || voiceBusy || !voiceSummary.canRecord}}" bindtap="startVoiceRecording"><text class="record-dot"></text>{{voiceSummary.canRecord ? '开始录一段' : '已达 3 段上限'}}</button>

        <view wx:for="{{voiceSegments}}" wx:key="segmentId" class="voice-item">
          <button hover-class="item--hover" class="voice-item__play" data-id="{{item.segmentId}}" disabled="{{voiceBusy}}" bindtap="playVoice">{{playingVoiceId === item.segmentId ? '停' : '听'}}</button>
          <view class="voice-item__main">
            <view class="voice-item__title">{{item.sequenceLabel}} · {{item.durationLabel}} · {{item.sizeLabel}}</view>
            <view class="voice-item__state voice-item__state--{{item.stateTone}}">{{item.stateLabel}}</view>
            <view wx:if="{{item.failureMessage}}" class="voice-item__failure">{{item.failureMessage}}</view>
          </view>
          <view class="voice-item__actions">
            <button hover-class="item--hover" class="control-center voice-item__action voice-item__action--primary" data-id="{{item.segmentId}}" disabled="{{interactionLocked || voiceBusy || speechBusy || !item.canOperate}}" bindtap="transcribeVoice">转文字</button>
            <button hover-class="item--hover" class="control-center voice-item__action" data-id="{{item.segmentId}}" disabled="{{interactionLocked || voiceBusy || !item.canOperate}}" bindtap="rerecordVoice">重录</button>
            <button hover-class="item--hover" class="control-center voice-item__action" data-id="{{item.segmentId}}" disabled="{{interactionLocked || voiceBusy || !item.canOperate}}" bindtap="deleteVoice">删除</button>
          </view>
        </view>
        <view class="voice-summary">{{voiceSummary.totalSizeLabel}}</view>
        <view wx:if="{{voiceMessage}}" class="voice-message">{{voiceMessage}}</view>
        <button hover-class="item--hover" wx:if="{{voiceSegments.length && voiceSummary.hasUnready}}" class="control-center voice-upload" loading="{{voiceBusy}}" disabled="{{interactionLocked || voiceBusy || isRecording}}" bindtap="uploadVoiceSegments">上传并检查录音</button>

        <view class="evidence-field">
          <view class="evidence-field__label">下次准备怎么做 <text class="evidence-field__optional">选填</text></view>
          <textarea cursor-spacing="24" class="evidence-field__input" value="{{strategyNote}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="写下一个具体动作" bindinput="inputStrategyNote" />
        </view>
        <view class="evidence-field">
          <view class="evidence-field__label">仍然没想通的点 <text class="evidence-field__optional">选填</text></view>
          <textarea cursor-spacing="24" class="evidence-field__input" value="{{doubtNote}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="保留疑问，后续继续跟进" bindinput="inputDoubtNote" />
        </view>
      </view>

      <view class="reflection-boundary">你只要留下真实的作答，岸岸先做判断；有不对的地方咱们再改。</view>
      <view class="reflection-bottom-spacer"></view>
    </view>

    <view wx:elif="{{phase === 'cause_processing'}}" class="cause-processing">
      <view class="cause-spinner"></view>
      <view class="cause-processing__title">{{causeCandidate.stateLabel}}</view>
      <view class="cause-processing__copy">{{causeCandidate.stateDescription}}</view>
      <view class="cause-processing__boundary">你的作答已经存好，岸岸正在形成初步判断，别走开。</view>
      <button hover-class="item--hover" class="reflection-secondary" disabled="{{interactionLocked}}" bindtap="refreshCauseCandidate">重新检查一次</button>
    </view>

    <view wx:elif="{{phase === 'cause_followup'}}" class="cause-content">
      <view class="cause-intro">
        <view class="cause-intro__mark">岸</view>
        <view>
          <view class="cause-intro__title">{{causeCandidate.stateLabel}}</view>
          <view class="cause-intro__copy">{{causeCandidate.stateDescription}}</view>
        </view>
      </view>
      <view class="followup-card">
        <view class="followup-card__label">岸岸追问</view>
        <view class="followup-card__question">{{causeCandidate.question}}</view>
        <textarea cursor-spacing="24" class="cause-textarea" value="{{followupAnswer}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="按当时真实想法回答" bindinput="inputFollowupAnswer" />
        <button hover-class="item--hover" class="reflection-primary tap-tactile" disabled="{{interactionLocked}}" bindtap="submitCauseFollowup">提交追问回答</button>
      </view>
    </view>

    <view wx:elif="{{phase === 'cause_decision' || phase === 'cause_insufficient' || phase === 'cause_terminated'}}" class="cause-content">
      <view class="cause-intro">
        <view class="cause-intro__mark">岸</view>
        <view>
          <view class="cause-intro__title">{{causeCandidate.stateLabel}}</view>
          <view class="cause-intro__copy">{{causeCandidate.stateDescription}}</view>
        </view>
      </view>

      <view wx:if="{{causeCandidate.summary || causeCandidate.explanation || causeCandidate.improvement}}" class="candidate-card">
        <view wx:if="{{causeCandidate.summary}}" class="candidate-section">
          <view class="candidate-section__label">可能的错因</view>
          <view class="candidate-section__copy">{{causeCandidate.summary}}</view>
        </view>
        <view wx:if="{{causeCandidate.explanation}}" class="candidate-section">
          <view class="candidate-section__label">判断依据</view>
          <view class="candidate-section__copy">{{causeCandidate.explanation}}</view>
        </view>
        <view wx:if="{{causeCandidate.improvement}}" class="candidate-section">
          <view class="candidate-section__label">下次动作</view>
          <view class="candidate-section__copy">{{causeCandidate.improvement}}</view>
        </view>
        <view wx:if="{{causeCandidate.rationale}}" class="candidate-section">
          <view class="candidate-section__label">判断理由</view>
          <view class="candidate-section__copy">{{causeCandidate.rationale}}</view>
        </view>
      </view>

      <!-- 逐题候选错因：错题卡 + 灰底 chip，纯展示不加交互；证据不足显式标注。 -->
      <view wx:if="{{causeCandidate.questionCandidates.length}}" class="question-cause-card">
        <view class="question-cause-card__title">每题的候选错因</view>
        <view class="question-cause-card__copy">按题给出岸岸的判断；可以直接继续，也可以在下面纠正。</view>
        <view wx:for="{{causeCandidate.questionCandidates}}" wx:key="questionId" class="question-cause-item">
          <view class="question-cause-item__head">
            <text class="question-cause-item__position">{{item.positionLabel}}</text>
            <view class="question-cause-chip {{item.status === 'evidence_insufficient' ? 'question-cause-chip--insufficient' : ''}}">{{item.causeLabel}}</view>
            <view wx:if="{{item.confidenceLabel}}" class="question-cause-chip question-cause-chip--meta">{{item.confidenceLabel}}</view>
          </view>
          <view wx:if="{{item.rationale}}" class="question-cause-item__rationale">{{item.rationale}}</view>
        </view>
      </view>

      <view wx:if="{{causeCandidate.missingEvidence.length || causeCandidate.limitations.length}}" class="candidate-limitations">
        <view wx:for="{{causeCandidate.missingEvidence}}" wx:key="*this" class="candidate-limitations__line">· {{item}}</view>
        <view wx:for="{{causeCandidate.limitations}}" wx:key="*this" class="candidate-limitations__line">· {{item}}</view>
      </view>

      <block wx:if="{{causeCandidate.canDecide}}">
        <button hover-class="item--hover" wx:if="{{causeCandidate.canConfirm}}" class="reflection-primary tap-tactile" disabled="{{interactionLocked}}" bindtap="confirmCause">按岸岸的判断继续</button>
        <button hover-class="item--hover" class="reflection-secondary" disabled="{{interactionLocked}}" bindtap="rejectCause">这不是我的错因</button>
        <!-- 改写错因的可选结构化归类：单选 chip，可不选，再点一次取消。 -->
        <view class="cause-code-hint">如果换成你的说法，它更像下面哪一类？选一个可以帮你以后归类，也可以不选。</view>
        <view class="tag-grid cause-code-grid">
          <button hover-class="item--hover"
            wx:for="{{replacementCodeOptions}}"
            wx:key="code"
            class="control-center tag-chip {{item.selected ? 'tag-chip--active' : ''}}"
            data-code="{{item.code}}"
            disabled="{{interactionLocked}}"
            bindtap="selectReplacementCode"
          >{{item.label}}</button>
        </view>
        <textarea cursor-spacing="24" class="cause-textarea" value="{{replacementCause}}" maxlength="2000" disabled="{{interactionLocked}}" placeholder="也可以写下你认可的错因" bindinput="inputReplacementCause" />
        <button hover-class="item--hover" class="reflection-secondary" disabled="{{interactionLocked}}" bindtap="replaceCause">采用我补充的错因</button>
        <button hover-class="item--hover" class="control-center cause-later" disabled="{{interactionLocked}}" bindtap="deferCause">稍后处理</button>
      </block>
      <view wx:else class="legacy-notice">这是一条旧记录，暂时没有可以确认的候选错因。</view>
      <view class="reflection-bottom-spacer"></view>
    </view>

    <!-- Figma 15:2：顶部空白已压缩（15:8 paddingTop=28），完成态整体上移。 -->
    <view wx:else class="completed-screen">
      <view class="completed-icon-pill check-pop">
        <view class="completed-icon">✓</view>
      </view>
      <view class="completed-title">{{completionClosure.statusTitle}}</view>
      <view class="completed-copy">{{completionClosure.statusDescription}}</view>
      <view wx:if="{{completionClosure.acceptedCorrection}}" class="completed-correction-card">
        <view class="completed-correction-step">
          <view class="completed-correction-step__marker">1</view>
          <view class="completed-correction-step__content">
            <view class="completed-correction-step__label">这次主要纠正的</view>
            <view class="completed-correction-step__copy">{{completionClosure.acceptedCorrection.correction}}</view>
          </view>
        </view>
        <view class="completed-correction-rail" aria-hidden="true"></view>
        <view class="completed-correction-step">
          <view class="completed-correction-step__marker completed-correction-step__marker--action">2</view>
          <view class="completed-correction-step__content">
            <view class="completed-correction-step__label">下一题只做这个动作</view>
            <view class="completed-correction-step__copy">{{completionClosure.acceptedCorrection.action}}</view>
          </view>
        </view>
      </view>
      <button
        hover-class="item--hover"
        wx:if="{{hasImmediateVerification}}"
        class="reflection-primary completed-primary tap-tactile"
        loading="{{verificationNavigationLocked}}"
        disabled="{{verificationNavigationLocked}}"
        bindtap="startImmediateVerification"
      >马上用一道新题试试</button>
      <button
        hover-class="item--hover"
        wx:else
        class="reflection-primary completed-primary tap-tactile"
        bindtap="returnToday"
      >返回今日计划</button>
    </view>

    <!-- Figma 113:2 Summary/FixedActionDock：主 CTA 固定在底部操作坞，不随正文滚动。 -->
    <view wx:if="{{phase === 'summary' && result}}" class="s9-action-dock">
      <button hover-class="item--hover" class="s9-primary-button tap-tactile" bindtap="startReflection">{{reviewItems.length > 0 ? '复盘 ' + reviewItems.length + ' 道关键题' : '完成本组复盘'}}</button>
    </view>

    <!-- 复盘正文可滚动；逐题浏览不等于逐题确认错因，统一在最后提交给岸岸判断。 -->
    <view wx:if="{{phase === 'reflection'}}" class="s9-action-dock">
      <view class="s9-action-row">
        <button
          wx:if="{{currentReviewIndex > 0}}"
          hover-class="item--hover"
          class="s9-secondary-button tap-tactile"
          disabled="{{interactionLocked || voiceBusy || isRecording}}"
          bindtap="previousReviewItem"
        >上一道关键题</button>
        <button
          hover-class="item--hover"
          class="s9-primary-button tap-tactile"
          loading="{{interactionLocked}}"
          disabled="{{interactionLocked || voiceBusy || isRecording}}"
          bindtap="confirmCauseAndNext"
        >{{currentReviewIndex < reviewItems.length - 1 ? '看下一道关键题' : '完成复盘，交给岸岸判断'}}</button>
      </view>
    </view>

    <!-- Figma 75:2 · 原题轨迹回放：题面 + 笔迹回放 + 底部回放工具栏。 -->
    <view wx:if="{{replayOpen && activeReviewItem}}" class="replay-surface" catchtouchmove="noop">
      <view class="replay-chip">
        <view class="replay-chip__dot" aria-hidden="true"></view>
        <text>轨迹回放 · {{replayCurrentLabel}}</text>
      </view>
      <scroll-view class="replay-body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="replay-question">
          <content-renderer
            blocks="{{activeReviewItem.stemContent || emptyRichContentBlocks}}"
            zoom="{{1}}"
            preferences="{{displayPreferences}}"
          />
        </view>
      </scroll-view>
      <view class="replay-ink" aria-hidden="true">
        <annotation-layer
          mode="replay"
          strokes="{{activeReviewItem.annotations}}"
          replayMs="{{replayMs}}"
        />
      </view>
      <view wx:if="{{replayCurrentEvent}}" class="replay-current-event">
        <view class="replay-current-event__dot" aria-hidden="true"></view>
        <text>{{replayCurrentEvent}}</text>
      </view>

      <!-- Figma 75:170：回放工具栏（y=750，底部约 16px 呼吸空间），播放圆钮与退出垂直居中。 -->
      <view class="replay-dock">
        <button hover-class="item--hover" class="replay-dock__play" aria-label="{{replayPlaying ? '暂停回放' : '播放回放'}}" bindtap="toggleReplayPlayback">
          <image wx:if="{{!replayPlaying}}" class="replay-dock__play-icon" src="/assets/icons/task/replay-play.svg" mode="aspectFit" aria-hidden="true" />
          <view wx:else class="replay-dock__pause-icon" aria-hidden="true">
            <view class="replay-dock__pause-bar"></view>
            <view class="replay-dock__pause-bar"></view>
          </view>
        </button>
        <view class="replay-dock__middle">
          <view class="replay-dock__track">
            <view class="replay-dock__track-fill" style="width: {{replayProgressPercent}}%;"></view>
            <view
              wx:for="{{replayMarkers}}"
              wx:key="index"
              class="replay-dock__marker replay-dock__marker--{{item.tone}}"
              style="left: {{item.percent}}%;"
            ></view>
          </view>
          <view class="replay-dock__meta">
            <text class="replay-dock__time type-data">{{replayTimeLabel}}</text>
            <text class="replay-dock__summary">{{replaySummaryLabel}}</text>
          </view>
        </view>
        <button hover-class="item--hover" class="replay-dock__exit" bindtap="closeReplay">退出回放</button>
      </view>
    </view>

    <!-- Figma 78:2 · 岸岸动作分析：从底部升起的分析面板（79:4 y=530 h=314）。 -->
    <view wx:if="{{analysisOpen && actionAnalysis}}" class="action-analysis motion-mask" catchtouchmove="noop">
      <view class="action-analysis__mask" catchtap="closeActionAnalysis" aria-label="收起动作分析"></view>
      <view class="action-analysis__sheet">
        <view class="action-analysis__handle" aria-hidden="true"></view>
        <view class="action-analysis__head">
          <view class="action-analysis__title">岸岸观察到的动作</view>
          <view class="action-analysis__confidence">{{actionAnalysis.reliabilityLabel}}</view>
        </view>
        <view class="action-analysis__basis">{{actionAnalysis.basisLabel}}</view>
        <view wx:if="{{actionAnalysis.summary}}" class="action-analysis__summary">{{actionAnalysis.summary}}</view>
        <view class="action-analysis__timeline">
          <view wx:for="{{actionAnalysis.rows}}" wx:key="index" class="action-analysis__row">
            <view class="action-analysis__time action-analysis__time--{{item.tone}} type-data">{{item.timeLabel}}</view>
            <text class="action-analysis__copy">{{item.text}}</text>
          </view>
        </view>
        <view class="action-analysis__boundary">这里只描述看到的过程，不直接说“粗心”或“不会”。</view>
        <!-- 底部按钮不贴设备边缘：sheet padding-bottom 提供呼吸空间。 -->
        <view class="action-analysis__actions">
          <button hover-class="item--hover" class="action-analysis__ask" bindtap="askAnanAboutGroup">继续追问岸岸</button>
          <button hover-class="item--hover" class="action-analysis__back" bindtap="closeActionAnalysis">回到复盘</button>
        </view>
      </view>
    </view>
  </block>
</view>
