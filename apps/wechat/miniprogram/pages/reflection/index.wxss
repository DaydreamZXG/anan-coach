.page-state {
  padding: 32rpx 0;
}
.capability-state {
  margin-top: 28rpx;
  padding: 40rpx 34rpx;
}
.capability-mark,
.hero-eyebrow,
.completed-mark {
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 760;
  letter-spacing: 2rpx;
}
.capability-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1.4;
}
.capability-copy {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.7;
}
.capability-action {
  margin-top: 28rpx;
}
.reflection-workspace {
  padding-bottom: 30rpx;
}
.reflection-hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  border-radius: 34rpx;
  border: 1rpx solid var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-ink);
  box-shadow: var(--shadow-card);
}
.hero-orbit {
  position: absolute;
  border: 1rpx solid var(--color-primary-a16);
  border-radius: 999rpx;
}
.hero-orbit--one {
  top: -100rpx;
  right: -70rpx;
  width: 260rpx;
  height: 260rpx;
}
.hero-orbit--two {
  top: -45rpx;
  right: -15rpx;
  width: 145rpx;
  height: 145rpx;
  background: var(--color-primary-a08);
}
.hero-eyebrow {
  position: relative;
  color: var(--color-primary);
}
.hero-title {
  position: relative;
  margin-top: 16rpx;
  font-size: 38rpx;
  font-weight: 840;
  line-height: 1.38;
}
.hero-copy {
  position: relative;
  margin-top: 14rpx;
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}
.hero-score {
  position: relative;
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid var(--color-primary-a24);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-ink-secondary);
  font-size: 20rpx;
}
.hero-score__value {
  color: var(--color-primary-deep);
  font-family: var(--font-family-data);
  font-size: 30rpx;
  font-weight: 820;
}
.legacy-result-notice {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  background: var(--color-surface-soft);
}
.legacy-result-title {
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  font-weight: 790;
}
.legacy-result-copy {
  margin-top: 9rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.62;
}
.legacy-result-code {
  margin-top: 10rpx;
  color: var(--color-faint);
  font-size: 17rpx;
}
.pending-write {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(185, 141, 47, 0.12);
  background: var(--color-warning-soft);
}
.pending-title {
  color: var(--color-warning);
  font-size: 24rpx;
  font-weight: 780;
}
.pending-copy {
  margin: 9rpx 0 18rpx;
  color: var(--color-ink-secondary);
  font-size: 21rpx;
  line-height: 1.6;
}
.pending-write .secondary-button {
  width: 100%;
}
.thought-input,
.cause-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 240rpx;
  padding: 26rpx;
  border: 2rpx solid var(--color-primary-a16);
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 34rpx rgba(190, 120, 60, 0.06);
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  line-height: 1.75;
}
.voice-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-primary-a16);
}
.voice-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.voice-title {
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  font-weight: 800;
}
.voice-title__optional {
  color: var(--color-faint);
  font-size: 19rpx;
  font-weight: 500;
}
.voice-copy {
  margin-top: 9rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.6;
}
.voice-count {
  flex: none;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-family: var(--font-family-data);
  font-size: 19rpx;
  font-weight: 760;
}
.voice-permission {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(185, 141, 47, 0.13);
  border-radius: 18rpx;
  background: var(--color-warning-soft);
}
.voice-permission-title {
  color: var(--color-warning);
  font-size: 22rpx;
  font-weight: 780;
}
.voice-permission-copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: 20rpx;
  line-height: 1.6;
}
.voice-setting {
  min-height: 64rpx;
  margin: 16rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  background: var(--color-warning);
  color: #fff;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 64rpx;
}
.voice-setting::after,
.record-button::after,
.voice-play::after,
.voice-action-button::after,
.voice-upload::after {
  border: 0;
}
.record-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 78rpx;
  margin: 22rpx 0 0;
  border: 1rpx solid var(--color-primary-a16);
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 780;
  line-height: 78rpx;
}
.record-button--active {
  border-color: rgba(219, 74, 82, 0.2);
  background: rgba(219, 74, 82, 0.08);
  color: #bd3941;
}
.record-dot {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 999rpx;
}
.record-button--active .record-dot {
  border-radius: 4rpx;
  background: currentColor;
}
.voice-list {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
}
.voice-item {
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-canvas);
}
.voice-item-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.voice-play {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 62rpx;
}
.voice-item-copy {
  flex: 1;
  min-width: 0;
}
.voice-item-title {
  color: var(--color-ink-secondary);
  font-family: var(--font-family-data);
  font-size: 21rpx;
  font-weight: 730;
}
.voice-state {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 19rpx;
}
.voice-state--working {
  color: var(--color-primary);
}
.voice-state--success {
  color: var(--color-success);
}
.voice-state--error {
  color: var(--color-warning);
}
.voice-failure {
  margin-top: 12rpx;
  color: var(--color-warning);
  font-size: 19rpx;
  line-height: 1.55;
}
.voice-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 12rpx;
}
.voice-action-button {
  min-height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 14rpx;
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 54rpx;
}
.voice-summary,
.voice-message {
  margin-top: 15rpx;
  color: var(--color-faint);
  font-size: 19rpx;
  line-height: 1.55;
}
.voice-message {
  color: var(--color-muted);
}
.voice-upload {
  width: 100%;
  min-height: 72rpx;
  margin: 18rpx 0 0;
  border: 0;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 21rpx;
  font-weight: 760;
  line-height: 72rpx;
}
.compact-heading {
  margin-top: 32rpx;
}
.tag-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.tag-chip {
  width: 100%;
  min-height: 72rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 70rpx;
}
.tag-chip--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 750;
  box-shadow: 0 8rpx 22rpx var(--color-primary-a08);
}
.interpretation-card {
  margin-top: 22rpx;
  padding: 28rpx;
}
.interpretation-title {
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.5;
}
.interpretation-copy {
  margin-top: 9rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.62;
}
.interpretation-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 94rpx;
  margin: 16rpx 0 0;
  padding: 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-canvas);
  color: var(--color-ink-secondary);
  text-align: left;
}
.interpretation-item::after {
  border: 0;
}
.interpretation-item--selected {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}
.interpretation-check {
  flex: none;
  padding: 8rpx 11rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 760;
}
.interpretation-body {
  flex: 1;
  min-width: 0;
}
.interpretation-position {
  font-size: 22rpx;
  font-weight: 760;
}
.interpretation-answer {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-size: 18rpx;
  line-height: 1.5;
}
.detail-card {
  margin-top: 22rpx;
  padding: 28rpx;
}
.field-label {
  margin-bottom: 12rpx;
  color: var(--color-ink-secondary);
  font-size: 23rpx;
  font-weight: 750;
}
.field-label:not(:first-child) {
  margin-top: 24rpx;
}
.field-label__optional {
  color: var(--color-faint);
  font-size: 19rpx;
  font-weight: 500;
}
.detail-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 126rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-canvas);
  font-size: 23rpx;
  line-height: 1.65;
}
.main-action {
  width: 100%;
  margin-top: 28rpx;
}
.cause-state {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(185, 141, 47, 0.12);
  background: linear-gradient(145deg, #fffaf3, #fff7e9);
}
.boundary-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--color-warning);
  color: #fff;
  font-family: var(--font-family-data);
  font-size: 22rpx;
  font-weight: 850;
}
.boundary-body {
  flex: 1;
  min-width: 0;
}
.boundary-title {
  color: var(--color-warning);
  font-size: 26rpx;
  font-weight: 800;
}
.boundary-copy {
  margin-top: 10rpx;
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}
.boundary-meta {
  margin-top: 12rpx;
  color: var(--color-faint);
  font-family: var(--font-family-data);
  font-size: 18rpx;
}
.followup-card,
.candidate-card,
.evidence-card,
.legacy-cause-readonly {
  margin-top: 22rpx;
  padding: 28rpx;
}
.followup-label,
.candidate-label {
  color: var(--color-ink-secondary);
  font-size: 21rpx;
  font-weight: 780;
}
.followup-question {
  margin: 14rpx 0 20rpx;
  font-size: 27rpx;
  font-weight: 760;
  line-height: 1.55;
}
.candidate-section + .candidate-section {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-line);
}
.candidate-copy,
.evidence-line,
.legacy-cause-readonly {
  margin-top: 9rpx;
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}
.reject-cause,
.defer-cause {
  width: 100%;
  min-height: 84rpx;
  margin-top: 14rpx;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 84rpx;
}
.reject-cause {
  color: var(--color-danger);
}
.reject-cause::after,
.defer-cause::after {
  border: 0;
}
.completed-card {
  margin-top: 34rpx;
  padding: 42rpx 32rpx;
  text-align: center;
}
.completed-mark {
  color: var(--color-success);
}
.completed-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 830;
  line-height: 1.45;
}
.completed-copy {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.72;
}

@media (min-width: 768px) {
  .reflection-workspace,
  .page-state,
  .capability-state {
    width: 100%;
    max-width: 760px;
    margin-right: auto;
    margin-left: auto;
  }

  .reflection-hero,
  .voice-card,
  .interpretation-card,
  .detail-card,
  .cause-state,
  .followup-card,
  .candidate-card,
  .evidence-card,
  .completed-card {
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .hero-title,
  .completed-title {
    font-size: 24px;
  }

  .hero-copy,
  .thought-input,
  .cause-input,
  .voice-title,
  .interpretation-title,
  .candidate-copy,
  .evidence-line,
  .legacy-cause-readonly,
  .completed-copy {
    font-size: 16px;
  }

  .tag-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
}
