.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

.foot-space {
  height: 80rpx;
}

/* ── 顶部导航 ── */

.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__text {
  flex: 1;
  min-width: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.nav__phase {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  font-size: 22rpx;
  color: var(--ink-2);
}

/* ── 作答概览 hero ── */

.hero {
  margin: 8rpx 32rpx 28rpx;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.hero__cap {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.08em;
}

.hero__line {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
}

.hero__hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 区块标题左右留白与页面一致 */
.section-head {
  margin: 28rpx 32rpx 20rpx;
}

/* ── 逐题回顾卡 ── */

.qitem {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.qitem__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qitem__seq {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(91, 95, 244, 0.12);
  color: var(--indigo);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qitem__module {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.qitem__tag {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.qitem__tag--correct {
  background: rgba(13, 159, 110, 0.12);
  color: var(--green);
}

.qitem__tag--incorrect {
  background: rgba(224, 82, 82, 0.12);
  color: var(--red);
}

.qitem__tag--skipped {
  background: rgba(16, 19, 27, 0.06);
  color: var(--ink-3);
}

.qitem__tag--timeout,
.qitem__tag--guessed {
  background: rgba(217, 127, 6, 0.12);
  color: var(--amber);
}

.qitem__stem {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
}

.qitem__answers {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.qitem__answer {
  font-size: 24rpx;
  color: var(--ink-2);
}

.qitem__answer--correct {
  color: var(--green);
  font-weight: 700;
}

/* ── 提交中提示条 ── */

.pending {
  margin: 0 32rpx 20rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--r-sm);
  background: rgba(91, 95, 244, 0.08);
  color: var(--indigo);
  font-size: 24rpx;
}

/* ── 表单卡 ── */

.field {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.field__label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}

.field__label + .field__textarea {
  margin-bottom: 24rpx;
}

.field__label:last-child {
  margin-bottom: 0;
}

.field__question {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.field__textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border-radius: var(--r-sm);
  background: var(--bg);
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink);
}

.field__textarea--sm {
  min-height: 120rpx;
}

/* ── 标签 chips ── */

.tags {
  margin: 0 32rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tags__chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  font-size: 26rpx;
  color: var(--ink-2);
}

.tags__chip--on {
  background: var(--grad-main);
  color: #ffffff;
  font-weight: 700;
}

/* ── 逐题解读选择 ── */

.interp {
  margin: 0 32rpx 20rpx;
  padding: 12rpx 28rpx;
}

.interp__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.interp__item:last-child {
  border-bottom: none;
}

.interp__check {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(16, 19, 27, 0.05);
  font-size: 22rpx;
  color: var(--ink-3);
}

.interp__item--on .interp__check {
  background: rgba(91, 95, 244, 0.14);
  color: var(--indigo);
  font-weight: 700;
}

.interp__pos {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.interp__answer {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── AI 错因卡 ── */

.cause {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
  display: flex;
  gap: 20rpx;
}

.cause__badge {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--grad-main);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-glow);
}

.cause__body {
  flex: 1;
  min-width: 0;
}

.cause__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.cause__copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.cause__meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 错因详情卡 ── */

.detail {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.detail__section {
  margin-bottom: 22rpx;
}

.detail__section:last-child {
  margin-bottom: 0;
}

.detail__label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.detail__copy {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink);
}

.detail__line {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.readonly {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
}

/* ── 完成卡 ── */

.done {
  margin: 0 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.done__mark {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(13, 159, 110, 0.12);
  color: var(--green);
  font-size: 24rpx;
  font-weight: 700;
}

.done__title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.done__copy {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 12rpx;
}

/* ── 操作区 ── */

.actions {
  margin: 24rpx 32rpx 0;
}

.actions__gap {
  height: 20rpx;
}
