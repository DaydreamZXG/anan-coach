.reflection-page {
  position: relative;
  overflow-x: hidden;
}

.reflection-state {
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

.summary-content {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--layout-readable-max);
  margin-right: auto;
  margin-left: auto;
  padding: var(--figma-space-24) var(--figma-page-inset) 0;
}

.summary-intro {
  margin-top: 0;
}

.summary-title {
  color: var(--color-ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: -1.4rpx;
  line-height: 1.25;
}

.summary-copy {
  margin-top: var(--figma-space-6);
  color: var(--color-muted);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.65;
}

.summary-card,
.summary-insight,
.summary-legacy,
.summary-question-strip {
  box-sizing: border-box;
  margin-top: var(--figma-space-16);
  border: 1rpx solid var(--color-line);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.summary-card {
  padding: var(--figma-space-20);
  border-radius: var(--figma-radius-card-large);
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--figma-space-4);
}

.summary-metric {
  min-width: 0;
  text-align: center;
}

.summary-metric__value {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-metric--warning .summary-metric__value {
  color: var(--color-warning);
}

.summary-metric__label {
  margin-top: var(--figma-space-4);
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.3;
}

.summary-confidence {
  margin-top: var(--figma-space-20);
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-control);
  background: var(--color-surface-soft);
}

.summary-confidence__title {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-confidence__list {
  display: grid;
  gap: var(--figma-space-10);
  margin-top: var(--figma-space-12);
}

.summary-confidence__row,
.summary-confidence__label {
  display: flex;
  align-items: center;
}

.summary-confidence__row {
  justify-content: space-between;
  gap: var(--figma-space-8);
}

.summary-confidence__label {
  gap: var(--figma-space-6);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 500;
}

.summary-confidence__value {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-confidence__dot {
  flex: none;
  width: var(--figma-space-6);
  height: var(--figma-space-6);
  border-radius: var(--figma-radius-pill);
  background: var(--color-faint);
}

.summary-confidence__dot--success {
  background: var(--figma-color-success-bright);
}

.summary-confidence__dot--primary {
  background: var(--color-primary-bright);
}

.summary-confidence__dot--warning {
  background: var(--color-warning);
}

.summary-confidence__dot--danger {
  background: var(--color-danger);
}

.summary-insight {
  padding: var(--figma-space-20);
  border-color: var(--color-primary-soft-strong);
  border-radius: var(--figma-radius-card-large);
}

.summary-insight__head {
  display: flex;
  align-items: center;
  gap: var(--figma-space-6);
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-insight__spark,
.summary-insight__toggle {
  color: var(--color-primary);
}

.summary-insight__title {
  margin-top: var(--figma-space-12);
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.summary-insight__copy {
  margin-top: var(--figma-space-6);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.7;
}

.summary-insight__basis {
  margin-top: var(--figma-space-12);
}

.summary-insight__basis-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--figma-space-10);
  padding: var(--figma-space-6) 0;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
}

.summary-insight__next,
.summary-insight__verification {
  margin-top: var(--figma-space-8);
  padding: var(--figma-space-10);
  border-radius: var(--figma-radius-small);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.55;
}

.summary-insight__verification {
  background: var(--color-surface-soft);
  color: var(--color-muted);
}

/* Figma 13:119：左对齐的文字链接。 */
.summary-insight__toggle {
  display: flex;
  justify-content: flex-start;
  margin-top: var(--figma-space-12);
  font-size: var(--text-micro);
  font-weight: 500;
  text-align: left;
}

.summary-legacy {
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-control);
}

.summary-legacy__title {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-legacy__copy {
  margin-top: var(--figma-space-6);
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.summary-question-strip {
  display: flex;
  justify-content: space-around;
  gap: var(--figma-space-6);
  padding: var(--figma-space-16) var(--figma-space-12);
  border-radius: var(--figma-radius-card);
}

.summary-question-strip__item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  flex-direction: column;
  gap: var(--figma-space-4);
}

/* Figma 13:129/13:145：40px 圆形题号；正常题浅灰，需复盘题红圈。 */
.summary-question-dot {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--figma-radius-pill);
  background: var(--figma-color-surface-subtle);
  color: var(--figma-color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-question-dot--review {
  border-color: var(--figma-color-danger-soft-strong);
  background: var(--figma-color-danger-soft);
  color: var(--figma-color-danger-deep);
}

.summary-question-dot--normal {
  border-color: var(--figma-color-line);
  background: var(--figma-color-surface-subtle);
  color: var(--figma-color-ink);
}

/* Figma 13:149：红色小注「复盘·超时」。 */
.summary-question-label {
  overflow: hidden;
  width: 100%;
  color: var(--figma-color-danger);
  font-size: var(--text-micro);
  font-weight: 500;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-actions {
  display: flex;
  flex-direction: column;
  gap: var(--figma-space-10);
  margin-top: var(--figma-space-16);
}

.summary-actions__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--figma-space-10);
}

.summary-primary,
.summary-secondary,
.summary-anan {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  border-radius: var(--figma-radius-control);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-primary {
  background: var(--color-action);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.summary-secondary {
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
}

.summary-anan {
  border: 1rpx solid var(--color-primary-soft-strong);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.summary-boundary {
  margin: var(--figma-space-12) var(--figma-space-10) 0;
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
  text-align: center;
}

.review-content,
.cause-content {
  box-sizing: border-box;
  padding: 32rpx 40rpx 0;
}

.pending-write,
.legacy-notice {
  margin: 24rpx 40rpx 0;
  padding: 28rpx;
  border: 1rpx solid var(--figma-color-warning-soft);
  border-radius: var(--radius-32);
  background: var(--figma-color-warning-soft);
}

.pending-write__title,
.legacy-notice__title {
  color: var(--figma-color-warning-deep);
  font-size: var(--text-body);
  font-weight: 700;
}

.pending-write__copy,
.legacy-notice__copy {
  margin-top: 8rpx;
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
}

.pending-write__action {
  margin-top: 20rpx;
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}

.legacy-notice {
  margin: 0 0 28rpx;
  border-color: var(--color-line-strong);
  background: var(--color-surface);
}

.legacy-notice__title {
  color: var(--color-ink-secondary);
}

.legacy-notice__copy {
  color: var(--ink-2);
}

.review-tabs {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  overflow-x: auto;
}

.review-tab {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 700;
}

.review-tab--active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.question-review {
  margin-bottom: 28rpx;
}

.question-review__position {
  margin-bottom: 20rpx;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.question-review__material {
  margin-bottom: var(--figma-space-12);
}

.question-review__stem {
  margin-bottom: var(--figma-space-12);
  padding: var(--figma-space-10) 0;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 600;
  line-height: 1.75;
}

.answer-compare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 86rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid;
  border-radius: var(--radius-32);
}

.answer-compare--wrong {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
  color: var(--danger);
}

.answer-compare--right {
  border-color: var(--good-soft);
  background: var(--good-soft);
  color: var(--good);
}

.answer-compare__label {
  margin-right: 20rpx;
  font-size: var(--text-caption);
  font-weight: 700;
}

.answer-compare__value {
  font-size: var(--text-caption);
  font-weight: 600;
}

.answer-compare__mark {
  font-size: var(--text-section);
  font-weight: 700;
}

.answer-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.answer-fact {
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-12);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}

.answer-fact--warning {
  border-color: var(--figma-color-warning-soft);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.structured-review,
.reason-card,
.method-card,
.more-evidence-panel,
.followup-card,
.candidate-card {
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.structured-review__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.structured-review__spark {
  color: var(--color-muted);
  font-size: var(--text-body-lg);
}

.structured-review__label {
  margin-top: 24rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
}

.structured-review__copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.75;
}

.structured-review__source {
  margin-top: 20rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.structured-review__warning {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--figma-color-warning-soft);
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.6;
}

.reason-card__title,
.method-card__title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.reason-card__copy,
.method-card__copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.tag-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.tag-chip--active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.reason-textarea,
.cause-textarea,
.evidence-field__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 190rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.7;
}

.method-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  text-align: left;
}

.method-option--selected {
  border-color: var(--color-primary-bright);
  background: var(--primary-soft);
}

.method-option__position {
  font-size: var(--text-caption);
  font-weight: 700;
}

.method-option__answer {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
}

.method-option__state {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}

.more-evidence-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
  text-align: left;
}

.voice-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.voice-head__title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.voice-head__optional,
.evidence-field__optional {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.voice-head__copy {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.voice-head__count {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.voice-permission {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--figma-color-warning-soft);
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
}

.voice-permission__title {
  color: var(--figma-color-warning-deep);
  font-size: var(--text-caption);
  font-weight: 700;
}

.voice-permission__copy {
  margin-top: 8rpx;
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.voice-permission__action {
  margin-top: 16rpx;
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}

.record-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 78rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--color-primary-soft-strong);
  border-radius: var(--radius-32);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.record-button--active {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
  color: var(--danger);
}

.record-dot {
  box-sizing: border-box;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.record-button--active .record-dot {
  border-radius: 3rpx;
  background: currentColor;
}

.voice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--bg);
}

.voice-item__play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 700;
}

.voice-item__main {
  flex: 1;
  min-width: 0;
}

.voice-item__title {
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.voice-item__state {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
}

.voice-item__state--success {
  color: var(--good);
}

.voice-item__state--error,
.voice-item__failure {
  color: var(--danger);
}

.voice-item__failure {
  margin-top: 8rpx;
  font-size: var(--text-micro);
  line-height: 1.45;
}

.voice-item__actions {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
}

.voice-item__action {
  min-height: 46rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.voice-summary,
.voice-message {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.voice-message {
  color: var(--ink-2);
}

.voice-upload {
  width: 100%;
  min-height: 74rpx;
  margin-top: 20rpx;
  border-radius: var(--radius-24);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 700;
}

.evidence-field {
  margin-top: 32rpx;
}

.evidence-field__label {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.evidence-field__input {
  min-height: 130rpx;
  margin-top: 16rpx;
}

.reflection-primary,
.reflection-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  border-radius: var(--radius-40);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.reflection-primary {
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.reflection-secondary {
  margin-top: 20rpx;
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
}

.reflection-boundary {
  margin-top: 20rpx;
  padding: 0 20rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
  text-align: center;
}

/* 固定操作坞高约 150rpx，正文底部必须完整让出。 */
.reflection-bottom-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.cause-processing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 220rpx);
  padding: 64rpx;
  text-align: center;
}

.cause-spinner {
  box-sizing: border-box;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 40rpx;
  border: 8rpx solid var(--color-primary-soft-strong);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: cause-spin 1.5s linear infinite;
}

@keyframes cause-spin {
  100% {
    transform: rotate(360deg);
  }
}

.cause-processing__title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
}

.cause-processing__copy,
.cause-processing__boundary {
  max-width: 580rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.65;
}

.cause-processing__boundary {
  margin: 28rpx 0 40rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.cause-intro {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin: 12rpx 0 32rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-primary-soft-strong);
  border-radius: var(--radius-40);
  background: var(--primary-soft);
}

.cause-intro__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--radius-24);
  background: var(--primary);
  color: var(--color-surface);
  font-size: var(--text-body);
  font-weight: 800;
}

.cause-intro__title {
  color: var(--color-muted);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.cause-intro__copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.followup-card__label {
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.followup-card__question {
  margin-top: 16rpx;
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.6;
}

.candidate-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.candidate-section__label {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
}

.candidate-section__copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.7;
}

.candidate-limitations {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-32);
  background: var(--figma-color-warning-soft);
}

.candidate-limitations__line {
  margin-top: 8rpx;
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.55;
}

.cause-later {
  width: 100%;
  min-height: 72rpx;
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
}

/* Figma 15:8：paddingTop 28，删除过大的顶部空白，整体上移。 */
.completed-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding: 56rpx 48rpx calc(64rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.completed-icon {
  color: var(--figma-color-ink);
  font-size: var(--text-title-lg);
  font-weight: 600;
  line-height: 1;
}

.completed-title {
  margin-top: 32rpx;
  color: var(--figma-color-ink);
  font-size: var(--text-title-lg);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 67rpx;
}

.completed-copy {
  max-width: 610rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.65;
}

/* Figma 15:19：证据数据卡，行间用 #f9fafb 细分隔线。 */
.completed-card {
  box-sizing: border-box;
  width: 100%;
  margin: 40rpx 0 40rpx;
  padding: 8rpx 32rpx;
  border-radius: var(--radius-64);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-card);
}

.completed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--figma-color-surface-subtle);
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.completed-row--last:last-child,
.completed-row--accent:last-child {
  border-bottom: 0;
}

button.summary-insight__toggle,
button.pending-write__action,
button.tag-chip,
button.voice-permission__action,
button.voice-item__action {
  width: auto;
}

button.summary-primary,
button.summary-secondary,
button.summary-anan,
button.method-option,
button.more-evidence-toggle,
button.record-button,
button.voice-upload,
button.reflection-primary,
button.reflection-secondary,
button.cause-later {
  width: 100%;
}

button.review-tab {
  width: 72rpx;
}

button.voice-item__play {
  width: 58rpx;
}

@media (min-width: 700px) {
  .review-content,
  .cause-content {
    padding-right: max(40rpx, calc((100vw - 860px) / 2));
    padding-left: max(40rpx, calc((100vw - 860px) / 2));
  }

  .completed-screen {
    max-width: 720px;
    margin: 0 auto;
  }
}

/* ===== Figma 03 · 行测练习与复盘 本轮接入新增 ===== */

/* Figma 14:2：共享材料收起入口条。 */
.review-material-entry {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 78rpx;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 20rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--radius-24);
  background: var(--figma-color-surface);
  color: var(--color-muted);
  text-align: left;
}

.review-material-entry::after {
  border: 0;
}

button.review-material-entry {
  width: 100%;
}

.review-material-entry__icon {
  flex: none;
  font-size: var(--text-body);
  line-height: 1;
}

.review-material-entry__label {
  overflow: hidden;
  flex: 1;
  font-size: var(--text-micro);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-material-entry__chevron {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  transform: rotate(-45deg);
  border-right: 3rpx solid var(--figma-color-faint);
  border-bottom: 3rpx solid var(--figma-color-faint);
  border-radius: 2rpx;
}

/* Figma 14:36/14:44：答案卡右侧圆形 × / ✓。 */
.answer-compare__mark {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: var(--text-caption);
  font-weight: 700;
}

.answer-compare__mark--wrong {
  border: 2rpx solid var(--figma-color-danger);
  color: var(--figma-color-danger);
}

.answer-compare__mark--right {
  border: 2rpx solid var(--figma-color-success);
  color: var(--figma-color-success);
}

/* Figma 14:2「你的具体错点」琥珀色块。 */
.structured-review__errorpoint {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
}

.structured-review__errorpoint-title {
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}

.structured-review__errorpoint-copy {
  margin-top: 8rpx;
  color: var(--figma-color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.7;
}

/* Figma 15:9：完成图标白色圆片（80×58、满圆角、投影）。 */
.completed-icon-pill {
  display: flex;
  width: 160rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border: 1rpx solid var(--figma-color-surface-subtle);
  border-radius: var(--radius-capsule);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-card);
}

.completed-row__value {
  color: var(--figma-color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.completed-row__value--accent,
.completed-row--accent {
  color: var(--color-muted);
}

/* ===== Figma 75:2 · 原题轨迹回放 ===== */

.structured-review__trajectory {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.structured-review__trajectory-link {
  box-sizing: border-box;
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-primary-soft-strong);
  border-radius: var(--radius-24);
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
  font-size: var(--text-caption);
  font-weight: 600;
}

.structured-review__trajectory-link::after {
  border: 0;
}

.replay-surface {
  position: fixed;
  z-index: var(--z-blocker);
  inset: 0;
  display: flex;
  flex-direction: column;
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  background: var(--figma-color-canvas);
}

/* Figma 75:2 顶部：轨迹回放橙色胶囊。 */
.replay-chip {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 24rpx);
  right: 28rpx;
  display: flex;
  height: 56rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-32);
  color: var(--figma-color-warning-deep);
  background: var(--figma-color-warning-soft);
  font-size: var(--text-micro);
  font-weight: 700;
}

.replay-chip__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--figma-color-warning);
}

.replay-body {
  min-height: 0;
  flex: 1;
}

.replay-question {
  padding: 32rpx 40rpx 260rpx;
}

.replay-ink {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

/* Figma 76:4：当前事件浮标。 */
.replay-current-event {
  position: absolute;
  right: 40rpx;
  bottom: calc(240rpx + env(safe-area-inset-bottom));
  display: flex;
  height: 68rpx;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgb(79 57 246 / 12%);
  border-radius: var(--radius-32);
  color: var(--color-muted);
  background: rgb(246 244 255 / 97%);
  font-size: var(--text-micro);
  font-weight: 700;
}

.replay-current-event__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary-deep);
}

/* Figma 75:170：回放工具栏（h78 r24 白底描边投影），底部约 16px 呼吸。 */
.replay-dock {
  position: absolute;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  box-sizing: border-box;
  display: flex;
  height: 156rpx;
  align-items: center;
  gap: 20rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--radius-48);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-elevated);
}

/* Figma 76:7：46px 播放圆钮，真正的 SVG 三角图标，视觉居中。 */
.replay-dock__play {
  box-sizing: border-box;
  display: flex;
  width: 92rpx;
  min-width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-48);
  background: var(--color-primary-deep);
}

.replay-dock__play-icon {
  width: 32rpx;
  height: 32rpx;
}

.replay-dock__pause-icon {
  display: flex;
  gap: 8rpx;
}

.replay-dock__pause-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--figma-color-on-dark);
}

.replay-dock__middle {
  min-width: 0;
  flex: 1;
}

/* Figma 76:9：进度轨 + 事件节点。 */
.replay-dock__track {
  position: relative;
  height: 12rpx;
  border-radius: var(--radius-8);
  background: var(--figma-color-line-strong);
}

.replay-dock__track-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-8);
  background: var(--color-primary-deep);
}

.replay-dock__marker {
  position: absolute;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid var(--figma-color-surface);
  border-radius: 50%;
  background: var(--color-primary-bright);
  transform: translate(-50%, -50%);
}

.replay-dock__marker--warning {
  background: var(--figma-color-warning);
}

.replay-dock__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.replay-dock__time {
  color: var(--figma-color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 600;
}

.replay-dock__summary {
  overflow: hidden;
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Figma 76:16：退出回放，与播放圆钮同轴垂直居中。 */
.replay-dock__exit {
  box-sizing: border-box;
  display: flex;
  width: 140rpx;
  min-width: 140rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--figma-color-on-dark);
  background: var(--figma-color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
}

.replay-dock__play::after,
.replay-dock__exit::after {
  border: 0;
}

/* ===== Figma 78:2 · 岸岸动作分析 ===== */

.action-analysis {
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
}

.action-analysis__mask {
  position: absolute;
  inset: 0;
  background: rgb(16 24 40 / 20%);
}

/* Figma 79:4：h=314、r28 面板，底部按钮不贴设备边缘。 */
.action-analysis__sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 18rpx 38rpx calc(40rpx + env(safe-area-inset-bottom));
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--radius-48) var(--radius-48) 0 0;
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-overlay);
}

.action-analysis__handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto;
  border-radius: 4rpx;
  background: var(--figma-color-line-emphasis);
}

.action-analysis__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

/* Figma 79:6 */
.action-analysis__title {
  color: var(--figma-color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 48rpx;
}

/* Figma 79:7 */
.action-analysis__confidence {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-24);
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
  font-size: var(--text-micro);
  font-weight: 700;
}

/* Figma 79:9 */
.action-analysis__basis {
  margin-top: 8rpx;
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
}

/* Figma 79:10 */
.action-analysis__summary {
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  border: 1rpx solid rgb(79 57 246 / 8%);
  border-radius: var(--radius-32);
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 38rpx;
}

.action-analysis__timeline {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

/* Figma 79:12：时间轨迹行。 */
.action-analysis__row {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  gap: 20rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-32);
  background: var(--figma-color-canvas);
}

.action-analysis__time {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-24);
  background: rgb(79 57 246 / 12%);
  color: var(--color-primary-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}

.action-analysis__time--warning {
  background: rgb(255 105 0 / 12%);
  color: var(--figma-color-warning);
}

.action-analysis__copy {
  overflow: hidden;
  color: var(--figma-color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Figma 79:20 */
.action-analysis__boundary {
  margin-top: 20rpx;
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
}

/* Figma 79:21/79:23：两个真实出口。 */
.action-analysis__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  margin-top: 24rpx;
}

.action-analysis__ask,
.action-analysis__back {
  box-sizing: border-box;
  display: flex;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  font-size: var(--text-caption);
  font-weight: 700;
}

.action-analysis__ask {
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.action-analysis__back {
  color: var(--figma-color-on-dark);
  background: var(--figma-color-ink);
}

.action-analysis__ask::after,
.action-analysis__back::after {
  border: 0;
}
