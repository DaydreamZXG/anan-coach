.reflection-page {
  position: relative;
  overflow-x: hidden;
}

.reflection-state {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(32 * var(--rpx));
}

.summary-content {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--layout-readable-max);
  margin-right: auto;
  margin-left: auto;
  padding: var(--figma-space-24) var(--figma-page-inset) 0;
}

.summary-intro {
  margin-top: 0;
}

.summary-title {
  color: var(--color-ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1.4 * var(--rpx));
  line-height: 1.25;
}

.summary-copy {
  margin-top: var(--figma-space-6);
  color: var(--color-muted);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.65;
}

.summary-card,
.summary-insight,
.summary-legacy,
.summary-question-map {
  box-sizing: border-box;
  margin-top: var(--figma-space-16);
  border: calc(1 * var(--rpx)) solid var(--color-line);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.summary-card {
  padding: var(--figma-space-20);
  border-radius: var(--figma-radius-card-large);
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--figma-space-4);
}

.summary-metric {
  min-width: 0;
  text-align: center;
}

.summary-metric__value {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-metric--warning .summary-metric__value {
  color: var(--color-warning);
}

.summary-metric__label {
  margin-top: var(--figma-space-4);
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.3;
}

.summary-confidence {
  margin-top: var(--figma-space-20);
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-control);
  background: var(--color-surface-soft);
}

.summary-confidence__title {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-confidence__list {
  display: grid;
  gap: var(--figma-space-10);
  margin-top: var(--figma-space-12);
}

.summary-confidence__row,
.summary-confidence__label {
  display: flex;
  align-items: center;
}

.summary-confidence__row {
  justify-content: space-between;
  gap: var(--figma-space-8);
}

.summary-confidence__label {
  gap: var(--figma-space-6);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 500;
}

.summary-confidence__value {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-confidence__dot {
  flex: none;
  width: var(--figma-space-6);
  height: var(--figma-space-6);
  border-radius: var(--figma-radius-pill);
  background: var(--color-faint);
}

.summary-confidence__dot--success {
  background: var(--figma-color-success-bright);
}

.summary-confidence__dot--primary {
  background: var(--color-primary-bright);
}

.summary-confidence__dot--warning {
  background: var(--color-warning);
}

.summary-confidence__dot--danger {
  background: var(--color-danger);
}

.summary-insight {
  padding: var(--figma-space-20);
  border-color: var(--color-primary-soft-strong);
  border-radius: var(--figma-radius-card-large);
}

.summary-insight__head {
  display: flex;
  align-items: center;
  gap: var(--figma-space-6);
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-insight__spark,
.summary-insight__toggle {
  color: var(--color-primary);
}

.summary-insight__title {
  margin-top: var(--figma-space-12);
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.summary-insight__copy {
  margin-top: var(--figma-space-6);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.7;
}

.summary-insight__basis {
  margin-top: var(--figma-space-12);
}

.summary-insight__basis-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--figma-space-10);
  padding: var(--figma-space-6) 0;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
}

.summary-insight__next,
.summary-insight__verification {
  margin-top: var(--figma-space-8);
  padding: var(--figma-space-10);
  border-radius: var(--figma-radius-small);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.55;
}

.summary-insight__verification {
  background: var(--color-surface-soft);
  color: var(--color-muted);
}

.summary-evidence {
  margin-top: var(--figma-space-10);
  padding: var(--figma-space-12);
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--figma-radius-small);
  background: var(--color-surface);
}

.summary-evidence__title {
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-evidence__counts {
  display: flex;
  flex-wrap: wrap;
  gap: var(--figma-space-6);
  margin-top: var(--figma-space-8);
}

.summary-evidence__count {
  padding: var(--figma-space-4) var(--figma-space-8);
  border-radius: var(--figma-radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--text-micro);
  font-weight: 600;
}

.summary-evidence__copy {
  margin-top: var(--figma-space-8);
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

/* Figma 13:119：左对齐的文字链接。 */
.summary-insight__toggle {
  display: flex;
  justify-content: flex-start;
  margin-top: var(--figma-space-12);
  font-size: var(--text-micro);
  font-weight: 500;
  text-align: left;
}

.summary-legacy {
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-control);
}

.summary-legacy__title {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-legacy__copy {
  margin-top: var(--figma-space-6);
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.summary-question-map {
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-card);
}

.summary-question-map__head,
.summary-question-group__head,
.summary-question-group__identity {
  display: flex;
  align-items: center;
}

.summary-question-map__head,
.summary-question-group__head {
  justify-content: space-between;
  gap: var(--figma-space-10);
}

.summary-question-map__title {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-question-map__hint {
  color: var(--color-faint);
  font-size: var(--text-micro);
  text-align: right;
}

.summary-question-group {
  margin-top: var(--figma-space-12);
  padding-top: var(--figma-space-12);
  border-top: calc(1 * var(--rpx)) solid var(--color-line);
}

.summary-question-group__identity {
  gap: var(--figma-space-6);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-question-group__signal {
  width: var(--figma-space-6);
  height: var(--figma-space-6);
  border-radius: var(--figma-radius-pill);
  background: var(--color-faint);
}

.summary-question-group__signal--danger {
  background: var(--color-danger);
}

.summary-question-group__signal--warning {
  background: var(--color-warning);
}

.summary-question-group__signal--success {
  background: var(--figma-color-success-bright);
}

.summary-question-group__count {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-question-group__description {
  margin-top: var(--figma-space-4);
  color: var(--color-faint);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.summary-question-group__numbers {
  display: flex;
  flex-wrap: wrap;
  gap: var(--figma-space-8);
  margin-top: var(--figma-space-10);
}

/* 题号只编码所属分区，不再逐题重复“不会·答错”等长标签。 */
.summary-question-number {
  display: flex;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  align-items: center;
  justify-content: center;
  border: calc(1 * var(--rpx)) solid var(--figma-color-line);
  border-radius: var(--figma-radius-pill);
  background: var(--figma-color-surface-subtle);
  color: var(--figma-color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.summary-question-number--danger {
  border-color: var(--figma-color-danger-soft-strong);
  background: var(--figma-color-danger-soft);
  color: var(--figma-color-danger-deep);
}

.summary-question-number--warning {
  border-color: var(--color-warning-a42);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
}

.summary-question-number--success {
  border-color: var(--figma-color-success);
  background: var(--figma-color-success-soft);
  color: var(--figma-color-success);
}

.summary-question-number--neutral {
  border-color: var(--figma-color-line);
  background: var(--figma-color-surface-subtle);
  color: var(--figma-color-ink);
}

.summary-actions {
  display: flex;
  flex-direction: column;
  gap: var(--figma-space-10);
  margin-top: var(--figma-space-16);
}

.summary-actions__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--figma-space-10);
}

.summary-primary,
.summary-secondary,
.summary-anan {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(92 * var(--rpx));
  border-radius: var(--figma-radius-control);
  font-size: var(--text-body);
  font-weight: 700;
}

.summary-primary {
  background: var(--color-action);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.summary-secondary {
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
}

.summary-anan {
  border: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.summary-boundary {
  margin: var(--figma-space-12) var(--figma-space-10) 0;
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
  text-align: center;
}

.review-content,
.cause-content {
  box-sizing: border-box;
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx)) 0;
}

.pending-write,
.legacy-notice {
  margin: calc(24 * var(--rpx)) calc(40 * var(--rpx)) 0;
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-warning-soft);
  border-radius: var(--radius-32);
  background: var(--figma-color-warning-soft);
}

.pending-write__title,
.legacy-notice__title {
  color: var(--figma-color-warning-deep);
  font-size: var(--text-body);
  font-weight: 700;
}

.pending-write__copy,
.legacy-notice__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
}

.pending-write__action {
  margin-top: calc(20 * var(--rpx));
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}

.legacy-notice {
  margin: 0 0 calc(28 * var(--rpx));
  border-color: var(--color-line-strong);
  background: var(--color-surface);
}

.legacy-notice__title {
  color: var(--color-ink-secondary);
}

.legacy-notice__copy {
  color: var(--ink-2);
}

.review-tabs {
  width: 100%;
  margin-bottom: calc(32 * var(--rpx));
  white-space: nowrap;
}

.review-tabs__inner {
  display: flex;
  justify-content: flex-start;
  gap: calc(16 * var(--rpx));
  width: max-content;
  padding: 0 calc(4 * var(--rpx));
}

.review-tab {
  flex: 0 0 auto;
  width: calc(72 * var(--rpx));
  height: calc(72 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 700;
}

.review-tab--active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.question-review {
  margin-bottom: calc(28 * var(--rpx));
}

.question-review__position {
  margin-bottom: calc(20 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.question-review__material {
  margin-bottom: var(--figma-space-12);
}

.question-review__stem {
  margin-bottom: var(--figma-space-12);
  padding: var(--figma-space-10) 0;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 600;
  line-height: 1.75;
}

.answer-compare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: calc(86 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid;
  border-radius: var(--radius-32);
}

.answer-compare--wrong {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
  color: var(--danger);
}

.answer-compare--right {
  border-color: var(--good-soft);
  background: var(--good-soft);
  color: var(--good);
}

.answer-compare__label {
  flex: none;
  margin-right: calc(20 * var(--rpx));
  font-size: var(--text-caption);
  font-weight: 700;
}

.answer-compare__line {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-start;
}

.answer-compare__content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: calc(4 * var(--rpx));
}

.answer-compare__value {
  font-size: var(--text-caption);
  font-weight: 700;
}

.answer-compare__text {
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.answer-compare__mark {
  flex: none;
  margin-left: calc(16 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 700;
}

.answer-facts {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.answer-fact {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-12);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}

.answer-fact--warning {
  border-color: var(--figma-color-warning-soft);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.structured-review,
.coach-handoff-card,
.reason-card,
.method-card,
.more-evidence-panel,
.followup-card,
.candidate-card {
  box-sizing: border-box;
  margin-bottom: calc(28 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.coach-handoff-card {
  border-color: var(--color-primary-soft-strong);
  background: linear-gradient(145deg, var(--color-surface) 0%, var(--primary-soft) 100%);
}

.coach-handoff-card__head {
  display: flex;
  align-items: center;
  gap: calc(20 * var(--rpx));
}

.coach-handoff-card__mark {
  display: flex;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-24);
  color: var(--color-surface);
  background: var(--primary);
  font-size: var(--text-caption);
  font-weight: 800;
}

.coach-handoff-card__eyebrow {
  color: var(--primary);
  font-size: var(--text-micro);
  font-weight: 800;
}

.coach-handoff-card__title {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
}

.coach-handoff-card__copy,
.coach-handoff-card__next {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.coach-handoff-card__facts {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.coach-handoff-card__fact {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-capsule);
  color: var(--color-ink-secondary);
  background: rgb(255 255 255 / 78%);
  font-size: var(--text-micro);
  font-weight: 700;
}

.coach-handoff-card__next {
  padding-top: calc(18 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
  color: var(--primary);
  font-weight: 700;
}

.structured-review__head {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--rpx));
  margin-bottom: calc(32 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.structured-review__section {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  margin-top: calc(16 * var(--rpx));
  padding: calc(22 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--figma-color-surface-subtle);
  overflow: hidden;
}

.structured-review__section--answer {
  border-color: var(--figma-color-success-soft);
  background: var(--figma-color-success-soft);
}

.structured-review__spark {
  color: var(--color-muted);
  font-size: var(--text-body-lg);
}

.structured-review__label {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
}

.structured-review__answer {
  margin-top: calc(8 * var(--rpx));
  color: var(--figma-color-success);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.65;
}

.structured-review__copy {
  min-width: 0;
  max-width: 100%;
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.75;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.structured-review__source {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.structured-review__warning {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-warning-soft);
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.6;
}

.reason-card__title,
.method-card__title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.reason-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.reason-card__summary {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  margin: 0;
  padding: 0;
  border: 0;
  color: inherit;
  background: transparent;
  text-align: left;
}

.reason-card__summary::after {
  border: 0;
}

.reason-card__optional,
.reason-card__chevron {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.reason-card__chevron {
  flex: 0 0 auto;
  color: var(--primary);
}

.reason-card__body {
  margin-top: calc(28 * var(--rpx));
  padding-top: calc(24 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--line);
}

.reason-card__body-title {
  color: var(--ink-2);
  font-size: var(--text-micro);
