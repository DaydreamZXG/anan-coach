.reflection-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--bg);
  color: var(--ink);
}

.reflection-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.02);
}

.reflection-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 72rpx;
  color: var(--ink);
}

.reflection-back__chevron {
  display: block;
  box-sizing: border-box;
  width: 21rpx;
  height: 21rpx;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.reflection-topbar__title {
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reflection-topbar__side {
  min-width: 72rpx;
  min-height: 72rpx;
}

.reflection-state {
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

.summary-content {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--layout-readable-max);
  margin-right: auto;
  margin-left: auto;
  padding: var(--figma-space-24) var(--figma-page-inset) 0;
}

.summary-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 64rpx;
  min-height: 64rpx;
  color: var(--color-ink);
}

.summary-intro {
  margin-top: var(--figma-space-16);
}

.summary-title {
  color: var(--color-ink);
  font-size: var(--figma-font-page-title);
  font-weight: 700;
  letter-spacing: -1.4rpx;
  line-height: 1.25;
}

.summary-copy {
  margin-top: var(--figma-space-6);
  color: var(--color-muted);
  font-size: var(--figma-font-body-compact);
  font-weight: 500;
  line-height: 1.65;
}

.summary-card,
.summary-insight,
.summary-legacy,
.summary-question-strip {
  box-sizing: border-box;
  margin-top: var(--figma-space-16);
  border: 1rpx solid var(--color-line);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.summary-card {
  padding: var(--figma-space-20);
  border-radius: var(--figma-radius-card-large);
}

.summary-metrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--figma-space-4);
}

.summary-metric {
  min-width: 0;
  text-align: center;
}

.summary-metric__value {
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--figma-font-body-large);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-metric--warning .summary-metric__value {
  color: var(--color-warning);
}

.summary-metric__label {
  margin-top: var(--figma-space-4);
  color: var(--color-faint);
  font-size: var(--figma-font-minimum);
  font-weight: 500;
  line-height: 1.3;
}

.summary-confidence {
  margin-top: var(--figma-space-20);
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-control);
  background: var(--color-surface-soft);
}

.summary-confidence__title {
  color: var(--color-ink);
  font-size: var(--figma-font-micro);
  font-weight: 700;
}

.summary-confidence__list {
  display: grid;
  gap: var(--figma-space-10);
  margin-top: var(--figma-space-12);
}

.summary-confidence__row,
.summary-confidence__label {
  display: flex;
  align-items: center;
}

.summary-confidence__row {
  justify-content: space-between;
  gap: var(--figma-space-8);
}

.summary-confidence__label {
  gap: var(--figma-space-6);
  color: var(--figma-color-ink-tertiary);
  font-size: var(--figma-font-micro);
  font-weight: 500;
}

.summary-confidence__value {
  color: var(--color-ink);
  font-size: var(--figma-font-micro);
  font-weight: 700;
}

.summary-confidence__dot {
  flex: none;
  width: var(--figma-space-6);
  height: var(--figma-space-6);
  border-radius: var(--figma-radius-pill);
  background: var(--color-faint);
}

.summary-confidence__dot--success {
  background: var(--figma-color-success-bright);
}

.summary-confidence__dot--primary {
  background: var(--figma-color-primary-bright);
}

.summary-confidence__dot--warning {
  background: var(--color-warning);
}

.summary-confidence__dot--danger {
  background: var(--color-danger);
}

.summary-insight {
  padding: var(--figma-space-20);
  border-color: var(--figma-color-primary-soft-strong);
  border-radius: var(--figma-radius-card-large);
}

.summary-insight__head {
  display: flex;
  align-items: center;
  gap: var(--figma-space-6);
  color: var(--color-ink);
  font-size: var(--figma-font-body-compact);
  font-weight: 700;
}

.summary-insight__spark,
.summary-insight__toggle {
  color: var(--color-primary);
}

.summary-insight__title {
  margin-top: var(--figma-space-12);
  color: var(--color-ink);
  font-size: var(--figma-font-body-large);
  font-weight: 700;
}

.summary-insight__copy {
  margin-top: var(--figma-space-6);
  color: var(--color-ink-secondary);
  font-size: var(--figma-font-body-compact);
  font-weight: 500;
  line-height: 1.7;
}

.summary-insight__basis {
  margin-top: var(--figma-space-12);
}

.summary-insight__basis-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--figma-space-10);
  padding: var(--figma-space-6) 0;
  color: var(--color-muted);
  font-size: var(--figma-font-micro);
  font-weight: 600;
}

.summary-insight__next,
.summary-insight__verification {
  margin-top: var(--figma-space-8);
  padding: var(--figma-space-10);
  border-radius: var(--figma-radius-small);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--figma-font-micro);
  font-weight: 600;
  line-height: 1.55;
}

.summary-insight__verification {
  background: var(--color-surface-soft);
  color: var(--color-muted);
}

.summary-insight__toggle {
  margin-top: var(--figma-space-12);
  font-size: var(--figma-font-micro);
  font-weight: 700;
}

.summary-legacy {
  padding: var(--figma-space-16);
  border-radius: var(--figma-radius-control);
}

.summary-legacy__title {
  color: var(--color-ink-secondary);
  font-size: var(--figma-font-body-compact);
  font-weight: 700;
}

.summary-legacy__copy {
  margin-top: var(--figma-space-6);
  color: var(--color-muted);
  font-size: var(--figma-font-micro);
  line-height: 1.65;
}

.summary-question-strip {
  display: flex;
  justify-content: space-around;
  gap: var(--figma-space-6);
  padding: var(--figma-space-16) var(--figma-space-12);
  border-radius: var(--figma-radius-card);
}

.summary-question-strip__item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  flex-direction: column;
  gap: var(--figma-space-4);
}

.summary-question-dot {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--figma-font-caption);
  font-weight: 700;
}

.summary-question-dot--danger {
  border-color: var(--figma-color-danger-soft-strong);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.summary-question-dot--warning {
  border-color: var(--figma-color-warning-soft);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.summary-question-dot--success {
  border-color: var(--color-success-soft);
  background: var(--color-success-soft);
  color: var(--color-success);
}

.summary-question-label {
  overflow: hidden;
  width: 100%;
  color: var(--color-faint);
  font-size: var(--figma-font-minimum);
  font-weight: 600;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-actions {
  display: flex;
  flex-direction: column;
  gap: var(--figma-space-10);
  margin-top: var(--figma-space-16);
}

.summary-actions__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--figma-space-10);
}

.summary-primary,
.summary-secondary,
.summary-anan {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  border-radius: var(--figma-radius-control);
  font-size: var(--figma-font-body-compact);
  font-weight: 700;
}

.summary-primary {
  background: var(--color-action);
  color: var(--color-on-primary);
  box-shadow: var(--shadow-primary);
}

.summary-secondary {
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--figma-color-ink-tertiary);
}

.summary-anan {
  border: 1rpx solid var(--figma-color-primary-soft-strong);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.summary-boundary {
  margin: var(--figma-space-12) var(--figma-space-10) 0;
  color: var(--color-faint);
  font-size: var(--figma-font-minimum);
  font-weight: 500;
  line-height: 1.6;
  text-align: center;
}

.review-content,
.cause-content {
  box-sizing: border-box;
  padding: 34rpx 40rpx 0;
}

.pending-write,
.legacy-notice {
  margin: 24rpx 40rpx 0;
  padding: 26rpx;
  border: 1rpx solid var(--figma-color-warning-soft);
  border-radius: 32rpx;
  background: var(--figma-color-warning-soft);
}

.pending-write__title,
.legacy-notice__title {
  color: var(--figma-color-warning-deep);
  font-size: 25rpx;
  font-weight: 700;
}

.pending-write__copy,
.legacy-notice__copy {
  margin-top: 9rpx;
  color: var(--figma-color-warning-deep);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.6;
}

.pending-write__action {
  margin-top: 18rpx;
  color: var(--figma-color-warning-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.legacy-notice {
  margin: 0 0 28rpx;
  border-color: var(--color-line-strong);
  background: var(--color-surface);
}

.legacy-notice__title {
  color: var(--color-ink-secondary);
}

.legacy-notice__copy {
  color: var(--ink-2);
}

.review-tabs {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
}

.review-tab {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 700;
}

.review-tab--active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.14);
}

.question-review {
  margin-bottom: 28rpx;
}

.question-review__position {
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.question-review__material {
  margin-bottom: var(--figma-space-12);
}

.question-review__stem {
  margin-bottom: var(--figma-space-12);
  padding: var(--figma-space-10) 0;
  color: var(--color-ink);
  font-size: var(--figma-font-body);
  font-weight: 600;
  line-height: 1.75;
}

.answer-compare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 86rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid;
  border-radius: 28rpx;
}

.answer-compare--wrong {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
  color: var(--danger);
}

.answer-compare--right {
  border-color: var(--good-soft);
  background: var(--good-soft);
  color: var(--good);
}

.answer-compare__label {
  margin-right: 18rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.answer-compare__value {
  font-size: 24rpx;
  font-weight: 600;
}

.answer-compare__mark {
  font-size: 30rpx;
  font-weight: 700;
}

.answer-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.answer-fact {
  padding: 8rpx 15rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 600;
}

.answer-fact--warning {
  border-color: var(--figma-color-warning-soft);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.structured-review,
.reason-card,
.method-card,
.more-evidence-panel,
.followup-card,
.candidate-card {
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: 34rpx;
  border: 1rpx solid var(--line);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(16, 24, 40, 0.025);
}

.structured-review__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 30rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.structured-review__spark {
  color: var(--primary);
  font-size: 28rpx;
}

.structured-review__label {
  margin-top: 25rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 700;
}

.structured-review__copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.75;
}

.structured-review__source {
  margin-top: 20rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 600;
}

.structured-review__warning {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--figma-color-warning-soft);
  border-radius: 22rpx;
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.6;
}

.reason-card__title,
.method-card__title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.reason-card__copy,
.method-card__copy {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.55;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.tag-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 700;
}

.tag-chip--active {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 6rpx 18rpx rgba(16, 24, 40, 0.12);
}

.reason-textarea,
.cause-textarea,
.evidence-field__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 190rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 26rpx;
  background: var(--bg);
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.7;
}

.method-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 26rpx;
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  text-align: left;
}

.method-option--selected {
  border-color: var(--figma-color-primary-bright);
  background: var(--primary-soft);
}

.method-option__position {
  font-size: 24rpx;
  font-weight: 700;
}

.method-option__answer {
  margin-top: 5rpx;
  color: var(--ink-2);
  font-size: 20rpx;
  font-weight: 500;
}

.method-option__state {
  flex: 0 0 auto;
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 700;
}

.more-evidence-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 86rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 30rpx;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 700;
  text-align: left;
}

.voice-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.voice-head__title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.voice-head__optional,
.evidence-field__optional {
  color: var(--ink-3);
  font-size: 19rpx;
  font-weight: 500;
}

.voice-head__copy {
  margin-top: 7rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  line-height: 1.55;
}

.voice-head__count {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 19rpx;
  font-weight: 700;
}

.voice-permission {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid var(--figma-color-warning-soft);
  border-radius: 24rpx;
  background: var(--figma-color-warning-soft);
}

.voice-permission__title {
  color: var(--figma-color-warning-deep);
  font-size: 23rpx;
  font-weight: 700;
}

.voice-permission__copy {
  margin-top: 7rpx;
  color: var(--figma-color-warning-deep);
  font-size: 20rpx;
  line-height: 1.55;
}

.voice-permission__action {
  margin-top: 14rpx;
  color: var(--figma-color-warning-deep);
  font-size: 21rpx;
  font-weight: 700;
}

.record-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 78rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--figma-color-primary-soft-strong);
  border-radius: 28rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 700;
}

.record-button--active {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
  color: var(--danger);
}

.record-dot {
  box-sizing: border-box;
  width: 17rpx;
  height: 17rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.record-button--active .record-dot {
  border-radius: 3rpx;
  background: currentColor;
}

.voice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 24rpx;
  background: var(--bg);
}

.voice-item__play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--color-surface);
  font-size: 18rpx;
  font-weight: 700;
}

.voice-item__main {
  flex: 1;
  min-width: 0;
}

.voice-item__title {
  color: var(--color-ink-secondary);
  font-size: 20rpx;
  font-weight: 700;
}

.voice-item__state {
  margin-top: 5rpx;
  color: var(--ink-2);
  font-size: 18rpx;
}

.voice-item__state--success {
  color: var(--good);
}

.voice-item__state--error,
.voice-item__failure {
  color: var(--danger);
}

.voice-item__failure {
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 1.45;
}

.voice-item__actions {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
}

.voice-item__action {
  min-height: 46rpx;
  color: var(--ink-2);
  font-size: 18rpx;
  font-weight: 700;
}

.voice-summary,
.voice-message {
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  line-height: 1.5;
}

.voice-message {
  color: var(--ink-2);
}

.voice-upload {
  width: 100%;
  min-height: 74rpx;
  margin-top: 18rpx;
  border-radius: 26rpx;
  background: var(--primary);
  color: var(--color-surface);
  font-size: 22rpx;
  font-weight: 700;
}

.evidence-field {
  margin-top: 30rpx;
}

.evidence-field__label {
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.evidence-field__input {
  min-height: 130rpx;
  margin-top: 14rpx;
}

.reflection-primary,
.reflection-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  border-radius: 40rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.reflection-primary {
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 10rpx 36rpx rgba(16, 24, 40, 0.14);
}

.reflection-secondary {
  margin-top: 18rpx;
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
}

.reflection-boundary {
  margin-top: 20rpx;
  padding: 0 20rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.6;
  text-align: center;
}

.reflection-bottom-spacer {
  height: calc(60rpx + env(safe-area-inset-bottom));
}

.cause-processing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 220rpx);
  padding: 60rpx;
  text-align: center;
}

.cause-spinner {
  box-sizing: border-box;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 42rpx;
  border: 8rpx solid var(--figma-color-primary-soft-strong);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: cause-spin 1.5s linear infinite;
}

@keyframes cause-spin {
  100% {
    transform: rotate(360deg);
  }
}

.cause-processing__title {
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 700;
}

.cause-processing__copy,
.cause-processing__boundary {
  max-width: 580rpx;
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.65;
}

.cause-processing__boundary {
  margin: 28rpx 0 36rpx;
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  background: var(--color-surface);
  color: var(--ink-3);
  font-size: 21rpx;
}

.cause-intro {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin: 12rpx 0 32rpx;
  padding: 30rpx;
  border: 1rpx solid var(--figma-color-primary-soft-strong);
  border-radius: 40rpx;
  background: var(--primary-soft);
}

.cause-intro__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: var(--color-surface);
  font-size: 25rpx;
  font-weight: 800;
}

.cause-intro__title {
  color: var(--primary-deep);
  font-size: 27rpx;
  font-weight: 700;
}

.cause-intro__copy {
  margin-top: 7rpx;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.55;
}

.followup-card__label {
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 700;
}

.followup-card__question {
  margin-top: 15rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.6;
}

.candidate-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.candidate-section__label {
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 700;
}

.candidate-section__copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.7;
}

.candidate-limitations {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--figma-color-warning-soft);
}

.candidate-limitations__line {
  margin-top: 8rpx;
  color: var(--figma-color-warning-deep);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.55;
}

.cause-later {
  width: 100%;
  min-height: 72rpx;
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 700;
}

.completed-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 80rpx);
  padding: 64rpx 48rpx calc(64rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.completed-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 42rpx;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink);
  font-size: 68rpx;
  font-weight: 500;
  box-shadow: 0 16rpx 60rpx rgba(16, 24, 40, 0.045);
}

.completed-title {
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.completed-copy {
  max-width: 610rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.65;
}

.completed-card {
  box-sizing: border-box;
  width: 100%;
  margin: 54rpx 0 56rpx;
  padding: 38rpx;
  border: 1rpx solid var(--line);
  border-radius: 56rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 50rpx rgba(16, 24, 40, 0.035);
}

.completed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  font-weight: 700;
}

.completed-row--accent {
  color: var(--primary);
}

.completed-divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: var(--line);
}

@media (min-width: 700px) {
  .reflection-topbar,
  .review-content,
  .cause-content {
    padding-right: max(40rpx, calc((100vw - 860px) / 2));
    padding-left: max(40rpx, calc((100vw - 860px) / 2));
  }

  .completed-screen {
    max-width: 720px;
    margin: 0 auto;
  }
}
