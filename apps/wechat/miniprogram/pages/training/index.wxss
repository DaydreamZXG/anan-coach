.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.is-pressed {
  opacity: 0.75;
}

.nav {
  padding: 0 32rpx 24rpx;
}

.nav__title {
  font-size: 44rpx;
  font-weight: 700;
  padding-top: 20rpx;
}

.nav__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 主入口：智能组卷（渐变描边卡，与今日主线同语言） */
.hero-wrap {
  margin: 8rpx 32rpx 28rpx;
  background: var(--grad-main);
  padding: 3rpx;
  border-radius: 42rpx;
  box-shadow: var(--shadow-mainline);
}

.hero-card {
  background: var(--surface);
  border-radius: 39rpx;
  padding: 32rpx 34rpx;
}

.hero-card__cap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-card__tag {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--indigo);
  font-weight: 700;
}

.hero-card__arrow {
  font-size: 32rpx;
  color: var(--indigo);
  line-height: 1;
}

.hero-card__name {
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-card__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 8rpx 32rpx 0;
}

.entry {
  padding: 30rpx 26rpx;
  position: relative;
}

.entry__badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #f59e0b;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.4);
}

.entry__glyph {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.entry__glyph--indigo {
  background: linear-gradient(135deg, #5b5ff4, #7a7df7);
}

.entry__glyph--cyan {
  background: linear-gradient(135deg, #0eb9ce, #22d3ee);
}

.entry__glyph--violet {
  background: linear-gradient(135deg, #8b5cf6, #a78bfa);
}

.entry__glyph--amber {
  background: linear-gradient(135deg, #d97f06, #f0a63c);
}

.entry__glyph--green {
  background: linear-gradient(135deg, #0d9f6e, #34d399);
}

.entry__name {
  font-size: 28rpx;
  font-weight: 700;
}

.entry__desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.hint {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}
