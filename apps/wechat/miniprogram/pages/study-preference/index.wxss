.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.sp { display: flex; flex-direction: column; min-height: 100vh; }
.sp-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.sp-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.sp-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.sp-body { flex: 1; min-height: 0; }
.sp-section { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-3); padding: 24rpx 8rpx 16rpx; }
.sp-rhythm {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  border: 2rpx solid var(--line);
  margin-bottom: 20rpx;
}
.sp-rhythm.is-on { border-color: var(--primary); background: var(--primary-soft); }
.sp-rhythm-main { display: flex; flex-direction: column; gap: 6rpx; }
.sp-rhythm-label { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.sp-radio {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid var(--line); flex-shrink: 0;
}
.sp-radio.is-on { border-color: var(--primary); background: var(--primary); box-shadow: inset 0 0 0 6rpx #fff; }
.sp-rest { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 8rpx; }
.sp-rest-chip {
  font-size: 26rpx; color: var(--ink-2);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}
.sp-rest-chip.is-on { color: #fff; background: var(--primary); border-color: var(--primary); }
.sp-hint { display: block; padding: 16rpx 8rpx; }
.sp-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.sp-foot-btn { width: 100%; }
