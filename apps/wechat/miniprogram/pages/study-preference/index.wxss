.preference-page {
  display: flex;
  flex-direction: column;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand-lockup {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.privacy-note {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.step-number {
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
  font-weight: 800;
}
.progress-track {
  height: 8rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: var(--radius-capsule);
  background: var(--color-primary-a08);
}
.progress-value {
  width: 84%;
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}
.intro {
  margin-top: 48rpx;
}
.page-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  text-align: center;
}
.state-title {
  margin-top: 28rpx;
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.state-copy {
  max-width: 560rpx;
  margin: 16rpx 0 32rpx;
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.65;
}
.request-id {
  margin-top: 12rpx;
  color: var(--color-faint);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}
.recovery-banner {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(239, 166, 68, 0.26);
  border-radius: var(--radius-24);
  background: var(--color-warning-soft);
}
.recovery-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--radius-12);
  background: var(--color-warning);
  color: var(--color-surface);
  font-weight: 800;
}
.recovery-title {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 800;
}
.recovery-copy {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.5;
}
.budget-card,
.schedule-card {
  margin-top: 28rpx;
}
.budget-divider,
.schedule-divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: var(--color-line);
}
.field-label {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 800;
}
.field-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.time-choice {
  min-width: 0;
}
.time-choice__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.time-choice__current {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 800;
}
.time-options {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}
.time-options__inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx 8rpx;
}
.time-option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 92rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}
.time-option--active {
  border-color: transparent;
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-primary);
}
.time-option__label {
  font-size: var(--text-micro);
  font-weight: 800;
}
.time-option__caption {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
}
.time-option--active .time-option__caption {
  color: rgba(255, 255, 255, 0.78);
}
.schedule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.schedule-tag {
  padding: 8rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 800;
}
.schedule-tag--rest {
  background: var(--color-success-soft);
  color: var(--color-success);
}
.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}
.weekday-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.weekday-chip--mock {
  border-color: transparent;
  background: var(--color-primary);
  color: var(--color-surface);
  font-weight: 800;
  box-shadow: var(--shadow-primary);
}
.weekday-chip--rest {
  border-color: var(--color-primary-a24);
  background: var(--color-success-soft);
  color: var(--color-success);
  font-weight: 800;
}
.rhythm-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}
.rhythm-item {
  padding: 24rpx 12rpx;
  border-radius: var(--radius-24);
  background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
  text-align: center;
}
.rhythm-item__value {
  display: block;
  color: var(--color-ink);
  font-size: var(--text-title-sm);
}
.rhythm-item__label {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.weekly-total {
  margin: 20rpx 0 28rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.65;
}
.weekly-total__value {
  color: var(--color-ink);
  font-weight: 800;
}
.error-banner {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-16);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--text-micro);
  line-height: 1.55;
}
