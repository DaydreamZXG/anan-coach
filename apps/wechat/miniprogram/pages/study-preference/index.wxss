.preference-page {
  display: flex;
  flex-direction: column;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand-lockup {
  display: flex;
  align-items: center;
  gap: calc(16 * var(--rpx));
}
.privacy-note {
  margin-top: calc(4 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.step-number {
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
  font-weight: 800;
}
.progress-track {
  height: calc(8 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
  overflow: hidden;
  border-radius: var(--radius-capsule);
  background: var(--color-primary-a08);
}
.progress-value {
  width: 84%;
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}
.intro {
  margin-top: calc(48 * var(--rpx));
}
.page-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  text-align: center;
}
.state-title {
  margin-top: calc(28 * var(--rpx));
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.state-copy {
  max-width: calc(560 * var(--rpx));
  margin: calc(16 * var(--rpx)) 0 calc(32 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.65;
}
.request-id {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-faint);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}
.recovery-banner {
  display: flex;
  gap: calc(20 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(239, 166, 68, 0.26);
  border-radius: var(--radius-24);
  background: var(--color-warning-soft);
}
.recovery-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: calc(42 * var(--rpx));
  height: calc(42 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--color-warning);
  color: var(--color-surface);
  font-weight: 800;
}
.recovery-title {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 800;
}
.recovery-copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.5;
}
.budget-card,
.schedule-card {
  margin-top: calc(28 * var(--rpx));
}
.budget-divider,
.schedule-divider {
  height: calc(1 * var(--rpx));
  margin: calc(28 * var(--rpx)) 0;
  background: var(--color-line);
}
.field-label {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 800;
}
.field-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.time-choice {
  min-width: 0;
}
.time-choice__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}
.time-choice__current {
  flex: none;
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 800;
}
.time-options {
  width: 100%;
  margin-top: calc(20 * var(--rpx));
  white-space: nowrap;
}
.time-options__inner {
  display: inline-flex;
  gap: calc(12 * var(--rpx));
  padding: 0 calc(4 * var(--rpx)) calc(8 * var(--rpx));
}
.time-options__hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: calc(8 * var(--rpx));
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.4;
}
.time-options__hint-arrow {
  color: var(--color-primary);
  font-family: var(--font-family-data);
  font-weight: 800;
}
.time-option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: calc(112 * var(--rpx));
  height: calc(92 * var(--rpx));
  padding: 0 calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}
.time-option--active {
  border-color: transparent;
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-primary);
}
.time-option__label {
  font-size: var(--text-micro);
  font-weight: 800;
}
.time-option__caption {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
}
.time-option--active .time-option__caption {
  color: rgba(255, 255, 255, 0.78);
}
.schedule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.schedule-tag {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 800;
}
.schedule-tag--rest {
  background: var(--color-success-soft);
  color: var(--color-success);
}
.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: calc(8 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}
.weekday-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: calc(60 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.weekday-chip--mock {
  border-color: transparent;
  background: var(--color-primary);
  color: var(--color-surface);
  font-weight: 800;
  box-shadow: var(--shadow-primary);
}
.weekday-chip--rest {
  border-color: var(--color-primary-a24);
  background: var(--color-success-soft);
  color: var(--color-success);
  font-weight: 800;
}
.rhythm-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(12 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}
.rhythm-item {
  padding: calc(24 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-24);
  background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
  text-align: center;
}
.rhythm-item__value {
  display: block;
  color: var(--color-ink);
  font-size: var(--text-title-sm);
}
.rhythm-item__label {
  display: block;
  margin-top: calc(4 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.weekly-total {
  margin: calc(20 * var(--rpx)) 0 calc(28 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.65;
}
.weekly-total__value {
  color: var(--color-ink);
  font-weight: 800;
}
.error-banner {
  margin: 0 0 calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--text-micro);
  line-height: 1.55;
}
