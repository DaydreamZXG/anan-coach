<view class="s9-page s9-page--with-dock preference-page">
  <view class="s9-hero">
    <view class="s9-title">把每周时间改成真实可执行的安排</view>
    <view class="s9-subtitle">工作日和周末直接按半小时选择；保存后，岸岸会按新时间安排后续计划。</view>
    <view wx:if="{{state && state.draft}}" class="s9-chip-row"><view class="s9-chip s9-chip--primary">工作日 {{state.presentation.weekdayDurationLabel}}</view><view class="s9-chip">周末 {{state.presentation.weekendDurationLabel}}</view></view>
  </view>

  <view wx:if="{{!state || state.status === 'loading'}}" class="page-state">
    <view class="state-title">正在读取你的周节奏</view>
    <view class="state-copy">正在读取你当前的学习时间安排。</view>
  </view>

  <view wx:elif="{{state.status === 'error'}}" class="page-state">
    <view class="state-title">时间偏好没有加载完成</view>
    <view class="state-copy">{{state.error.message}}</view>
    <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
    <ui-button label="重新读取" bind:action="retry" />
  </view>

  <block wx:else>
    <view wx:if="{{state.pendingRecovery}}" class="recovery-banner">
      <view class="recovery-mark">↻</view>
      <view><view class="recovery-title">上一次保存结果还不确定</view><view class="recovery-copy">内容已暂时锁定；本次只会确认刚才的结果，不会重复保存。</view></view>
    </view>

    <view class="budget-card s9-card">
      <view class="time-choice">
        <view class="time-choice__head">
          <view><view class="field-label">工作日可学习</view><view class="field-copy">按 0.5 小时选择，不需要换算分钟</view></view>
          <view class="time-choice__current type-data">{{state.presentation.weekdayDurationLabel}}</view>
        </view>
        <scroll-view scroll-x scroll-with-animation class="time-options" enhanced show-scrollbar="{{false}}" scroll-into-view="{{weekdayMinutesTarget}}" aria-label="工作日可学习时长，左右滑动查看更多">
          <view class="time-options__inner">
            <view id="weekday-minutes-{{item.minutes}}" hover-class="item--hover" wx:for="{{timeOptions}}" wx:key="minutes" class="time-option {{state.draft.weekdayMinutes === item.minutes ? 'time-option--active' : ''}}" data-field="weekdayMinutes" data-minutes="{{item.minutes}}" bindtap="selectMinutes">
              <text class="time-option__label">{{item.label}}</text>
              <text class="time-option__caption">{{item.caption}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="time-options__hint" aria-hidden="true"><text class="time-options__hint-arrow">↔</text><text>左右滑动查看更多时长</text></view>
      </view>
      <view class="budget-divider"></view>
      <view class="time-choice">
        <view class="time-choice__head">
          <view><view class="field-label">周末可学习</view><view class="field-copy">容纳模考、申论套题或完整材料训练</view></view>
          <view class="time-choice__current type-data">{{state.presentation.weekendDurationLabel}}</view>
        </view>
        <scroll-view scroll-x scroll-with-animation class="time-options" enhanced show-scrollbar="{{false}}" scroll-into-view="{{weekendMinutesTarget}}" aria-label="周末可学习时长，左右滑动查看更多">
          <view class="time-options__inner">
            <view id="weekend-minutes-{{item.minutes}}" hover-class="item--hover" wx:for="{{timeOptions}}" wx:key="minutes" class="time-option {{state.draft.weekendMinutes === item.minutes ? 'time-option--active' : ''}}" data-field="weekendMinutes" data-minutes="{{item.minutes}}" bindtap="selectMinutes">
              <text class="time-option__label">{{item.label}}</text>
              <text class="time-option__caption">{{item.caption}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="time-options__hint" aria-hidden="true"><text class="time-options__hint-arrow">↔</text><text>左右滑动查看更多时长</text></view>
      </view>
    </view>

    <view class="schedule-card s9-card">
      <view class="schedule-head"><view><view class="field-label">整卷模考日</view><view class="field-copy">每周一次稳定标尺</view></view><view class="schedule-tag">1 天</view></view>
      <view class="weekday-row">
        <view hover-class="item--hover" wx:for="{{weekdays}}" wx:key="value" class="weekday-chip {{state.draft.mockExamDay === item.value ? 'weekday-chip--mock' : ''}}" data-field="mockExamDay" data-value="{{item.value}}" bindtap="selectDay">{{item.label}}</view>
      </view>
      <view class="schedule-divider"></view>
      <view class="schedule-head"><view><view class="field-label">固定恢复日</view><view class="field-copy">不排新知识，只做轻量闭环或休息</view></view><view class="schedule-tag schedule-tag--rest">1 天</view></view>
      <view class="weekday-row">
        <view hover-class="item--hover" wx:for="{{weekdays}}" wx:key="value" class="weekday-chip {{state.draft.fixedRestDay === item.value ? 'weekday-chip--rest' : ''}}" data-field="fixedRestDay" data-value="{{item.value}}" bindtap="selectDay">{{item.label}}</view>
      </view>
    </view>

    <view class="rhythm-strip">
      <view class="rhythm-item"><text class="rhythm-item__value type-data">{{state.summary.focusedTrainingDays}}</text><text class="rhythm-item__label">针对训练</text></view>
      <view class="rhythm-item"><text class="rhythm-item__value type-data">{{state.summary.mockExamDays}}</text><text class="rhythm-item__label">整卷模考</text></view>
      <view class="rhythm-item"><text class="rhythm-item__value type-data">{{state.summary.recoveryDays}}</text><text class="rhythm-item__label">恢复日</text></view>
    </view>
    <view class="weekly-total">常规每周可学约 <text class="weekly-total__value type-data">{{state.presentation.weeklyDurationLabel}}</text>；行测和申论共用这些时间，不会把某一科只当作剩余时间。</view>

    <view wx:if="{{state.validationError}}" class="error-banner">{{state.validationError}}</view>
    <view wx:if="{{state.error}}" class="error-banner">
      <view>{{state.error.message}}</view>
      <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
    </view>
    <view class="s9-action-dock"><button hover-class="item--hover" class="s9-primary-button" loading="{{state.saving}}" bindtap="submit">{{state.pendingRecovery ? '确认上次保存结果' : '保存每周学习时间'}}</button></view>
  </block>
</view>
