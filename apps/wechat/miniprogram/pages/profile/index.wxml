<view class="page">
  <view class="header" style="padding-top: {{statusBarHeight + 10}}px">
    <view class="header__glow"></view>
    <view class="user">
      <view class="user__avatar">岸</view>
      <view class="user__info">
        <view class="user__name">岸岸学员</view>
        <view class="user__sub">把分差，变成今天的行动</view>
      </view>
    </view>
  </view>

  <view class="groups">
    <view class="card group" wx:for="{{groups}}" wx:key="title" wx:for-item="group">
      <view
        wx:for="{{group.items}}"
        wx:key="id"
        class="row"
        hover-class="is-pressed"
        data-id="{{item.id}}"
        bind:tap="onEntry"
      >
        <view class="row__name">{{item.name}}</view>
        <view class="row__right">
          <text wx:if="{{item.meta}}" class="row__meta">{{item.meta}}</text>
          <text class="row__arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="foot">岸岸 · AI 国考教练</view>
</view>
