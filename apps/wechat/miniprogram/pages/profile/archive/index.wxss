.archive-page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.archive-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.archive-request {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.archive-scroll {
  min-height: 0;
  flex: 1;
}

.archive-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(256 * var(--rpx));
}

.archive-notice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
  padding: calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-a16);
  border-radius: var(--radius-48);
  background: var(--color-primary-soft-a52);
}

.notice-spark {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
  flex: none;
  padding-top: calc(2 * var(--rpx));
}

.notice-body {
  min-width: 0;
  flex: 1;
}

.notice-title {
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.notice-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.625;
}

.archive-list {
  display: flex;
  flex-direction: column;
  gap: calc(32 * var(--rpx));
  margin-top: calc(64 * var(--rpx));
}

.archive-card {
  display: flex;
  min-height: calc(180 * var(--rpx));
  align-items: center;
  gap: calc(32 * var(--rpx));
}

.module-icon {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: calc(96 * var(--rpx));
  height: calc(96 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.module-icon--blue {
  background: var(--figma-color-info-soft);
  color: var(--figma-color-info-bright);
}

.module-icon--orange {
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning);
}

.module-icon--green {
  background: var(--good-soft);
  color: var(--good);
}

.module-icon--indigo {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.module-icon--rose {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.module-symbol {
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
}

.module-main {
  min-width: 0;
  flex: 1;
}

.module-name {
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.module-copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: calc(36 * var(--rpx));
  white-space: normal;
}

.module-actions {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: calc(16 * var(--rpx));
}

.module-status {
  padding: calc(4 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-12);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(30 * var(--rpx));
}

.module-status--complete {
  background: var(--line);
  color: var(--ink-2);
}

.module-status--incomplete {
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
}

button.module-edit {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--primary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.module-edit::after {
  border: 0;
}

button.archive-primary {
  gap: calc(16 * var(--rpx));
}

.archive-primary::after {
  border: 0;
}

.archive-arrow {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

@media (min-width: 768px) {
  .archive-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }
}

/* 排版总纲·列表模板：档案模块卡宽屏 2 列（容器放宽到 readable-max）。 */
@media (min-width: 1024px) {
  .archive-content {
    max-width: var(--layout-readable-max);
  }

  .archive-list {
    display: grid;
    align-items: stretch;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .archive-list > .archive-card {
    height: 100%;
    box-sizing: border-box;
  }
}
