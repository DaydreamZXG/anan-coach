.archive-page {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: #f7f9fc;
  color: #101828;
}

.archive-nav {
  box-sizing: border-box;
  display: flex;
  height: 112rpx;
  align-items: center;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
  background: rgba(255, 255, 255, 0.8);
}

.archive-back {
  box-sizing: border-box;
  display: flex;
  width: 64rpx;
  height: 80rpx;
  align-items: center;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.archive-back::after {
  border: 0;
}

.archive-back__icon {
  width: 18rpx;
  height: 18rpx;
  transform: rotate(45deg);
  border-bottom: 3rpx solid #101828;
  border-left: 3rpx solid #101828;
}

.archive-nav__title {
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.archive-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.archive-request {
  margin-top: 20rpx;
  color: #98a2b3;
  font-size: 20rpx;
  text-align: center;
}

.archive-scroll {
  min-height: 0;
  flex: 1;
}

.archive-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 216rpx;
}

.archive-notice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 42rpx;
  border: 1rpx solid rgba(224, 231, 255, 0.5);
  border-radius: 48rpx;
  background: rgba(238, 242, 255, 0.5);
}

.notice-spark {
  flex: none;
  padding-top: 2rpx;
  color: #615fff;
  font-size: 34rpx;
  line-height: 1;
}

.notice-body {
  min-width: 0;
  flex: 1;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.notice-copy {
  margin-top: 8rpx;
  color: #4a5565;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.625;
}

.archive-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 60rpx;
}

.archive-card {
  box-sizing: border-box;
  display: flex;
  min-height: 160rpx;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx 36rpx;
  border: 1rpx solid #f9fafb;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.module-icon {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.module-icon--blue {
  background: #eff6ff;
  color: #2b7fff;
}

.module-icon--orange {
  background: #fff7ed;
  color: #ff6900;
}

.module-icon--green {
  background: #ecfdf5;
  color: #00bc7d;
}

.module-icon--indigo {
  background: #eef2ff;
  color: #615fff;
}

.module-icon--rose {
  background: #fff1f2;
  color: #f43f5e;
}

.module-symbol {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  color: inherit;
}

.module-symbol--person::before {
  position: absolute;
  top: 1rpx;
  left: 13rpx;
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentcolor;
  border-radius: 50%;
  content: "";
}

.module-symbol--person::after {
  position: absolute;
  bottom: 1rpx;
  left: 6rpx;
  box-sizing: border-box;
  width: 28rpx;
  height: 18rpx;
  border: 3rpx solid currentcolor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  content: "";
}

.module-symbol--shield {
  box-sizing: border-box;
  width: 31rpx;
  height: 36rpx;
  margin: 2rpx auto;
  border: 3rpx solid currentcolor;
  border-radius: 10rpx 10rpx 16rpx 16rpx;
}

.module-symbol--shield::after {
  position: absolute;
  top: 13rpx;
  left: 12rpx;
  width: 10rpx;
  height: 5rpx;
  transform: rotate(-45deg);
  border-bottom: 3rpx solid currentcolor;
  border-left: 3rpx solid currentcolor;
  content: "";
}

.module-symbol--pin {
  box-sizing: border-box;
  width: 30rpx;
  height: 36rpx;
  margin: 1rpx auto 0;
  border: 3rpx solid currentcolor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.module-symbol--pin::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  box-sizing: border-box;
  width: 9rpx;
  height: 9rpx;
  border: 2rpx solid currentcolor;
  border-radius: 50%;
  content: "";
}

.module-symbol--clock {
  box-sizing: border-box;
  border: 3rpx solid currentcolor;
  border-radius: 50%;
}

.module-symbol--clock::before,
.module-symbol--clock::after {
  position: absolute;
  top: 9rpx;
  left: 18rpx;
  width: 3rpx;
  border-radius: 99rpx;
  background: currentcolor;
  transform-origin: 50% 100%;
  content: "";
}

.module-symbol--clock::before {
  height: 12rpx;
}

.module-symbol--clock::after {
  height: 10rpx;
  transform: rotate(120deg);
}

.module-symbol--target {
  box-sizing: border-box;
  border: 3rpx solid currentcolor;
  border-radius: 50%;
}

.module-symbol--target::before,
.module-symbol--target::after {
  position: absolute;
  border: 3rpx solid currentcolor;
  border-radius: 50%;
  content: "";
}

.module-symbol--target::before {
  inset: 7rpx;
}

.module-symbol--target::after {
  inset: 15rpx;
  border-width: 2rpx;
}

.module-main {
  min-width: 0;
  flex: 1;
}

.module-name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.module-copy {
  overflow: hidden;
  margin-top: 4rpx;
  color: #6a7282;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.module-actions {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.module-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.module-status--complete {
  background: #f3f4f6;
  color: #6a7282;
}

.module-status--incomplete {
  background: #fff7ed;
  color: #f54900;
}

.module-edit {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #615fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.module-edit::after {
  border: 0;
}

.archive-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f3f4f6;
  background: rgba(255, 255, 255, 0.9);
}

.archive-primary {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 48rpx;
  background: #101828;
  color: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.12);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.archive-primary::after {
  border: 0;
}

.archive-arrow {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.archive-arrow::before {
  position: absolute;
  top: 13rpx;
  left: 1rpx;
  width: 23rpx;
  height: 3rpx;
  border-radius: 99rpx;
  background: currentcolor;
  content: "";
}

.archive-arrow::after {
  position: absolute;
  top: 7rpx;
  right: 1rpx;
  width: 11rpx;
  height: 11rpx;
  transform: rotate(-45deg);
  border-right: 3rpx solid currentcolor;
  border-bottom: 3rpx solid currentcolor;
  content: "";
}

@media (min-width: 768px) {
  .archive-content,
  .archive-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
