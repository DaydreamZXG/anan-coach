.archive-page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.archive-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.archive-request {
  margin-top: 20rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.archive-scroll {
  min-height: 0;
  flex: 1;
}

.archive-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 256rpx;
}

.archive-notice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 40rpx;
  border: 1rpx solid var(--color-primary-a16);
  border-radius: var(--radius-48);
  background: var(--color-primary-soft-a52);
}

.notice-spark {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  padding-top: 2rpx;
}

.notice-body {
  min-width: 0;
  flex: 1;
}

.notice-title {
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 42rpx;
}

.notice-copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.625;
}

.archive-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 64rpx;
}

.archive-card {
  display: flex;
  min-height: 180rpx;
  align-items: center;
  gap: 32rpx;
}

.module-icon {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.module-icon--blue {
  background: var(--figma-color-info-soft);
  color: var(--figma-color-info-bright);
}

.module-icon--orange {
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning);
}

.module-icon--green {
  background: var(--good-soft);
  color: var(--good);
}

.module-icon--indigo {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.module-icon--rose {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.module-symbol {
  width: 40rpx;
  height: 40rpx;
}

.module-main {
  min-width: 0;
  flex: 1;
}

.module-name {
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}

.module-copy {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 36rpx;
  white-space: normal;
}

.module-actions {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.module-status {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-12);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 30rpx;
}

.module-status--complete {
  background: var(--line);
  color: var(--ink-2);
}

.module-status--incomplete {
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
}

button.module-edit {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--primary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 36rpx;
}

.module-edit::after {
  border: 0;
}

button.archive-primary {
  gap: 16rpx;
}

.archive-primary::after {
  border: 0;
}

.archive-arrow {
  width: 36rpx;
  height: 36rpx;
}

@media (min-width: 768px) {
  .archive-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }
}
