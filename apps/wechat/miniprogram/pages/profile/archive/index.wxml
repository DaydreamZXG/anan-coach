<view class="archive-page">
  <safe-top mode="status" gap="48" />
  <view class="archive-nav">
    <button class="archive-back" aria-label="返回" bindtap="back">
      <image class="archive-back__icon" src="/assets/icons/navigation/chevron-left-ink.svg" mode="aspectFit" />
    </button>
    <view class="archive-nav__title">我的备考档案</view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="archive-state">
    <state-view state="loading" title="正在读取备考档案" description="会核对身份、资格、岗位、时间和能力证据。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="archive-state">
    <state-view state="error" title="备考档案没有加载成功" description="{{errorMessage}}" actionText="重新读取" bindaction="retry" />
    <view wx:if="{{requestId}}" class="archive-request">问题编号 · {{requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="archive-scroll" enhanced show-scrollbar="{{false}}">
      <view class="archive-content">
        <view class="archive-notice">
          <image class="notice-spark" src="/assets/icons/profile/archive-spark.svg" mode="aspectFit" aria-hidden="true" />
          <view class="notice-body">
            <view class="notice-title">{{warningTitle}}</view>
            <view class="notice-copy">{{warningCopy}}</view>
          </view>
        </view>

        <view class="archive-list">
          <view wx:for="{{modules}}" wx:key="key" class="archive-card">
            <view class="module-icon module-icon--{{item.tone}}">
              <image class="module-symbol" src="/assets/icons/profile/archive-{{item.icon}}.svg" mode="aspectFit" aria-hidden="true" />
            </view>
            <view class="module-main">
              <view class="module-name">{{item.name}}</view>
              <view class="module-copy">{{item.description}}</view>
            </view>
            <view class="module-actions">
              <view class="module-status module-status--{{item.statusKind}}">{{item.statusLabel}}</view>
              <button class="module-edit" data-key="{{item.key}}" bindtap="editModule">修改</button>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="archive-dock">
      <button class="archive-primary" bindtap="openAssessment">
        <text>查看整体档案评估</text>
        <image class="archive-arrow" src="/assets/icons/anan/arrow-right-white.svg" mode="aspectFit" />
      </button>
    </view>
  </block>
</view>
