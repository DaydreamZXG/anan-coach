.qualification-edit-page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.choice-row,
.choice-chip,
.year-option,
.text-action {
  margin: 0;
  border: 0;
}

.choice-row::after,
.choice-chip::after,
.year-option::after,
.text-action::after {
  border: 0;
}

.qualification-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.step-head {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(28 * var(--rpx));
  padding: calc(40 * var(--rpx)) calc(40 * var(--rpx)) calc(28 * var(--rpx));
  background: rgba(255, 255, 255, 0.8);
}

.step-main {
  min-width: 0;
  flex: 1;
}

.step-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(32 * var(--rpx));
}

.step-title {
  margin-top: calc(8 * var(--rpx));
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.8 * var(--rpx));
  line-height: calc(52 * var(--rpx));
}

.step-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.55;
}

.step-badge {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(30 * var(--rpx));
}

.progress-track {
  height: calc(6 * var(--rpx));
  overflow: hidden;
  background: var(--color-line-strong);
}

.progress-value {
  height: 100%;
  border-radius: 0 var(--radius-capsule) var(--radius-capsule) 0;
  background: var(--gradient-ai);
  transition: width var(--motion-slow) var(--ease-out);
}

@media (prefers-reduced-motion: reduce) {
  .progress-value {
    transition-duration: 0.01ms;
  }
}

.progress-value--0 {
  width: 25%;
}

.progress-value--1 {
  width: 50%;
}

.progress-value--2 {
  width: 75%;
}

.progress-value--3 {
  width: 100%;
}

.qualification-scroll {
  min-height: 0;
  flex: 1;
}

.qualification-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(250 * var(--rpx));
}

.boundary-notice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(255, 237, 212, 0.5);
  border-radius: var(--radius-40);
  background: rgba(255, 247, 237, 0.5);
}

.notice-icon {
  display: flex;
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border: calc(3 * var(--rpx)) solid var(--figma-color-warning);
  border-radius: 50%;
  color: var(--figma-color-warning);
  font-size: var(--text-micro);
  font-weight: 800;
  line-height: 1;
}

.notice-copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.625;
}

.boundary-notice + .form-card {
  margin-top: calc(40 * var(--rpx));
}

.card-title {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.3 * var(--rpx));
  line-height: calc(42 * var(--rpx));
}

.card-copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.625;
}

.field-label {
  margin-top: calc(40 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.field-label--spaced {
  margin-top: calc(48 * var(--rpx));
}

.input-field {
  box-sizing: border-box;
  display: flex;
  height: calc(96 * var(--rpx));
  align-items: center;
  gap: calc(20 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
}

.input-field--filled {
  border-color: var(--color-primary-soft-strong);
  background: var(--color-surface);
}

.search-icon {
  box-sizing: border-box;
  position: relative;
  width: calc(27 * var(--rpx));
  height: calc(27 * var(--rpx));
  flex: none;
  border: calc(3 * var(--rpx)) solid var(--ink-3);
  border-radius: 50%;
}

.search-icon::after {
  position: absolute;
  right: calc(-8 * var(--rpx));
  bottom: calc(-6 * var(--rpx));
  width: calc(11 * var(--rpx));
  height: calc(3 * var(--rpx));
  transform: rotate(45deg);
  border-radius: var(--radius-capsule);
  background: var(--ink-3);
  content: "";
}

.text-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 600;
}

.optional-label {
  flex: none;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(24 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.picker-field--wide {
  grid-column: 1 / -1;
}

.picker-label {
  margin-left: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.picker-control {
  box-sizing: border-box;
  display: flex;
  height: calc(96 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  gap: calc(12 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 600;
}

.picker-control--filled {
  color: var(--ink);
  font-weight: 700;
}

.picker-chevron {
  width: calc(11 * var(--rpx));
  height: calc(11 * var(--rpx));
  flex: none;
  transform: rotate(45deg) translateY(calc(-3 * var(--rpx)));
  border-right: calc(2 * var(--rpx)) solid var(--ink-3);
  border-bottom: calc(2 * var(--rpx)) solid var(--ink-3);
}

.option-stack {
  display: flex;
  flex-direction: column;
  gap: calc(16 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
}

.choice-row {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: calc(96 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(2 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  text-align: left;
}

.choice-row--selected {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary-deep);
}

.choice-title {
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(38 * var(--rpx));
}

.choice-copy {
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: calc(32 * var(--rpx));
}

.choice-check {
  display: flex;
  width: calc(34 * var(--rpx));
  height: calc(34 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 800;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
}

.choice-chip {
  min-height: calc(68 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: calc(68 * var(--rpx));
}

.choice-chip--selected {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}

.year-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: calc(12 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
}

.year-option {
  min-width: 0;
  height: calc(72 * var(--rpx));
  padding: 0;
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(72 * var(--rpx));
}

.year-option--selected {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary);
}

.field-help {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.review-card {
  padding-bottom: calc(32 * var(--rpx));
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.review-main {
  min-width: 0;
  flex: 1;
}

.review-badge {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(30 * var(--rpx));
}

.review-list {
  overflow: hidden;
  margin-top: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface-soft);
}

.review-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(28 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--line);
  font-size: var(--text-caption);
  line-height: calc(34 * var(--rpx));
}

.review-row:last-child {
  border-bottom: 0;
}

.review-label {
  flex: none;
  color: var(--ink-3);
  font-weight: 600;
}

.review-value {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-weight: 700;
  text-align: right;
}

.confirm-copy {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.55;
}

.recovery-banner,
.error-banner {
  box-sizing: border-box;
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-32);
}

.recovery-banner {
  display: flex;
  align-items: flex-start;
  gap: calc(20 * var(--rpx));
  background: var(--primary-soft);
  color: var(--color-muted);
}

.recovery-mark {
  flex: none;
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
  line-height: calc(36 * var(--rpx));
}

.recovery-title {
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.recovery-copy {
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: calc(32 * var(--rpx));
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.55;
}

.request-id {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  line-height: calc(28 * var(--rpx));
  text-align: center;
}

.success-page {
  box-sizing: border-box;
  display: flex;
  min-height: calc(100vh - calc(112 * var(--rpx)));
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: calc(96 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(48 * var(--rpx)) + env(safe-area-inset-bottom));
  text-align: center;
}

.success-mark {
  display: flex;
  width: calc(112 * var(--rpx));
  height: calc(112 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-32);
  background: var(--good-soft);
}

.success-icon {
  width: calc(52 * var(--rpx));
  height: calc(52 * var(--rpx));
}

.success-kicker {
  margin-top: calc(40 * var(--rpx));
  color: var(--good);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(34 * var(--rpx));
}

.success-title {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.6 * var(--rpx));
  line-height: 1.35;
}

.success-copy {
  max-width: calc(620 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.625;
}

.success-card {
  box-sizing: border-box;
  width: 100%;
  margin-top: calc(48 * var(--rpx));
  padding: calc(28 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  text-align: left;
}

.success-row {
  display: flex;
  align-items: center;
  gap: calc(16 * var(--rpx));
  padding: calc(12 * var(--rpx)) 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: calc(34 * var(--rpx));
}

.success-check {
  color: var(--good);
  font-size: var(--text-body);
  font-weight: 800;
}

.success-actions {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: calc(16 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
}

.text-action {
  min-height: calc(72 * var(--rpx));
  background: transparent;
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(72 * var(--rpx));
}

/* 平板层：分步表单与成功卡限可读宽。 */
@media (min-width: 768px) {
  .step-head,
  .progress-track,
  .qualification-scroll,
  .success-card,
  .success-actions {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
  }
}
