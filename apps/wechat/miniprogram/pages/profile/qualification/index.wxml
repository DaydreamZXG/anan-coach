<view class="s9-page s9-page--with-dock onboarding qualification-profile">
  <view wx:if="{{loadingProfile}}" class="loading-state">
    <anan-companion size="large" intent="thinking" context="plan" animate />
    <view class="loading-title">正在读取报考资格档案</view>
    <view class="loading-copy">岗位推荐只用你确认过的信息，普通工作经历不会自动算成基层经历。</view>
  </view>
  <view wx:elif="{{loadFailed}}" class="loading-state">
    <anan-companion size="large" intent="rest" context="emotion" />
    <view class="loading-title">资格档案没有加载成功</view>
    <view class="loading-copy">{{error}}</view>
    <ui-button label="重新读取" bind:action="retryLoad" />
  </view>
  <block wx:elif="{{!saved}}">
    <view class="s9-hero">
      <view class="s9-kicker">账户资料 · 影响可报岗位</view>
      <view class="s9-title">报考资格档案</view>
      <view class="s9-subtitle">保存后，岗位推荐会按新信息重新计算可报范围。</view>
      <view class="s9-chip-row"><view class="s9-chip s9-chip--primary">当前 v{{profileVersion}}</view><view class="s9-chip">本人确认</view></view>
    </view>

    <view class="progress-track"><view class="progress-value progress-value--{{current}}"></view></view>

    <view class="s9-card s9-card--primary onboarding-step-card">
      <view class="s9-card-kicker">第 {{current + 1}} 步 · {{steps[current].label}}</view>
      <view class="s9-card-title">{{steps[current].title}}</view>
      <view class="s9-card-copy">{{steps[current].copy}}</view>
      <view class="step-count type-data">{{current + 1}} / 4</view>
    </view>

    <view class="form-card s9-card">
      <block wx:if="{{current === 0}}">
        <view class="field-label">最高学历</view>
        <view class="choice-grid choice-grid--four">
          <view hover-class="item--hover" wx:for="{{['大专','本科','硕士','博士']}}" wx:key="*this" class="choice {{education === item ? 'choice--selected' : ''}}" data-value="{{item}}" bindtap="chooseEducation">
            <view class="choice-dot"></view><text>{{item}}</text>
          </view>
        </view>
        <view class="field-label field-label--spaced">毕业证专业名称</view>
        <view class="input-shell {{major ? 'input-shell--filled' : ''}}">
          <input class="input-shell__control" value="{{major}}" maxlength="80" placeholder="例如：法学、汉语言文学" bindinput="inputMajor" />
          <view class="input-badge">原文</view>
        </view>
        <view class="field-help">请按毕业证填写。专业是岗位推荐的第一权重之一，不能只填“经管类”“计算机类”。</view>
      </block>

      <block wx:elif="{{current === 1}}">
        <view class="field-label">是否属于应届高校毕业生</view>
        <view class="choice-grid">
          <view hover-class="item--hover" class="choice choice--large {{freshGraduate === 'true' ? 'choice--selected' : ''}}" data-value="true" bindtap="chooseFreshGraduate">
            <view class="choice-icon">应</view><view><view class="choice-title">是</view><view class="choice-copy">包含政策规定的择业期情形</view></view>
          </view>
          <view hover-class="item--hover" class="choice choice--large {{freshGraduate === 'false' ? 'choice--selected' : ''}}" data-value="false" bindtap="chooseFreshGraduate">
            <view class="choice-icon">社</view><view><view class="choice-title">否</view><view class="choice-copy">按社会人员条件核验</view></view>
          </view>
        </view>
        <view class="field-label field-label--spaced">政治面貌</view>
        <view class="choice-list">
          <view hover-class="item--hover" wx:for="{{['中共党员','中共预备党员','共青团员','群众','民主党派']}}" wx:key="*this" class="choice-row {{politicalStatus === item ? 'choice-row--selected' : ''}}" data-value="{{item}}" bindtap="choosePoliticalStatus">
            <text>{{item}}</text><view class="row-check">✓</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{current === 2}}">
        <view class="field-label">普通工作经历</view>
        <view class="year-strip">
          <view hover-class="item--hover" wx:for="{{[0,1,2,3,5]}}" wx:key="*this" class="year-chip {{workYears === item ? 'year-chip--selected' : ''}}" data-value="{{item}}" bindtap="chooseWorkYears"><text class="type-data">{{item === 5 ? '5+' : item}}</text> 年</view>
        </view>
        <view class="field-help">普通工作经历指毕业后的工作经历，不等于基层工作经历。</view>
        <view class="field-label field-label--spaced">基层工作经历</view>
        <view class="year-strip">
          <view hover-class="item--hover" wx:for="{{[0,1,2,3,5]}}" wx:key="*this" class="year-chip {{grassrootsYears === item ? 'year-chip--selected' : ''}}" data-value="{{item}}" bindtap="chooseGrassrootsYears"><text class="type-data">{{item === 5 ? '5+' : item}}</text> 年</view>
        </view>
        <view class="field-help">按国考公告口径填写；岗位要求 2 年时，1 年 11 个月不会被算作满足。</view>
        <view class="field-label field-label--spaced">服务基层项目</view>
        <view class="choice-list">
          <view hover-class="item--hover" wx:for="{{['无','大学生村官','三支一扶','特岗教师','西部计划','高校毕业生退役士兵']}}" wx:key="*this" class="choice-row {{serviceProject === item ? 'choice-row--selected' : ''}}" data-value="{{item}}" bindtap="chooseServiceProject">
            <text>{{item}}</text><view class="row-check">✓</view>
          </view>
        </view>
        <view class="field-help">服务基层项目是定向岗位的资格条件，和普通工作经历分开填写。</view>
        <view class="field-label field-label--spaced">户籍或生源地限制核验</view>
        <view class="input-shell {{hukou ? 'input-shell--filled' : ''}}">
          <input class="input-shell__control" value="{{hukou}}" maxlength="60" placeholder="选填，例如：江西省赣州市" bindinput="inputHukou" />
          <view class="input-badge input-badge--optional">选填</view>
        </view>
        <view class="notice-card">
          <view class="notice-mark">i</view>
          <view>户籍、生源地、证书和备注条件不会被 AI 猜测；无法确定时会显示“待确认”，并告诉你要补什么。</view>
        </view>
      </block>

      <block wx:else>
        <view class="review-head">
          <view class="review-status">保存后重新核验</view>
          <view class="review-caption">资格档案 v{{profileVersion}}</view>
        </view>
        <view class="review-list">
          <view class="review-row"><text class="review-row__label">学历</text><text class="review-row__value">{{education}}</text></view>
          <view class="review-row"><text class="review-row__label">专业</text><text class="review-row__value">{{major}}</text></view>
          <view class="review-row"><text class="review-row__label">应届身份</text><text class="review-row__value">{{freshGraduate === 'true' ? '是' : '否'}}</text></view>
          <view class="review-row"><text class="review-row__label">政治面貌</text><text class="review-row__value">{{politicalStatus}}</text></view>
          <view class="review-row"><text class="review-row__label">普通工作经历</text><text class="review-row__value">{{workYears === 5 ? '5 年以上' : workYears + ' 年'}}</text></view>
          <view class="review-row"><text class="review-row__label">基层经历</text><text class="review-row__value">{{grassrootsYears === 5 ? '5 年以上' : grassrootsYears + ' 年'}}</text></view>
          <view class="review-row"><text class="review-row__label">服务基层项目</text><text class="review-row__value">{{serviceProject}}</text></view>
          <view class="review-row"><text class="review-row__label">户籍 / 生源地</text><text class="review-row__value">{{hukou || '未填写，相关岗位将待确认'}}</text></view>
        </view>
        <view class="confirm-copy">我确认以上信息属实。更新后，岗位推荐会按新信息重新计算。</view>
      </block>
    </view>

    <view wx:if="{{pendingRecovery}}" class="recovery-banner">
      <view class="recovery-mark">↻</view>
      <view>
        <view class="recovery-title">上一次保存结果还不确定</view>
        <view class="recovery-copy">重试不会产生重复的档案。</view>
      </view>
    </view>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{requestId}}" class="request-id">Request ID · {{requestId}}</view>
    <view class="s9-action-dock">
      <view class="s9-action-row">
        <button wx:if="{{current > 0}}" class="s9-secondary-button" bindtap="previous">返回</button>
        <button class="s9-primary-button" loading="{{saving}}" bindtap="next">{{primaryActionLabel}}</button>
      </view>
    </view>
  </block>

  <view wx:else class="success-state">
    <view class="success-orbit"><anan-companion size="large" intent="encouragement" context="post-submit" animate /></view>
    <view class="success-kicker">资格档案 v{{profileVersion}}</view>
    <view class="success-title">资格事实已更新</view>
    <view class="success-copy">岗位页会按新档案重新筛选。建议回去看看候选岗位的变化。</view>
    <view class="success-points">
      <view class="success-point"><text class="success-point__check">✓</text>普通工作经历与基层经历已分开保存</view>
      <view class="success-point"><text class="success-point__check">✓</text>服务基层项目不会被普通工作经历替代</view>
      <view class="success-point"><text class="success-point__check">✓</text>岗位结论会重新绑定档案版本</view>
    </view>
    <view class="saved-actions">
      <ui-button label="回岗位工作区" bind:action="openPositions" />
      <button class="s9-secondary-button" bindtap="editAgain">继续修改</button>
    </view>
  </view>
</view>
