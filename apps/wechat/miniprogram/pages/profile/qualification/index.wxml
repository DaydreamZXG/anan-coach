<view class="s9-screen qualification-edit-page">
  <workbench-nav id="runtime-workbench-nav" title="报考资格档案" back-behavior="emit" bind:back="back" />

  <view wx:if="{{loadingProfile}}" class="qualification-state">
    <state-view
      state="loading"
      title="正在读取报考资料"
      description="会恢复你已经确认过的学历、专业、身份与经历。"
    />
  </view>

  <view wx:elif="{{loadFailed}}" class="qualification-state">
    <state-view
      state="error"
      title="报考资料没有读取完成"
      description="{{error}}"
      actionText="重新读取"
      bindaction="retryLoad"
    />
    <view wx:if="{{requestId}}" class="request-id">问题编号 · {{requestId}}</view>
  </view>

  <block wx:elif="{{!saved}}">
    <view class="step-head">
      <view class="step-main">
        <view class="step-kicker">资格资料 · {{current + 1}} / 4</view>
        <view class="step-title">{{steps[current].title}}</view>
        <view class="step-copy">{{steps[current].copy}}</view>
      </view>
      <view class="step-badge">{{steps[current].label}}</view>
    </view>
    <view class="progress-track">
      <view class="progress-value progress-value--{{current}}"></view>
    </view>

    <scroll-view scroll-y class="qualification-scroll" enhanced show-scrollbar="{{false}}">
      <view class="qualification-content">
        <view wx:if="{{current === 0}}" class="boundary-notice">
          <view class="notice-icon">!</view>
          <view class="notice-copy">专业是岗位筛选的核心门槛，请按毕业证上的名称填写，不用专业大类代替。</view>
        </view>

        <view wx:if="{{current === 0}}" class="s9-card form-card">
          <view class="card-title">专业与学历</view>
          <view class="card-copy">这些信息会直接用于国考岗位的硬条件核验。</view>

          <view class="field-label">毕业证专业名称</view>
          <view class="input-field {{major ? 'input-field--filled' : ''}}">
            <view class="search-icon"></view>
            <input
              class="text-input"
              value="{{major}}"
              maxlength="80"
              placeholder="例如：法学、汉语言文学"
              bindinput="inputMajor"
            />
          </view>

          <view class="field-grid">
            <view class="picker-field">
              <view class="picker-label">最高学历</view>
              <picker mode="selector" range="{{educationOptions}}" bindchange="chooseEducation">
                <view class="picker-control {{education ? 'picker-control--filled' : ''}}">
                  <text>{{education || '请选择'}}</text>
                  <view class="picker-chevron"></view>
                </view>
              </picker>
            </view>
            <view class="picker-field">
              <view class="picker-label">毕业年份</view>
              <picker mode="selector" range="{{graduationYears}}" bindchange="chooseGraduationYear">
                <view class="picker-control {{graduationYear >= 2000 ? 'picker-control--filled' : ''}}">
                  <text>{{graduationYear >= 2000 ? graduationYear + ' 年' : '请选择'}}</text>
                  <view class="picker-chevron"></view>
                </view>
              </picker>
            </view>
          </view>
        </view>

        <view wx:elif="{{current === 1}}" class="s9-card form-card">
          <view class="card-title">身份与政治面貌</view>
          <view class="card-copy">应届身份和政治面貌会改变部分岗位的可报结论。</view>

          <view class="field-label">是否属于应届高校毕业生</view>
          <view class="option-stack">
            <button hover-class="item--hover"
              class="choice-row choice-row--detail {{freshGraduate === 'true' ? 'choice-row--selected' : ''}}"
              data-value="true"
              bindtap="chooseFreshGraduate"
            >
              <view>
                <view class="choice-title">应届高校毕业生</view>
                <view class="choice-copy">包含公告规定的择业期身份</view>
              </view>
              <view wx:if="{{freshGraduate === 'true'}}" class="choice-check">✓</view>
            </button>
            <button hover-class="item--hover"
              class="choice-row choice-row--detail {{freshGraduate === 'false' ? 'choice-row--selected' : ''}}"
              data-value="false"
              bindtap="chooseFreshGraduate"
            >
              <view>
                <view class="choice-title">社会人员</view>
                <view class="choice-copy">按非应届条件核验</view>
              </view>
              <view wx:if="{{freshGraduate === 'false'}}" class="choice-check">✓</view>
            </button>
          </view>

          <view class="field-label field-label--spaced">政治面貌</view>
          <view class="chip-grid">
            <button hover-class="item--hover"
              wx:for="{{['中共党员','中共预备党员','共青团员','群众','民主党派']}}"
              wx:key="*this"
              class="choice-chip {{politicalStatus === item ? 'choice-chip--selected' : ''}}"
              data-value="{{item}}"
              bindtap="choosePoliticalStatus"
            >{{item}}</button>
          </view>
        </view>

        <view wx:elif="{{current === 2}}" class="s9-card form-card">
          <view class="card-title">经历与户籍</view>
          <view class="card-copy">普通工作、基层工作和服务基层项目是三类不同资格，必须分别确认。</view>

          <view class="field-label">普通工作经历</view>
          <view class="year-grid">
            <button hover-class="item--hover"
              wx:for="{{[0,1,2,3,5]}}"
              wx:key="*this"
              class="year-option {{workYears === item ? 'year-option--selected' : ''}}"
              data-value="{{item}}"
              bindtap="chooseWorkYears"
            >{{item === 5 ? '5+' : item}} 年</button>
          </view>
          <view class="field-help">毕业后的普通工作经历，不等同于基层工作经历。</view>

          <view class="field-label field-label--spaced">基层工作经历</view>
          <view class="year-grid">
            <button hover-class="item--hover"
              wx:for="{{[0,1,2,3,5]}}"
              wx:key="*this"
              class="year-option {{grassrootsYears === item ? 'year-option--selected' : ''}}"
              data-value="{{item}}"
              bindtap="chooseGrassrootsYears"
            >{{item === 5 ? '5+' : item}} 年</button>
          </view>
          <view class="field-help">按国考公告口径填写；不足整年不会自动进位。</view>

          <view class="field-label field-label--spaced">服务基层项目</view>
          <view class="chip-grid">
            <button hover-class="item--hover"
              wx:for="{{['无','大学生村官','三支一扶','特岗教师','西部计划','高校毕业生退役士兵']}}"
              wx:key="*this"
              class="choice-chip {{serviceProject === item ? 'choice-chip--selected' : ''}}"
              data-value="{{item}}"
              bindtap="chooseServiceProject"
            >{{item}}</button>
          </view>

          <view class="field-label field-label--spaced">户籍或生源地</view>
          <view class="input-field {{hukou ? 'input-field--filled' : ''}}">
            <input
              class="text-input"
              value="{{hukou}}"
              maxlength="60"
              placeholder="选填，例如：江西省赣州市"
              bindinput="inputHukou"
            />
            <view class="optional-label">选填</view>
          </view>
        </view>

        <view wx:else class="s9-card form-card review-card">
          <view class="review-head">
            <view class="review-main">
              <view class="card-title">保存前确认</view>
              <view class="card-copy">保存后，候选岗位会使用新资料重新核验。</view>
            </view>
            <view class="review-badge">本人确认</view>
          </view>
          <view class="review-list">
            <view class="review-row"><text class="review-label">学历与专业</text><text class="review-value">{{education}} · {{major}}</text></view>
            <view class="review-row"><text class="review-label">毕业年份</text><text class="review-value">{{graduationYear}} 年</text></view>
            <view class="review-row"><text class="review-label">考生身份</text><text class="review-value">{{freshGraduate === 'true' ? '应届高校毕业生' : '社会人员'}}</text></view>
            <view class="review-row"><text class="review-label">政治面貌</text><text class="review-value">{{politicalStatus}}</text></view>
            <view class="review-row"><text class="review-label">普通工作经历</text><text class="review-value">{{workYears === 5 ? '5 年以上' : workYears + ' 年'}}</text></view>
            <view class="review-row"><text class="review-label">基层工作经历</text><text class="review-value">{{grassrootsYears === 5 ? '5 年以上' : grassrootsYears + ' 年'}}</text></view>
            <view class="review-row"><text class="review-label">服务基层项目</text><text class="review-value">{{serviceProject}}</text></view>
            <view class="review-row"><text class="review-label">户籍或生源地</text><text class="review-value">{{hukou || '未填写'}}</text></view>
          </view>
          <view class="confirm-copy">我确认以上资料由本人填写，并用于岗位资格核验。</view>
        </view>

        <view wx:if="{{pendingRecovery}}" class="recovery-banner">
          <view class="recovery-mark">↻</view>
          <view>
            <view class="recovery-title">上一次保存结果还在确认</view>
            <view class="recovery-copy">再次查询不会重复创建资格档案。</view>
          </view>
        </view>
        <view wx:if="{{error}}" class="error-banner">{{error}}</view>
        <view wx:if="{{requestId}}" class="request-id">问题编号 · {{requestId}}</view>
      </view>
    </scroll-view>

    <view class="s9-action-dock">
      <view class="s9-action-row">
        <button hover-class="item--hover" wx:if="{{current > 0}}" class="s9-secondary-button" bindtap="previous">返回</button>
        <button hover-class="item--hover" class="s9-primary-button tap-tactile" loading="{{saving}}" bindtap="next">{{primaryActionLabel}}</button>
      </view>
    </view>
  </block>

  <view wx:else class="success-page">
    <view class="success-mark">
      <image class="success-icon" src="/assets/onboarding/result-check-green.svg" mode="aspectFit" />
    </view>
    <view class="success-kicker">资料已保存</view>
    <view class="success-title">岗位会按新资料重新核验</view>
    <view class="success-copy">普通工作经历、基层工作经历和服务基层项目已分别保存，不会相互替代。</view>
    <view class="success-card">
      <view class="success-row"><text class="success-check">✓</text><text>资格事实已更新</text></view>
      <view class="success-row"><text class="success-check">✓</text><text>候选岗位将重新计算</text></view>
      <view class="success-row"><text class="success-check">✓</text><text>不确定条件仍会明确标为待确认</text></view>
    </view>
    <view class="success-actions">
      <button hover-class="item--hover" class="s9-primary-button tap-tactile" bindtap="openPositions">查看候选岗位</button>
      <button hover-class="item--hover" class="s9-secondary-button" bindtap="openScoreSheet">补成绩，计算分差</button>
      <button hover-class="item--hover" class="text-action" bindtap="editAgain">继续修改资料</button>
    </view>
  </view>
</view>
