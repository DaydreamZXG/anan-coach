.profile-page { padding-bottom: 96rpx; }
.profile-topbar { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; }
.profile-kicker { color: var(--color-muted); font-size: 20rpx; }
.profile-title { margin-top: 5rpx; font-size: 42rpx; font-weight: 850; }
.settings-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 72rpx; height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: rgba(255,255,255,.78); color: var(--color-ink-secondary); font-size: 32rpx; line-height: 1; }
.settings-button::after { border: 0; }
.profile-state { display: block; margin-top: 28rpx; }
.profile-hero { margin-top: 24rpx; }
.profile-head { display: flex; align-items: center; gap: 20rpx; }
.profile-avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--color-primary-soft); }
.profile-head-copy { flex: 1; min-width: 0; }
.profile-name { font-size: 30rpx; font-weight: 850; }
.profile-caption { margin-top: 8rpx; color: var(--color-muted); font-size: 21rpx; }
.profile-level { padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 20rpx; font-weight: 800; }
.profile-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 8rpx; margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--color-line); }
.profile-stat { min-width: 0; text-align: center; }
.profile-stat__value { display: block; overflow: hidden; color: var(--color-ink); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-stat__label { display: block; margin-top: 7rpx; color: var(--color-muted); font-size: 18rpx; }
.profile-menu { margin-top: 22rpx; }
.profile-menu-row { display: flex; align-items: center; gap: 20rpx; min-height: 114rpx; padding: 0 26rpx; }
.profile-menu-row + .profile-menu-row { border-top: 1rpx solid var(--color-line); }
.menu-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 58rpx; height: 58rpx; border-radius: 18rpx; background: var(--color-primary-soft); color: var(--color-primary-deep); font-size: 22rpx; font-weight: 850; }
.menu-arrow { flex: 0 0 auto; color: var(--color-primary); font-size: 40rpx; }
.menu-writing { flex: 0 0 auto; color: var(--color-muted); font-size: 20rpx; }
.companion-quote { display: flex; align-items: flex-end; gap: 20rpx; margin-top: 22rpx; background: linear-gradient(135deg,#ffffff,var(--color-primary-soft)); }
.quote-main { flex: 1; min-width: 0; }
.device-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 48rpx; height: 62rpx; border: 2rpx solid var(--color-primary-deep); border-radius: 12rpx; background: var(--color-primary-soft); }
.device-screen { width: 7rpx; height: 7rpx; margin-top: 38rpx; border-radius: 50%; background: var(--color-primary); }
.session-title-row { display: flex; align-items: center; gap: 10rpx; }
.current-tag { padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--color-success-soft); color: var(--color-success); font-size: 18rpx; }
.session-action { color: var(--color-danger); font-size: 22rpx; font-weight: 800; }
.security-actions { display: flex; flex-direction: column; gap: 14rpx; margin-top: 34rpx; }
.logout-all { background: transparent; color: var(--color-danger); font-size: 24rpx; font-weight: 750; }
.security-note { margin-top: 16rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.55; text-align: center; }
