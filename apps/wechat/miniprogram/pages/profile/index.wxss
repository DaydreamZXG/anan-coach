.profile-page {
  padding-bottom: 96rpx;
}

.profile-topbar {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
}

.profile-kicker {
  color: var(--color-primary-deep);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 0.5rpx;
}

.profile-title {
  margin-top: 6rpx;
  font-size: 46rpx;
  font-weight: 850;
  line-height: 1.1;
}

.profile-intro {
  max-width: 620rpx;
  margin-top: 20rpx;
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.8rpx;
  line-height: 1.42;
}

.profile-intro__accent {
  color: var(--color-primary);
}

.settings-button {
  box-sizing: border-box;
  min-width: 86rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(198, 217, 213, 0.82);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--color-ink-secondary);
  box-shadow: var(--shadow-card);
  font-size: 20rpx;
  font-weight: 750;
  line-height: 58rpx;
}

.settings-button::after {
  border: 0;
}

.profile-state {
  display: block;
  margin-top: 28rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  border-color: var(--color-primary-a16);
  background:
    radial-gradient(circle at 94% 10%, rgba(107, 97, 220, 0.16), transparent 30%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.98), var(--color-primary-soft));
  box-shadow: var(--shadow-card-strong);
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar {
  display: flex;
  overflow: hidden;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  background: var(--gradient-companion);
  box-shadow: 0 12rpx 30rpx rgba(45, 127, 231, 0.14);
}

.profile-head-copy {
  min-width: 0;
  flex: 1;
}

.profile-head-label {
  color: var(--color-primary);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.profile-name {
  margin-top: 5rpx;
  font-size: 30rpx;
  font-weight: 850;
}

.profile-caption {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.profile-level {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: var(--color-primary-deep);
  font-size: 18rpx;
  font-weight: 800;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-line);
}

.profile-stat {
  min-width: 0;
  text-align: center;
}

.profile-stat__value {
  display: block;
  overflow: hidden;
  color: var(--color-ink);
  font-size: 21rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-stat__label {
  display: block;
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 17rpx;
}

.profile-menu {
  margin-top: 22rpx;
  border-color: rgba(198, 217, 213, 0.72);
  background: rgba(255, 255, 255, 0.88);
}

.profile-menu-row {
  display: flex;
  min-height: 114rpx;
  align-items: center;
  gap: 20rpx;
  padding: 0 26rpx;
}

.profile-menu-row + .profile-menu-row {
  border-top: 1rpx solid var(--color-line);
}

.menu-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 18rpx;
  font-size: 21rpx;
  font-weight: 850;
}

.menu-icon--teal {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.menu-icon--blue {
  background: var(--color-ai-soft);
  color: var(--color-ai-blue);
}

.menu-icon--violet {
  background: #f0edff;
  color: var(--color-ai-violet);
}

.menu-icon--ai {
  background: var(--gradient-ai);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(45, 127, 231, 0.18);
}

.menu-icon--orange {
  background: #fff0e2;
  color: var(--color-action-deep);
}

.menu-icon--gold {
  background: var(--color-gold-soft);
  color: var(--color-warning);
}

.menu-icon--muted {
  background: #eef2f1;
  color: var(--color-ink-secondary);
}

.menu-arrow {
  flex: 0 0 auto;
  color: var(--color-primary);
  font-size: 40rpx;
}

.menu-writing {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: 20rpx;
}

.companion-quote {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 22rpx;
  border-color: rgba(45, 127, 231, 0.12);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), var(--color-ai-soft));
}

.quote-main {
  min-width: 0;
  flex: 1;
}

.device-icon {
  display: flex;
  width: 48rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border: 2rpx solid var(--color-primary-deep);
  border-radius: 12rpx;
  background: var(--color-primary-soft);
}

.device-screen {
  width: 7rpx;
  height: 7rpx;
  margin-top: 38rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.session-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.current-tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: 18rpx;
}

.session-action {
  color: var(--color-danger);
  font-size: 22rpx;
  font-weight: 800;
}

.security-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 34rpx;
}

.logout-all {
  background: transparent;
  color: var(--color-danger);
  font-size: 24rpx;
  font-weight: 750;
}

.security-note {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
}
