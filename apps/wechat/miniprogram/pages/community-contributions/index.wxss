@import "../../features/community-method-cards/page-shell.wxss";

.card-headline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.state-badge {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 18rpx;
  font-weight: 760;
}

.version-row {
  display: grid;
  grid-template-columns: 58rpx 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--color-surface-soft);
}

.version-number {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 820;
}

.version-body {
  min-width: 0;
}

.version-body .choice-copy,
.ledger-row .choice-copy {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.award-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(22, 131, 99, 0.14);
  border-radius: 20rpx;
  background: var(--color-success-soft);
}

.balance-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.balance-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.balance-item__label {
  color: var(--color-muted);
  font-size: 18rpx;
}

.balance-item__value {
  color: var(--color-success);
  font-family: var(--font-family-data);
  font-size: 26rpx;
}

.ledger-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--color-surface-soft);
}

.ledger-balance {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-self: center;
  color: var(--color-primary-deep);
  font-family: var(--font-family-data);
  font-size: 19rpx;
  font-weight: 760;
}
