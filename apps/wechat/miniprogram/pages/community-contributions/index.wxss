@import "../../features/community-method-cards/page-shell.wxss";

.card-headline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
}

.state-badge {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.version-row {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: calc(16 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
}

.version-number {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 800;
  white-space: nowrap;
}

.version-body {
  min-width: 0;
}

.version-body .choice-copy,
.ledger-row .choice-copy {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.award-card {
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(22, 131, 99, 0.14);
  border-radius: var(--radius-24);
  background: var(--color-success-soft);
}

.balance-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.balance-item {
  display: flex;
  flex-direction: column;
  gap: calc(8 * var(--rpx));
  padding: calc(16 * var(--rpx));
  border-radius: var(--radius-16);
  background: rgba(255, 255, 255, 0.72);
}

.balance-item__label {
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.balance-item__value {
  color: var(--color-success);
  font-family: var(--font-family-data);
  font-size: var(--text-body);
}

.ledger-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: calc(16 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
}

.ledger-balance {
  display: flex;
  flex-direction: column;
  gap: calc(8 * var(--rpx));
  align-self: center;
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
  font-weight: 700;
}
