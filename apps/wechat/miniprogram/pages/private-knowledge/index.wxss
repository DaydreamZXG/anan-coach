.library-page {
  position: relative;
  overflow-x: hidden;
}

.library-content {
  box-sizing: border-box;
  padding: 16rpx 40rpx calc(var(--figma-space-48) + env(safe-area-inset-bottom));
}

.library-intro {
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.library-intro__title {
  color: var(--ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.3;
}

.library-intro__copy {
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.7;
}

.library-security {
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 40rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-24);
  background: rgba(228, 231, 236, 0.5);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}

.library-security__lock {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 800;
  transform: rotate(90deg);
}

.library-quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.library-quick-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 196rpx;
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  color: var(--ink);
  box-shadow: var(--shadow-card);
}

.library-quick-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
}

.library-quick-card__icon--indigo {
  background: var(--primary-soft);
}

.library-quick-card__icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.library-quick-card__image {
  width: 40rpx;
  height: 40rpx;
}

.library-quick-card__title {
  font-size: var(--text-body);
  font-weight: 700;
}

.library-search {
  display: grid;
  grid-template-columns: 34rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  min-height: 96rpx;
  margin-bottom: 48rpx;
  padding: 0 16rpx 0 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.library-search__icon {
  position: relative;
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid var(--ink-3);
  border-radius: 50%;
}

.library-search__icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 13rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--ink-3);
  content: "";
  transform: rotate(45deg);
}

.library-search__input {
  min-width: 0;
  height: 80rpx;
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 500;
}

.library-search__status {
  padding-right: var(--figma-space-12);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  white-space: nowrap;
}

.library-search-state {
  margin: -24rpx 0 40rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-small);
  background: var(--color-surface);
}

.library-search-state--error {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
}

.library-search-state__title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.library-search-state__copy,
.library-search-state__request {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.library-search-state__request {
  font-family: var(--font-family-data);
}

.library-search-state__action {
  width: auto;
  min-height: 56rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 56rpx;
}

.library-group {
  margin-top: 40rpx;
}

.library-group__head,
.review-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 2rpx 24rpx;
}

.library-group__title,
.review-card__title {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.library-group__count,
.review-card__count {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.processing-row,
.source-card,
.citation-result {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  color: var(--ink);
  text-align: left;
  box-shadow: var(--shadow-card);
}

.processing-row,
.source-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.processing-row__icon,
.source-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-24);
  background: var(--bg);
}

.processing-row__image,
.source-card__image {
  width: 36rpx;
  height: 36rpx;
}

.processing-row__main,
.source-card__main {
  flex: 1;
  min-width: 0;
}

.processing-row__title,
.source-card__title {
  overflow: hidden;
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.processing-row__copy,
.source-card__meta {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.source-card__icon--lecture {
  background: var(--primary-soft);
}

.source-card__icon--note {
  background: var(--figma-color-cyan-soft);
}

.source-card__icon--summary {
  background: var(--figma-color-warning-soft);
}

.source-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.source-card__state {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-8);
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-micro);
  font-weight: 700;
}

.source-card__foot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.source-card__check {
  width: 24rpx;
  height: 24rpx;
}

.review-card {
  margin: 48rpx 0;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.review-card__copy {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.review-span {
  margin-top: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-32);
}

.review-span__label {
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.review-span__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 190rpx;
  padding: 24rpx;
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: 1.7;
}

.review-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 20rpx;
  margin-top: 28rpx;
}

.review-action {
  min-height: 88rpx;
  border-radius: var(--radius-32);
  font-size: var(--text-caption);
  font-weight: 700;
}

.review-action--quiet {
  border: 1rpx solid var(--color-line-strong);
  color: var(--ink-2);
}

.review-action--primary {
  background: var(--ink);
  color: var(--color-surface);
}

.citation-result__source {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}

.citation-result__copy {
  margin-top: 16rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.65;
}

.citation-result__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.library-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  text-align: center;
}

.library-empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-32);
  background: var(--bg);
}

.library-empty__image {
  width: 40rpx;
  height: 40rpx;
}

.library-empty__title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.library-empty__copy {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.library-inline-error {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.55;
}

.library-state {
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

button.library-quick-card,
button.processing-row,
button.citation-result,
button.source-card,
button.review-action,
button.import-action {
  width: 100%;
}

button.processing-background,
button.library-search-state__action {
  width: auto;
}

button.citation-sheet__close {
  width: 88rpx;
}

.processing-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 112rpx);
  padding: 52rpx 64rpx calc(80rpx + env(safe-area-inset-bottom));
  text-align: center;
}

.processing-document {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 192rpx;
  height: 192rpx;
  margin-bottom: 56rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.processing-document__icon {
  width: 80rpx;
  height: 80rpx;
}

.processing-beam {
  position: absolute;
  top: 20%;
  right: 0;
  left: 0;
  height: 5rpx;
  border-radius: var(--radius-capsule);
  background: var(--figma-color-cyan-deep);
  box-shadow: var(--shadow-cyan);
  animation: processing-scan 2.5s linear infinite;
}

@keyframes processing-scan {
  0% {
    transform: translateY(-30rpx);
  }

  50% {
    transform: translateY(130rpx);
  }

  100% {
    transform: translateY(-30rpx);
  }
}

.processing-title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.processing-filename {
  max-width: 570rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.processing-steps {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  width: 100%;
  max-width: 560rpx;
  margin-top: 56rpx;
  text-align: left;
}

.processing-step {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.processing-step--pending {
  opacity: 0.4;
}

.processing-step__status {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--figma-color-line-emphasis);
  border-radius: 50%;
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 800;
}

.processing-step__status--done {
  border-color: var(--good);
  background: var(--good);
}

.processing-step__status--active {
  border-color: var(--color-primary-soft-strong);
  border-top-color: var(--primary);
  animation: processing-spin 1.2s linear infinite;
}

@keyframes processing-spin {
  100% {
    transform: rotate(360deg);
  }
}

.processing-step__copy {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.processing-note {
  max-width: 570rpx;
  margin-top: 56rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--primary-soft);
  border-radius: var(--radius-40);
  background: rgba(238, 242, 255, 0.6);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.65;
}

.processing-background {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 180rpx;
  min-height: 88rpx;
  margin-top: 40rpx;
  padding: 0 20rpx;
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 700;
}

.import-title-input,
.import-kind {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  margin-bottom: 20rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--color-surface-soft);
  color: var(--ink);
  font-size: var(--text-body);
  line-height: 92rpx;
}

.import-kind {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.import-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.import-action {
  min-height: 84rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.citation-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(16, 24, 40, 0.42);
}

.citation-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  box-sizing: border-box;
  max-height: 75vh;
  padding: 16rpx 48rpx calc(50rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: var(--radius-64) var(--radius-64) 0 0;
  background: var(--color-surface);
  box-shadow: var(--shadow-overlay);
}

.citation-sheet__handle {
  width: 96rpx;
  height: 12rpx;
  margin: 0 auto 40rpx;
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
}

.citation-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
}

.citation-sheet__title {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.citation-sheet__source {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
}

.citation-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-title-sm);
}

.citation-sheet__paper {
  margin-top: 40rpx;
  padding: 40rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-48);
  background: var(--bg);
  box-shadow: var(--shadow-well);
}

.citation-sheet__paper-title {
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--figma-color-line-emphasis);
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-align: center;
}

.citation-sheet__highlight {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  border-left: 8rpx solid var(--color-primary-bright);
  border-radius: 0 var(--radius-16) var(--radius-16) 0;
  background: rgba(224, 231, 255, 0.7);
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 600;
  line-height: 1.85;
}

.citation-sheet__evidence {
  margin-top: 24rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
}

@media (min-width: 700px) {
  .library-content {
    padding-right: max(40rpx, calc((100vw - 860px) / 2));
    padding-left: max(40rpx, calc((100vw - 860px) / 2));
  }

  .citation-sheet {
    right: calc((100vw - 720px) / 2);
    left: calc((100vw - 720px) / 2);
  }
}
