.library-page {
  position: relative;
  overflow-x: hidden;
}

.library-content {
  box-sizing: border-box;
  padding: calc(16 * var(--rpx)) calc(40 * var(--rpx))
    calc(var(--figma-space-48) + env(safe-area-inset-bottom));
}

.library-intro {
  margin-top: calc(16 * var(--rpx));
  margin-bottom: calc(40 * var(--rpx));
}

.library-intro__title {
  color: var(--ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1 * var(--rpx));
  line-height: 1.3;
}

.library-intro__copy {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.7;
}

.library-security {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--rpx));
  box-sizing: border-box;
  width: 100%;
  margin-bottom: calc(40 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: rgba(228, 231, 236, 0.5);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}

.library-security__lock {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 800;
  transform: rotate(90deg);
}

.library-quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: calc(24 * var(--rpx));
  margin-bottom: calc(40 * var(--rpx));
}

.library-quick-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(196 * var(--rpx));
  padding: calc(28 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  color: var(--ink);
  box-shadow: var(--shadow-card);
}

.library-quick-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
  margin-bottom: calc(20 * var(--rpx));
  border-radius: 50%;
}

.library-quick-card__icon--indigo {
  background: var(--primary-soft);
}

.library-quick-card__icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.library-quick-card__image {
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
}

.library-quick-card__title {
  font-size: var(--text-body);
  font-weight: 700;
}

.library-search {
  display: grid;
  grid-template-columns: calc(34 * var(--rpx)) minmax(0, 1fr) auto;
  align-items: center;
  gap: calc(16 * var(--rpx));
  box-sizing: border-box;
  min-height: calc(96 * var(--rpx));
  margin-bottom: calc(48 * var(--rpx));
  padding: 0 calc(16 * var(--rpx)) 0 calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.library-search__icon {
  position: relative;
  box-sizing: border-box;
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
  border: calc(3 * var(--rpx)) solid var(--ink-3);
  border-radius: 50%;
}

.library-search__icon::after {
  position: absolute;
  right: calc(-9 * var(--rpx));
  bottom: calc(-6 * var(--rpx));
  width: calc(13 * var(--rpx));
  height: calc(3 * var(--rpx));
  border-radius: calc(2 * var(--rpx));
  background: var(--ink-3);
  content: "";
  transform: rotate(45deg);
}

.library-search__input {
  min-width: 0;
  height: calc(80 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 500;
}

.library-search__status {
  padding-right: var(--figma-space-12);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  white-space: nowrap;
}

.library-search-state {
  margin: calc(-24 * var(--rpx)) 0 calc(40 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--figma-radius-small);
  background: var(--color-surface);
}

.library-search-state--error {
  border-color: var(--color-danger-soft);
  background: var(--color-danger-soft);
}

.library-search-state__title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.library-search-state__copy,
.library-search-state__request {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.library-search-state__request {
  font-family: var(--font-family-data);
}

.library-search-state__action {
  width: auto;
  min-height: calc(56 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(56 * var(--rpx));
}

.library-group {
  margin-top: calc(40 * var(--rpx));
}

.library-group__head,
.review-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  margin: 0 calc(2 * var(--rpx)) calc(24 * var(--rpx));
}

.library-group__title,
.review-card__title {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.library-group__count,
.review-card__count {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.processing-row,
.source-card,
.citation-result {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: calc(20 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  color: var(--ink);
  text-align: left;
  box-shadow: var(--shadow-card);
}

.processing-row,
.source-card {
  display: flex;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
}

.processing-row__icon,
.source-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--bg);
}

.processing-row__image,
.source-card__image {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

.processing-row__main,
.source-card__main {
  flex: 1;
  min-width: 0;
}

.processing-row__title,
.source-card__title {
  overflow: hidden;
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.processing-row__copy,
.source-card__meta {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.source-card__icon--lecture {
  background: var(--primary-soft);
}

.source-card__icon--note {
  background: var(--figma-color-cyan-soft);
}

.source-card__icon--summary {
  background: var(--figma-color-warning-soft);
}

.source-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.source-card__state {
  flex: 0 0 auto;
  padding: calc(4 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-8);
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-micro);
  font-weight: 700;
}

.source-card__foot {
  display: flex;
  align-items: center;
  gap: calc(8 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.source-card__check {
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
}

.review-card {
  margin: calc(48 * var(--rpx)) 0;
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.review-card__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.review-span {
  margin-top: calc(24 * var(--rpx));
  overflow: hidden;
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-32);
}

.review-span__label {
  padding: calc(16 * var(--rpx)) calc(24 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.review-span__input {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(190 * var(--rpx));
  padding: calc(24 * var(--rpx));
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: 1.7;
}

.review-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: calc(20 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}

.review-action {
  min-height: calc(88 * var(--rpx));
  border-radius: var(--radius-32);
  font-size: var(--text-caption);
  font-weight: 700;
}

.review-action--quiet {
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  color: var(--ink-2);
}

.review-action--primary {
  background: var(--ink);
  color: var(--color-surface);
}

.citation-result__source {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}

.citation-result__copy {
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.65;
}

.citation-result__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.library-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(64 * var(--rpx)) calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  text-align: center;
}

.library-empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(88 * var(--rpx));
  height: calc(88 * var(--rpx));
  margin-bottom: calc(24 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--bg);
}

.library-empty__image {
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
}

.library-empty__title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.library-empty__copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.library-inline-error {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.55;
}

.library-state {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(32 * var(--rpx));
}

button.library-quick-card,
button.processing-row,
button.citation-result,
button.source-card,
button.review-action,
button.import-action {
  width: 100%;
}

button.processing-background,
button.library-search-state__action {
  width: auto;
}

button.citation-sheet__close {
  width: calc(88 * var(--rpx));
}

.processing-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - calc(112 * var(--rpx)));
  padding: calc(52 * var(--rpx)) calc(64 * var(--rpx))
    calc(calc(80 * var(--rpx)) + env(safe-area-inset-bottom));
  text-align: center;
}

.processing-document {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(192 * var(--rpx));
  height: calc(192 * var(--rpx));
  margin-bottom: calc(56 * var(--rpx));
  overflow: hidden;
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.processing-document__icon {
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
}

.processing-beam {
  position: absolute;
  top: 20%;
  right: 0;
  left: 0;
  height: calc(5 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--figma-color-cyan-deep);
  box-shadow: var(--shadow-cyan);
  animation: processing-scan 2.5s linear infinite;
}

@keyframes processing-scan {
  0% {
    transform: translateY(calc(-30 * var(--rpx)));
  }

  50% {
    transform: translateY(calc(130 * var(--rpx)));
  }

  100% {
    transform: translateY(calc(-30 * var(--rpx)));
  }
}

.processing-title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.8 * var(--rpx));
}

.processing-filename {
  max-width: calc(570 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  overflow: hidden;
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.processing-steps {
  display: flex;
  flex-direction: column;
  gap: calc(28 * var(--rpx));
  width: 100%;
  max-width: calc(560 * var(--rpx));
  margin-top: calc(56 * var(--rpx));
  text-align: left;
}

.processing-step {
  display: flex;
  align-items: center;
  gap: calc(24 * var(--rpx));
}

.processing-step--pending {
  opacity: 0.4;
}

.processing-step__status {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 auto;
  width: calc(34 * var(--rpx));
  height: calc(34 * var(--rpx));
  border: calc(4 * var(--rpx)) solid var(--figma-color-line-emphasis);
  border-radius: 50%;
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 800;
}

.processing-step__status--done {
  border-color: var(--good);
  background: var(--good);
}

.processing-step__status--active {
  border-color: var(--color-primary-soft-strong);
  border-top-color: var(--primary);
  animation: processing-spin 1.2s linear infinite;
}

@keyframes processing-spin {
  100% {
    transform: rotate(360deg);
  }
}

.processing-step__copy {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.processing-note {
  max-width: calc(570 * var(--rpx));
  margin-top: calc(56 * var(--rpx));
  padding: calc(28 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--primary-soft);
  border-radius: var(--radius-40);
  background: rgba(238, 242, 255, 0.6);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.65;
}

.processing-background {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: calc(180 * var(--rpx));
  min-height: calc(88 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 700;
}

.import-title-input,
.import-kind {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(92 * var(--rpx));
  margin-bottom: calc(20 * var(--rpx));
  padding: 0 calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--color-surface-soft);
  color: var(--ink);
  font-size: var(--text-body);
  line-height: calc(92 * var(--rpx));
}

.import-kind {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.import-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(16 * var(--rpx));
}

.import-action {
  min-height: calc(84 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.library-inline-error__retry {
  box-sizing: border-box;
  min-height: calc(68 * var(--rpx));
  margin: calc(16 * var(--rpx)) 0 0;
  padding: 0 calc(24 * var(--rpx));
  border: 0;
  border-radius: var(--radius-capsule);
  background: var(--color-action);
  color: var(--color-on-primary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(68 * var(--rpx));
}

.library-inline-error__retry::after {
  border: 0;
}

.citation-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(16, 24, 40, 0.42);
}

.citation-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  box-sizing: border-box;
  max-height: 75vh;
  padding: calc(16 * var(--rpx)) calc(48 * var(--rpx))
    calc(calc(50 * var(--rpx)) + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: var(--radius-64) var(--radius-64) 0 0;
  background: var(--color-surface);
  box-shadow: var(--shadow-overlay);
}

.citation-sheet__handle {
  width: calc(96 * var(--rpx));
  height: calc(12 * var(--rpx));
  margin: 0 auto calc(40 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
}

.citation-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(28 * var(--rpx));
}

.citation-sheet__title {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.citation-sheet__source {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
}

.citation-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: calc(88 * var(--rpx));
  height: calc(88 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-title-sm);
}

.citation-sheet__paper {
  margin-top: calc(40 * var(--rpx));
  padding: calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-48);
  background: var(--bg);
  box-shadow: var(--shadow-well);
}

.citation-sheet__paper-title {
  padding-bottom: calc(28 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--figma-color-line-emphasis);
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-align: center;
}

.citation-sheet__highlight {
  margin-top: calc(32 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-left: calc(8 * var(--rpx)) solid var(--color-primary-bright);
  border-radius: 0 var(--radius-16) var(--radius-16) 0;
  background: rgba(224, 231, 255, 0.7);
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 600;
  line-height: 1.85;
}

.citation-sheet__evidence {
  margin-top: calc(24 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.6;
}

@media (min-width: 700px) {
  .library-content {
    padding-right: max(calc(40 * var(--rpx)), calc((100vw - 860px) / 2));
    padding-left: max(calc(40 * var(--rpx)), calc((100vw - 860px) / 2));
  }

  .citation-sheet {
    right: calc((100vw - 720px) / 2);
    left: calc((100vw - 720px) / 2);
  }
}

@media (min-width: 1024px) {
  .source-grid,
  .citation-grid {
    display: grid;
    align-items: stretch;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .source-grid > .source-card,
  .citation-grid > .citation-result {
    height: 100%;
    margin-bottom: 0;
    box-sizing: border-box;
  }
}
