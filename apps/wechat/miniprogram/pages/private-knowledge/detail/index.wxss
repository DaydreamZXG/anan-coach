.detail-page {
  position: relative;
  overflow-x: hidden;
}

.detail-state {
  box-sizing: border-box;
  padding: 48rpx 32rpx;
}

.detail-content {
  box-sizing: border-box;
  padding: 12rpx 40rpx calc(var(--figma-space-48) + env(safe-area-inset-bottom));
}

.detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 8rpx 0 48rpx;
  text-align: center;
}

.detail-hero__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.detail-hero__icon--lecture {
  background: var(--color-surface);
}

.detail-hero__icon--note {
  background: var(--figma-color-cyan-soft);
}

.detail-hero__icon--summary {
  background: var(--figma-color-warning-soft);
}

.detail-hero__image {
  width: 58rpx;
  height: 58rpx;
}

.detail-hero__title {
  max-width: 620rpx;
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: -0.6rpx;
  line-height: 1.35;
  word-break: break-all;
}

.detail-hero__meta {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 500;
}

.detail-version-action {
  display: inline-flex;
  width: auto;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 600;
}

.detail-version-action::after {
  border: 0;
}

.detail-version-action__icon {
  width: 28rpx;
  height: 28rpx;
}

.detail-indexed {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 40rpx;
  overflow: hidden;
  border: 1rpx solid rgba(187, 247, 208, 0.7);
  border-radius: var(--radius-48);
  background: linear-gradient(145deg, var(--good-soft), var(--good-soft));
}

.detail-indexed::after {
  position: absolute;
  top: -50rpx;
  right: -36rpx;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: rgba(134, 239, 172, 0.22);
  content: "";
}

.detail-indexed__icon {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--good);
  color: var(--color-surface);
  font-size: var(--text-caption);
  font-weight: 800;
}

.detail-indexed__main {
  position: relative;
  z-index: 1;
}

.detail-indexed__title {
  color: var(--good);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.detail-indexed__copy {
  margin-top: 8rpx;
  color: rgba(20, 83, 45, 0.76);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.6;
}

.detail-section-title {
  margin: 48rpx 0 20rpx 2rpx;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.detail-insights,
.detail-boundaries {
  padding: 40rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.detail-insight {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.detail-insight__spark,
.detail-insight__link {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  color: var(--primary);
  font-size: var(--text-body-lg);
  font-weight: 800;
}

.detail-insight__link {
  color: var(--figma-color-cyan-deep);
}

.detail-insight__copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.62;
}

.detail-insight__strong {
  color: var(--ink);
  font-weight: 700;
}

.detail-insights__divider,
.detail-boundaries__divider {
  height: 1rpx;
  margin: 32rpx 0 32rpx 56rpx;
  background: var(--line);
}

.detail-boundary {
  position: relative;
  padding-right: 118rpx;
}

.detail-boundary__title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.detail-boundary__copy {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 1.55;
}

.detail-boundary__state {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-capsule);
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-micro);
  font-weight: 700;
}

.detail-boundary__state--quiet {
  background: var(--line);
  color: var(--ink-2);
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 48rpx;
}

.action-btn-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 700;
  box-shadow: var(--shadow-card);
}

.action-btn-tile--danger {
  border-color: var(--color-danger-soft);
  color: var(--danger);
}

.action-btn-tile__icon {
  width: 30rpx;
  height: 30rpx;
}

button.action-btn-tile,
button.delete-sheet__confirm,
button.delete-sheet__cancel {
  width: 100%;
}

.delete-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(16, 24, 40, 0.42);
}

.delete-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 81;
  box-sizing: border-box;
  padding: 16rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-64) var(--radius-64) 0 0;
  background: var(--color-surface);
  text-align: center;
  box-shadow: var(--shadow-overlay);
}

.delete-sheet__handle {
  width: 96rpx;
  height: 12rpx;
  margin: 0 auto 40rpx;
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
}

.delete-sheet__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  border-radius: var(--radius-32);
  background: var(--color-danger-soft);
}

.delete-sheet__image {
  width: 44rpx;
  height: 44rpx;
}

.delete-sheet__title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
}

.delete-sheet__copy {
  max-width: 570rpx;
  margin: 20rpx auto 40rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.65;
}

.delete-sheet__confirm,
.delete-sheet__cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 94rpx;
  border-radius: var(--radius-40);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.delete-sheet__confirm {
  background: var(--danger);
  color: var(--color-surface);
}

.delete-sheet__cancel {
  margin-top: 16rpx;
  color: var(--ink-2);
}

@media (min-width: 700px) {
  .detail-content {
    padding-right: max(40rpx, calc((100vw - 860px) / 2));
    padding-left: max(40rpx, calc((100vw - 860px) / 2));
  }

  .delete-sheet {
    right: calc((100vw - 720px) / 2);
    left: calc((100vw - 720px) / 2);
  }
}
