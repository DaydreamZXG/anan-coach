.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.goal { display: flex; flex-direction: column; min-height: 100vh; }
.g-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.g-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.g-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.g-body { flex: 1; min-height: 0; }
.g-current { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 24rpx; border-left: 6rpx solid var(--primary); }
.g-current-name { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.g-search { display: flex; gap: 16rpx; align-items: center; margin-bottom: 24rpx; }
.g-input {
  flex: 1; font-size: 28rpx; color: var(--ink);
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: var(--radius-sm); padding: 18rpx 24rpx;
}
.g-placeholder { color: var(--ink-3); }
.g-search-btn { flex-shrink: 0; }
.g-pos { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.g-pos-main { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.g-pos-name { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.g-pos-cta { font-size: 26rpx; color: var(--primary); flex-shrink: 0; }

.g-check {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid var(--line); flex-shrink: 0;
}
.g-check.is-on { border-color: var(--primary); background: var(--primary); box-shadow: inset 0 0 0 6rpx #fff; }

.g-compare-bar { padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 16rpx); }
.g-compare-btn { width: 100%; }
.demo-tip { text-align: center; padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 16rpx); }
