.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

/* ── 顶部导航 ── */
.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
  flex-shrink: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 深空结算 hero ── */
.summary {
  margin: 8rpx 32rpx 32rpx;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 20rpx 0;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.summary__row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.summary__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary__num {
  font-size: 52rpx;
  font-weight: 800;
  color: #ffffff;
}

.summary__num--cyan {
  color: #22d3ee;
}

.summary__num--green {
  color: #4ade80;
}

.summary__num--amber {
  color: #fbbf24;
}

.summary__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.summary__divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ── 总结 ── */
.conclusion {
  margin: 0 32rpx;
  padding: 28rpx;
}

.conclusion__text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.7;
}

.section-head {
  margin: 32rpx 32rpx 24rpx;
}

/* ── 任务证据 ── */
.task {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.task__main {
  flex: 1;
  min-width: 0;
}

.task__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.5;
}

.task__meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.task__pill {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: var(--ink-3);
  background: rgba(16, 19, 27, 0.05);
}

.task__pill--complete {
  color: var(--green);
  background: rgba(13, 159, 110, 0.1);
}

.task__pill--in_progress {
  color: var(--indigo);
  background: rgba(91, 95, 244, 0.09);
}

/* ── 风险提示 ── */
.notice {
  margin: 28rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--amber);
  background: rgba(217, 127, 6, 0.08);
  border: 1rpx solid rgba(217, 127, 6, 0.28);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  line-height: 1.7;
}
