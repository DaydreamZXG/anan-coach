.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.settle { align-items: stretch; }

.settle-hero { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0 48rpx; }
.settle-ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  border: 8rpx solid var(--primary);
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 32rpx;
}
.settle-ring-num { font-size: 88rpx; font-weight: 700; color: var(--primary); line-height: 1; }
.settle-ring-unit { font-size: 32rpx; color: var(--primary); }
.settle-title { display: block; margin-bottom: 8rpx; }

.settle-stats { display: flex; align-items: center; margin-bottom: 32rpx; }
.s-stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.s-num { font-size: 48rpx; font-weight: 700; color: var(--ink); }
.s-unit { font-size: 26rpx; color: var(--ink-3); font-weight: 500; }
.s-divider { width: 1rpx; height: 60rpx; background: var(--line); }

.settle-anan {
  display: flex;
  gap: 20rpx;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 40rpx;
}
.anan-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--warm);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.settle-anan-body { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.settle-anan-text { font-size: 29rpx; line-height: 1.6; color: #5c4a35; }
.settle-anan-cta { font-size: 26rpx; color: var(--warm); font-weight: 600; }

.settle-done { width: 100%; }
