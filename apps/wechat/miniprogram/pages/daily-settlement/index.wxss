.settlement-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-canvas);
  color: var(--color-ink);
}

.tomorrow-card__action::after,
.settlement-primary::after,
.settlement-companion::after {
  border: 0;
}

.settlement-content {
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: var(--figma-space-48) var(--space-page-x) calc(230rpx + env(safe-area-inset-bottom));
}

.settlement-title {
  max-width: 650rpx;
  font-size: var(--figma-font-hero-title);
  font-weight: 760;
  letter-spacing: -1rpx;
  line-height: 1.3;
}

.settlement-copy {
  margin-top: var(--figma-space-12);
  color: var(--color-muted);
  font-size: var(--figma-font-body-compact);
  line-height: 1.65;
}

.settlement-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--figma-space-12);
  margin-top: var(--figma-space-32);
}

.settlement-metric {
  box-sizing: border-box;
  min-width: 0;
  padding: var(--figma-space-20) var(--figma-space-12);
  border-radius: var(--figma-radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.settlement-metric--actual {
  background: var(--color-primary-soft);
}

.metric-label {
  color: var(--color-faint);
  font-size: var(--figma-font-caption);
}

.metric-value {
  margin-top: var(--figma-space-8);
  overflow: hidden;
  font-size: var(--figma-font-body);
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settlement-metric--actual .metric-label,
.settlement-metric--actual .metric-value {
  color: var(--color-primary);
}

.variance-label {
  margin-top: var(--figma-space-10);
  color: var(--color-faint);
  font-size: var(--figma-font-caption);
  text-align: center;
}

.settlement-section {
  margin-top: var(--figma-space-32);
}

.section-heading {
  display: flex;
  align-items: center;
  gap: var(--figma-space-8);
  padding-left: var(--figma-space-4);
  font-size: var(--figma-font-body-large);
  font-weight: 760;
  letter-spacing: -0.5rpx;
}

.section-heading__mark {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-ink);
  font-size: var(--figma-font-caption);
  font-weight: 800;
}

.section-heading--warning .section-heading__mark {
  color: var(--color-warning);
}

.settlement-card,
.tomorrow-card {
  box-sizing: border-box;
  margin-top: var(--figma-space-16);
  border-radius: var(--figma-radius-card-medium);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.confirmation-card {
  position: relative;
  overflow: hidden;
  padding: var(--figma-space-24);
}

.confirmation-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 6rpx;
  background: var(--color-cyan);
}

.settlement-summary {
  font-size: var(--figma-font-body);
  font-weight: 700;
  line-height: 1.65;
}

.evidence-note {
  margin-top: var(--figma-space-16);
  padding: var(--figma-space-12);
  border-radius: var(--figma-radius-xsmall);
  background: var(--figma-color-cyan-soft);
  color: var(--color-ink-secondary);
  font-size: var(--figma-font-caption);
  line-height: 1.6;
}

.empty-card {
  padding: var(--figma-space-24);
}

.empty-title {
  font-size: var(--figma-font-body);
  font-weight: 720;
  line-height: 1.5;
}

.empty-copy {
  margin-top: var(--figma-space-8);
  color: var(--color-muted);
  font-size: var(--figma-font-body-compact);
  line-height: 1.65;
}

.risk-card {
  padding: var(--figma-space-20);
  border: 1rpx solid var(--figma-color-warning-soft);
}

.risk-item {
  color: var(--figma-color-ink-strong);
  font-size: var(--figma-font-body-compact);
  font-weight: 650;
  line-height: 1.65;
}

.risk-item + .risk-item {
  margin-top: var(--figma-space-10);
  padding-top: var(--figma-space-10);
  border-top: 1rpx solid var(--color-line);
}

.unfinished-card {
  padding: var(--figma-space-20);
}

.unfinished-title {
  font-size: var(--figma-font-body);
  font-weight: 720;
  line-height: 1.5;
}

.unfinished-meta {
  margin-top: var(--figma-space-4);
  color: var(--color-faint);
  font-size: var(--figma-font-caption);
  line-height: 1.5;
}

.unfinished-note,
.unfinished-more {
  margin-top: var(--figma-space-16);
  padding: var(--figma-space-12);
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-canvas);
  color: var(--color-muted);
  font-size: var(--figma-font-caption);
  line-height: 1.6;
}

.unfinished-more {
  margin-top: var(--figma-space-8);
}

.tomorrow-card {
  padding: var(--figma-space-20);
  border: 1rpx solid var(--figma-color-primary-soft-strong);
  background: var(--color-primary-soft);
}

.tomorrow-card__title {
  font-size: var(--figma-font-body);
  font-weight: 720;
  line-height: 1.5;
}

.tomorrow-card__copy {
  margin-top: var(--figma-space-8);
  color: var(--color-muted);
  font-size: var(--figma-font-body-compact);
  line-height: 1.65;
}

button.tomorrow-card__action {
  display: inline-flex;
  width: auto;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  margin: var(--figma-space-16) 0 0;
  padding: 0 var(--figma-space-16);
  border: 0;
  border-radius: var(--figma-radius-small);
  background: var(--color-surface);
  color: var(--color-primary-deep);
  font-size: var(--figma-font-caption);
  font-weight: 720;
  line-height: 68rpx;
}

.settlement-dock {
  position: fixed;
  z-index: var(--z-footer);
  right: 0;
  bottom: 0;
  left: 0;
  border-top: 1rpx solid var(--color-line);
  background: var(--color-surface);
}

.settlement-dock__inner {
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: var(--figma-space-16) var(--space-page-x)
    calc(var(--figma-space-20) + env(safe-area-inset-bottom));
}

button.settlement-primary,
button.settlement-companion {
  width: 100%;
  margin: 0;
  border: 0;
  font-weight: 720;
  text-align: center;
}

button.settlement-primary {
  min-height: 96rpx;
  border-radius: var(--figma-radius-card);
  background: var(--color-action);
  color: var(--color-on-primary);
  font-size: var(--figma-font-body);
  line-height: 96rpx;
  box-shadow: var(--figma-shadow-elevated);
}

button.settlement-companion {
  min-height: 60rpx;
  background: none;
  color: var(--color-primary);
  font-size: var(--figma-font-body-compact);
  line-height: 60rpx;
}

@media (min-width: 768px) {
  .settlement-content {
    padding-top: var(--figma-space-32);
  }

  .settlement-title {
    font-size: var(--figma-font-page-title);
  }
}
