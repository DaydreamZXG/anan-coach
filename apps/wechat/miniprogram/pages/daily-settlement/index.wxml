<view class="settlement-page">
  <safe-top gap="{{0}}" />
  <view class="settlement-nav">
    <button class="settlement-back" aria-label="返回" bindtap="exit">
      <view class="settlement-back__icon"></view>
    </button>
  </view>

  <view class="settlement-content">
    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="结算没有加载成功"
      description="{{errorMessage}}"
      request-id="{{requestId}}"
      action-text="重新加载"
      bind:action="retry"
    />

    <block wx:elif="{{settlement}}">
      <view class="settlement-hero">
        <view class="settlement-title">今天到这里，看看真正留下了什么</view>
        <view class="settlement-copy">不比刷了多少，只看哪些变化值得带到明天。</view>
      </view>

      <view class="settlement-metrics">
        <view class="settlement-metric">
          <view class="metric-label">原计划</view>
          <view class="metric-value">{{scheduledLabel}}</view>
        </view>
        <view class="settlement-metric settlement-metric--actual">
          <view class="metric-label">实际学习</view>
          <view class="metric-value">{{elapsedLabel}}</view>
        </view>
        <view class="settlement-metric">
          <view class="metric-label">完成</view>
          <view class="metric-value">{{completionLabel}}</view>
        </view>
      </view>
      <view class="variance-label">{{varianceLabel}}</view>

      <view class="settlement-section">
        <view class="section-heading">
          <view class="section-heading__mark">◎</view>
          <view>今天确认了什么</view>
        </view>
        <view wx:if="{{hasSummary}}" class="settlement-card confirmation-card">
          <view class="confirmation-line"></view>
          <view class="settlement-summary">{{settlement.summary}}</view>
          <view class="evidence-note">
            完成 {{settlement.completedTaskCount}} 项 · 累计 {{settlement.elapsedMinutes}} 分钟 · 来自今天的真实记录
          </view>
        </view>
        <view wx:else class="settlement-card empty-card">
          <view class="empty-title">今天还没有形成可确认的变化</view>
          <view class="empty-copy">当前没有结算总结。回到今日页完成任务后，再来查看真实记录。</view>
        </view>
      </view>

      <view wx:if="{{settlement.newRisks.length}}" class="settlement-section">
        <view class="section-heading section-heading--warning">
          <view class="section-heading__mark">!</view>
          <view>今天新发现的问题</view>
        </view>
        <view class="settlement-card risk-card">
          <view wx:for="{{settlement.newRisks}}" wx:key="*this" class="risk-item">{{item}}</view>
        </view>
      </view>

      <view class="settlement-section">
        <view class="section-heading">
          <view class="section-heading__mark">○</view>
          <view>没完成的这一项</view>
        </view>
        <view wx:if="{{primaryOpenTask}}" class="settlement-card unfinished-card">
          <view class="unfinished-title">{{primaryOpenTask.title}}</view>
          <view class="unfinished-meta">
            {{primaryOpenTask.trackLabel}} · 计划 {{primaryOpenTask.plannedLabel}} ·
            {{primaryOpenTask.statusLabel}}
          </view>
          <view class="unfinished-note">没有完成的任务不会自动变成学习欠账。</view>
          <view wx:if="{{additionalOpenTaskCount > 0}}" class="unfinished-more">
            另外还有 {{additionalOpenTaskCount}} 项未完成，可在今日页查看。
          </view>
        </view>
        <view wx:else class="settlement-card empty-card">
          <view class="empty-title">今天没有未完成的任务</view>
          <view class="empty-copy">已安排任务都已闭环，可以直接结束今天。</view>
        </view>
      </view>

      <view class="settlement-section">
        <view class="section-heading">
          <view class="section-heading__mark">↗</view>
          <view>明天从哪里开始</view>
        </view>
        <view class="tomorrow-card">
          <view class="tomorrow-card__title">明天的第一项还没有生成</view>
          <view class="tomorrow-card__copy">
            新的日计划形成后会显示在今日页；现在可以先查看本周安排。
          </view>
          <button class="tomorrow-card__action" bindtap="openWeeklyPlan">查看本周计划</button>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{settlement}}" class="settlement-dock">
    <view class="settlement-dock__inner">
      <button class="settlement-primary" bindtap="returnToday">确认结算，结束今天</button>
      <button class="settlement-companion" bindtap="askAnan">
        带着今天的结果问岸岸 <text>✦</text>
      </button>
    </view>
  </view>
</view>
