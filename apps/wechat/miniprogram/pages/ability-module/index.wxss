@import "../../features/learning-brain/page-shell.wxss";
.decision-types { display: flex; flex-wrap: wrap; gap: 12rpx; }
.decision-types .active { background: var(--color-primary); color: #fff; }
.date-row, .decision-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: 18rpx; }
.date-box { padding: 18rpx; border-radius: 18rpx; background: var(--color-surface-soft); }
.date-box__value { display: block; margin-top: 8rpx; font-size: 23rpx; }
.candidate-box { margin-top: 20rpx; }
