<view class="brain-page">
  <view class="brain-hero"><view class="brain-kicker">{{module ? module.displayName : '模块详情'}}</view><view class="brain-title">把能力拆成能验证的组成部分</view><view class="brain-copy">正确率之外，还看速度、稳定、迁移、取舍和证据置信度。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error' && !module}}" state="error" title="模块画像没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="{{retryAllowed ? '重新加载' : ''}}" bind:action="retryLoad" />
  <block wx:elif="{{module}}">
    <view class="brain-card brain-grid"><view class="brain-metric"><view class="brain-label">正确率</view><text class="brain-metric__value type-data">{{correctRateLabel}}</text></view><view class="brain-metric"><view class="brain-label">平均用时</view><text class="brain-metric__value type-data">{{module.averageSeconds === null ? '证据不足' : module.averageSeconds + ' 秒'}}</text></view><view class="brain-metric"><view class="brain-label">稳定掌握</view><text class="brain-metric__value type-data">{{module.stableMasteryCount}}</text></view><view class="brain-metric"><view class="brain-label">到期复测</view><text class="brain-metric__value type-data">{{module.dueCount}}</text></view></view>
    <view class="brain-card"><view class="brain-row-title">证据状态：{{module.readiness}} · {{module.confidence}} 置信</view><view class="brain-note">{{module.evidenceCount}} 条证据，{{module.evidenceRefs.length}} 个当前版本引用。情绪不会改变这些事实。</view></view>
    <view class="brain-section-head"><view class="brain-section-title">有期限的战略取舍</view><view class="brain-section-meta">先候选，再确认</view></view>
    <view class="brain-card">
      <view class="decision-types"><button class="brain-pill {{decisionType === 'exam_skip' ? 'active' : ''}}" data-type="exam_skip" bindtap="chooseDecisionType">考场跳过</button><button class="brain-pill {{decisionType === 'phase_deprioritize' ? 'active' : ''}}" data-type="phase_deprioritize" bindtap="chooseDecisionType">阶段降权</button><button class="brain-pill {{decisionType === 'strategic_abandon' ? 'active' : ''}}" data-type="strategic_abandon" bindtap="chooseDecisionType">战略放弃</button></view>
      <textarea class="brain-textarea" value="{{rationale}}" maxlength="1000" placeholder="说明为什么考虑这个取舍；服务器会附上实际正确率、耗时和掌握证据。" bindinput="inputRationale" />
      <view class="date-row"><picker mode="date" bindchange="chooseReviewDate"><view class="date-box"><view class="brain-label">复评日期</view><text class="date-box__value">{{reviewDate || '请选择'}}</text></view></picker><picker mode="date" bindchange="chooseEffectiveDate"><view class="date-box"><view class="brain-label">失效日期</view><text class="date-box__value">{{effectiveDate || '请选择'}}</text></view></picker></view>
      <view class="brain-warning">候选不会自动生效；没有范围、收益证据、有效期和复评日，就不能形成战略决定。</view>
      <view wx:if="{{errorMessage}}" class="brain-warning">{{errorMessage}}</view>
      <button wx:if="{{!candidate}}" class="brain-action" loading="{{submitting}}" bindtap="createCandidate">生成证据候选</button>
      <view wx:else class="candidate-box"><view class="brain-row-title">候选 {{candidate.status}}</view><view class="brain-note">{{decisionMessage}}</view><view wx:if="{{candidate.status === 'awaiting_confirmation'}}" class="decision-actions"><button class="brain-action brain-action--secondary" data-action="reject" bindtap="decideCandidate">拒绝</button><button class="brain-action" data-action="confirm" bindtap="decideCandidate">确认有期限决定</button></view></view>
    </view>
  </block>
</view>
