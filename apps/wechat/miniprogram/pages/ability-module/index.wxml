<view class="brain-page">
  <view class="brain-hero"><view class="brain-kicker">{{module ? module.displayName : '模块详情'}}</view><view class="brain-title">把能力拆成能验证的组成部分</view><view class="brain-copy">除了正确率，还看速度、稳定性和举一反三。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error' && !module}}" state="error" title="模块画像没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="{{retryAllowed ? '重新加载' : ''}}" bind:action="retryLoad" />
  <block wx:elif="{{module}}">
    <view class="brain-card brain-grid"><view class="brain-metric"><view class="brain-label">正确率</view><text class="brain-metric__value type-data">{{correctRateLabel}}</text></view><view class="brain-metric"><view class="brain-label">平均用时</view><text class="brain-metric__value type-data">{{module.averageSeconds === null ? '记录还不够' : module.averageSeconds + ' 秒'}}</text></view><view class="brain-metric"><view class="brain-label">稳定掌握</view><text class="brain-metric__value type-data">{{module.stableMasteryCount}}</text></view><view class="brain-metric"><view class="brain-label">到期复测</view><text class="brain-metric__value type-data">{{module.dueCount}}</text></view></view>
    <view class="brain-card"><view class="brain-row-title">当前判断：{{readinessLabel}} · {{confidenceLabel}}</view><view class="brain-note">已参考 {{module.evidenceCount}} 条学习记录，其中 {{module.externalEvidenceCount}} 条来自你确认录入的外部答案。外部答案不会单独生成正确率或分数判断。</view></view>
    <view class="brain-section-head"><view class="brain-section-title">有期限的战略取舍</view><view class="brain-section-meta">先候选，再确认</view></view>
    <view class="brain-card">
      <view class="decision-types"><button class="brain-pill {{decisionType === 'exam_skip' ? 'active' : ''}}" data-type="exam_skip" bindtap="chooseDecisionType">考场跳过</button><button class="brain-pill {{decisionType === 'phase_deprioritize' ? 'active' : ''}}" data-type="phase_deprioritize" bindtap="chooseDecisionType">阶段降权</button><button class="brain-pill {{decisionType === 'strategic_abandon' ? 'active' : ''}}" data-type="strategic_abandon" bindtap="chooseDecisionType">战略放弃</button></view>
      <textarea cursor-spacing="24" class="brain-textarea" value="{{rationale}}" maxlength="1000" placeholder="说说你为什么想放弃这部分；我们会附上你的正确率和用时做参考。" bindinput="inputRationale" />
      <view class="date-row"><picker mode="date" bindchange="chooseReviewDate"><view class="date-box"><view class="brain-label">复评日期</view><text class="date-box__value">{{reviewDate || '请选择'}}</text></view></picker><picker mode="date" bindchange="chooseEffectiveDate"><view class="date-box"><view class="brain-label">失效日期</view><text class="date-box__value">{{effectiveDate || '请选择'}}</text></view></picker></view>
      <view class="brain-warning">这只是调整建议，不会自动生效。确认前请写清适用范围、预期收益、有效期和复评日。</view>
      <view wx:if="{{errorMessage}}" class="brain-warning">{{errorMessage}}</view>
      <button wx:if="{{!candidate}}" class="brain-action" loading="{{submitting}}" bindtap="createCandidate">生成调整建议</button>
      <view wx:else class="candidate-box"><view class="brain-row-title">{{candidateStatusLabel}}</view><view class="brain-note">{{decisionMessage}}</view><view wx:if="{{candidate.status === 'awaiting_confirmation'}}" class="decision-actions"><button class="brain-action brain-action--secondary" data-action="reject" bindtap="decideCandidate">不采用</button><button class="brain-action" data-action="confirm" bindtap="decideCandidate">确认采用</button></view></view>
    </view>
  </block>
</view>
