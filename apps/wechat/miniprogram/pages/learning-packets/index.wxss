@import "../../features/external-learning/page-shell.wxss";

.packets-state-view {
  display: block;
  margin-top: 32rpx;
}

.content-row,
.packet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.content-row {
  min-height: 98rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 20rpx 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
}

.content-row--selected {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.content-title {
  font-weight: 800;
}

.content-check {
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
}

.packet-head {
  align-items: flex-start;
}

.packet-meta {
  display: grid;
  gap: 8rpx;
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  word-break: break-all;
}

.packet-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.packet-action {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: var(--radius-control);
  background: var(--color-ink);
  color: var(--color-on-primary);
  font-size: var(--text-caption);
  font-weight: 800;
}

.packet-action--secondary {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}
