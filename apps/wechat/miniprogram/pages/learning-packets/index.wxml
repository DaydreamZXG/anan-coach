<view class="page external-page packets-page">
  <workbench-nav title="我的学习包" />
  <view class="external-hero">
    <view class="external-hero__copy">
      <view class="external-eyebrow">我的学习包</view>
      <view class="external-title">上传的资料，要变成能用的学习对象</view>
      <view class="external-subtitle">每个学习包保留来源、解析状态、知识点和关联任务；原始文件可单独删除。</view>
    </view>
    <anan-companion size="medium" intent="thinking" context="plan" animate />
  </view>

  <state-view wx:if="{{configurationError}}" custom-class="packets-state-view" state="error" title="学习包服务未完成配置" description="{{configurationError}}" />
  <state-view wx:elif="{{!state || state.status === 'idle' || state.status === 'loading'}}" custom-class="packets-state-view" state="loading" />
  <state-view wx:elif="{{state.status === 'error' && !state.packets.length}}" custom-class="packets-state-view" state="error" title="{{state.error.title}}" description="{{state.error.message}}" request-id="{{state.error.requestId}}" action-text="重新加载" bind:action="retryLoad" />

  <block wx:else>
    <view class="delivery-strip">
      <text>题目候选 {{state.eligibleContent.length}} 个 · 学习包 {{state.packets.length}} 份</text>
      <text wx:if="{{state.generatedAt}}">生成于 {{state.generatedAt}}</text>
    </view>
    <view wx:if="{{state.refreshError}}" class="inline-warning">没刷新成功，先看着之前的内容。<view hover-class="item--hover" class="inline-link" bindtap="retryLoad">重新加载 · {{state.refreshError.requestId}}</view></view>
    <view wx:if="{{state.partialReasons.length}}" class="inline-warning"><view>本次列表不完整：</view><view wx:for="{{state.partialReasons}}" wx:key="*this">· {{item}}</view></view>

    <view class="section-head"><view class="section-head__title">生成新学习包</view><view class="section-head__meta">仅显示你已确认的题目</view></view>
    <view class="external-card">
      <view class="field-label">科目</view>
      <view class="choice-row">
        <view hover-class="item--hover" class="choice {{state.track === 'xingce' ? 'choice--active' : ''}}" role="button" aria-label="选择行测学习包" data-value="xingce" bindtap="chooseTrack">行测</view>
        <view hover-class="item--hover" class="choice {{state.track === 'essay' ? 'choice--active' : ''}}" role="button" aria-label="选择申论学习包" data-value="essay" bindtap="chooseTrack">申论</view>
      </view>
      <view class="field-label">导出格式</view>
      <view class="choice-row">
        <view hover-class="item--hover" class="choice {{state.renderFormat === 'pdf' ? 'choice--active' : ''}}" role="button" aria-label="导出 PDF" data-value="pdf" bindtap="chooseFormat">PDF 打印包</view>
        <view hover-class="item--hover" class="choice {{state.renderFormat === 'note_app_file' ? 'choice--active' : ''}}" role="button" aria-label="导出笔记应用文件" data-value="note_app_file" bindtap="chooseFormat">笔记应用文件</view>
      </view>
      <view class="field-label">选择题目</view>
      <view wx:for="{{state.eligibleContent}}" wx:key="contentVersionId">
        <view hover-class="item--hover" wx:if="{{item.track === state.track}}" class="content-row {{item.selected ? 'content-row--selected' : ''}}" role="checkbox" aria-checked="{{item.selected}}" data-id="{{item.contentVersionId}}" bindtap="toggleContent">
          <view><view class="content-title">{{item.title}}</view><view class="card-copy">{{item.sourceLabel}} · {{item.versionLabel}}</view></view>
          <view class="content-check">{{item.selected ? '✓' : '＋'}}</view>
        </view>
      </view>
      <view wx:if="{{!state.visibleEligibleContentCount}}" class="inline-note">这个科目还没有确认好的题目。<view hover-class="item--hover" class="inline-link" bindtap="openCaptureImport">去拍题或导入 →</view></view>
      <view wx:if="{{state.validationError}}" class="inline-error">{{state.validationError}}</view>
      <view wx:if="{{state.error}}" class="inline-error">{{state.error.message}}<view wx:if="{{state.error.requestId}}">问题编号 · {{state.error.requestId}}</view></view>
      <view class="action-stack"><ui-button label="{{state.pendingRecovery ? '确认刚才的结果' : '生成学习包'}}" loading="{{state.creating}}" disabled="{{!state.visibleEligibleContentCount || state.operatingPacketId || state.openingPacketVersionId}}" bind:action="createPacket" /></view>
      <view class="card-copy">生成过程中可以离开本页，稍后回来会继续显示进度。</view>
    </view>

    <view class="section-head"><view class="section-head__title">历史学习包</view><view class="section-head__meta">每份内容和有效期独立保存</view></view>
    <state-view wx:if="{{!state.packets.length}}" custom-class="packets-state-view" state="empty" title="还没有学习包" description="选择已确认的题目后生成第一份；尚未核对的识别内容不会出现在这里。" />
    <view wx:for="{{state.packets}}" wx:key="packetVersionId" class="external-card packet-card">
      <view class="packet-head">
        <view><view class="card-title">{{item.displayTitle}}</view><view class="card-copy">{{item.versionLabel}} · {{item.itemCountLabel}} · {{item.renderFormat === 'pdf' ? 'PDF' : '笔记文件'}}</view></view>
        <view class="status-pill status-pill--{{item.stateTone}}">{{item.stateLabel}}</view>
      </view>
      <view class="packet-meta"><text>创建 {{item.createdAtLabel}}</text><text>{{item.expiresAtLabel}}</text></view>
      <view wx:if="{{item.state === 'requested' || item.state === 'generating'}}" class="inline-note">正在排版和校对题目……</view>
      <view wx:elif="{{item.state === 'expired'}}" class="inline-warning">这份学习包已过期，原下载地址不再有效；重新生成会保留旧记录。</view>
      <view wx:elif="{{item.state === 'revoked'}}" class="inline-warning">内容授权已变更，旧包不能继续下载。</view>
      <view class="packet-actions">
        <view hover-class="item--hover" wx:if="{{item.canOpen}}" class="packet-action" role="button" aria-label="打开学习包" data-id="{{item.packetVersionId}}" bindtap="openPacket">{{state.openingPacketVersionId === item.packetVersionId ? '正在获取…' : '打开 / 导出'}}</view>
        <view hover-class="item--hover" wx:if="{{item.canRetry}}" class="packet-action" role="button" aria-label="继续生成学习包" data-id="{{item.packetVersionId}}" bindtap="retryPacket">{{state.operatingPacketId === item.packetId ? '正在恢复…' : '继续生成'}}</view>
        <view hover-class="item--hover" wx:if="{{item.canRenew}}" class="packet-action" role="button" aria-label="重新生成学习包" data-id="{{item.packetVersionId}}" bindtap="renewPacket">{{state.operatingPacketId === item.packetId ? '正在生成…' : '重新生成'}}</view>
        <view hover-class="item--hover" wx:if="{{item.canIngestAnswers}}" class="packet-action packet-action--secondary" role="button" aria-label="录入该学习包答案" data-id="{{item.packetVersionId}}" bindtap="openAnswerIngestion">录入答案</view>
      </view>
    </view>
  </block>
</view>
