.retake-page {
  display: flex;
  flex-direction: column;
}
.page-state,
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 62vh;
  text-align: center;
}
.state-title,
.empty-title {
  margin-top: calc(28 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 800;
}
.state-copy,
.empty-copy {
  max-width: calc(570 * var(--rpx));
  margin: calc(16 * var(--rpx)) 0 calc(32 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}
.request-id {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-faint);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}
.target-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(28 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
}
.target-strip__label {
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.target-strip__year {
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
}
.section-title {
  margin-top: calc(32 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.evidence-list {
  display: flex;
  flex-direction: column;
  gap: calc(16 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}
.evidence-card {
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.evidence-card--selected {
  border-color: var(--color-primary);
  background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
}
.evidence-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.evidence-year {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 800;
}
.evidence-source {
  margin-left: calc(16 * var(--rpx));
  padding: calc(8 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: var(--text-micro);
}
.evidence-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(42 * var(--rpx));
  height: calc(42 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: 50%;
  color: var(--color-surface);
  font-weight: 800;
}
.evidence-card--selected .evidence-check {
  border-color: var(--color-primary);
  background: var(--color-primary);
}
.score-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(12 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}
.score-cell {
  padding: calc(16 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-16);
  background: rgba(255, 255, 255, 0.76);
  text-align: center;
}
.score-label {
  display: block;
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.score-value {
  display: block;
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.program-card {
  margin-top: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary);
  border-radius: var(--radius-32);
  background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
  box-shadow: var(--shadow-card);
}
.program-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
}
.program-title {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.track-row {
  display: flex;
  flex-direction: column;
  gap: calc(12 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}
.focus-item {
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.boundary-note,
.recovery-banner,
.error-banner {
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.6;
}
.boundary-note {
  margin-bottom: calc(28 * var(--rpx));
  background: var(--color-surface-soft);
  color: var(--color-muted);
}
.recovery-banner {
  background: var(--color-warning-soft);
  color: var(--color-ink-secondary);
}
.error-banner {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

/* 排版总纲·列表模板：实考证据卡宽屏 2 列。 */
@media (min-width: 1024px) {
  .evidence-list {
    display: grid;
    align-items: stretch;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .evidence-list > .evidence-card {
    height: 100%;
    box-sizing: border-box;
  }
}
