.retake-page {
  display: flex;
  flex-direction: column;
}
.page-state,
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 62vh;
  text-align: center;
}
.state-title,
.empty-title {
  margin-top: 28rpx;
  font-size: var(--text-section);
  font-weight: 800;
}
.state-copy,
.empty-copy {
  max-width: 570rpx;
  margin: 16rpx 0 32rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}
.request-id {
  margin-top: 12rpx;
  color: var(--color-faint);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}
.target-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
}
.target-strip__label {
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.target-strip__year {
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
}
.section-title {
  margin-top: 32rpx;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.evidence-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}
.evidence-card {
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.evidence-card--selected {
  border-color: var(--color-primary);
  background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
}
.evidence-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.evidence-year {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 800;
}
.evidence-source {
  margin-left: 16rpx;
  padding: 8rpx 12rpx;
  border-radius: var(--radius-12);
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: var(--text-micro);
}
.evidence-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 50%;
  color: var(--color-surface);
  font-weight: 800;
}
.evidence-card--selected .evidence-check {
  border-color: var(--color-primary);
  background: var(--color-primary);
}
.score-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}
.score-cell {
  padding: 16rpx 12rpx;
  border-radius: var(--radius-16);
  background: rgba(255, 255, 255, 0.76);
  text-align: center;
}
.score-label {
  display: block;
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.score-value {
  display: block;
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.program-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-32);
  background: linear-gradient(145deg, var(--color-surface), var(--color-primary-soft));
  box-shadow: var(--shadow-card);
}
.program-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
}
.program-title {
  margin-top: 12rpx;
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.track-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
}
.focus-item {
  padding: 20rpx 20rpx;
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.boundary-note,
.recovery-banner,
.error-banner {
  margin-top: 20rpx;
  padding: 20rpx 20rpx;
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.6;
}
.boundary-note {
  margin-bottom: 28rpx;
  background: var(--color-surface-soft);
  color: var(--color-muted);
}
.recovery-banner {
  background: var(--color-warning-soft);
  color: var(--color-ink-secondary);
}
.error-banner {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
