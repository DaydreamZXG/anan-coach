.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.retake { display: flex; flex-direction: column; min-height: 100vh; }

.rt-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.rt-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.rt-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }

.rt-loading { padding: 120rpx 0; text-align: center; }
.rt-body { flex: 1; min-height: 0; }

.rt-anan {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.rt-anan-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: #5c4a35; }

.rt-evidence {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  border: 2rpx solid var(--line);
  margin-bottom: 20rpx;
}
.rt-evidence.is-on { border-color: var(--primary); background: var(--primary-soft); }
.rt-ev-main { display: flex; flex-direction: column; gap: 6rpx; }
.rt-ev-year { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.rt-ev-source {
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 6rpx 20rpx;
  flex-shrink: 0;
}
.rt-boundary { display: block; padding: 8rpx 8rpx 24rpx; line-height: 1.6; }
.rt-import-link { text-align: center; padding: 0 0 24rpx; }

.rt-program { display: flex; flex-direction: column; gap: 32rpx; margin-bottom: 32rpx; }
.rt-program-head { display: flex; align-items: center; justify-content: space-between; }
.rt-state {
  font-size: 22rpx; color: var(--good);
  background: var(--good-soft);
  border-radius: 999rpx; padding: 6rpx 20rpx;
}
.rt-scores { display: flex; gap: 48rpx; }
.rt-score { display: flex; flex-direction: column; gap: 4rpx; }
.rt-score-num { font-size: 52rpx; font-weight: 700; color: var(--ink); }

.rt-limitation, .rt-focus { display: flex; flex-direction: column; gap: 12rpx; border-top: 1rpx dashed var(--line); padding-top: 24rpx; }
.rt-lim-label { font-size: 24rpx; font-weight: 600; color: var(--primary); }
.rt-lim-text { font-size: 28rpx; line-height: 1.6; color: var(--ink); }
.rt-focus-item { display: flex; gap: 16rpx; align-items: flex-start; }
.rt-focus-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); margin-top: 14rpx; flex-shrink: 0; }
.rt-focus-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: var(--ink); }

.rt-cta { width: 100%; margin-bottom: 24rpx; }

.rt-empty { display: flex; flex-direction: column; gap: 24rpx; padding-top: 96rpx; text-align: center; align-items: center; }

.demo-tip { text-align: center; padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx); }
