.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

.foot-space {
  height: 80rpx;
}

/* ── 顶部导航 ── */

.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__text {
  flex: 1;
  min-width: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 模式概览 hero ── */

.hero {
  margin: 8rpx 32rpx 28rpx;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.hero__cap {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.08em;
}

.hero__title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.35;
}

.hero__chips {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero__chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.1);
}

.hero__chip--confirmed {
  background: rgba(13, 159, 110, 0.28);
  color: #6ee7b7;
}

.hero__chip--counter {
  background: rgba(217, 127, 6, 0.3);
  color: #fcd34d;
}

.hero__chip--retired {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.45);
}

/* ── 观测数据 ── */

.metrics {
  margin: 0 32rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--shadow-card);
  padding: 28rpx 12rpx;
  display: flex;
  align-items: center;
}

.metrics__cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.metrics__num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink);
}

.metrics__num--amber {
  color: var(--amber);
}

.metrics__num--date {
  font-size: 30rpx;
}

.metrics__label {
  font-size: 22rpx;
  color: var(--ink-3);
}

.metrics__divider {
  width: 2rpx;
  height: 52rpx;
  background: var(--line);
}

/* ── 区块标题（section-head 用全局样式） ── */

.section-head {
  margin: 0 32rpx 20rpx;
}

/* ── 内容卡 ── */

.block-card {
  margin: 0 32rpx 28rpx;
  padding: 28rpx;
}

.block-card__kicker {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}

.block-card__text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
}

.block-card__empty {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ── 证据行 ── */

.evi {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 16rpx 0;
}

.evi + .evi {
  border-top: 1rpx solid var(--line);
}

.evi__dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 4rpx;
  background: var(--grad-main);
}

.evi__dot--counter {
  background: var(--amber);
}

.evi__main {
  flex: 1;
  min-width: 0;
}

.evi__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.evi__meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 局限 ── */

.limit {
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
  padding: 6rpx 0;
}
