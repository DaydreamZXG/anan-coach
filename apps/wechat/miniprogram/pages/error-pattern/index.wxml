<view class="s9-page brain-page">
  <view class="brain-hero">
    <view class="brain-kicker">{{detail ? detail.pattern.displayName : '错误模式'}}</view>
    <view class="brain-title">同一种错法，不该伪装成很多道错题</view>
    <view class="brain-copy">按触发条件、行为、后果和修正动作，合并长期重复的错误。</view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{status === 'error'}}"
    state="error"
    title="错误模式没有加载成功"
    description="{{errorMessage}}"
    request-id="{{requestId}}"
    action-text="{{retryAllowed ? '重新加载' : ''}}"
    bind:action="retryLoad"
  />

  <block wx:elif="{{detail}}">
    <view class="brain-card brain-grid">
      <view class="brain-metric"><view class="brain-label">出现次数</view><text class="brain-metric__value type-data">{{detail.pattern.occurrenceCount}}</text></view>
      <view class="brain-metric"><view class="brain-label">相反记录</view><text class="brain-metric__value type-data">{{detail.pattern.counterevidenceCount}}</text></view>
      <view class="brain-metric"><view class="brain-label">当前状态</view><text class="brain-metric__value">{{patternStatusLabel}}</text></view>
      <view class="brain-metric"><view class="brain-label">最近出现</view><text class="brain-metric__value">{{latestLabel}}</text></view>
    </view>

    <view class="brain-card">
      <view class="brain-row-title">当前解释</view>
      <view class="brain-note">{{detail.interpretation}}</view>
    </view>

    <view class="brain-section-head">
      <view class="brain-section-title">支持这个判断的记录</view>
      <view class="brain-section-meta">{{supportingEvidence.length}} 条</view>
    </view>
    <view class="brain-card">
      <view wx:if="{{!supportingEvidence.length}}" class="brain-empty">这条判断已经没有有效支持记录。</view>
      <view wx:for="{{supportingEvidence}}" wx:key="label" class="brain-row">
        <view class="brain-row-main">
          <view class="brain-row-title">{{item.label}}</view>
          <view class="brain-row-copy">{{item.meta}}</view>
        </view>
      </view>
    </view>

    <view class="brain-section-head"><view class="brain-section-title">局限与相反记录</view></view>
    <view class="brain-card">
      <view wx:if="{{!detail.limitations.length}}" class="brain-empty">暂未记录额外局限。</view>
      <view wx:for="{{detail.limitations}}" wx:key="*this" class="brain-row-copy">· {{item}}</view>
    </view>
  </block>
</view>
