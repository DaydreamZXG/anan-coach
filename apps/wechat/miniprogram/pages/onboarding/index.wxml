<view class="s9-page s9-page--with-dock onboarding">
  <view wx:if="{{loadingProfile}}" class="loading-state">
    <anan-companion size="large" intent="thinking" context="plan" animate />
    <view class="loading-title">正在恢复你的资格档案</view>
    <view class="loading-copy">会按服务端建档进度继续，不让你重复填写已确认事实。</view>
  </view>
  <view wx:elif="{{loadFailed}}" class="loading-state">
    <anan-companion size="large" intent="rest" context="emotion" />
    <view class="loading-title">资格档案没有恢复完成</view>
    <view class="loading-copy">{{error}}</view>
    <ui-button label="重新读取" bind:action="retryLoad" />
  </view>
  <block wx:elif="{{!saved}}">
    <view class="s9-hero">
      <view class="s9-title">先把你真正要去的地方说清楚</view>
      <view class="s9-subtitle">三分钟建立目标、经历与可用时间，岸岸再给建议。</view>
      <view class="s9-chip-row"><view class="s9-chip s9-chip--primary">约 3 分钟</view><view class="s9-chip">可稍后修改</view></view>
    </view>

    <view class="progress-track"><view class="progress-value progress-value--{{current}}"></view></view>

    <view class="s9-card s9-card--primary onboarding-step-card">
      <view class="s9-card-kicker">第 {{current + 1}} 步 · {{steps[current].label}}</view>
      <view class="s9-card-title">{{steps[current].title}}</view>
      <view class="s9-card-copy">{{steps[current].copy}}</view>
      <view class="step-count type-data">{{current + 1}} / 4</view>
    </view>

    <view class="form-card s9-card">
      <block wx:if="{{current === 0}}">
        <view class="field-label">最高学历</view>
        <view class="choice-grid choice-grid--four">
          <view wx:for="{{['大专','本科','硕士','博士']}}" wx:key="*this" class="choice {{education === item ? 'choice--selected' : ''}}" data-value="{{item}}" bindtap="chooseEducation">
            <view class="choice-dot"></view><text>{{item}}</text>
          </view>
        </view>
        <view class="field-label field-label--spaced">毕业证专业名称</view>
        <view class="input-shell {{major ? 'input-shell--filled' : ''}}">
          <input class="input-shell__control" value="{{major}}" maxlength="80" placeholder="例如：法学、汉语言文学" bindinput="inputMajor" />
          <view class="input-badge">原文</view>
        </view>
        <view class="field-help">请按毕业证填写，不要只填“经管类”“计算机类”。专业大类会由岗位规则单独核验。</view>
      </block>

      <block wx:elif="{{current === 1}}">
        <view class="field-label">是否属于应届高校毕业生</view>
        <view class="choice-grid">
          <view class="choice choice--large {{freshGraduate === 'true' ? 'choice--selected' : ''}}" data-value="true" bindtap="chooseFreshGraduate">
            <view class="choice-icon">应</view><view><view class="choice-title">是</view><view class="choice-copy">包含政策规定的择业期情形</view></view>
          </view>
          <view class="choice choice--large {{freshGraduate === 'false' ? 'choice--selected' : ''}}" data-value="false" bindtap="chooseFreshGraduate">
            <view class="choice-icon">社</view><view><view class="choice-title">否</view><view class="choice-copy">按社会人员条件核验</view></view>
          </view>
        </view>
        <view class="field-label field-label--spaced">政治面貌</view>
        <view class="choice-list">
          <view wx:for="{{['中共党员','中共预备党员','共青团员','群众','民主党派']}}" wx:key="*this" class="choice-row {{politicalStatus === item ? 'choice-row--selected' : ''}}" data-value="{{item}}" bindtap="choosePoliticalStatus">
            <text>{{item}}</text><view class="row-check">✓</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{current === 2}}">
        <view class="field-label">基层工作经历</view>
        <view class="year-strip">
          <view wx:for="{{[0,1,2,3,5]}}" wx:key="*this" class="year-chip {{grassrootsYears === item ? 'year-chip--selected' : ''}}" data-value="{{item}}" bindtap="chooseGrassrootsYears"><text class="type-data">{{item === 5 ? '5+' : item}}</text> 年</view>
        </view>
        <view class="field-help">按公告口径填写；岗位要求 2 年时，1 年 11 个月不会被算作满足。</view>
        <view class="field-label field-label--spaced">户籍或生源地限制核验</view>
        <view class="input-shell {{hukou ? 'input-shell--filled' : ''}}">
          <input class="input-shell__control" value="{{hukou}}" maxlength="60" placeholder="选填，例如：江西省赣州市" bindinput="inputHukou" />
          <view class="input-badge input-badge--optional">选填</view>
        </view>
        <view class="notice-card">
          <view class="notice-mark">i</view>
          <view>户籍、生源地、证书和备注条件不会被 AI 猜测；无法确定时会显示“待确认”。</view>
        </view>
      </block>

      <block wx:else>
        <view class="review-head">
          <view class="review-status">待本人确认</view>
          <view class="review-caption">保存后形成新的资格档案版本</view>
        </view>
        <view class="review-list">
          <view class="review-row"><text class="review-row__label">学历</text><text class="review-row__value">{{education}}</text></view>
          <view class="review-row"><text class="review-row__label">专业</text><text class="review-row__value">{{major}}</text></view>
          <view class="review-row"><text class="review-row__label">应届身份</text><text class="review-row__value">{{freshGraduate === 'true' ? '是' : '否'}}</text></view>
          <view class="review-row"><text class="review-row__label">政治面貌</text><text class="review-row__value">{{politicalStatus}}</text></view>
          <view class="review-row"><text class="review-row__label">基层经历</text><text class="review-row__value">{{grassrootsYears === 5 ? '5 年以上' : grassrootsYears + ' 年'}}</text></view>
          <view class="review-row"><text class="review-row__label">户籍 / 生源地</text><text class="review-row__value">{{hukou || '未填写，相关岗位将待确认'}}</text></view>
        </view>
        <view class="confirm-copy">我确认以上内容来自本人真实情况。后续修改会生成新版本，已有岗位结论将自动重新核验。</view>
      </block>
    </view>

    <view wx:if="{{pendingRecovery}}" class="recovery-banner">
      <view class="recovery-mark">↻</view>
      <view>
        <view class="recovery-title">上一次确认结果还不确定</view>
        <view class="recovery-copy">资格事实已锁定；重试会复用原命令，不会重复生成档案版本。</view>
      </view>
    </view>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{requestId}}" class="request-id">Request ID · {{requestId}}</view>
    <view class="s9-action-dock">
      <view class="s9-action-row">
        <button wx:if="{{current > 0}}" class="s9-secondary-button" bindtap="previous">返回</button>
        <button class="s9-primary-button" loading="{{saving}}" bindtap="next">{{primaryActionLabel}}</button>
      </view>
    </view>
  </block>

  <view wx:else class="success-state">
    <view class="success-orbit"><anan-companion size="large" intent="encouragement" context="post-submit" animate /></view>
    <view class="success-kicker">资格档案 v{{profileVersion}}</view>
    <view class="success-title">岸岸已经记住你了</view>
    <view class="success-copy">下一步逐个核验岗位硬条件。每一条“可报”都能看到依据；不确定的地方会明确请你确认。</view>
    <view class="success-points">
      <view class="success-point"><text class="success-point__check">✓</text>事实已按版本保存</view>
      <view class="success-point"><text class="success-point__check">✓</text>修改后自动重新核验</view>
      <view class="success-point"><text class="success-point__check">✓</text>AI 不替你猜资格条件</view>
    </view>
    <ui-button label="继续设置学习节奏" bind:action="continueOnboarding" />
  </view>
</view>
