<view class="eligibility-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="2/5 报考资格"
    back-behavior="emit"
    bind:back="back"
  />

  <view wx:if="{{loadingProfile}}" class="eligibility-state">
    <state-view state="loading" title="正在恢复报考资料" description="会读取你已经确认过的学历、专业和经历。" />
  </view>

  <view wx:elif="{{loadFailed}}" class="eligibility-state">
    <state-view state="error" title="报考资料没有恢复完成" description="{{error}}" actionText="重新读取" bindaction="retryLoad" />
    <view wx:if="{{requestId}}" class="request-id">问题编号 · {{requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="eligibility-scroll" enhanced show-scrollbar="{{false}}">
      <view class="eligibility-content onboarding-scroll-content fade-slide-in fade-slide-in--2">
        <view class="boundary-notice">
          <image class="notice-icon" src="/assets/icons/onboarding/notice-warning.svg" mode="aspectFit" />
          <view class="notice-copy">这部分信息将决定你能否跨过岗位的硬性门槛。不确定的可以先标记“稍后确认”。</view>
        </view>

        <view class="form-card">
          <view class="card-title">专业与学历</view>
          <view class="card-copy">专业是国考岗位的核心门槛，匹配度优先于地区偏好。</view>

          <view class="major-field {{majorCategory ? 'major-field--selected' : ''}}">
            <image class="search-icon" src="/assets/icons/onboarding/search-muted.svg" mode="aspectFit" />
            <input
              class="major-input"
              value="{{major}}"
              maxlength="80"
              placeholder="搜索具体专业名称..."
              disabled="{{catalogLoading || !!catalogError}}"
              bindinput="inputMajor"
            />
          </view>
          <view wx:if="{{catalogLoading}}" class="catalog-status">正在读取国考专业目录…</view>
          <view wx:if="{{catalogError}}" class="catalog-error">
            <text>{{catalogError}}</text>
            <button hover-class="item--hover" class="catalog-retry" bindtap="retryCatalog">重新读取</button>
          </view>
          <view wx:if="{{majorSuggestions.length}}" class="major-results">
            <button hover-class="item--hover"
              wx:for="{{majorSuggestions}}"
              wx:key="code"
              class="major-result"
              data-name="{{item.name}}"
              data-category="{{item.category}}"
              bindtap="selectMajor"
            >
              <view class="major-result__title">{{item.name}} <text class="major-result__code">{{item.code}}</text></view>
              <view class="major-result__category">{{item.category}}</view>
            </button>
          </view>
          <view wx:if="{{majorCategory}}" class="major-selected-meta">{{majorCategory}}</view>

          <view class="field-grid">
            <view class="picker-field">
              <view class="picker-label">最高学历</view>
              <picker mode="selector" range="{{educationOptions}}" bindchange="chooseEducation">
                <view class="picker-control {{education ? 'picker-control--filled' : ''}}">
                  <text>{{education || '请选择'}}</text>
                  <view class="picker-chevron"></view>
                </view>
              </picker>
            </view>
            <view class="picker-field">
              <view class="picker-label">毕业年份</view>
              <picker mode="selector" range="{{graduationOptions}}" range-key="label" bindchange="chooseGraduation">
                <view class="picker-control {{graduationLabel ? 'picker-control--filled' : ''}}">
                  <text>{{graduationLabel || '请选择'}}</text>
                  <view class="picker-chevron"></view>
                </view>
              </picker>
            </view>
          </view>
        </view>

        <view class="form-card experience-card">
          <view class="card-title">服务基层项目经历</view>
          <view class="card-copy">包含大学生村官、三支一扶、特岗教师等。此项能为你解锁大量定向招录的特殊岗位，与普通工作经历严格区分。</view>

          <view class="service-options">
            <button hover-class="item--hover"
              class="service-option {{serviceProject === '无' ? 'service-option--selected' : ''}}"
              data-mode="none"
              bindtap="chooseServiceMode"
            >
              <text>无服务基层项目经历</text>
              <view wx:if="{{serviceProject === '无'}}" class="option-check">✓</view>
            </button>
            <button hover-class="item--hover"
              class="service-option service-option--column {{serviceExpanded ? 'service-option--selected service-option--project' : ''}}"
              data-mode="has"
              bindtap="chooseServiceMode"
            >
              <view class="service-option__head">
                <text>有基层项目经历</text>
                <view wx:if="{{serviceExpanded && serviceProject}}" class="option-check option-check--indigo">✓</view>
              </view>
              <view wx:if="{{serviceExpanded}}" class="project-list">
                <button hover-class="item--hover"
                  wx:for="{{serviceProjectOptions}}"
                  wx:key="*this"
                  class="project-chip {{serviceProject === item ? 'project-chip--selected' : ''}}"
                  data-value="{{item}}"
                  catchtap="chooseServiceProject"
                >{{item}}</button>
              </view>
            </button>
          </view>

          <view class="divider"></view>
          <view class="card-title">普通工作经历</view>
          <view class="work-options">
            <button hover-class="item--hover" class="control-center work-option {{workYears === 0 ? 'work-option--selected' : ''}}" data-value="0" bindtap="chooseWorkYears">无经验</button>
            <button hover-class="item--hover" class="control-center work-option {{workYears === 1 ? 'work-option--selected' : ''}}" data-value="1" bindtap="chooseWorkYears">2 年以下</button>
            <button hover-class="item--hover" class="control-center work-option {{workYears === 2 ? 'work-option--selected' : ''}}" data-value="2" bindtap="chooseWorkYears">2 年以上</button>
          </view>
        </view>

        <button hover-class="item--hover" class="mark-later" loading="{{savingDraft}}" bindtap="markLater">稍后确认这页的缺失信息</button>

        <view wx:if="{{error}}" class="error-banner">{{error}}</view>
        <view wx:if="{{requestId}}" class="request-id">问题编号 · {{requestId}}</view>
      </view>
    </scroll-view>

    <view class="eligibility-dock onboarding-action-dock">
      <button hover-class="item--hover"
        class="control-center eligibility-primary {{primaryDisabled || catalogLoading || catalogError ? 'eligibility-primary--disabled' : ''}} tap-tactile"
        loading="{{saving}}"
        disabled="{{saving || savingDraft || primaryDisabled || catalogLoading || !!catalogError}}"
        bindtap="submit"
      >{{primaryActionLabel}}</button>
      <button
        hover-class="item--hover"
        class="onboarding-save-action"
        loading="{{savingDraft}}"
        disabled="{{saving || savingDraft}}"
        bindtap="saveAndExit"
      >暂存并退出</button>
    </view>
  </block>
</view>
