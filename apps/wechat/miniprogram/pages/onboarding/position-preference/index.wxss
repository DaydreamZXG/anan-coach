.preference-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.preference-nav {
  box-sizing: border-box;
  display: flex;
  height: 112rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.8);
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-back,
.nav-save,
.catalog-retry,
.region-chip,
.relocation-row,
.level-row,
.preference-primary {
  margin: 0;
  border: 0;
}

.nav-back::after,
.nav-save::after,
.catalog-retry::after,
.region-chip::after,
.relocation-row::after,
.level-row::after,
.preference-primary::after {
  border: 0;
}

.nav-back {
  display: flex;
  width: 64rpx;
  height: 80rpx;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
}

.nav-back__icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
}

.nav-save {
  padding: 12rpx 24rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 39rpx;
}

.preference-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.preference-scroll {
  min-height: 0;
  flex: 1;
}

.preference-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.preference-card {
  box-sizing: border-box;
  padding: 40rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.02);
}

.level-card {
  margin-top: 48rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 45rpx;
}

.card-copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.625;
}

.catalog-state {
  margin-top: 32rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.catalog-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: 22rpx;
}

.catalog-retry {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: 21rpx;
  font-weight: 700;
}

.region-scroll {
  width: 100%;
  max-height: 166rpx;
  margin-top: 32rpx;
}

.region-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 2rpx;
}

.region-chip {
  flex: none;
  padding: 16rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--figma-color-ink-tertiary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.region-chip--selected {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.14);
}

.relocation-row {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 136rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--bg);
  text-align: left;
}

.relocation-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.relocation-copy {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.switch {
  box-sizing: border-box;
  display: flex;
  width: 96rpx;
  height: 56rpx;
  flex: none;
  align-items: center;
  padding: 8rpx;
  border-radius: 99rpx;
  background: var(--color-line-strong);
  transition: background 180ms ease;
}

.switch--on {
  justify-content: flex-end;
  background: var(--good);
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.18);
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.level-row {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: left;
}

.level-check {
  box-sizing: border-box;
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--figma-color-line-emphasis);
  border-radius: 8rpx;
  color: transparent;
  font-size: 22rpx;
}

.level-row--selected .level-check {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--primary-deep);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  text-align: center;
}

.preference-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(42rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.preference-primary {
  width: 100%;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-radius: 48rpx;
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.12);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.preference-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.nav-back {
  width: 64rpx;
}

button.nav-save,
button.catalog-retry,
button.region-chip {
  width: auto;
}

button.relocation-row,
button.level-row,
button.preference-primary {
  width: 100%;
}

@media (min-width: 768px) {
  .preference-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .preference-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
