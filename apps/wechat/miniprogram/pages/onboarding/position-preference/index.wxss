@import "../../../features/onboarding/page-shell.wxss";

.preference-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.catalog-retry,
.region-chip,
.relocation-row,
.level-row,
.preference-primary {
  margin: 0;
  border: 0;
}

.catalog-retry::after,
.region-chip::after,
.relocation-row::after,
.level-row::after,
.preference-primary::after {
  border: 0;
}

.preference-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.preference-scroll {
  min-height: 0;
  flex: 1;
}

.preference-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.preference-card {
  box-sizing: border-box;
  padding: 40rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.level-card {
  margin-top: 48rpx;
}

.card-title {
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 45rpx;
}

.card-copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.625;
}

.catalog-state {
  margin-top: 32rpx;
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 600;
}

.catalog-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 20rpx;
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-micro);
}

.catalog-retry {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--text-micro);
  font-weight: 700;
}

.region-picker {
  width: 100%;
  margin-top: 32rpx;
}

.region-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 2rpx;
}

.region-group {
  margin-top: 24rpx;
}

.region-group:first-child {
  margin-top: 0;
}

.region-group__title {
  margin-bottom: 12rpx;
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 700;
}

button.region-toggle {
  width: auto;
  min-height: 64rpx;
  margin-top: 20rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 64rpx;
}

button.region-toggle::after {
  border: 0;
}

.region-chip {
  flex: none;
  padding: 16rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.5;
}

.region-chip--selected {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.relocation-row {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 136rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding: 32rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
  text-align: left;
}

.relocation-title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 40rpx;
}

.relocation-copy {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 32rpx;
}

.switch {
  box-sizing: border-box;
  display: flex;
  width: 96rpx;
  height: 56rpx;
  flex: none;
  align-items: center;
  padding: 8rpx;
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
  transition: background 180ms ease;
}

.switch--on {
  justify-content: flex-end;
  background: var(--color-primary);
}

.switch-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.level-row {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 40rpx;
  text-align: left;
}

.level-check {
  box-sizing: border-box;
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--figma-color-line-emphasis);
  border-radius: var(--radius-8);
  color: transparent;
  font-size: var(--text-micro);
}

.level-row--selected .level-check {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.preference-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(42rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26rpx);
}

.preference-primary {
  width: 100%;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.5;
}

.preference-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.catalog-retry,
button.region-chip {
  width: auto;
}

button.relocation-row,
button.level-row,
button.preference-primary {
  width: 100%;
}

@media (min-width: 768px) {
  .preference-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .preference-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
