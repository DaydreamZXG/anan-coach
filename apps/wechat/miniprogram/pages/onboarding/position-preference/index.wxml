<wxs src="./regions.wxs" module="regionUtil" />
<view class="preference-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="3/5 想考哪里"
    back-behavior="emit"
    bind:back="back"
  />

  <view wx:if="{{!state || state.status === 'loading'}}" class="preference-state">
    <state-view state="loading" title="正在找回你想考的地方" description="别急，你选过的地区和层级都还记得。" />
  </view>

  <view wx:elif="{{state.status === 'error'}}" class="preference-state">
    <state-view state="error" title="哎，没找回来" description="{{state.error.message}}" actionText="再试一次" bindaction="retry" />
    <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="preference-scroll" enhanced show-scrollbar="{{false}}">
      <view class="preference-content onboarding-scroll-content fade-slide-in fade-slide-in--2">
        <view class="preference-card">
          <view class="card-title">想考的地区</view>
          <view class="card-copy">要是最想去的地方没有合适的岗位，岸岸会帮你看看周边、分数差不多的地区。</view>

          <view wx:if="{{catalogLoading}}" class="catalog-state">正在帮你找地区…</view>
          <view wx:elif="{{catalogError}}" class="catalog-error">
            <text>{{catalogError}}</text>
            <button hover-class="item--hover" class="catalog-retry" bindtap="retryCatalog">再试一次</button>
          </view>
          <view wx:else class="region-picker">
            <view wx:if="{{!regionsExpanded}}" class="region-list">
              <button hover-class="item--hover"
                wx:for="{{regionUtil.common(regions, state.draft.preferredRegions[0])}}"
                wx:key="*this"
                class="region-chip {{state.draft.preferredRegions[0] === item ? 'region-chip--selected' : ''}}"
                data-region="{{item}}"
                bindtap="selectRegion"
              >{{item}}</button>
            </view>
            <block wx:if="{{regionsExpanded}}">
              <view wx:for="{{regionUtil.groups(regions)}}" wx:key="name" wx:for-item="group" class="region-group">
                <view class="region-group__title">{{group.name}}</view>
                <view class="region-list">
                  <button hover-class="item--hover"
                    wx:for="{{group.items}}"
                    wx:key="*this"
                    class="region-chip {{state.draft.preferredRegions[0] === item ? 'region-chip--selected' : ''}}"
                    data-region="{{item}}"
                    bindtap="selectRegion"
                  >{{item}}</button>
                </view>
              </view>
            </block>
            <button hover-class="item--hover"
              wx:if="{{regions.length > regionUtil.common(regions, state.draft.preferredRegions[0]).length}}"
              class="region-toggle"
              bindtap="toggleRegionCatalog"
            >{{regionsExpanded ? '收起地区列表' : '全部 ' + regions.length + ' 个地区'}}</button>
          </view>

          <button hover-class="item--hover" class="relocation-row" bindtap="toggleRelocation">
            <view>
              <view class="relocation-title">接受调剂或异地岗位</view>
              <view class="relocation-copy">能多出一大堆岗位可选</view>
            </view>
            <view class="switch {{state.draft.acceptsRelocation ? 'switch--on' : ''}}">
              <view class="switch-dot"></view>
            </view>
          </button>
        </view>

        <view class="preference-card level-card">
          <view class="card-title">能接受哪些岗位层级</view>
          <view class="level-list">
            <button hover-class="item--hover"
              wx:for="{{levels}}"
              wx:key="value"
              class="level-row {{item.selected ? 'level-row--selected' : ''}}"
              data-level="{{item.value}}"
              bindtap="toggleLevel"
            >
              <view class="level-check">✓</view>
              <text>{{item.label}}</text>
            </button>
          </view>
        </view>

        <view wx:if="{{state.pendingRecovery}}" class="recovery-banner">上次的结果还没存稳，这次只帮你查一下，不重复存。</view>
        <view wx:if="{{state.validationError}}" class="error-banner">{{state.validationError}}</view>
        <view wx:if="{{state.error}}" class="error-banner">{{state.error.message}}</view>
        <view wx:if="{{state.error && state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
      </view>
    </scroll-view>

    <view class="preference-dock onboarding-action-dock">
      <button hover-class="item--hover"
        class="control-center preference-primary {{!hasRequiredSelection || catalogLoading || catalogError ? 'preference-primary--disabled' : ''}} tap-tactile"
        loading="{{state.saving}}"
        disabled="{{state.saving || !hasRequiredSelection || catalogLoading || catalogError}}"
        bindtap="submit"
      >{{state.pendingRecovery ? '看看上次的结果' : '继续：定学习时间'}}</button>
      <button
        hover-class="item--hover"
        class="onboarding-save-action"
        loading="{{state.saving}}"
        disabled="{{state.saving}}"
        bindtap="saveAndExit"
      >先存起来，回头再填</button>
    </view>
  </block>
</view>
