<view class="preference-page">
  <safe-top mode="status" gap="48" />
  <view class="preference-nav fade-slide-in">
    <view class="nav-left">
      <button hover-class="item--hover" class="nav-back" aria-label="返回" bindtap="back">
        <image class="nav-back__icon" src="/assets/icons/navigation/chevron-left-ink.svg" mode="aspectFit" />
      </button>
      <view class="nav-title">3/5 岗位偏好</view>
    </view>
    <button hover-class="item--hover" class="nav-save tap-tactile" loading="{{state && state.saving}}" bindtap="saveAndExit">暂存并退出</button>
  </view>

  <view wx:if="{{!state || state.status === 'loading'}}" class="preference-state">
    <state-view state="loading" title="正在读取岗位偏好" description="会恢复首选地区和已经接受的岗位层级。" />
  </view>

  <view wx:elif="{{state.status === 'error'}}" class="preference-state">
    <state-view state="error" title="岗位偏好没有恢复完成" description="{{state.error.message}}" actionText="重新读取" bindaction="retry" />
    <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="preference-scroll" enhanced show-scrollbar="{{false}}">
      <view class="preference-content fade-slide-in fade-slide-in--2">
        <view class="preference-card">
          <view class="card-title">首选工作地区</view>
          <view class="card-copy">如果首选地区未匹配到理想岗位，岸岸将为你寻找周边或相似分数段区域。</view>

          <view wx:if="{{catalogLoading}}" class="catalog-state">正在读取国考岗位地区…</view>
          <view wx:elif="{{catalogError}}" class="catalog-error">
            <text>{{catalogError}}</text>
            <button hover-class="item--hover" class="catalog-retry" bindtap="retryCatalog">重新读取</button>
          </view>
          <scroll-view wx:else scroll-y class="region-scroll" enhanced show-scrollbar="{{false}}">
            <view class="region-list">
              <button hover-class="item--hover"
                wx:for="{{regions}}"
                wx:key="*this"
                class="region-chip {{state.draft.preferredRegions[0] === item ? 'region-chip--selected' : ''}}"
                data-region="{{item}}"
                bindtap="selectRegion"
              >{{item}}</button>
            </view>
          </scroll-view>

          <button hover-class="item--hover" class="relocation-row" bindtap="toggleRelocation">
            <view>
              <view class="relocation-title">接受调剂或异地岗位</view>
              <view class="relocation-copy">大幅增加符合条件的岗位基数</view>
            </view>
            <view class="switch {{state.draft.acceptsRelocation ? 'switch--on' : ''}}">
              <view class="switch-dot"></view>
            </view>
          </button>
        </view>

        <view class="preference-card level-card">
          <view class="card-title">岗位层级接受度</view>
          <view class="level-list">
            <button hover-class="item--hover"
              wx:for="{{levels}}"
              wx:key="value"
              class="level-row {{item.selected ? 'level-row--selected' : ''}}"
              data-level="{{item.value}}"
              bindtap="toggleLevel"
            >
              <view class="level-check">✓</view>
              <text>{{item.label}}</text>
            </button>
          </view>
        </view>

        <view wx:if="{{state.pendingRecovery}}" class="recovery-banner">上一次保存结果还不确定，本次只会查询原结果。</view>
        <view wx:if="{{state.validationError}}" class="error-banner">{{state.validationError}}</view>
        <view wx:if="{{state.error}}" class="error-banner">{{state.error.message}}</view>
        <view wx:if="{{state.error && state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
      </view>
    </scroll-view>

    <view class="preference-dock">
      <button hover-class="item--hover"
        class="preference-primary {{!hasRequiredSelection || catalogLoading || catalogError ? 'preference-primary--disabled' : ''}} tap-tactile"
        loading="{{state.saving}}"
        disabled="{{state.saving || !hasRequiredSelection || catalogLoading || catalogError}}"
        bindtap="submit"
      >{{state.pendingRecovery ? '查询原保存结果' : '继续：填写学习时间'}}</button>
    </view>
  </block>
</view>
