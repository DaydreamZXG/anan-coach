<view class="identity-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="1/5 先认识一下你"
    back-behavior="emit"
    bind:back="back"
  />

  <view wx:if="{{!state || state.status === 'loading' || accountLoading}}" class="identity-state">
    <state-view state="loading" title="正在找回你的资料" description="别急，昵称和上次填的备考情况都还在。" />
  </view>

  <view wx:elif="{{state.status === 'error'}}" class="identity-state">
    <state-view state="error" title="哎，没找回来" description="{{state.error.message}}" actionText="再试一次" bindaction="retry" />
    <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="identity-scroll" enhanced show-scrollbar="{{false}}">
      <view class="identity-content onboarding-scroll-content fade-slide-in fade-slide-in--2">
        <view class="identity-heading">先聊聊你的情况</view>
        <view class="identity-intro">咱们就专心国考这一件事。考过没考过，节奏不一样，岸岸会按你的情况来。</view>

        <view class="profile-field">
          <view class="profile-avatar profile-avatar--{{avatarStyle}}">{{avatarInitial}}</view>
          <view class="profile-control">
            <view class="profile-label">微信昵称</view>
            <input
              class="profile-input"
              value="{{displayName}}"
              maxlength="24"
              bindinput="inputDisplayName"
            />
          </view>
        </view>

        <view class="field-title">你的备考经验</view>
        <view class="exam-grid">
          <button hover-class="item--hover"
            class="exam-card {{state.draft.firstSystematic ? 'exam-card--selected' : ''}}"
            data-mode="first"
            bindtap="selectExamMode"
          >
            <view class="exam-card__head">
              <text>首次备考</text>
              <view wx:if="{{state.draft.firstSystematic}}" class="selected-check">✓</view>
            </view>
            <view class="exam-card__copy">从零开始，把基础打牢</view>
          </button>
          <button hover-class="item--hover"
            class="exam-card {{state.draft.retake ? 'exam-card--selected' : ''}}"
            data-mode="retake"
            bindtap="selectExamMode"
          >
            <view class="exam-card__head">
              <text>二战/多战</text>
              <view wx:if="{{state.draft.retake}}" class="selected-check">✓</view>
            </view>
            <view class="exam-card__copy">主要补之前的弱项</view>
          </button>
        </view>

        <view class="field-title field-title--status">你现在是啥状态</view>
        <view class="status-list">
          <button hover-class="item--hover"
            class="status-card {{state.draft.currentStatus === 'parttime' ? 'status-card--selected' : ''}}"
            data-status="parttime"
            bindtap="selectCurrentStatus"
          >
            <view><view class="status-name">在职备考</view><view class="status-copy">时间比较碎，咱们就抓效率</view></view>
            <view class="radio-ring"><view wx:if="{{state.draft.currentStatus === 'parttime'}}" class="radio-dot"></view></view>
          </button>
          <button hover-class="item--hover"
            class="status-card {{state.draft.currentStatus === 'fulltime' ? 'status-card--selected' : ''}}"
            data-status="fulltime"
            bindtap="selectCurrentStatus"
          >
            <view><view class="status-name">全职备考</view><view class="status-copy">时间多，正好把基础打扎实</view></view>
            <view class="radio-ring"><view wx:if="{{state.draft.currentStatus === 'fulltime'}}" class="radio-dot"></view></view>
          </button>
          <button hover-class="item--hover"
            class="status-card {{state.draft.currentStatus === 'student' ? 'status-card--selected' : ''}}"
            data-status="student"
            bindtap="selectCurrentStatus"
          >
            <view><view class="status-name">在校生</view><view class="status-copy">还得忙学业，灵活着来</view></view>
            <view class="radio-ring"><view wx:if="{{state.draft.currentStatus === 'student'}}" class="radio-dot"></view></view>
          </button>
        </view>

        <view wx:if="{{profileError}}" class="error-banner">{{profileError}}</view>
        <view wx:if="{{state.validationError}}" class="error-banner">{{state.validationError}}</view>
        <view wx:if="{{state.error}}" class="error-banner">
          <view>{{state.error.message}}</view>
          <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="identity-dock onboarding-action-dock">
      <button hover-class="item--hover"
        class="control-center identity-primary {{!state.draft.currentStatus || (!state.draft.firstSystematic && !state.draft.retake) ? 'identity-primary--disabled' : ''}} tap-tactile"
        loading="{{state.saving || profileSaving}}"
        disabled="{{state.saving || profileSaving}}"
        bindtap="submit"
      >
        继续：报考资格
      </button>
      <button
        hover-class="item--hover"
        class="onboarding-save-action"
        loading="{{state.saving || profileSaving}}"
        disabled="{{state.saving || profileSaving}}"
        bindtap="saveAndExit"
      >先存起来，回头再填</button>
    </view>
  </block>
</view>
