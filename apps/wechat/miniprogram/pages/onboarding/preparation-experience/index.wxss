@import "../../../features/onboarding/page-shell.wxss";

.identity-page {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.identity-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.identity-scroll {
  min-height: 0;
  flex: 1;
}

.identity-content {
  box-sizing: border-box;
  padding: 48rpx 48rpx 220rpx;
}

.identity-heading {
  font-size: var(--text-title-lg);
  font-weight: 700;
  letter-spacing: -1.2rpx;
  line-height: 1.4;
}

.identity-intro {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.625;
}

.profile-field {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 64rpx;
  padding: 32rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.profile-avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--color-surface);
  border-radius: 50%;
  color: var(--color-surface);
  box-shadow: var(--shadow-crisp);
  font-size: var(--text-title);
  font-weight: 800;
}

.profile-avatar--ocean {
  background: linear-gradient(145deg, var(--primary), var(--figma-color-cyan-deep));
}

.profile-avatar--aurora {
  background: linear-gradient(145deg, var(--good), var(--color-ai-violet));
}

.profile-avatar--sunrise {
  background: linear-gradient(145deg, var(--figma-color-warning), var(--color-ai-pink));
}

.profile-avatar--violet {
  background: linear-gradient(145deg, var(--color-ai-violet), var(--primary));
}

.profile-avatar--graphite {
  background: linear-gradient(145deg, var(--ink-2), var(--ink));
}

.profile-avatar--mint {
  background: linear-gradient(145deg, var(--figma-color-cyan), var(--figma-color-cyan-dark));
}

.profile-control {
  min-width: 0;
  flex: 1;
}

.profile-label {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 36rpx;
}

.profile-input {
  box-sizing: border-box;
  width: 100%;
  height: 62rpx;
  border-bottom: 1rpx solid var(--color-line-strong);
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 56rpx;
}

.field-title {
  margin: 64rpx 0 24rpx 8rpx;
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}

.field-title--status {
  margin-top: 64rpx;
}

.exam-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.exam-card,
.status-card {
  box-sizing: border-box;
  margin: 0;
  text-align: left;
}

.exam-card::after,
.status-card::after {
  border: 0;
}

.exam-card {
  min-height: 165rpx;
  padding: 32rpx;
  border: 3rpx solid transparent;
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.exam-card--selected {
  border-color: var(--ink);
  box-shadow: var(--shadow-elevated);
}

.exam-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}

.selected-check {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
}

.exam-card__copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 36rpx;
}

.status-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-card {
  display: flex;
  min-height: 138rpx;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border: 3rpx solid transparent;
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.status-card--selected {
  border-color: var(--ink);
  box-shadow: var(--shadow-elevated);
}

.status-name {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}

.status-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 36rpx;
}

.radio-ring {
  box-sizing: border-box;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--figma-color-line-emphasis);
  border-radius: 50%;
}

.status-card--selected .radio-ring {
  border-color: var(--ink);
}

.radio-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--ink);
}

.identity-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(42rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26rpx);
}

.identity-primary {
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.5;
}

.identity-primary::after {
  border: 0;
}

.identity-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.exam-card,
button.status-card,
button.identity-primary {
  width: 100%;
}

.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.request-id {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

@media (min-width: 768px) {
  .identity-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .identity-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
