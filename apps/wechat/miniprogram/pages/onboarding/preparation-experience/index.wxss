.experience-page { display: flex; flex-direction: column; }
.page-state { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center; }
.state-title { margin-top: 26rpx; font-size: 34rpx; font-weight: 850; }
.state-copy { max-width: 560rpx; margin: 14rpx 0 30rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.65; }
.request-id { margin-top: 10rpx; color: var(--color-faint); font-family: var(--font-family-data); font-size: 18rpx; }
.recovery-banner { margin-top: 24rpx; padding: 20rpx 22rpx; border: 1rpx solid rgba(239,166,68,.26); border-radius: 22rpx; background: var(--color-warning-soft); color: var(--color-ink-secondary); font-size: 20rpx; line-height: 1.55; }
.choice-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.choice-card { display: flex; align-items: center; gap: 20rpx; padding: 25rpx 24rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: var(--color-surface); box-shadow: 0 10rpx 30rpx rgba(32,50,70,.05); }
.choice-card--selected { border-color: var(--color-primary); background: linear-gradient(135deg,#fff 0%,var(--color-primary-soft) 100%); box-shadow: 0 16rpx 38rpx var(--color-primary-a16); }
.choice-card--retake { margin-top: 4rpx; }
.choice-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 20rpx; background: var(--color-surface-soft); color: var(--color-muted); font-family: var(--font-family-data); font-size: 19rpx; font-weight: 850; }
.choice-card--selected .choice-icon { background: var(--color-primary); color: #fff; }
.choice-body { flex: 1; min-width: 0; }
.choice-title { color: var(--color-ink); font-size: 26rpx; font-weight: 850; }
.choice-copy { margin-top: 7rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; }
.choice-check { display: flex; flex: none; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border: 1rpx solid var(--color-line-strong); border-radius: 50%; color: #fff; font-size: 23rpx; font-weight: 900; }
.choice-card--selected .choice-check { border-color: var(--color-primary); background: var(--color-primary); }
.boundary-note { margin: 20rpx 0 28rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: var(--color-surface-soft); color: var(--color-muted); font-size: 19rpx; line-height: 1.6; }
.error-banner { margin: 0 0 18rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 21rpx; line-height: 1.55; }
