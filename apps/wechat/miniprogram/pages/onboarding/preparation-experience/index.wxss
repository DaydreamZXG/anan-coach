@import "../../../features/onboarding/page-shell.wxss";

.identity-page {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.identity-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.identity-scroll {
  min-height: 0;
  flex: 1;
}

.identity-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(48 * var(--rpx)) calc(220 * var(--rpx));
}

.identity-heading {
  font-size: var(--text-title-lg);
  font-weight: 700;
  letter-spacing: calc(-1.2 * var(--rpx));
  line-height: 1.4;
}

.identity-intro {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.625;
}

.profile-field {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: calc(32 * var(--rpx));
  margin-top: calc(64 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.profile-avatar {
  display: flex;
  width: calc(112 * var(--rpx));
  height: calc(112 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border: calc(4 * var(--rpx)) solid var(--color-surface);
  border-radius: 50%;
  color: var(--color-surface);
  box-shadow: var(--shadow-crisp);
  font-size: var(--text-title);
  font-weight: 800;
}

.profile-avatar--ocean {
  background: linear-gradient(145deg, var(--primary), var(--figma-color-cyan-deep));
}

.profile-avatar--aurora {
  background: linear-gradient(145deg, var(--good), var(--color-ai-violet));
}

.profile-avatar--sunrise {
  background: linear-gradient(145deg, var(--figma-color-warning), var(--color-ai-pink));
}

.profile-avatar--violet {
  background: linear-gradient(145deg, var(--color-ai-violet), var(--primary));
}

.profile-avatar--graphite {
  background: linear-gradient(145deg, var(--ink-2), var(--ink));
}

.profile-avatar--mint {
  background: linear-gradient(145deg, var(--figma-color-cyan), var(--figma-color-cyan-dark));
}

.profile-control {
  min-width: 0;
  flex: 1;
}

.profile-label {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.profile-input {
  box-sizing: border-box;
  width: 100%;
  height: calc(62 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--color-line-strong);
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(56 * var(--rpx));
}

.field-title {
  margin: calc(64 * var(--rpx)) 0 calc(24 * var(--rpx)) calc(8 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.field-title--status {
  margin-top: calc(64 * var(--rpx));
}

.exam-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(24 * var(--rpx));
}

.exam-card,
.status-card {
  box-sizing: border-box;
  margin: 0;
  text-align: left;
}

.exam-card::after,
.status-card::after {
  border: 0;
}

.exam-card {
  min-height: calc(165 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(3 * var(--rpx)) solid transparent;
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.exam-card--selected {
  border-color: var(--ink);
  box-shadow: var(--shadow-elevated);
}

.exam-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.selected-check {
  display: flex;
  width: calc(34 * var(--rpx));
  height: calc(34 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
}

.exam-card__copy {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: calc(36 * var(--rpx));
}

.status-list {
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
}

.status-card {
  display: flex;
  min-height: calc(138 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  padding: calc(32 * var(--rpx));
  border: calc(3 * var(--rpx)) solid transparent;
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-crisp);
}

.status-card--selected {
  border-color: var(--ink);
  box-shadow: var(--shadow-elevated);
}

.status-name {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.status-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: calc(36 * var(--rpx));
}

.radio-ring {
  box-sizing: border-box;
  display: flex;
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border: calc(2 * var(--rpx)) solid var(--figma-color-line-emphasis);
  border-radius: 50%;
}

.status-card--selected .radio-ring {
  border-color: var(--ink);
}

.radio-dot {
  width: calc(20 * var(--rpx));
  height: calc(20 * var(--rpx));
  border-radius: 50%;
  background: var(--ink);
}

.identity-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(42 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(calc(26 * var(--rpx)));
}

.identity-primary {
  width: 100%;
  min-height: calc(112 * var(--rpx));
  margin: 0;
  padding: 0 calc(32 * var(--rpx));
  border: 0;
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.5;
}

.identity-primary::after {
  border: 0;
}

.identity-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.exam-card,
button.status-card,
button.identity-primary {
  width: 100%;
}

.error-banner {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.request-id {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

@media (min-width: 600px) {
  .identity-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .identity-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
