<view class="time-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="4/5 学习时间"
    back-behavior="emit"
    bind:back="back"
  />

  <view wx:if="{{!state || state.status === 'loading'}}" class="time-state">
    <state-view state="loading" title="正在找回学习安排" description="别急，你工作日和周末的安排都记得。" />
  </view>

  <view wx:elif="{{state.status === 'error'}}" class="time-state">
    <state-view state="error" title="哎，没找回来" description="{{state.error.message}}" actionText="再试一次" bindaction="retry" />
    <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="time-scroll" enhanced show-scrollbar="{{false}}">
      <view class="time-content onboarding-scroll-content fade-slide-in fade-slide-in--2">
        <view class="time-card">
          <view class="time-intro">排得下才坚持得久，别一上来就定太高。每天最少 0.5 小时、最多 12 小时，岸岸照这个帮你安排每天的任务。</view>

          <view class="time-section">
            <view class="time-section__head">
              <view class="time-label">工作日（周一到周五）每天能学</view>
              <view class="time-value">{{weekdayHoursLabel}} <text class="time-unit">小时</text></view>
            </view>
            <view class="time-control">
              <button hover-class="item--hover" class="time-step" data-field="weekdayMinutes" data-delta="-30" bindtap="adjustMinutes">−</button>
              <slider class="time-slider" min="30" max="720" step="30" value="{{state.draft.weekdayMinutes}}" block-size="18" block-color="#00b8db" activeColor="#00b8db" backgroundColor="#e5e7eb" data-field="weekdayMinutes" bindchange="changeMinutes" />
              <button hover-class="item--hover" class="time-step time-step--plus" data-field="weekdayMinutes" data-delta="30" bindtap="adjustMinutes">＋</button>
            </view>
          </view>

          <view class="time-divider"></view>

          <view class="time-section">
            <view class="time-section__head">
              <view class="time-label">周末和节假日 每天能学</view>
              <view class="time-value">{{weekendHoursLabel}} <text class="time-unit">小时</text></view>
            </view>
            <view class="time-control">
              <button hover-class="item--hover" class="time-step" data-field="weekendMinutes" data-delta="-30" bindtap="adjustMinutes">−</button>
              <slider class="time-slider" min="30" max="720" step="30" value="{{state.draft.weekendMinutes}}" block-size="18" block-color="#00b8db" activeColor="#00b8db" backgroundColor="#e5e7eb" data-field="weekendMinutes" bindchange="changeMinutes" />
              <button hover-class="item--hover" class="time-step time-step--plus" data-field="weekendMinutes" data-delta="30" bindtap="adjustMinutes">＋</button>
            </view>
          </view>

          <view class="time-presets">
            <button hover-class="item--hover" class="control-center time-preset" data-weekday="120" data-weekend="360" bindtap="applyPreset">标准在职 (2h/6h)</button>
            <button hover-class="item--hover" class="control-center time-preset" data-weekday="480" data-weekend="480" bindtap="applyPreset">全职备考 (8h/8h)</button>
          </view>
        </view>

        <view wx:if="{{state.pendingRecovery}}" class="recovery-banner">上次的结果还没存稳，这次只帮你查一下，不重复存。</view>
        <view wx:if="{{state.validationError}}" class="error-banner">{{state.validationError}}</view>
        <view wx:if="{{state.error}}" class="error-banner">{{state.error.message}}</view>
        <view wx:if="{{state.error && state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
      </view>
    </scroll-view>

    <view class="time-dock onboarding-action-dock">
      <button hover-class="item--hover" class="time-primary {{state.saving ? 'time-primary--disabled' : ''}} tap-tactile" loading="{{state.saving}}" disabled="{{state.saving}}" bindtap="submit">{{state.pendingRecovery ? '看看上次的结果' : '继续：现在的水平'}}</button>
      <button
        hover-class="item--hover"
        class="onboarding-save-action"
        loading="{{state.saving}}"
        disabled="{{state.saving}}"
        bindtap="saveAndExit"
      >先存起来，回头再填</button>
    </view>
  </block>
</view>
