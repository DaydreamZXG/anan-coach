.time-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.time-nav {
  box-sizing: border-box;
  display: flex;
  height: 112rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.8);
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-back,
.nav-save,
.time-step,
.time-preset,
.time-primary {
  margin: 0;
  border: 0;
}

.nav-back::after,
.nav-save::after,
.time-step::after,
.time-preset::after,
.time-primary::after {
  border: 0;
}

.nav-back {
  display: flex;
  width: 64rpx;
  height: 80rpx;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
}

.nav-back__icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
}

.nav-save {
  padding: 12rpx 24rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 39rpx;
}

.time-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.time-scroll {
  min-height: 0;
  flex: 1;
}

.time-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.time-card {
  box-sizing: border-box;
  padding: 48rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.time-intro {
  margin-bottom: 48rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.625;
}

.time-section__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.time-label {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.time-value {
  flex: none;
  color: var(--primary);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.time-unit {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 500;
}

.time-control {
  box-sizing: border-box;
  display: flex;
  height: 128rpx;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--bg);
}

.time-step {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: 32rpx;
  line-height: 64rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.time-step--plus {
  color: var(--ink);
}

.time-slider {
  min-width: 0;
  flex: 1;
  margin: 0;
}

.time-divider {
  height: 1rpx;
  margin: 48rpx 0;
  background: var(--color-surface-soft);
}

.time-presets {
  display: flex;
  gap: 16rpx;
  margin-top: 48rpx;
}

.time-preset {
  box-sizing: border-box;
  flex: 1;
  padding: 16rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--figma-color-ink-tertiary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--primary-deep);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 14rpx;
  color: var(--ink-3);
  font-family: monospace;
  font-size: 20rpx;
  text-align: center;
}

.time-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 34rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.time-primary {
  width: 100%;
  padding: 32rpx 24rpx;
  border-radius: 48rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.12);
}

.time-primary--disabled {
  opacity: 0.58;
}
