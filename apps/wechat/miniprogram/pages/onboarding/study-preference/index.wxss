.preference-page { display: flex; flex-direction: column; }
.topbar { display: flex; align-items: center; justify-content: space-between; }
.brand-lockup { display: flex; align-items: center; gap: 16rpx; }
.privacy-note { margin-top: 4rpx; color: var(--color-muted); font-size: 20rpx; }
.step-number { color: var(--color-primary-deep); font-family: var(--font-family-data); font-size: 22rpx; font-weight: 800; }
.progress-track { height: 8rpx; margin-top: 28rpx; overflow: hidden; border-radius: 99rpx; background: rgba(82,104,255,.1); }
.progress-value { width: 84%; height: 100%; border-radius: inherit; background: linear-gradient(90deg,var(--color-cyan),var(--color-primary)); }
.intro { margin-top: 44rpx; }
.page-state { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: 70vh; text-align: center; }
.state-title { margin-top: 26rpx; font-size: 34rpx; font-weight: 850; }
.state-copy { max-width: 560rpx; margin: 14rpx 0 30rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.65; }
.request-id { margin-top: 10rpx; color: var(--color-faint); font-family: var(--font-family-data); font-size: 18rpx; }
.recovery-banner { display: flex; gap: 18rpx; margin-top: 26rpx; padding: 22rpx; border: 1rpx solid rgba(239,166,68,.26); border-radius: 24rpx; background: var(--color-warning-soft); }
.recovery-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 14rpx; background: var(--color-warning); color: #fff; font-weight: 900; }
.recovery-title { color: var(--color-ink-secondary); font-size: 23rpx; font-weight: 800; }
.recovery-copy { margin-top: 5rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; }
.budget-card,.schedule-card { margin-top: 26rpx; }
.budget-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.budget-divider,.schedule-divider { height: 1rpx; margin: 26rpx 0; background: var(--color-line); }
.field-label { color: var(--color-ink-secondary); font-size: 24rpx; font-weight: 800; }
.field-copy { margin-top: 6rpx; color: var(--color-muted); font-size: 19rpx; }
.stepper { display: flex; align-items: center; gap: 8rpx; padding: 7rpx; border: 1rpx solid var(--color-line); border-radius: 22rpx; background: var(--color-surface-soft); }
.stepper-button { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 16rpx; background: #fff; color: var(--color-primary); font-size: 30rpx; font-weight: 800; }
.stepper-value { min-width: 124rpx; color: var(--color-ink); font-size: 28rpx; font-weight: 850; text-align: center; }
.stepper-value__unit { color: var(--color-muted); font-family: var(--font-family-reading); font-size: 18rpx; font-weight: 600; }
.schedule-head { display: flex; align-items: center; justify-content: space-between; }
.schedule-tag { padding: 8rpx 14rpx; border-radius: 14rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 19rpx; font-weight: 800; }
.schedule-tag--rest { background: var(--color-success-soft); color: var(--color-success); }
.weekday-row { display: grid; grid-template-columns: repeat(7,1fr); gap: 9rpx; margin-top: 20rpx; }
.weekday-chip { display: flex; align-items: center; justify-content: center; height: 60rpx; border: 1rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-surface-soft); color: var(--color-muted); font-size: 22rpx; }
.weekday-chip--mock { border-color: transparent; background: var(--color-primary); color: #fff; font-weight: 800; box-shadow: var(--shadow-primary); }
.weekday-chip--rest { border-color: rgba(45,166,153,.4); background: var(--color-success-soft); color: var(--color-success); font-weight: 800; }
.rhythm-strip { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; margin-top: 26rpx; }
.rhythm-item { padding: 22rpx 10rpx; border-radius: 24rpx; background: linear-gradient(145deg,#fff,#e7f7f3); text-align: center; }
.rhythm-item__value { display: block; color: var(--color-primary-deep); font-size: 34rpx; }
.rhythm-item__label { display: block; margin-top: 5rpx; color: var(--color-muted); font-size: 18rpx; }
.weekly-total { margin: 18rpx 0 28rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: var(--color-primary-soft); color: var(--color-ink-secondary); font-size: 21rpx; line-height: 1.65; }
.weekly-total__value { color: var(--color-primary-deep); font-weight: 850; }
.error-banner { margin: 0 0 18rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 21rpx; line-height: 1.55; }
