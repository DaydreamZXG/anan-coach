@import "../../../features/onboarding/page-shell.wxss";

.time-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.time-step,
.time-preset,
.time-primary {
  margin: 0;
  border: 0;
}

.time-step::after,
.time-preset::after,
.time-primary::after {
  border: 0;
}

.time-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.time-scroll {
  min-height: 0;
  flex: 1;
}

.time-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(260 * var(--rpx));
}

.time-card {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.time-intro {
  margin-bottom: calc(48 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.625;
}

.time-section__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  margin-bottom: calc(32 * var(--rpx));
}

.time-label {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.time-value {
  flex: none;
  color: var(--color-ink);
  font-size: var(--text-title);
  font-weight: 700;
  line-height: calc(40 * var(--rpx));
}

.time-unit {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 500;
}

.time-control {
  box-sizing: border-box;
  display: flex;
  height: calc(128 * var(--rpx));
  align-items: center;
  gap: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--bg);
}

.time-step {
  display: flex;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-section);
  line-height: calc(64 * var(--rpx));
  box-shadow: var(--shadow-crisp);
}

.time-step--plus {
  color: var(--ink);
}

.time-slider {
  min-width: 0;
  flex: 1;
  margin: 0;
}

.time-divider {
  height: calc(1 * var(--rpx));
  margin: calc(48 * var(--rpx)) 0;
  background: var(--color-surface-soft);
}

.time-presets {
  display: flex;
  gap: calc(16 * var(--rpx));
  margin-top: calc(48 * var(--rpx));
}

.time-preset {
  box-sizing: border-box;
  flex: 1;
  padding: calc(16 * var(--rpx)) calc(8 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.recovery-banner,
.error-banner {
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  text-align: center;
}

.time-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: calc(34 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(40 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(calc(26 * var(--rpx)));
}

.time-primary {
  width: 100%;
  padding: calc(32 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(48 * var(--rpx));
  box-shadow: var(--shadow-elevated);
}

.time-primary--disabled {
  opacity: 0.58;
}

button.time-step {
  width: calc(64 * var(--rpx));
}

button.time-preset {
  width: auto;
}

button.time-primary {
  width: 100%;
}
