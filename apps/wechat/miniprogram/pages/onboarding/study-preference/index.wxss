@import "../../../features/onboarding/page-shell.wxss";

.time-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.time-step,
.time-preset,
.time-primary {
  margin: 0;
  border: 0;
}

.time-step::after,
.time-preset::after,
.time-primary::after {
  border: 0;
}

.time-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.time-scroll {
  min-height: 0;
  flex: 1;
}

.time-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.time-card {
  box-sizing: border-box;
  padding: 48rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.time-intro {
  margin-bottom: 48rpx;
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.625;
}

.time-section__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.time-label {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}

.time-value {
  flex: none;
  color: var(--color-ink);
  font-size: var(--text-title);
  font-weight: 700;
  line-height: 40rpx;
}

.time-unit {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 500;
}

.time-control {
  box-sizing: border-box;
  display: flex;
  height: 128rpx;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--bg);
}

.time-step {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 50%;
  background: var(--color-surface);
  color: var(--ink-2);
  font-size: var(--text-section);
  line-height: 64rpx;
  box-shadow: var(--shadow-crisp);
}

.time-step--plus {
  color: var(--ink);
}

.time-slider {
  min-width: 0;
  flex: 1;
  margin: 0;
}

.time-divider {
  height: 1rpx;
  margin: 48rpx 0;
  background: var(--color-surface-soft);
}

.time-presets {
  display: flex;
  gap: 16rpx;
  margin-top: 48rpx;
}

.time-preset {
  box-sizing: border-box;
  flex: 1;
  padding: 16rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 36rpx;
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  text-align: center;
}

.time-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 34rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26rpx);
}

.time-primary {
  width: 100%;
  padding: 32rpx 24rpx;
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 48rpx;
  box-shadow: var(--shadow-elevated);
}

.time-primary--disabled {
  opacity: 0.58;
}

button.time-step {
  width: 64rpx;
}

button.time-preset {
  width: auto;
}

button.time-primary {
  width: 100%;
}
