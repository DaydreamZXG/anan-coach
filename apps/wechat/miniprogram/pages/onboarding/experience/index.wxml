<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="step-text">第 1 步 / 共 6 步</view>
    <view class="step-bar">
      <view wx:for="{{steps}}" wx:key="*this" class="step-seg {{item <= step ? 'is-active' : ''}}"></view>
    </view>
    <view class="nav__title">备考经历</view>
    <view class="nav__sub">如实选就好，这些只影响岸岸怎么给你排节奏</view>
  </view>

  <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="card field">
    <view class="field__label">{{group.label}}</view>
    <view class="options">
      <view
        wx:for="{{group.options}}"
        wx:key="label"
        wx:for-item="opt"
        class="option {{values[group.key] === opt.value ? 'is-active' : ''}}"
        data-key="{{group.key}}"
        data-value="{{opt.value}}"
        hover-class="is-pressed"
        bind:tap="onPick"
      >
        {{opt.label}}
      </view>
    </view>
  </view>

  <view class="footer">
    <ui-button variant="primary" block disabled="{{!canSubmit}}" loading="{{submitting}}" bind:tap="onSubmit">
      下一步
    </ui-button>
  </view>
</view>
