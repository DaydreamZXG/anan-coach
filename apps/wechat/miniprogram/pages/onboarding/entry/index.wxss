.entry-page {
  display: flex;
  flex-direction: column;
}

.entry-content {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  max-width: calc(750 * var(--rpx));
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  padding: calc(64 * var(--rpx));
  text-align: center;
}

.entry-mark {
  position: relative;
  display: flex;
  width: calc(160 * var(--rpx));
  height: calc(160 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin-bottom: calc(64 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.entry-mark__icon {
  width: calc(72 * var(--rpx));
  height: calc(72 * var(--rpx));
}

.entry-title {
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1.4 * var(--rpx));
  line-height: 1.4;
}

.entry-copy {
  max-width: calc(652 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-section);
  font-weight: 500;
  line-height: 1.625;
}

.entry-actions {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: calc(32 * var(--rpx));
  margin-top: calc(96 * var(--rpx));
}

.entry-action {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: calc(112 * var(--rpx));
  align-items: center;
  justify-content: center;
  gap: calc(16 * var(--rpx));
  margin: 0;
  padding: 0 calc(32 * var(--rpx));
  border-radius: var(--radius-48);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.5;
}

.entry-action::after {
  border: 0;
}

.entry-action--primary {
  border: 0;
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.entry-action--secondary {
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--ink);
}

.entry-action__icon {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

button.entry-action {
  width: 100%;
}

@media (min-width: 768px) {
  .entry-content {
    max-width: 560px;
    padding: 32px 48px;
  }
}
