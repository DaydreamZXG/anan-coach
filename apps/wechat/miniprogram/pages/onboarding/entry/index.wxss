.entry-page {
  display: flex;
  flex-direction: column;
}

.entry-content {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  max-width: 750rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  padding: 64rpx;
  text-align: center;
}

.entry-mark {
  position: relative;
  display: flex;
  width: 160rpx;
  height: 160rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 64rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.entry-mark__icon {
  width: 72rpx;
  height: 72rpx;
}

.entry-title {
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: -1.4rpx;
  line-height: 1.4;
}

.entry-copy {
  max-width: 652rpx;
  margin-top: 24rpx;
  color: var(--ink-2);
  font-size: var(--text-section);
  font-weight: 500;
  line-height: 1.625;
}

.entry-actions {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 96rpx;
}

.entry-action {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 0;
  padding: 0 32rpx;
  border-radius: var(--radius-48);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.5;
}

.entry-action::after {
  border: 0;
}

.entry-action--primary {
  border: 0;
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.entry-action--secondary {
  border: 1rpx solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--ink);
}

.entry-action__icon {
  width: 36rpx;
  height: 36rpx;
}

button.entry-action {
  width: 100%;
}

@media (min-width: 768px) {
  .entry-content {
    max-width: 560px;
    padding: 32px 48px;
  }
}
