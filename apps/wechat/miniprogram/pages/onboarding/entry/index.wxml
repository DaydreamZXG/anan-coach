<view class="entry-page">
  <safe-top mode="status" gap="16" />
  <button hover-class="item--hover" class="back-button fade-slide-in" aria-label="返回" bindtap="back">
    <image class="back-icon" src="/assets/icons/navigation/chevron-left-ink.svg" mode="aspectFit" />
  </button>

  <view class="entry-content">
    <view class="entry-mark fade-slide-in" aria-hidden="true">
      <image class="entry-mark__icon" src="/assets/icons/onboarding/profile-spark.svg" mode="aspectFit" />
    </view>
    <view class="entry-title fade-slide-in fade-slide-in--2">建立备考档案</view>
    <view class="entry-copy fade-slide-in fade-slide-in--2">岸岸需要了解你的背景和目标，以提供准确的岗位推荐与定制化计划。</view>

    <view class="entry-actions fade-slide-in fade-slide-in--3">
      <button hover-class="item--hover" class="entry-action entry-action--primary tap-tactile" bindtap="startProfile">
        <text>我是新用户，开始建档</text>
        <image class="entry-action__icon" src="/assets/icons/anan/arrow-right-white.svg" mode="aspectFit" />
      </button>
      <button hover-class="item--hover" class="entry-action entry-action--secondary" bindtap="openArchive">
        <text>我是老用户，修改档案</text>
        <image class="entry-action__icon" src="/assets/icons/onboarding/edit-ink.svg" mode="aspectFit" />
      </button>
    </view>
  </view>
</view>
