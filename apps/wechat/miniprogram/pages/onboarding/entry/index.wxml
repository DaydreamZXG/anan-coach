<view class="entry-page">
  <safe-top gap="{{0}}" />
  <button class="back-button" aria-label="返回" bindtap="back">
    <view class="back-icon"></view>
  </button>

  <view class="entry-content">
    <view class="entry-mark" aria-hidden="true">
      <view class="spark spark--one"></view>
      <view class="spark spark--two"></view>
      <view class="spark spark--three"></view>
    </view>
    <view class="entry-title">建立备考档案</view>
    <view class="entry-copy">岸岸需要了解你的背景和目标，以提供准确的岗位推荐与定制化计划。</view>

    <view class="entry-actions">
      <button class="entry-action entry-action--primary" bindtap="startProfile">
        <text>我是新用户，开始建档</text>
        <view class="arrow-icon"></view>
      </button>
      <button class="entry-action entry-action--secondary" bindtap="openArchive">
        <text>我是老用户，修改档案</text>
        <view class="edit-icon"></view>
      </button>
    </view>
  </view>
</view>
