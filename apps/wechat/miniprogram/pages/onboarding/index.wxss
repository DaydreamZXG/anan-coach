@import "../../features/onboarding/page-shell.wxss";

.eligibility-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.major-result,
.catalog-retry,
.service-option,
.project-chip,
.work-option,
.mark-later,
.eligibility-primary {
  margin: 0;
  border: 0;
}

.major-result::after,
.catalog-retry::after,
.service-option::after,
.project-chip::after,
.work-option::after,
.mark-later::after,
.eligibility-primary::after {
  border: 0;
}

.eligibility-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.eligibility-scroll {
  min-height: 0;
  flex: 1;
}

.eligibility-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(280 * var(--rpx));
}

.boundary-notice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(255, 237, 212, 0.5);
  border-radius: var(--radius-40);
  background: rgba(255, 247, 237, 0.5);
}

.notice-icon {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
  flex: none;
}

.notice-copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.625;
}

.form-card {
  box-sizing: border-box;
  margin-top: calc(64 * var(--rpx));
  padding: calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.experience-card {
  margin-top: calc(48 * var(--rpx));
}

.card-title {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.3 * var(--rpx));
  line-height: calc(42 * var(--rpx));
}

.card-copy {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.625;
}

.major-field {
  box-sizing: border-box;
  display: flex;
  height: calc(96 * var(--rpx));
  align-items: center;
  gap: calc(20 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
}

.major-field--selected {
  border-color: var(--color-primary-soft-strong);
  background: var(--color-surface);
}

.search-icon {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
  flex: none;
}

.major-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: var(--ink);
  font-size: var(--text-body-lg);
}

.catalog-status,
.major-selected-meta {
  margin-top: calc(16 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.5;
}

.catalog-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.catalog-retry {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.4;
}

.major-results {
  overflow: hidden;
  margin-top: calc(12 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.major-result {
  box-sizing: border-box;
  width: 100%;
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: 0;
  background: var(--color-surface);
  text-align: left;
}

.major-result:last-child {
  border-bottom: 0;
}

.major-result__title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.45;
}

.major-result__code {
  margin-left: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.major-result__category {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.4;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(24 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.picker-label {
  margin-left: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(36 * var(--rpx));
}

.picker-control {
  box-sizing: border-box;
  display: flex;
  height: calc(96 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  gap: calc(12 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 600;
}

.picker-control--filled {
  color: var(--ink);
  font-weight: 700;
}

.picker-chevron {
  width: calc(11 * var(--rpx));
  height: calc(11 * var(--rpx));
  flex: none;
  transform: rotate(45deg) translateY(calc(-3 * var(--rpx)));
  border-right: calc(2 * var(--rpx)) solid var(--ink-3);
  border-bottom: calc(2 * var(--rpx)) solid var(--ink-3);
}

.service-options {
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.service-option {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: calc(112 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  padding: calc(32 * var(--rpx));
  border: calc(2 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
  text-align: left;
}

.service-option--column {
  flex-direction: column;
  align-items: stretch;
}

.service-option--selected {
  border-color: var(--ink);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.service-option--project {
  border-color: var(--primary);
  background: rgba(238, 242, 255, 0.5);
}

.service-option__head {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}

.option-check {
  display: flex;
  width: calc(34 * var(--rpx));
  height: calc(34 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
}

.option-check--indigo {
  background: var(--primary);
}

.project-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding-top: calc(24 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
}

.project-chip {
  padding: calc(16 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1.5;
}

.project-chip--selected {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--color-surface);
}

.divider {
  height: calc(1 * var(--rpx));
  margin: calc(40 * var(--rpx)) 0;
  background: var(--color-surface-soft);
}

.work-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
}

.work-option {
  min-height: calc(84 * var(--rpx));
  padding: 0 calc(12 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 1.4;
}

.work-option--selected {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
}

.mark-later {
  display: flex;
  width: 100%;
  min-height: calc(100 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin-top: calc(48 * var(--rpx));
  border: calc(2 * var(--rpx)) dashed var(--color-line-strong);
  border-radius: var(--radius-48);
  background: transparent;
  color: var(--ink-3);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.5;
}

.error-banner {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.request-id {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.eligibility-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(42 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(calc(26 * var(--rpx)));
}

.eligibility-primary {
  width: 100%;
  min-height: calc(112 * var(--rpx));
  padding: 0 calc(32 * var(--rpx));
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: var(--shadow-elevated);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.5;
}

.eligibility-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.catalog-retry,
button.project-chip {
  width: auto;
}

button.major-result,
button.service-option,
button.work-option,
button.mark-later,
button.eligibility-primary {
  width: 100%;
}

@media (min-width: 768px) {
  .eligibility-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .eligibility-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
