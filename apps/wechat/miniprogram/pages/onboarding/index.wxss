.onboarding { display: flex; flex-direction: column; padding-bottom: 36rpx; }
.loading-state { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: calc(100vh - 100rpx); text-align: center; }
.loading-title { margin-top: 28rpx; font-size: 34rpx; font-weight: 850; }
.loading-copy { max-width: 560rpx; margin-top: 14rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.65; }
.topbar { display: flex; align-items: center; justify-content: space-between; }
.brand-lockup { display: flex; align-items: center; gap: 16rpx; }
.privacy-note { margin-top: 4rpx; color: var(--color-muted); font-size: 20rpx; }
.step-number { color: var(--color-primary-deep); font-family: var(--font-family-data); font-size: 22rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.progress-track { height: 8rpx; margin-top: 28rpx; overflow: hidden; border-radius: 99rpx; background: rgba(82, 104, 255, 0.1); }
.progress-value { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--color-cyan), var(--color-primary)); transition: width 0.28s ease; }
.progress-value--0 { width: 25%; }.progress-value--1 { width: 50%; }.progress-value--2 { width: 75%; }.progress-value--3 { width: 100%; }
.step-tabs { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 12rpx; }
.step-tab { color: var(--color-faint); font-size: 20rpx; text-align: center; }
.step-tab--active { color: var(--color-primary); font-weight: 700; }
.intro { margin-top: 42rpx; }
.form-card { margin-top: 30rpx; padding: 30rpx; border: 1rpx solid rgba(82, 104, 255, 0.12); border-radius: 36rpx; background: rgba(255,255,255,.9); box-shadow: 0 24rpx 70rpx rgba(31,42,104,.09); }
.field-label { color: var(--color-ink-secondary); font-size: 24rpx; font-weight: 750; }
.field-label--spaced { margin-top: 34rpx; }
.choice-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: 18rpx; }
.choice-grid--four { grid-template-columns: repeat(4, 1fr); }
.choice { display: flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 78rpx; padding: 0 12rpx; border: 1rpx solid var(--color-line); border-radius: 22rpx; background: var(--color-surface-soft); color: var(--color-ink-secondary); font-size: 24rpx; }
.choice--selected { border-color: rgba(82,104,255,.7); background: var(--color-primary-soft); color: var(--color-primary-deep); box-shadow: inset 0 0 0 1rpx rgba(82,104,255,.18); font-weight: 750; }
.choice-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--color-faint); }
.choice--selected .choice-dot { background: var(--color-primary); box-shadow: 0 0 0 7rpx rgba(82,104,255,.12); }
.choice--large { justify-content: flex-start; min-height: 116rpx; padding: 18rpx; }
.choice-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #fff; color: var(--color-primary); font-weight: 800; }
.choice-title { font-weight: 750; }.choice-copy { margin-top: 6rpx; color: var(--color-muted); font-size: 19rpx; }
.input-shell { display: flex; align-items: center; gap: 16rpx; height: 92rpx; margin-top: 16rpx; padding: 0 20rpx 0 24rpx; border: 1rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface-soft); }
.input-shell--filled { border-color: rgba(82,104,255,.4); background: #fff; }
.input-shell input { flex: 1; height: 100%; font-size: 26rpx; }
.input-badge { padding: 8rpx 12rpx; border-radius: 12rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 18rpx; font-weight: 700; }
.input-badge--optional { background: #eef1f5; color: var(--color-muted); }
.field-help { margin-top: 14rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.55; }
.choice-list { margin-top: 16rpx; overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 24rpx; }
.choice-row { display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; padding: 0 22rpx; border-bottom: 1rpx solid var(--color-line); color: var(--color-ink-secondary); font-size: 24rpx; }
.choice-row:last-child { border-bottom: 0; }.choice-row--selected { background: var(--color-primary-soft); color: var(--color-primary-deep); font-weight: 750; }
.row-check { opacity: 0; color: var(--color-primary); }.choice-row--selected .row-check { opacity: 1; }
.year-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; margin-top: 18rpx; }
.year-chip { display: flex; align-items: center; justify-content: center; height: 72rpx; border: 1rpx solid var(--color-line); border-radius: 20rpx; background: var(--color-surface-soft); color: var(--color-muted); font-size: 22rpx; }
.year-chip--selected { border-color: var(--color-primary); background: var(--gradient-brand); color: #fff; font-weight: 750; box-shadow: var(--shadow-primary); }
.notice-card { display: flex; gap: 16rpx; margin-top: 26rpx; padding: 20rpx; border-radius: 22rpx; background: linear-gradient(135deg,#f0f2ff,#edfbf8); color: var(--color-ink-secondary); font-size: 21rpx; line-height: 1.55; }
.notice-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border-radius: 50%; background: var(--color-primary); color: #fff; font-weight: 800; }
.review-head { display: flex; align-items: flex-end; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--color-line); }
.review-status { color: var(--color-warning); font-size: 25rpx; font-weight: 800; }.review-caption { color: var(--color-muted); font-size: 19rpx; }
.review-row { display: grid; grid-template-columns: 170rpx 1fr; gap: 20rpx; padding: 21rpx 0; border-bottom: 1rpx solid var(--color-line); font-size: 23rpx; line-height: 1.45; }
.review-row text:first-child { color: var(--color-muted); }.review-row text:last-child { color: var(--color-ink-secondary); text-align: right; word-break: break-all; }
.confirm-copy { margin-top: 22rpx; padding: 18rpx; border-radius: 18rpx; background: var(--color-success-soft); color: var(--color-success); font-size: 21rpx; line-height: 1.55; }
.recovery-banner { display: flex; gap: 18rpx; margin-top: 18rpx; padding: 22rpx; border: 1rpx solid rgba(239,166,68,.26); border-radius: 24rpx; background: var(--color-warning-soft); }
.recovery-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 14rpx; background: var(--color-warning); color: #fff; font-weight: 900; }
.recovery-title { color: var(--color-ink-secondary); font-size: 23rpx; font-weight: 800; }
.recovery-copy { margin-top: 5rpx; color: var(--color-muted); font-size: 20rpx; line-height: 1.5; }
.error-banner { margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: var(--color-danger-soft); color: var(--color-danger); font-size: 22rpx; }
.request-id { margin-top: 10rpx; color: var(--color-faint); font-family: var(--font-family-data); font-size: 18rpx; }
.footer-actions { display: flex; align-items: center; gap: 14rpx; margin-top: auto; padding-top: 28rpx; }
.footer-primary { flex: 1; }
.success-state { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-height: calc(100vh - 100rpx); text-align: center; }
.success-orbit { display: flex; align-items: center; justify-content: center; width: 260rpx; height: 260rpx; border-radius: 50%; background: radial-gradient(circle,#fff 15%,#edf0ff 56%,rgba(77,226,208,.2) 100%); box-shadow: 0 30rpx 90rpx rgba(82,104,255,.16); }
.success-kicker { margin-top: 40rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }.success-title { margin-top: 12rpx; font-size: 46rpx; font-weight: 850; }.success-copy { max-width: 610rpx; margin: 18rpx auto 0; color: var(--color-muted); font-size: 24rpx; line-height: 1.7; }
.success-points { align-self: stretch; margin: 30rpx 0; padding: 24rpx 28rpx; border: 1rpx solid var(--color-line); border-radius: 28rpx; background: rgba(255,255,255,.84); text-align: left; }
.success-points view { padding: 10rpx 0; color: var(--color-ink-secondary); font-size: 23rpx; }.success-points text { margin-right: 16rpx; color: var(--color-success); font-weight: 900; }
