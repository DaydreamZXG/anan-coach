.eligibility-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.eligibility-nav {
  box-sizing: border-box;
  display: flex;
  height: 112rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.8);
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-back,
.nav-save,
.major-result,
.catalog-retry,
.service-option,
.project-chip,
.work-option,
.mark-later,
.eligibility-primary {
  margin: 0;
  border: 0;
}

.nav-back::after,
.nav-save::after,
.major-result::after,
.catalog-retry::after,
.service-option::after,
.project-chip::after,
.work-option::after,
.mark-later::after,
.eligibility-primary::after {
  border: 0;
}

.nav-back {
  display: flex;
  width: 64rpx;
  height: 80rpx;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
}

.nav-back__icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.nav-save {
  padding: 12rpx 24rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 39rpx;
}

.eligibility-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.eligibility-scroll {
  min-height: 0;
  flex: 1;
}

.eligibility-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 280rpx;
}

.boundary-notice {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 237, 212, 0.5);
  border-radius: 40rpx;
  background: rgba(255, 247, 237, 0.5);
}

.notice-icon {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.notice-copy {
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.625;
}

.form-card {
  box-sizing: border-box;
  margin-top: 64rpx;
  padding: 40rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.02);
}

.experience-card {
  margin-top: 48rpx;
}

.card-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
  line-height: 42rpx;
}

.card-copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.625;
}

.major-field {
  box-sizing: border-box;
  display: flex;
  height: 96rpx;
  align-items: center;
  gap: 18rpx;
  margin-top: 32rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--bg);
}

.major-field--selected {
  border-color: var(--figma-color-primary-soft-strong);
  background: var(--color-surface);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.major-input {
  min-width: 0;
  height: 100%;
  flex: 1;
  color: var(--ink);
  font-size: 28rpx;
}

.catalog-status,
.major-selected-meta {
  margin-top: 14rpx;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.catalog-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: 22rpx;
  line-height: 1.5;
}

.catalog-retry {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
}

.major-results {
  overflow: hidden;
  margin-top: 12rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: 0 20rpx 50rpx rgba(16, 24, 40, 0.1);
}

.major-result {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--color-surface-soft);
  border-radius: 0;
  background: var(--color-surface);
  text-align: left;
}

.major-result:last-child {
  border-bottom: 0;
}

.major-result__title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
}

.major-result__code {
  margin-left: 10rpx;
  color: var(--ink-3);
  font-size: 21rpx;
  font-weight: 500;
}

.major-result__category {
  margin-top: 7rpx;
  color: var(--primary);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 32rpx;
}

.picker-label {
  margin-left: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.picker-control {
  box-sizing: border-box;
  display: flex;
  height: 96rpx;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 600;
}

.picker-control--filled {
  color: var(--ink);
  font-weight: 700;
}

.picker-chevron {
  width: 11rpx;
  height: 11rpx;
  flex: none;
  transform: rotate(45deg) translateY(-3rpx);
  border-right: 2rpx solid var(--ink-3);
  border-bottom: 2rpx solid var(--ink-3);
}

.service-options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.service-option {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border: 2rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: left;
}

.service-option--column {
  flex-direction: column;
  align-items: stretch;
}

.service-option--selected {
  border-color: var(--ink);
  background: var(--color-surface);
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.06);
}

.service-option--project {
  border-color: var(--primary);
  background: rgba(238, 242, 255, 0.5);
}

.service-option__head {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}

.option-check {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 22rpx;
}

.option-check--indigo {
  background: var(--primary);
}

.project-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--figma-color-primary-soft-strong);
}

.project-chip {
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--figma-color-ink-tertiary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.project-chip--selected {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--color-surface);
}

.divider {
  height: 1rpx;
  margin: 40rpx 0;
  background: var(--color-surface-soft);
}

.work-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.work-option {
  min-height: 84rpx;
  padding: 0 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--figma-color-ink-tertiary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.work-option--selected {
  border-color: var(--ink);
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.16);
}

.mark-later {
  display: flex;
  width: 100%;
  min-height: 100rpx;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  border: 2rpx dashed var(--color-line-strong);
  border-radius: 48rpx;
  background: transparent;
  color: var(--ink-3);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: 23rpx;
  line-height: 1.55;
}

.request-id {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 19rpx;
  text-align: center;
}

.eligibility-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(42rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.eligibility-primary {
  width: 100%;
  min-height: 112rpx;
  padding: 0 32rpx;
  border-radius: 48rpx;
  background: var(--ink);
  color: var(--color-surface);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.12);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.eligibility-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.nav-back {
  width: 64rpx;
}

button.nav-save,
button.catalog-retry,
button.project-chip {
  width: auto;
}

button.major-result,
button.service-option,
button.work-option,
button.mark-later,
button.eligibility-primary {
  width: 100%;
}

@media (min-width: 768px) {
  .eligibility-content {
    width: 100%;
    max-width: 560px;
    margin-right: auto;
    margin-left: auto;
  }

  .eligibility-dock {
    right: auto;
    left: 50%;
    width: 560px;
    transform: translateX(-50%);
  }
}
