<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="step-text">第 6 步 / 共 6 步</view>
    <view class="step-bar">
      <view wx:for="{{steps}}" wx:key="*this" class="step-seg {{item <= step ? 'is-active' : ''}}"></view>
    </view>

    <view class="hero">
      <view class="hero__title">都准备好了。</view>
      <view class="hero__sub">岸岸会按你的目标和节奏，每天排好要做的事。</view>
    </view>
  </view>

  <view class="footer">
    <ui-button variant="primary" block loading="{{submitting}}" bind:tap="onEnter">进入今日</ui-button>
  </view>
</view>
