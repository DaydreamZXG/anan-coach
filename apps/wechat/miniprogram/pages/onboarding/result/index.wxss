.result-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.result-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.result-scroll {
  min-height: 0;
  flex: 1;
}

.result-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.result-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 32rpx;
  text-align: center;
}

.status-icon {
  display: flex;
  width: 160rpx;
  height: 160rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--good-soft);
  border-radius: 50%;
  background: var(--good-soft);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.status-icon__asset {
  width: 72rpx;
  height: 72rpx;
}

.status-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1.3rpx;
  line-height: 73rpx;
}

.status-confidence {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.confidence {
  font-weight: 700;
}

.confidence--high {
  color: var(--good);
}

.confidence--calibrating {
  color: var(--primary);
}

.confidence--review {
  color: var(--figma-color-warning-deep);
}

.assessment-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  margin-top: 64rpx;
  padding: 48rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 64rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.03);
}

.assessment-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
  line-height: 42rpx;
}

.assessment-heading__icon {
  width: 32rpx;
  height: 32rpx;
}

.assessment-copy {
  margin-top: 8rpx;
  color: var(--figma-color-ink-tertiary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 42rpx;
  text-indent: 40rpx;
}

.assessment-divider {
  height: 1rpx;
  background: var(--color-surface-soft);
}

.position-notice {
  position: relative;
  box-sizing: border-box;
  padding: 34rpx 32rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--bg);
}

.notice-tag {
  position: absolute;
  top: -16rpx;
  left: 32rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--ink);
  color: var(--color-surface);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.notice-copy {
  color: var(--figma-color-ink-tertiary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.suggestions-title {
  margin: 48rpx 0 24rpx 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 45rpx;
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.suggestion-card {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--color-surface);
  text-align: left;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.suggestion-card::after {
  border: 0;
}

.suggestion-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
}

.suggestion-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.suggestion-icon--indigo {
  background: var(--primary-soft);
}

.suggestion-icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.suggestion-icon__asset {
  width: 36rpx;
  height: 36rpx;
}

.suggestion-text {
  min-width: 0;
}

.suggestion-name {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.suggestion-copy {
  margin-top: 2rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.suggestion-arrow {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  margin-left: 16rpx;
}

.validity {
  margin-top: 24rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  text-align: center;
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--primary-deep);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 14rpx;
  color: var(--ink-3);
  font-family: monospace;
  font-size: 20rpx;
  text-align: center;
}

.result-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 34rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.result-primary {
  width: 100%;
  margin: 0;
  padding: 32rpx 24rpx;
  border: 0;
  border-radius: 48rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.12);
}

.result-primary::after {
  border: 0;
}

button.suggestion-card,
button.result-primary {
  width: 100%;
}
