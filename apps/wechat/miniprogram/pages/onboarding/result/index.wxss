.result-page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.result-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.result-scroll {
  min-height: 0;
  flex: 1;
}

.result-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(260 * var(--rpx));
}

.result-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: calc(32 * var(--rpx));
  text-align: center;
}

.status-icon {
  display: flex;
  width: calc(160 * var(--rpx));
  height: calc(160 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin-bottom: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--good-soft);
  border-radius: 50%;
  background: var(--good-soft);
  box-shadow: var(--shadow-crisp);
}

.status-icon__asset {
  width: calc(72 * var(--rpx));
  height: calc(72 * var(--rpx));
}

.status-title {
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1.3 * var(--rpx));
  line-height: calc(73 * var(--rpx));
}

.status-confidence {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: calc(42 * var(--rpx));
}

.confidence {
  font-weight: 700;
}

.confidence--high {
  color: var(--good);
}

.confidence--calibrating {
  color: var(--color-muted);
}

.confidence--review {
  color: var(--figma-color-warning-deep);
}

.assessment-card {
  display: flex;
  flex-direction: column;
  gap: calc(40 * var(--rpx));
  margin-top: calc(64 * var(--rpx));
}

.assessment-heading {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.3 * var(--rpx));
  line-height: calc(42 * var(--rpx));
}

.assessment-heading__icon {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}

.assessment-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: calc(42 * var(--rpx));
}

.assessment-divider {
  height: calc(1 * var(--rpx));
  background: var(--color-surface-soft);
}

.position-notice {
  position: relative;
  box-sizing: border-box;
  padding: calc(32 * var(--rpx)) calc(32 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--bg);
}

.notice-tag {
  position: absolute;
  top: calc(-16 * var(--rpx));
  left: calc(32 * var(--rpx));
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(30 * var(--rpx));
  box-shadow: var(--shadow-crisp);
}

.notice-copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: calc(42 * var(--rpx));
}

.suggestions-title {
  margin: calc(48 * var(--rpx)) 0 calc(24 * var(--rpx)) calc(8 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(45 * var(--rpx));
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
}

.suggestion-card {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  text-align: left;
  box-shadow: var(--shadow-crisp);
}

.suggestion-card::after {
  border: 0;
}

.suggestion-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: calc(24 * var(--rpx));
}

.suggestion-icon {
  display: flex;
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.suggestion-icon--indigo {
  background: var(--primary-soft);
}

.suggestion-icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.suggestion-icon__asset {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

.suggestion-text {
  min-width: 0;
}

.suggestion-name {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}

.suggestion-copy {
  margin-top: calc(2 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: calc(36 * var(--rpx));
}

.suggestion-arrow {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
  flex: none;
  margin-left: calc(16 * var(--rpx));
}

.validity {
  margin-top: calc(24 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.recovery-banner,
.error-banner {
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  text-align: center;
}

button.suggestion-card,
button.result-primary {
  width: 100%;
}

/* 平板层：结果内容限可读宽。 */
@media (min-width: 768px) {
  .result-content {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
  }
}
