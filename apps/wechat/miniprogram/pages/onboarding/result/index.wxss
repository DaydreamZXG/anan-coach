.result-page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.result-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.result-scroll {
  min-height: 0;
  flex: 1;
}

.result-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.result-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 32rpx;
  text-align: center;
}

.status-icon {
  display: flex;
  width: 160rpx;
  height: 160rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--good-soft);
  border-radius: 50%;
  background: var(--good-soft);
  box-shadow: var(--shadow-crisp);
}

.status-icon__asset {
  width: 72rpx;
  height: 72rpx;
}

.status-title {
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: -1.3rpx;
  line-height: 73rpx;
}

.status-confidence {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 42rpx;
}

.confidence {
  font-weight: 700;
}

.confidence--high {
  color: var(--good);
}

.confidence--calibrating {
  color: var(--color-muted);
}

.confidence--review {
  color: var(--figma-color-warning-deep);
}

.assessment-card {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  margin-top: 64rpx;
}

.assessment-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: -0.3rpx;
  line-height: 42rpx;
}

.assessment-heading__icon {
  width: 32rpx;
  height: 32rpx;
}

.assessment-copy {
  margin-top: 8rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 42rpx;
}

.assessment-divider {
  height: 1rpx;
  background: var(--color-surface-soft);
}

.position-notice {
  position: relative;
  box-sizing: border-box;
  padding: 32rpx 32rpx 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--bg);
}

.notice-tag {
  position: absolute;
  top: -16rpx;
  left: 32rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 30rpx;
  box-shadow: var(--shadow-crisp);
}

.notice-copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 42rpx;
}

.suggestions-title {
  margin: 48rpx 0 24rpx 8rpx;
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 45rpx;
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.suggestion-card {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  text-align: left;
  box-shadow: var(--shadow-crisp);
}

.suggestion-card::after {
  border: 0;
}

.suggestion-main {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 24rpx;
}

.suggestion-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.suggestion-icon--indigo {
  background: var(--primary-soft);
}

.suggestion-icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.suggestion-icon__asset {
  width: 36rpx;
  height: 36rpx;
}

.suggestion-text {
  min-width: 0;
}

.suggestion-name {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}

.suggestion-copy {
  margin-top: 2rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 36rpx;
}

.suggestion-arrow {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  margin-left: 16rpx;
}

.validity {
  margin-top: 24rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  text-align: center;
}

button.suggestion-card,
button.result-primary {
  width: 100%;
}

/* 平板层：结果内容限可读宽。 */
@media (min-width: 768px) {
  .result-content {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
  }
}
