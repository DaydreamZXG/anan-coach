<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="step-row">
      <view class="step-text">第 5 步 / 共 6 步</view>
      <view wx:if="{{phase === 'answering'}}" class="step-skip" bind:tap="onSkip">跳过，直接完成</view>
    </view>
    <view class="step-bar">
      <view wx:for="{{steps}}" wx:key="*this" class="step-seg {{item <= step ? 'is-active' : ''}}"></view>
    </view>
    <view class="nav__title">定位测试</view>
    <view wx:if="{{task}}" class="nav__sub">共 {{task.questionCount}} 题 · 约 {{task.durationMinutes}} 分钟</view>
    <view wx:else class="nav__sub">一屏一题，做完就有起跑线</view>
  </view>

  <!-- 加载 / 错误 -->
  <state-view wx:if="{{phase === 'loading'}}" type="loading" title="岸岸正在出题…" />
  <state-view
    wx:elif="{{phase === 'error'}}"
    type="error"
    title="题目没加载出来"
    desc="网络不太稳定，稍后再试一次。"
    request-id="{{requestId}}"
    action-text="重试"
    bind:action="load"
  />

  <!-- 逐题作答 -->
  <block wx:elif="{{phase === 'answering' && current}}">
    <view class="q-meta">第 {{currentNo}}/{{task.questionCount}} 题 · {{current.moduleName || '行测'}}</view>
    <view class="q-stem">{{current.stem}}</view>
    <view class="q-options">
      <view
        wx:for="{{current.options}}"
        wx:key="label"
        class="q-option {{currentSelected === item.label ? 'is-active' : ''}}"
        data-label="{{item.label}}"
        hover-class="is-pressed"
        bind:tap="onPickOption"
      >
        <text class="q-option__label">{{item.label}}</text>
        <text class="q-option__text">{{item.optionText}}</text>
      </view>
    </view>

    <view class="footer">
      <ui-button
        variant="primary"
        block
        disabled="{{!currentSelected}}"
        loading="{{submitting}}"
        bind:tap="onFooterTap"
      >
        {{isLast ? '提交' : '下一题'}}
      </ui-button>
    </view>
  </block>

  <!-- 结果视图（页面内切换，不跳页） -->
  <block wx:elif="{{phase === 'result' && result}}">
    <view class="card score">
      <view class="score__cap">行测估分</view>
      <view class="score__line">
        <text class="score__num">{{scoreText}}</text>
        <text class="score__unit">分</text>
      </view>
      <view class="score__note">这是起跑线，岸岸会按它排后面的练习</view>
    </view>

    <view class="card modules" wx:if="{{moduleBars.length > 0}}">
      <view wx:for="{{moduleBars}}" wx:key="name" class="module">
        <view class="module__name">{{item.name}}</view>
        <view class="module__bar">
          <view class="module__fill" style="width: {{item.percent}}%"></view>
        </view>
        <view class="module__val">
          {{item.percent}}<text class="module__pct">%</text>
        </view>
        <view class="module__detail">{{item.detail}}</view>
      </view>
    </view>

    <view class="footer">
      <ui-button variant="primary" block bind:tap="onFinish">完成</ui-button>
    </view>
  </block>
</view>
