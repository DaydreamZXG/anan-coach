.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 220rpx;
}

.nav {
  padding: 0 32rpx 32rpx;
}

.step-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
}

.step-text {
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--ink-3);
}

.step-skip {
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 8rpx 0 8rpx 24rpx;
}

.step-bar {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.step-seg {
  flex: 1;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(16, 19, 27, 0.08);
}

.step-seg.is-active {
  background: var(--grad-main);
}

.nav__title {
  padding-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 作答区 */
.q-meta {
  margin: 0 32rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--ink-3);
}

.q-stem {
  margin: 0 32rpx 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.7;
}

.q-options {
  padding: 0 32rpx;
}

.q-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
}

.q-option.is-active {
  border: 1rpx solid transparent;
  background:
    linear-gradient(var(--surface), var(--surface)) padding-box,
    var(--grad-main) border-box;
}

.q-option__label {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--indigo);
}

.q-option__text {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.6;
}

.is-pressed {
  opacity: 0.85;
}

/* 结果视图 */
.score {
  margin: 8rpx 32rpx 0;
  padding: 34rpx;
  border-radius: var(--r-lg);
}

.score__cap {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--ink-3);
}

.score__line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.score__num {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.02em;
  background: var(--grad-main);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.score__unit {
  font-size: 26rpx;
  color: var(--ink-3);
}

.score__note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.modules {
  margin: 24rpx 32rpx 0;
  padding: 8rpx 28rpx;
}

.module {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.module:last-child {
  border-bottom: none;
}

.module__name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.module__bar {
  flex: 1;
  height: 16rpx;
  background: rgba(16, 19, 27, 0.06);
  border-radius: 999rpx;
  overflow: hidden;
}

.module__fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--grad-main);
}

.module__val {
  width: 72rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
}

.module__pct {
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}

.module__detail {
  width: 96rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 20rpx;
  color: var(--ink-3);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 250, 0), var(--bg) 45%);
}
