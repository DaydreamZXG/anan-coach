<view class="page">
  <!-- 深空 hero：品牌与定位 -->
  <view class="hero" style="padding-top: {{statusBarHeight}}px">
    <view class="hero__brand">岸岸</view>
    <view class="hero__tagline">AI 国考教练：把分差，变成今天的行动</view>
  </view>

  <!-- 三步说明 -->
  <view class="steps">
    <view wx:for="{{steps}}" wx:key="no" class="card step">
      <view class="step__no">{{item.no}}</view>
      <view class="step__body">
        <view class="step__name">{{item.name}}</view>
        <view class="step__desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="footer">
    <ui-button variant="primary" block bind:tap="onStart">开始</ui-button>
  </view>
</view>
