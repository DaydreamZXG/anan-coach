<view class="baseline-page">
  <workbench-nav
    id="runtime-workbench-nav"
    title="5/5 现在的水平"
    back-behavior="emit"
    bind:back="back"
  />

  <view wx:if="{{!state || state.status === 'loading'}}" class="baseline-state">
    <state-view state="loading" title="正在找回你的情况" description="别急，你填过的分数、答过的摸底都记得。" />
  </view>

  <view wx:elif="{{state.status === 'error'}}" class="baseline-state">
    <state-view state="error" title="哎，没找回来" description="{{state.error.message}}" actionText="再试一次" bindaction="retry" />
    <view wx:if="{{state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="baseline-scroll" enhanced show-scrollbar="{{false}}">
      <view class="baseline-content onboarding-scroll-content fade-slide-in fade-slide-in--2">
        <view class="baseline-heading">咱们先摸个底，不急着赶进度。</view>
        <view class="baseline-copy">这里的分数只当起点用，不打分你这个人。</view>

        <view class="baseline-options">
          <view hover-class="item--hover"
            class="baseline-card {{state.draft.mode === 'unknown' ? 'baseline-card--unknown-selected' : ''}}"
            role="button"
            data-mode="unknown"
            bindtap="selectMode"
          >
            <view class="card-top">
              <view class="card-icon card-icon--cyan">
                <image class="card-icon__asset" src="/assets/onboarding/ability-target-cyan.svg" mode="aspectFit" />
              </view>
              <view wx:if="{{state.draft.mode === 'unknown'}}" class="card-check card-check--ink">✓</view>
            </view>
            <view class="card-title">不清楚现在什么水平</view>
            <view class="card-copy">先不用填，等咱们认识完，岸岸给你安排一组摸底小题，帮你看看水平。</view>
          </view>

          <view hover-class="item--hover"
            class="baseline-card {{state.draft.mode === 'reported_score' ? 'baseline-card--reported-selected' : ''}}"
            role="button"
            data-mode="reported_score"
            bindtap="selectMode"
          >
            <view class="card-top">
              <view class="card-icon card-icon--indigo">
                <image class="card-icon__asset" src="/assets/onboarding/ability-book-indigo.svg" mode="aspectFit" />
              </view>
              <view wx:if="{{state.draft.mode === 'reported_score'}}" class="card-check card-check--indigo">✓</view>
            </view>
            <view class="card-title">填过往的模考/考试分数</view>
            <view class="card-copy">这样岸岸能更快找出你的薄弱点。</view>

            <view wx:if="{{state.draft.mode === 'reported_score'}}" class="score-form">
              <view class="score-grid">
                <view class="score-field">
                  <view class="score-label">行测总分 (估)</view>
                  <input class="score-input" type="digit" maxlength="6" placeholder="如: 65" value="{{state.draft.xingceScore}}" data-field="xingceScore" bindinput="updateScore" />
                </view>
                <view class="score-field">
                  <view class="score-label">申论总分 (估)</view>
                  <input class="score-input" type="digit" maxlength="6" placeholder="如: 60" value="{{state.draft.shenlunScore}}" data-field="shenlunScore" bindinput="updateScore" />
                </view>
              </view>
              <view class="score-note">更细的模块情况（比如言语、资料分析错几题），回头导入试卷就能自动看出来。</view>
            </view>
          </view>
        </view>

        <view wx:if="{{state.pendingRecovery}}" class="recovery-banner">上次的结果还没存稳，这次只帮你查一下，不重复存。</view>
        <view wx:if="{{state.validationError}}" class="error-banner">{{state.validationError}}</view>
        <view wx:if="{{state.error}}" class="error-banner">{{state.error.message}}</view>
        <view wx:if="{{state.error && state.error.requestId}}" class="request-id">问题编号 · {{state.error.requestId}}</view>
      </view>
    </scroll-view>

    <view class="baseline-dock onboarding-action-dock">
      <button hover-class="item--hover"
        class="baseline-primary {{!hasChoice ? 'baseline-primary--disabled' : ''}} tap-tactile"
        loading="{{state.saving}}"
        disabled="{{state.saving || !hasChoice}}"
        bindtap="submit"
      >{{state.pendingRecovery ? '看看上次的结果' : '完成，看看你的情况'}}</button>
      <button
        hover-class="item--hover"
        class="onboarding-save-action"
        loading="{{state.saving}}"
        disabled="{{state.saving}}"
        bindtap="saveAndExit"
      >先存起来，回头再填</button>
    </view>
  </block>
</view>
