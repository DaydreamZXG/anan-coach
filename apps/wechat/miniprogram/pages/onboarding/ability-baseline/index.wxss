@import "../../../features/onboarding/page-shell.wxss";

.baseline-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.baseline-primary {
  margin: 0;
  border: 0;
}

.baseline-primary::after {
  border: 0;
}

.baseline-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.baseline-scroll {
  min-height: 0;
  flex: 1;
}

.baseline-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.baseline-heading {
  margin-left: 8rpx;
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: 56rpx;
}

.baseline-copy {
  margin: 16rpx 0 48rpx 8rpx;
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 42rpx;
}

.baseline-options {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.baseline-card {
  box-sizing: border-box;
  padding: 40rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.baseline-card--unknown-selected {
  outline: 3rpx solid var(--ink);
  box-shadow: var(--shadow-elevated);
}

.baseline-card--reported-selected {
  outline: 3rpx solid var(--primary);
  box-shadow: var(--shadow-ai);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.card-icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.card-icon--indigo {
  background: var(--primary-soft);
}

.card-icon__asset {
  width: 36rpx;
  height: 36rpx;
}

.card-check {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: 40rpx;
}

.card-check--ink {
  color: var(--ink);
}

.card-check--indigo {
  color: var(--color-muted);
}

.card-title {
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: -0.32rpx;
  line-height: 45rpx;
}

.card-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 36rpx;
}

.score-form {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line);
}

.score-grid {
  display: flex;
  gap: 16rpx;
}

.score-field {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
}

.score-label {
  margin-bottom: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 32rpx;
}

.score-input {
  width: 100%;
  height: 44rpx;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 44rpx;
}

.score-note {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 32rpx;
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  text-align: center;
}

.baseline-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 34rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(26rpx);
}

.baseline-primary {
  width: 100%;
  padding: 32rpx 24rpx;
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 48rpx;
  box-shadow: var(--shadow-elevated);
}

.baseline-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.baseline-primary {
  width: 100%;
}
