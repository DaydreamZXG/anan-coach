@import "../../../features/onboarding/page-shell.wxss";

.baseline-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.baseline-primary {
  margin: 0;
  border: 0;
}

.baseline-primary::after {
  border: 0;
}

.baseline-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: calc(40 * var(--rpx));
}

.baseline-scroll {
  min-height: 0;
  flex: 1;
}

.baseline-content {
  box-sizing: border-box;
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx)) calc(260 * var(--rpx));
}

.baseline-heading {
  margin-left: calc(8 * var(--rpx));
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.4 * var(--rpx));
  line-height: calc(56 * var(--rpx));
}

.baseline-copy {
  margin: calc(16 * var(--rpx)) 0 calc(48 * var(--rpx)) calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: calc(42 * var(--rpx));
}

.baseline-options {
  display: flex;
  flex-direction: column;
  gap: calc(32 * var(--rpx));
}

.baseline-card {
  box-sizing: border-box;
  padding: calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-surface-soft);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.baseline-card--unknown-selected {
  outline: calc(3 * var(--rpx)) solid var(--ink);
  box-shadow: var(--shadow-elevated);
}

.baseline-card--reported-selected {
  outline: calc(3 * var(--rpx)) solid var(--primary);
  box-shadow: var(--shadow-ai);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: calc(16 * var(--rpx));
}

.card-icon {
  display: flex;
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.card-icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.card-icon--indigo {
  background: var(--primary-soft);
}

.card-icon__asset {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

.card-check {
  display: flex;
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
  align-items: center;
  justify-content: center;
  border: calc(3 * var(--rpx)) solid currentColor;
  border-radius: 50%;
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: calc(40 * var(--rpx));
}

.card-check--ink {
  color: var(--ink);
}

.card-check--indigo {
  color: var(--color-muted);
}

.card-title {
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.32 * var(--rpx));
  line-height: calc(45 * var(--rpx));
}

.card-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: calc(36 * var(--rpx));
}

.score-form {
  margin-top: calc(32 * var(--rpx));
  padding-top: calc(32 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--line);
}

.score-grid {
  display: flex;
  gap: calc(16 * var(--rpx));
}

.score-field {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
}

.score-label {
  margin-bottom: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(32 * var(--rpx));
}

.score-input {
  width: 100%;
  height: calc(44 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(44 * var(--rpx));
}

.score-note {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: calc(32 * var(--rpx));
}

.recovery-banner,
.error-banner {
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--color-muted);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-3);
  font-family: monospace;
  font-size: var(--text-micro);
  text-align: center;
}

.baseline-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: calc(34 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(40 * var(--rpx)) + env(safe-area-inset-bottom));
  border-top: calc(1 * var(--rpx)) solid var(--line);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(calc(26 * var(--rpx)));
}

.baseline-primary {
  width: 100%;
  padding: calc(32 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-48);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(48 * var(--rpx));
  box-shadow: var(--shadow-elevated);
}

.baseline-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}

button.baseline-primary {
  width: 100%;
}
