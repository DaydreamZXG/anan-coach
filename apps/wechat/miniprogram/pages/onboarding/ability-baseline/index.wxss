.baseline-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
}

.baseline-nav {
  position: relative;
  box-sizing: border-box;
  display: flex;
  height: 112rpx;
  align-items: center;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.8);
}

.nav-back,
.nav-save,
.baseline-primary {
  margin: 0;
  border: 0;
}

.nav-back::after,
.nav-save::after,
.baseline-primary::after {
  border: 0;
}

.nav-back {
  display: flex;
  width: 64rpx;
  height: 80rpx;
  align-items: center;
  justify-content: flex-start;
  padding: 0;
  background: transparent;
}

.nav-back__icon {
  width: 48rpx;
  height: 48rpx;
}

.nav-title {
  margin-left: 24rpx;
  margin-right: auto;
  font-size: 32rpx;
  font-weight: 700;
}

.nav-save {
  padding: 12rpx 24rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 39rpx;
}

.baseline-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx;
}

.baseline-scroll {
  min-height: 0;
  flex: 1;
}

.baseline-content {
  box-sizing: border-box;
  padding: 48rpx 40rpx 260rpx;
}

.baseline-heading {
  margin-left: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  line-height: 56rpx;
}

.baseline-copy {
  margin: 16rpx 0 48rpx 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.baseline-options {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.baseline-card {
  box-sizing: border-box;
  padding: 40rpx;
  border: 1rpx solid var(--color-surface-soft);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.baseline-card--unknown-selected {
  outline: 3rpx solid var(--ink);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.1);
}

.baseline-card--reported-selected {
  outline: 3rpx solid var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(97, 95, 255, 0.12);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.card-icon--cyan {
  background: var(--figma-color-cyan-soft);
}

.card-icon--indigo {
  background: var(--primary-soft);
}

.card-icon__asset {
  width: 36rpx;
  height: 36rpx;
}

.card-check {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.card-check--ink {
  color: var(--ink);
}

.card-check--indigo {
  color: var(--primary);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.32rpx;
  line-height: 45rpx;
}

.card-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.score-form {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line);
}

.score-grid {
  display: flex;
  gap: 16rpx;
}

.score-field {
  box-sizing: border-box;
  min-width: 0;
  flex: 1;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--bg);
}

.score-label {
  margin-bottom: 8rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.score-input {
  width: 100%;
  height: 44rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.score-note {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.recovery-banner,
.error-banner {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.recovery-banner {
  background: var(--primary-soft);
  color: var(--primary-deep);
}

.error-banner {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.request-id {
  margin-top: 14rpx;
  color: var(--ink-3);
  font-family: monospace;
  font-size: 20rpx;
  text-align: center;
}

.baseline-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 34rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.9);
}

.baseline-primary {
  width: 100%;
  padding: 32rpx 24rpx;
  border-radius: 48rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 48rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.12);
}

.baseline-primary--disabled {
  background: var(--line);
  color: var(--ink-3);
  box-shadow: none;
}
