<view class="login-page">
  <view class="brand-lockup" aria-label="岸岸">
    <view class="brand-mark">岸</view>
    <view class="brand-name">岸岸</view>
  </view>

  <view class="login-copy">
    <view class="eyebrow">基于真实题与岗位数据的 AI 备考伙伴</view>
    <view class="hero-title">
      <view>把分差，</view>
      <view>变成<text class="hero-title__accent">今天的行动</text>。</view>
    </view>
    <view class="hero-copy">
      不承诺上岸，不制造焦虑。只按你的岗位、水平和时间，告诉你今天最该练什么。
    </view>
  </view>

  <view class="companion-stage">
    <anan-companion
      intent="companion"
      size="hero-240"
      context="home"
      label="岸岸欢迎你开始备考"
    />
  </view>

  <view class="login-actions">
    <view wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</view>
    <button
      class="wechat-button {{submitting || restoring ? 'wechat-button--disabled' : ''}}"
      loading="{{submitting || restoring}}"
      disabled="{{submitting || restoring}}"
      bindtap="login"
    >
      <view wx:if="{{!submitting && !restoring}}" class="wechat-button__content">
        <view class="wechat-icon" aria-hidden="true"></view>
        <text>微信登录</text>
      </view>
      <text wx:else>{{restoring ? '正在恢复登录…' : '正在登录…'}}</text>
    </button>
    <view class="legal">
      <text class="legal-symbol" aria-hidden="true">◇</text>
      <text>数据加密存储，可随时导出与删除</text>
    </view>
  </view>
</view>
