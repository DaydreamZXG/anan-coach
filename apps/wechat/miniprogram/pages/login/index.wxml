<view class="login-page">
  <view class="login-orb login-orb--top"></view>
  <view class="login-orb login-orb--bottom"></view>
  <safe-top mode="status" gap="{{0}}" />

  <view class="login-content">
    <view class="login-lockup fade-slide-in" aria-label="正在进入岸岸">
      <view class="brain-logo-shell">
        <image
          class="brain-logo"
          src="/assets/icons/anan/brain-outline-ink.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
        <view class="brain-logo-tint" aria-hidden="true"></view>
      </view>

      <view class="login-tagline" aria-live="polite">
        <text>{{errorMessage ? '暂时没能进入岸岸' : '正在进入岸岸'}}</text>
        <text class="login-status-copy">
          {{errorMessage || (restoring ? '正在同步你的学习档案…' : submitting ? '正在连接微信身份…' : '正在准备你的备考空间…')}}
        </text>
      </view>
    </view>

    <view wx:if="{{!errorMessage}}" class="entry-progress fade-slide-in fade-slide-in--2" aria-hidden="true">
      <view class="entry-progress__dot"></view>
      <view class="entry-progress__dot entry-progress__dot--2"></view>
      <view class="entry-progress__dot entry-progress__dot--3"></view>
    </view>

    <view wx:else class="login-actions fade-slide-in fade-slide-in--2">
      <button
        class="wechat-button {{submitting || restoring ? 'wechat-button--disabled' : ''}} tap-tactile"
        hover-class="item--hover"
        loading="{{submitting || restoring}}"
        disabled="{{submitting || restoring}}"
        bindtap="retry"
      >
        <view wx:if="{{!submitting && !restoring}}" class="wechat-button__content">
          <text>重新进入岸岸</text>
          <image
            class="arrow-icon"
            src="/assets/icons/anan/arrow-right-white.svg"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <text wx:else>正在重新连接…</text>
      </button>
    </view>
  </view>
</view>
