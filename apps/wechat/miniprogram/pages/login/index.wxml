<view class="login-page">
  <view class="login-orb login-orb--top"></view>
  <view class="login-orb login-orb--bottom"></view>
  <safe-top mode="status" gap="{{0}}" />

  <view class="login-content">
    <view class="login-lockup fade-slide-in" aria-label="岸岸备考">
      <view class="brain-logo-shell">
        <image
          class="brain-logo"
          src="/assets/icons/anan/brain-outline-ink.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
        <view class="brain-logo-tint" aria-hidden="true"></view>
      </view>

      <view class="login-tagline">
        <text>如果你暂时看不清方向，</text>
        <text>那就先把方向盘交给我</text>
      </view>
    </view>

    <view class="login-actions fade-slide-in fade-slide-in--2">
      <view wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</view>
      <button
        class="wechat-button {{submitting || restoring || !legalAccepted ? 'wechat-button--disabled' : ''}} tap-tactile"
        hover-class="item--hover"
        loading="{{submitting || restoring}}"
        disabled="{{submitting || restoring || !legalAccepted}}"
        bindtap="login"
      >
        <view wx:if="{{!submitting && !restoring}}" class="wechat-button__content">
          <text>微信一键登录</text>
          <image
            class="arrow-icon"
            src="/assets/icons/anan/arrow-right-white.svg"
            mode="aspectFit"
            aria-hidden="true"
          />
        </view>
        <text wx:else>{{restoring ? '正在找回登录…' : '正在登录…'}}</text>
      </button>
      <view class="legal">
        <checkbox-group class="legal-consent" bindchange="toggleLegalConsent">
          <label class="legal-checkbox-label" aria-label="同意用户协议与隐私保护指引">
            <checkbox class="legal-checkbox" value="accepted" checked="{{legalAccepted}}" color="#101828" />
          </label>
        </checkbox-group>
        <view class="legal-copy">
          <text>我已阅读并同意</text>
          <button hover-class="item--hover" class="legal-link" bindtap="openTerms">用户协议</button>
          <text>和</text>
          <button hover-class="item--hover" class="legal-link" bindtap="openPrivacy">隐私保护指引</button>
        </view>
      </view>
    </view>
  </view>
</view>
