.login-page {
  position: relative;
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: 124rpx 54rpx calc(44rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 8% 8%, rgba(11, 167, 144, 0.16), transparent 31%),
    radial-gradient(circle at 96% 20%, rgba(45, 127, 231, 0.16), transparent 34%),
    radial-gradient(circle at 54% 72%, rgba(107, 97, 220, 0.11), transparent 30%),
    var(--color-canvas);
  color: var(--color-ink);
  font-family: var(--font-family-ui);
}

.login-aurora {
  position: absolute;
  border-radius: 50%;
  opacity: 0.7;
  pointer-events: none;
}

.login-aurora--one {
  top: 160rpx;
  right: -180rpx;
  width: 430rpx;
  height: 430rpx;
  background: radial-gradient(circle, rgba(45, 127, 231, 0.14), transparent 68%);
}

.login-aurora--two {
  bottom: 120rpx;
  left: -190rpx;
  width: 460rpx;
  height: 460rpx;
  background: radial-gradient(circle, rgba(11, 167, 144, 0.13), transparent 68%);
}

.brand-lockup {
  position: relative;
  z-index: 1;
  display: flex;
  flex: none;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  box-sizing: border-box;
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.54);
  border-radius: 18rpx;
  background: var(--gradient-ai);
  color: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(38, 123, 174, 0.22);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1;
}

.brand-name {
  color: var(--color-ink);
  font-size: 31rpx;
  font-weight: 850;
  letter-spacing: 1rpx;
  line-height: 1.05;
}

.brand-caption {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-size: 13rpx;
  letter-spacing: 2.2rpx;
}

.login-copy {
  position: relative;
  z-index: 1;
  flex: none;
  margin-top: 68rpx;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--color-primary-deep);
  font-size: 21rpx;
  font-weight: 750;
  letter-spacing: 0.6rpx;
  line-height: 1.45;
}

.eyebrow-dot,
.ai-status__dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 0 0 7rpx var(--color-primary-a08);
}

.hero-title {
  margin-top: 24rpx;
  color: var(--color-ink);
  font-size: 59rpx;
  font-weight: 850;
  letter-spacing: -3rpx;
  line-height: 1.16;
}

.hero-title__accent {
  color: var(--color-primary);
  background: var(--gradient-ai);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-copy {
  max-width: 620rpx;
  margin-top: 26rpx;
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  line-height: 1.7;
}

.login-capabilities {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 24rpx;
}

.capability-chip {
  display: flex;
  align-items: center;
  gap: 7rpx;
  min-height: 46rpx;
  padding: 0 15rpx;
  border: 1rpx solid rgba(198, 217, 213, 0.76);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--color-ink-secondary);
  font-size: 19rpx;
  font-weight: 650;
}

.capability-chip__mark {
  color: var(--color-primary);
  font-size: 16rpx;
}

.companion-stage {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 294rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  margin: 2rpx -16rpx 0;
}

.companion-glow,
.companion-orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.companion-glow {
  width: 270rpx;
  height: 270rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0%, rgba(43, 142, 191, 0.12) 48%, transparent 72%);
}

.companion-orbit {
  border: 1rpx solid rgba(45, 127, 231, 0.14);
}

.companion-orbit--outer {
  width: 310rpx;
  height: 190rpx;
  transform: translate(-50%, -50%) rotate(-12deg);
}

.companion-orbit--inner {
  width: 225rpx;
  height: 225rpx;
  border-color: rgba(11, 167, 144, 0.18);
}

.companion-asset {
  position: relative;
  z-index: 1;
}

.ai-status {
  position: absolute;
  right: 42rpx;
  bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 17rpx;
  border: 1rpx solid rgba(198, 217, 213, 0.76);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: var(--color-ink-secondary);
  box-shadow: var(--shadow-card);
  font-size: 18rpx;
  font-weight: 700;
}

.ai-status__dot {
  width: 7rpx;
  height: 7rpx;
}

.login-actions {
  position: relative;
  z-index: 2;
  width: 638rpx;
  flex: none;
  align-self: stretch;
}

.wechat-button {
  box-sizing: border-box;
  display: flex;
  width: 638rpx !important;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--gradient-brand);
  color: #ffffff;
  box-shadow: var(--shadow-primary);
  font-family: var(--font-family-ui);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 96rpx;
}

.wechat-button::after {
  border: 0;
}

.wechat-button--disabled {
  background: #9ec9c4;
  color: rgba(255, 255, 255, 0.86);
  box-shadow: none;
}

.wechat-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.wechat-icon {
  position: relative;
  box-sizing: border-box;
  width: 23rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.wechat-icon::before {
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  box-sizing: border-box;
  width: 15rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  background: #258bd5;
  content: "";
}

.legal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin-top: 22rpx;
  color: var(--color-faint);
  font-size: 18rpx;
  line-height: 1.45;
  text-align: center;
}

.legal-symbol {
  color: var(--color-primary);
  font-size: 18rpx;
  line-height: 1;
}

.error-message {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(213, 70, 79, 0.12);
  border-radius: 16rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}

@media (min-width: 768px) {
  .login-page {
    display: grid;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: calc(64px + env(safe-area-inset-top)) 62px calc(40px + env(safe-area-inset-bottom));
    grid-template-columns: minmax(320px, 0.95fr) minmax(300px, 1.05fr);
    grid-template-rows: auto 1fr auto;
    column-gap: 64px;
  }

  .brand-lockup {
    grid-column: 1 / -1;
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    font-size: 21px;
  }

  .brand-name {
    font-size: 22px;
  }

  .brand-caption {
    font-size: 9px;
  }

  .login-copy {
    align-self: center;
    margin-top: 34px;
  }

  .eyebrow {
    font-size: 14px;
  }

  .hero-title {
    margin-top: 18px;
    font-size: 48px;
    letter-spacing: -1.6px;
  }

  .hero-copy {
    max-width: 520px;
    margin-top: 20px;
    font-size: 16px;
  }

  .capability-chip {
    min-height: 34px;
    padding: 0 12px;
    font-size: 13px;
  }

  .companion-stage {
    min-height: 470px;
    grid-column: 2;
    grid-row: 2 / 4;
    align-items: center;
    margin: 0;
  }

  .companion-glow {
    width: 350px;
    height: 350px;
  }

  .companion-orbit--outer {
    width: 410px;
    height: 250px;
  }

  .companion-orbit--inner {
    width: 300px;
    height: 300px;
  }

  .login-actions,
  .wechat-button {
    width: 100% !important;
  }

  .login-actions {
    max-width: 520px;
  }

  .wechat-button {
    min-height: 58px;
    border-radius: 18px;
    font-size: 17px;
    line-height: 58px;
  }

  .legal {
    margin-top: 14px;
    font-size: 12px;
  }
}
