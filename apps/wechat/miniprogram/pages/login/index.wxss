.login-page {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: 132rpx 56rpx calc(46rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 10% 15%, rgba(240, 195, 140, 0.35) 0, transparent 34%),
    radial-gradient(circle at 92% 22%, rgba(253, 238, 226, 0.9) 0, transparent 32%),
    var(--color-canvas);
  color: var(--color-ink);
  font-family: var(--font-family-ui);
}

.brand-lockup {
  display: flex;
  flex: none;
  align-items: center;
  gap: 16rpx;
}

.brand-mark {
  box-sizing: border-box;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-name {
  color: var(--color-primary-deep);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.login-copy {
  flex: none;
  margin-top: 80rpx;
}

.eyebrow {
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.45;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.18;
}

.hero-title__accent {
  color: var(--color-primary);
}

.hero-copy {
  max-width: 610rpx;
  margin-top: 28rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.72;
}

.companion-stage {
  display: flex;
  min-height: 340rpx;
  flex: 1;
  align-items: flex-end;
  justify-content: center;
  margin: 8rpx -20rpx 2rpx;
}

.login-actions {
  width: 638rpx;
  flex: none;
  align-self: stretch;
}

.wechat-button {
  box-sizing: border-box;
  display: flex;
  /* WeChat's native button stylesheet pins the default control to 184px. */
  width: 638rpx !important;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--color-wechat);
  color: #ffffff;
  box-shadow: 0 20rpx 44rpx rgba(7, 193, 96, 0.17);
  font-family: var(--font-family-ui);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 94rpx;
}

.wechat-button::after {
  border: 0;
}

.wechat-button--disabled {
  background: rgba(7, 193, 96, 0.4);
  color: rgba(255, 255, 255, 0.86);
}

.wechat-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.wechat-icon {
  position: relative;
  box-sizing: border-box;
  width: 23rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.wechat-icon::before {
  position: absolute;
  right: -8rpx;
  bottom: -7rpx;
  box-sizing: border-box;
  width: 15rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  background: var(--color-wechat);
  content: "";
}

.legal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin-top: 22rpx;
  color: var(--color-faint);
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
}

.legal-symbol {
  font-size: 19rpx;
  line-height: 1;
}

.error-message {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid rgba(213, 70, 79, 0.12);
  border-radius: 16rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}

@media (min-width: 768px) {
  .login-page {
    display: grid;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: calc(64px + env(safe-area-inset-top)) 56px calc(40px + env(safe-area-inset-bottom));
    grid-template-columns: minmax(320px, 0.95fr) minmax(300px, 1.05fr);
    grid-template-rows: auto 1fr auto;
    column-gap: 56px;
  }

  .brand-lockup {
    grid-column: 1 / -1;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    font-size: 21px;
  }

  .brand-name {
    font-size: 22px;
  }

  .login-copy {
    align-self: center;
    margin-top: 32px;
  }

  .eyebrow {
    font-size: 14px;
  }

  .hero-title {
    margin-top: 18px;
    font-size: 46px;
    letter-spacing: -1.5px;
  }

  .hero-copy {
    max-width: 520px;
    margin-top: 20px;
    font-size: 16px;
  }

  .companion-stage {
    min-height: 460px;
    grid-column: 2;
    grid-row: 2 / 4;
    align-items: center;
    margin: 0;
  }

  .login-actions,
  .wechat-button {
    width: 100% !important;
  }

  .login-actions {
    max-width: 520px;
  }

  .wechat-button {
    min-height: 56px;
    border-radius: 16px;
    font-size: 17px;
    line-height: 56px;
  }

  .legal {
    margin-top: 14px;
    font-size: 12px;
  }
}
