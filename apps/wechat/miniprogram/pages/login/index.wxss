.login-page {
  position: relative;
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--figma-color-canvas);
  color: var(--color-ink);
}

.login-orb {
  position: absolute;
  width: calc(700 * var(--rpx));
  height: calc(700 * var(--rpx));
  border-radius: 50%;
  filter: blur(calc(128 * var(--rpx)));
  opacity: 0.6;
  pointer-events: none;
}

.login-orb--top {
  top: calc(-169 * var(--rpx));
  right: calc(-156 * var(--rpx));
  background: var(--figma-gradient-login-halo-top);
}

.login-orb--bottom {
  bottom: calc(-169 * var(--rpx));
  left: calc(-156 * var(--rpx));
  background: var(--figma-gradient-login-halo-bottom);
}

.login-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  max-width: calc(780 * var(--rpx));
  min-height: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  margin: 0 auto;
  padding: 0 calc(64 * var(--rpx)) env(safe-area-inset-bottom);
}

.login-lockup {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.brain-logo-shell {
  position: relative;
  display: flex;
  width: calc(192 * var(--rpx));
  height: calc(192 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin-bottom: calc(64 * var(--rpx));
  overflow: hidden;
  border-radius: var(--radius-64);
  background: var(--figma-color-surface);
  box-shadow: var(--figma-shadow-card);
}

.brain-logo {
  position: relative;
  z-index: 1;
  width: calc(96 * var(--rpx));
  height: calc(96 * var(--rpx));
}

.brain-logo-tint {
  position: absolute;
  inset: 0;
  background: var(--figma-gradient-ai);
  opacity: 0.1;
}

.login-tagline {
  display: flex;
  flex-direction: column;
  margin-top: calc(32 * var(--rpx));
  color: var(--figma-color-ink);
  font-size: var(--text-display);
  font-weight: 700;
  letter-spacing: calc(-1.2 * var(--rpx));
  line-height: calc(80 * var(--rpx));
}

.login-actions {
  width: 100%;
  margin-top: calc(96 * var(--rpx));
}

.wechat-button {
  box-sizing: border-box;
  display: flex;
  width: 100% !important;
  min-height: calc(112 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 calc(40 * var(--rpx));
  border: 0;
  border-radius: var(--radius-40);
  background: var(--figma-color-ink);
  color: var(--figma-color-on-dark);
  box-shadow: var(--shadow-elevated);
  font-size: var(--text-section);
  font-weight: 600;
  line-height: calc(112 * var(--rpx));
}

.wechat-button::after {
  border: 0;
}

.wechat-button--disabled {
  background: var(--ink-3);
  box-shadow: none;
}

.wechat-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(16 * var(--rpx));
}

.arrow-icon {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

.legal {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  gap: calc(12 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
  color: var(--figma-color-faint);
  font-size: var(--text-caption);
  line-height: 1.5;
  text-align: center;
}

.legal-consent,
.legal-checkbox-label {
  display: flex;
  min-width: 44px;
  min-height: 44px;
  align-items: center;
  justify-content: center;
}

.legal-checkbox {
  transform: scale(0.86);
}

.legal-copy {
  display: flex;
  min-height: 44px;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

button.legal-link {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  margin: 0;
  padding: 0 calc(4 * var(--rpx));
  border: 0;
  background: transparent;
  color: var(--figma-color-ink);
  font: inherit;
  font-weight: 700;
  line-height: 44px;
}

button.legal-link::after {
  border: 0;
}

.error-message {
  margin-bottom: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(220, 76, 100, 0.14);
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: var(--text-micro);
  line-height: 1.5;
  text-align: center;
}

/* 平板横竖屏仍是一项连续的登录任务：品牌、说明、操作和协议共用同一中心轴。 */
@media (min-width: 600px) and (min-height: 600px) {
  .login-content {
    display: flex;
    width: 100%;
    max-width: 520px;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    padding: 40px 32px calc(40px + env(safe-area-inset-bottom));
  }

  .login-lockup {
    align-items: center;
    text-align: center;
  }

  .brain-logo-shell {
    width: 88px;
    height: 88px;
    margin-bottom: 28px;
    border-radius: 30px;
  }

  .brain-logo {
    width: 44px;
    height: 44px;
  }

  .login-tagline {
    margin-top: 18px;
    font-size: 36px;
    line-height: 1.2;
  }

  .login-actions {
    width: 100%;
    max-width: 440px;
    align-self: center;
    margin-top: 44px;
  }

  .wechat-button {
    min-height: 60px;
    border-radius: 20px;
    font-size: 17px;
    line-height: 60px;
  }

  .legal {
    margin-top: 16px;
    font-size: 12px;
  }
}
