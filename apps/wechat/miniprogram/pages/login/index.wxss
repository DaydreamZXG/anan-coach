.login-page {
  position: relative;
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: var(--figma-color-canvas);
  color: var(--color-ink);
}

.login-orb {
  position: absolute;
  width: 700rpx;
  height: 700rpx;
  border-radius: 50%;
  filter: blur(128rpx);
  opacity: 0.6;
  pointer-events: none;
}

.login-orb--top {
  top: -169rpx;
  right: -156rpx;
  background: var(--figma-gradient-login-halo-top);
}

.login-orb--bottom {
  bottom: -169rpx;
  left: -156rpx;
  background: var(--figma-gradient-login-halo-bottom);
}

.login-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  max-width: 780rpx;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  margin: 0 auto;
  padding: 0 64rpx env(safe-area-inset-bottom);
}

.login-lockup {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.brain-logo-shell {
  position: relative;
  display: flex;
  width: 192rpx;
  height: 192rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 64rpx;
  overflow: hidden;
  border-radius: 64rpx;
  background: var(--figma-color-surface);
  box-shadow: var(--figma-shadow-card);
}

.brain-logo {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
}

.brain-logo-tint {
  position: absolute;
  inset: 0;
  background: var(--figma-gradient-ai);
  opacity: 0.1;
}

.login-title {
  color: var(--figma-color-ink);
  font-size: var(--figma-font-display-compact);
  font-weight: 700;
  letter-spacing: -1.8rpx;
  line-height: 80rpx;
}

.login-subtitle {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  color: var(--figma-color-muted);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 48.75rpx;
}

.login-actions {
  width: 100%;
  margin-top: 96rpx;
}

.wechat-button {
  box-sizing: border-box;
  display: flex;
  width: 100% !important;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 36rpx;
  border: 0;
  border-radius: 40rpx;
  background: var(--figma-color-ink);
  color: var(--figma-color-on-dark);
  box-shadow: 0 20rpx 15rpx rgba(16, 24, 40, 0.2), 0 8rpx 6rpx rgba(16, 24, 40, 0.2);
  font-size: var(--figma-font-body-large);
  font-weight: 600;
  line-height: 112rpx;
}

.wechat-button::after {
  border: 0;
}

.wechat-button--disabled {
  background: var(--ink-3);
  box-shadow: none;
}

.wechat-button__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.arrow-icon {
  width: 36rpx;
  height: 36rpx;
}

.legal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 48rpx;
  color: var(--figma-color-faint);
  font-size: var(--figma-font-caption);
  line-height: 1.5;
  text-align: center;
}

.legal-check {
  width: 28rpx;
  height: 28rpx;
}

.error-message {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(220, 76, 100, 0.14);
  border-radius: 20rpx;
  background: var(--color-danger-soft);
  color: var(--color-danger);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

@media (min-width: 768px) {
  .login-content {
    max-width: 560px;
    min-height: calc(100vh - 96px);
    padding: 36px 52px calc(36px + env(safe-area-inset-bottom));
  }

  .brain-logo-shell {
    width: 96px;
    height: 96px;
    margin-bottom: 32px;
    border-radius: 32px;
  }

  .brain-logo {
    width: 48px;
    height: 48px;
  }

  .login-title {
    font-size: 42px;
  }

  .login-subtitle {
    margin-top: 14px;
    font-size: 17px;
  }

  .login-actions {
    margin-top: 54px;
  }

  .wechat-button {
    min-height: 60px;
    border-radius: 20px;
    font-size: 17px;
    line-height: 60px;
  }

  .legal {
    margin-top: 20px;
    font-size: 12px;
  }
}
