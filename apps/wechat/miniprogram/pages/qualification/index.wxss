.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.ql-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.ql-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.ql-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.ql-loading { padding: 120rpx 0; text-align: center; }

.ql-head { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 8rpx; border-left: 6rpx solid #b45309; }
.ql-head.is-ok { border-left-color: var(--good); }

.ql-section { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-3); padding: 28rpx 8rpx 16rpx; }

.ql-gap { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 16rpx; }
.ql-gap-main { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.ql-gap-head { display: flex; align-items: center; gap: 16rpx; }
.ql-gap-fact { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.ql-gap-type {
  font-size: 22rpx; color: #b45309; background: #fef3e2;
  border-radius: 999rpx; padding: 4rpx 16rpx;
}
.ql-gap-cta { font-size: 26rpx; color: var(--primary); flex-shrink: 0; }
.demo-tip { text-align: center; padding: 16rpx 0; }
