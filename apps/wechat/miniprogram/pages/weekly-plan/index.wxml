<view class="page wp">
  <safe-top />
  <view class="wp-nav">
    <text class="wp-back" bindtap="onBack">‹</text>
    <text class="wp-title">本周节奏</text>
  </view>

  <view wx:if="{{loading}}" class="wp-loading text-2">正在取本周安排…</view>

  <scroll-view wx:else class="wp-body" scroll-y>
    <view class="card wp-head">
      <text class="h2">{{weekLabel}}</text>
      <text class="text-3">{{rhythmLine}}</text>
    </view>

    <view
      class="card wp-day {{item.isToday ? 'is-today' : ''}} {{item.status === 'past' ? 'is-past' : ''}}"
      wx:for="{{days}}"
      wx:key="localDate"
      data-status="{{item.status}}"
      bindtap="onTapDay"
    >
      <view class="wp-day-side">
        <text class="wp-weekday">周{{item.dayLabel}}</text>
        <text class="text-3 num">{{item.dateLabel}}</text>
      </view>
      <view class="wp-day-main">
        <view class="wp-day-head">
          <text class="wp-mode {{item.modeClass}}">{{item.modeLabel}}</text>
          <text class="text-3 num" wx:if="{{item.minutes > 0}}">{{item.minutes}} 分钟</text>
          <text class="text-3 num" wx:if="{{item.progressLabel !== '-'}}">完成 {{item.progressLabel}}</text>
          <text class="wp-today-chip" wx:if="{{item.isToday}}">今天</text>
        </view>
        <text class="wp-explain">{{item.explanation}}</text>
      </view>
    </view>

    <text class="text-3 wp-note">周计划由后端根据你的偏好和进度每周重排。改学习偏好或当日减量后，这里会跟着变。</text>
    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示数据（后端未连接）</view>
  </scroll-view>
</view>
