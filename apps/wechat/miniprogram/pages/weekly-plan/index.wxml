<view class="brain-page">
  <view class="brain-hero"><view class="brain-kicker">周计划 · 5+1+1</view><view class="brain-title">这一周，只追三个能验证的变化</view><view class="brain-copy">目标、任务、复盘和机动时间被放在同一张周计划里。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="周计划没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{week}}">
    <view class="brain-card"><view class="brain-row"><view><view class="brain-label">周计划版本</view><view class="brain-value">v{{week.versionNo}} · {{week.rhythm}}</view></view><view class="brain-pill">{{week.weekStart}}</view></view><view class="brain-note">变更原因：{{reasonLabel}}</view></view>
    <view wx:for="{{days}}" wx:key="localDate" class="brain-card day-card day-card--{{item.mode}} {{item.status === 'today' ? 'day-card--today' : ''}}">
      <view class="brain-row"><view class="day-date"><view class="brain-row-title">{{item.weekdayLabel}} · {{item.localDate}}</view><view class="brain-row-copy">{{item.explanation}}</view></view><view class="brain-pill">{{item.modeLabel}}</view></view>
      <view class="day-progress"><view class="day-progress__item"><text>预算</text><text class="day-progress__value type-data">{{item.plannedMinutes}} 分</text></view><view class="day-progress__item"><text>已排</text><text class="day-progress__value type-data">{{item.scheduledMinutes}} 分</text></view><view class="day-progress__item"><text>闭环</text><text class="day-progress__value type-data">{{item.completedTaskCount}}/{{item.totalTaskCount}}</text></view></view>
    </view>
    <view class="brain-warning">未完成任务不会跨日复制；新的一天重新计算最有价值的 1–3 项。</view>
  </block>
</view>
