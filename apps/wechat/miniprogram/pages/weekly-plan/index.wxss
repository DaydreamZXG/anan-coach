.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

/* ── 顶部导航 ── */
.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
  flex-shrink: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 深空摘要 ── */
.summary {
  margin: 8rpx 32rpx 32rpx;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.summary__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary__version {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
}

.summary__week {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

.summary__reason {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.7;
}

/* ── 区块标题外边距（全局类只定义了排版） ── */
.section-head {
  margin: 0 32rpx 24rpx;
}

/* ── 日卡 ── */
.day {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.day--today {
  border: 1rpx solid rgba(91, 95, 244, 0.45);
  box-shadow: 0 8rpx 30rpx rgba(91, 95, 244, 0.14);
}

.day__row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.day__main {
  flex: 1;
  min-width: 0;
}

.day__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day__today {
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--grad-main);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.day__copy {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.day__pill {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: var(--indigo);
  background: rgba(91, 95, 244, 0.09);
}

.day__pill--mock {
  color: var(--violet);
  background: rgba(139, 92, 246, 0.1);
}

.day__pill--recovery {
  color: var(--green);
  background: rgba(13, 159, 110, 0.1);
}

.day__metrics {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.day__metric {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  background: #f4f5fb;
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
}

.day__k {
  font-size: 20rpx;
  color: var(--ink-3);
}

.day__v {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

/* ── 底部提示 ── */
.notice {
  margin: 28rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--amber);
  background: rgba(217, 127, 6, 0.08);
  border: 1rpx solid rgba(217, 127, 6, 0.28);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  line-height: 1.7;
}
