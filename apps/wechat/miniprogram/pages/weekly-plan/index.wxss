.week-page {
  box-sizing: border-box;
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 4%, rgba(199, 210, 254, 0.34), transparent 26%),
    #f7f9fc;
  color: #111827;
}

.week-nav {
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
  padding: 0 34rpx 16rpx;
}

.week-back {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
}

.week-back::after,
.day-trigger::after,
.week-action::after {
  border: 0;
}

.week-back__icon {
  position: absolute;
  top: 21rpx;
  left: 24rpx;
  width: 19rpx;
  height: 19rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid #111827;
  border-left: 4rpx solid #111827;
}

.week-nav__title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 760;
}

.week-content {
  box-sizing: border-box;
  padding: 28rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
}

.week-kicker {
  display: inline-flex;
  padding: 9rpx 16rpx;
  border-radius: 13rpx;
  background: #eef2ff;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 750;
}

.week-title {
  max-width: 650rpx;
  margin-top: 28rpx;
  font-size: 50rpx;
  font-weight: 780;
  letter-spacing: -1.8rpx;
  line-height: 1.28;
}

.week-copy {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.65;
}

.week-summary {
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr 1rpx 1fr;
  align-items: center;
  margin-top: 40rpx;
  padding: 27rpx 16rpx;
  border: 1rpx solid #f0f2f6;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(17, 24, 39, 0.035);
}

.summary-metric {
  min-width: 0;
  text-align: center;
}

.summary-label {
  color: #9ca3af;
  font-size: 18rpx;
}

.summary-value {
  margin-top: 7rpx;
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-divider {
  width: 1rpx;
  height: 44rpx;
  background: #eef0f4;
}

.week-basis {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e0e7ff;
  border-radius: 28rpx;
  background: rgba(238, 242, 255, 0.68);
}

.basis-mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 20rpx;
}

.basis-title {
  font-size: 22rpx;
  font-weight: 760;
}

.basis-copy {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 20rpx;
  line-height: 1.55;
}

.schedule-heading {
  margin: 40rpx 4rpx 17rpx;
  font-size: 28rpx;
  font-weight: 760;
}

.schedule-card {
  overflow: hidden;
  border: 1rpx solid #f0f2f6;
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 36rpx rgba(17, 24, 39, 0.035);
}

.day-row {
  padding: 0 16rpx;
}

.day-row + .day-row {
  border-top: 1rpx solid #f3f4f6;
}

.day-row--today {
  background: #f8f8ff;
}

.day-trigger {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 0 14rpx;
  border: 0;
  background: transparent;
  color: #111827;
  text-align: left;
}

.day-trigger__main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-name {
  font-size: 24rpx;
  font-weight: 740;
}

.today-tag,
.day-status {
  padding: 6rpx 11rpx;
  border-radius: 10rpx;
  background: #eef2ff;
  color: var(--color-primary);
  font-size: 17rpx;
  font-weight: 700;
}

.day-status {
  background: #f5f6f8;
  color: #9ca3af;
}

.day-chevron {
  width: 13rpx;
  height: 13rpx;
  transform: rotate(45deg);
  border-right: 2rpx solid #9ca3af;
  border-bottom: 2rpx solid #9ca3af;
}

.day-chevron--open {
  transform: rotate(225deg);
}

.day-detail {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  padding: 0 14rpx 28rpx;
}

.day-detail__label {
  color: #9ca3af;
  font-size: 18rpx;
}

.day-detail__value {
  margin-top: 8rpx;
  font-size: 21rpx;
  font-weight: 740;
}

.day-detail__reason {
  grid-column: 1 / -1;
  padding: 17rpx 18rpx;
  border-radius: 18rpx;
  background: #f7f9fc;
  color: #6b7280;
  font-size: 20rpx;
  line-height: 1.55;
}

.week-note {
  margin: 22rpx 10rpx 0;
  color: #9ca3af;
  font-size: 19rpx;
  line-height: 1.6;
  text-align: center;
}

.week-action {
  width: 100%;
  min-height: 94rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: 28rpx;
  background: #111827;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 94rpx;
  box-shadow: 0 12rpx 28rpx rgba(17, 24, 39, 0.12);
}

.week-action--secondary {
  border: 1rpx solid #dfe3eb;
  background: #ffffff;
  color: var(--color-primary);
  box-shadow: none;
}

.week-action--secondary + .week-action {
  margin-top: 16rpx;
}

@media (min-width: 768px) {
  .week-page {
    width: 100%;
  }

  .week-content {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 52px 58px;
  }

  .week-title {
    font-size: 38px;
  }

  .schedule-card {
    border-radius: 28px;
  }
}
