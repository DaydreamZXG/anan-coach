/* 周计划：骨架、卡片与操作坞来自 s9；保留七日折叠表、
 * 建议卡与周计划专属按钮。 */

.inline-action::after,
.day-trigger::after,
.adjustment-card__action::after,
.week-companion::after {
  border: 0;
}

.week-chip--active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.section-heading {
  display: flex;
  align-items: center;
  gap: var(--figma-space-8);
  margin-bottom: calc(20 * var(--rpx));
  padding-left: var(--figma-space-4);
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.5 * var(--rpx));
}

.section-heading__mark {
  display: flex;
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
  align-items: center;
  justify-content: center;
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 800;
}

button.inline-action {
  display: inline-flex;
  width: auto;
  align-items: center;
  justify-content: center;
  min-height: calc(64 * var(--rpx));
  margin: var(--figma-space-16) 0 0;
  padding: 0 var(--figma-space-16);
  border: 0;
  border-radius: var(--figma-radius-small);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(64 * var(--rpx));
}

.schedule-card {
  overflow: hidden;
  padding: var(--figma-space-8);
}

.day-row {
  border-radius: var(--figma-radius-control);
}

.day-row--today {
  background: var(--color-canvas);
}

button.day-trigger {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(92 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: var(--figma-space-12) var(--figma-space-16);
  border: 0;
  border-radius: var(--figma-radius-control);
  background: none;
  color: var(--color-ink);
  text-align: left;
}

.day-trigger__main {
  display: flex;
  align-items: center;
  gap: var(--figma-space-12);
}

.day-name {
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.day-status {
  padding: var(--figma-space-4) var(--figma-space-8);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-caption);
  font-weight: 600;
}

.day-status--today {
  background: var(--color-primary-soft);
  color: var(--color-muted);
}

.day-status--past {
  color: var(--color-faint);
}

.day-status--recovery {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.day-chevron {
  width: calc(13 * var(--rpx));
  height: calc(13 * var(--rpx));
  transform: rotate(45deg);
  border-right: calc(2 * var(--rpx)) solid var(--color-faint);
  border-bottom: calc(2 * var(--rpx)) solid var(--color-faint);
}

.day-chevron--open {
  transform: rotate(225deg);
}

.day-detail {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: var(--figma-space-16);
  padding: var(--figma-space-4) var(--figma-space-16) var(--figma-space-16);
}

.day-detail__metric {
  min-width: 0;
}

.day-detail__label {
  color: var(--color-faint);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.day-detail__value {
  margin-top: var(--figma-space-4);
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-detail__metric--focus .day-detail__value {
  white-space: normal;
}

.day-detail__note {
  grid-column: 1 / -1;
  padding: var(--figma-space-10) var(--figma-space-12);
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.adjustment-card {
  border-color: var(--color-primary-soft-strong);
  background: var(--color-primary-soft);
}

.adjustment-card__head {
  display: flex;
  gap: var(--figma-space-10);
}

.adjustment-card__mark {
  flex: none;
  color: var(--color-muted);
  font-size: var(--text-body-lg);
  line-height: 1.4;
}

.adjustment-card__body {
  min-width: 0;
}

.adjustment-card__title {
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.adjustment-card__copy {
  margin-top: var(--figma-space-4);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.65;
}

button.adjustment-card__action {
  width: 100%;
  min-height: calc(76 * var(--rpx));
  margin: var(--figma-space-12) 0 0;
  border: 0;
  border-radius: var(--figma-radius-small);
  background: var(--color-ink);
  color: var(--color-on-primary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(76 * var(--rpx));
}

button.week-primary {
  width: 100%;
}

button.week-companion {
  width: 100%;
  min-height: calc(60 * var(--rpx));
  margin: calc(12 * var(--rpx)) 0 0;
  border: 0;
  background: none;
  color: var(--color-primary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(60 * var(--rpx));
  text-align: center;
}

/* 平板宽屏（排版总纲主辅模板）：七日安排主列 | 周目标与调整建议辅列。 */
@media (min-width: 1024px) {
  .week-content {
    display: grid;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
    column-gap: 24px;
    grid-template-columns: minmax(0, 1fr) 340px;
  }

  .week-content > view {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .week-content .week-sec-days {
    grid-column: 1;
    grid-row: 2 / span 2;
  }

  .week-content .week-sec-goal {
    grid-column: 2;
    grid-row: 2;
  }

  .week-content .week-sec-adjust {
    grid-column: 2;
    grid-row: 3;
  }
}
