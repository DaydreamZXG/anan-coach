.week-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-canvas);
  color: var(--color-ink);
}

.week-nav {
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  min-height: 72rpx;
  margin: 0 auto;
  padding: 0 var(--space-page-x);
}

button.week-back {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  box-shadow: var(--figma-shadow-surface);
}

.week-back::after,
.inline-action::after,
.day-trigger::after,
.adjustment-card__action::after,
.week-primary::after,
.week-companion::after {
  border: 0;
}

.week-back__icon {
  position: absolute;
  top: 18rpx;
  left: 21rpx;
  width: 16rpx;
  height: 16rpx;
  transform: rotate(45deg);
  border-bottom: 3rpx solid var(--color-ink);
  border-left: 3rpx solid var(--color-ink);
}

.week-content {
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: var(--figma-space-48) var(--space-page-x)
    calc(230rpx + env(safe-area-inset-bottom));
}

.week-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--figma-space-8);
}

.week-chip {
  padding: var(--figma-space-8) var(--figma-space-10);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--figma-font-caption);
  font-weight: 600;
  line-height: 1.5;
}

.week-chip--active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.week-title {
  margin-top: var(--figma-space-16);
  font-size: var(--figma-font-hero-title);
  font-weight: 760;
  letter-spacing: -1rpx;
  line-height: 1.3;
}

.week-copy {
  margin-top: var(--figma-space-12);
  color: var(--color-muted);
  font-size: var(--figma-font-body-compact);
  line-height: 1.65;
}

.week-section {
  margin-top: var(--figma-space-32);
}

.section-heading {
  display: flex;
  align-items: center;
  gap: var(--figma-space-8);
  padding-left: var(--figma-space-4);
  font-size: var(--figma-font-body-large);
  font-weight: 760;
  letter-spacing: -0.5rpx;
}

.section-heading__mark {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-ink);
  font-size: var(--figma-font-caption);
  font-weight: 800;
}

.goal-card,
.schedule-card {
  box-sizing: border-box;
  margin-top: var(--figma-space-16);
  border-radius: var(--figma-radius-card-medium);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.goal-card--empty {
  padding: var(--figma-space-24);
}

.empty-title {
  font-size: var(--figma-font-body);
  font-weight: 720;
  line-height: 1.5;
}

.empty-copy {
  margin-top: var(--figma-space-8);
  color: var(--color-muted);
  font-size: var(--figma-font-body-compact);
  line-height: 1.65;
}

button.inline-action {
  display: inline-flex;
  width: auto;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  margin: var(--figma-space-16) 0 0;
  padding: 0 var(--figma-space-16);
  border: 0;
  border-radius: var(--figma-radius-small);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--figma-font-caption);
  font-weight: 700;
  line-height: 64rpx;
}

.schedule-card {
  overflow: hidden;
  padding: var(--figma-space-8);
}

.day-row {
  border-radius: var(--figma-radius-control);
}

.day-row--today {
  background: var(--color-canvas);
}

button.day-trigger {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: var(--figma-space-12) var(--figma-space-16);
  border: 0;
  border-radius: var(--figma-radius-control);
  background: none;
  color: var(--color-ink);
  text-align: left;
}

.day-trigger__main {
  display: flex;
  align-items: center;
  gap: var(--figma-space-12);
}

.day-name {
  font-size: var(--figma-font-body);
  font-weight: 720;
}

.day-status {
  padding: var(--figma-space-4) var(--figma-space-8);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--figma-font-caption);
  font-weight: 600;
}

.day-status--today {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.day-status--past {
  color: var(--color-faint);
}

.day-status--recovery {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.day-chevron {
  width: 13rpx;
  height: 13rpx;
  transform: rotate(45deg);
  border-right: 2rpx solid var(--color-faint);
  border-bottom: 2rpx solid var(--color-faint);
}

.day-chevron--open {
  transform: rotate(225deg);
}

.day-detail {
  display: grid;
  grid-template-columns: 1fr 1fr 2fr;
  gap: var(--figma-space-16);
  padding: var(--figma-space-4) var(--figma-space-16) var(--figma-space-16);
}

.day-detail__metric {
  min-width: 0;
}

.day-detail__label {
  color: var(--color-faint);
  font-size: var(--figma-font-caption);
  line-height: 1.5;
}

.day-detail__value {
  margin-top: var(--figma-space-4);
  overflow: hidden;
  color: var(--color-ink);
  font-size: var(--figma-font-caption);
  font-weight: 700;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.day-detail__metric--focus .day-detail__value {
  white-space: normal;
}

.day-detail__note {
  grid-column: 1 / -1;
  padding: var(--figma-space-10) var(--figma-space-12);
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--figma-font-caption);
  line-height: 1.5;
}

.adjustment-card {
  box-sizing: border-box;
  margin-top: var(--figma-space-32);
  padding: var(--figma-space-20);
  border: 1rpx solid var(--figma-color-primary-soft-strong);
  border-radius: var(--figma-radius-card);
  background: var(--color-primary-soft);
}

.adjustment-card__head {
  display: flex;
  gap: var(--figma-space-10);
}

.adjustment-card__mark {
  flex: none;
  color: var(--color-primary);
  font-size: var(--figma-font-body);
  line-height: 1.4;
}

.adjustment-card__body {
  min-width: 0;
}

.adjustment-card__title {
  font-size: var(--figma-font-body);
  font-weight: 720;
}

.adjustment-card__copy {
  margin-top: var(--figma-space-4);
  color: var(--color-ink-tertiary, var(--color-ink-secondary));
  font-size: var(--figma-font-body-compact);
  line-height: 1.65;
}

button.adjustment-card__action {
  width: 100%;
  min-height: 76rpx;
  margin: var(--figma-space-12) 0 0;
  border: 0;
  border-radius: var(--figma-radius-small);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--figma-font-body-compact);
  font-weight: 720;
  line-height: 76rpx;
}

.week-dock {
  position: fixed;
  z-index: var(--z-footer);
  right: 0;
  bottom: 0;
  left: 0;
  border-top: 1rpx solid var(--color-line);
  background: var(--color-surface);
}

.week-dock__inner {
  box-sizing: border-box;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: var(--figma-space-16) var(--space-page-x)
    calc(var(--figma-space-20) + env(safe-area-inset-bottom));
}

button.week-primary,
button.week-companion {
  width: 100%;
  margin: 0;
  border: 0;
  font-weight: 720;
  text-align: center;
}

button.week-primary {
  min-height: 96rpx;
  border-radius: var(--figma-radius-card);
  background: var(--color-action);
  color: var(--color-on-primary);
  font-size: var(--figma-font-body);
  line-height: 96rpx;
  box-shadow: var(--figma-shadow-elevated);
}

button.week-companion {
  min-height: 60rpx;
  background: none;
  color: var(--color-primary);
  font-size: var(--figma-font-body-compact);
  line-height: 60rpx;
}

@media (min-width: 768px) {
  .week-content {
    padding-top: var(--figma-space-32);
  }

  .week-title {
    font-size: var(--figma-font-page-title);
  }
}
