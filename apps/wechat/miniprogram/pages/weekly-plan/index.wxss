.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.wp { display: flex; flex-direction: column; min-height: 100vh; }
.wp-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.wp-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.wp-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.wp-loading { padding: 120rpx 0; text-align: center; }
.wp-body { flex: 1; min-height: 0; }

.wp-head { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }

.wp-day { display: flex; gap: 24rpx; margin-bottom: 16rpx; }
.wp-day.is-today { border: 2rpx solid var(--primary); }
.wp-day.is-past { opacity: 0.62; }
.wp-day-side { display: flex; flex-direction: column; align-items: center; gap: 4rpx; width: 88rpx; flex-shrink: 0; }
.wp-weekday { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.wp-day-main { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.wp-day-head { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.wp-mode {
  font-size: 22rpx; border-radius: 999rpx; padding: 4rpx 18rpx;
  color: var(--ink-3); background: var(--bg);
}
.wp-mode.is-training { color: var(--primary); background: var(--primary-soft); }
.wp-mode.is-mock { color: #b45309; background: #fef3e2; }
.wp-mode.is-recovery { color: var(--good); background: var(--good-soft); }
.wp-today-chip {
  font-size: 22rpx; color: #fff; background: var(--primary);
  border-radius: 999rpx; padding: 4rpx 16rpx;
}
.wp-explain { font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }

.wp-note { display: block; padding: 8rpx 8rpx 24rpx; line-height: 1.7; }
.demo-tip { text-align: center; padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx); }
