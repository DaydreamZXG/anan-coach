<view class="page community-page">
  <view class="community-hero">
    <view class="hero-kicker">社区方法试用</view>
    <view class="hero-title">先小范围验证，再决定是否公开</view>
    <view class="hero-copy">同类考生试用后只回传结构化结果，不交换原题和个人资料。</view>
    <view class="privacy-strip">
      <view class="privacy-dot"></view>
      <view>效果只按当前版本、合格曝光、独立新题与延时验证计算；后续编辑不会继承旧版本成绩。</view>
    </view>
  </view>

  <state-view
    wx:if="{{pageState !== 'default'}}"
    custom-class="community-state-view"
    state="{{pageState}}"
    title="{{stateTitle}}"
    description="{{stateDescription}}"
    action-text="{{stateActionLabel}}"
    request-id="{{requestId}}"
    bind:action="stateAction"
  />

  <block wx:if="{{pageState === 'default' || pageState === 'partial'}}">
    <scroll-view wx:if="{{cards.length > 1}}" class="card-tabs" scroll-x enhanced>
      <view class="card-tabs-inner">
        <view
          wx:for="{{cards}}"
          wx:key="cardVersionId"
          class="card-tab {{activeIndex === index ? 'card-tab--active' : ''}}"
          data-index="{{index}}"
          bindtap="selectCard"
        >{{index + 1}}</view>
      </view>
    </scroll-view>

    <view wx:if="{{selectedCard}}" class="community-card trial-card">
      <view class="version-pill">版本证据 · {{selectedCard.cardVersionId}}</view>
      <view class="section-title">{{selectedCard.title}}</view>
      <view class="section-copy">{{selectedCard.recognition}}</view>
      <view class="tag-line">{{selectedCard.applicabilityLabel}}</view>
      <view class="evidence-line">{{selectedCard.evidenceLabel}}</view>
      <view class="risk-line">{{selectedCard.riskLabel}}</view>

      <view class="detail-title">方法步骤</view>
      <view wx:for="{{selectedCard.methodSteps}}" wx:key="index" class="method-step">
        <text class="step-index">{{index + 1}}</text><text>{{item}}</text>
      </view>
      <view wx:if="{{selectedCard.exclusions.length}}" class="detail-title">不适用</view>
      <view wx:for="{{selectedCard.exclusions}}" wx:key="index" class="boundary-item">— {{item}}</view>
      <view wx:if="{{selectedCard.pitfalls.length}}" class="detail-title">容易踩坑</view>
      <view wx:for="{{selectedCard.pitfalls}}" wx:key="index" class="boundary-item">— {{item}}</view>

      <view wx:if="{{!selectedCard.canTrial}}" class="warning-note">这是你的方法卡。作者不能试用、投票或制造自己的效果证据。</view>
      <button wx:if="{{!exposureId}}" class="action-button {{interactionLocked || !selectedCard.canTrial ? 'action-button--disabled' : ''}}" disabled="{{interactionLocked || !selectedCard.canTrial}}" bindtap="optIn">主动加入这一版本试用</button>
      <button wx:elif="{{!trialId}}" class="action-button {{interactionLocked || !evidenceReady ? 'action-button--disabled' : ''}}" disabled="{{interactionLocked || !evidenceReady}}" bindtap="completeTrial">核验独立新题结果</button>
      <view wx:if="{{trialMessage}}" class="{{feedbackEligible ? 'success-note' : 'boundary-note'}}">{{trialMessage}}</view>
    </view>

    <view wx:if="{{feedbackEligible}}" class="community-section">
      <view class="section-label">固定反馈</view>
      <view class="section-title">每位用户对每个版本仅一次</view>
      <view class="fixed-actions">
        <button class="action-button {{feedbackVote === 'helpful' ? '' : 'secondary-button'}}" data-value="helpful" bindtap="chooseVote">有帮助</button>
        <button class="action-button {{feedbackVote === 'not_helpful' ? '' : 'secondary-button'}}" data-value="not_helpful" bindtap="chooseVote">没帮助</button>
      </view>
      <view class="reason-grid">
        <view
          wx:for="{{activeFeedbackReasons}}"
          wx:key="value"
          class="reason-chip {{feedbackReason === item.value ? 'reason-chip--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="chooseFeedbackReason"
        >{{item.label}}</view>
      </view>
      <view class="boundary-note">没有自由评论、聊天或外链入口。平台只接收固定选项与版本化证据。</view>
      <button class="action-button {{interactionLocked || feedbackRecorded ? 'action-button--disabled' : ''}}" disabled="{{interactionLocked || feedbackRecorded}}" bindtap="submitFeedback">{{feedbackRecorded ? '反馈已记录' : '提交固定反馈'}}</button>
    </view>

    <view wx:if="{{exposureId}}" class="community-section">
      <view class="section-label">问题举报</view>
      <view class="section-title">只提交固定分类与已有证据</view>
      <view class="reason-grid">
        <view
          wx:for="{{reportCategories}}"
          wx:key="value"
          class="reason-chip {{reportCategory === item.value ? 'reason-chip--danger' : ''}}"
          data-value="{{item.value}}"
          bindtap="chooseReportCategory"
        >{{item.label}}</view>
      </view>
      <button class="action-button danger-button {{interactionLocked ? 'action-button--disabled' : ''}}" disabled="{{interactionLocked}}" bindtap="submitReport">提交举报</button>
      <view wx:if="{{reportMessage}}" class="success-note">{{reportMessage}}</view>
    </view>
  </block>
</view>
