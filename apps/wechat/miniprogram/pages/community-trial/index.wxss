@import "../../features/community-method-cards/page-shell.wxss";

.card-tabs {
  margin-top: 22rpx;
  white-space: nowrap;
}

.card-tabs-inner {
  display: inline-flex;
  gap: 12rpx;
}

.card-tab {
  display: inline-flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--color-surface);
  color: var(--color-muted);
  font-family: var(--font-family-data);
}

.card-tab--active {
  background: var(--color-primary);
  color: #fff;
}

.version-pill {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-family: var(--font-family-data);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-line,
.evidence-line,
.risk-line {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.tag-line {
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}

.evidence-line {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.risk-line {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.detail-title {
  margin-top: 24rpx;
  color: var(--color-ink);
  font-size: 23rpx;
  font-weight: 800;
}

.method-step {
  display: grid;
  grid-template-columns: 46rpx 1fr;
  gap: 10rpx;
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.step-index {
  color: var(--color-primary);
  font-family: var(--font-family-data);
  font-weight: 800;
}

.boundary-item {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.reason-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.reason-chip {
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: 20rpx;
}

.reason-chip--active {
  border-color: rgba(0, 151, 139, 0.4);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.reason-chip--danger {
  border-color: rgba(200, 63, 86, 0.28);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
