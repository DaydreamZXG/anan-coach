@import "../../features/community-method-cards/page-shell.wxss";

.card-tabs {
  margin-top: calc(24 * var(--rpx));
  white-space: nowrap;
}

.card-tabs-inner {
  display: inline-flex;
  gap: calc(12 * var(--rpx));
}

.card-tab {
  display: inline-flex;
  width: calc(62 * var(--rpx));
  height: calc(62 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-16);
  background: var(--color-surface);
  color: var(--color-muted);
  font-family: var(--font-family-data);
}

.card-tab--active {
  background: var(--color-primary);
  color: var(--color-surface);
}

.version-pill {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  padding: calc(8 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-line,
.evidence-line,
.risk-line {
  margin-top: calc(16 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-16);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.tag-line {
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}

.evidence-line {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.risk-line {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.detail-title {
  margin-top: calc(24 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 800;
}

.method-step {
  display: grid;
  grid-template-columns: calc(46 * var(--rpx)) 1fr;
  gap: calc(12 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.step-index {
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-weight: 800;
}

.boundary-item {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.reason-grid {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.reason-chip {
  padding: calc(16 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.reason-chip--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.reason-chip--danger {
  border-color: rgba(213, 70, 79, 0.28);
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
