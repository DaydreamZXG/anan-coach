.terms-page {
  padding-bottom: calc(96 * var(--rpx));
}

.terms-hero {
  padding: calc(28 * var(--rpx)) calc(4 * var(--rpx)) calc(20 * var(--rpx));
}

.terms-title {
  max-width: calc(640 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-title-lg);
  font-weight: 800;
  line-height: 1.2;
}

.terms-copy {
  max-width: calc(650 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.72;
}

.terms-stack {
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
}

.terms-card .s9-card-copy {
  line-height: 1.75;
}
