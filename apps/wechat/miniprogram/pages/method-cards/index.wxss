.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.cards-head { margin-bottom: 24rpx; }
.page-title { display: block; margin: 8rpx 0 8rpx; }

.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.tab {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}
.tab-on { background: var(--primary); color: #fff; border-color: var(--primary); }

.mc-card { margin-bottom: 24rpx; }
.mc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}
.mc-title { flex: 1; }
.mc-score {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  background: var(--good-soft);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.mc-score-num { font-size: 34rpx; font-weight: 700; color: var(--good); }
.mc-score-unit { font-size: 22rpx; color: var(--good); }
.mc-score-low { background: #fdf0e6; }
.mc-score-low .mc-score-num, .mc-score-low .mc-score-unit { color: #c98a3f; }

.mc-recognition { display: block; line-height: 1.5; margin-bottom: 16rpx; }
.mc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; }
.mc-evidence { color: var(--primary); }
.mc-flag { color: #c98a3f; }
.mc-tag {
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--bg);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.mc-section { margin-top: 24rpx; }
.mc-section-title { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-2); margin-bottom: 12rpx; }
.mc-step { display: flex; gap: 14rpx; margin-bottom: 12rpx; }
.mc-step-idx {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mc-step-text { flex: 1; font-size: 28rpx; line-height: 1.5; color: var(--ink); }
.mc-pitfall { display: block; font-size: 27rpx; color: var(--ink-2); line-height: 1.6; }
.mc-save { width: 100%; margin-top: 24rpx; }
.mc-expand { display: block; margin-top: 16rpx; color: var(--primary); }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--primary);
  color: #fff;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 108, 176, 0.3);
}
.fab-plus { font-size: 40rpx; line-height: 1; }
.fab-text { font-size: 28rpx; font-weight: 600; }

.demo-tip { text-align: center; margin-top: 24rpx; }
.skeleton-card { height: 220rpx; border-radius: var(--radius); background: #eef0f3; margin-bottom: 24rpx; }
