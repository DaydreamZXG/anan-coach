<view class="page cards">
  <view class="statusbar" />
  <view class="cards-head">
    <text class="page-title h1">知识卡广场</text>
    <text class="text-2">考友们验证过的方法，收藏后能被你的计划引用</text>
  </view>

  <!-- 赛道切换 -->
  <view class="tabs">
    <view
      wx:for="{{tracks}}"
      wx:key="key"
      class="tab {{activeTrack === item.key ? 'tab-on' : ''}}"
      data-track="{{item.key}}"
      bindtap="onSwitchTrack"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="skeleton-card" />
    <view class="skeleton-card" />
  </block>

  <block wx:else>
    <view
      wx:for="{{cards}}"
      wx:key="cardVersionId"
      class="mc-card card"
      data-idx="{{index}}"
      bindtap="onToggle"
    >
      <view class="mc-head">
        <text class="mc-title h2">{{item.title}}</text>
        <view class="mc-score {{item.shaky ? 'mc-score-low' : ''}}">
          <text class="mc-score-num num">{{item.scorePct}}</text>
          <text class="mc-score-unit">分</text>
        </view>
      </view>
      <text class="mc-recognition text-2">{{item.recognition}}</text>

      <view class="mc-meta">
        <text class="mc-evidence text-3">{{item.evidenceCount}} 人验证</text>
        <text wx:if="{{item.shaky}}" class="mc-flag text-3">样本较少</text>
        <text
          wx:for="{{item.applicability}}"
          wx:for-item="tag"
          wx:key="*this"
          class="mc-tag"
        >{{tag}}</text>
      </view>

      <!-- 展开区 -->
      <block wx:if="{{item.expanded}}">
        <view class="mc-section">
          <text class="mc-section-title">方法步骤</text>
          <view wx:for="{{item.methodSteps}}" wx:for-item="step" wx:key="*this" class="mc-step">
            <text class="mc-step-idx num">{{index + 1}}</text>
            <text class="mc-step-text">{{step}}</text>
          </view>
        </view>
        <view wx:if="{{item.pitfalls.length}}" class="mc-section">
          <text class="mc-section-title">常见坑</text>
          <text wx:for="{{item.pitfalls}}" wx:for-item="p" wx:key="*this" class="mc-pitfall">· {{p}}</text>
        </view>
        <button class="btn btn-primary mc-save" catchtap="onSave">收藏，让计划用起来</button>
      </block>
      <text wx:else class="mc-expand text-3">点击展开方法步骤 ›</text>
    </view>

    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示数据（后端未连接）</view>
  </block>

  <!-- 发布悬浮按钮 -->
  <view class="fab" bindtap="onPublish">
    <text class="fab-plus">+</text>
    <text class="fab-text">发布知识卡</text>
  </view>
</view>
