.basis-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.basis-nav {
  display: flex;
  height: 64rpx;
  align-items: center;
  padding: 0 32rpx;
}

.basis-back {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  border: 1rpx solid rgba(229, 231, 235, 0.5);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.05);
}

.basis-back__icon {
  position: absolute;
  top: 21rpx;
  left: 24rpx;
  width: 19rpx;
  height: 19rpx;
  transform: rotate(45deg);
  border-bottom: 4rpx solid var(--ink);
  border-left: 4rpx solid var(--ink);
}

.basis-content {
  display: flex;
  box-sizing: border-box;
  flex-direction: column;
  gap: 64rpx;
  padding: 54rpx 40rpx calc(300rpx + env(safe-area-inset-bottom));
}

.basis-badge {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: var(--figma-radius-pill);
  background: rgba(229, 231, 235, 0.5);
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 700;
}

.basis-title {
  margin-top: 32rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1.3rpx;
  line-height: 1.3;
}

.basis-copy {
  margin-top: 24rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.65;
}

.judgment-card,
.steps-card,
.criteria-card,
.basis-empty {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(238, 242, 255, 0.5);
  border-radius: 64rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 60rpx rgba(16, 24, 40, 0.04);
}

.judgment-card {
  padding: 48rpx;
}

.judgment-aurora {
  position: absolute;
  background: linear-gradient(135deg, var(--primary), var(--color-ai-violet) 50%, var(--color-ai-pink));
  opacity: 0.03;
  inset: 0;
}

.judgment-content {
  position: relative;
  z-index: 1;
}

.judgment-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.judgment-spark {
  color: var(--primary);
  font-size: 36rpx;
}

.judgment-title {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.65;
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.evidence-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: var(--figma-color-ink-tertiary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.6;
}

.evidence-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-top: 16rpx;
  border-radius: 50%;
  background: var(--figma-color-primary-bright);
}

.basis-detail {
  margin-top: 40rpx;
}

.factor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 32rpx;
  border-radius: 40rpx;
  background: var(--bg);
}

.factor-item {
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--color-surface);
}

.factor-label {
  color: var(--ink-3);
  font-size: 20rpx;
}

.factor-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.factor-item--primary .factor-value {
  color: var(--primary);
}

.factor-item--warning .factor-value {
  color: var(--figma-color-warning-deep);
}

.invalidation-block {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--bg);
}

.invalidation-title {
  font-size: 24rpx;
  font-weight: 700;
}

.invalidation-item {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.basis-toggle {
  display: inline-flex;
  width: auto;
  align-items: center;
  gap: 8rpx;
  margin-top: 40rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(238, 242, 255, 0.5);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
}

.basis-toggle__arrow--open {
  display: inline-block;
  transform: rotate(180deg);
}

.basis-section__title {
  margin: 0 8rpx 32rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.steps-card,
.criteria-card {
  padding: 48rpx;
}

.steps-card {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.steps-line {
  position: absolute;
  top: 80rpx;
  bottom: 80rpx;
  left: 64rpx;
  width: 2rpx;
  background: var(--line);
}

.step-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
}

.step-number {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.12);
}

.step-number--active {
  background: var(--primary);
  box-shadow: 0 6rpx 18rpx rgba(97, 95, 255, 0.28);
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
}

.step-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.criteria-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: 0;
}

.criteria-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  color: var(--figma-color-ink-strong);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.criteria-check {
  color: var(--good);
  font-size: 32rpx;
  font-weight: 800;
}

.criteria-boundary {
  margin: 0 -48rpx;
  padding: 40rpx 48rpx;
  background: rgba(249, 250, 251, 0.68);
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.6;
}

.basis-footer {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(40rpx);
}

.basis-primary {
  width: 100%;
  min-height: 104rpx;
  border-radius: 48rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 60rpx rgba(16, 24, 40, 0.12);
}

.basis-footer__links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 0 32rpx;
}

.basis-link {
  width: auto;
  color: var(--figma-color-ink-tertiary);
  font-size: 27rpx;
  font-weight: 700;
}

.basis-link--anan {
  color: var(--primary);
}

.basis-footer__divider {
  width: 1rpx;
  height: 24rpx;
  background: var(--figma-color-line-emphasis);
}

.basis-empty {
  padding: 56rpx 48rpx;
  text-align: center;
}

.basis-empty__title {
  font-size: 34rpx;
  font-weight: 700;
}

.basis-empty__copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.basis-empty__action {
  width: 100%;
  min-height: 88rpx;
  margin-top: 32rpx;
  border-radius: 36rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 28rpx;
  font-weight: 700;
}

@media (min-width: 768px) {
  .basis-content {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .basis-footer {
    right: 50%;
    left: auto;
    width: min(100%, 760px);
    transform: translateX(50%);
  }
}
