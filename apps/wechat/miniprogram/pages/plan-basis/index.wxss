.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.pb { display: flex; flex-direction: column; min-height: 100vh; }
.pb-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.pb-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.pb-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.pb-loading { padding: 120rpx 0; text-align: center; }
.pb-body { flex: 1; min-height: 0; }

.pb-head { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 8rpx; border-left: 6rpx solid var(--primary); }
.pb-rationale { line-height: 1.7; }

.pb-section { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-3); padding: 28rpx 8rpx 16rpx; }

.pb-task { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 16rpx; }
.pb-task-head { display: flex; align-items: center; gap: 16rpx; }
.pb-order {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--primary-soft); color: var(--primary);
  font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.pb-task-title { flex: 1; font-size: 29rpx; font-weight: 600; color: var(--ink); }
.pb-reason { font-size: 27rpx; line-height: 1.6; color: var(--ink-2); }
.pb-chip {
  align-self: flex-start;
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 4rpx 18rpx;
}

.pb-adjust { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; margin-bottom: 24rpx; }
.pb-adjust-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.pb-adjust-main { display: flex; flex-direction: column; gap: 4rpx; }
.pb-arrow { font-size: 26rpx; color: var(--primary); flex-shrink: 0; }
.pb-sub { font-size: 27rpx; color: var(--ink-2); padding-top: 8rpx; }
.pb-minute { color: var(--primary); font-weight: 700; }
.pb-energy { display: flex; flex-wrap: wrap; gap: 14rpx; }
.pb-energy-chip {
  font-size: 25rpx; color: var(--ink-2);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
.pb-energy-chip.is-on { color: #fff; background: var(--primary); border-color: var(--primary); }
.pb-apply { width: 100%; margin-top: 8rpx; }
.pb-note { line-height: 1.6; }
.demo-tip { text-align: center; padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx); }
