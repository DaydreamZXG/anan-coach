.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

/* ── 顶部导航 ── */
.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
  flex-shrink: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.section-head {
  margin: 32rpx 32rpx 24rpx;
}

/* ── 总览卡 ── */
.overview {
  margin: 8rpx 32rpx 0;
  padding: 32rpx;
}

.overview__pill {
  display: inline-flex;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--indigo);
  background: rgba(91, 95, 244, 0.09);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.overview__headline {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.5;
}

.overview__note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

/* ── 排序公式 ── */
.policy {
  margin: 0 32rpx;
  padding: 10rpx 0;
  display: flex;
  flex-wrap: wrap;
}

.policy__cell {
  width: 33.33%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.policy__label {
  font-size: 20rpx;
  color: var(--ink-3);
}

.policy__value {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

/* ── 任务依据 ── */
.task {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.task__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.5;
}

.task__reason {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.task__metrics {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.task__metric {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  background: #f4f5fb;
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
}

.task__k {
  font-size: 20rpx;
  color: var(--ink-3);
}

.task__v {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.task__v--sm {
  font-size: 22rpx;
}

/* ── 失效条件 ── */
.invalidation {
  margin: 0 32rpx;
  padding: 28rpx;
}

.invalidation__row {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.8;
}

.invalidation__row + .invalidation__row {
  margin-top: 10rpx;
}

/* ── 冲突提示 ── */
.notice {
  margin: 28rpx 32rpx 0;
  font-size: 22rpx;
  color: var(--amber);
  background: rgba(217, 127, 6, 0.08);
  border: 1rpx solid rgba(217, 127, 6, 0.28);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  line-height: 1.7;
}
