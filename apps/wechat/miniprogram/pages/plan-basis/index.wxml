<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav__back" hover-class="is-pressed" bind:tap="onBack">‹</view>
    <view class="nav__text">
      <view class="nav__title">计划依据</view>
      <view class="nav__sub">今天为什么这样排，每个任务都对得上目标和时间</view>
    </view>
  </view>

  <state-view wx:if="{{viewState === 'loading'}}" type="loading" title="正在读取计划依据…" />
  <state-view
    wx:elif="{{viewState === 'error'}}"
    type="error"
    title="计划依据没有加载成功"
    desc="{{errorDesc}}"
    request-id="{{requestId}}"
    action-text="重新加载"
    bind:action="onRetry"
  />

  <block wx:else>
    <!-- 总览 -->
    <view class="card overview">
      <view class="overview__pill">目标匹配 · 计划 v{{versionNo}}</view>
      <view class="overview__headline">{{headline}}</view>
      <view class="overview__note">{{rationale}}</view>
    </view>

    <!-- 排序公式 -->
    <view class="section-head">
      <view class="section-title">排序公式</view>
      <view class="section-extra">{{algorithmVersion}}</view>
    </view>
    <view class="card policy">
      <view wx:for="{{policyMetrics}}" wx:key="label" class="policy__cell">
        <view class="policy__label">{{item.label}}</view>
        <view class="policy__value">{{item.value}}</view>
      </view>
    </view>

    <!-- 任务逐项依据 -->
    <view class="section-head">
      <view class="section-title">任务逐项依据</view>
      <view class="section-extra">{{tasks.length}} 项</view>
    </view>
    <view wx:for="{{tasks}}" wx:key="taskId" class="card task">
      <view class="task__title">{{item.order}} · {{item.trackLabel}} · {{item.title}}</view>
      <view class="task__reason">{{item.reason}}</view>
      <view class="task__metrics">
        <view class="task__metric">
          <text class="task__k">综合优先级</text>
          <text class="task__v">{{item.priorityLabel}}</text>
        </view>
        <view class="task__metric">
          <text class="task__k">证据</text>
          <text class="task__v task__v--sm">{{item.evidenceLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 失效条件 -->
    <view class="section-head">
      <view class="section-title">什么时候失效</view>
    </view>
    <view class="card invalidation">
      <view wx:for="{{invalidationConditions}}" wx:key="*this" class="invalidation__row">
        {{index + 1}}. {{item}}
      </view>
    </view>

    <view wx:if="{{hasConflicts}}" class="notice">
      还有能力或内容条件没满足：{{conflictLabel}}
    </view>
  </block>
</view>
