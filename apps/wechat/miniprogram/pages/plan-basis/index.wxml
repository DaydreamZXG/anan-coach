<view class="s9-screen">
  <workbench-nav id="runtime-workbench-nav" title="计划依据" back-behavior="emit" bind:back="exit" />

  <view class="s9-body s9-body--with-dock basis-content">
    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="安排依据没有加载成功"
      description="{{errorMessage}}"
      request-id="{{requestId}}"
      action-text="重新加载"
      bind:action="retry"
    />
    <view wx:elif="{{status === 'empty'}}" class="s9-card basis-empty">
      <view class="s9-card-title">今天没有待解释的任务</view>
      <view class="s9-card-copy">{{errorMessage}}</view>
      <view class="s9-empty-space"></view>
      <button hover-class="item--hover" class="s9-primary-button" bindtap="exit">返回今日</button>
    </view>

    <block wx:elif="{{focusTask}}">
      <view class="s9-hero">
        <view class="s9-chip-row">
          <view class="s9-chip">{{focusTask.trackLabel}} · 约 {{focusTask.estimatedMinutes}} 分钟</view>
        </view>
        <view class="s9-title">为什么今天练这个</view>
        <view class="s9-subtitle">这不是让你多刷一组题，而是验证近期最值得确认的问题。</view>
      </view>

      <view class="s9-stack">
        <view class="s9-card s9-card--primary">
          <view class="judgment-heading"><text class="judgment-spark">✦</text><text>岸岸为什么这样安排</text></view>
          <view class="s9-card-title">{{focusTask.reason}}</view>
          <view class="evidence-list">
            <view wx:for="{{evidenceBullets}}" wx:key="*this" class="evidence-item">
              <view class="evidence-dot"></view><text>{{item}}</text>
            </view>
          </view>

          <view wx:if="{{expanded}}" class="basis-detail">
            <view class="factor-grid">
              <view wx:for="{{factorMetrics}}" wx:key="label" class="factor-item factor-item--{{item.tone}}">
                <view class="factor-label">{{item.label}}</view>
                <view class="factor-value type-data">{{item.value}}</view>
              </view>
            </view>
            <view wx:if="{{invalidationConditions.length}}" class="invalidation-block">
              <view class="invalidation-title">这些变化会触发重新安排</view>
              <view wx:for="{{invalidationConditions}}" wx:key="*this" class="invalidation-item">· {{item}}</view>
            </view>
          </view>
          <button hover-class="item--hover" class="basis-toggle" bindtap="toggleExpanded">{{expanded ? '收起完整依据' : '查看完整依据'}} <text class="{{expanded ? 'basis-toggle__arrow--open' : ''}}">⌄</text></button>
        </view>
      </view>

      <view class="s9-section">
        <view class="s9-section-head"><view class="s9-section-title">这 {{focusTask.estimatedMinutes}} 分钟怎么练</view></view>
        <view class="s9-card steps-card">
          <view class="steps-line"></view>
          <view class="step-row">
            <view class="step-number">1</view>
            <view><view class="step-title">完成当前任务目标</view><view class="step-copy">{{focusTask.objective}}</view></view>
          </view>
          <view class="step-row">
            <view class="step-number">2</view>
            <view><view class="step-title">保留真实作答过程</view><view class="step-copy">答案、用时、信心、改答和草稿都会一起记录。</view></view>
          </view>
          <view class="step-row">
            <view class="step-number step-number--active">3</view>
            <view><view class="step-title">{{focusTask.requiresReflection ? '完成关键题复盘' : '提交本次训练结果'}}</view><view class="step-copy">本次结果会进入后续复测，不会被直接当成稳定能力。</view></view>
          </view>
        </view>
      </view>

      <view class="s9-section">
        <view class="s9-section-head"><view class="s9-section-title">今天练成什么算有效</view></view>
        <view class="s9-card criteria-card">
          <view wx:for="{{focusTask.successCriteria}}" wx:key="*this" class="criteria-row">
            <view class="criteria-check">✓</view><text>{{item}}</text>
          </view>
          <view class="criteria-boundary">完成本次训练只会新增真实记录，不会凭一组题直接改变能力结论。</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{status === 'ready' && focusTask}}" class="s9-action-dock">
    <button hover-class="item--hover" class="s9-primary-button tap-tactile" loading="{{openingTask}}" bindtap="startTask">开始这项训练 <text>›</text></button>
    <view class="basis-footer__links">
      <button hover-class="item--hover" class="basis-link" bindtap="openAdjustment">调整这项任务</button>
      <view class="basis-footer__divider"></view>
      <button hover-class="item--hover" class="basis-link basis-link--anan" bindtap="askAnan">带着这项安排问岸岸</button>
    </view>
  </view>
</view>
