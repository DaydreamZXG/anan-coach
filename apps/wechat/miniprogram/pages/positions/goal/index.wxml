<view class="s9-page position-page position-goal-page">
  <view class="s9-hero">
    <view class="s9-kicker">主目标变更</view>
    <view class="s9-title">换目标可以，但先看计划会怎么变</view>
    <view class="s9-subtitle">确认前先固定资格、目标分证据和会被重建的计划范围。</view>
  </view>

  <state-view wx:if="{{!state || state.status === 'idle' || state.status === 'loading' || state.status === 'previewing'}}" state="{{state && state.status === 'previewing' ? 'processing' : 'loading'}}" title="正在生成影响预览" description="先重新核验资格，再固定目标分与计划失效项。" />
  <state-view
    wx:elif="{{state.status === 'needsProfile'}}"
    state="empty"
    title="先完成资格建档"
    description="主目标必须绑定当前资格档案版本。"
    request-id="{{state.error.requestId}}"
    action-text="去建档"
    bind:action="openOnboarding"
  />
  <state-view
    wx:elif="{{state.status === 'noActiveRelease'}}"
    state="empty"
    title="目标岗位不在当前发布"
    description="旧年度或未激活岗位不能成为主目标。"
    request-id="{{state.error.requestId}}"
  />
  <state-view
    wx:elif="{{state.status !== 'ready' && state.status !== 'confirming' && state.status !== 'confirmed'}}"
    state="{{state.status === 'network' ? 'stale' : 'error'}}"
    title="{{state.error.title}}"
    description="{{state.error.message}}"
    request-id="{{state.error.requestId}}"
    action-text="{{state.status === 'versionConflict' ? '重新生成预览' : (state.error.retryable ? '重试原命令' : '')}}"
    bind:action="retry"
  />

  <block wx:else>
    <view wx:if="{{state.restoredPreview}}" class="processing-banner">已恢复本机尚未确认且仍在有效期内的服务端预览；确认时服务端仍会校验当前版本。</view>
    <view wx:if="{{state.summary}}" class="goal-position-card"><view class="goal-position-card__label">候选主目标</view><view class="goal-position-card__name">{{state.summary.name}}</view><view class="goal-position-card__department">{{state.summary.departmentFull}}</view><text class="goal-position-card__meta">{{state.summary.region}}{{state.summary.city ? ' · ' + state.summary.city : ''}} · 职位 {{state.summary.positionCode}}</text></view>
    <view wx:if="{{state.preview}}" class="impact-card">
      <view class="impact-card__head"><view><view class="eyebrow">服务端影响预览</view><view class="impact-card__title">{{state.preview.planImpact.changeType === 'goal_changed' ? '更换主目标' : '建立主目标'}}</view></view><view class="status-pill">{{state.previewView.expiryLabel}}</view></view>
      <view class="impact-score"><view class="impact-score__item"><text class="impact-score__label">原目标分</text><text class="impact-score__value type-data">{{state.previewView.previousScoreLabel}}</text></view><view class="impact-score__arrow">→</view><view class="impact-score__item"><text class="impact-score__label">新目标分</text><text class="impact-score__value type-data">{{state.previewView.nextScoreLabel}}</text></view></view>
      <view class="impact-delta">{{state.previewView.deltaLabel}}</view>
      <view class="impact-evidence">目标分 {{state.preview.targetScore.lowerBound}}–{{state.preview.targetScore.upperBound}} · 样本 {{state.preview.targetScore.sampleCount}} · {{state.targetValidity.generatedLabel}} · {{state.targetValidity.label}}</view>
      <view wx:if="{{!state.targetValidity.available}}" class="inline-warning">正式目标确认需要服务端返回目标分有效期；当前契约缺口不会由客户端补日期。</view>
      <view wx:if="{{state.targetValidity.expired}}" class="inline-error">目标分证据已过期，请重新生成服务端预览。</view>
    </view>

    <view class="section-heading"><view class="section-title">将失效并重建</view><view class="section-meta">完全来自 planImpact.invalidates</view></view>
    <view wx:if="{{state.invalidations.length}}" class="invalidation-list"><view wx:for="{{state.invalidations}}" wx:key="code" class="invalidation-item"><text class="invalidation-dot"></text><view class="invalidation-item__copy"><text class="invalidation-item__title">{{item.label}}</text><text class="invalidation-item__meta">服务端标识 · {{item.code}}</text></view></view></view>
    <view wx:else class="capability-card"><view class="capability-card__title">服务端未返回计划失效项</view><view class="capability-card__copy">客户端不会硬编码“今日计划”“周计划”或“分差”影响；本次预览不能继续确认。</view></view>

    <view wx:if="{{state.delivery}}" class="delivery-strip"><text>生成 {{state.delivery.generatedAtLabel}}</text><text class="delivery-strip__request">Request ID · {{state.delivery.requestId}}</text></view>
    <view wx:if="{{state.status === 'confirmed'}}" class="success-card">主目标版本已确认。以上失效项将由服务端重建。<text wx:if="{{state.commandTrace}}">Request ID · {{state.commandTrace.requestId}}</text></view>
    <view wx:if="{{state.status === 'confirmed' && state.offerExamBriefing && resolvingPostGoalAction}}" class="orientation-card">
      <view class="orientation-card__eyebrow">正在对齐首日入口</view>
      <view class="orientation-card__title">主目标已确认，正在读取你的备考经历</view>
      <view class="orientation-card__copy">不会再用“新账号”猜测你是不是小白。</view>
    </view>
    <view wx:elif="{{state.status === 'confirmed' && state.offerExamBriefing && postGoalAction === 'review_exam_briefing'}}" class="orientation-card">
      <view class="orientation-card__eyebrow">第一次建立主目标</view>
      <view class="orientation-card__title">你对国考和这个岗位熟悉吗？</view>
      <view class="orientation-card__copy">账号是新的，不代表你是备考小白。由你自己选择是否查看基础考情，系统不会根据注册时间猜测。</view>
      <view class="orientation-card__actions">
        <ui-button label="我已熟悉，直接开始" variant="secondary" bind:action="finish" />
        <ui-button label="我是小白，先看考情" bind:action="openBeginnerBriefing" />
      </view>
    </view>
    <view wx:elif="{{state.status === 'confirmed' && state.offerExamBriefing && postGoalAction === 'import_prior_evidence'}}" class="orientation-card">
      <view class="orientation-card__eyebrow">复用已有学习成果</view>
      <view class="orientation-card__title">下一步先把外部成绩与资料接进来</view>
      <view class="orientation-card__copy">已有学习不会被当成空白起点；导入后仍由你确认，才会影响能力和计划。</view>
      <view class="orientation-card__actions"><ui-button label="稍后再导入" variant="secondary" bind:action="finish" /><ui-button label="导入已有证据" bind:action="openRecommendedEntry" /></view>
    </view>
    <view wx:elif="{{state.status === 'confirmed' && state.offerExamBriefing && postGoalAction === 'start_retake_recovery'}}" class="orientation-card">
      <view class="orientation-card__eyebrow">二战失分回收</view>
      <view class="orientation-card__title">先用往年实考成绩还原失分结构</view>
      <view class="orientation-card__copy">跨年原始分不直接计算提分，也不参与退款或现金奖励。</view>
      <view class="orientation-card__actions"><ui-button label="稍后再做" variant="secondary" bind:action="finish" /><ui-button label="建立失分回收计划" bind:action="openRecommendedEntry" /></view>
    </view>
    <view wx:if="{{state.status === 'confirmed' && state.offerExamBriefing && postGoalError}}" class="inline-error">{{postGoalError}}</view>
    <view wx:if="{{state.status !== 'confirmed' || !state.offerExamBriefing || postGoalError || (postGoalAction && postGoalAction !== 'review_exam_briefing' && postGoalAction !== 'import_prior_evidence' && postGoalAction !== 'start_retake_recovery')}}" class="sticky-actions">
      <ui-button wx:if="{{state.status === 'confirmed'}}" label="{{state.offerExamBriefing ? '进入今日计划' : '返回岗位工作区'}}" bind:action="finish" />
      <block wx:else>
        <block wx:if="{{state.status !== 'confirmed'}}">
          <ui-button label="返回核对岗位" variant="secondary" bind:action="openDetail" />
          <ui-button label="确认主目标变更" loading="{{state.status === 'confirming'}}" disabled="{{!state.preview || !state.invalidations.length || state.targetValidity.expired}}" bind:action="confirmGoal" />
        </block>
      </block>
    </view>
  </block>
</view>
