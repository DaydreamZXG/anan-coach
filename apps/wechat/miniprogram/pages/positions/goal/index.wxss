@import "../../../features/positions/page-shell.wxss";

.position-goal-page {
  padding-bottom: 140rpx;
}

.orientation-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid var(--color-primary-a16);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, var(--color-primary-soft) 100%);
  box-shadow: 0 16rpx 40rpx rgba(190, 120, 60, 0.08);
}

.orientation-card__eyebrow {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.orientation-card__title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.35;
}

.orientation-card__copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.orientation-card__actions {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}
