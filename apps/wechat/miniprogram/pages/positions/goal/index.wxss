@import "../../../features/positions/page-shell.wxss";

.position-goal-page {
  padding-bottom: 140rpx;
}

.orientation-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(49, 86, 211, 0.18);
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eef3ff 100%);
  box-shadow: 0 16rpx 40rpx rgba(49, 86, 211, 0.08);
}

.orientation-card__eyebrow {
  color: #3156d3;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.orientation-card__title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.35;
}

.orientation-card__copy {
  margin-top: 12rpx;
  color: #5d667a;
  font-size: 26rpx;
  line-height: 1.65;
}

.orientation-card__actions {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}
