<view class="s9-page position-page position-compare-page">
  <view class="s9-hero">
    <view class="s9-kicker">岗位对比 · {{state.positionIds.length}} 个候选</view>
    <view class="s9-title">两个岗位，差别不只在竞争比</view>
    <view class="s9-subtitle">按同一份档案对比资格、分差和加试要求。</view>
  </view>

  <state-view wx:if="{{!state || state.status === 'idle' || state.status === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{state.status === 'needsProfile'}}"
    state="empty"
    title="先完成资格建档"
    description="岗位对比要按同一份档案重新核对。"
    request-id="{{state.error.requestId}}"
    action-text="去建档"
    bind:action="openOnboarding"
  />
  <state-view
    wx:elif="{{state.status === 'noActiveRelease'}}"
    state="empty"
    title="候选岗位不在当前发布"
    description="不能把旧年度或非激活发布中的岗位放入正式对比。"
    request-id="{{state.error.requestId}}"
  />
  <state-view
    wx:elif="{{state.status !== 'ready'}}"
    state="{{state.status === 'network' ? 'stale' : 'error'}}"
    title="{{state.error.title}}"
    description="{{state.error.message}}"
    request-id="{{state.error.requestId}}"
    action-text="{{state.error.retryable ? '重新对齐' : ''}}"
    bind:action="retry"
  />

  <block wx:else>
    <view class="delivery-strip">
      <text>档案 v{{state.learnerProfileVersion}} · 规则 {{state.ruleSetVersion}}</text>
      <text>生成 {{state.delivery.generatedAtLabel}}</text>
      <text wx:if="{{state.delivery.partial}}" class="delivery-strip__warning">{{state.delivery.partialLabel}}</text>
      <text wx:if="{{state.delivery.stale}}" class="delivery-strip__warning">{{state.delivery.staleLabel}}</text>
      <text wx:if="{{state.delivery.processing}}" class="delivery-strip__processing">{{state.delivery.processingLabel}}</text>
      <text class="delivery-strip__request">Request ID · {{state.delivery.requestId}}</text>
    </view>
    <scroll-view class="comparison-scroll" scroll-x enable-flex>
      <view class="comparison-track">
        <view wx:for="{{state.items}}" wx:key="positionId" class="comparison-card">
          <view class="position-card__top"><view class="status-pill status-pill--{{item.eligibilityTone}}">{{item.eligibilityLabel}}</view><view wx:if="{{item.isPrimaryGoal}}" class="primary-tag">当前主目标</view></view>
          <view class="comparison-card__name">{{item.name}}</view>
          <view class="comparison-card__department">{{item.departmentFull}}</view>
          <view class="highlight-list"><view wx:for="{{item.highlightLabels}}" wx:for-item="label" wx:key="*this" class="highlight-item">{{label}}</view></view>
          <view class="comparison-table">
            <view class="comparison-row"><text class="comparison-row__label">资格核验</text><text class="comparison-row__value">{{item.conditionSummary}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">岗位分带</text><text class="comparison-row__value">{{item.fitView.bandLabel}} · {{item.fitView.statusDescription}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">同版本分差</text><text class="comparison-row__value type-data">{{item.fitView.scoreGapRangeLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">建议点差</text><text class="comparison-row__value type-data">{{item.fitView.scoreGapRecommendedLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">双科证据</text><text class="comparison-row__value">{{item.fitView.evidenceStatusLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">资格负担</text><text class="comparison-row__value">{{item.fitView.requirementsBurdenLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">目标分区间</text><text class="comparison-row__value type-data">{{item.scoreLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">目标分有效期</text><text class="comparison-row__value">{{item.targetValidityLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">目标分生成时间</text><text class="comparison-row__value">{{item.targetGeneratedLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">样本证据</text><text class="comparison-row__value">{{item.scoreEvidenceLabel}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">招录人数</text><text class="comparison-row__value type-data">{{item.headcount}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">地区</text><text class="comparison-row__value">{{item.region}}{{item.city ? ' · ' + item.city : ''}}</text></view>
            <view class="comparison-row"><text class="comparison-row__label">试卷类型</text><text class="comparison-row__value">{{item.paperTypeLabel}}</text></view>
          </view>
          <view wx:if="{{item.fitView.evidenceReasonLabel}}" class="fit-card__reason">未形成分差的依据 · {{item.fitView.evidenceReasonLabel}}</view>
          <view class="fit-card__audit">分差 Request ID · {{item.fitRequestId}}</view>
          <view hover-class="item--hover" class="inline-link" data-id="{{item.positionId}}" bindtap="openPosition">查看逐条证据 →</view>
        </view>
      </view>
    </scroll-view>
    <view class="capability-card capability-card--neutral">
      <view class="capability-card__title">分带是区间关系，不是录取概率</view>
      <view class="capability-card__copy">稳妥、匹配、冲刺只描述同年度能力区间与岗位目标区间的关系；资格待确认、不符合条件和额外考试仍单独展示。</view>
    </view>
    <view class="sticky-actions"><ui-button label="返回调整候选" variant="secondary" bind:action="returnToSearch" /></view>
  </block>
</view>
