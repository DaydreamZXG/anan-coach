<view class="s9-page position-page position-detail-page">
  <view class="s9-hero">
    <view class="s9-kicker">岗位详情</view>
    <view class="s9-title">{{state.summaryView ? state.summaryView.name : '岗位逐条资格核验'}}</view>
    <view class="s9-subtitle">把资格、竞争与个人匹配拆开看，所有判断都保留依据。</view>
  </view>

  <state-view wx:if="{{!state || state.status === 'idle' || state.status === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{state.status === 'needsProfile'}}"
    state="empty"
    title="先完成资格建档"
    description="先完善你的资格条件，才能逐条核对岗位要求。"
    request-id="{{state.error.requestId}}"
    action-text="去建档"
    bind:action="openOnboarding"
  />
  <state-view
    wx:elif="{{state.status === 'noActiveRelease'}}"
    state="empty"
    title="岗位发布已停止使用"
    description="该岗位不属于当前激活的国考发布，不能继续使用旧规则核验。"
    request-id="{{state.error.requestId}}"
  />
  <state-view
    wx:elif="{{state.status !== 'ready'}}"
    state="{{state.status === 'network' ? 'stale' : 'error'}}"
    title="{{state.error.title}}"
    description="{{state.error.message}}"
    request-id="{{state.error.requestId}}"
    action-text="{{state.error.retryable ? '重新核验' : ''}}"
    bind:action="retry"
  />

  <block wx:else>
    <view class="delivery-strip">
      <text>{{state.examYear}} 国考 · 资格档案 v{{state.learnerProfileVersion}} · 规则 {{state.ruleSetVersion}}</text>
      <text>生成 {{state.delivery.generatedAtLabel}}</text>
      <text wx:if="{{state.delivery.partial}}" class="delivery-strip__warning">{{state.delivery.partialLabel}}</text>
      <text wx:if="{{state.delivery.stale}}" class="delivery-strip__warning">{{state.delivery.staleLabel}}</text>
      <text wx:if="{{state.delivery.processing}}" class="delivery-strip__processing">{{state.delivery.processingLabel}}</text>
      <text class="delivery-strip__request">资格核验 Request ID · {{state.delivery.requestId}}</text>
      <text wx:if="{{state.detailTrace}}" class="delivery-strip__request">岗位详情 Request ID · {{state.detailTrace.requestId}}</text>
    </view>

    <view wx:if="{{state.summaryView}}" class="detail-hero">
      <view class="detail-hero__top"><view class="status-pill status-pill--{{state.summaryView.eligibilityTone}}">{{state.summaryView.eligibilityLabel}}</view><view class="position-code">{{state.summaryView.positionCode}}</view></view>
      <view class="detail-hero__score"><text class="detail-hero__score-label">建议备考线</text><text class="detail-hero__score-value type-data">{{state.summaryView.scoreLabel}}</text></view>
      <view class="detail-hero__meta">{{state.summaryView.region}}{{state.summaryView.city ? ' · ' + state.summaryView.city : ''}} · 招 {{state.summaryView.headcount}} 人</view>
      <view class="detail-hero__evidence">{{state.summaryView.scoreEvidenceLabel}} · {{state.summaryView.targetGeneratedLabel}} · {{state.summaryView.targetValidityLabel}}</view>
      <view wx:if="{{state.summaryView.targetScoreExpired}}" class="inline-warning">这个目标分是旧的，不能用来定目标，请重新评估。</view>
    </view>

    <view class="section-heading"><view class="section-title">岗位匹配与分差</view><view class="section-meta">分差依据 · 不是录取概率</view></view>
    <view wx:if="{{state.fit}}" class="fit-card fit-card--{{state.fit.statusTone}}">
      <view class="fit-card__head">
        <view><view class="fit-card__kicker">{{state.fit.bandLabel}}分带</view><view class="fit-card__title">{{state.fit.statusLabel}}</view></view>
        <view class="status-pill status-pill--{{state.fit.statusTone}}">{{state.fit.evidenceStatusLabel}}</view>
      </view>
      <view class="fit-card__description">{{state.fit.statusDescription}}</view>
      <view class="fit-card__metrics">
        <view class="fit-card__metric"><text class="fit-card__metric-label">同版本分差区间</text><text class="fit-card__metric-value type-data">{{state.fit.scoreGapRangeLabel}}</text></view>
        <view class="fit-card__metric"><text class="fit-card__metric-label">建议点差</text><text class="fit-card__metric-value type-data">{{state.fit.scoreGapRecommendedLabel}}</text></view>
      </view>
      <view wx:if="{{state.fit.scoreGapDirectionLabel}}" class="fit-card__note">{{state.fit.scoreGapDirectionLabel}}</view>
      <view class="fit-card__burden">{{state.fit.requirementsBurdenLabel}}</view>
      <view wx:if="{{state.fit.pendingRequirementIdsLabel}}" class="fit-card__audit">待确认条件 ID · {{state.fit.pendingRequirementIdsLabel}}</view>
      <view wx:if="{{state.fit.hardConditionNotMetRequirementIdsLabel}}" class="fit-card__audit">不符合条件 ID · {{state.fit.hardConditionNotMetRequirementIdsLabel}}</view>
      <view wx:if="{{state.fit.evidenceReasonLabel}}" class="fit-card__reason">未形成分差的依据 · {{state.fit.evidenceReasonLabel}}</view>
      <view class="fit-next-step fit-next-step--{{state.fit.statusTone}}">
        <view class="fit-next-step__title">{{state.fit.nextActionTitle}}</view>
        <view class="fit-next-step__copy">{{state.fit.nextActionCopy}}</view>
      </view>
      <view hover-class="item--hover" wx:if="{{!state.fit.scoreGapAvailable}}" class="inline-link fit-card__action" bindtap="openPositionsWorkspace">回岗位工作区录入成绩 →</view>
    </view>

    <view class="section-heading"><view class="section-title">行测 + 申论能力证据</view><view class="section-meta">缺一科不生成总分分差</view></view>
    <view wx:if="{{state.ability}}" class="ability-card">
      <view class="ability-card__head">
        <view><view class="ability-card__kicker">共享学习大脑</view><view class="ability-card__title">{{state.ability.statusLabel}}</view></view>
        <view class="status-pill">{{state.ability.confidenceLabel}}</view>
      </view>
      <view class="ability-card__scores">
        <view class="ability-score"><text class="ability-score__label">行测</text><text class="ability-score__value type-data">{{state.ability.xingceLabel}}</text></view>
        <view class="ability-score"><text class="ability-score__label">申论</text><text class="ability-score__value type-data">{{state.ability.shenlunLabel}}</text></view>
        <view class="ability-score"><text class="ability-score__label">总分</text><text class="ability-score__value type-data">{{state.ability.totalLabel}}</text></view>
      </view>
      <view class="ability-card__copy">{{state.ability.evidenceLabel}} · {{state.ability.missingLabel}}</view>
      <view wx:if="{{state.ability.conflictLabel}}" class="inline-warning">{{state.ability.conflictLabel}}</view>
    </view>

    <view class="section-heading"><view class="section-title">硬条件逐条核验</view><view class="section-meta">快照 {{state.snapshotId}}</view></view>
    <view wx:if="{{!state.checks.length}}" class="empty-inline">当前规则编译结果没有额外硬条件；报名前仍需核对官方公告。</view>
    <view class="requirement-card-grid">
    <view wx:for="{{state.checks}}" wx:key="requirementId" class="requirement-card">
      <view class="requirement-card__head"><view class="status-pill status-pill--{{item.statusTone}}">{{item.statusLabel}}</view><view class="requirement-card__field">{{item.field}}</view></view>
      <view class="requirement-card__condition">{{item.conditionLabel}}</view>
      <view class="requirement-card__evidence">{{item.evidenceLabel}}</view>
      <view wx:if="{{item.sourceReference}}" class="requirement-card__source">来源 · {{item.sourceReference}}</view>
      <view wx:if="{{item.operator === 'manual_review'}}" class="confirmation-actions">
        <view hover-class="item--hover" class="confirmation-action" data-requirement-id="{{item.requirementId}}" data-response="satisfied" bindtap="confirmRequirement">符合</view>
        <view hover-class="item--hover" class="confirmation-action" data-requirement-id="{{item.requirementId}}" data-response="uncertain" bindtap="confirmRequirement">不确定</view>
        <view hover-class="item--hover" class="confirmation-action" data-requirement-id="{{item.requirementId}}" data-response="not_satisfied" bindtap="confirmRequirement">不符合</view>
      </view>
      <view wx:if="{{state.confirmingRequirementId === item.requirementId}}" class="processing-banner">正在生成新资格档案版本并重新核验…</view>
    </view>
    </view>
    <view wx:if="{{state.confirmationMessage}}" class="success-card">{{state.confirmationMessage}}<text wx:if="{{state.commandTrace}}">Request ID · {{state.commandTrace.requestId}}</text></view>
    <view wx:if="{{state.commandError}}" class="inline-error"><view>{{state.commandError.message}}</view><view wx:if="{{state.commandError.requestId}}">Request ID · {{state.commandError.requestId}}</view></view>

    <view class="section-heading"><view class="section-title">目标变更</view><view class="section-meta">先预览再确认</view></view>
    <view class="capability-card capability-card--neutral"><view class="capability-card__title">先看计划会怎么变</view><view class="capability-card__copy">确认前不会改变当前主目标，下一步会先展示受影响的计划。</view></view>
    <view class="sticky-actions">
      <ui-button label="{{state.eligibilityStatus !== 'eligible' ? '资格确认后才能设为目标' : (state.summaryView.targetScoreExpired ? '目标分证据已过期' : '查看目标变更影响')}}" disabled="{{state.eligibilityStatus !== 'eligible' || state.summaryView.targetScoreExpired}}" bind:action="openGoalChange" />
    </view>
  </block>
</view>
