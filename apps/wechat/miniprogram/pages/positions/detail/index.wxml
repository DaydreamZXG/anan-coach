<view class="s9-screen position-screen position-screen--detail">
  <workbench-nav id="runtime-workbench-nav" title="岗位详情" back-behavior="emit" bind:back="goBack" />

  <view class="position-content position-content--detail">
    <state-view wx:if="{{!state || state.status === 'idle' || state.status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{state.status === 'needsProfile'}}"
      state="empty"
      title="先把报考资料补全"
      description="把你的条件填完整，才能一条条对照岗位要求。"
      action-text="去补资料"
      bind:action="openQualificationProfile"
    />
    <state-view
      wx:elif="{{state.status === 'noActiveRelease'}}"
      state="empty"
      title="{{state.error.title}}"
      description="{{state.error.message}}"
      action-text="继续备考"
      bind:action="openPreparation"
    />
    <state-view
      wx:elif="{{state.status !== 'ready'}}"
      state="{{state.status === 'network' ? 'stale' : 'error'}}"
      title="{{state.error.title}}"
      description="{{state.error.message}}"
      request-id="{{state.error.requestId}}"
      action-text="{{state.error.retryable ? '再试一次' : ''}}"
      bind:action="retry"
    />

    <block wx:else>
      <view wx:if="{{state.summaryView}}" class="detail-heading">
        <text class="detail-heading__location">{{state.summaryView.region}}{{state.summaryView.city ? ' · ' + state.summaryView.city : ''}}</text>
        <view class="detail-heading__title">{{state.summaryView.name}}</view>
        <view class="detail-heading__department">{{state.summaryView.departmentFull}}</view>
      </view>

      <view class="detail-section-title">报考条件核对</view>
      <view class="requirement-summary-card">
        <view wx:if="{{!state.checks.length}}" class="requirement-row">
          <text class="requirement-row__icon requirement-row__icon--success">✓</text>
          <view>
            <view class="requirement-row__title">没有额外卡人的条件</view>
            <view class="requirement-row__copy">报名前，还是以官方公告为准再对一遍。</view>
          </view>
        </view>
        <block wx:for="{{state.checks}}" wx:key="requirementId">
          <view wx:if="{{index > 0}}" class="requirement-divider"></view>
          <view class="requirement-row">
            <text class="requirement-row__icon requirement-row__icon--{{item.statusTone}}">{{item.status === 'met' ? '✓' : '!'}}</text>
            <view class="requirement-row__main">
              <view class="requirement-row__title">{{item.fieldLabel}}</view>
              <view class="requirement-row__copy">{{item.conditionLabel}}</view>
              <view class="requirement-row__evidence">{{item.statusLabel}} · {{item.evidenceLabel}}</view>
              <view wx:if="{{item.operator === 'manual_review'}}" class="requirement-confirm">
                <button hover-class="item--hover" class="requirement-confirm__button tap-tactile" data-requirement-id="{{item.requirementId}}" data-response="satisfied" bindtap="confirmRequirement">符合</button>
                <button hover-class="item--hover" class="requirement-confirm__button tap-tactile" data-requirement-id="{{item.requirementId}}" data-response="uncertain" bindtap="confirmRequirement">不确定</button>
                <button hover-class="item--hover" class="requirement-confirm__button tap-tactile" data-requirement-id="{{item.requirementId}}" data-response="not_satisfied" bindtap="confirmRequirement">不符合</button>
              </view>
              <view wx:if="{{state.confirmingRequirementId === item.requirementId}}" class="requirement-row__saving">正在保存，马上重新核对…</view>
            </view>
          </view>
        </block>
      </view>

      <view class="detail-section-title">竞争和分数差距</view>
      <view class="score-judgement-card">
        <view class="score-orb"></view>
        <view class="score-judgement-card__body">
          <view class="score-line">
            <view>
              <view class="score-line__label">建议备考分数</view>
              <view class="score-line__value">{{state.summaryView.scoreLabel}}</view>
            </view>
            <text wx:if="{{state.fit}}" class="score-gap-pill score-gap-pill--{{state.fit.statusTone}}">{{state.fit.scoreGapRecommendedLabel}}</text>
          </view>
          <view wx:if="{{state.fit}}" class="fit-summary">
            <view class="fit-summary__item">
              <text class="fit-summary__label">岗位分带</text>
              <text class="fit-summary__value">{{state.fit.bandLabel}}</text>
            </view>
            <view class="fit-summary__item">
              <text class="fit-summary__label">当前关系</text>
              <text class="fit-summary__value">{{state.fit.statusLabel}}</text>
            </view>
            <view class="fit-summary__item">
              <text class="fit-summary__label">和你差多少</text>
              <text class="fit-summary__value">{{state.fit.scoreGapRangeLabel}}</text>
            </view>
          </view>
          <button hover-class="item--hover" class="evidence-link" bindtap="openScoreSheet">查看怎么算的 <text class="tiny-chevron">›</text></button>
        </view>
      </view>

      <view class="detail-section-title">这个岗位适不适合你</view>
      <view wx:if="{{state.fit}}" class="personal-fit-card">
        <text class="personal-fit-card__mark">✦</text>
        <view>
          <view class="personal-fit-card__title">{{state.fit.nextActionTitle}}</view>
          <view class="personal-fit-card__copy">{{state.fit.nextActionCopy}}</view>
        </view>
      </view>
      <button hover-class="item--hover" class="anan-context-action" bindtap="askAnan"><text>✦</text><text class="anan-context-action__label">带着这个岗位问岸岸</text><text>›</text></button>

      <view wx:if="{{state.confirmationMessage}}" class="position-success-message">{{state.confirmationMessage}}</view>
      <view wx:if="{{state.commandError}}" class="position-inline-alert">
        {{state.commandError.message}}
        <text wx:if="{{state.commandError.requestId}}"> · 问题编号 {{state.commandError.requestId}}</text>
      </view>
      <view class="detail-bottom-spacer"></view>
    </block>
  </view>

  <view wx:if="{{state && state.status === 'ready'}}" class="detail-actions">
    <view class="detail-actions__row">
      <button hover-class="item--hover" class="control-center detail-actions__compare {{comparisonSelected ? 'detail-actions__compare--selected' : ''}}" bindtap="toggleComparison">
        {{comparisonSelected ? '已加入对比' : '加入对比 (' + comparisonCount + '/3)'}}
      </button>
      <button hover-class="item--hover"
        class="control-center detail-actions__primary {{state.eligibilityStatus !== 'eligible' || state.summaryView.targetScoreExpired ? 'detail-actions__primary--disabled' : ''}} tap-tactile"
        disabled="{{state.eligibilityStatus !== 'eligible' || state.summaryView.targetScoreExpired}}"
        bindtap="openGoalChange"
      >{{state.eligibilityStatus !== 'eligible' ? '资格确认后才能设为目标' : (state.summaryView.targetScoreExpired ? '目标分参考过期啦，重新核对下' : '设为主目标')}}</button>
    </view>
    <button hover-class="item--hover" wx:if="{{comparisonCount >= 2}}" class="detail-actions__compare-link" bindtap="openComparison">看这几个岗位的对比 <text>→</text></button>
  </view>

  <view wx:if="{{scoreSheetOpen}}" class="sheet-mask motion-mask" catchtouchmove="noop" bindtap="closeScoreSheet"></view>
  <view wx:if="{{scoreSheetOpen}}" class="position-sheet evidence-sheet motion-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-header">
      <view class="sheet-title">这个分数线怎么来的</view>
      <button hover-class="item--hover" class="control-center sheet-close" bindtap="closeScoreSheet">×</button>
    </view>
    <view class="evidence-sheet__card">
      <view class="evidence-sheet__label">岗位目标分怎么来的</view>
      <view class="evidence-sheet__copy">{{state.summaryView.scoreEvidenceLabel}}</view>
      <view class="evidence-sheet__copy">{{state.summaryView.targetGeneratedLabel}} · {{state.summaryView.targetValidityLabel}}</view>
    </view>
    <view wx:if="{{state.fit}}" class="evidence-sheet__card">
      <view class="evidence-sheet__label">与你的能力怎么比较</view>
      <view class="evidence-sheet__copy">{{state.fit.statusDescription}}。</view>
      <view class="evidence-sheet__copy">{{state.fit.scoreGapRangeLabel}}；{{state.fit.scoreGapDirectionLabel}}</view>
      <view wx:if="{{state.fit.evidenceReasonLabel}}" class="evidence-sheet__copy">{{state.fit.evidenceReasonLabel}}</view>
    </view>
    <view class="evidence-sheet__note">这是给你的备考参考，不是录取概率。报名条件还是以官方职位表为准。</view>
    <button hover-class="item--hover" class="control-center sheet-button sheet-button--primary tap-tactile" bindtap="closeScoreSheet">明白了</button>
  </view>
</view>
