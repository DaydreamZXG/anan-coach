@import "../../../features/positions/page-shell.wxss";

.briefing-page {
  padding-bottom: 56rpx;
}

.briefing-intro {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.briefing-hero {
  padding: 32rpx;
  border-radius: var(--radius-32);
  color: var(--color-surface);
  background: var(--figma-gradient-dark);
  box-shadow: var(--shadow-elevated);
}

.briefing-hero__meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--text-micro);
  letter-spacing: 1rpx;
}

.briefing-hero__title {
  margin-top: 16rpx;
  font-size: var(--text-title);
  font-weight: 700;
  line-height: 1.3;
}

.briefing-hero__department,
.briefing-hero__location {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: var(--text-body);
  line-height: 1.5;
}

.briefing-section {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: var(--radius-24);
  background: var(--color-surface);
}

.briefing-section__number {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
}

.briefing-section__title {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.briefing-fact,
.briefing-score {
  margin-top: 16rpx;
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.briefing-score {
  font-size: var(--text-section);
}

.briefing-copy,
.briefing-evidence,
.briefing-warning {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--text-body);
  line-height: 1.65;
}

.briefing-evidence {
  color: var(--color-muted);
}

.briefing-warning {
  padding: 20rpx 20rpx;
  border-radius: var(--radius-16);
  color: var(--figma-color-warning-deep);
  background: var(--figma-color-warning-soft);
}

.briefing-boundary {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-24);
  background: var(--good-soft);
}

.briefing-boundary__title {
  color: var(--good);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.briefing-boundary__copy {
  margin-top: 12rpx;
  color: var(--good);
  font-size: var(--text-body);
  line-height: 1.65;
}

.briefing-actions {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}
