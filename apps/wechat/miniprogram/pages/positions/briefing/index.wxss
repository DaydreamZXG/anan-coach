@import "../../../features/positions/page-shell.wxss";

.briefing-page {
  padding-bottom: 56rpx;
}

.briefing-intro {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.briefing-hero {
  padding: 34rpx;
  border-radius: 30rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #005e57 0%, var(--color-primary) 62%, #42bea8 100%);
  box-shadow: 0 20rpx 52rpx rgba(0, 94, 87, 0.18);
}

.briefing-hero__meta {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.briefing-hero__title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 760;
  line-height: 1.3;
}

.briefing-hero__department,
.briefing-hero__location {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.5;
}

.briefing-section {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e6e9f2;
  border-radius: 26rpx;
  background: #ffffff;
}

.briefing-section__number {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 750;
}

.briefing-section__title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 750;
}

.briefing-fact,
.briefing-score {
  margin-top: 16rpx;
  color: var(--color-primary-deep);
  font-size: 30rpx;
  font-weight: 720;
}

.briefing-score {
  font-size: 32rpx;
}

.briefing-copy,
.briefing-evidence,
.briefing-warning {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.briefing-evidence {
  color: var(--color-primary-deep);
}

.briefing-warning {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #725019;
  background: #fff8e8;
}

.briefing-boundary {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #eef7f4;
}

.briefing-boundary__title {
  color: #175d4b;
  font-size: 28rpx;
  font-weight: 720;
}

.briefing-boundary__copy {
  margin-top: 10rpx;
  color: #42685f;
  font-size: 25rpx;
  line-height: 1.65;
}

.briefing-actions {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}
