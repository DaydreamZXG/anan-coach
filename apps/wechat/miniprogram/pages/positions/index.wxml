<view class="s9-page position-page position-workspace">
  <view class="position-hero">
    <view class="position-hero__copy">
      <view class="s9-kicker"><text class="position-hero__dot"></text>国考岗位助手</view>
      <view class="s9-title">先确认能不能报，<text class="position-hero__accent">再看差多少。</text></view>
      <view class="s9-subtitle">先按专业、学历和经历筛出可报岗位，再结合地区与成绩看备考分差。</view>
    </view>
    <anan-companion size="medium" intent="thinking" context="plan" animate />
  </view>

  <view class="position-actions">
    <ui-button custom-class="position-actions__button" label="开始筛选岗位" bind:action="openSearch" />
    <view hover-class="item--hover" class="position-actions__link" bindtap="openScoreSheet">补成绩，计算分差</view>
    <view hover-class="item--hover" class="position-actions__link" bindtap="openQualificationProfile">核对我的报考资料</view>
  </view>

  <view class="position-boundary"><text class="position-boundary__mark">◇</text><text>岗位分差只用于备考定位，不代表录取概率。</text></view>

  <state-view wx:if="{{!workspace || workspace.status === 'idle' || workspace.status === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{workspace.status === 'needsProfile'}}"
    state="empty"
    title="先补完整报考资料"
    description="填好学历、专业和经历，岸岸才能帮你筛出真正能报的岗位。"
    action-text="去补资料"
    bind:action="openOnboarding"
  />
  <state-view
    wx:elif="{{workspace.status === 'noActiveRelease'}}"
    state="empty"
    title="本年度岗位尚未正式发布"
    description="岗位数据还没更新，先不给你看过时的信息。"
  />
  <state-view
    wx:elif="{{workspace.status !== 'ready' && workspace.status !== 'empty'}}"
    state="{{workspace.status === 'network' ? 'stale' : 'error'}}"
    title="{{workspace.error.title}}"
    description="{{workspace.error.message}}"
    request-id="{{workspace.error.requestId}}"
    action-text="重新加载"
    bind:action="retryPositions"
  />

  <block wx:else>
    <view wx:if="{{workspace.delivery}}" class="delivery-strip">
      <view class="delivery-strip__mark">岸</view>
      <view class="delivery-strip__main">
        <text class="delivery-strip__title">已按你的报考资料完成筛选</text>
        <text class="delivery-strip__copy">{{workspace.examYear}} 国考岗位 · 更新于 {{workspace.delivery.generatedAtLabel}}</text>
      </view>
      <text wx:if="{{workspace.delivery.partial}}" class="delivery-strip__warning">{{workspace.delivery.partialLabel}}</text>
      <text wx:if="{{workspace.delivery.stale}}" class="delivery-strip__warning">{{workspace.delivery.staleLabel}}</text>
      <text wx:if="{{workspace.delivery.processing}}" class="delivery-strip__processing">{{workspace.delivery.processingLabel}}</text>
    </view>
    <view wx:if="{{workspace.refreshError}}" class="inline-warning">
      <view>没刷新成功，先看着之前的内容。</view>
      <view hover-class="item--hover" class="inline-link" bindtap="retryPositions">重新加载 · {{workspace.refreshError.requestId}}</view>
    </view>

    <view class="section-heading">
      <view class="section-title">我的主目标</view>
      <view class="section-meta">它会决定今天练什么</view>
    </view>
    <view wx:if="{{workspace.primaryGoal}}" class="position-card position-card--primary" hover-class="card--hover" data-id="{{workspace.primaryGoal.positionId}}" bindtap="openPosition">
      <view class="position-card__top">
        <view class="status-pill status-pill--{{workspace.primaryGoal.eligibilityTone}}">{{workspace.primaryGoal.eligibilityLabel}}</view>
        <view class="primary-tag">当前主目标</view>
      </view>
      <view class="position-card__name">{{workspace.primaryGoal.name}}</view>
      <view class="position-card__department">{{workspace.primaryGoal.departmentFull}}</view>
      <view class="position-card__metrics">
        <view class="position-metric"><text class="position-card__metric-label">建议备考线</text><text class="position-card__metric-value type-data">{{workspace.primaryGoal.scoreLabel}}</text></view>
        <view class="position-metric"><text class="position-card__metric-label">岗位分带</text><text class="position-card__metric-value">{{workspace.primaryGoal.fitView.bandLabel}}</text></view>
      </view>
      <view class="position-card__evidence">{{workspace.primaryGoal.scoreEvidenceLabel}} · {{workspace.primaryGoal.targetGeneratedLabel}} · {{workspace.primaryGoal.targetValidityLabel}}</view>
      <view class="position-card__fit">
        <view class="status-pill status-pill--{{workspace.primaryGoal.fitView.statusTone}}">{{workspace.primaryGoal.fitView.statusLabel}}</view>
        <text class="position-card__fit-copy">{{workspace.primaryGoal.fitView.scoreGapRecommendedLabel}} · {{workspace.primaryGoal.fitView.evidenceStatusLabel}}</text>
      </view>
      <view class="fit-next-step fit-next-step--{{workspace.primaryGoal.fitView.statusTone}}">
        <view class="fit-next-step__title">{{workspace.primaryGoal.fitView.nextActionTitle}}</view>
        <view class="fit-next-step__copy">{{workspace.primaryGoal.fitView.nextActionCopy}}</view>
      </view>
    </view>
    <view wx:else class="capability-card capability-card--neutral">
      <view class="capability-card__mark">下一步</view>
      <view class="capability-card__title">从下面的可报候选里选一个主目标</view>
      <view class="capability-card__copy">选定后，岸岸会用这个岗位反推每日训练。补齐行测和申论成绩后，再计算可以展开查看依据的分差。</view>
      <view class="capability-actions">
        <view hover-class="item--hover" class="inline-link" bindtap="openSearch">查看更多可报岗位 →</view>
        <view hover-class="item--hover" class="inline-link" bindtap="openScoreSheet">先录入双科成绩 →</view>
      </view>
    </view>

    <view class="section-heading">
      <view class="section-title">你可以报的岗位</view>
      <view class="section-meta">先选目标，再看分差</view>
    </view>
    <view class="position-card-grid">
    <view wx:for="{{workspace.candidateItems}}" wx:key="positionId" class="position-card" hover-class="card--hover" data-id="{{item.positionId}}" bindtap="openPosition">
      <view class="position-card__top">
        <view class="status-pill status-pill--{{item.eligibilityTone}}">{{item.eligibilityLabel}}</view>
        <view class="position-code">{{item.positionCode}}</view>
      </view>
      <view class="position-card__name">{{item.name}}</view>
      <view class="position-card__department">{{item.departmentFull}}</view>
      <view class="position-card__meta">{{item.region}}{{item.city ? ' · ' + item.city : ''}} · 招 {{item.headcount}} 人</view>
      <view class="position-card__metrics">
        <view class="position-metric"><text class="position-card__metric-label">{{item.fitView.bandLabel}}</text><text class="position-card__metric-value">{{item.fitView.statusDescription}}</text></view>
        <view class="position-metric"><text class="position-card__metric-label">分差状态</text><text class="position-card__metric-value type-data">{{item.fitView.scoreGapRangeLabel}}</text></view>
      </view>
      <view class="position-card__evidence">{{item.scoreEvidenceLabel}} · {{item.targetGeneratedLabel}} · {{item.targetValidityLabel}}</view>
      <view class="fit-evidence fit-evidence--{{item.fitView.statusTone}}">
        <view>{{item.fitView.evidenceStatusLabel}} · {{item.fitView.requirementsBurdenLabel}}</view>
        <text wx:if="{{item.fitView.evidenceReasonLabel}}" class="fit-evidence__reason">{{item.fitView.evidenceReasonLabel}}</text>
        <text wx:if="{{item.fitView.scoreGapDirectionLabel}}">{{item.fitView.scoreGapDirectionLabel}}</text>
        <view hover-class="item--hover" wx:if="{{!item.fitView.scoreGapAvailable}}" class="inline-link fit-evidence__action" catchtap="openScoreSheet">补成绩后计算分差 →</view>
      </view>
      <view class="fit-next-step fit-next-step--{{item.fitView.statusTone}}">
        <view class="fit-next-step__title">{{item.fitView.nextActionTitle}}</view>
        <view class="fit-next-step__copy">{{item.fitView.nextActionCopy}}</view>
      </view>
      <view class="position-card__footer">
        <view hover-class="item--hover" class="compare-toggle {{item.comparisonSelected ? 'compare-toggle--selected' : ''}}" data-id="{{item.positionId}}" catchtap="toggleComparison">{{item.comparisonSelected ? '✓ 已加入对比' : '＋ 加入对比'}}</view>
        <view>查看依据 / 设为主目标 →</view>
      </view>
    </view>
    </view>
    <view wx:if="{{workspace.status === 'empty'}}" class="empty-inline">按当前资料还没找到可报岗位。先核对专业、学历和经历，再重新筛选。</view>
    <view wx:elif="{{!workspace.candidateItems.length}}" class="empty-inline">暂时没有其他候选岗位，可以进入搜索查看完整范围。</view>

    <view class="section-heading">
      <view class="section-title">资格缺口</view>
      <view class="section-meta">只列影响岗位判断的事实</view>
    </view>
    <view wx:if="{{workspace.qualificationStatus === 'loading'}}" class="card"><text class="muted">正在按你的资料重新核对…</text></view>
    <view wx:elif="{{workspace.qualificationStatus === 'error'}}" class="inline-error">
      <view>{{workspace.qualificationError.message}}</view>
      <view hover-class="item--hover" class="inline-link" bindtap="retryQualification">重试 · {{workspace.qualificationError.requestId}}</view>
    </view>
    <view wx:elif="{{workspace.qualificationComplete}}" class="success-card">当前没有待补资格信息；不可报结论仍保留逐条依据。</view>
    <view wx:else>
      <view wx:for="{{workspace.qualificationGaps}}" wx:key="gapKey" class="gap-row">
        <view>
          <view class="gap-row__title">{{item.factLabel}} · {{item.statusLabel}}</view>
          <view class="gap-row__copy">影响 {{item.affectedPositionCount}} 个岗位</view>
        </view>
        <view hover-class="item--hover" class="inline-link" data-action="{{item.action}}" data-code="{{item.samplePositionCodes[0]}}" bindtap="openGapAction">{{item.actionLabel}} →</view>
      </view>
    </view>

    <view class="section-heading">
      <view class="section-title">我的成绩</view>
      <view class="section-meta">补齐两科才能算分差</view>
    </view>
    <view wx:if="{{workspace.ability}}" class="ability-card">
      <view class="ability-card__head">
        <view><view class="ability-card__kicker">分差计算准备</view><view class="ability-card__title">{{workspace.ability.statusLabel}}</view></view>
        <view class="status-pill">{{workspace.ability.confidenceLabel}}</view>
      </view>
      <view class="ability-card__scores">
        <view class="ability-score"><text class="ability-score__label">行测</text><text class="ability-score__value type-data">{{workspace.ability.xingceLabel}}</text></view>
        <view class="ability-score"><text class="ability-score__label">申论</text><text class="ability-score__value type-data">{{workspace.ability.shenlunLabel}}</text></view>
        <view class="ability-score"><text class="ability-score__label">总分</text><text class="ability-score__value type-data">{{workspace.ability.totalLabel}}</text></view>
      </view>
      <view class="ability-card__copy">{{workspace.ability.evidenceLabel}}</view>
      <view class="ability-card__copy">{{workspace.ability.missingLabel}} · {{workspace.ability.gapBlockDetail}}</view>
      <view wx:if="{{workspace.ability.conflictLabel}}" class="inline-warning">{{workspace.ability.conflictLabel}}</view>
      <view hover-class="item--hover" class="inline-link" bindtap="openScoreSheet">{{workspace.ability.readiness === 'unavailable' ? '录入成绩' : '补充新的成绩记录'}} →</view>
    </view>
  </block>

  <view wx:if="{{workspace && workspace.selectedIds.length > 0}}" class="comparison-dock">
    <view class="comparison-dock__summary"><text class="comparison-dock__title">已选 {{workspace.selectedIds.length}} / 3</text><text class="comparison-dock__note">{{workspace.selectedIds.length < 2 ? '再选 1 个开始对比' : '会重新对齐岗位和分差'}}</text></view>
    <view class="comparison-dock__clear" bindtap="clearComparison">清空</view>
    <view class="comparison-dock__action {{workspace.selectedIds.length < 2 ? 'comparison-dock__action--disabled' : ''}}" bindtap="openComparison">对比</view>
  </view>

  <view wx:if="{{score && score.open}}" class="sheet-mask" catchtouchmove="noop" bindtap="closeScoreSheet"></view>
  <view wx:if="{{score && score.open}}" class="position-sheet score-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-header">
      <view><view class="eyebrow">成绩 · 本人确认</view><view class="sheet-title">{{score.supersedesEvidenceId ? '修正这条成绩记录' : '记录真实单科分'}}</view></view>
      <view class="sheet-close" bindtap="closeScoreSheet">×</view>
    </view>
    <view class="sheet-copy">行测与申论分别记录；只有同一口径下两科都完整时，才会生成总分估计。</view>
    <view class="subsection-head"><view>历史记录</view><view hover-class="item--hover" wx:if="{{score.supersedesEvidenceId}}" class="inline-link" bindtap="startNewScoreEvidence">改为新增</view></view>
    <view wx:if="{{score.historyStatus === 'loading'}}" class="empty-inline">正在读取历史版本…</view>
    <view wx:elif="{{score.historyStatus === 'error'}}" class="inline-error"><view>{{score.historyError.message}}</view><view hover-class="item--hover" class="inline-link" bindtap="retryScoreHistory">重试</view></view>
    <view wx:elif="{{!score.history.length}}" class="empty-inline">还没有成绩记录，这次是第一条。</view>
    <scroll-view wx:else class="history-scroll" scroll-y>
      <view wx:for="{{score.history}}" wx:key="evidenceId" class="history-row {{item.active ? '' : 'history-row--inactive'}}">
        <view><view>{{item.contextLabel}} · {{item.dateLabel}}</view><text class="history-row__meta">{{item.scoreLabel}} · {{item.statusLabel}}</text></view>
        <view hover-class="item--hover" wx:if="{{item.active}}" class="inline-link" data-id="{{item.evidenceId}}" bindtap="beginScoreCorrection">修正</view>
      </view>
    </scroll-view>
    <view class="form-label">成绩来自</view>
    <view class="choice-row">
      <view hover-class="item--hover" class="choice {{score.scoreContext === 'official_exam' ? 'choice--active' : ''}}" data-value="official_exam" bindtap="chooseScoreContext">正式考试</view>
      <view hover-class="item--hover" class="choice {{score.scoreContext === 'full_mock' ? 'choice--active' : ''}}" data-value="full_mock" bindtap="chooseScoreContext">整卷模考</view>
      <view hover-class="item--hover" class="choice {{score.scoreContext === 'historical_estimate' ? 'choice--active' : ''}}" data-value="historical_estimate" bindtap="chooseScoreContext">历史估分</view>
    </view>
    <view class="score-inputs">
      <view class="score-input"><text class="score-input__label">行测</text><input class="score-input__control" type="digit" value="{{score.xingceScore}}" disabled="{{score.saving || score.submissionUncertain}}" placeholder="0–100" bindinput="inputXingceScore" /></view>
      <view class="score-input"><text class="score-input__label">申论</text><input class="score-input__control" type="digit" value="{{score.shenlunScore}}" disabled="{{score.saving || score.submissionUncertain}}" placeholder="0–100" bindinput="inputShenlunScore" /></view>
    </view>
    <view class="form-label">是否按规定限时完成</view>
    <view class="choice-row">
      <view hover-class="item--hover" class="choice {{score.scoreTimedStatus === 'timed' ? 'choice--active' : ''}}" data-value="timed" bindtap="chooseTimedStatus">是</view>
      <view hover-class="item--hover" class="choice {{score.scoreTimedStatus === 'untimed' ? 'choice--active' : ''}}" data-value="untimed" bindtap="chooseTimedStatus">否</view>
      <view hover-class="item--hover" class="choice {{score.scoreTimedStatus === 'unknown' ? 'choice--active' : ''}}" data-value="unknown" bindtap="chooseTimedStatus">不确定</view>
    </view>
    <view class="date-row"><text>作答日期</text><picker mode="date" value="{{score.scoreDate}}" end="{{score.todayDate}}" disabled="{{score.saving || score.submissionUncertain}}" bindchange="chooseScoreDate"><view>{{score.scoreDate}} ›</view></picker></view>
    <view wx:if="{{score.validationError}}" class="inline-error">{{score.validationError}}</view>
    <view wx:if="{{score.error}}" class="inline-error"><view>{{score.error.message}}</view><view wx:if="{{score.submissionUncertain}}">刚才的结果还不确定，请直接重试；内容已暂时锁定，不会重复保存。</view><view wx:if="{{score.error.requestId}}">问题编号 · {{score.error.requestId}}</view></view>
    <view class="sheet-actions">
      <ui-button label="取消" variant="secondary" disabled="{{score.submissionUncertain}}" bind:action="closeScoreSheet" />
      <ui-button label="{{score.submissionUncertain ? '确认刚才结果' : (score.supersedesEvidenceId ? '保存修正' : '确认记录')}}" loading="{{score.saving}}" bind:action="submitScoreEvidence" />
    </view>
  </view>
</view>
