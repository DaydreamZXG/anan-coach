<view class="position-screen position-screen--dock">
  <safe-top gap="8" />

  <view class="position-nav">
    <button class="position-nav__back" bindtap="goBack" aria-label="返回"><text class="position-nav__chevron"></text></button>
  </view>

  <view class="position-content">
    <view class="position-page-title">岗位决策台</view>

    <state-view wx:if="{{!workspace || workspace.status === 'idle' || workspace.status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{workspace.status === 'needsProfile'}}"
      state="empty"
      title="先补完整报考资料"
      description="填好学历、专业和经历，岸岸才能筛出真正能报的岗位。"
      action-text="去补资料"
      bind:action="openQualificationProfile"
    />
    <state-view
      wx:elif="{{workspace.status === 'noActiveRelease'}}"
      state="empty"
      title="本年度岗位尚未正式发布"
      description="正式职位表发布后，这里会按你的资格自动筛选。"
    />
    <state-view
      wx:elif="{{workspace.status !== 'ready' && workspace.status !== 'empty'}}"
      state="{{workspace.status === 'network' ? 'stale' : 'error'}}"
      title="{{workspace.error.title}}"
      description="{{workspace.error.message}}"
      request-id="{{workspace.error.requestId}}"
      action-text="重新加载"
      bind:action="retryPositions"
    />

    <block wx:else>
      <view class="profile-context-card">
        <view class="context-orb"></view>
        <view class="context-card__body">
          <view class="context-card__kicker">岸岸已载入你的报考档案</view>
          <view class="context-chips">
            <text class="context-chip">{{workspace.examYear}} 国考</text>
            <text class="context-chip">{{workspace.qualificationComplete ? '资料已完整' : '资料待确认'}}</text>
            <text wx:if="{{workspace.ability}}" class="context-chip">{{workspace.ability.statusLabel}}</text>
          </view>
          <view class="context-card__divider"></view>
          <view class="context-card__summary">
            <view class="context-card__count">
              <text class="sparkle-mark">✦</text>
              <text>已筛出 <text class="context-card__number">{{workspace.items.length}}</text> 个可报岗位</text>
            </view>
            <button class="context-card__link" bindtap="openSearch">查看全部 <text class="tiny-chevron">›</text></button>
          </view>
        </view>
      </view>

      <view wx:if="{{workspace.refreshError}}" class="position-inline-alert">
        岗位信息暂时没有更新成功。
        <button class="text-action" bindtap="retryPositions">重新加载</button>
      </view>
      <view wx:if="{{workspace.delivery && (workspace.delivery.partial || workspace.delivery.stale)}}" class="position-inline-alert">
        {{workspace.delivery.partial ? workspace.delivery.partialLabel : workspace.delivery.staleLabel}}
      </view>

      <block wx:if="{{workspace.primaryGoal}}">
        <view class="position-section-title">当前主目标</view>
        <view class="discovery-card discovery-card--primary" hover-class="item--hover" data-id="{{workspace.primaryGoal.positionId}}" bindtap="openPosition">
          <view class="position-card__eyebrow">{{workspace.primaryGoal.departmentFull}}</view>
          <view class="position-card__title">{{workspace.primaryGoal.name}}</view>
          <view class="position-tag-row">
            <text class="position-tag position-tag--primary">当前主目标</text>
            <text class="position-tag">{{workspace.primaryGoal.region}}{{workspace.primaryGoal.city ? ' · ' + workspace.primaryGoal.city : ''}}</text>
            <text class="position-tag">{{workspace.primaryGoal.fitView.bandLabel}}</text>
          </view>
          <view class="position-insight position-insight--primary">
            <text class="position-insight__mark">✦</text>
            <text class="position-insight__copy">{{workspace.primaryGoal.fitView.nextActionCopy}}</text>
          </view>
        </view>
      </block>

      <view class="position-section-title">{{workspace.primaryGoal ? '其他适合你的岗位' : '为你筛出的优势岗位'}} ({{workspace.candidateItems.length}})</view>
      <view class="discovery-list">
        <view
          wx:for="{{workspace.candidateItems}}"
          wx:key="positionId"
          class="discovery-card"
          hover-class="item--hover"
          data-id="{{item.positionId}}"
          bindtap="openPosition"
        >
          <view class="position-card__eyebrow">{{item.departmentFull}}</view>
          <view class="position-card__title">{{item.name}}</view>
          <view class="position-tag-row">
            <text class="position-tag position-tag--{{item.eligibilityTone}}">{{item.eligibilityLabel}}</text>
            <text class="position-tag">{{item.region}}{{item.city ? ' · ' + item.city : ''}}</text>
            <text class="position-tag">招 {{item.headcount}} 人</text>
          </view>
          <view class="position-insight {{item.fitView.statusTone === 'success' ? 'position-insight--cyan' : ''}}">
            <text class="position-insight__mark">{{item.fitView.statusTone === 'success' ? '⌖' : '✦'}}</text>
            <text class="position-insight__copy">{{item.fitView.nextActionCopy}}</text>
          </view>
          <view class="position-card__actions">
            <button
              class="compare-link {{item.comparisonSelected ? 'compare-link--selected' : ''}}"
              data-id="{{item.positionId}}"
              catchtap="toggleComparison"
            >{{item.comparisonSelected ? '✓ 已加入对比' : '＋ 加入对比'}}</button>
            <text class="position-card__open">查看详情 ›</text>
          </view>
        </view>
      </view>

      <view wx:if="{{workspace.status === 'empty' || !workspace.candidateItems.length && !workspace.primaryGoal}}" class="position-empty-card">
        <view class="position-empty-card__title">暂时没有匹配岗位</view>
        <view class="position-empty-card__copy">核对专业、学历和经历后，再重新筛选。</view>
        <button class="secondary-pill" bindtap="openQualificationProfile">核对报考资料</button>
      </view>

      <view wx:if="{{!workspace.qualificationComplete}}" class="compact-action-card">
        <view>
          <view class="compact-action-card__title">还有 {{workspace.qualificationGaps.length}} 项资料待确认</view>
          <view class="compact-action-card__copy">补完整后，岗位判断会自动更新。</view>
        </view>
        <button class="compact-action-card__button" bindtap="openQualificationProfile">去确认</button>
      </view>

      <view class="quiet-actions">
        <button class="quiet-action" bindtap="openScoreSheet">记录成绩，计算分差</button>
        <button class="quiet-action" bindtap="openQualificationProfile">修改报考资料</button>
      </view>
    </block>
  </view>

  <view wx:if="{{workspace && workspace.selectedIds.length > 0}}" class="comparison-dock">
    <view class="comparison-dock__summary">
      <text class="comparison-dock__title">已选 {{workspace.selectedIds.length}} / 3</text>
      <text class="comparison-dock__note">{{workspace.selectedIds.length < 2 ? '再选 1 个开始对比' : '可以横向比较资格和分差'}}</text>
    </view>
    <button class="comparison-dock__clear" bindtap="clearComparison">清空</button>
    <button class="comparison-dock__action {{workspace.selectedIds.length < 2 ? 'comparison-dock__action--disabled' : ''}}" disabled="{{workspace.selectedIds.length < 2}}" bindtap="openComparison">对比</button>
  </view>

  <view wx:if="{{score && score.open}}" class="sheet-mask" catchtouchmove="noop" bindtap="closeScoreSheet"></view>
  <view wx:if="{{score && score.open}}" class="position-sheet score-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-header">
      <view>
        <view class="sheet-kicker">成绩记录</view>
        <view class="sheet-title">{{score.supersedesEvidenceId ? '修正这条成绩' : '记录真实单科分'}}</view>
      </view>
      <button class="sheet-close" bindtap="closeScoreSheet">×</button>
    </view>
    <view class="sheet-copy">行测与申论分别记录；只有同一口径下两科都完整时，才计算总分与岗位分差。</view>

    <view class="sheet-subhead">
      <text>历史记录</text>
      <button wx:if="{{score.supersedesEvidenceId}}" class="text-action" bindtap="startNewScoreEvidence">改为新增</button>
    </view>
    <view wx:if="{{score.historyStatus === 'loading'}}" class="sheet-empty">正在读取历史成绩…</view>
    <view wx:elif="{{score.historyStatus === 'error'}}" class="sheet-error">
      <text>{{score.historyError.message}}</text>
      <button class="text-action" bindtap="retryScoreHistory">重试</button>
    </view>
    <view wx:elif="{{!score.history.length}}" class="sheet-empty">还没有成绩记录，这次是第一条。</view>
    <scroll-view wx:else class="history-scroll" scroll-y>
      <view wx:for="{{score.history}}" wx:key="evidenceId" class="history-row {{item.active ? '' : 'history-row--inactive'}}">
        <view>
          <view class="history-row__title">{{item.contextLabel}} · {{item.dateLabel}}</view>
          <view class="history-row__meta">{{item.scoreLabel}} · {{item.statusLabel}}</view>
        </view>
        <button wx:if="{{item.active}}" class="text-action" data-id="{{item.evidenceId}}" bindtap="beginScoreCorrection">修正</button>
      </view>
    </scroll-view>

    <view class="form-label">成绩来自</view>
    <view class="choice-row">
      <button class="choice {{score.scoreContext === 'official_exam' ? 'choice--active' : ''}}" data-value="official_exam" bindtap="chooseScoreContext">正式考试</button>
      <button class="choice {{score.scoreContext === 'full_mock' ? 'choice--active' : ''}}" data-value="full_mock" bindtap="chooseScoreContext">整卷模考</button>
      <button class="choice {{score.scoreContext === 'historical_estimate' ? 'choice--active' : ''}}" data-value="historical_estimate" bindtap="chooseScoreContext">历史估分</button>
    </view>
    <view class="score-inputs">
      <label class="score-input"><text>行测</text><input class="score-input__control" type="digit" value="{{score.xingceScore}}" disabled="{{score.saving || score.submissionUncertain}}" placeholder="0–100" bindinput="inputXingceScore" /></label>
      <label class="score-input"><text>申论</text><input class="score-input__control" type="digit" value="{{score.shenlunScore}}" disabled="{{score.saving || score.submissionUncertain}}" placeholder="0–100" bindinput="inputShenlunScore" /></label>
    </view>
    <view class="form-label">是否按规定限时完成</view>
    <view class="choice-row">
      <button class="choice {{score.scoreTimedStatus === 'timed' ? 'choice--active' : ''}}" data-value="timed" bindtap="chooseTimedStatus">是</button>
      <button class="choice {{score.scoreTimedStatus === 'untimed' ? 'choice--active' : ''}}" data-value="untimed" bindtap="chooseTimedStatus">否</button>
      <button class="choice {{score.scoreTimedStatus === 'unknown' ? 'choice--active' : ''}}" data-value="unknown" bindtap="chooseTimedStatus">不确定</button>
    </view>
    <picker mode="date" value="{{score.scoreDate}}" end="{{score.todayDate}}" disabled="{{score.saving || score.submissionUncertain}}" bindchange="chooseScoreDate">
      <view class="date-row"><text>作答日期</text><text>{{score.scoreDate}} ›</text></view>
    </picker>
    <view wx:if="{{score.validationError}}" class="sheet-error">{{score.validationError}}</view>
    <view wx:if="{{score.error}}" class="sheet-error">
      <view>{{score.error.message}}</view>
      <view wx:if="{{score.submissionUncertain}}">请确认刚才的保存结果，内容不会重复写入。</view>
      <view wx:if="{{score.error.requestId}}">问题编号 · {{score.error.requestId}}</view>
    </view>
    <view class="sheet-actions">
      <button class="sheet-button sheet-button--secondary" disabled="{{score.submissionUncertain}}" bindtap="closeScoreSheet">取消</button>
      <button class="sheet-button sheet-button--primary" bindtap="submitScoreEvidence">{{score.submissionUncertain ? '确认刚才结果' : (score.supersedesEvidenceId ? '保存修正' : '确认记录')}}</button>
    </view>
  </view>
</view>
