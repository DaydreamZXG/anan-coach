<view class="s9-page position-page position-search-page">
  <view class="s9-hero">
    <view class="s9-kicker">岗位筛选</view>
    <view class="s9-title">先筛能报的，再看值不值得冲</view>
    <view class="s9-subtitle">资格档案先排除不符合项，再按关键词和地区缩小范围。</view>
  </view>

  <view class="filter-card">
    <view class="search-input"><text>⌕</text><input class="search-input__control" value="{{state.filters.query}}" placeholder="部门、职位名称或职位代码" confirm-type="search" bindinput="inputQuery" bindconfirm="search" /></view>
    <view class="filter-grid">
      <view class="filter-grid__item"><text class="filter-grid__label">考试年度</text><input class="filter-grid__control" type="number" maxlength="4" value="{{state.filters.examYear}}" placeholder="当前发布" bindinput="inputExamYear" /></view>
      <view class="filter-grid__item"><text class="filter-grid__label">省份</text><input class="filter-grid__control" value="{{state.filters.region}}" placeholder="不限" bindinput="inputRegion" /></view>
      <view class="filter-grid__item"><text class="filter-grid__label">城市</text><input class="filter-grid__control" value="{{state.filters.city}}" placeholder="不限" bindinput="inputCity" /></view>
    </view>
    <view class="filter-actions">
      <ui-button label="清除" variant="secondary" bind:action="clearFilters" />
      <ui-button label="按资格筛选" bind:action="search" />
    </view>
    <view wx:if="{{state.validationError}}" class="inline-error">{{state.validationError}}</view>
  </view>

  <state-view wx:if="{{!state || state.status === 'idle' || state.status === 'loading'}}" state="loading" />
  <state-view
    wx:elif="{{state.status === 'needsProfile'}}"
    state="empty"
    title="先完成资格建档"
    description="先完成建档，才能按你的真实条件搜索岗位。"
    request-id="{{state.error.requestId}}"
    action-text="去建档"
    bind:action="openOnboarding"
  />
  <state-view
    wx:elif="{{state.status === 'noActiveRelease'}}"
    state="empty"
    title="本年度岗位尚未正式发布"
    description="岗位数据还没更新，请稍后再试。"
    request-id="{{state.error.requestId}}"
  />
  <state-view
    wx:elif="{{state.status !== 'ready' && state.status !== 'empty'}}"
    state="{{state.status === 'network' ? 'stale' : 'error'}}"
    title="{{state.error.title}}"
    description="{{state.error.message}}"
    request-id="{{state.error.requestId}}"
    action-text="重新加载"
    bind:action="retry"
  />
  <state-view
    wx:elif="{{state.status === 'empty'}}"
    state="empty"
    title="没有匹配的岗位"
    description="按你的条件和筛选没有找到岗位，换个地区或关键词试试。"
    action-text="清除筛选"
    bind:action="clearFilters"
  />

  <block wx:else>
    <view class="delivery-strip">
      <text>档案 v{{state.learnerProfileVersion}} · 规则 {{state.ruleSetVersion}}</text>
      <text>生成 {{state.delivery.generatedAtLabel}}</text>
      <text wx:if="{{state.delivery.partial}}" class="delivery-strip__warning">{{state.delivery.partialLabel}}</text>
      <text wx:if="{{state.delivery.stale}}" class="delivery-strip__warning">{{state.delivery.staleLabel}}</text>
      <text wx:if="{{state.delivery.processing}}" class="delivery-strip__processing">{{state.delivery.processingLabel}}</text>
    </view>
    <view class="section-heading"><view class="section-title">筛选结果</view><view class="section-meta">已加载 {{state.items.length}} 个</view></view>
    <view class="position-card-grid">
    <view hover-class="item--hover" wx:for="{{state.items}}" wx:key="positionId" class="position-card" data-id="{{item.positionId}}" bindtap="openPosition">
      <view class="position-card__top"><view class="status-pill status-pill--{{item.eligibilityTone}}">{{item.eligibilityLabel}}</view><view class="position-code">{{item.positionCode}}</view></view>
      <view class="position-card__name">{{item.name}}</view>
      <view class="position-card__department">{{item.departmentFull}}</view>
      <view class="position-card__meta">{{item.region}}{{item.city ? ' · ' + item.city : ''}} · 招 {{item.headcount}} 人</view>
      <view class="position-card__metrics"><view class="position-metric"><text class="position-card__metric-label">资格核验</text><text class="position-card__metric-value">{{item.conditionSummary}}</text></view><view class="position-metric"><text class="position-card__metric-label">建议备考线</text><text class="position-card__metric-value type-data">{{item.scoreLabel}}</text></view></view>
      <view class="position-card__evidence">{{item.scoreEvidenceLabel}} · {{item.targetGeneratedLabel}} · {{item.targetValidityLabel}}</view>
      <view class="position-card__footer"><view hover-class="item--hover" class="compare-toggle {{item.comparisonSelected ? 'compare-toggle--selected' : ''}}" data-id="{{item.positionId}}" catchtap="toggleComparison">{{item.comparisonSelected ? '✓ 已加入对比' : '＋ 加入对比'}}</view><view>查看依据 →</view></view>
    </view>
    </view>
    <view wx:if="{{state.paginationStatus === 'error'}}" class="inline-error"><view>{{state.paginationError.message}}</view><view hover-class="item--hover" class="inline-link" bindtap="loadMore">继续加载 · {{state.paginationError.requestId}}</view></view>
    <view wx:elif="{{state.paginationStatus === 'loading'}}" class="load-more">正在加载下一页…</view>
    <view hover-class="item--hover" wx:elif="{{state.hasMore}}" class="load-more" bindtap="loadMore">加载更多</view>
    <view wx:else class="list-end">已展示当前条件下的全部岗位</view>
  </block>

  <view wx:if="{{state && state.selectedIds.length > 0}}" class="comparison-dock">
    <view class="comparison-dock__summary"><text class="comparison-dock__title">已选 {{state.selectedIds.length}} / 3</text><text class="comparison-dock__note">{{state.selectedIds.length < 2 ? '再选 1 个开始对比' : '按你当前资料重新核验'}}</text></view>
    <view class="comparison-dock__clear" bindtap="clearComparison">清空</view>
    <view class="comparison-dock__action {{state.selectedIds.length < 2 ? 'comparison-dock__action--disabled' : ''}}" bindtap="openComparison">对比</view>
  </view>
</view>
