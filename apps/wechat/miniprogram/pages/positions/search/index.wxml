<view class="s9-screen position-screen position-screen--dock">
  <workbench-nav
    id="runtime-workbench-nav"
    title="全部可选岗位{{state && state.status === 'ready' ? ' (' + state.items.length + ')' : ''}}"
    back-behavior="emit"
    bind:back="goBack"
  />

  <view class="position-search-panel">
    <label class="position-search-input">
      <text class="search-mark"></text>
      <input
        class="position-search-input__control"
        value="{{state.filters.query}}"
        placeholder="搜索单位、岗位或地点"
        confirm-type="search"
        bindinput="inputQuery"
        bindconfirm="search"
      />
    </label>
    <scroll-view class="filter-strip" scroll-x enable-flex>
      <label class="filter-pill">
        <text>年份</text>
        <input class="filter-pill__input filter-pill__input--year" type="number" maxlength="4" value="{{state.filters.examYear}}" placeholder="当前" bindinput="inputExamYear" />
      </label>
      <label class="filter-pill">
        <text>省份</text>
        <input class="filter-pill__input" value="{{state.filters.region}}" placeholder="不限" bindinput="inputRegion" />
      </label>
      <label class="filter-pill">
        <text>城市</text>
        <input class="filter-pill__input" value="{{state.filters.city}}" placeholder="不限" bindinput="inputCity" />
      </label>
      <button hover-class="item--hover" class="filter-pill filter-pill--action" bindtap="search">筛选</button>
      <button hover-class="item--hover" class="filter-pill filter-pill--quiet" bindtap="clearFilters">清除</button>
    </scroll-view>
    <view wx:if="{{state.validationError}}" class="position-inline-alert">{{state.validationError}}</view>
  </view>

  <view class="position-content position-content--list">
    <state-view wx:if="{{!state || state.status === 'idle' || state.status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{state.status === 'needsProfile'}}"
      state="empty"
      title="先完成资格建档"
      description="建档后，才能按你的真实条件筛选岗位。"
      action-text="去建档"
      bind:action="openQualificationProfile"
    />
    <state-view
      wx:elif="{{state.status === 'noActiveRelease'}}"
      state="empty"
      title="本年度岗位尚未正式发布"
      description="正式职位表发布后再来查看。"
    />
    <state-view
      wx:elif="{{state.status !== 'ready' && state.status !== 'empty'}}"
      state="{{state.status === 'network' ? 'stale' : 'error'}}"
      title="{{state.error.title}}"
      description="{{state.error.message}}"
      request-id="{{state.error.requestId}}"
      action-text="重新加载"
      bind:action="retry"
    />
    <state-view
      wx:elif="{{state.status === 'empty'}}"
      state="empty"
      title="没有匹配的岗位"
      description="换个地区或关键词再试试。"
      action-text="清除筛选"
      bind:action="clearFilters"
    />

    <block wx:else>
      <view wx:if="{{state.delivery && (state.delivery.partial || state.delivery.stale)}}" class="position-inline-alert">
        {{state.delivery.partial ? state.delivery.partialLabel : state.delivery.staleLabel}}
      </view>

      <view class="all-position-list position-card-grid">
        <view
          wx:for="{{state.items}}"
          wx:key="positionId"
          class="all-position-card"
          hover-class="item--hover"
          data-id="{{item.positionId}}"
          bindtap="openPosition"
        >
          <view class="all-position-card__top">
            <text class="all-position-card__department">{{item.departmentFull}}</text>
            <text class="all-position-card__location">{{item.region}}{{item.city ? ' · ' + item.city : ''}}</text>
          </view>
          <view class="all-position-card__title">{{item.name}}</view>
          <view class="all-position-card__footer">
            <view class="all-position-card__facts">
              <text>招 {{item.headcount}} 人</text>
              <text class="fact-dot"></text>
              <text>{{item.eligibilityLabel}}</text>
            </view>
            <text class="all-position-card__score">{{item.scoreLabel}} <text class="tiny-chevron">›</text></text>
          </view>
          <button
            hover-class="item--hover"
            class="compare-corner {{item.comparisonSelected ? 'compare-corner--selected' : ''}}"
            data-id="{{item.positionId}}"
            catchtap="toggleComparison"
          >{{item.comparisonSelected ? '✓ 已选' : '＋ 对比'}}</button>
        </view>
      </view>

      <view wx:if="{{state.paginationStatus === 'error'}}" class="position-inline-alert">
        {{state.paginationError.message}}
        <button hover-class="item--hover" class="text-action" bindtap="loadMore">继续加载</button>
      </view>
      <view wx:elif="{{state.paginationStatus === 'loading'}}" class="list-status">正在加载下一页…</view>
      <button wx:elif="{{state.hasMore}}" hover-class="item--hover" class="list-status list-status--button" bindtap="loadMore">加载更多</button>
      <view wx:else class="list-status">已展示当前条件下的全部岗位</view>
    </block>
  </view>

  <view wx:if="{{state && state.selectedIds.length > 0}}" class="comparison-dock">
    <view class="comparison-dock__summary">
      <text class="comparison-dock__title">已选 {{state.selectedIds.length}} / 3</text>
      <text class="comparison-dock__note">{{state.selectedIds.length < 2 ? '再选 1 个开始对比' : '可以横向比较资格和分差'}}</text>
    </view>
    <button hover-class="item--hover" class="comparison-dock__clear" bindtap="clearComparison">清空</button>
    <button hover-class="item--hover" class="comparison-dock__action {{state.selectedIds.length < 2 ? 'comparison-dock__action--disabled' : ''}}" disabled="{{state.selectedIds.length < 2}}" bindtap="openComparison">对比</button>
  </view>
</view>
