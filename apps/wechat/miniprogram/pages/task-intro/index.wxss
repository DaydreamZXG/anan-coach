.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 60rpx;
}

.is-pressed {
  opacity: 0.72;
}

.foot-space {
  height: 80rpx;
}

/* ── 顶部导航 ── */

.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
}

.nav__text {
  flex: 1;
  min-width: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 已失效 ── */

.expired__actions {
  margin: 32rpx;
}

/* ── hero ── */

.hero {
  margin: 8rpx 32rpx 28rpx;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 36rpx 32rpx;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.hero__cap {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
}

.hero__chips {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.hero__chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.hero__chip--primary {
  background: var(--grad-main);
  color: #ffffff;
  font-weight: 700;
}

/* ── 目标卡 ── */

.goal {
  margin: 0 32rpx 20rpx;
  padding: 32rpx 28rpx;
}

.goal__kicker {
  font-size: 22rpx;
  color: var(--indigo);
  font-weight: 700;
  letter-spacing: 0.06em;
}

.goal__title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
}

.goal__metric {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 800;
  background: var(--grad-main);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.goal__reason {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

.goal__meta {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 复测阶段卡 ── */

.stage {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.stage__kicker {
  font-size: 22rpx;
  color: var(--cyan);
  font-weight: 700;
  letter-spacing: 0.06em;
}

.stage__title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}

/* ── 完成后卡 ── */

.after {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
}

.after__kicker {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.06em;
}

.after__title {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}

.after__chips {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.after__chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(91, 95, 244, 0.1);
  color: var(--indigo);
  font-size: 24rpx;
}

.after__copy {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* ── 操作区 ── */

.actions {
  margin: 32rpx 32rpx 0;
}
