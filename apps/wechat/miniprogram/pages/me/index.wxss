.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.page-title { display: block; margin: 8rpx 0 28rpx; }

.profile { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(61, 126, 255, 0.28);
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 平板双栏:概览与数据条并排,菜单组左右分流 */
@media (min-width: 700px) {
  .me {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    align-content: start;
  }
  .me safe-top,
  .me .page-title {
    grid-column: 1 / -1;
  }
  .me .profile,
  .me .stats {
    margin-bottom: 0;
  }
  .me .group-title {
    grid-column: 1 / -1;
  }
  .me .menu {
    grid-column: 1 / -1;
  }
}
.profile-info { display: flex; flex-direction: column; gap: 8rpx; }
.profile-name { font-size: 34rpx; font-weight: 600; }

.stats { display: flex; align-items: center; margin-bottom: 32rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stat-num { font-size: 44rpx; font-weight: 700; color: var(--primary); }
.stat-divider { width: 1rpx; height: 56rpx; background: var(--line); }

.group-title { display: block; margin: 0 4rpx 12rpx; }
.menu { padding: 0 28rpx; margin-bottom: 28rpx; }
.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}
.menu-border { border-bottom: 1rpx solid var(--line); }
.menu-body { display: flex; flex-direction: column; gap: 4rpx; }
.menu-label { font-size: 30rpx; font-weight: 600; }
.menu-arrow { font-size: 40rpx; color: var(--ink-3); }
