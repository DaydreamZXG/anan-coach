.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.profile-content {
  box-sizing: border-box;
  padding: 0 var(--figma-page-inset)
    calc(
      var(--figma-bottom-navigation-height) + var(--figma-space-32) +
        env(safe-area-inset-bottom)
    );
}

.identity-block,
.identity-name-row,
.card-head,
.study-title-row,
.coach-setting,
.service-row,
.section-head-row,
.session-row {
  display: flex;
  align-items: center;
}

.edit-profile,
.card-link {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}
.edit-profile::after,
.card-link::after,
.target-action::after,
.coach-setting::after,
.asset-item::after,
.service-row::after,
.session-action::after,
.logout-button::after,
.profile-editor__close::after,
.profile-editor__save::after { border: 0; }
.identity-block { align-items: center; gap: 32rpx; margin: 16rpx 0 16rpx; }
.identity-avatar {
  display: flex;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 1rpx solid var(--line);
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 30rpx rgba(0, 0, 0, 0.04);
}
.identity-avatar__icon { width: 56rpx; height: 56rpx; }
.user-avatar {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  color: var(--color-surface);
  font-size: 38rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 46rpx rgba(17, 24, 39, 0.08);
}
.user-avatar--large { width: 144rpx; height: 144rpx; border-radius: 48rpx; font-size: 46rpx; }
.user-avatar--ocean { background: linear-gradient(145deg, var(--color-primary), var(--figma-color-cyan-deep)); }
.user-avatar--aurora { background: linear-gradient(145deg, var(--good), var(--color-ai-violet)); }
.user-avatar--sunrise { background: linear-gradient(145deg, var(--figma-color-warning), var(--color-ai-pink)); }
.user-avatar--violet { background: linear-gradient(145deg, var(--color-ai-violet), var(--color-primary)); }
.user-avatar--graphite { background: linear-gradient(145deg, var(--ink-2), var(--ink)); }
.user-avatar--mint { background: linear-gradient(145deg, var(--figma-color-cyan), var(--figma-color-cyan-dark)); }
.identity-copy { min-width: 0; flex: 1; }
.identity-name-row { gap: 8rpx; }
.identity-name { overflow: hidden; font-size: 44rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.edit-profile { display: flex; min-width: 44rpx; min-height: 44rpx; align-items: center; justify-content: center; line-height: 44rpx; }
.edit-profile__icon { width: 28rpx; height: 28rpx; }
.identity-meta { margin-top: 4rpx; color: var(--ink-2); font-size: 26rpx; font-weight: 500; }
.identity-target {
  display: inline-flex;
  max-width: 100%;
  margin-top: 16rpx;
  padding: 10rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 64rpx;
  background: var(--color-surface);
  color: var(--figma-color-ink-tertiary);
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.08);
}

.profile-card,
.service-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(240, 242, 246, 0.78);
  border-radius: 64rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 60rpx rgba(17, 24, 39, 0.04);
}
.profile-card { margin-top: 32rpx; padding: 48rpx; }
.card-head { justify-content: space-between; gap: 20rpx; }
.card-title { font-size: 32rpx; font-weight: 780; }
.card-link { display: flex; flex: none; min-height: 48rpx; align-items: center; gap: 4rpx; color: var(--ink-3); font-size: 24rpx; line-height: 48rpx; }
.link-chevron { width: 28rpx; height: 28rpx; flex: none; }
.archive-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 32rpx;
  row-gap: 40rpx;
  margin-top: 40rpx;
}
.archive-item { min-width: 0; }
.archive-label { color: var(--ink-3); font-size: 22rpx; font-weight: 550; }
.archive-value { margin-top: 8rpx; color: var(--ink); font-size: 28rpx; font-weight: 700; line-height: 1.45; }
.archive-prompt { margin-top: 28rpx; padding: 20rpx 22rpx; border-radius: 22rpx; background: var(--figma-color-warning-soft); color: var(--figma-color-warning-deep); font-size: 20rpx; line-height: 1.55; }

.target-status { display: inline-flex; padding: 7rpx 13rpx; border-radius: 10rpx; background: var(--good-soft); color: var(--good); font-size: 18rpx; font-weight: 700; }
.target-name { margin-top: 12rpx; font-size: 36rpx; font-weight: 800; line-height: 1.4; }
.target-department { margin-top: 8rpx; color: var(--ink-2); font-size: 26rpx; font-weight: 500; }
.target-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 26rpx; }
.target-action { min-height: 86rpx; margin: 0; padding: 0 12rpx; border: 0; border-radius: 32rpx; background: var(--bg); color: var(--color-ink-secondary); font-size: 26rpx; font-weight: 700; line-height: 86rpx; }

.study-title-row { gap: 12rpx; }
.study-status { padding: 6rpx 16rpx; border-radius: 60rpx; background: var(--line); color: var(--ink-2); font-size: 22rpx; font-weight: 650; }
.study-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-top: 40rpx; }
.study-metric { padding: 32rpx 16rpx; border-radius: 40rpx; background: var(--bg); text-align: center; }
.study-value { margin-top: 8rpx; font-size: 36rpx; font-weight: 780; }
.study-value--small { margin-top: 12rpx; font-size: 26rpx; }

.coach-setting { width: 100%; gap: 24rpx; text-align: left; }
.coach-setting__icon { display: flex; width: 80rpx; height: 80rpx; align-items: center; justify-content: center; flex: none; border-radius: 32rpx; background: var(--gradient-ai); box-shadow: 0 2rpx 5rpx rgba(173, 70, 255, 0.2); }
.coach-setting__image { width: 36rpx; height: 36rpx; }
.coach-setting__main { min-width: 0; flex: 1; }
.coach-setting__title { font-size: 30rpx; font-weight: 760; }
.coach-setting__copy { margin-top: 4rpx; color: var(--ink-3); font-size: 24rpx; }
.coach-setting__state { margin-left: auto; color: var(--ink-3); font-size: 26rpx; }

.asset-section,
.service-section { margin-top: 48rpx; }
.section-title { margin-left: 16rpx; font-size: 30rpx; font-weight: 780; }
.asset-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; margin-top: 32rpx; }
.asset-item { display: flex; flex-direction: column; align-items: center; gap: 16rpx; min-width: 0; margin: 0; padding: 0; border: 0; background: transparent; color: var(--figma-color-ink-tertiary); font-size: 22rpx; line-height: 1.3; }
.asset-icon { display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; border-radius: 40rpx; background: var(--color-surface); box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.03); }
.asset-icon__image { width: 40rpx; height: 40rpx; }
.service-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 32rpx;
  padding: 24rpx;
}
.service-row { box-sizing: border-box; width: 100%; min-height: 112rpx; gap: 24rpx; margin: 0; padding: 0 24rpx; border: 0; border-radius: 48rpx; background: transparent; color: var(--ink); font-size: 28rpx; font-weight: 700; line-height: 42rpx; text-align: left; }
.service-row--logout { margin-top: 8rpx; border-top: 1rpx solid var(--line); }
.service-row:last-child { border-bottom: 0; }
.service-icon { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; flex: none; border-radius: 50%; background: var(--bg); }
.service-icon__image { width: 28rpx; height: 28rpx; }
.service-icon--danger { background: var(--color-danger-soft); }
.service-text--danger { color: var(--danger); }
.service-chevron { width: 32rpx; height: 32rpx; margin-left: auto; }
.service-main { min-width: 0; flex: 1; }
.service-main__copy { margin-top: 4rpx; color: var(--ink-3); font-size: 18rpx; font-weight: 500; }
.service-arrow { margin-left: auto; color: var(--ink-3); font-size: 22rpx; font-weight: 550; }
.section-head-row { justify-content: space-between; }
.section-count { color: var(--ink-3); font-size: 19rpx; }

.session-row { min-height: 104rpx; gap: 18rpx; border-bottom: 1rpx solid var(--line); }
.session-row:last-child { border-bottom: 0; }
.device-icon { display: flex; width: 48rpx; height: 62rpx; align-items: flex-end; justify-content: center; flex: none; box-sizing: border-box; padding-bottom: 7rpx; border: 2rpx solid var(--ink-2); border-radius: 12rpx; }
.device-dot { width: 6rpx; height: 6rpx; border-radius: 50%; background: var(--ink-2); }
.session-main { min-width: 0; flex: 1; }
.session-title { font-size: 22rpx; font-weight: 720; }
.current-tag { margin-left: 10rpx; padding: 4rpx 9rpx; border-radius: var(--figma-radius-pill); background: var(--good-soft); color: var(--good); font-size: 16rpx; }
.session-copy { margin-top: 5rpx; color: var(--ink-3); font-size: 18rpx; }
.session-action { width: auto; min-height: 56rpx; margin: 0; padding: 0 10rpx; border: 0; background: transparent; color: var(--danger); font-size: 19rpx; line-height: 56rpx; }

.inline-error { margin-top: 26rpx; padding: 22rpx; border-radius: 22rpx; background: var(--color-danger-soft); color: var(--danger); font-size: 21rpx; line-height: 1.55; }

.context-error-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-danger-soft);
  border-radius: var(--figma-radius-small);
  background: var(--color-danger-soft);
}

.context-error-card__title {
  color: var(--ink);
  font-size: var(--figma-font-body-compact);
  font-weight: 750;
}

.context-error-card__copy,
.context-error-card__request {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--figma-font-caption);
  line-height: 1.55;
}

.context-error-card__request {
  font-family: var(--font-family-data);
}

.context-error-card__retry {
  width: auto;
  min-height: 56rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--figma-font-caption);
  font-weight: 700;
  line-height: 56rpx;
}
.logout-actions { display: flex; flex-direction: column; gap: 10rpx; margin-top: 40rpx; }
.logout-button { min-height: 72rpx; margin: 0; border: 0; border-radius: 24rpx; background: var(--line); color: var(--ink-2); font-size: 21rpx; line-height: 72rpx; }
.logout-actions .logout-all { background: transparent; color: var(--danger); }
.logout-note { margin-top: 12rpx; color: var(--ink-3); font-size: 18rpx; line-height: 1.5; text-align: center; }

.profile-editor-mask { position: fixed; z-index: 110; display: flex; align-items: flex-end; box-sizing: border-box; padding: 0; background: rgba(17, 24, 39, 0.28); inset: 0; backdrop-filter: blur(12rpx); }
.profile-editor { box-sizing: border-box; width: 100%; max-height: 88vh; padding: 18rpx 38rpx calc(38rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 48rpx 48rpx 0 0; background: var(--color-surface); box-shadow: 0 -24rpx 80rpx rgba(17, 24, 39, 0.14); }
.sheet-handle { width: 72rpx; height: 9rpx; margin: 0 auto 28rpx; border-radius: 999rpx; background: var(--color-line-strong); }
.profile-editor__head { display: flex; align-items: center; justify-content: space-between; }
.profile-editor__title { font-size: 34rpx; font-weight: 800; }
.profile-editor__close { width: 56rpx; height: 56rpx; margin: 0; padding: 0; border: 0; border-radius: var(--figma-radius-pill); background: var(--bg); color: var(--ink-2); font-size: 32rpx; line-height: 56rpx; }
.profile-editor__preview { display: flex; justify-content: center; margin: 34rpx 0; }
.profile-editor__label { margin-top: 26rpx; color: var(--ink-2); font-size: 21rpx; font-weight: 650; }
.profile-editor__input { box-sizing: border-box; width: 100%; height: 86rpx; margin-top: 12rpx; padding: 0 24rpx; border-radius: 24rpx; background: var(--bg); font-size: 24rpx; }
.avatar-style-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 14rpx; }
.avatar-style { display: flex; align-items: center; gap: 12rpx; padding: 14rpx; border: 1rpx solid var(--line); border-radius: 20rpx; color: var(--ink-2); font-size: 19rpx; }
.avatar-style--active { border-color: var(--color-primary); background: var(--primary-soft); color: var(--primary-deep); font-weight: 700; }
.avatar-style__swatch { width: 34rpx; height: 34rpx; border-radius: 12rpx; }
.profile-editor__error { margin-top: 18rpx; color: var(--danger); font-size: 20rpx; }
.profile-editor__save { width: 100%; min-height: 86rpx; margin: 30rpx 0 0; border-radius: 28rpx; background: var(--ink); color: var(--color-surface); font-size: 24rpx; font-weight: 750; line-height: 86rpx; }

@media (min-width: 768px) {
  .profile-page { width: 100%; max-width: 820px; margin: 0 auto; }
  .profile-content { padding: 0 38px calc(112px + env(safe-area-inset-bottom)); }
  .profile-card { padding: 26px; border-radius: 26px; }
  .card-title,
  .target-name { font-size: 18px; }
  .archive-label,
  .card-link,
  .target-copy,
  .coach-setting__copy,
  .section-count,
  .session-copy,
  .logout-note { font-size: 13px; }
  .archive-value,
  .coach-setting__title,
  .service-row,
  .session-title { font-size: 16px; }
  .asset-item { font-size: 13px; }
  .profile-editor { right: 50%; left: auto; width: min(100%, 720px); transform: translateX(50%); }
}
