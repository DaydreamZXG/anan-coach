.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.profile-content {
  box-sizing: border-box;
  padding: 0 var(--figma-page-inset)
    calc(
      var(--figma-bottom-navigation-height) + var(--figma-space-32) + env(safe-area-inset-bottom)
    );
}

.identity-block,
.identity-name-row,
.card-head,
.study-title-row,
.coach-setting,
.service-row,
.section-head-row,
.session-row {
  display: flex;
  align-items: center;
}

.edit-profile,
.card-link {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}
.edit-profile::after,
.card-link::after,
.target-action::after,
.coach-setting::after,
.asset-item::after,
.service-row::after,
.session-action::after,
.logout-button::after,
.profile-editor__close::after,
.profile-editor__save::after {
  border: 0;
}
.identity-block {
  align-items: center;
  gap: calc(32 * var(--rpx));
  margin: calc(16 * var(--rpx)) 0 calc(16 * var(--rpx));
}
.identity-avatar {
  display: flex;
  width: calc(128 * var(--rpx));
  height: calc(128 * var(--rpx));
  align-items: center;
  justify-content: center;
  flex: none;
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.identity-avatar__icon {
  width: calc(56 * var(--rpx));
  height: calc(56 * var(--rpx));
}
.user-avatar {
  display: flex;
  width: calc(112 * var(--rpx));
  height: calc(112 * var(--rpx));
  align-items: center;
  justify-content: center;
  flex: none;
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  color: var(--color-surface);
  font-size: var(--text-title);
  font-weight: 800;
  box-shadow: var(--shadow-card);
}
.user-avatar--large {
  width: calc(144 * var(--rpx));
  height: calc(144 * var(--rpx));
  border-radius: var(--radius-48);
  font-size: var(--text-title-lg);
}
.user-avatar--ocean {
  background: linear-gradient(145deg, var(--color-primary), var(--figma-color-cyan-deep));
}
.user-avatar--aurora {
  background: linear-gradient(145deg, var(--good), var(--color-ai-violet));
}
.user-avatar--sunrise {
  background: linear-gradient(145deg, var(--figma-color-warning), var(--color-ai-pink));
}
.user-avatar--violet {
  background: linear-gradient(145deg, var(--color-ai-violet), var(--color-primary));
}
.user-avatar--graphite {
  background: linear-gradient(145deg, var(--ink-2), var(--ink));
}
.user-avatar--mint {
  background: linear-gradient(145deg, var(--figma-color-cyan), var(--figma-color-cyan-dark));
}
.identity-copy {
  min-width: 0;
  flex: 1;
}
.identity-name-row {
  gap: calc(8 * var(--rpx));
}
.identity-name {
  overflow: hidden;
  font-size: var(--text-title-lg);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}
button.edit-profile {
  display: flex;
  width: calc(44 * var(--rpx));
  min-width: calc(44 * var(--rpx));
  min-height: calc(44 * var(--rpx));
  align-items: center;
  justify-content: center;
  line-height: calc(44 * var(--rpx));
}
.edit-profile__icon {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
}
.identity-meta {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
}
.identity-target {
  display: inline-flex;
  max-width: 100%;
  margin-top: calc(16 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  overflow: hidden;
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: var(--shadow-crisp);
}

.profile-card,
.service-card {
  box-sizing: border-box;
  border: calc(1 * var(--rpx)) solid rgba(240, 242, 246, 0.78);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}
.profile-card {
  margin-top: calc(32 * var(--rpx));
  padding: calc(48 * var(--rpx));
}
.card-head {
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}
.card-title {
  font-size: var(--text-section);
  font-weight: 800;
}
button.card-link {
  display: flex;
  width: auto;
  flex: none;
  min-height: calc(48 * var(--rpx));
  align-items: center;
  gap: calc(4 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  line-height: calc(48 * var(--rpx));
}
.link-chevron {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
  flex: none;
}
.archive-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  column-gap: calc(32 * var(--rpx));
  row-gap: calc(40 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
}
.archive-item {
  min-width: 0;
}
.archive-label {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}
.archive-value {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.45;
}
.archive-prompt {
  margin-top: calc(28 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.target-status {
  display: inline-flex;
  padding: calc(8 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-micro);
  font-weight: 700;
}
.target-name {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-title-sm);
  font-weight: 800;
  line-height: 1.4;
}
.target-department {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
}
.target-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}
button.target-action {
  width: 100%;
  min-height: calc(86 * var(--rpx));
  margin: 0;
  padding: 0 calc(12 * var(--rpx));
  border: 0;
  border-radius: var(--radius-32);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(86 * var(--rpx));
}

.study-title-row {
  gap: calc(12 * var(--rpx));
}
.study-status {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-64);
  background: var(--line);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}
.study-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
}
.study-metric {
  padding: calc(32 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-40);
  background: var(--bg);
  text-align: center;
}
.study-value {
  margin-top: calc(8 * var(--rpx));
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.study-value--small {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-body);
}

button.coach-setting {
  width: 100%;
  gap: calc(24 * var(--rpx));
  text-align: left;
}
.coach-setting__icon {
  display: flex;
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: var(--radius-32);
  background: var(--gradient-ai);
  box-shadow: var(--shadow-ai);
}
.coach-setting__image {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}
.coach-setting__main {
  min-width: 0;
  flex: 1;
}
.coach-setting__title {
  font-size: var(--text-section);
  font-weight: 700;
}
.coach-setting__copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
}
.coach-setting__state {
  margin-left: auto;
  color: var(--ink-3);
  font-size: var(--text-body);
}

.community-entry {
  background:
    radial-gradient(circle at 92% 8%, rgba(80, 221, 224, 0.18), transparent 34%),
    var(--color-surface);
}
.community-entry__head {
  display: flex;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
}
.community-entry__icon {
  display: flex;
  width: calc(80 * var(--rpx));
  height: calc(80 * var(--rpx));
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: var(--radius-32);
  background: var(--figma-color-cyan-soft);
}
.community-entry__image {
  width: calc(38 * var(--rpx));
  height: calc(38 * var(--rpx));
}
.community-entry__main {
  min-width: 0;
  flex: 1;
}
.community-entry__kicker {
  color: var(--color-primary);
  font-size: var(--text-micro);
  font-weight: 800;
}
.community-entry__title {
  margin-top: calc(6 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 800;
  line-height: 1.4;
}
.community-entry__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  line-height: 1.6;
}
.community-entry__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}
button.community-entry__button {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(76 * var(--rpx));
  margin: 0;
  padding: 0 calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 800;
  line-height: calc(76 * var(--rpx));
}
button.community-entry__button--primary {
  border-color: transparent;
  background: var(--ink);
  color: var(--color-surface);
}
.community-entry__button::after {
  border: 0;
}

.asset-section,
.service-section {
  margin-top: calc(48 * var(--rpx));
}
.section-title {
  margin-left: calc(16 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 800;
}
.asset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: calc(24 * var(--rpx)) calc(16 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}
button.asset-item {
  display: flex;
  width: calc((100% - calc(48 * var(--rpx))) / 4);
  min-width: 0;
  flex: 0 0 calc((100% - calc(48 * var(--rpx))) / 4);
  flex-direction: column;
  align-items: center;
  gap: calc(16 * var(--rpx));
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.3;
}
.asset-icon {
  display: flex;
  width: calc(96 * var(--rpx));
  height: calc(96 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}
.asset-icon__image {
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
}
.service-card {
  display: flex;
  flex-direction: column;
  gap: calc(8 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
  padding: calc(24 * var(--rpx));
}
.service-row {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(112 * var(--rpx));
  gap: calc(24 * var(--rpx));
  margin: 0;
  padding: 0 calc(24 * var(--rpx));
  border: 0;
  border-radius: var(--radius-48);
  background: transparent;
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
  text-align: left;
}
button.service-row {
  width: 100%;
}
.service-row--logout {
  margin-top: calc(8 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--line);
}
.service-row:last-child {
  border-bottom: 0;
}
.service-icon {
  display: flex;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 50%;
  background: var(--bg);
}
.service-icon__image {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
}
.service-icon--danger {
  background: var(--color-danger-soft);
}
.service-text--danger {
  color: var(--danger);
}
.service-chevron {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
  margin-left: auto;
}
.service-main {
  min-width: 0;
  flex: 1;
}
.service-main__copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}
.service-arrow {
  margin-left: auto;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}
.section-head-row {
  justify-content: space-between;
}
.section-count {
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.session-row {
  min-height: calc(104 * var(--rpx));
  gap: calc(20 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--line);
}
.session-row:last-child {
  border-bottom: 0;
}
.device-icon {
  display: flex;
  width: calc(48 * var(--rpx));
  height: calc(62 * var(--rpx));
  align-items: flex-end;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  padding-bottom: calc(8 * var(--rpx));
  border: calc(2 * var(--rpx)) solid var(--ink-2);
  border-radius: var(--radius-12);
}
.device-dot {
  width: calc(6 * var(--rpx));
  height: calc(6 * var(--rpx));
  border-radius: 50%;
  background: var(--ink-2);
}
.session-main {
  min-width: 0;
  flex: 1;
}
.session-title {
  font-size: var(--text-micro);
  font-weight: 700;
}
.current-tag {
  margin-left: calc(12 * var(--rpx));
  padding: calc(4 * var(--rpx)) calc(8 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-micro);
}
.session-copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
}
button.session-action {
  width: auto;
  min-height: calc(56 * var(--rpx));
  margin: 0;
  padding: 0 calc(12 * var(--rpx));
  border: 0;
  background: transparent;
  color: var(--danger);
  font-size: var(--text-micro);
  line-height: calc(56 * var(--rpx));
}

.inline-error {
  margin-top: calc(28 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-danger-soft);
  color: var(--danger);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.context-error-card {
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-danger-soft);
  border-radius: var(--figma-radius-small);
  background: var(--color-danger-soft);
}

.context-error-card__title {
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.context-error-card__copy,
.context-error-card__request {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.context-error-card__request {
  font-family: var(--font-family-data);
}

button.context-error-card__retry {
  width: auto;
  min-height: calc(56 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(56 * var(--rpx));
}
.logout-actions {
  display: flex;
  flex-direction: column;
  gap: calc(12 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
}
.logout-button {
  min-height: calc(72 * var(--rpx));
  margin: 0;
  border: 0;
  border-radius: var(--radius-24);
  background: var(--line);
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: calc(72 * var(--rpx));
}
.logout-actions .logout-all {
  background: transparent;
  color: var(--danger);
}
.logout-note {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.5;
  text-align: center;
}

.profile-editor-mask {
  position: fixed;
  z-index: 110;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 0;
  background: rgba(17, 24, 39, 0.28);
  inset: 0;
  backdrop-filter: blur(calc(12 * var(--rpx)));
}
.profile-editor {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  padding: calc(18 * var(--rpx)) calc(38 * var(--rpx))
    calc(calc(38 * var(--rpx)) + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: var(--radius-48) var(--radius-48) 0 0;
  background: var(--color-surface);
  box-shadow: var(--shadow-overlay);
}
.sheet-handle {
  width: calc(72 * var(--rpx));
  height: calc(9 * var(--rpx));
  margin: 0 auto calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-line-strong);
}
.profile-editor__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.profile-editor__title {
  font-size: var(--text-title-sm);
  font-weight: 800;
}
button.profile-editor__close {
  width: calc(56 * var(--rpx));
  height: calc(56 * var(--rpx));
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-section);
  line-height: calc(56 * var(--rpx));
}
.profile-editor__preview {
  display: flex;
  justify-content: center;
  margin: calc(32 * var(--rpx)) 0;
}
.profile-editor__label {
  margin-top: calc(28 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}
.profile-editor__input {
  box-sizing: border-box;
  width: 100%;
  height: calc(86 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--bg);
  font-size: var(--text-caption);
}
.avatar-style-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(16 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
}
.avatar-style {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--rpx));
  padding: calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  color: var(--ink-2);
  font-size: var(--text-micro);
}
.avatar-style--active {
  border-color: var(--color-primary);
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-weight: 700;
}
.avatar-style__swatch {
  width: calc(34 * var(--rpx));
  height: calc(34 * var(--rpx));
  border-radius: var(--radius-12);
}
.profile-editor__error {
  margin-top: calc(20 * var(--rpx));
  color: var(--danger);
  font-size: var(--text-micro);
}
button.profile-editor__save {
  width: 100%;
  min-height: calc(86 * var(--rpx));
  margin: calc(32 * var(--rpx)) 0 0;
  border-radius: var(--radius-32);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(86 * var(--rpx));
}

@media (min-width: 768px) {
  .profile-page {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
  }
  .profile-content {
    padding: 0 38px calc(112px + env(safe-area-inset-bottom));
  }
  .profile-card {
    padding: 26px;
    border-radius: 26px;
  }
  .card-title,
  .target-name {
    font-size: 18px;
  }
  .archive-label,
  .card-link,
  .target-copy,
  .coach-setting__copy,
  .section-count,
  .session-copy,
  .logout-note {
    font-size: 13px;
  }
  .archive-value,
  .coach-setting__title,
  .service-row,
  .session-title {
    font-size: 16px;
  }
  .asset-item {
    font-size: 13px;
  }
  /* 平板：底部抽屉升级为居中对话框（与 ui-sheet 原语同款形态）。 */
  .profile-editor-mask {
    align-items: center;
    justify-content: center;
    padding: 32px;
  }

  .profile-editor {
    width: min(100%, 560px);
    max-height: 80vh;
    padding: 24px 32px 28px;
    border-radius: 24px;
    transform: none;
  }

  .profile-editor .sheet-handle {
    display: none;
  }
}

/*
 * 平板横屏：把“我的”组成一张备考工作台。
 * 档案跨两行，与右侧的岗位 + 提醒形成一组；
 * 学习方式与方法卡社区等高对应，避免自动两列造成的大面积空洞。
 * 该断点只命中横屏，不改动手机和平板竖屏的单列阅读顺序。
 */
@media (min-width: 1024px) and (orientation: landscape) {
  .profile-page {
    max-width: 1160px;
  }

  .profile-content {
    display: grid;
    align-items: start;
    column-gap: 24px;
    row-gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      "identity identity"
      "archive target"
      "archive coach"
      "study community"
      "assets assets"
      "services services"
      "error error";
  }

  .identity-block {
    grid-area: identity;
    margin-bottom: 2px;
  }

  .archive-card {
    grid-area: archive;
  }

  .target-card {
    grid-area: target;
  }

  .study-card {
    grid-area: study;
  }

  .coach-setting {
    grid-area: coach;
  }

  .community-entry {
    grid-area: community;
  }

  .asset-section {
    grid-area: assets;
  }

  .service-section {
    grid-area: services;
  }

  .inline-error {
    grid-area: error;
  }

  .profile-card,
  .asset-section,
  .service-section {
    margin-top: 0;
  }

  button.coach-setting {
    min-height: 100%;
  }

  .community-entry {
    min-height: 100%;
  }
}
