<view class="brain-page">
  <view class="companion-hero">
    <anan-companion size="small" intent="{{companionIntent}}" context="plan" animate />
    <view>
      <view class="companion-name">岸岸</view>
      <view class="companion-scope">按你的岗位、计划和学习记录回答</view>
    </view>
  </view>

  <view class="semantic-state state-{{semanticState}}">
    <view class="semantic-dot"></view>
    <view>{{stateLabel}}</view>
  </view>

  <view wx:if="{{question}}" class="question-bubble">{{question}}</view>
  <view wx:if="{{errorMessage}}" class="brain-warning">{{errorMessage}}<text wx:if="{{requestId}}"> · {{requestId}}</text></view>
  <button wx:if="{{contextStatus === 'error'}}" class="brain-secondary" bindtap="retryContext">重新读取证据</button>

  <view wx:if="{{answer}}" class="answer-card">
    <view class="answer-header">
      <view>
        <view class="brain-row-title">岸岸回答</view>
        <view class="answer-meta">{{answer.respondingAgent}} · {{answer.confidenceLabel}} · {{answer.stateLabel}}</view>
      </view>
      <view class="answer-type">{{answer.answerType}}</view>
    </view>
    <view class="answer-copy">{{answer.answer}}</view>

    <view wx:if="{{answer.highImpactDecision}}" class="decision-boundary">
      <view class="brain-row-title">高影响结论边界</view>
      <view class="brain-row-copy">本次只做解释，不会修改报考资格、主目标或学习策略；采用前仍需你确认。</view>
    </view>

    <view class="brain-section-head">
      <view class="brain-section-title">来源与版本</view>
      <view class="brain-section-meta">{{answer.citations.length}}</view>
    </view>
    <view wx:for="{{answer.citations}}" wx:key="sourceId" class="brain-row citation-row">
      <view class="brain-row-main">
        <view class="brain-row-title">{{item.title}}</view>
        <view class="citation-version">{{item.kind}} · v{{item.version}} · {{item.anchor}}</view>
        <view class="brain-row-copy">{{item.summary}}</view>
      </view>
    </view>

    <view wx:if="{{answer.limitations.length}}" class="limitations">
      <view class="brain-row-title">局限</view>
      <view wx:for="{{answer.limitations}}" wx:key="*this" class="limitation-item">· {{item}}</view>
    </view>

    <view wx:if="{{answer.allowedActions.length}}" class="action-list">
      <button wx:for="{{answer.allowedActions}}" wx:key="label" class="brain-secondary action-button" data-index="{{index}}" bindtap="handleAction">{{item.label}}</button>
    </view>
    <view class="brain-warning">{{answer.quotaUnlimited ? '冷启动期间正常使用不限会员额度' : '剩余额度 ' + answer.quotaRemaining + ' / ' + answer.quota.limit}}；学习状态版本 {{answer.knowledgeFreshness}}。</view>
  </view>

  <view class="companion-composer">
    <textarea cursor-spacing="24" class="composer-input" value="{{question}}" maxlength="800" auto-height placeholder="继续问岸岸…" bindinput="inputQuestion" />
    <button class="composer-send {{contextStatus !== 'ready' ? 'composer-send--disabled' : ''}}" loading="{{submitting || contextStatus === 'loading'}}" disabled="{{contextStatus !== 'ready'}}" bindtap="ask">↑</button>
  </view>
</view>
