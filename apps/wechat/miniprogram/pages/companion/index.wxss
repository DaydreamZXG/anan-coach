@import "../../features/learning-brain/page-shell.wxss";
.companion-hero {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 4rpx 22rpx;
  color: var(--color-ink);
}
.companion-name {
  font-size: 29rpx;
  font-weight: 820;
}
.companion-scope {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}
.semantic-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}
.semantic-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
.state-evidence_insufficient .semantic-dot,
.state-provider_pending .semantic-dot {
  background: #d39331;
}
.state-permission_denied .semantic-dot,
.state-security_blocked .semantic-dot,
.state-failed .semantic-dot {
  background: #c34e59;
}
.state-quota_exhausted .semantic-dot {
  background: #7b668f;
}
.answer-copy {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
.question-bubble {
  max-width: 78%;
  box-sizing: border-box;
  margin: 20rpx 0 30rpx auto;
  padding: 22rpx 24rpx;
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}
.answer-card {
  margin: 0 64rpx 150rpx 0;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.answer-header {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.answer-meta,
.citation-version {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}
.answer-type {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 18rpx;
}
.decision-boundary {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 22rpx;
  background: var(--color-surface-soft);
}
.citation-row {
  align-items: flex-start;
}
.limitations {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceef5;
}
.limitation-item {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.6;
}
.action-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}
.action-button {
  width: auto;
  margin: 0;
}
.companion-composer {
  position: fixed;
  z-index: 20;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 12rpx 12rpx 12rpx 22rpx;
  border: 1rpx solid rgba(41, 73, 65, 0.16);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(32, 67, 58, 0.14);
}
.composer-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 180rpx;
  padding: 12rpx 0;
  color: var(--color-ink);
  font-size: 24rpx;
  line-height: 1.55;
}
.composer-send {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 72rpx;
}
.composer-send--disabled {
  opacity: 0.46;
}
