.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.tb { display: flex; flex-direction: column; min-height: 100vh; }
.tb-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.tb-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.tb-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.tb-loading { padding: 120rpx 0; text-align: center; }
.tb-body { flex: 1; min-height: 0; }

.tb-head { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 24rpx; }
.tb-mode {
  align-self: flex-start;
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 6rpx 20rpx;
}
.tb-task-title { line-height: 1.4; }

.tb-anan {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.tb-anan-text { flex: 1; font-size: 28rpx; line-height: 1.7; color: #5c4a35; }

.tb-facts { display: flex; align-items: stretch; }
.tb-fact { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.tb-fact-num { font-size: 48rpx; font-weight: 700; color: var(--ink); line-height: 1.2; }
.tb-fact-divider { width: 1rpx; background: var(--line); }

.tb-note { display: block; padding: 24rpx 8rpx; line-height: 1.7; }

.tb-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.tb-foot-btn { width: 100%; }
