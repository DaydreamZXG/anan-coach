.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.si { display: flex; flex-direction: column; min-height: 100vh; }
.si-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.si-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.si-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.si-body { flex: 1; min-height: 0; }

.si-anan {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 8rpx;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.si-anan-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: #5c4a35; }

.si-section { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-3); padding: 28rpx 8rpx 16rpx; }

.si-ctx {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  border: 2rpx solid var(--line);
  margin-bottom: 16rpx;
}
.si-ctx.is-on { border-color: var(--primary); background: var(--primary-soft); }
.si-ctx-main { display: flex; flex-direction: column; gap: 4rpx; }
.si-ctx-label { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.si-radio {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid var(--line); flex-shrink: 0;
}
.si-radio.is-on { border-color: var(--primary); background: var(--primary); box-shadow: inset 0 0 0 6rpx #fff; }

.si-form { display: flex; flex-direction: column; gap: 32rpx; }
.si-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.si-row-main { display: flex; flex-direction: column; gap: 4rpx; }
.si-row-label { font-size: 29rpx; color: var(--ink); }
.si-picker { font-size: 29rpx; color: var(--primary); }
.si-picker.is-empty { color: var(--ink-3); }
.si-input { text-align: right; font-size: 29rpx; color: var(--ink); width: 240rpx; }
.si-ph { color: var(--ink-3); }

.si-hist { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 16rpx; }
.si-hist-main { display: flex; flex-direction: column; gap: 4rpx; }
.si-hist-year { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.si-hist-badge {
  font-size: 22rpx; color: var(--ink-3);
  background: var(--bg);
  border-radius: 999rpx; padding: 6rpx 20rpx;
  flex-shrink: 0;
}
.si-hist-badge.is-active { color: var(--good); background: var(--good-soft); }

.si-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.si-foot-btn { width: 100%; }
.demo-tip { text-align: center; padding-bottom: 16rpx; }
