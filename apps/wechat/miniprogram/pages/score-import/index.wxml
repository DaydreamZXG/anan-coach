<view class="page si">
  <view class="statusbar" />
  <view class="si-nav">
    <text class="si-back" bindtap="onBack">‹</text>
    <text class="si-title">补一笔成绩</text>
  </view>

  <scroll-view class="si-body" scroll-y>
    <view class="si-anan">
      <view class="anan-avatar">岸</view>
      <text class="si-anan-text">把你考过的成绩告诉我，分数只用来定训练重点，不做任何评判。记不清就选「大概记得」，凭印象填。</text>
    </view>

    <text class="si-section">这是哪种成绩</text>
    <view
      class="card si-ctx {{contextKey === item.key ? 'is-on' : ''}}"
      wx:for="{{contexts}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onPickContext"
    >
      <view class="si-ctx-main">
        <text class="si-ctx-label">{{item.label}}</text>
        <text class="text-3">{{item.desc}}</text>
      </view>
      <view class="si-radio {{contextKey === item.key ? 'is-on' : ''}}" />
    </view>

    <text class="si-section">考试信息</text>
    <view class="card si-form">
      <view class="si-row">
        <text class="si-row-label">考试日期</text>
        <picker mode="date" end="{{maxDate}}" value="{{occurredDate}}" bindchange="onDateChange">
          <text class="si-picker {{occurredDate ? '' : 'is-empty'}}">{{occurredDate || '点击选择'}}</text>
        </picker>
      </view>
      <view class="si-row">
        <text class="si-row-label">行测分数</text>
        <input class="si-input num" type="digit" value="{{xingceScore}}" bindinput="onXingceInput" placeholder="没考可不填" placeholder-class="si-ph" />
      </view>
      <view class="si-row">
        <text class="si-row-label">申论分数</text>
        <input class="si-input num" type="digit" value="{{shenlunScore}}" bindinput="onShenlunInput" placeholder="没考可不填" placeholder-class="si-ph" />
      </view>
      <view class="si-row">
        <view class="si-row-main">
          <text class="si-row-label">当时限时了吗</text>
          <text class="text-3">正式考试都算限时</text>
        </view>
        <switch checked="{{timed}}" bindchange="onTimedChange" color="#3d7eff" />
      </view>
    </view>

    <block wx:if="{{history.length}}">
      <text class="si-section">已记录的成绩</text>
      <view class="card si-hist" wx:for="{{history}}" wx:key="evidenceId">
        <view class="si-hist-main">
          <text class="si-hist-year">{{item.yearLabel}} · {{item.sourceLabel}}</text>
          <text class="text-3">{{item.scoreLine}}</text>
        </view>
        <text class="si-hist-badge {{item.active ? 'is-active' : ''}}">{{item.active ? '生效中' : '已替代'}}</text>
      </view>
    </block>

    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示模式（后端未连接）</view>
  </scroll-view>

  <view class="si-foot">
    <button class="btn btn-primary si-foot-btn" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '提交中…' : '记下这笔成绩'}}</button>
  </view>
</view>
