.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.ab-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.ab-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.ab-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }

.ab-contact {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  width: 100%; text-align: left; line-height: inherit;
  margin-bottom: 8rpx;
}
.ab-contact::after { border: none; }
.ab-contact-main { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.ab-contact-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.ab-contact-arrow { font-size: 36rpx; color: var(--ink-3); }
.ab-hero { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 48rpx 0 40rpx; }
.ab-logo {
  width: 128rpx; height: 128rpx; border-radius: 32rpx;
  background: var(--warm); color: #fff;
  font-size: 56rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 8rpx;
}
.ab-name { font-size: 36rpx; font-weight: 700; color: var(--ink); }
.ab-card { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.ab-slogan { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.ab-row { display: flex; align-items: center; justify-content: space-between; }
.ab-row-label { font-size: 28rpx; color: var(--ink); }
