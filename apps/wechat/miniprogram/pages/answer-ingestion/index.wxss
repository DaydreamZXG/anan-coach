@import "../../features/external-learning/page-shell.wxss";

.answer-state-view {
  display: block;
  margin-top: calc(32 * var(--rpx));
}

.target-scroll {
  width: 100%;
  white-space: nowrap;
}

.target-card {
  display: inline-block;
  width: calc(600 * var(--rpx));
  min-height: calc(196 * var(--rpx));
  box-sizing: border-box;
  margin-right: calc(16 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  vertical-align: top;
  white-space: normal;
}

.target-card--selected {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.target-track,
.target-expiry {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
}

.target-title {
  overflow: hidden;
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-body-lg);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.target-expiry {
  margin-top: calc(16 * var(--rpx));
}

.answer-source {
  margin-top: calc(20 * var(--rpx));
}

.answer-string {
  margin-top: calc(20 * var(--rpx));
}

.answer-image-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}

.selected-file {
  display: grid;
  gap: calc(8 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-compact);
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: var(--text-micro);
  word-break: break-all;
}

.upload-number {
  color: var(--color-ink);
  font-size: var(--text-stat);
  font-weight: 800;
}

.answer-row {
  display: grid;
  grid-template-columns: calc(58 * var(--rpx)) 1fr calc(140 * var(--rpx));
  align-items: center;
  gap: calc(16 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface);
}

.answer-order {
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
  text-align: center;
}

.answer-field {
  min-width: 0;
}

.essay-answer {
  min-height: calc(220 * var(--rpx));
}

.answer-confidence {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-success);
  font-size: var(--text-micro);
}

.answer-confidence--warning {
  color: var(--color-warning);
}

.binding-code {
  overflow-wrap: anywhere;
  color: var(--color-muted);
  font-size: var(--text-micro);
  text-align: right;
}

.success-receipt {
  margin-top: calc(20 * var(--rpx));
  word-break: break-all;
}
