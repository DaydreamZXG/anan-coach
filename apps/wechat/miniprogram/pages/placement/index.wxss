.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.placement { display: flex; flex-direction: column; min-height: 100vh; }

.p-nav { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 16rpx; }
.p-title { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.p-skip { padding: 8rpx 16rpx; }
.p-progress { font-size: 28rpx; color: var(--ink-3); }

.p-loading { padding: 120rpx 0; text-align: center; }
.p-body { flex: 1; min-height: 0; }

.p-anan {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.p-anan-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: #5c4a35; }

.p-brief { display: flex; flex-direction: column; gap: 24rpx; }
.p-bp-row { display: flex; justify-content: space-between; }
.p-bp-name { font-size: 28rpx; color: var(--ink-2); }
.p-bp-count { font-size: 28rpx; color: var(--ink); }

.p-q { display: flex; flex-direction: column; gap: 24rpx; }
.p-chip {
  align-self: flex-start;
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 6rpx 20rpx;
}
.p-stem { font-size: 30rpx; line-height: 1.6; color: var(--ink); }
.p-options { display: flex; flex-direction: column; gap: 16rpx; }
.opt {
  display: flex; gap: 20rpx; align-items: flex-start;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
}
.opt-on { border-color: var(--primary); background: var(--primary-soft); }
.opt-label { font-size: 28rpx; font-weight: 600; color: var(--primary); flex-shrink: 0; }
.opt-text { flex: 1; font-size: 28rpx; line-height: 1.5; color: var(--ink); }

.p-score { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-bottom: 24rpx; }
.p-score-num { font-size: 96rpx; font-weight: 700; color: var(--primary); line-height: 1.2; }

.p-results { display: flex; flex-direction: column; gap: 28rpx; margin-bottom: 24rpx; }
.p-result { display: flex; flex-direction: column; gap: 12rpx; }
.p-result-head { display: flex; justify-content: space-between; }
.p-track { height: 12rpx; background: var(--bg); border-radius: 999rpx; overflow: hidden; }
.p-fill { height: 100%; background: var(--primary); border-radius: 999rpx; }

.p-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.p-foot-btn { width: 100%; }

.demo-tip { text-align: center; padding-bottom: 16rpx; }
