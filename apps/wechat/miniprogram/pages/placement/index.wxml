<view class="page placement">
  <view class="statusbar" />

  <view class="p-nav">
    <text class="p-title">{{phase === 'result' ? '你的起点' : '摸底测试'}}</text>
    <text class="p-skip text-3" wx:if="{{phase === 'brief'}}" bindtap="onSkip">跳过</text>
    <text class="p-progress num" wx:if="{{phase === 'test'}}">{{index + 1}}/{{questions.length}}</text>
  </view>

  <view wx:if="{{loading}}" class="p-loading text-2">正在挑题…</view>

  <!-- 简报 -->
  <block wx:elif="{{phase === 'brief'}}">
    <scroll-view class="p-body" scroll-y>
      <view class="p-anan">
        <view class="anan-avatar">岸</view>
        <text class="p-anan-text">开始之前，先花 {{durationMinutes}} 分钟摸个底。不打分不排名，只是让我知道从哪儿帮你练起。答不出来就猜，猜错也有价值。</text>
      </view>
      <view class="card p-brief">
        <text class="h2">{{title}}</text>
        <view class="p-bp-row" wx:for="{{modulePlan}}" wx:key="moduleName">
          <text class="p-bp-name">{{item.moduleName}}</text>
          <text class="p-bp-count num">{{item.count}} 题</text>
        </view>
      </view>
    </scroll-view>
    <view class="p-foot">
      <button class="btn btn-primary p-foot-btn" bindtap="onStart">开始摸底</button>
    </view>
    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示题目（后端未连接）</view>
  </block>

  <!-- 作答 -->
  <block wx:elif="{{phase === 'test'}}">
    <scroll-view class="p-body" scroll-y>
      <view class="card p-q">
        <text class="p-chip">{{questions[index].moduleName}}</text>
        <text class="p-stem">{{questions[index].stem}}</text>
        <view class="p-options">
          <view
            wx:for="{{questions[index].options}}"
            wx:for-item="opt"
            wx:key="label"
            class="opt {{currentSelected === opt.label ? 'opt-on' : ''}}"
            data-label="{{opt.label}}"
            bindtap="onSelect"
          >
            <text class="opt-label">{{opt.label}}</text>
            <text class="opt-text">{{opt.text}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="p-foot">
      <button
        class="btn btn-primary p-foot-btn"
        bindtap="onNext"
        disabled="{{!currentSelected || submitting}}"
      >{{submitting ? '提交中…' : (index + 1 < questions.length ? '下一题' : '交卷看结果')}}</button>
    </view>
  </block>

  <!-- 结果 -->
  <block wx:else>
    <scroll-view class="p-body" scroll-y>
      <view class="card p-score">
        <text class="text-3">初始估分</text>
        <text class="p-score-num num">{{estimatedScore}}</text>
        <text class="text-3">这是起点，不是终点</text>
      </view>
      <view class="card p-results">
        <view class="p-result" wx:for="{{results}}" wx:key="moduleName">
          <view class="p-result-head">
            <text class="p-bp-name">{{item.moduleName}}</text>
            <text class="text-3 num">{{item.correct}}/{{item.total}}</text>
          </view>
          <view class="p-track">
            <view class="p-fill" style="width: {{item.accuracyPct}}%" />
          </view>
        </view>
      </view>
      <view class="p-anan">
        <view class="anan-avatar">岸</view>
        <text class="p-anan-text">底摸完了。从明天起，任务会按你的实际水平排，弱的多练，稳的少碰。</text>
      </view>
    </scroll-view>
    <view class="p-foot">
      <button class="btn btn-primary p-foot-btn" bindtap="onGoToday">看今天的任务</button>
    </view>
  </block>
</view>
