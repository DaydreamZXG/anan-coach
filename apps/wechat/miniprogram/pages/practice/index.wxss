}

.help-sheet .overlay-result {
  margin: 0 calc(32 * var(--rpx));
}

.dispute-categories {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}

.dispute-category {
  flex: none;
  min-height: calc(58 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  font-size: var(--text-micro);
  line-height: calc(58 * var(--rpx));
}

.dispute-description {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(210 * var(--rpx));
  margin: calc(24 * var(--rpx)) 0 calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
  font-size: var(--text-caption);
  line-height: 1.65;
}
.confidence-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
}

@media (min-width: 768px) {
  .practice-workspace,
  .page-state,
  .capability-state,
  .pending-checkpoint,
  .inline-warning {
    max-width: 760px;
    margin-right: auto;
    margin-left: auto;
  }

  .question-hero {
    padding: 0;
  }

  .practice-question-pane {
    padding: 24px 24px 112px;
  }

  .question-stem {
    margin-top: 0;
    font-size: 19px;
    line-height: 30px;
  }

  .practice-material-head {
    min-height: 32px;
  }

  .practice-material-chip {
    padding: 4px 10px;
    font-size: 13px;
    line-height: 18px;
  }

  .practice-material-action {
    width: 44px;
    min-width: 44px;
    height: 44px;
  }

  .option-list {
    gap: 12px;
    margin-top: 0;
    padding: 24px 0 0;
  }

  .option-row {
    grid-template-columns: minmax(0, 1fr) 48px;
    gap: 8px;
  }

  .option-card {
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    min-height: 0;
    padding: 17px;
    border-width: 1px;
    border-radius: 20px;
  }

  .option-label {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: 13px;
  }

  .option-copy {
    font-size: 15px;
    line-height: 24.375px;
  }

  .eliminate-action {
    width: 48px;
    min-width: 48px;
    height: auto;
    border-radius: 20px;
  }

  .eliminate-action__icon {
    width: 18px;
    height: 18px;
  }

  .confidence-card {
    margin-right: 0;
    margin-left: 0;
  }

  .question-actions {
    margin-right: 0;
    margin-left: 0;
  }

  .question-actions {
    gap: 10px;
    margin-top: 18px;
  }

  .pause-mask {
    align-items: center;
    justify-content: center;
    padding: 32px;
  }

  .pause-card {
    max-width: 460px;
    padding: 30px;
    border-radius: 24px;
  }

  .result-card,
  .group-summary,
  .verification-card,
  .reflection-gate,
  .completion-card {
    margin-top: 14px;
    padding: 20px;
  }
}

@media (min-width: 1024px) {
  /* 宽屏把材料与题目并排，但两侧仍各自滚动，底栏依旧在滚动区域之外。 */
  .practice-workspace {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(340px, 0.95fr) minmax(0, 1.2fr);
    align-items: stretch;
    gap: 28px;
  }

  .practice-workspace--single .practice-question-pane {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 780px;
    justify-self: center;
  }

  .material-reader-shell {
    display: flex;
    min-width: 0;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    margin-bottom: 0;
    overflow: hidden;
  }

  .practice-material-head {
    flex: none;
  }

  .practice-material-reader {
    min-height: 0;
    flex: 1;
  }

  .practice-question-pane {
    min-width: 0;
    height: 100%;
  }
}

/* ===== Figma 84:161 · 画词工具条 ===== */

/* 透明全屏捕捉层：点空白处收起工具条（不拦截滚动）。 */
.selection-backdrop {
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
}

.selection-toolbar {
  position: fixed;
  z-index: calc(var(--z-overlay) + 1);
  left: 50%;
  display: flex;
  height: calc(92 * var(--rpx));
  align-items: center;
  border-radius: var(--radius-32);
  background: var(--figma-color-ink);
  box-shadow: var(--shadow-elevated);
  transform: translateX(-50%);
}

.selection-toolbar__action {
  box-sizing: border-box;
  display: flex;
  width: auto;
  min-width: 0;
  height: calc(92 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 calc(32 * var(--rpx));
  border: 0;
  border-radius: var(--radius-32);
  color: var(--figma-color-on-dark);
  background: transparent;
  font-size: var(--text-caption);
  font-weight: 700;
}

.selection-toolbar__action--anan {
  color: var(--color-primary-bright);
}

/* 收起：单独的动作，视觉轻量（只放 ✕），避免误点又弹回。 */
.selection-toolbar__action--dismiss {
  color: rgb(255 255 255 / 60%);
}

.selection-toolbar__divider {
  width: calc(1 * var(--rpx));
  height: calc(36 * var(--rpx));
  background: rgb(255 255 255 / 16%);
}

.selection-toolbar__action::after {
  border: 0;
}

/* ===== Figma 97:177-97:201 · 上下文追问岸岸 ===== */

.anan-context {
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
}

.anan-context__mask {
  position: absolute;
  inset: 0;
  background: rgb(15 23 42 / 8%);
}

/* Figma 97:178：h414 顶部圆角 28 白色面板，不覆盖微信胶囊。 */
.anan-context__sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 80vh;
  padding: calc(20 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  border-radius: var(--radius-48) var(--radius-48) 0 0;
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-overlay);
}

.anan-context__grabber {
  width: calc(96 * var(--rpx));
  height: calc(8 * var(--rpx));
  margin: 0 auto;
  border-radius: calc(4 * var(--rpx));
  background: var(--figma-color-line-emphasis);
}

.anan-context__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(28 * var(--rpx));
}

/* Figma 97:180 */
.anan-context__title {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
  line-height: calc(56 * var(--rpx));
}

/* Figma 97:181 */
.anan-context__badge {
  display: flex;
  height: calc(48 * var(--rpx));
  align-items: center;
  gap: calc(12 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
  font-size: var(--text-micro);
  font-weight: 600;
}

.anan-context__badge-dot {
  width: calc(12 * var(--rpx));
  height: calc(12 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary-deep);
}

/* Figma 97:184：青色引用条。 */
.anan-context__quote {
  display: flex;
  min-height: calc(120 * var(--rpx));
  align-items: center;
  gap: calc(20 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--figma-color-cyan-soft);
}

.anan-context__quote-bar {
  width: calc(6 * var(--rpx));
  height: calc(68 * var(--rpx));
  flex: none;
  border-radius: calc(4 * var(--rpx));
  background: var(--color-primary-deep);
}

.anan-context__quote-text {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: calc(40 * var(--rpx));
}

/* Figma 97:187：岸岸回复框。 */
.anan-context__insight {
  box-sizing: border-box;
  min-height: calc(120 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: calc(28 * var(--rpx)) calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-32);
  background: var(--bg);
}

.anan-context__insight--pending {
  color: var(--ink-2);
  font-size: var(--text-body);
}

.anan-context__insight--error {
  color: var(--figma-color-danger-deep);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.anan-context__insight-title {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(44 * var(--rpx));
}

.anan-context__insight-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  line-height: calc(40 * var(--rpx));
}

/* Figma 97:190 */
.anan-context__actions-label {
  margin-top: calc(28 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: calc(44 * var(--rpx));
}

.anan-context__actions {
  display: flex;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
  margin-top: calc(8 * var(--rpx));
}

/* Figma 97:191-97:195 */
.anan-context__action {
  box-sizing: border-box;
  display: flex;
  height: calc(84 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-40);
  color: var(--ink);
  background: var(--bg);
  font-size: var(--text-caption);
  font-weight: 600;
}

.anan-context__action--primary {
  border-color: transparent;
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

/* Figma 97:197 */
.anan-context__hint {
  margin-top: calc(16 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: calc(40 * var(--rpx));
}

/* Figma 97:198：继续追问输入行，不被压到设备底边。 */
.anan-context__input-row {
  position: relative;
  display: flex;
  height: calc(96 * var(--rpx));
  align-items: center;
  margin-top: calc(20 * var(--rpx));
}

.anan-context__input {
  box-sizing: border-box;
  width: 100%;
  height: calc(96 * var(--rpx));
  padding: 0 calc(110 * var(--rpx)) 0 calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-48);
  background: var(--bg);
  color: var(--ink);
  font-size: var(--text-caption);
}

/* Figma 97:200：36px 视觉圆钮，外层 44px 触控热区满足可达性门禁。 */
.anan-context__send {
  position: absolute;
  top: 50%;
  right: calc(2 * var(--rpx));
  box-sizing: border-box;
  display: flex;
  width: calc(88 * var(--rpx));
  min-width: calc(88 * var(--rpx));
  height: calc(88 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  transform: translateY(-50%);
}

.anan-context__send-circle {
  display: flex;
  width: calc(72 * var(--rpx));
  height: calc(72 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-32);
  color: var(--figma-color-on-dark);
  background: var(--color-primary-deep);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.anan-context__action::after,
.anan-context__send::after {
  border: 0;
}

/* 批注层宿主：仅作为相态锚点，本身不拦截触摸。
   --active 只标记"批注层已打开"给内部渲染判断，宿主自身保持 pointer-events:none，
   触摸是否拦截由批注层内部的捕获层/工具栏决定（滑动工具下题目可正常滚动）。 */
.practice-annotation-host {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.practice-annotation-host--active {
  pointer-events: none;
}

.question-swipe-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
  color: var(--figma-color-faint);
  font-size: var(--text-micro);
  line-height: 1.5;
  text-align: center;
}
