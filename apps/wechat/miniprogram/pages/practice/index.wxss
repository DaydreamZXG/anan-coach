.practice { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }
.statusbar { height: env(safe-area-inset-top); }

.p-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}
.p-back { font-size: 56rpx; color: var(--ink); width: 60rpx; }
.p-timer {
  background: var(--primary-soft);
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
}
.p-timer-text { font-size: 30rpx; font-weight: 600; color: var(--primary); }
.p-progress { font-size: 30rpx; color: var(--ink-2); width: 100rpx; text-align: right; }

.p-progress-bar { height: 8rpx; background: var(--line); margin: 0 32rpx 24rpx; border-radius: 999rpx; }
.p-progress-fill { height: 8rpx; background: var(--primary); border-radius: 999rpx; transition: width 0.3s; }

.p-loading { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--ink-3); }
.p-body { flex: 1; padding: 0 32rpx; box-sizing: border-box; }

.q-module {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}
.q-stem { display: block; font-size: 34rpx; line-height: 1.6; color: var(--ink); margin-bottom: 32rpx; }
.q-options { display: flex; flex-direction: column; gap: 20rpx; }
.opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
}
.opt-on { border-color: var(--primary); background: var(--primary-soft); }
.opt-label {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--bg);
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.opt-on .opt-label { background: var(--primary); color: #fff; }
.opt-text { flex: 1; font-size: 30rpx; line-height: 1.5; color: var(--ink); }

.p-foot {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}
.p-foot-btn { flex: 1; }

.demo-tip { text-align: center; padding: 12rpx 0; }
