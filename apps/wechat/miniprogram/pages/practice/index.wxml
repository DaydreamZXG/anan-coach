<task-shell
  id="runtime-task-shell"
  layoutVariant="xingce"
  title="{{view ? view.title : '真实行测训练'}}"
  modeLabel="{{view ? view.modeLabel : '行测练习'}}"
  current="{{view ? view.current : 1}}"
  total="{{view ? view.total : 1}}"
  elapsedLabel="{{view ? view.elapsedLabel : '00:00'}}"
  syncLabel="{{view ? view.syncLabel : '正在连接'}}"
  materialAvailable="{{false}}"
  answerSheetAvailable="{{status === 'ready' && sessionState === 'answering'}}"
  draftAvailable="{{false}}"
  markAvailable="{{false}}"
  timerPausable="{{status === 'ready' && sessionState === 'answering'}}"
  timerPaused="{{taskPaused}}"
  marked="{{view && view.question ? view.question.marked : false}}"
  toolsAvailable="{{status === 'ready' && sessionState === 'answering'}}"
  footerAvailable="{{status === 'ready' && sessionState === 'answering' && view && view.current === view.total}}"
  headerAvailable="{{status !== 'ready' || sessionState === 'answering'}}"
  bindexit="exit"
  bindmaterial="toggleMaterial"
  bindanswersheet="toggleAnswerSheet"
  binddraft="toggleDraft"
  bindtimer="toggleTaskPause"
  bindmark="toggleMarked"
  bindtools="openTaskTools"
>
  <view wx:if="{{status === 'loading'}}" class="page-state">
    <state-view state="loading" title="正在恢复真实作答" description="正在恢复你上次的作答进度。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" actionText="重试" bindaction="retry" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="capability-state card">
    <view class="capability-mark">先完成前置学习</view>
    <view class="capability-title">{{errorTitle}}</view>
    <view class="capability-copy">{{errorMessage}}</view>
    <button hover-class="item--hover" wx:if="{{showLoginAction}}" class="secondary-button capability-action" bindtap="goLogin">重新登录</button>
    <button hover-class="item--hover" wx:if="{{showTodayAction}}" class="primary-button capability-action" bindtap="goToday">去今日计划</button>
  </view>

  <block wx:elif="{{status === 'ready' && view}}">
    <view wx:if="{{errorMessage}}" class="inline-warning">{{errorMessage}}</view>
    <view wx:if="{{hasPendingCheckpoint}}" class="pending-checkpoint card">
      <view class="pending-checkpoint-title">上次的进度没存上</view>
      <view class="pending-checkpoint-copy">{{pendingCheckpointMessage}}</view>
      <button hover-class="item--hover" class="secondary-button" bindtap="retryPendingCheckpoint">重试一次</button>
    </view>

    <block wx:if="{{sessionState === 'answering'}}">
      <view class="practice-workspace {{view.question.material ? 'practice-workspace--with-material' : 'practice-workspace--single'}}">
        <view wx:if="{{view.question.material}}" class="material-reader-shell {{materialOpen ? 'material-reader-shell--immersive' : ''}}">
          <!-- Figma 2:76：材料标题行承载收藏、岸岸与收起，顶栏因此不必挤满一排。 -->
          <view class="practice-material-head">
            <view class="practice-material-chip">
              <text>{{view.question.moduleName}} · 共享材料</text>
              <text wx:if="{{view.materialScopeLabel}}"> ({{view.materialScopeLabel}})</text>
            </view>
            <view class="practice-material-actions">
              <button
                class="practice-material-action practice-material-action--mark {{view.question.marked ? 'practice-material-action--marked' : ''}}"
                hover-class="item--hover"
                disabled="{{interactionLocked}}"
                aria-label="{{view.question.marked ? '取消标记本题' : '标记本题'}}"
                bindtap="toggleMarked"
              >
                <image
                  class="practice-material-icon practice-material-icon--bookmark"
                  src="/assets/icons/task/bookmark-active.svg"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </button>
              <button
                class="practice-material-action practice-material-action--anan"
                hover-class="item--hover"
                disabled="{{interactionLocked}}"
                aria-label="就本题追问岸岸"
                bindtap="openAnanContext"
              >
                <image
                  class="practice-material-icon practice-material-icon--anan"
                  src="/assets/icons/task/anan.svg"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </button>
              <button
                class="practice-material-action practice-material-action--collapse"
                hover-class="item--hover"
                disabled="{{interactionLocked}}"
                aria-label="沉浸阅读材料"
                bindtap="toggleMaterial"
              >
                <image
                  class="practice-material-icon practice-material-icon--collapse"
                  src="/assets/icons/task/collapse.svg"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </button>
            </view>
          </view>

          <material-reader
            appearance="answering"
            inlineHeaderAvailable="{{false}}"
            title="{{view.question.material.title || '本题材料'}}"
            subtitle="{{view.question.moduleName}}{{view.materialScopeLabel ? ' · 第 ' + view.materialScopeLabel : ''}}"
            chipLabel="{{view.question.moduleName}} · 共享材料{{view.materialScopeLabel ? '（' + view.materialScopeLabel + '）' : ''}}"
            returnLabel="回到第 {{view.current}} 题"
            blocks="{{view && view.question && view.question.material && view.question.material.content ? view.question.material.content : emptyRichContentBlocks}}"
            anchors="{{view && view.question && view.question.material && view.question.material.anchors ? view.question.material.anchors : emptyContentAnchors}}"
            state="{{materialReaderState}}"
            bindstatechange="updateMaterialReader"
          />
        </view>

        <!-- Figma 2:132：题干与选项自成滚动区，底部留出 112px 让 D 选项不被底栏遮住。 -->
        <!--
          左右快滑切题只绑在题目滚动区（平板双栏时材料栏不参与）。
          判定阈值与已知边界（content-renderer 表格横向滚动）见 task-runtime/swipe-nav.ts。
        -->
        <scroll-view
          class="practice-question-pane"
          scroll-y
          scroll-top="{{questionScrollTop}}"
          enhanced
          show-scrollbar="{{false}}"
          bindtouchstart="onQuestionTouchStart"
          bindtouchmove="onQuestionTouchMove"
          bindtouchend="onQuestionTouchEnd"
        >
        <view
          class="practice-question-body {{view && view.current === view.total ? 'practice-question-body--with-footer' : ''}} {{questionTransition ? 'motion-question-in--' + questionTransition : ''}}"
          bindanimationend="clearQuestionTransition"
        >
          <view class="question-hero">
            <view class="question-heading">
              <text class="question-number">{{view.current}}.</text>
              <!-- Figma 84:2 画词：题干句段可选中，点选后浮出工具条。 -->
              <content-renderer
                class="question-stem question-rich-content"
                blocks="{{view && view.question && view.question.stemContent ? view.question.stemContent : emptyRichContentBlocks}}"
                zoom="{{1}}"
                preferences="{{displayPreferences}}"
                selectable
                selectedSegmentKey="{{selection.key}}"
                bindsegmenttap="tapStemSegment"
              />
            </view>
          </view>

          <view class="option-list {{interactionLocked ? 'option-list--locked' : ''}}">
            <view
              wx:for="{{view.question.options}}"
              wx:key="optionId"
              class="option-row"
            >
              <view
                class="option-card {{item.selected ? 'option-card--selected' : ''}} {{item.eliminated ? 'option-card--eliminated' : ''}}"
                hover-class="option--hover"
                data-optionid="{{item.optionId}}"
                bindtap="selectOption"
              >
                <view class="option-label">{{item.label}}</view>
                <content-renderer
                  class="option-copy option-rich-content"
                  blocks="{{item.content ? item.content : emptyRichContentBlocks}}"
                  zoom="{{1}}"
                  preferences="{{displayPreferences}}"
                />
              </view>
              <button
                class="eliminate-action {{item.eliminated ? 'eliminate-action--active' : ''}}"
                hover-class="item--hover"
                aria-label="{{item.eliminated ? '撤销排除选项 ' + item.label : '排除选项 ' + item.label}}"
                data-optionid="{{item.optionId}}"
                catchtap="toggleEliminated"
              >
                <image
                  class="eliminate-action__icon"
                  src="{{item.eliminated ? '/assets/icons/task/eliminate.svg' : '/assets/icons/task/eliminate-faint.svg'}}"
                  mode="aspectFit"
                  aria-hidden="true"
                />
              </button>
            </view>
          </view>

          <view wx:if="{{view.question.selectedOptionIds.length > 0}}" class="confidence-card">
            <view class="confidence-prompt">刚刚这题选得怎么样？</view>
            <view class="confidence-row confidence-row--question">
              <button hover-class="item--hover"
                wx:for="{{confidenceOptions}}"
                wx:key="value"
                class="control-center confidence-chip confidence-chip--question {{view.question.confidence === item.value ? 'confidence-chip--active' : ''}}"
                data-confidence="{{item.value}}"
                bindtap="selectConfidence"
              >{{item.label}}</button>
            </view>
          </view>

          <view class="question-actions">
            <button class="skip-button question-action" hover-class="item--hover" disabled="{{interactionLocked}}" bindtap="skipQuestion">{{view.question.skipped ? '已明确跳过' : '这题先放弃，稍后再看'}}</button>
          </view>
          <view wx:if="{{view.current < view.total}}" class="question-swipe-hint">
            <text>←</text>
            <text>左右滑动切题，点顶部题号可打开答题卡</text>
            <text>→</text>
          </view>
        </view>
        </scroll-view>

        <!-- Figma 70:2 题面直接批注：笔迹层覆盖在题面上，static 时触摸穿透。 -->
        <view class="practice-annotation-host {{annotationOpen ? 'practice-annotation-host--active' : ''}}">
          <annotation-layer
            mode="{{annotationOpen ? 'annotate' : (view.question.annotations.length ? 'static' : 'hidden')}}"
            strokes="{{view.question.annotations}}"
            elapsedSeconds="{{view.question.elapsedSeconds}}"
            elapsedMs="{{view.question.elapsedMs || -1}}"
            bindstrokeschange="changeAnnotations"
            binddone="closeAnnotation"
          />
        </view>
      </view>

      <!-- Figma 84:161 画词工具条：不遮住选中文字，也不遮住固定底栏。 -->
      <view
        wx:if="{{selection.key && !ananContextOpen && !annotationOpen}}"
        class="selection-toolbar"
        style="top: {{selection.toolbarTop}}px;"
      >
        <button hover-class="item--hover" class="selection-toolbar__action" catchtap="explainSelection">解释</button>
        <view class="selection-toolbar__divider" aria-hidden="true"></view>
        <button hover-class="item--hover" class="selection-toolbar__action" catchtap="compareSelectionOptions">对比选项</button>
        <view class="selection-toolbar__divider" aria-hidden="true"></view>
        <button hover-class="item--hover" class="selection-toolbar__action selection-toolbar__action--anan" catchtap="askAboutSelection">问岸岸</button>
      </view>

      <!-- Figma 97:2 上下文追问岸岸：当前题目的操作面板，不是普通聊天页。 -->
      <view wx:if="{{ananContextOpen}}" class="anan-context motion-mask" catchtouchmove="noop">
        <view class="anan-context__mask" catchtap="closeAnanContext" aria-label="收起岸岸面板"></view>
        <view class="anan-context__sheet">
          <view class="anan-context__grabber" aria-hidden="true"></view>
          <view class="anan-context__head">
            <view class="anan-context__title">岸岸 · 当前题目</view>
            <view class="anan-context__badge">
              <view class="anan-context__badge-dot" aria-hidden="true"></view>
              <text>依据题干与材料</text>
            </view>
          </view>

          <view wx:if="{{selection.text}}" class="anan-context__quote">
            <view class="anan-context__quote-bar" aria-hidden="true"></view>
            <text class="anan-context__quote-text">“{{selection.text}}”</text>
          </view>

          <view wx:if="{{ananAsking}}" class="anan-context__insight anan-context__insight--pending">岸岸正在读这道题……</view>
          <view wx:elif="{{ananReply}}" class="anan-context__insight">
            <view wx:if="{{ananReplyTitle}}" class="anan-context__insight-title">{{ananReplyTitle}}</view>
            <view class="anan-context__insight-copy">{{ananReply}}</view>
          </view>
          <view wx:elif="{{ananError}}" class="anan-context__insight anan-context__insight--error">{{ananError}}</view>

          <view class="anan-context__actions-label">让岸岸直接帮你</view>
          <view class="anan-context__actions">
            <button hover-class="item--hover"
              wx:if="{{selection.text}}"
              class="anan-context__action anan-context__action--primary"
              catchtap="markSelectionOnQuestion"
            >在题面标出所选</button>
            <button hover-class="item--hover" class="anan-context__action" catchtap="compareSelectionOptions">对比选项</button>
            <button hover-class="item--hover" class="anan-context__action" catchtap="logSelectionToDraft">记入本题错因</button>
          </view>
          <view class="anan-context__hint">动作会先给你确认，再写入练习与能力记录</view>

          <view class="anan-context__input-row">
            <input
              class="anan-context__input"
              value="{{ananInput}}"
              placeholder="继续问：例如 为什么不能用 216784？"
              confirm-type="send"
              cursor-spacing="24"
              bindinput="inputAnanQuestion"
              bindconfirm="sendAnanQuestion"
            />
            <button hover-class="item--hover" class="anan-context__send" disabled="{{ananAsking}}" catchtap="sendAnanQuestion" aria-label="发送追问">
              <view class="anan-context__send-circle" aria-hidden="true">↑</view>
            </button>
          </view>
        </view>
      </view>

      <!-- Figma 59:2 / 60:4：答题卡半屏 Bottom Sheet，题号使用圆形状态。 -->
      <view wx:if="{{answerSheetOpen}}" class="answer-card motion-mask" catchtouchmove="noop">
        <view class="answer-card__mask" catchtap="toggleAnswerSheet" aria-label="关闭答题卡"></view>
        <view class="answer-card__sheet">
          <view class="answer-card__handle-row" aria-hidden="true">
            <view class="answer-card__handle"></view>
          </view>

          <view class="answer-card__header">
            <view class="answer-card__title-group">
              <view class="answer-card__title">答题卡</view>
              <view class="answer-card__subtitle">{{answerSheetSubtitle}}</view>
            </view>
            <button hover-class="item--hover" class="answer-card__close" aria-label="关闭答题卡" bindtap="toggleAnswerSheet">×</button>
          </view>

          <view class="answer-card__legend">
            <view class="answer-card__legend-item">
              <view class="answer-card__legend-dot answer-card__legend-dot--answered" aria-hidden="true"></view>
              <text>已答 {{answerSheetLegend.answered}}</text>
            </view>
            <view class="answer-card__legend-item">
              <view class="answer-card__legend-dot answer-card__legend-dot--unanswered" aria-hidden="true"></view>
              <text>未答 {{answerSheetLegend.unanswered}}</text>
            </view>
            <view class="answer-card__legend-item">
              <view class="answer-card__legend-dot answer-card__legend-dot--current" aria-hidden="true"></view>
              <text>当前 1</text>
            </view>
            <view class="answer-card__legend-item">
              <view class="answer-card__legend-dot answer-card__legend-dot--marked" aria-hidden="true"></view>
              <text>标记 {{answerSheetLegend.marked}}</text>
            </view>
          </view>

          <view class="answer-card__section">
            <view class="answer-card__module-row">
              <view class="answer-card__module-name">{{answerSheetModuleName}}</view>
              <view class="answer-card__module-counts">{{answerSheetModuleCounts}}</view>
            </view>
            <view class="answer-card__grid">
              <view wx:for="{{answerSheetItems}}" wx:key="index" class="answer-card__cell">
                <button hover-class="item--hover"
                  class="answer-card__question answer-card__question--{{item.active ? 'current' : item.state}} {{!item.active && item.marked ? 'answer-card__question--marked' : ''}}"
                  aria-label="第 {{item.label}} 题{{item.active ? '，当前题' : item.marked ? '，已标记' : item.state === 'answered' ? '，已作答' : '，未作答'}}"
                  data-index="{{item.index}}"
                  bindtap="selectQuestion"
                >{{item.label}}</button>
                <view wx:if="{{item.marked && !item.active}}" class="answer-card__marked-badge" aria-hidden="true">!</view>
              </view>
            </view>
            <view class="answer-card__hint">点题号即可直接切换，标记题会进入复盘</view>
          </view>

          <view class="answer-card__insight">
            <image class="answer-card__insight-icon" src="/assets/icons/task/answer-card-insight.svg" mode="aspectFit" aria-hidden="true" />
            <view class="answer-card__insight-copy">
              <view class="answer-card__insight-title">岸岸会记住你的标记与存疑</view>
              <view class="answer-card__insight-sub">交卷后优先进入证据复盘</view>
            </view>
          </view>

          <button hover-class="item--hover" class="answer-card__cta" bindtap="toggleAnswerSheet">继续第 {{view.current}} 题</button>
        </view>
      </view>

      <ui-sheet
        visible="{{draftOpen}}"
        title="草稿纸"
        copy="当前第 {{view.current}} / {{view.total}} 题 · 自动保存"
        max-height="80vh"
        bindclose="toggleDraft"
      >
        <button hover-class="item--hover" slot="action" class="mark-action {{view.question.marked ? 'mark-action--active' : ''}}" bindtap="toggleMarked">{{view.question.marked ? '已标记' : '标记'}}</button>
        <textarea cursor-spacing="24" class="draft-input draft-input--sheet" value="{{view.question.draftText}}" maxlength="4000" placeholder="写下公式、排除理由或仍不确定的点……" bindinput="inputDraft"></textarea>
        <button hover-class="item--hover" class="math-ink-entry" bindtap="toggleMathInk">{{mathInkOpen ? '收起手写公式' : '手写公式识别'}}</button>
        <view wx:if="{{mathInkOpen}}" class="math-ink-panel">
          <view class="math-ink-tip">先手写，识别成公式后核对一下，确认再放进草稿。</view>
          <math-ink-pad recognizing="{{mathInkRecognizing}}" bind:recognize="recognizeMathInk" />
          <view wx:if="{{mathInkCandidate}}" class="math-ink-review">
            <view class="confidence-label">识别候选</view>
            <textarea cursor-spacing="24" class="math-ink-latex" value="{{mathInkLatex}}" maxlength="4000" bindinput="inputMathInkLatex"></textarea>
            <button hover-class="item--hover" class="primary-button" loading="{{mathInkRecognizing}}" bindtap="confirmMathInk">确认并写入草稿</button>
          </view>
          <view wx:if="{{mathInkError}}" class="inline-warning">{{mathInkError}}</view>
        </view>
        <view class="confidence-row">
          <view class="confidence-label">作答信心</view>
          <button hover-class="item--hover"
            wx:for="{{confidenceOptions}}"
            wx:key="value"
            class="control-center confidence-chip {{view.question.confidence === item.value ? 'confidence-chip--active' : ''}}"
            data-confidence="{{item.value}}"
            bindtap="selectConfidence"
          >{{item.label}}</button>
        </view>
        <button hover-class="item--hover" class="primary-button draft-sheet-action" bindtap="toggleDraft">收起草稿，继续作答</button>
      </ui-sheet>

      <!-- Figma 82:155/82:156：暂停卡位于屏幕视觉中心，背景题目降权保留。 -->
      <view wx:if="{{taskPaused}}" class="pause-mask motion-mask" catchtouchmove="noop">
        <view class="pause-card">
          <view class="pause-icon" aria-hidden="true">
            <view class="pause-icon__bar"></view>
            <view class="pause-icon__bar"></view>
          </view>
          <view class="pause-title">训练已暂停</view>
          <view class="pause-time type-data">{{view.elapsedLabel}}</view>
          <view class="pause-copy">先把气喘匀，题就在原地等你。\n暂停期间不计入作答用时。\n材料位置、答案与批注均已保留。</view>
          <button hover-class="item--hover" class="pause-resume" bindtap="toggleTaskPause">继续作答</button>
          <button hover-class="item--hover" class="control-center pause-exit" bindtap="exit">结束本次训练</button>
        </view>
      </view>
    </block>

    <view wx:else class="page-state">
      <state-view state="loading" title="正在打开训练总结" description="交卷已完成，正在进入可回看的总结与复盘。" />
    </view>
  </block>

  <ui-sheet
    visible="{{toolsOpen}}"
    title="做题工具"
    copy="修改会自动保存"
    show-close
    level="overlay"
    max-height="86vh"
    bindclose="closeTaskOverlay"
  >
    <view class="task-tool-grid">
      <button hover-class="item--hover" class="control-center task-tool-item" bindtap="openAnnotation">题面批注</button>
      <button hover-class="item--hover" class="control-center task-tool-item" bindtap="toggleMarked">{{view.question.marked ? '取消标记' : '标记本题'}}</button>
      <button hover-class="item--hover" wx:if="{{toolPolicy.dispute_report}}" class="control-center task-tool-item" bindtap="openDispute">题目争议</button>
      <button hover-class="item--hover" wx:if="{{toolPolicy.operation_help}}" class="control-center task-tool-item" bindtap="openTaskHelp">操作/故障帮助</button>
      <button hover-class="item--hover" class="control-center task-tool-item {{displayPreferences.colorMode === 'eye_care' ? 'task-tool-item--active' : ''}}" bindtap="toggleDisplayEyeCare">护眼模式</button>
    </view>
    <view class="display-tool-row">
      <button hover-class="item--hover" class="display-tool-button" bindtap="decreaseDisplayFont">A−</button>
      <view>字号 {{displayPreferences.fontScale * 100}}%</view>
      <button hover-class="item--hover" class="display-tool-button" bindtap="increaseDisplayFont">A＋</button>
    </view>
    <view class="locked-tools">公式卡、完整解析和解题 AI 在提交前不可用；国考模式不提供计算器。</view>
  </ui-sheet>

  <ui-sheet
    visible="{{helpOpen}}"
    level="overlay"
    show-handle="{{false}}"
    sheet-class="help-sheet"
    max-height="86vh"
    bindclose="closeTaskOverlay"
  >
    <global-help
      pageObjectReference="{{helpReference}}"
      syncState="{{helpSyncState}}"
      bindsubmit="submitTaskHelp"
      bindclose="closeTaskOverlay"
    />
    <view wx:if="{{helpSubmitting}}" class="overlay-result">正在查询确定性帮助……</view>
    <view wx:elif="{{helpGuidance}}" class="overlay-result">{{helpGuidance}}</view>
  </ui-sheet>

  <ui-sheet
    visible="{{disputeOpen}}"
    title="题目异常或争议"
    copy="报错不影响继续做题，我们会定位到这道题。"
    show-close
    level="overlay"
    max-height="86vh"
    bindclose="closeTaskOverlay"
  >
    <view class="dispute-categories">
      <button hover-class="item--hover"
        wx:for="{{disputeCategories}}"
        wx:key="value"
        class="dispute-category {{disputeCategory === item.value ? 'dispute-category--active' : ''}}"
        data-category="{{item.value}}"
        bindtap="selectDisputeCategory"
      >{{item.label}}</button>
    </view>
    <textarea cursor-spacing="24" class="dispute-description" value="{{disputeDescription}}" maxlength="2000" placeholder="请描述具体问题；不要填写个人敏感信息。" bindinput="inputDisputeDescription"></textarea>
    <button hover-class="item--hover" class="primary-button" loading="{{disputeSubmitting}}" disabled="{{disputeSubmitting}}" bindtap="submitDispute">提交争议记录</button>
    <view wx:if="{{disputeReceipt}}" class="overlay-result">{{disputeReceipt}}</view>
  </ui-sheet>

  <view slot="footer" class="task-footer-actions" wx:if="{{status === 'ready' && sessionState === 'answering' && view && view.current === view.total}}">
    <button hover-class="item--hover" class="primary-button submit-button" disabled="{{interactionLocked}}" bindtap="footerAction">{{canSubmit ? '交卷并查看结果' : '查看未完成题目'}}</button>
  </view>
</task-shell>
