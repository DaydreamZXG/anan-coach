<task-shell
  title="{{view ? view.title : '真实行测训练'}}"
  modeLabel="{{view ? view.modeLabel : '行测 Agent'}}"
  current="{{view ? view.current : 1}}"
  total="{{view ? view.total : 1}}"
  elapsedLabel="{{view ? view.elapsedLabel : '00:00'}}"
  syncLabel="{{view ? view.syncLabel : '连接服务端'}}"
  materialAvailable="{{view && view.materialAvailable}}"
  answerSheetAvailable="{{status === 'ready' && sessionState === 'answering'}}"
  draftAvailable="{{status === 'ready' && sessionState === 'answering'}}"
  timerPausable="{{status === 'ready' && sessionState === 'answering'}}"
  timerPaused="{{taskPaused}}"
  toolsAvailable="{{status === 'ready' && sessionState === 'answering'}}"
  footerAvailable="{{status === 'ready' && sessionState === 'answering'}}"
  bindexit="exit"
  bindmaterial="toggleMaterial"
  bindanswersheet="toggleAnswerSheet"
  binddraft="toggleDraft"
  bindtimer="toggleTaskPause"
  bindtools="openTaskTools"
>
  <view wx:if="{{status === 'loading'}}" class="page-state">
    <state-view state="loading" title="正在恢复真实作答" description="题组与断点均以服务端版本为准。" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state">
    <state-view state="error" title="{{errorTitle}}" description="{{errorMessage}}" actionText="重试" bindaction="retry" />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="capability-state card">
    <view class="capability-mark">真实学习证据门禁</view>
    <view class="capability-title">{{errorTitle}}</view>
    <view class="capability-copy">{{errorMessage}}</view>
    <button wx:if="{{showLoginAction}}" class="secondary-button capability-action" bindtap="goLogin">重新登录</button>
  </view>

  <block wx:elif="{{status === 'ready' && view}}">
    <view wx:if="{{errorMessage}}" class="inline-warning">{{errorMessage}}</view>
    <view wx:if="{{hasPendingCheckpoint}}" class="pending-checkpoint card">
      <view class="pending-checkpoint-title">上次断点保存结果未知</view>
      <view class="pending-checkpoint-copy">{{pendingCheckpointMessage}}</view>
      <button class="secondary-button" bindtap="retryPendingCheckpoint">按原命令重试</button>
    </view>

    <block wx:if="{{sessionState === 'answering'}}">
      <view class="practice-workspace {{view.question.material ? 'practice-workspace--with-material' : 'practice-workspace--single'}}">
        <view wx:if="{{view.question.material}}" class="material-reader-shell">
          <material-reader
            title="{{view.question.material.title || '本题材料'}}"
            blocks="{{view.question.material.content}}"
            anchors="{{view.question.material.anchors}}"
            state="{{materialReaderState}}"
            bindstatechange="updateMaterialReader"
          />
        </view>

        <view class="practice-question-pane">
          <view class="question-hero">
            <view class="question-meta-row">
              <view class="module-pill">{{view.question.moduleName}}</view>
              <view class="position-label">{{view.question.positionLabel}}</view>
            </view>
            <content-renderer
              class="question-stem question-rich-content"
              style="--color-ink: #17211f; --color-muted: #354541;"
              blocks="{{view.question.stemContent}}"
              zoom="{{1}}"
              preferences="{{displayPreferences}}"
            />
          </view>

          <view class="option-list {{interactionLocked ? 'option-list--locked' : ''}}">
            <view
              wx:for="{{view.question.options}}"
              wx:key="optionId"
              class="option-card {{item.selected ? 'option-card--selected' : ''}} {{item.eliminated ? 'option-card--eliminated' : ''}}"
              hover-class="option--hover"
              data-optionid="{{item.optionId}}"
              bindtap="selectOption"
            >
              <view class="option-label">{{item.label}}</view>
              <content-renderer
                class="option-copy option-rich-content"
                blocks="{{item.content}}"
                zoom="{{1}}"
                preferences="{{displayPreferences}}"
              />
              <button class="eliminate-action" hover-class="item--hover" data-optionid="{{item.optionId}}" catchtap="toggleEliminated">{{item.eliminated ? '撤销排除' : '排除'}}</button>
            </view>
          </view>

          <view class="question-actions">
            <button class="secondary-button question-action" hover-class="secondary-button--hover" disabled="{{view.current === 1 || interactionLocked}}" bindtap="previousQuestion">上一题</button>
            <button class="skip-button question-action" hover-class="item--hover" disabled="{{interactionLocked}}" bindtap="skipQuestion">{{view.question.skipped ? '已明确跳过' : '这题先放弃'}}</button>
          </view>
        </view>
      </view>

      <view wx:if="{{answerSheetOpen}}" class="answer-sheet-mask" catchtap="toggleAnswerSheet">
        <view class="answer-sheet" catchtap="noop">
          <view class="sheet-handle"></view>
          <view class="sheet-head">
            <view>
              <view class="sheet-title">答题卡</view>
              <view class="sheet-copy">{{view.answeredCount}} 已答 · {{view.skippedCount}} 跳过 · {{view.unansweredCount}} 未处理</view>
            </view>
            <button class="text-action" bindtap="toggleAnswerSheet">关闭</button>
          </view>
          <view class="sheet-grid">
            <button
              wx:for="{{answerSheetItems}}"
              wx:key="index"
              class="sheet-item sheet-item--{{item.state}} {{item.active ? 'sheet-item--active' : ''}}"
              data-index="{{item.index}}"
              bindtap="selectQuestion"
            >{{item.label}}</button>
          </view>
        </view>
      </view>

      <view wx:if="{{draftOpen}}" class="answer-sheet-mask" catchtap="toggleDraft" catchtouchmove="noop">
        <view class="answer-sheet draft-sheet" catchtap="noop">
          <view class="sheet-handle"></view>
          <view class="thinking-head">
            <view>
              <view class="thinking-title">草稿纸</view>
              <view class="thinking-copy">当前第 {{view.current}} / {{view.total}} 题 · 随断点自动保存</view>
            </view>
            <button class="mark-action {{view.question.marked ? 'mark-action--active' : ''}}" bindtap="toggleMarked">{{view.question.marked ? '已标记' : '标记'}}</button>
          </view>
          <textarea class="draft-input draft-input--sheet" value="{{view.question.draftText}}" maxlength="4000" placeholder="写下公式、排除理由或仍不确定的点……" bindinput="inputDraft"></textarea>
          <view class="confidence-row">
            <view class="confidence-label">作答信心</view>
            <button
              wx:for="{{confidenceOptions}}"
              wx:key="value"
              class="confidence-chip {{view.question.confidence === item.value ? 'confidence-chip--active' : ''}}"
              data-confidence="{{item.value}}"
              bindtap="selectConfidence"
            >{{item.label}}</button>
          </view>
          <button class="primary-button draft-sheet-action" bindtap="toggleDraft">收起草稿，继续作答</button>
        </view>
      </view>

      <view wx:if="{{taskPaused}}" class="pause-mask" catchtouchmove="noop">
        <view class="pause-card">
          <view class="pause-play" aria-hidden="true"></view>
          <view class="pause-title">训练已暂停</view>
          <view class="pause-time type-data">{{view.elapsedLabel}}</view>
          <view class="pause-copy">暂停期间不计入作答用时。材料位置、答案和草稿均已保留。</view>
          <button class="primary-button" bindtap="toggleTaskPause">继续作答</button>
          <button class="pause-exit" bindtap="exit">结束训练</button>
        </view>
      </view>
    </block>

    <view wx:else class="result-workspace">
      <view class="result-hero">
        <view class="result-eyebrow">服务端已按冻结事实合同评分</view>
        <view class="result-score"><text class="result-score__value">{{result.correctCount}}</text> / {{result.totalCount}}</view>
        <view class="result-title">{{result.headline}}</view>
        <view class="result-copy">{{result.summary}}</view>
      </view>

      <view wx:if="{{result.group}}" class="group-summary card group-summary--{{result.group.outcomeTone}}">
        <view class="group-head">
          <view>
            <view class="group-kicker">3 题组结果</view>
            <view class="group-title">{{result.group.outcomeLabel}}</view>
          </view>
          <view class="group-code type-data">{{result.group.outcome}}</view>
        </view>
        <view class="group-description">{{result.group.description}}</view>
        <view class="group-counts">
          <view wx:for="{{result.group.counts}}" wx:key="code" class="group-count-item">
            <view class="group-count-value type-data">{{item.value}}</view>
            <view class="group-count-label">{{item.label}}</view>
          </view>
        </view>
        <view class="group-next">{{result.group.nextActionLabel}}</view>
      </view>

      <view wx:elif="{{result.availability === 'legacy_result_unavailable'}}" class="legacy-result card">
        <view class="legacy-result-title">历史结果不提供新事实拆分</view>
        <view class="legacy-result-copy">不补算真会、猜对、主动放弃、超建议用时或方法正确但计算错误。原结果只读保留。</view>
        <view class="legacy-result-code type-data">legacy_result_unavailable</view>
      </view>

      <view wx:if="{{result.verification}}" class="verification-card card verification-card--{{result.verification.outcomeTone}}">
        <view class="verification-head">
          <view>
            <view class="verification-kicker">{{result.verification.stageLabel}}</view>
            <view class="verification-title">{{result.verification.outcomeLabel}}</view>
          </view>
          <view class="verification-evidence verification-evidence--{{result.verification.evidenceState}}">{{result.verification.evidenceLabel}}</view>
        </view>
        <view class="verification-description">{{result.verification.evidenceDescription}}</view>
        <view class="verification-source type-data">{{result.verification.sourceVersionLabel}}</view>
      </view>

      <view wx:for="{{result.items}}" wx:key="questionId" class="result-card card">
        <view class="result-card-head">
          <view>
            <view class="result-position">{{item.positionLabel}}</view>
            <view class="result-status result-status--{{item.resultTone}}">{{item.resultLabel}}</view>
          </view>
          <view class="result-answer">你的答案 {{item.selectedLabel}} · 正确答案 {{item.correctLabel}}</view>
        </view>
        <view class="result-facts">
          <view class="result-fact">{{item.objectiveLabel}}</view>
          <view class="result-fact">{{item.confidenceLabel}}</view>
          <view class="result-fact">{{item.dispositionLabel}}</view>
        </view>
        <view class="timing-fact {{item.timingExceeded ? 'timing-fact--exceeded' : ''}}">{{item.timingLabel}}<text wx:if="{{item.timingExceeded}}" class="timing-fact__note">·只记录用时，不自动判错</text></view>
        <view class="explanation">{{item.explanation}}</view>
        <view class="explanation-source">{{item.explanationSource}}</view>
        <button class="result-dispute" data-questionid="{{item.questionId}}" bindtap="openResultDispute">这题有争议</button>
      </view>
      <view wx:if="{{sessionState !== 'completed'}}" class="reflection-gate card">
        <view class="gate-mark">必做复盘</view>
        <view class="gate-title">先写下你当时真实的想法</view>
        <view class="gate-copy">岸岸不会把猜对或超建议用时冒充为错因。错因与逐题解读由你确认。</view>
        <button class="primary-button" bindtap="openReflection">开始复盘</button>
      </view>
      <view wx:else class="completion-card card">
        <view class="completion-mark">学习证据已结算</view>
        <view class="completion-title">今日计划已经按本次真实结果重排</view>
        <button class="primary-button" bindtap="returnToday">返回今日计划</button>
      </view>
    </view>
  </block>

  <view wx:if="{{toolsOpen}}" class="task-overlay" catchtap="closeTaskOverlay">
    <view class="task-tool-panel" catchtap="noop">
      <view class="overlay-head">
        <view>
          <view class="overlay-title">做题工具</view>
          <view class="overlay-copy">专项训练 · 修改会随断点保存</view>
        </view>
        <button class="text-action" bindtap="closeTaskOverlay">关闭</button>
      </view>
      <view class="task-tool-grid">
        <button class="task-tool-item" bindtap="toggleMarked">{{view.question.marked ? '取消标记' : '标记本题'}}</button>
        <button wx:if="{{toolPolicy.dispute_report}}" class="task-tool-item" bindtap="openDispute">题目争议</button>
        <button wx:if="{{toolPolicy.operation_help}}" class="task-tool-item" bindtap="openTaskHelp">操作/故障帮助</button>
        <button class="task-tool-item {{displayPreferences.colorMode === 'eye_care' ? 'task-tool-item--active' : ''}}" bindtap="toggleDisplayEyeCare">护眼模式</button>
      </view>
      <view class="display-tool-row">
        <button class="display-tool-button" bindtap="decreaseDisplayFont">A−</button>
        <view>字号 {{displayPreferences.fontScale * 100}}%</view>
        <button class="display-tool-button" bindtap="increaseDisplayFont">A＋</button>
      </view>
      <view class="locked-tools">公式卡、完整解析和解题 AI 在提交前不可用；国考模式不提供计算器。</view>
    </view>
  </view>

  <view wx:if="{{helpOpen}}" class="task-overlay" catchtap="closeTaskOverlay">
    <view class="task-help-panel" catchtap="noop">
      <global-help
        pageObjectReference="{{helpReference}}"
        syncState="{{helpSyncState}}"
        bindsubmit="submitTaskHelp"
        bindclose="closeTaskOverlay"
      />
      <view wx:if="{{helpSubmitting}}" class="overlay-result">正在查询确定性帮助……</view>
      <view wx:elif="{{helpGuidance}}" class="overlay-result">{{helpGuidance}}</view>
    </view>
  </view>

  <view wx:if="{{disputeOpen}}" class="task-overlay" catchtap="closeTaskOverlay">
    <view class="dispute-panel" catchtap="noop">
      <view class="overlay-head">
        <view>
          <view class="overlay-title">题目异常或争议</view>
          <view class="overlay-copy">继续作答不受影响；服务端会自动附带题面版本、断点和材料位置。</view>
        </view>
        <button class="text-action" bindtap="closeTaskOverlay">关闭</button>
      </view>
      <view class="dispute-categories">
        <button
          wx:for="{{disputeCategories}}"
          wx:key="value"
          class="dispute-category {{disputeCategory === item.value ? 'dispute-category--active' : ''}}"
          data-category="{{item.value}}"
          bindtap="selectDisputeCategory"
        >{{item.label}}</button>
      </view>
      <textarea class="dispute-description" value="{{disputeDescription}}" maxlength="2000" placeholder="请描述具体问题；不要填写个人敏感信息。" bindinput="inputDisputeDescription"></textarea>
      <button class="primary-button" loading="{{disputeSubmitting}}" disabled="{{disputeSubmitting}}" bindtap="submitDispute">提交争议记录</button>
      <view wx:if="{{disputeReceipt}}" class="overlay-result">{{disputeReceipt}}</view>
    </view>
  </view>

  <view slot="footer" class="task-footer-actions" wx:if="{{status === 'ready' && sessionState === 'answering'}}">
    <button class="primary-button submit-button" disabled="{{interactionLocked}}" bindtap="footerAction">{{view.current < view.total ? '下一题' : (canSubmit ? '交卷并查看结果' : '查看未完成题目')}}</button>
  </view>
</task-shell>
