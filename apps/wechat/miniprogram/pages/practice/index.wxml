<view class="practice">
  <view class="statusbar" />
  <!-- 顶部：计时 + 进度 -->
  <view class="p-nav">
    <text class="p-back" bindtap="onBack">‹</text>
    <view class="p-timer">
      <text class="p-timer-text num">{{elapsedText}}</text>
    </view>
    <text class="p-progress num">{{index + 1}}/{{questions.length}}</text>
  </view>

  <view wx:if="{{loading}}" class="p-loading">加载中…</view>

  <block wx:elif="{{questions.length}}">
    <view class="p-progress-bar">
      <view class="p-progress-fill" style="width:{{(index + 1) / questions.length * 100}}%;" />
    </view>

    <scroll-view class="p-body" scroll-y>
      <!-- 当前题 -->
      <view class="q">
        <text class="q-module">{{questions[index].moduleName}}</text>
        <text class="q-stem">{{questions[index].stem}}</text>
        <view class="q-options">
          <view
            wx:for="{{questions[index].options}}"
            wx:for-item="opt"
            wx:key="optionId"
            class="opt {{answers[questions[index].questionId] === opt.optionId ? 'opt-on' : ''}}"
            data-qid="{{questions[index].questionId}}"
            data-oid="{{opt.optionId}}"
            bindtap="onSelect"
          >
            <text class="opt-label">{{opt.label}}</text>
            <text class="opt-text">{{opt.text}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部导航 -->
    <view class="p-foot">
      <button class="btn btn-ghost p-foot-btn" bindtap="onPrev" disabled="{{index === 0}}">上一题</button>
      <button
        wx:if="{{index < questions.length - 1}}"
        class="btn btn-primary p-foot-btn"
        bindtap="onNext"
      >下一题</button>
      <button
        wx:else
        class="btn btn-primary p-foot-btn"
        bindtap="onSubmit"
      >{{submitting ? '提交中…' : '交卷'}}</button>
    </view>
    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示题目（后端未连接）</view>
  </block>
</view>
