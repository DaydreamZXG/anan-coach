.mastery-page {
  padding-bottom: calc(calc(88 * var(--rpx)) + env(safe-area-inset-bottom));
}

.mastery-state-view {
  display: block;
  margin-top: calc(32 * var(--rpx));
}

.mastery-hero {
  padding: calc(12 * var(--rpx)) 0 calc(8 * var(--rpx));
  color: var(--color-ink);
}

.mastery-hero::after {
  display: none;
}

.hero-eyebrow {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: calc(2 * var(--rpx));
}

.hero-title {
  margin-top: calc(16 * var(--rpx));
  font-size: var(--text-hero);
  font-weight: 800;
}

.hero-copy {
  max-width: calc(560 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.7;
}

.hero-updated {
  margin-top: calc(20 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.bucket-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: calc(8 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
  padding: calc(8 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
}

.bucket-tab {
  display: flex;
  min-width: 0;
  min-height: calc(76 * var(--rpx));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-16);
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.bucket-tab--active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 800;
}

.bucket-count {
  margin-top: calc(3 * var(--rpx));
  font-size: var(--text-caption);
  font-weight: 800;
}

.account-gate {
  margin-top: calc(28 * var(--rpx));
}

.mastery-state-action {
  display: block;
  margin-top: calc(20 * var(--rpx));
}

.withdrawn-notice,
.partial-warning {
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-24);
}

.withdrawn-notice {
  border: calc(1 * var(--rpx)) solid rgba(176, 64, 76, 0.16);
  background: var(--color-danger-soft);
}

.notice-title {
  color: var(--color-danger);
  font-size: var(--text-body);
  font-weight: 800;
}

.notice-copy,
.invalidated-copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.partial-warning {
  border: calc(1 * var(--rpx)) solid rgba(185, 141, 47, 0.15);
  background: var(--color-warning-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.warning-action {
  min-height: calc(62 * var(--rpx));
  margin: calc(16 * var(--rpx)) 0 0;
  padding: 0 calc(20 * var(--rpx));
  border: 0;
  border-radius: var(--radius-16);
  background: rgba(185, 141, 47, 0.1);
  color: var(--color-warning);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(62 * var(--rpx));
}

.mastery-card {
  margin-top: calc(20 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.mastery-card--invalidated {
  border-color: rgba(176, 64, 76, 0.16);
  background: var(--color-danger-soft);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.card-title-wrap {
  min-width: 0;
  flex: 1;
}

.card-title {
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.45;
}

.card-stage {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.state-pill {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.state-pill--stable_mastery {
  background: var(--color-primary-soft);
  color: var(--color-success);
}

.state-pill--invalidated {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.evidence-row {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.card-action,
.load-more {
  width: 100%;
  min-height: calc(78 * var(--rpx));
  margin: calc(24 * var(--rpx)) 0 0;
  border: 0;
  border-radius: var(--radius-24);
  background: var(--color-ink);
  color: var(--color-on-primary);
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: calc(78 * var(--rpx));
}

.card-action--secondary,
.load-more {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.pagination {
  margin-top: calc(24 * var(--rpx));
}

.load-more {
  margin-top: 0;
}

.page-note {
  padding: calc(24 * var(--rpx)) 0;
  color: var(--color-faint);
  font-size: var(--text-micro);
  text-align: center;
}
