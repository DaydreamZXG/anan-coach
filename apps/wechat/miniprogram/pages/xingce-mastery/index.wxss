.mastery-page {
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

.mastery-state-view {
  display: block;
  margin-top: 30rpx;
}

.mastery-hero {
  padding: 10rpx 0 8rpx;
  color: var(--color-ink);
}

.mastery-hero::after {
  display: none;
}

.hero-eyebrow {
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 780;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 860;
}

.hero-copy {
  max-width: 560rpx;
  margin-top: 14rpx;
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.hero-updated {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: 19rpx;
}

.bucket-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 26rpx;
  padding: 8rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 22rpx;
  background: var(--color-surface);
}

.bucket-tab {
  display: flex;
  min-width: 0;
  min-height: 76rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.bucket-tab--active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 780;
}

.bucket-count {
  margin-top: 3rpx;
  font-size: 23rpx;
  font-weight: 820;
}

.account-gate {
  margin-top: 26rpx;
}

.mastery-state-action {
  display: block;
  margin-top: 18rpx;
}

.withdrawn-notice,
.partial-warning {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
}

.withdrawn-notice {
  border: 1rpx solid rgba(176, 64, 76, 0.16);
  background: var(--color-danger-soft);
}

.notice-title {
  color: var(--color-danger);
  font-size: 25rpx;
  font-weight: 800;
}

.notice-copy,
.invalidated-copy {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.65;
}

.partial-warning {
  border: 1rpx solid rgba(185, 141, 47, 0.15);
  background: var(--color-warning-soft);
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  line-height: 1.6;
}

.warning-action {
  min-height: 62rpx;
  margin: 14rpx 0 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 16rpx;
  background: rgba(185, 141, 47, 0.1);
  color: var(--color-warning);
  font-size: 21rpx;
  font-weight: 760;
  line-height: 62rpx;
}

.mastery-card {
  margin-top: 18rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 26rpx;
  background: var(--color-surface);
  box-shadow: 0 12rpx 34rpx rgba(190, 120, 60, 0.06);
}

.mastery-card--invalidated {
  border-color: rgba(176, 64, 76, 0.16);
  background: var(--color-danger-soft);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-title-wrap {
  min-width: 0;
  flex: 1;
}

.card-title {
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 820;
  line-height: 1.45;
}

.card-stage {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 21rpx;
}

.state-pill {
  flex: none;
  padding: 8rpx 13rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 19rpx;
  font-weight: 760;
}

.state-pill--stable_mastery {
  background: var(--color-primary-soft);
  color: var(--color-success);
}

.state-pill--invalidated {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.evidence-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 22rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.card-action,
.load-more {
  width: 100%;
  min-height: 78rpx;
  margin: 24rpx 0 0;
  border: 0;
  border-radius: 19rpx;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 78rpx;
}

.card-action--secondary,
.load-more {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.pagination {
  margin-top: 22rpx;
}

.load-more {
  margin-top: 0;
}

.page-note {
  padding: 24rpx 0;
  color: var(--color-faint);
  font-size: 20rpx;
  text-align: center;
}
