.mastery-page {
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

.mastery-state-view {
  display: block;
  margin-top: 32rpx;
}

.mastery-hero {
  padding: 12rpx 0 8rpx;
  color: var(--color-ink);
}

.mastery-hero::after {
  display: none;
}

.hero-eyebrow {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 16rpx;
  font-size: var(--text-hero);
  font-weight: 800;
}

.hero-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.7;
}

.hero-updated {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.bucket-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 8rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
}

.bucket-tab {
  display: flex;
  min-width: 0;
  min-height: 76rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-16);
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.bucket-tab--active {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 800;
}

.bucket-count {
  margin-top: 3rpx;
  font-size: var(--text-caption);
  font-weight: 800;
}

.account-gate {
  margin-top: 28rpx;
}

.mastery-state-action {
  display: block;
  margin-top: 20rpx;
}

.withdrawn-notice,
.partial-warning {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-24);
}

.withdrawn-notice {
  border: 1rpx solid rgba(176, 64, 76, 0.16);
  background: var(--color-danger-soft);
}

.notice-title {
  color: var(--color-danger);
  font-size: var(--text-body);
  font-weight: 800;
}

.notice-copy,
.invalidated-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.partial-warning {
  border: 1rpx solid rgba(185, 141, 47, 0.15);
  background: var(--color-warning-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.warning-action {
  min-height: 62rpx;
  margin: 16rpx 0 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: var(--radius-16);
  background: rgba(185, 141, 47, 0.1);
  color: var(--color-warning);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 62rpx;
}

.mastery-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.mastery-card--invalidated {
  border-color: rgba(176, 64, 76, 0.16);
  background: var(--color-danger-soft);
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title-wrap {
  min-width: 0;
  flex: 1;
}

.card-title {
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.45;
}

.card-stage {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.state-pill {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.state-pill--stable_mastery {
  background: var(--color-primary-soft);
  color: var(--color-success);
}

.state-pill--invalidated {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.evidence-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 24rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.card-action,
.load-more {
  width: 100%;
  min-height: 78rpx;
  margin: 24rpx 0 0;
  border: 0;
  border-radius: var(--radius-24);
  background: var(--color-ink);
  color: var(--color-on-primary);
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: 78rpx;
}

.card-action--secondary,
.load-more {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.pagination {
  margin-top: 24rpx;
}

.load-more {
  margin-top: 0;
}

.page-note {
  padding: 24rpx 0;
  color: var(--color-faint);
  font-size: var(--text-micro);
  text-align: center;
}
