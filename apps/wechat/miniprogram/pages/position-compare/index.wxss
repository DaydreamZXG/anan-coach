.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.pc { display: flex; flex-direction: column; min-height: 100vh; }
.pc-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.pc-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.pc-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.pc-loading { padding: 120rpx 0; text-align: center; }
.pc-body { flex: 1; min-height: 0; }

.pc-item { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 20rpx; }
.pc-item.is-primary { border: 2rpx solid var(--primary); }
.pc-item-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pc-name { flex: 1; font-size: 30rpx; font-weight: 600; color: var(--ink); }
.pc-eligibility {
  font-size: 22rpx; border-radius: 999rpx; padding: 6rpx 18rpx; flex-shrink: 0;
  color: var(--ink-3); background: var(--bg);
}
.pc-eligibility.is-ok { color: var(--good); background: var(--good-soft); }
.pc-eligibility.is-warn { color: #b45309; background: #fef3e2; }
.pc-eligibility.is-bad { color: #b91c1c; background: #fdecec; }

.pc-facts { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.pc-fact { font-size: 28rpx; font-weight: 700; color: var(--primary); }

.pc-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pc-tag {
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 4rpx 18rpx;
}

.pc-note { display: block; padding: 8rpx 8rpx 24rpx; line-height: 1.7; }
.demo-tip { text-align: center; padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx); }
