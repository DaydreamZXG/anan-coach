<view class="s9-page s9-page--with-dock membership-page">
  <view class="s9-hero">
    <view class="s9-title">{{freeColdStart ? '冷启动期间，完整能力免费开放' : '第一次付钱，也可以安心试'}}</view>
    <view class="s9-subtitle">{{freeColdStart ? '所有注册用户直接使用，不需要购买，也不会创建支付订单。' : (offer ? offer.subtitle : '具体服务期、权益和退款规则以付款前展示为准。')}}</view>
    <view wx:if="{{!freeColdStart}}" class="s9-chip-row">
      <view class="s9-chip s9-chip--gold">创始体验官</view>
      <view class="s9-chip s9-chip--primary">{{offer ? offer.remainingLabel : '名额待确认'}}</view>
    </view>
    <view wx:else class="s9-chip-row">
      <view class="s9-chip s9-chip--primary">公开免费</view>
      <view class="s9-chip">阶段性开放</view>
    </view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" custom-class="membership-state-view" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" custom-class="membership-state-view" state="error" title="会员信息没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />

  <block wx:elif="{{freeColdStart}}">
    <view class="s9-stack">
      <view class="s9-card s9-card--primary founder-card">
        <view class="s9-card-kicker">当前开放状态</view>
        <view class="s9-card-title">注册后即可使用岸岸</view>
        <view class="s9-card-copy">岗位、训练、申论批改、拍照搜题、报告与学习档案按正式服务质量开放，不区分会员身份。</view>
        <view class="s9-card-meta">无需付费 · 不创建订单 · 不自动续费</view>
      </view>

      <view class="s9-card guarantee-card">
        <view class="s9-card-kicker">阶段说明</view>
        <view class="s9-card-title">免费是当前产品状态，不是永久承诺</view>
        <view class="s9-card-copy">如果未来启用收费，会在购买入口开放前单独展示商品、价格、服务内容和退款规则；不会把本页视为你同意了任何付费条款。</view>
        <view class="s9-card-meta">{{commercialModeLabel}}</view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">当前边界</view><view class="s9-section-meta">{{entitlementPeriod}}</view></view>
      <view class="s9-list">
        <view class="s9-list-row"><view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">没有会员购买入口</view><view class="s9-list-copy">当前不会创建订单；未来开放时，付款前会单独确认。</view></view></view>
        <view class="s9-list-row"><view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">学习数据不受会员状态影响</view><view class="s9-list-copy">作答、档案、计划、私人资料和导出属于你的学习数据。</view></view></view>
        <view class="s9-list-row"><view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">免费开放不等于允许滥用</view><view class="s9-list-copy">批量爬题、脚本刷模型、恶意文件和账号共享仍会被安全检查拦截。</view></view></view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="s9-stack">
      <view class="s9-card s9-card--primary founder-card">
        <view class="s9-card-kicker">创始体验</view>
        <view class="founder-head">
          <view>
            <view class="s9-card-title">{{offer ? offer.title : '岸岸会员'}}</view>
            <view class="founder-duration type-data">{{offer ? offer.serviceDays + ' 天' : '服务期待确认'}}</view>
          </view>
          <view wx:if="{{offer}}" class="founder-price type-data">{{offer.amountLabel}}</view>
        </view>
        <view class="s9-card-copy">买到的就是下面列的，没做好的功能不会写进来卖。</view>
        <view class="s9-card-meta">{{offer ? offer.remainingLabel : entitlementPeriod}} · 单次购买 · 不自动续费</view>
        <view class="payment-disclosure">{{paymentDisclosure}}</view>
      </view>

      <view class="s9-card guarantee-card">
        <view class="s9-card-kicker">保障规则</view>
        <view class="s9-card-title">{{refundPolicyTitle}}</view>
        <view class="s9-card-copy">{{refundPolicyLabel || '当前没有可固化的退款政策，不开放购买。'}}</view>
        <view class="s9-card-meta">规则会在付款前完整展示，并随订单保存</view>
      </view>
    </view>

    <view wx:if="{{offer}}" class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">你会得到什么</view><view class="s9-section-meta">当前权益：{{entitlementLabel}}</view></view>
      <view class="s9-list">
        <view class="s9-list-row" wx:for="{{offer.featureHighlights}}" wx:key="*this">
          <view class="feature-check">✓</view><view class="s9-list-main"><view class="s9-list-title">{{item}}</view></view>
        </view>
      </view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">购买与退款规则</view><view class="s9-section-meta">以付款时确认为准</view></view>
      <view class="s9-list">
        <view class="s9-list-row policy-row" wx:for="{{policies}}" wx:key="policyVersion">
          <view class="s9-list-main"><view class="s9-list-title">{{item.title}}</view><view class="s9-list-copy">{{item.contentLabel}}</view></view>
          <view class="policy-version">付款前确认</view>
        </view>
      </view>
      <view hover-class="item--hover" wx:if="{{paymentEnabled}}" class="accept-row" bindtap="toggleAccepted"><view class="checkbox {{accepted ? 'checked' : ''}}">{{accepted ? '✓' : ''}}</view><view>我已阅读并接受当前规则</view></view>
    </view>

    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">学习过程奖励</view><view class="s9-section-meta">不读取成绩字段</view></view>
      <view class="reward-grid">
        <view class="reward-card"><view class="reward-value type-data">{{effectiveDays}}/{{effectiveDaysRequired || '—'}}</view><view class="reward-title">有效学习日</view><view class="reward-copy">达成后按购买时确认的规则发放</view></view>
        <view class="reward-card"><view class="reward-value type-data">{{weeklyReflections}}/{{weeklyReflectionsRequired || '—'}}</view><view class="reward-title">周复盘</view><view class="reward-copy">达成后按购买时确认的规则发放</view></view>
        <view class="reward-card"><view class="reward-value type-data">{{coreRatioLabel}}</view><view class="reward-title">核心任务</view><view class="reward-copy">按购买时确认的条件解锁奖励</view></view>
      </view>
    </view>

    <view wx:if="{{dashboard.refundEligibility}}" class="s9-section">
      <view class="s9-card {{dashboard.refundEligibility.eligible ? 's9-card--primary' : ''}}">
        <view class="s9-card-kicker">退款状态</view>
        <view class="s9-card-title">当前订单退款资格</view>
        <view class="s9-card-copy">按订单当时的规则计算；已返过程奖励会计入累计退回金额。</view>
        <button hover-class="item--hover" wx:if="{{dashboard.refundEligibility.eligible}}" class="refund-button" loading="{{refunding}}" bindtap="requestRefund">申请原路退款</button>
        <view wx:else class="s9-card-meta">当前不可申请：{{refundBlockingLabel}}</view>
      </view>
    </view>
    <view wx:if="{{errorMessage}}" class="s9-inline-error">{{errorMessage}}</view>

    <view wx:if="{{offer && paymentEnabled}}" class="s9-action-dock">
      <button hover-class="item--hover" class="s9-primary-button {{!accepted || offer.recruitmentState === 'paused' || offer.recruitmentState === 'sold_out' ? 's9-primary-button--disabled' : ''}}" loading="{{paying}}" disabled="{{!accepted || offer.recruitmentState === 'paused' || offer.recruitmentState === 'sold_out'}}" bindtap="buy">{{accepted ? '安全支付 ' + offer.amountLabel : '阅读并确认规则后购买'}}</button>
    </view>
  </block>
</view>
