.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.mb-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.mb-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.mb-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.mb-loading { padding: 120rpx 0; text-align: center; }

.mb-tier { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 8rpx; }
.mb-tier.is-pro { border-left: 6rpx solid var(--warm); }
.mb-tier-label { font-size: 40rpx; font-weight: 700; color: var(--ink); }

.mb-section { display: block; font-size: 26rpx; font-weight: 600; color: var(--ink-3); padding: 28rpx 8rpx 16rpx; }

.mb-quota { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 16rpx; }
.mb-quota-title { font-size: 29rpx; color: var(--ink); }
.mb-quota-line { font-size: 27rpx; color: var(--ink-2); }
.mb-quota-line.is-unlimited { color: var(--good); }

.mb-anan {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 24rpx 0;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mb-anan-text { flex: 1; font-size: 28rpx; line-height: 1.7; color: #5c4a35; }

.mb-upgrade { width: 100%; }
.demo-tip { text-align: center; padding: 16rpx 0; }
