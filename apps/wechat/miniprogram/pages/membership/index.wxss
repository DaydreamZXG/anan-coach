.membership-state-view {
  display: block;
  margin-top: 28rpx;
}
.founder-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.founder-duration {
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: var(--text-title-lg);
  font-weight: 800;
}
.founder-price {
  color: var(--color-muted);
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.feature-check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-weight: 800;
}
.policy-row {
  align-items: flex-start;
}
.policy-version {
  flex: 0 0 120rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: var(--text-micro);
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.accept-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 4rpx 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
}
.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid var(--color-line-strong);
  border-radius: var(--radius-12);
  color: var(--color-surface);
}
.checkbox.checked {
  border-color: var(--color-primary);
  background: var(--color-primary);
}
.reward-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.reward-card {
  min-width: 0;
  padding: 28rpx 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
}
.reward-value {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 800;
}
.reward-title {
  margin-top: 12rpx;
  font-size: var(--text-micro);
  font-weight: 800;
}
.reward-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.45;
}
.refund-button {
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  color: var(--color-primary-deep);
  font-size: var(--text-caption);
  font-weight: 800;
  text-align: left;
}
.payment-disclosure {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-16);
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.5;
}
