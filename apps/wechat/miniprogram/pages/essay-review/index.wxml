<view class="workbench-page">
  <view class="workbench-hero"><view class="workbench-kicker">申论 AI 评阅</view><view class="workbench-title">每一处建议，都要能指回原文和评分点</view><view class="workbench-copy">先给证据，再给判断；不把模糊风格偏好当成扣分理由。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="评阅没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="{{retryAllowed ? '重新加载' : ''}}" bind:action="retryLoad" />
  <block wx:elif="{{review && view}}">
    <view class="workbench-card"><view class="workbench-pill">{{view.confidenceLabel}}</view><view class="score-range">{{view.scoreLabel}}</view><view class="workbench-note">建议观察值 {{view.recommendedScore}}，不作为承诺分数。</view><view wx:for="{{view.confidenceReasons}}" wx:key="*this" class="workbench-meta">· {{item}}</view></view>
    <view wx:for="{{view.dimensions}}" wx:key="criterionCode" class="workbench-card"><view class="workbench-row-title">{{item.label}} <text class="workbench-meta">{{item.rangeLabel}}</text></view><view class="dimension-bar"><view class="dimension-bar-fill" style="width: {{item.percent}}%"></view></view><view class="workbench-note">{{item.rationale}}</view></view>
    <view wx:for="{{view.findings}}" wx:key="findingId" class="workbench-card"><view class="workbench-pill">问题 {{item.order}} · {{item.severity}}</view><view class="workbench-row-title">{{item.diagnosis}}</view><view class="workbench-note">下一步：{{item.action}}</view><view class="evidence-quote">你的原句：{{item.answerQuote}}</view><view class="evidence-quote">材料原句：{{item.materialQuote}}</view></view>
  </block>
</view>
