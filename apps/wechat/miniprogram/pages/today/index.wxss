.today-page {
  padding-bottom: 172rpx;
}

.today-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.today-kicker {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.today-heading {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 58rpx;
  font-weight: 850;
  line-height: 1.12;
}

.today-intro {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  line-height: 1.62;
}

.today-capture {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 68rpx;
  margin: 2rpx 0 0;
  padding: 0 24rpx;
  border: 1rpx solid rgba(0, 151, 139, 0.22);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--color-primary-deep);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 68rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 57, 52, 0.08);
}

.today-capture__icon {
  font-size: 32rpx;
  line-height: 1;
}

.top-space {
  margin-top: 28rpx;
}

.focus-dashboard {
  padding: 32rpx;
  border: 1rpx solid rgba(0, 151, 139, 0.18);
  border-radius: var(--radius-card);
  background: linear-gradient(145deg, #f8fffd 0%, var(--color-primary-soft) 100%);
  box-shadow: var(--shadow-card);
}

.dashboard-hero-strip {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.dashboard-hero-main {
  flex: 1;
  min-width: 0;
}
.goal-label {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}
.goal-name {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
}
.goal-evidence {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}
.dashboard-hero-side {
  flex: none;
}

.gap-brief-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.gap-brief-item {
  display: flex;
  flex-direction: column;
}
.score-label {
  color: var(--color-muted);
  font-size: 22rpx;
}
.score-value {
  margin-top: 6rpx;
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}
.score-unit {
  font-size: 22rpx;
  font-weight: 500;
}
.gap-arrow {
  color: var(--color-faint);
  font-size: 28rpx;
}
.gap-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 23rpx;
  font-weight: 750;
}

.gap-unavailable {
  margin: 24rpx 0;
  padding: 22rpx;
  border-radius: 18rpx;
  background: var(--color-surface-soft);
}
.gap-unavailable-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 750;
}
.gap-unavailable-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.coach-insight-box {
  margin: 24rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--color-surface-soft);
}
.coach-insight-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.coach-mark {
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 750;
}
.coach-headline {
  margin-top: 14rpx;
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}
.coach-copy {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.capacity-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 8rpx;
}
.capacity-bar-info {
  flex: 1;
  min-width: 0;
}
.capacity-bar-title {
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 780;
}
.capacity-bar-meta {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}
.capacity-edit-button {
  flex: none;
  min-height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--color-primary-soft);
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 56rpx;
}
.capacity-editor {
  margin: 28rpx -28rpx -28rpx;
  padding: 8rpx 28rpx 30rpx;
  border-top: 1rpx solid var(--color-line);
  background: rgba(247, 248, 253, 0.72);
}
.capacity-field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.capacity-field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}
.capacity-field-copy {
  flex: 1;
  min-width: 0;
}
.capacity-field-label {
  color: var(--color-ink);
  font-size: 25rpx;
  font-weight: 750;
}
.capacity-field-help {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.45;
}
.capacity-current {
  flex: none;
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 700;
}
.capacity-minute-input {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}
.capacity-minute-input__control {
  box-sizing: border-box;
  width: 128rpx;
  height: 68rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(0, 151, 139, 0.3);
  border-radius: 16rpx;
  background: #ffffff;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 800;
  text-align: right;
}
.capacity-scale {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}
.capacity-scale-option {
  min-width: 0;
  min-height: 62rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  background: #ffffff;
  color: var(--color-muted);
  font-family: var(--font-family-data);
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 750;
  line-height: 62rpx;
}
.capacity-scale-option--active {
  border-color: rgba(0, 151, 139, 0.42);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  box-shadow: 0 8rpx 18rpx rgba(0, 151, 139, 0.1);
}
.capacity-scale-option--disabled {
  opacity: 0.58;
}
.capacity-recovery-hint {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--color-success-soft), var(--color-primary-soft));
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.55;
}
.capacity-recovery-title {
  margin-bottom: 8rpx;
  color: var(--color-ink-secondary);
  font-weight: 750;
}
.capacity-write-notice,
.capacity-feedback {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  line-height: 1.5;
}
.capacity-write-notice {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}
.capacity-write-notice--disabled {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.capacity-feedback--submitting {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}
.capacity-feedback--success {
  background: var(--color-success-soft);
  color: var(--color-success);
}
.capacity-feedback--error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
.capacity-feedback--conflict {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.capacity-submit {
  width: 100%;
  margin-top: 22rpx;
}
.capacity-submit--disabled {
  box-shadow: none;
  opacity: 0.48;
}
.recovery-note {
  margin-bottom: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--color-success-soft);
  color: var(--color-success);
}
.plan-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}
.plan-tool {
  display: flex;
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--color-line);
  border-radius: 18rpx;
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.plan-tool__arrow {
  color: var(--color-primary);
  font-family: var(--font-family-data);
  font-size: 18rpx;
}
.track-budget {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.plan-mode-pill,
.track-budget-item {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}
.plan-mode-pill {
  background: var(--color-surface-soft);
  color: var(--color-muted);
}
.track-budget-item {
  background: rgba(52, 61, 102, 0.08);
  color: var(--color-ink-secondary);
}
.track-budget-item--xingce {
  background: rgba(58, 91, 190, 0.1);
  color: var(--color-primary);
}
.track-budget-item--essay {
  background: rgba(118, 74, 170, 0.1);
  color: #7041a0;
}
.track-budget-item--recovery {
  background: var(--color-success-soft);
  color: var(--color-success);
}
.track-budget-item--mock {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.section-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.mastery-link {
  margin: 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}
.plan-explanation {
  margin-top: -18rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.55;
}
.allocation-reason,
.omitted-reason {
  display: grid;
  grid-template-columns: 96rpx 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-line);
}
.allocation-track,
.omitted-reason__label {
  color: var(--color-ink-secondary);
  font-weight: 700;
}
.omitted-reason {
  color: var(--color-warning);
}

.task {
  display: flex;
  gap: 22rpx;
}
.task-order {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: var(--color-ink);
  color: #ffffff;
  font-family: var(--font-family-data);
  font-variant-numeric: tabular-nums;
  font-weight: 800;
}
.task-body {
  flex: 1;
  min-width: 0;
}
.task-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.track-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 750;
}
.track-pill--xingce {
  background: rgba(58, 91, 190, 0.12);
  color: var(--color-primary);
}
.track-pill--essay {
  background: rgba(118, 74, 170, 0.12);
  color: #7041a0;
}
.track-pill--recovery {
  background: var(--color-success-soft);
  color: var(--color-success);
}
.track-pill--mock {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.pill--quiet {
  background: var(--color-surface-soft);
  color: var(--color-muted);
}
.task-status--ready {
  background: var(--color-surface-soft);
  color: var(--color-muted);
}
.task-status--in_progress {
  background: rgba(58, 91, 190, 0.12);
  color: var(--color-primary);
}
.task-status--complete {
  background: var(--color-success-soft);
  color: var(--color-success);
}
.task-status--abandoned {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}
.task-time {
  color: var(--color-muted);
  font-size: 22rpx;
}
.task-progress {
  margin-top: 14rpx;
  color: var(--color-primary);
  font-size: 22rpx;
}
.task-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 750;
}
.task-reason {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
.task-rule {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-line);
  color: var(--color-primary);
  font-size: 22rpx;
}
.task-basis {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--color-surface-soft);
}
.task-basis-title {
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 750;
}
.task-priority {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 14rpx;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1.55;
}
.task-priority-item {
  display: flex;
  gap: 6rpx;
}
.task-evidence {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.5;
}
.task-evidence-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin-top: 11rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
}
.task--disabled {
  border-style: dashed;
}
.task-disabled-reason {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
  font-size: 20rpx;
  line-height: 1.5;
}
.task-empty {
  color: var(--color-ink-secondary);
  line-height: 1.55;
}
.task-empty__note {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}
.setup-link {
  margin: 36rpx 0 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
}
