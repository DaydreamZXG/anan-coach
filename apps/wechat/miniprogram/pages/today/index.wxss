.today-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.today-content {
  display: flex;
  box-sizing: border-box;
  min-height: calc(100vh - 64px);
  flex-direction: column;
  gap: 40rpx;
  padding: 0 var(--figma-page-inset)
    calc(
      var(--figma-bottom-navigation-height) + var(--figma-space-32) +
        env(safe-area-inset-bottom)
    );
}

.today-header,
.opening-line,
.opening-actions,
.coffee-prompt,
.opening-collapsed,
.opening-collapsed__main,
.task-heading__meta,
.anan-insight,
.task-meta,
.primary-task__head,
.primary-button,
.compact-task,
.compact-task__main,
.completed-task,
.settlement-button,
.tool-row,
.tool-link {
  display: flex;
  align-items: center;
}

.today-header {
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.today-header__copy {
  min-width: 0;
  flex: 1;
}

.today-date {
  margin-bottom: 1rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 500;
}

.today-greeting {
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.4;
}

.today-countdown {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-button {
  display: flex !important;
  width: 80rpx !important;
  min-width: 80rpx !important;
  max-width: 80rpx !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  max-height: 80rpx !important;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  border-radius: 50% !important;
  background: var(--color-surface) !important;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04) !important;
}

.icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.icon--camera { width: 36rpx; height: 36rpx; }
.icon--small { width: 28rpx; height: 28rpx; }
.icon--sparkles { width: 32rpx; height: 32rpx; }
.icon--chevron { width: 24rpx; height: 24rpx; transition: transform 0.2s ease; }
.icon--rotated { transform: rotate(180deg); }
.icon--play { width: 32rpx; height: 32rpx; }
.icon--completed { width: 36rpx; height: 36rpx; }
.icon--settlement { width: 32rpx; height: 32rpx; }

.opening-card {
  flex: none;
  padding: 32rpx;
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.opening-line {
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.opening-line__text {
  min-width: 0;
  flex: 1;
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.45;
}

.weather-location-button {
  width: auto;
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
}

.opening-actions {
  justify-content: space-between;
  gap: 16rpx;
}

.coffee-prompt {
  min-width: 0;
  flex: 1;
  gap: 12rpx;
}

.coffee-prompt__text {
  color: var(--ink-2);
  font-size: 24rpx;
  white-space: nowrap;
}

.coffee-button {
  width: auto;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}

.coffee-button--quiet {
  background: transparent;
  color: var(--ink-3);
}

.opening-start {
  width: auto;
  min-width: 144rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.opening-error {
  margin-top: 12rpx;
  color: var(--danger);
  font-size: 22rpx;
}

.opening-failure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-danger-soft);
  border-radius: var(--figma-radius-control);
  background: var(--color-danger-soft);
}

.opening-failure__copy {
  min-width: 0;
  flex: 1;
  color: var(--ink-2);
  font-size: var(--figma-font-caption);
  line-height: 1.5;
}

.opening-failure__retry {
  width: auto;
  min-height: 52rpx;
  flex: none;
  padding: 0 22rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--figma-font-caption);
  font-weight: 700;
  line-height: 52rpx;
}

.opening-collapsed {
  justify-content: space-between;
  padding: 24rpx 40rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.opening-collapsed__main {
  gap: 16rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.opening-collapsed__weather {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 500;
}

.capacity-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 24rpx;
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.capacity-notice--error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.capacity-notice__copy {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.55;
}

.capacity-notice__action {
  width: auto;
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.task-heading {
  flex: none;
  margin-top: 8rpx;
}

.task-heading__title {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.task-heading__meta {
  gap: 16rpx;
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
}

.adjust-button {
  width: auto;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
}

.primary-task {
  position: relative;
  flex: none;
  overflow: hidden;
  padding: 48rpx;
  border: 1rpx solid rgba(238, 242, 255, 0.5);
  border-radius: 64rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.06);
}

.task-aurora {
  position: absolute;
  background: linear-gradient(135deg, var(--primary), var(--color-ai-violet) 52%, var(--color-ai-pink));
  opacity: 0.02;
  inset: 0;
}

.anan-insight {
  position: relative;
  z-index: 1;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 40rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid rgba(243, 244, 246, 0.6);
}

.anan-icon {
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--primary), var(--color-ai-violet) 52%, var(--color-ai-pink));
  box-shadow: 0 2rpx 6rpx rgba(173, 70, 255, 0.2);
}

.anan-insight__main {
  min-width: 0;
  flex: 1;
}

.anan-insight__title {
  margin-bottom: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.anan-insight__copy {
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  line-height: 1.625;
}

.anan-insight__detail {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.625;
}

.insight-toggle {
  display: flex;
  width: auto;
  align-items: center;
  gap: 2rpx;
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
}

.primary-task__body {
  position: relative;
  z-index: 1;
}

.primary-task__head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.task-meta {
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.task-tag {
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--primary-soft);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.task-duration {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 500;
}

.primary-task__title {
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
}

.basis-button {
  display: flex;
  width: auto;
  align-items: center;
  gap: 2rpx;
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.primary-button {
  width: 100%;
  min-height: 88rpx;
  justify-content: center;
  gap: 12rpx;
  border-radius: 40rpx;
  background: var(--ink);
  color: var(--color-surface);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.primary-button--disabled { opacity: 0.45; }

.task-disabled {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  text-align: center;
}

.other-tasks {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: 24rpx;
}

.compact-task {
  justify-content: space-between;
  gap: 16rpx;
  padding: 32rpx 40rpx;
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.compact-task__main {
  min-width: 0;
  gap: 24rpx;
}

.compact-task__icon {
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-surface-soft);
}

.compact-task__title {
  margin-bottom: 2rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.compact-task__meta {
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
}

.compact-task__action {
  width: auto;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.completed-task {
  gap: 24rpx;
  padding: 16rpx 40rpx;
  opacity: 0.5;
}

.completed-task__title {
  min-width: 0;
  flex: 1;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 700;
  text-decoration: line-through;
  text-decoration-color: var(--color-line-strong);
}

.completed-task__action {
  width: auto;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
}

.secondary-tools {
  flex: none;
  margin: 24rpx 0 16rpx;
}

.settlement-button {
  width: 100%;
  min-height: 88rpx;
  justify-content: center;
  gap: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 700;
}

.tool-row {
  justify-content: center;
  gap: 48rpx;
  margin-top: 32rpx;
}

.tool-link {
  width: auto;
  gap: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
  opacity: 0.7;
}

.task-error,
.empty-card {
  padding: 32rpx;
  border-radius: 32rpx;
  background: var(--color-surface);
}

.task-error {
  color: var(--danger);
  font-size: 24rpx;
}

.empty-card__title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-card__copy {
  margin: 12rpx 0 28rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.625;
}

@media (min-width: 768px) {
  .today-content {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }
}
