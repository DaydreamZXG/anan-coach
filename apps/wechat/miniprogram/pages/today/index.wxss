.today-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.today-content {
  display: flex;
  box-sizing: border-box;
  min-height: calc(100vh - 64px);
  flex-direction: column;
  gap: calc(40 * var(--rpx));
  padding: 0 var(--figma-page-inset)
    calc(
      var(--figma-bottom-navigation-height) + var(--figma-space-32) + env(safe-area-inset-bottom)
    );
}

.today-header,
.opening-line,
.opening-actions,
.coffee-prompt,
.opening-collapsed,
.opening-collapsed__main,
.task-heading__meta,
.anan-insight,
.task-meta,
.primary-task__head,
.primary-button,
.compact-task,
.compact-task__main,
.completed-task,
.settlement-button,
.tool-row,
.tool-link {
  display: flex;
  align-items: center;
}

.today-header {
  align-items: flex-end;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
}

.today-header__copy {
  min-width: 0;
  flex: 1;
}

.today-date {
  margin-bottom: calc(1 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
}

.today-greeting {
  color: var(--ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1 * var(--rpx));
  line-height: 1.4;
}

.today-countdown {
  margin-top: calc(4 * var(--rpx));
  overflow: hidden;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-button {
  display: flex !important;
  width: calc(80 * var(--rpx)) !important;
  min-width: calc(80 * var(--rpx)) !important;
  max-width: calc(80 * var(--rpx)) !important;
  height: calc(80 * var(--rpx)) !important;
  min-height: calc(80 * var(--rpx)) !important;
  max-height: calc(80 * var(--rpx)) !important;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  margin-bottom: calc(4 * var(--rpx));
  border-radius: 50% !important;
  background: var(--color-surface) !important;
  box-shadow: var(--shadow-card) !important;
}

.icon {
  display: block;
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
  flex: none;
}

.icon--camera {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}
.icon--small {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
}
.icon--sparkles {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}
.icon--chevron {
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
  transition: transform 0.2s ease;
}
.icon--rotated {
  transform: rotate(180deg);
}
.icon--play {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}
.icon--completed {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}
.icon--settlement {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}

.opening-card {
  flex: none;
  padding: calc(32 * var(--rpx));
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.opening-line {
  gap: calc(16 * var(--rpx));
  margin-bottom: calc(16 * var(--rpx));
}

.opening-line__text {
  min-width: 0;
  flex: 1;
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.45;
}

.weather-location-button {
  width: auto;
  flex: none;
  padding: calc(8 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.opening-actions {
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
}

.coffee-prompt {
  min-width: 0;
  flex: 1;
  gap: calc(12 * var(--rpx));
}

.coffee-prompt__text {
  color: var(--ink-2);
  font-size: var(--text-caption);
  white-space: nowrap;
}

.coffee-button {
  width: auto;
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 500;
  white-space: nowrap;
}

.coffee-button--quiet {
  background: transparent;
  color: var(--ink-3);
}

.opening-start {
  width: auto;
  min-width: calc(144 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(32 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-body);
  font-weight: 700;
  white-space: nowrap;
}

.opening-error {
  margin-top: calc(12 * var(--rpx));
  color: var(--danger);
  font-size: var(--text-micro);
}

.opening-failure {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-danger-soft);
  border-radius: var(--figma-radius-control);
  background: var(--color-danger-soft);
}

.opening-failure__copy {
  min-width: 0;
  flex: 1;
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.opening-failure__retry {
  width: auto;
  min-height: calc(52 * var(--rpx));
  flex: none;
  padding: 0 calc(24 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface);
  color: var(--danger);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(52 * var(--rpx));
}

.opening-collapsed {
  justify-content: space-between;
  padding: calc(24 * var(--rpx)) calc(40 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.opening-collapsed__main {
  gap: calc(16 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.opening-collapsed__weather {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 500;
}

.capacity-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.capacity-notice--error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.capacity-notice__copy {
  min-width: 0;
  flex: 1;
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.55;
}

.capacity-notice__action {
  width: auto;
  flex: none;
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.task-heading {
  flex: none;
  margin-top: calc(8 * var(--rpx));
}

.task-heading__title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.5 * var(--rpx));
}

.task-heading__meta {
  gap: calc(16 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
}

.adjust-button {
  width: auto;
  padding: calc(8 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.primary-task {
  position: relative;
  flex: none;
  overflow: hidden;
  padding: calc(48 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(238, 242, 255, 0.5);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.task-aurora {
  position: absolute;
  background: linear-gradient(
    135deg,
    var(--primary),
    var(--color-ai-violet) 52%,
    var(--color-ai-pink)
  );
  opacity: 0.02;
  inset: 0;
}

.anan-insight {
  position: relative;
  z-index: 1;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
  margin-bottom: calc(40 * var(--rpx));
  padding-bottom: calc(40 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid rgba(243, 244, 246, 0.6);
}

.anan-icon {
  display: flex;
  width: calc(64 * var(--rpx));
  min-width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-24);
  background: linear-gradient(
    135deg,
    var(--primary),
    var(--color-ai-violet) 52%,
    var(--color-ai-pink)
  );
  box-shadow: var(--shadow-ai);
}

.anan-insight__main {
  min-width: 0;
  flex: 1;
}

.anan-insight__title {
  margin-bottom: calc(4 * var(--rpx));
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.anan-insight__copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.625;
}

.anan-insight__detail {
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.625;
}

.insight-toggle {
  display: flex;
  width: auto;
  align-items: center;
  gap: calc(2 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.primary-task__body {
  position: relative;
  z-index: 1;
}

.primary-task__head {
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
  margin-bottom: calc(32 * var(--rpx));
}

.task-meta {
  gap: calc(16 * var(--rpx));
  margin-bottom: calc(12 * var(--rpx));
}

.task-tag {
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.task-duration {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 500;
}

.primary-task__title {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.basis-button {
  display: flex;
  width: auto;
  align-items: center;
  gap: calc(2 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
  white-space: nowrap;
}

.primary-button {
  width: 100%;
  min-height: calc(88 * var(--rpx));
  justify-content: center;
  gap: calc(12 * var(--rpx));
  border-radius: var(--radius-40);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-section);
  font-weight: 600;
  box-shadow: var(--shadow-elevated);
}

.primary-button--disabled {
  opacity: 0.45;
}

.task-disabled {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.other-tasks {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
}

.compact-task {
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx));
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.compact-task__main {
  min-width: 0;
  gap: calc(24 * var(--rpx));
}

.compact-task__icon {
  display: flex;
  width: calc(64 * var(--rpx));
  min-width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-surface-soft);
}

.compact-task__title {
  margin-bottom: calc(2 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.compact-task__meta {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.compact-task__action {
  width: auto;
  padding: calc(12 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--bg);
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 600;
}

.completed-task {
  gap: calc(24 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(40 * var(--rpx));
  opacity: 0.5;
}

.completed-task__title {
  min-width: 0;
  flex: 1;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-decoration: line-through;
  text-decoration-color: var(--color-line-strong);
}

.completed-task__action {
  width: auto;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.secondary-tools {
  flex: none;
  margin: calc(24 * var(--rpx)) 0 calc(16 * var(--rpx));
}

.settlement-button {
  width: 100%;
  min-height: calc(88 * var(--rpx));
  justify-content: center;
  gap: calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.tool-row {
  justify-content: center;
  gap: calc(48 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.tool-link {
  width: auto;
  gap: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  opacity: 0.7;
}

.task-error,
.empty-card {
  padding: calc(32 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--color-surface);
}

.task-error {
  color: var(--danger);
  font-size: var(--text-caption);
}

.empty-card__title {
  font-size: var(--text-section);
  font-weight: 700;
}

.empty-card__copy {
  margin: calc(12 * var(--rpx)) 0 calc(28 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  line-height: 1.625;
}

/* 平板：768 起加左导航轨（单列限宽）；1024 起任务|辅助两列（粉笔式）。 */
@media (min-width: 768px) {
  .today-content {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }
}

@media (min-width: 1024px) {
  .today-content {
    display: grid;
    max-width: 1100px;
    align-items: start;
    column-gap: 24px;
    grid-template-columns: minmax(0, 1fr) 340px;
    grid-template-areas:
      "header header"
      "main side-a"
      "main side-b"
      "main .";
    grid-template-rows: auto auto auto 1fr;
  }

  .today-header {
    grid-area: header;
  }

  .today-col--main {
    grid-area: main;
    min-width: 0;
  }

  .today-col--side-a {
    grid-area: side-a;
    min-width: 0;
  }

  .today-col--side-b {
    grid-area: side-b;
    min-width: 0;
  }
}
