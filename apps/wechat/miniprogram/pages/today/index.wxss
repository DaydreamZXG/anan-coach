.today-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.today-content {
  display: flex;
  box-sizing: border-box;
  min-height: calc(100vh - 64px);
  flex-direction: column;
  gap: calc(40 * var(--rpx));
  padding: 0 var(--figma-page-inset)
    calc(
      var(--figma-bottom-navigation-height) + var(--figma-space-32) + env(safe-area-inset-bottom)
    );
}

.today-header,
.today-greeting-row,
.header-weather,
.task-heading__meta,
.task-heading__actions,
.anan-insight,
.task-meta,
.primary-task__head,
.primary-button,
.compact-task,
.compact-task__main,
.completed-task,
.settlement-button,
.tool-row,
.tool-link {
  display: flex;
  align-items: center;
}

.mock-entry {
  display: flex;
  min-height: calc(132 * var(--rpx));
  align-items: center;
  gap: calc(20 * var(--rpx));
  padding: calc(22 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(15, 30, 55, 0.08);
  border-radius: var(--radius-32);
  background: linear-gradient(112deg, var(--bg) 0%, var(--color-surface-soft) 100%);
  color: var(--ink);
  text-align: left;
}

.mock-entry__icon {
  display: flex;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: calc(20 * var(--rpx));
  background: var(--ink);
}

.mock-entry__icon .icon {
  filter: brightness(0) invert(1);
}

.mock-entry__body {
  min-width: 0;
  flex: 1;
}

.mock-entry__eyebrow {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.mock-entry__title {
  margin-top: calc(2 * var(--rpx));
  font-size: var(--text-body);
  font-weight: 800;
}

.mock-entry__meta,
.mock-entry__action {
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}

.mock-entry__action {
  flex: none;
  color: var(--primary);
}

.settlement-button--quiet {
  border-color: var(--line);
  background: var(--color-surface);
  box-shadow: none;
  color: var(--ink);
}

.settlement-button--quiet .icon--settlement {
  filter: none;
}

.today-header {
  align-items: flex-end;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
}

.today-header__copy {
  min-width: 0;
  flex: 1;
}

.today-date {
  margin-bottom: calc(1 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
}

.today-greeting-row {
  min-width: 0;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
}

.today-greeting {
  color: var(--ink);
  font-size: var(--text-hero);
  font-weight: 700;
  letter-spacing: calc(-1 * var(--rpx));
  line-height: 1.4;
}

.header-weather {
  width: auto;
  min-height: calc(46 * var(--rpx));
  flex: none;
  gap: calc(8 * var(--rpx));
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(15, 30, 55, 0.06);
  border-radius: var(--radius-capsule);
  background: rgba(255, 255, 255, 0.64);
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 1;
}

.header-weather--action {
  color: var(--ink-2);
}

.header-weather__icon {
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
  flex: none;
}

.today-countdown {
  margin-top: calc(4 * var(--rpx));
  overflow: hidden;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.capture-button {
  display: flex !important;
  width: calc(80 * var(--rpx)) !important;
  min-width: calc(80 * var(--rpx)) !important;
  max-width: calc(80 * var(--rpx)) !important;
  height: calc(80 * var(--rpx)) !important;
  min-height: calc(80 * var(--rpx)) !important;
  max-height: calc(80 * var(--rpx)) !important;
  padding: 0 !important;
  align-items: center;
  justify-content: center;
  margin-bottom: calc(4 * var(--rpx));
  border-radius: 50% !important;
  background: var(--color-surface) !important;
  box-shadow: var(--shadow-card) !important;
}

.icon {
  display: block;
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
  flex: none;
}

.icon--camera {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}
.icon--small {
  width: calc(28 * var(--rpx));
  height: calc(28 * var(--rpx));
}
.icon--sparkles {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}
.icon--chevron {
  width: calc(24 * var(--rpx));
  height: calc(24 * var(--rpx));
  transition: transform 0.2s ease;
}
.icon--rotated {
  transform: rotate(180deg);
}
.icon--play {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}
.icon--completed {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}
.icon--settlement {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}

.recognition-accelerator {
  display: flex;
  align-items: center;
}

.capacity-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.capacity-notice--error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.capacity-notice__copy {
  min-width: 0;
  flex: 1;
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.55;
}

.capacity-notice__action {
  width: auto;
  flex: none;
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-surface);
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.task-heading {
  flex: none;
  margin-top: calc(8 * var(--rpx));
}

.task-heading__title {
  color: var(--ink);
  font-size: var(--text-title);
  font-weight: 700;
  letter-spacing: calc(-0.5 * var(--rpx));
}

.task-heading__meta {
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
}

.task-heading__actions {
  flex: none;
  gap: calc(10 * var(--rpx));
}

.adjust-button {
  width: auto;
  padding: calc(8 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.primary-task {
  position: relative;
  flex: none;
  overflow: hidden;
  padding: calc(48 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(238, 242, 255, 0.5);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.task-aurora {
  position: absolute;
  background: linear-gradient(
    135deg,
    var(--primary),
    var(--color-ai-violet) 52%,
    var(--color-ai-pink)
  );
  opacity: 0.02;
  inset: 0;
}

.anan-insight {
  position: relative;
  z-index: 1;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
  padding-top: calc(40 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid rgba(243, 244, 246, 0.72);
}

.primary-task--feedback-only {
  margin-top: var(--figma-space-16);
}

.anan-insight--feedback-only {
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-bottom: 0;
  border-top: 0;
  border-bottom: 0;
}

.coach-return-feedback--standalone {
  margin-top: calc(12 * var(--rpx));
}

.anan-icon {
  display: flex;
  width: calc(64 * var(--rpx));
  min-width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-24);
  background: linear-gradient(
    135deg,
    var(--primary),
    var(--color-ai-violet) 52%,
    var(--color-ai-pink)
  );
  box-shadow: var(--shadow-ai);
}

.anan-insight__main {
  min-width: 0;
  flex: 1;
}

.anan-insight__heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: calc(12 * var(--rpx));
  margin-bottom: calc(4 * var(--rpx));
}

.anan-insight__title {
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.anan-insight__status {
  padding: calc(4 * var(--rpx)) calc(14 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: rgba(112, 68, 255, 0.08);
  color: var(--primary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.anan-insight__phase {
  margin-bottom: calc(20 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.coach-statement {
  padding: calc(18 * var(--rpx)) 0;
  border-top: calc(1 * var(--rpx)) solid rgba(15, 30, 55, 0.06);
}

.coach-statement--judgment {
  padding-bottom: calc(4 * var(--rpx));
}

.recognition-accelerator {
  width: 100%;
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: rgba(112, 68, 255, 0.055);
  color: var(--ink);
  text-align: left;
}

.recognition-accelerator__title {
  font-size: var(--text-caption);
  font-weight: 800;
}

.recognition-accelerator__copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.recognition-accelerator__arrow {
  flex: none;
  color: var(--primary);
  font-size: var(--text-section);
  font-weight: 700;
}

.coach-statement__label {
  margin-bottom: calc(6 * var(--rpx));
  color: var(--primary);
  font-size: var(--text-micro);
  font-weight: 800;
}

.anan-insight__copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.625;
}

.anan-insight__detail {
  margin-top: calc(16 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.625;
}

.coach-detail-row {
  display: flex;
  flex-direction: column;
  gap: calc(6 * var(--rpx));
}

.coach-detail-row + .coach-detail-row {
  margin-top: calc(16 * var(--rpx));
  padding-top: calc(16 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--color-line);
}

.coach-detail-row__label {
  color: var(--ink);
  font-weight: 800;
}

.coach-detail-row__copy {
  color: var(--ink-2);
}

.insight-toggle {
  display: flex;
  width: auto;
  align-items: center;
  gap: calc(2 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.coach-candidate,
.coach-return-feedback {
  margin-top: calc(20 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-24);
}

.coach-candidate {
  border: calc(1 * var(--rpx)) solid rgba(112, 68, 255, 0.14);
  background: rgba(112, 68, 255, 0.045);
}

.coach-candidate__eyebrow {
  color: var(--primary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.coach-candidate__title {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body);
  font-weight: 800;
}

.coach-candidate__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.coach-candidate__actions {
  display: flex;
  gap: calc(16 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.coach-candidate__reject,
.coach-candidate__confirm {
  min-height: calc(64 * var(--rpx));
  flex: 1;
  border-radius: var(--radius-capsule);
  font-size: var(--text-caption);
  font-weight: 700;
}

.coach-candidate__reject {
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--ink-2);
}

.coach-candidate__confirm {
  background: var(--ink);
  color: var(--color-surface);
}

.coach-decision-message {
  margin-top: calc(14 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.coach-return-feedback {
  background: rgba(13, 201, 160, 0.08);
}

.coach-return-feedback__title {
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 800;
}

.coach-return-feedback__change {
  position: relative;
  margin-top: calc(10 * var(--rpx));
  padding-left: calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.coach-return-feedback__change::before {
  position: absolute;
  top: calc(10 * var(--rpx));
  left: 0;
  width: calc(8 * var(--rpx));
  height: calc(8 * var(--rpx));
  border-radius: 50%;
  background: var(--color-success);
  content: "";
}

.coach-return-feedback__next {
  margin-top: calc(16 * var(--rpx));
  padding-top: calc(14 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid rgba(13, 201, 160, 0.16);
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 700;
}

.primary-task__body {
  position: relative;
  z-index: 1;
}

.primary-task__head {
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
  margin-bottom: calc(32 * var(--rpx));
}

.task-meta {
  gap: calc(16 * var(--rpx));
  margin-bottom: calc(12 * var(--rpx));
}

.task-tag {
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.task-duration {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 500;
}

.primary-task__title {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.coach-loop-details {
  display: flex;
  flex-direction: column;
  gap: calc(16 * var(--rpx));
  margin: calc(-4 * var(--rpx)) 0 calc(32 * var(--rpx));
}

.coach-loop-detail {
  display: flex;
  align-items: flex-start;
  gap: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
}

.coach-loop-detail--feedback {
  background: rgba(112, 68, 255, 0.055);
}

.coach-loop-detail__label {
  min-width: calc(96 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.6;
}

.coach-loop-detail__copy {
  min-width: 0;
  flex: 1;
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.basis-button {
  display: flex;
  width: auto;
  align-items: center;
  gap: calc(2 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
  white-space: nowrap;
}

.primary-button {
  width: 100%;
  min-height: calc(88 * var(--rpx));
  justify-content: center;
  gap: calc(12 * var(--rpx));
  border-radius: var(--radius-40);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-section);
  font-weight: 600;
  box-shadow: var(--shadow-elevated);
}

.primary-button--disabled {
  opacity: 0.45;
}

.task-disabled {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.other-tasks {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
  margin-top: var(--figma-space-16);
}

.compact-task {
  justify-content: space-between;
  gap: calc(16 * var(--rpx));
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx));
  border-radius: var(--radius-48);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.compact-task__main {
  flex: 1;
  min-width: 0;
  gap: calc(24 * var(--rpx));
}

.compact-task__copy {
  min-width: 0;
}

.compact-task__icon {
  display: flex;
  width: calc(64 * var(--rpx));
  min-width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-surface-soft);
}

.compact-task__title {
  margin-bottom: calc(2 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.compact-task__meta {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.compact-task__action {
  width: auto;
  min-width: calc(104 * var(--rpx));
  flex: none;
  padding: calc(12 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--bg);
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 600;
  white-space: nowrap;
}

.completed-task {
  gap: calc(24 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(40 * var(--rpx));
  opacity: 0.5;
}

.completed-task__title {
  min-width: 0;
  flex: 1;
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-decoration: line-through;
  text-decoration-color: var(--color-line-strong);
}

.completed-task__action {
  width: auto;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.secondary-tools {
  flex: none;
  margin: calc(24 * var(--rpx)) 0 calc(16 * var(--rpx));
}

.secondary-tools__head {
  display: none;
}

.settlement-button {
  width: 100%;
  min-height: calc(88 * var(--rpx));
  justify-content: center;
  gap: calc(16 * var(--rpx));
  margin-top: var(--figma-space-16);
  border: calc(1 * var(--rpx)) solid var(--ink);
  border-radius: var(--radius-40);
  background: var(--ink);
  box-shadow: var(--shadow);
  color: var(--color-surface);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.icon--settlement {
  filter: brightness(0) invert(1);
}

.tool-row {
  gap: calc(16 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
}

.tool-link {
  width: 0;
  min-height: calc(80 * var(--rpx));
  flex: 1;
  justify-content: center;
  gap: calc(12 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 700;
}

.task-error,
.empty-card {
  padding: calc(32 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--color-surface);
}

.task-error {
  color: var(--danger);
  font-size: var(--text-caption);
}

.empty-card__title {
  margin-top: calc(16 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 700;
}

.empty-card__mode {
  display: inline-flex;
  width: fit-content;
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 700;
}

.empty-card__copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  line-height: 1.625;
}

.empty-card__summary {
  margin: calc(20 * var(--rpx)) 0 calc(28 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 600;
}

.empty-card__actions {
  display: flex;
  gap: calc(16 * var(--rpx));
}

.empty-card__secondary {
  min-height: calc(80 * var(--rpx));
  flex: 1;
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 700;
}

.track-section {
  margin-top: calc(40 * var(--rpx));
}

.today-col--track {
  order: 3;
  margin-top: 0;
}

.today-col--main {
  order: 1;
}

.today-col--side-b {
  order: 4;
}

.track-section__head,
.track-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.track-section__head {
  gap: calc(16 * var(--rpx));
  margin: 0 calc(8 * var(--rpx)) calc(24 * var(--rpx));
}

.track-section__title {
  color: var(--ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.track-section__note {
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 500;
}

.track-grid {
  display: flex;
  gap: calc(16 * var(--rpx));
}

.track-card {
  width: 0;
  min-height: calc(268 * var(--rpx));
  flex: 1;
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
  text-align: left;
}

.track-card__name {
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.track-card__status {
  width: calc(12 * var(--rpx));
  height: calc(12 * var(--rpx));
  flex: none;
  border-radius: 50%;
  background: var(--line);
}

.track-card--active .track-card__status {
  background: var(--primary);
  box-shadow: 0 0 0 calc(8 * var(--rpx)) var(--primary-soft);
}

.track-card--complete .track-card__status {
  background: var(--color-success);
}

.track-card__summary {
  margin-top: calc(24 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-caption);
  font-weight: 700;
}

.track-card__detail {
  display: -webkit-box;
  min-height: calc(66 * var(--rpx));
  margin-top: calc(8 * var(--rpx));
  overflow: hidden;
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.track-card__action {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 700;
}

.track-card--active .track-card__action {
  color: var(--primary);
}

/* 600+ 进入平板排版；仅在 1024+ 横屏进入任务台双栏。 */
@media (min-width: 600px) {
  .today-content {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }
}

@media (min-width: 1024px) and (orientation: landscape) {
  .today-content {
    display: grid;
    max-width: 1100px;
    align-items: start;
    column-gap: 28px;
    row-gap: 24px;
    grid-template-columns: minmax(0, 1fr) 320px;
    grid-template-areas:
      "header header"
      "main side-b"
      "main track"
      "main .";
    grid-template-rows: auto auto auto 1fr;
  }

  .today-header {
    grid-area: header;
  }

  .today-col--main {
    grid-area: main;
    min-width: 0;
  }

  .today-col--side-b {
    grid-area: side-b;
    min-width: 0;
  }

  .today-col--track {
    grid-area: track;
    min-width: 0;
    margin-top: 0;
  }

  .secondary-tools {
    margin: 0 0 8px;
  }

  .secondary-tools__head {
    display: block;
    margin: calc(8 * var(--rpx)) 4px 16px;
  }

  .secondary-tools__title {
    color: var(--ink);
    font-size: var(--text-title-sm);
    font-weight: 700;
  }

  .secondary-tools__meta {
    margin-top: calc(12 * var(--rpx));
    color: var(--ink-2);
    font-size: var(--text-caption);
    font-weight: 500;
  }

  .today-col--track .track-section__head {
    align-items: flex-start;
    flex-direction: column;
    gap: calc(8 * var(--rpx));
    margin: 0 4px 16px;
  }

  .today-col--track .track-grid {
    flex-direction: column;
    gap: 12px;
  }

  .today-col--track .track-card {
    width: 100%;
    min-height: 0;
    padding: 16px 18px;
    border-radius: var(--radius-32);
  }

  .today-col--track .track-card__summary {
    margin-top: 12px;
  }

  .today-col--track .track-card__detail {
    min-height: 0;
    margin-top: 4px;
  }

  .today-col--track .track-card__action {
    margin-top: 12px;
  }
}
