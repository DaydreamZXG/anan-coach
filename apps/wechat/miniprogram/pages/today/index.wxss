.today {
  padding-top: 0;
}
.statusbar {
  height: calc(env(safe-area-inset-top) + 24rpx);
}

/* 岸岸每日开场条 */
.opening {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.opening-main { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.opening-greeting { font-size: 29rpx; line-height: 1.6; color: #5c4a35; }
.opening-coffee { font-size: 26rpx; line-height: 1.5; color: #8a6d4a; }
.opening-close { font-size: 40rpx; color: #c4a984; line-height: 1; padding: 0 8rpx; flex-shrink: 0; }

/* 头部 */
.head {
  padding: 8rpx 0 24rpx;
}
.head-date {
  display: block;
  margin-bottom: 8rpx;
}
.head-title {
  display: block;
  margin-bottom: 28rpx;
}
.target-bar {
  display: flex;
  align-items: stretch;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 24rpx 28rpx;
}
.target-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.target-divider {
  width: 1rpx;
  background: var(--line);
  margin: 0 28rpx;
}
.target-main {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.target-gap {
  font-size: 46rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
}
.target-gap-unit {
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 4rpx;
}

/* 告警 */
.alert {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff6ec;
  border: 1rpx solid #f4d9b8;
  border-radius: var(--radius-sm);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.alert-body { display: flex; flex-direction: column; gap: 4rpx; }
.alert-title { font-size: 28rpx; font-weight: 600; color: #a15b12; }
.alert-arrow { font-size: 40rpx; color: #c98a3f; }

/* 今日依据：暖色岸岸卡 */
.rationale {
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 32rpx;
}
.rationale-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.anan-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--warm);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rationale-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #a15b12;
}
.rationale-text {
  display: block;
  font-size: 29rpx;
  line-height: 1.6;
  color: #5c4a35;
  margin-bottom: 12rpx;
}
.rationale-basis { display: block; margin-bottom: 16rpx; }
.rationale-cta { font-size: 26rpx; color: var(--warm); font-weight: 600; }

/* 进度 */
.progress-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.progress-label { font-size: 30rpx; font-weight: 600; }
.progress-count { font-size: 30rpx; color: var(--ink-2); }

/* 任务流 */
.stream { display: flex; flex-direction: column; }
.task { display: flex; gap: 20rpx; }
.task-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 56rpx;
}
.task-node {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.task-order { font-size: 28rpx; color: var(--ink-3); font-weight: 600; }
.task-check { font-size: 30rpx; color: #fff; }
.task-line { flex: 1; width: 2rpx; background: var(--line); margin: 4rpx 0; }
.task-next .task-node { border-color: var(--primary); }
.task-next .task-order { color: var(--primary); }
.task-done .task-node { background: var(--good); border-color: var(--good); }

.task-body {
  flex: 1;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.task-next .task-body { border-color: var(--primary); box-shadow: 0 8rpx 24rpx rgba(43, 108, 176, 0.08); }
.task-done .task-body { opacity: 0.6; }
.task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.task-track {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
}
.track-essay { background: #eef4ea; color: #5a7a3f; }
.track-recovery { background: #f3eefb; color: #6b5a8a; }
.track-mock { background: #fdecec; color: #b53a3a; }
.task-title { display: block; margin-bottom: 6rpx; }
.task-sub { display: block; margin-bottom: 16rpx; }
.task-reason {
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}
.task-reason-text {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.task-grounding { display: block; }
.task-btn { width: 100%; }
.task-done-tag {
  text-align: center;
  font-size: 26rpx;
  color: var(--good);
  font-weight: 600;
  padding: 12rpx 0;
}

/* 每日结算 */
.settle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border: 1rpx dashed var(--line);
  border-radius: var(--radius);
  padding: 32rpx 28rpx;
  margin-top: 8rpx;
}
.settle-ready {
  background: var(--good-soft);
  border: 1rpx solid #bfe4cd;
}
.settle-body { display: flex; flex-direction: column; gap: 6rpx; }
.settle-title { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.settle-ready .settle-title { color: var(--good); }
.settle-arrow { font-size: 44rpx; color: var(--ink-3); }
.settle-ready .settle-arrow { color: var(--good); }

.demo-tip { text-align: center; margin-top: 24rpx; }

/* 骨架屏 */
.skeleton-head { height: 200rpx; border-radius: var(--radius); background: #eef0f3; margin-bottom: 24rpx; }
.skeleton-card { height: 240rpx; border-radius: var(--radius); background: #eef0f3; margin-bottom: 24rpx; }
