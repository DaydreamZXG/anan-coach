<view class="today-page">
  <safe-top gap="4" />

  <view class="today-content">
    <view class="today-header">
      <view class="today-header__copy">
        <view class="today-date">{{openingView ? openingView.localDateLabel : '今天'}}</view>
        <view class="today-greeting">{{headerGreeting}}</view>
        <view class="today-countdown">{{headerContextLabel}}</view>
      </view>
      <button hover-class="item--hover" class="capture-button" bindtap="openCaptureImport" aria-label="拍照搜题">
        <image class="icon icon--camera" src="/assets/icons/today/camera-ink.png" mode="aspectFit" />
      </button>
    </view>

    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="今天的计划没有加载成功"
      description="{{errorMessage}}"
      action-text="重新加载"
      bind:action="retry"
    />

    <block wx:elif="{{view}}">
      <view class="today-col today-col--side-a">
      <view
        wx:if="{{openingStatus === 'error'}}"
        class="opening-failure"
      >
        <view class="opening-failure__copy">{{openingError || '每日开场没有加载成功。'}}</view>
        <button hover-class="item--hover" class="opening-failure__retry" bindtap="loadDailyOpening">重新读取</button>
      </view>

      <view
        wx:elif="{{openingStatus === 'ready' && openingView && !openingCollapsed}}"
        class="opening-card"
      >
        <view class="opening-line" wx:if="{{openingView.weatherReady}}">
          <image class="icon icon--small" src="/assets/icons/today/cloud-rain-muted.png" mode="aspectFit" />
          <text class="opening-line__text">{{openingView.weatherHeadline}} {{openingView.weatherDetail}}</text>
        </view>

        <view class="opening-line" wx:elif="{{openingView.weatherLocationRequired}}">
          <image class="icon icon--small" src="/assets/icons/today/cloud-rain-muted.png" mode="aspectFit" />
          <text class="opening-line__text">
            {{weatherLocationStatus === 'requesting' ? '正在获取附近天气…' : (weatherLocationMessage || '开启定位后显示附近天气')}}
          </text>
          <button hover-class="item--hover"
            wx:if="{{weatherLocationStatus === 'denied' || weatherLocationStatus === 'error'}}"
            class="weather-location-button"
            bindtap="requestWeatherLocation"
          >{{weatherLocationStatus === 'denied' ? '去开启' : '重试'}}</button>
        </view>

        <view class="opening-line">
          <image class="icon icon--small" src="/assets/icons/today/target-muted.png" mode="aspectFit" />
          <text class="opening-line__text">今天安排 {{view.availableDurationLabel}}，先完成 {{openingView.planTitle}}</text>
        </view>

        <view class="opening-actions">
          <view wx:if="{{openingView.coffeeVisible}}" class="coffee-prompt">
            <image class="icon icon--small" src="/assets/icons/today/coffee-muted.png" mode="aspectFit" />
            <text class="coffee-prompt__text">顺便看咖啡？</text>
            <button hover-class="item--hover" class="coffee-button coffee-button--quiet" bindtap="declineDailyCoffee">今天不喝</button>
          </view>
          <button hover-class="item--hover" class="opening-start" bindtap="startDailyOpening">开始学习</button>
        </view>
        <view wx:if="{{openingError}}" class="opening-error">{{openingError}}</view>
      </view>

      <view
        wx:elif="{{openingStatus === 'ready' && openingView && openingCollapsed}}"
        class="opening-collapsed"
      >
        <view class="opening-collapsed__main">
          <image class="icon icon--small" src="/assets/icons/today/target-ink.png" mode="aspectFit" />
          <text>学习进行中 · {{view.availableDurationLabel}}</text>
        </view>
        <text wx:if="{{openingView.weatherReady}}" class="opening-collapsed__weather">{{openingView.weatherHeadline}}</text>
      </view>
      </view>

      <view class="today-col today-col--main">
      <view
        wx:if="{{capacityMessage && (capacitySubmission === 'conflict' || capacitySubmission === 'error')}}"
        class="capacity-notice capacity-notice--{{capacitySubmission}}"
      >
        <text class="capacity-notice__copy">{{capacityMessage}}</text>
        <button hover-class="item--hover" class="capacity-notice__action" bindtap="retry">重新载入</button>
      </view>

      <view class="task-heading">
        <view class="task-heading__title">今日任务</view>
        <view class="task-heading__meta">
          <text>今天可学 {{view.availableDurationLabel}} · 精力{{energyLabel}} · 压力{{stressLabel}}</text>
          <button hover-class="item--hover" class="adjust-button" bindtap="openDayAdjustment">调整今天</button>
        </view>
      </view>

      <view wx:if="{{!view.hasTasks}}" class="empty-card">
        <view class="empty-card__title">{{view.headline || '今天还没有可执行任务'}}</view>
        <view class="empty-card__copy">{{view.rationale || '先确认目标岗位和今天可用时间，岸岸才能生成真实安排。'}}</view>
        <button hover-class="item--hover" class="primary-button" bindtap="openDayAdjustment">调整今天</button>
      </view>

      <block wx:for="{{view.tasks}}" wx:key="id">
        <view wx:if="{{index === 0}}" class="primary-task">
          <view class="task-aurora"></view>
          <view class="anan-insight">
            <view class="anan-icon">
              <image class="icon icon--sparkles" src="/assets/icons/today/sparkles-white.png" mode="aspectFit" />
            </view>
            <view class="anan-insight__main">
              <view class="anan-insight__title">岸岸建议</view>
              <view class="anan-insight__copy">{{view.headline}}</view>
              <view wx:if="{{insightExpanded}}" class="anan-insight__detail">{{view.rationale}}</view>
              <button hover-class="item--hover" class="insight-toggle" bindtap="toggleInsight">
                <text>{{insightExpanded ? '收起' : '为什么今天先做这个？'}}</text>
                <image class="icon icon--chevron {{insightExpanded ? 'icon--rotated' : ''}}" src="/assets/icons/today/chevron-down-muted.png" mode="aspectFit" />
              </button>
            </view>
          </view>

          <view class="primary-task__body">
            <view class="primary-task__head">
              <view>
                <view class="task-meta">
                  <text class="task-tag">{{item.kindLabel}}</text>
                  <text class="task-duration">· 预计 {{item.estimatedMinutes}} 分钟</text>
                </view>
                <view class="primary-task__title">{{item.title}}</view>
              </view>
              <button hover-class="item--hover" class="basis-button" bindtap="openPlanBasis">
                <text>为什么这样练</text>
                <image class="icon icon--chevron" src="/assets/icons/today/chevron-right-indigo.png" mode="aspectFit" />
              </button>
            </view>
            <button
              hover-class="item--hover"
              class="primary-button {{!item.canOpen ? 'primary-button--disabled' : ''}}"
              data-id="{{item.id}}"
              disabled="{{!item.canOpen}}"
              bindtap="openTask"
            >
              <image class="icon icon--play" src="/assets/icons/today/play-white.png" mode="aspectFit" />
              <text>{{taskOpeningId === item.id ? '正在打开…' : item.status === 'in_progress' ? '继续第一项任务' : '开始第一项任务'}}</text>
            </button>
            <view wx:if="{{!item.canOpen}}" class="task-disabled">{{item.disabledReason}}</view>
          </view>
        </view>
      </block>

      <view class="other-tasks">
        <block wx:for="{{view.tasks}}" wx:key="id">
          <view wx:if="{{index > 0 && item.status !== 'complete'}}" class="compact-task">
            <view class="compact-task__main">
              <view class="compact-task__icon">
                <image class="icon icon--small" src="/assets/icons/today/file-text-secondary.png" mode="aspectFit" />
              </view>
              <view>
                <view class="compact-task__title">{{item.title}}</view>
                <view class="compact-task__meta">{{item.trackLabel}} · 预计 {{item.estimatedMinutes}} 分钟</view>
              </view>
            </view>
            <button
              hover-class="item--hover"
              class="compact-task__action"
              data-id="{{item.id}}"
              disabled="{{!item.canOpen}}"
              bindtap="openTask"
            >{{item.status === 'in_progress' ? '继续' : '开始'}}</button>
          </view>

          <view wx:if="{{item.status === 'complete'}}" class="completed-task">
            <image class="icon icon--completed" src="/assets/icons/today/circle-check-muted.png" mode="aspectFit" />
            <view class="completed-task__title">{{item.title}}</view>
            <button hover-class="item--hover" class="completed-task__action" bindtap="openDailySettlement">查看复盘</button>
          </view>
        </block>
      </view>
      <view wx:if="{{taskNavigationError}}" class="task-error">{{taskNavigationError}}</view>
      </view>

      <view class="today-col today-col--side-b">
      <view class="secondary-tools">
        <button hover-class="item--hover" class="settlement-button" bindtap="openDailySettlement">
          <image class="icon icon--settlement" src="/assets/icons/today/circle-check-secondary.png" mode="aspectFit" />
          <text>结束今天并复盘</text>
        </button>

        <view class="tool-row">
          <button hover-class="item--hover" class="tool-link" bindtap="openMasteryQueue">
            <image class="icon icon--small" src="/assets/icons/today/book-open-secondary.png" mode="aspectFit" />
            <text>错题与掌握</text>
          </button>
          <button hover-class="item--hover" class="tool-link" bindtap="openWeeklyPlan">
            <image class="icon icon--small" src="/assets/icons/today/calendar-days-secondary.png" mode="aspectFit" />
            <text>周计划</text>
          </button>
        </view>
      </view>
      </view>
    </block>
  </view>
</view>
