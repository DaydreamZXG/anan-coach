<view class="s9-page today-page">
  <view class="today-topbar">
    <view>
      <view class="today-kicker">岸岸 · 今日计划</view>
      <view class="today-heading">今日</view>
    </view>
    <button class="today-capture" bindtap="openCaptureImport">
      <text class="today-capture__icon">⌁</text>
      <text>拍题</text>
    </button>
  </view>
  <view class="today-intro">今天只做最值钱的事。岗位目标、能力证据和可用时间共同决定行动。</view>

  <block wx:if="{{status === 'loading'}}">
    <view class="top-space"><state-view state="loading" /></view>
  </block>

  <view wx:elif="{{status === 'error'}}" class="top-space">
    <state-view
      state="error"
      title="计划没有加载成功"
      description="{{errorMessage}}"
      actionText="重新加载"
      bindaction="retry"
    />
  </view>

  <block wx:elif="{{view}}">
    <view wx:if="{{openingStatus === 'ready' && openingView}}" class="daily-opening card top-space">
      <view class="daily-opening__head">
        <view class="daily-opening__identity">
          <anan-companion intent="encouragement" size="small" context="home" label="岸岸" />
          <view>
            <view class="daily-opening__kicker">岸岸 · {{openingView.localDateLabel}}</view>
            <view class="daily-opening__greeting">{{openingView.greeting}}</view>
          </view>
        </view>
        <view class="daily-opening__once">今日一次</view>
      </view>

      <view wx:if="{{openingView.weatherReady}}" class="daily-opening__weather">
        <view>
          <view class="daily-opening__weather-main">{{openingView.weatherHeadline}}</view>
          <view class="daily-opening__weather-detail">{{openingView.weatherDetail}}</view>
        </view>
        <button class="daily-opening__source" bindtap="openWeatherAttribution">Apple Weather ›</button>
      </view>
      <view wx:elif="{{openingView.weatherLocationRequired}}" class="daily-opening__setup">
        <view>
          <view class="daily-opening__setup-title">先选一个天气地点</view>
          <view class="daily-opening__setup-copy">只保存约百米精度的位置，不持续定位，也不会直接用于咖啡下单。</view>
        </view>
        <button class="daily-opening__location" loading="{{openingWriting}}" bindtap="chooseWeatherLocation">选择地点</button>
      </view>
      <view wx:elif="{{openingView.weatherUnavailable}}" class="daily-opening__provider-state">
        天气服务尚未完成线上授权，本次不展示推测天气。
      </view>

      <view class="daily-opening__plan">
        <view class="daily-opening__plan-copy">
          <view class="daily-opening__plan-label">今天先做</view>
          <view class="daily-opening__plan-title">{{openingView.planTitle}}</view>
        </view>
        <view class="daily-opening__minutes type-data">{{openingView.planMinutesLabel}}</view>
      </view>

      <view wx:if="{{openingView.coffeeVisible}}" class="daily-opening__coffee">
        <view class="daily-opening__coffee-copy">{{openingView.coffeePrompt}}</view>
        <view class="daily-opening__coffee-actions">
          <button class="daily-opening__coffee-primary" bindtap="openCoffeeAssistant">帮我看看</button>
          <button class="daily-opening__coffee-secondary" loading="{{openingWriting}}" bindtap="declineDailyCoffee">今天不喝</button>
          <button class="daily-opening__coffee-secondary" loading="{{openingWriting}}" bindtap="disableDailyCoffee">以后别问</button>
        </view>
      </view>

      <view wx:if="{{openingError}}" class="daily-opening__error">{{openingError}}</view>
      <button class="daily-opening__start" bindtap="startDailyOpening">开始今日学习</button>
    </view>

    <view class="focus-dashboard card top-space">
      <view class="dashboard-hero-strip">
        <view class="dashboard-hero-main">
          <view class="goal-label">今日备考主目标</view>
          <view class="goal-name">{{view.positionName}}</view>
          <view class="goal-evidence">{{view.evidenceSummary}}</view>
        </view>
        <view class="dashboard-hero-side">
          <view class="pill {{view.capacityStatusLabel === '已确认容量版本' ? 'pill--success' : ''}}">{{view.capacityStatusLabel}}</view>
        </view>
      </view>

      <view wx:if="{{view.hasCompleteGoalGap}}" class="gap-brief-row">
        <view class="gap-brief-item">
          <view class="score-label">当前总分估计</view>
          <view class="score-value">{{view.currentScore}} <text class="score-unit">分</text></view>
        </view>
        <view class="gap-arrow">→</view>
        <view class="gap-brief-item">
          <view class="score-label">岗位备考线</view>
          <view class="score-value">{{view.targetScore}} <text class="score-unit">分</text></view>
        </view>
        <view class="gap-badge">
          差 <text class="type-data">{{view.scoreGap}}</text> 分
        </view>
      </view>
      <view wx:else class="gap-unavailable">
        <view class="gap-unavailable-title">{{view.gapStateLabel}}</view>
        <view class="gap-unavailable-copy">{{view.gapGuidance}}</view>
      </view>

      <view class="coach-insight-box">
        <view class="coach-insight-header">
          <anan-companion intent="thinking" size="small" context="plan" label="岸岸判断" />
          <view class="coach-mark">AI 导读建议 · {{view.confidence}}</view>
        </view>
        <view class="coach-headline">{{view.headline}}</view>
        <view class="coach-copy">{{view.rationale}}</view>
      </view>

      <view class="capacity-bar">
        <view class="capacity-bar-info">
          <view class="capacity-bar-title">
            今日可用 <text class="type-data">{{view.availableMinutes}}</text> 分钟
          </view>
          <view class="capacity-bar-meta">
            精力 {{view.energy}}/5 · 压力 {{view.stress}}/5 · {{view.capacitySourceLabel}}
          </view>
        </view>
        <button class="capacity-edit-button" bindtap="toggleCapacityEditor">
          {{capacityEditorOpen ? '收起调整' : '调整容量'}}
        </button>
      </view>

      <view wx:if="{{capacityEditorOpen && capacityDraft}}" class="capacity-editor">
        <view class="capacity-field">
          <view class="capacity-field-heading">
            <view class="capacity-field-copy">
              <view class="capacity-field-label">今日真实可用时间</view>
              <view class="capacity-field-help">包含做题、复盘和申论作答的总时间</view>
            </view>
            <view class="capacity-minute-input">
              <input
                class="type-data capacity-minute-input__control"
                type="number"
                maxlength="4"
                value="{{capacityDraft.availableMinutes}}"
                disabled="{{capacitySubmission === 'submitting' || capacitySubmission === 'conflict'}}"
                bindinput="inputAvailableMinutes"
              />
              <text>分钟</text>
            </view>
          </view>
        </view>

        <view class="capacity-field">
          <view class="capacity-field-heading">
            <view class="capacity-field-copy">
              <view class="capacity-field-label">当前精力</view>
              <view class="capacity-field-help">现在可以持续专注的状态</view>
            </view>
            <view class="capacity-current"
              ><text class="type-data">{{capacityDraft.energy}}</text> · {{energyLabel}}</view
            >
          </view>
          <view class="capacity-scale">
            <button
              wx:for="{{capacityScaleOptions}}"
              wx:key="*this"
              class="capacity-scale-option {{capacityDraft.energy === item ? 'capacity-scale-option--active' : ''}} {{capacitySubmission === 'submitting' || capacitySubmission === 'conflict' ? 'capacity-scale-option--disabled' : ''}}"
              hover-class="item--hover"
              data-field="energy"
              data-value="{{item}}"
              disabled="{{capacitySubmission === 'submitting' || capacitySubmission === 'conflict'}}"
              bindtap="chooseCapacityScale"
            >
              {{item}}
            </button>
          </view>
        </view>

        <view class="capacity-field">
          <view class="capacity-field-heading">
            <view class="capacity-field-copy">
              <view class="capacity-field-label">当前压力</view>
              <view class="capacity-field-help">以你的主观感受为准，不做价值判断</view>
            </view>
            <view class="capacity-current"
              ><text class="type-data">{{capacityDraft.stress}}</text> · {{stressLabel}}</view
            >
          </view>
          <view class="capacity-scale">
            <button
              wx:for="{{capacityScaleOptions}}"
              wx:key="*this"
              class="capacity-scale-option {{capacityDraft.stress === item ? 'capacity-scale-option--active' : ''}} {{capacitySubmission === 'submitting' || capacitySubmission === 'conflict' ? 'capacity-scale-option--disabled' : ''}}"
              hover-class="item--hover"
              data-field="stress"
              data-value="{{item}}"
              disabled="{{capacitySubmission === 'submitting' || capacitySubmission === 'conflict'}}"
              bindtap="chooseCapacityScale"
            >
              {{item}}
            </button>
          </view>
        </view>

        <view class="capacity-recovery-hint">
          <view class="capacity-recovery-title">精力与压力会影响恢复模式</view>
          <view>低精力或高压力时，规划 Agent 会减少新知识负荷，优先保留必要复测与恢复任务。</view>
        </view>

        <view class="capacity-field">
          <view class="capacity-field-heading">
            <view class="capacity-field-copy">
              <view class="capacity-field-label">时间可兑现把握</view>
              <view class="capacity-field-help">今天真正能留出这段时间的确定程度</view>
            </view>
            <view class="capacity-current"
              ><text class="type-data">{{capacityDraft.confidenceLevel}}</text> ·
              {{confidenceLabel}}</view
            >
          </view>
          <view class="capacity-scale">
            <button
              wx:for="{{capacityScaleOptions}}"
              wx:key="*this"
              class="capacity-scale-option {{capacityDraft.confidenceLevel === item ? 'capacity-scale-option--active' : ''}} {{capacitySubmission === 'submitting' || capacitySubmission === 'conflict' ? 'capacity-scale-option--disabled' : ''}}"
              data-field="confidenceLevel"
              data-value="{{item}}"
              disabled="{{capacitySubmission === 'submitting' || capacitySubmission === 'conflict'}}"
              bindtap="chooseCapacityScale"
            >
              {{item}}
            </button>
          </view>
        </view>

        <view
          class="capacity-write-notice {{capacityWriteAllowed ? '' : 'capacity-write-notice--disabled'}}"
        >
          {{capacityWriteNotice}}
        </view>
        <view
          wx:if="{{capacityMessage}}"
          class="capacity-feedback capacity-feedback--{{capacitySubmission}}"
          >{{capacityMessage}}</view
        >

        <button
          wx:if="{{capacitySubmission === 'conflict'}}"
          class="secondary-button capacity-submit"
          bindtap="reloadAfterCapacityConflict"
        >
          重新载入最新计划
        </button>
        <button
          wx:else
          class="primary-button capacity-submit {{!capacityWriteAllowed || capacitySubmission === 'submitting' ? 'capacity-submit--disabled' : ''}}"
          loading="{{capacitySubmission === 'submitting'}}"
          disabled="{{!capacityWriteAllowed || capacitySubmission === 'submitting'}}"
          bindtap="submitCapacity"
        >
          {{capacitySubmission === 'submitting' ? '正在重排今日计划' : '确认容量并重排计划'}}
        </button>
      </view>

      <view
        wx:if="{{!capacityEditorOpen && capacitySubmission === 'success'}}"
        class="capacity-feedback capacity-feedback--success"
      >
        {{capacityMessage}}
      </view>
    </view>

    <view class="section-heading">
      <view>
        <view class="section-title">{{view.planSectionTitle}}</view>
        <view class="track-budget">
          <view class="plan-mode-pill">{{view.planModeLabel}}</view>
          <view
            wx:for="{{view.trackAllocations}}"
            wx:for-item="allocation"
            wx:key="track"
            class="track-budget-item track-budget-item--{{allocation.track}}"
          >
            {{allocation.trackLabel}} <text class="type-data">{{allocation.minutes}}</text> 分钟
          </view>
        </view>
      </view>
      <view class="section-side">
        <view class="section-meta">{{view.dueSummary}}</view>
        <button class="mastery-link" bindtap="openMasteryQueue">错题与掌握 →</button>
      </view>
    </view>

    <view class="plan-explanation card">
      <view>{{view.planModeSummary}}</view>
      <view
        wx:for="{{view.trackAllocations}}"
        wx:for-item="allocation"
        wx:key="track"
        class="allocation-reason"
      >
        <text class="allocation-track">{{allocation.trackLabel}}</text>
        <text>{{allocation.stageSummary}}：{{allocation.reason}}</text>
      </view>
      <view
        wx:for="{{view.omittedTrackReasons}}"
        wx:for-item="omission"
        wx:key="track"
        class="omitted-reason"
      >
        <text class="omitted-reason__label">{{omission.trackLabel}}未安排</text>
        <text>{{omission.reason}}</text>
      </view>
    </view>

    <view class="plan-tools card">
      <button class="plan-tool" hover-class="item--hover" bindtap="openPlanBasis"><text>为什么这样排</text><text class="plan-tool__arrow">→</text></button>
      <button class="plan-tool" hover-class="item--hover" bindtap="openDayAdjustment"><text>调整今天安排</text><text class="plan-tool__arrow">→</text></button>
      <button class="plan-tool" hover-class="item--hover" bindtap="openDailySettlement"><text>进入每日结算</text><text class="plan-tool__arrow">→</text></button>
      <button class="plan-tool" hover-class="item--hover" bindtap="openWeeklyPlan"><text>5+1+1 周计划</text><text class="plan-tool__arrow">→</text></button>
    </view>

    <view wx:if="{{view.isRecoveryDay}}" class="recovery-note"
      >今天是恢复日：只做必要复测，不安排新知识。</view
    >

    <view wx:if="{{!view.hasTasks}}" class="task-empty card">
      <view>当前没有通过容量和内容门禁的可执行任务。</view>
      <text class="task-empty__note">规划缺口已如实保留，不会用占位任务冒充今日安排。</text>
    </view>

    <view wx:if="{{taskNavigationError}}" class="task-navigation-error">
      {{taskNavigationError}}
    </view>

    <view
      wx:for="{{view.tasks}}"
      wx:key="id"
      class="task card {{item.canOpen ? '' : 'task--disabled'}} {{taskOpeningId === item.id ? 'task--opening' : ''}}"
      hover-class="{{item.canOpen ? 'card--hover' : ''}}"
      data-id="{{item.id}}"
      bindtap="openTask"
    >
      <view class="task-order">{{index + 1}}</view>
      <view class="task-body">
        <view class="row">
          <view class="task-tags">
            <view class="track-pill track-pill--{{item.track}}">{{item.trackLabel}}</view>
            <view class="pill">{{item.stageLabel}}</view>
            <view class="pill pill--quiet">{{item.kindLabel}}</view>
            <view class="pill task-status task-status--{{item.status}}">{{item.statusLabel}}</view>
          </view>
          <view class="task-time"
            ><text class="type-data">{{item.estimatedMinutes}}</text> 分钟</view
          >
        </view>
        <view wx:if="{{item.elapsedMinutes !== null}}" class="task-progress">
          已记录 <text class="type-data">{{item.elapsedMinutes}}</text> 分钟实际投入
        </view>
        <view class="task-title">{{taskOpeningId === item.id ? '正在打开···' : item.title}}</view>
        <view class="task-reason">{{item.reason}}</view>
        <view class="task-rule">验收：{{item.completionRule}}</view>
        <view class="task-basis">
          <view class="task-basis-title">安排依据</view>
          <view class="task-priority">
            <view
              wx:for="{{item.priorityMetrics}}"
              wx:for-item="metric"
              wx:key="label"
              class="task-priority-item"
            >
              <text>{{metric.label}}</text><text class="type-data">{{metric.value}}</text>
            </view>
          </view>
          <view
            wx:for="{{item.evidenceLabels}}"
            wx:for-item="evidenceLabel"
            wx:key="*this"
            class="task-evidence"
          >
            <view class="task-evidence-dot"></view>
            <view>{{evidenceLabel}}</view>
          </view>
        </view>
        <view wx:if="{{!item.canOpen}}" class="task-disabled-reason">{{item.disabledReason}}</view>
      </view>
    </view>

    <button class="setup-link" bindtap="openOnboarding">修改建档与学习设置 →</button>
  </block>
</view>
