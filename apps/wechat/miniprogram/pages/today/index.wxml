<view class="page today">
  <block wx:if="{{loading}}">
    <view class="statusbar" />
    <view class="skeleton-head" />
    <view class="skeleton-card" />
    <view class="skeleton-card" />
  </block>

  <block wx:else>
    <!-- 蓝色 hero 头部 -->
    <view class="hero">
      <view class="statusbar" />
      <text class="hero-date num">{{stream.date}}</text>
      <text class="hero-title">{{stream.headline}}</text>

      <view class="hero-stats">
        <view class="hs-col">
          <text class="hs-label">目标</text>
          <text class="hs-main">{{stream.target.positionGroup}}</text>
          <text class="hs-sub">{{stream.target.exam}}</text>
        </view>
        <view class="hs-divider" />
        <view class="hs-col">
          <text class="hs-label">当前分差</text>
          <text class="hs-gap num" wx:if="{{stream.target.scoreGapAvailable}}">{{stream.target.scoreGap}}<text class="hs-gap-unit">分</text></text>
          <text class="hs-main" wx:else>待测</text>
          <text class="hs-sub">{{stream.calibration.statusLabel}}</text>
        </view>
      </view>

      <view class="hero-basis" bindtap="onOpenBasis">
        <text class="hero-basis-text">为什么是这些任务 · 状态不好想减量</text>
        <text class="hero-basis-arrow">›</text>
      </view>
    </view>

    <!-- 岸岸每日开场 -->
    <view wx:if="{{opening}}" class="opening">
      <view class="anan-avatar">岸</view>
      <view class="opening-main">
        <text class="opening-greeting">{{opening.greeting}}</text>
        <text wx:if="{{opening.weatherLine}}" class="text-3">{{opening.weatherLine}}</text>
        <text wx:if="{{opening.coffeePrompt}}" class="opening-coffee">{{opening.coffeePrompt}}</text>
      </view>
      <text class="opening-close" bindtap="onDismissOpening">×</text>
    </view>

    <!-- 告警（如降载提醒等） -->
    <view
      wx:for="{{stream.alerts}}"
      wx:key="id"
      class="alert"
      data-url="{{item.actionUrl}}"
      bindtap="onTapAlert"
    >
      <view class="alert-body">
        <text class="alert-title">{{item.title}}</text>
        <text class="text-3">{{item.subtitle}}</text>
      </view>
      <text class="alert-arrow">›</text>
    </view>

    <!-- 今日依据（岸岸口吻，暖色） -->
    <view class="rationale" bindtap="onAskAnan">
      <view class="rationale-head">
        <view class="anan-avatar">岸</view>
        <text class="rationale-label">今天为什么这么排</text>
      </view>
      <text class="rationale-text">{{stream.rationale}}</text>
      <text class="rationale-cta">有疑问？找岸岸聊聊 ›</text>
    </view>

    <!-- 进度 -->
    <view class="progress-row">
      <text class="progress-label">今日任务</text>
      <text class="progress-count num">{{doneCount}}/{{totalCount}}</text>
    </view>

    <!-- 任务流 -->
    <view class="stream">
      <view
        wx:for="{{tasksView}}"
        wx:key="id"
        class="task {{item.done ? 'task-done' : ''}} {{item.order === (doneCount + 1) && !item.done ? 'task-next' : ''}}"
      >
        <view class="task-rail">
          <view class="task-node">
            <text wx:if="{{item.done}}" class="task-check">✓</text>
            <text wx:else class="task-order num">{{item.order}}</text>
          </view>
          <view wx:if="{{item.order < totalCount}}" class="task-line" />
        </view>

        <view class="task-body">
          <view class="task-top">
            <text class="task-track track-{{item.track}}">{{item.trackLabel}}</text>
            <text class="task-min text-3 num">{{item.estimatedMinutes}} 分钟</text>
          </view>
          <text class="task-title h2">{{item.title}}</text>
          <text class="task-sub text-2">{{item.subtitle}}</text>

          <view class="task-reason">
            <text class="task-reason-text">{{item.reason}}</text>
          </view>

          <button
            wx:if="{{!item.done}}"
            class="btn {{item.order === (doneCount + 1) ? 'btn-primary' : 'btn-ghost'}} task-btn"
            data-url="{{item.startUrl}}"
            data-kind="{{item.kind}}"
            bindtap="onStartTask"
          >
            {{item.order === (doneCount + 1) ? '开始' : '稍后做'}}
          </button>
          <view wx:else class="task-done-tag">已完成</view>
        </view>
      </view>
    </view>

    <!-- 每日结算入口：任务流的终点 -->
    <view class="settle {{allDone ? 'settle-ready' : ''}}" bindtap="onOpenSettlement">
      <view class="settle-body">
        <text class="settle-title">{{allDone ? '今天的事都做完了' : '每日结算'}}</text>
        <text class="text-3">{{allDone ? '来做个结算，看看今天离上岸近了多少' : '完成任务后在这里复盘今天'}}</text>
      </view>
      <text class="settle-arrow">›</text>
    </view>

    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示数据（后端未连接）</view>
  </block>
</view>
