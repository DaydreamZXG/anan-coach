<view class="today-page">
  <safe-top gap="4" />

  <view class="today-content">
    <view class="today-header">
      <view class="today-header__copy">
        <view class="today-date">{{openingView ? openingView.localDateLabel : '今天'}}</view>
        <view class="today-greeting-row">
          <view class="today-greeting">{{headerGreeting}}</view>
          <view wx:if="{{openingStatus === 'ready' && openingView && openingView.weatherReady}}" class="header-weather">
            <image class="header-weather__icon" src="/assets/icons/today/cloud-rain-muted.png" mode="aspectFit" />
            <text>{{openingView.weatherCompactLabel}}</text>
          </view>
          <button
            wx:elif="{{openingStatus === 'ready' && openingView && openingView.weatherLocationRequired}}"
            hover-class="item--hover"
            class="header-weather header-weather--action"
            bindtap="requestWeatherLocation"
          >
            <image class="header-weather__icon" src="/assets/icons/today/cloud-rain-muted.png" mode="aspectFit" />
            <text>{{weatherLocationStatus === 'requesting' ? '获取中…' : '看降雨'}}</text>
          </button>
        </view>
        <view class="today-countdown">{{headerContextLabel}}</view>
      </view>
      <button hover-class="item--hover" class="capture-button" bindtap="openCaptureImport" aria-label="拍照搜题">
        <image class="icon icon--camera" src="/assets/icons/today/camera-ink.png" mode="aspectFit" />
      </button>
    </view>

    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="今天的计划没加载出来"
      description="{{errorMessage}}"
      action-text="再试一次"
      bind:action="retry"
    />

    <block wx:elif="{{view}}">
      <view class="today-col today-col--main">
      <view
        wx:if="{{capacityMessage && (capacitySubmission === 'conflict' || capacitySubmission === 'error')}}"
        class="capacity-notice capacity-notice--{{capacitySubmission}}"
      >
        <text class="capacity-notice__copy">{{capacityMessage}}</text>
        <button hover-class="item--hover" class="capacity-notice__action" bindtap="retry">再试一次</button>
      </view>

      <view class="task-heading">
        <view class="task-heading__title">{{view.planSectionTitle}}</view>
        <view class="task-heading__meta">
          <text>今天可学 {{view.availableDurationLabel}} · 精力{{energyLabel}} · 压力{{stressLabel}}</text>
          <view class="task-heading__actions">
            <button hover-class="item--hover" class="adjust-button" bindtap="openDayAdjustment">调整今天</button>
          </view>
        </view>
      </view>

      <view wx:if="{{!view.hasTasks}}" class="empty-card empty-card--{{view.dayState}}">
        <view class="empty-card__mode">{{view.planModeLabel}}</view>
        <view class="empty-card__title">{{view.emptyStateTitle}}</view>
        <view class="empty-card__copy">{{view.emptyStateCopy}}</view>
        <view class="empty-card__summary">{{view.dueSummary}}</view>
        <view wx:if="{{view.dayState === 'recovery'}}" class="empty-card__actions">
          <button hover-class="item--hover" class="control-center empty-card__secondary" bindtap="openMasteryQueue">查看到期复盘</button>
          <button hover-class="item--hover" class="control-center empty-card__secondary" bindtap="openQuestionBookImport">我想加练</button>
        </view>
        <button wx:elif="{{view.dayState === 'complete'}}" hover-class="item--hover" class="primary-button" bindtap="openDailySettlement">结束今天并复盘</button>
        <button wx:else hover-class="item--hover" class="primary-button" bindtap="openDayAdjustment">调整今天</button>
      </view>

      <view wx:if="{{!view.hasTasks && view.loop && view.loop.feedback}}" class="primary-task primary-task--feedback-only">
        <view class="task-aurora"></view>
        <view class="anan-insight anan-insight--feedback-only">
          <view class="anan-icon">
            <image class="icon icon--sparkles" src="/assets/icons/today/sparkles-white.png" mode="aspectFit" />
          </view>
          <view class="anan-insight__main">
            <view class="anan-insight__heading">
              <text class="anan-insight__title">岸岸建议</text>
              <text class="anan-insight__status">{{view.loop.recognitionLabel}}</text>
            </view>
            <view class="coach-return-feedback coach-return-feedback--standalone">
              <view class="coach-return-feedback__title">{{view.loop.feedback.title}}</view>
              <view wx:for="{{view.loop.feedback.changes}}" wx:key="*this" class="coach-return-feedback__change">{{item}}</view>
              <view class="coach-return-feedback__next">{{view.loop.feedback.nextAction}}</view>
            </view>
          </view>
        </view>
      </view>

      <block wx:for="{{view.activeTasks}}" wx:key="id">
        <view wx:if="{{index === 0}}" class="primary-task">
          <view class="task-aurora"></view>
          <view class="primary-task__body">
            <view class="primary-task__head">
              <view class="compact-task__copy">
                <view class="task-meta">
                  <text class="task-tag">{{item.kindLabel}}</text>
                  <text class="task-duration">· 预计 {{item.estimatedMinutes}} 分钟</text>
                </view>
                <view class="primary-task__title">{{view.loop.actionTitle}}</view>
              </view>
            </view>
            <view class="coach-loop-details">
              <view class="coach-loop-detail">
                <text class="coach-loop-detail__label">完成标准</text>
                <text class="coach-loop-detail__copy">{{view.loop.completionRule}}</text>
              </view>
              <view class="coach-loop-detail coach-loop-detail--feedback">
                <text class="coach-loop-detail__label">完成后</text>
                <text class="coach-loop-detail__copy">{{view.loop.feedbackPromise}}</text>
              </view>
            </view>
            <button
              hover-class="item--hover"
              class="primary-button {{!item.canOpen ? 'primary-button--disabled' : ''}}"
              data-id="{{item.id}}"
              disabled="{{!item.canOpen}}"
              bindtap="openTask"
            >
              <image class="icon icon--play" src="/assets/icons/today/play-white.png" mode="aspectFit" />
              <text>{{taskOpeningId === item.id ? '正在打开…' : item.status === 'in_progress' ? '继续第一项任务' : '开始第一项任务'}}</text>
            </button>
            <view wx:if="{{!item.canOpen}}" class="task-disabled">{{item.disabledReason}}</view>
          </view>

          <view class="anan-insight">
            <view class="anan-icon">
              <image class="icon icon--sparkles" src="/assets/icons/today/sparkles-white.png" mode="aspectFit" />
            </view>
            <view class="anan-insight__main">
              <view class="anan-insight__heading">
                <text class="anan-insight__title">岸岸建议</text>
                <text class="anan-insight__status">{{view.loop.recognitionLabel}}</text>
              </view>
              <view class="anan-insight__phase">{{view.loop.statusLabel}}</view>
              <view class="coach-statement">
                <view class="coach-statement__label">我观察到</view>
                <view class="anan-insight__copy">{{view.loop.observation}}</view>
              </view>
              <view class="coach-statement coach-statement--judgment">
                <view class="coach-statement__label">暂时判断</view>
                <view class="anan-insight__copy">{{view.loop.judgment}}</view>
              </view>
              <button
                wx:if="{{view.loop.recognitionLevel === 'just_met'}}"
                hover-class="item--hover"
                class="recognition-accelerator"
                bindtap="openRecognitionOptions"
              >
                <view>
                  <view class="recognition-accelerator__title">有成绩单或错题？</view>
                  <view class="recognition-accelerator__copy">可选 · 让岸岸更快认识你</view>
                </view>
                <text class="recognition-accelerator__arrow">→</text>
              </button>
              <view wx:if="{{insightExpanded}}" class="anan-insight__detail">
                <view class="coach-detail-row">
                  <text class="coach-detail-row__label">为什么今天先做这个</text>
                  <text class="coach-detail-row__copy">{{view.loop.why}}</text>
                </view>
                <view class="coach-detail-row">
                  <text class="coach-detail-row__label">怎么验证</text>
                  <text class="coach-detail-row__copy">{{view.loop.verification}}</text>
                </view>
                <view class="coach-detail-row">
                  <text class="coach-detail-row__label">判断错了</text>
                  <text class="coach-detail-row__copy">{{view.loop.correction}}</text>
                </view>
              </view>
              <button hover-class="item--hover" class="insight-toggle" bindtap="toggleInsight">
                <text>{{insightExpanded ? '收起判断依据' : '看岸岸怎么验证这个判断'}}</text>
                <image class="icon icon--chevron {{insightExpanded ? 'icon--rotated' : ''}}" src="/assets/icons/today/chevron-down-muted.png" mode="aspectFit" />
              </button>

              <view wx:if="{{view.loop.candidate}}" class="coach-candidate">
                <view class="coach-candidate__eyebrow">等待你确认 · 确认前不改变计划</view>
                <view class="coach-candidate__title">{{view.loop.candidate.title}}</view>
                <view class="coach-candidate__copy">{{view.loop.candidate.rationale}}</view>
                <view class="coach-candidate__actions">
                  <button hover-class="item--hover" class="coach-candidate__reject control-center" data-action="reject" disabled="{{coachDecisionSubmitting}}" bindtap="decideCoachSuggestion">不像我</button>
                  <button hover-class="item--hover" class="coach-candidate__confirm control-center" data-action="confirm" loading="{{coachDecisionSubmitting}}" bindtap="decideCoachSuggestion">按这个方向练</button>
                </view>
              </view>
              <view wx:if="{{coachDecisionMessage}}" class="coach-decision-message">{{coachDecisionMessage}}</view>

              <view wx:if="{{view.loop.feedback}}" class="coach-return-feedback">
                <view class="coach-return-feedback__title">{{view.loop.feedback.title}}</view>
                <view wx:for="{{view.loop.feedback.changes}}" wx:key="*this" class="coach-return-feedback__change">{{item}}</view>
                <view class="coach-return-feedback__next">{{view.loop.feedback.nextAction}}</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view class="other-tasks">
        <view wx:if="{{view.hiddenCompletedCount > 0}}" class="completed-task">
          <image class="icon icon--completed" src="/assets/icons/today/circle-check-muted.png" mode="aspectFit" />
          <view class="completed-task__title">{{view.hiddenCompletedLabel}}</view>
          <button hover-class="item--hover" class="completed-task__action" bindtap="openDailySettlement">查看记录</button>
        </view>
        <block wx:for="{{view.secondaryTasks}}" wx:key="id">
          <view class="compact-task">
            <view class="compact-task__main">
              <view class="compact-task__icon">
                <image class="icon icon--small" src="/assets/icons/today/file-text-secondary.png" mode="aspectFit" />
              </view>
              <view>
                <view class="compact-task__title">{{item.title}}</view>
                <view class="compact-task__meta">{{item.queueMetaLabel}}</view>
              </view>
            </view>
            <button
              hover-class="item--hover"
              class="compact-task__action"
              data-id="{{item.id}}"
              disabled="{{!item.canOpen}}"
              bindtap="openTask"
            >{{item.queueActionLabel}}</button>
          </view>
        </block>
        <block wx:for="{{view.completedTasks}}" wx:key="id">
          <view class="completed-task">
            <image class="icon icon--completed" src="/assets/icons/today/circle-check-muted.png" mode="aspectFit" />
            <view class="completed-task__title">{{item.title}}</view>
            <button hover-class="item--hover" class="completed-task__action" bindtap="openDailySettlement">查看复盘</button>
          </view>
        </block>
      </view>
      <view wx:if="{{taskNavigationError}}" class="task-error">{{taskNavigationError}}</view>
      </view>

      <view class="track-section today-col--track">
        <view class="track-section__head">
          <view class="track-section__title">双轨进度</view>
          <view class="track-section__note">行测与申论每天都保留状态</view>
        </view>
        <view class="track-grid">
          <button
            wx:for="{{view.trackViews}}"
            wx:key="track"
            hover-class="item--hover"
            class="track-card track-card--{{item.tone}}"
            data-track="{{item.track}}"
            data-task-id="{{item.taskId}}"
            bindtap="openTrack"
          >
            <view class="track-card__top">
              <view class="track-card__name">{{item.label}}</view>
              <view class="track-card__status"></view>
            </view>
            <view class="track-card__summary">{{item.summary}}</view>
            <view class="track-card__detail">{{item.detail}}</view>
            <view class="track-card__action">{{item.actionLabel}} →</view>
          </button>
        </view>
      </view>

      <view class="today-col today-col--side-b">
      <view class="secondary-tools">
        <view class="secondary-tools__head">
          <view class="secondary-tools__title">学习工具</view>
          <view class="secondary-tools__meta">加练 · 复盘 · 计划</view>
        </view>
        <button hover-class="item--hover" class="mock-entry" bindtap="openMockExam">
          <view class="mock-entry__icon">
            <image class="icon icon--small" src="/assets/icons/task/clock.svg" mode="aspectFit" />
          </view>
          <view class="mock-entry__body">
            <view class="mock-entry__eyebrow">完整校准</view>
            <view class="mock-entry__title">整卷模考</view>
            <view class="mock-entry__meta">135 题 · 120 分钟</view>
          </view>
          <view class="mock-entry__action">进入模考 →</view>
        </button>

        <button hover-class="item--hover" class="settlement-button {{view.hasExecutionActivity ? '' : 'settlement-button--quiet'}}" bindtap="openDailySettlement">
          <image class="icon icon--settlement" src="/assets/icons/today/circle-check-secondary.png" mode="aspectFit" />
          <text>{{view.hasExecutionActivity ? '结束今天并复盘' : '记录今天'}}</text>
        </button>

        <view class="tool-row">
          <button hover-class="item--hover" class="tool-link" bindtap="openQuestionBookImport">
            <image class="icon icon--small" src="/assets/icons/today/file-text-secondary.png" mode="aspectFit" />
            <text>我想加练</text>
          </button>
          <button hover-class="item--hover" class="tool-link" bindtap="openPlanBasis">
            <image class="icon icon--small" src="/assets/icons/today/target-muted.png" mode="aspectFit" />
            <text>计划依据</text>
          </button>
          <button hover-class="item--hover" class="tool-link" bindtap="openWeeklyPlan">
            <image class="icon icon--small" src="/assets/icons/today/calendar-days-secondary.png" mode="aspectFit" />
            <text>周计划</text>
          </button>
        </view>
      </view>
      </view>
    </block>
  </view>
</view>
