<view class="page ability">
  <view class="statusbar" />

  <block wx:if="{{loading}}">
    <view class="skeleton-card" />
    <view class="skeleton-card" />
  </block>

  <block wx:else>
    <text class="page-title h1">我的能力</text>

    <!-- 总估分 + 置信 -->
    <view class="overall card">
      <view class="overall-top">
        <view>
          <text class="text-3">行测综合估分</text>
          <view class="overall-score">
            <text class="overall-num num">{{est.xingceScore === null ? '--' : est.xingceScore}}</text>
            <text class="overall-unit">分</text>
          </view>
        </view>
        <view class="confidence-pill conf-{{est.confidence}}">
          <text class="conf-label">置信度</text>
          <text class="conf-value">{{confidenceLabel}}</text>
        </view>
      </view>
      <text class="overall-dataline">{{est.dataLine}}</text>
      <text wx:if="{{est.latestMockReason}}" class="overall-reason text-3">{{est.latestMockReason}}</text>
      <button class="btn btn-primary overall-cta" bindtap="onGoMock">做一次限时模考，收窄区间</button>
    </view>

    <!-- 能力地形：模块条 + 不确定带 -->
    <view class="section-title">
      <text class="h2">能力地形</text>
      <text class="text-3">灰色区间 = 数据还不够确定的范围</text>
    </view>
    <view class="card terrain">
      <view wx:for="{{modulesView}}" wx:key="moduleName" class="module">
        <view class="module-head">
          <text class="module-name">{{item.moduleName}}</text>
          <view class="module-meta">
            <text class="module-src text-3">{{item.sourceLabel}} · {{item.sampleSize}}题</text>
            <text class="module-acc num">{{item.accuracyPct}}%</text>
          </view>
        </view>
        <view class="bar">
          <!-- 不确定带 -->
          <view class="bar-band" style="left:{{item.bandLeft}}%;width:{{item.bandWidth}}%;" />
          <!-- 估计点 -->
          <view class="bar-point" style="left:{{item.accuracyPct}}%;" />
        </view>
        <text wx:if="{{item.shaky}}" class="module-hint text-3">样本较少，多做几题这个数才准</text>
      </view>
    </view>

    <!-- 知识卡广场入口 -->
    <view class="community card" bindtap="onGoCommunity">
      <view class="community-body">
        <text class="community-title">知识卡广场</text>
        <text class="text-3">看看其他考友怎么攻克这些薄弱模块</text>
      </view>
      <text class="community-arrow">›</text>
    </view>

    <!-- 报告下钻 -->
    <view class="section-title"><text class="h2">深入看看</text></view>
    <view class="card reports">
      <view
        wx:for="{{reports}}"
        wx:key="key"
        class="report-row {{index < reports.length - 1 ? 'report-border' : ''}}"
        data-url="{{item.url}}"
        bindtap="onOpenReport"
      >
        <view class="report-body">
          <text class="report-title">{{item.title}}</text>
          <text class="text-3">{{item.subtitle}}</text>
        </view>
        <text class="report-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示数据（后端未连接）</view>
  </block>
</view>
