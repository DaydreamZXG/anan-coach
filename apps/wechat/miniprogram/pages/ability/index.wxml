<view class="ability-page">
  <safe-top mode="status" gap="52" />

  <view class="ability-content">
    <view class="ability-header">
      <view class="ability-title">能力</view>
      <view class="ability-subtitle">知道现在在哪，才知道下一步往哪走</view>
      <view wx:if="{{updatedLabel}}" class="ability-updated">{{updatedLabel}} 更新 · 已参考 {{evidenceCountLabel}} 条学习记录</view>
    </view>

    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="学习档案没有加载成功"
      description="{{errorMessage}}"
      request-id="{{requestId}}"
      action-text="重新加载"
      bind:action="retry"
    />

    <block wx:elif="{{profile}}">
      <view class="ability-card goal-card">
        <view class="card-heading">
          <view class="card-heading__main">
            <text class="card-title">目标对照</text>
            <text class="goal-name">· {{goalName}}</text>
          </view>
          <button hover-class="item--hover" class="text-action" bindtap="openPositionWorkspace">
            <text>查看怎么算的</text>
            <image class="icon icon--chevron" src="/assets/icons/ability/chevron-right-muted.png" mode="aspectFit" />
          </button>
        </view>
        <view class="goal-metrics">
          <view class="goal-metric">
            <view class="metric-label">能力估计</view>
            <view class="metric-value type-data">{{currentScoreLabel}}</view>
          </view>
          <view class="goal-metric">
            <view class="metric-label">岗位备考参考线</view>
            <view class="metric-value type-data">{{targetScoreLabel}}</view>
          </view>
          <view class="goal-metric">
            <view class="metric-label">当前差距</view>
            <view class="metric-value type-data">{{scoreGapLabel}}</view>
          </view>
        </view>
        <view class="goal-boundary {{goalAvailable ? '' : 'goal-boundary--pending'}}">{{goalBoundaryLabel}}</view>
      </view>

      <view class="ability-card overview-card">
        <view class="card-heading">
          <view class="card-title">当前能力总览</view>
          <view class="status-chip">{{profileReadinessLabel}}</view>
        </view>
        <view class="overview-row">
          <view class="overview-total">
            <view class="metric-label">综合区间</view>
            <view class="overview-total__value type-data">{{totalScoreLabel}}</view>
          </view>
          <view class="overview-scores">
            <view class="overview-score">
              <view class="metric-label">行测</view>
              <view class="overview-score__value type-data">{{xingceScoreLabel}}</view>
            </view>
            <view class="overview-score">
              <view class="metric-label">申论</view>
              <view class="overview-score__value type-data">{{essayScoreLabel}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="subject-tabs">
        <button hover-class="item--hover" class="subject-tab {{subjectTab === 'xingce' ? 'subject-tab--active' : ''}}" data-value="xingce" bindtap="chooseSubject">行测</button>
        <button hover-class="item--hover" class="subject-tab {{subjectTab === 'essay' ? 'subject-tab--active' : ''}}" data-value="essay" bindtap="chooseSubject">申论</button>
      </view>

      <block wx:if="{{subjectTab === 'xingce'}}">
        <view class="ability-card radar-card">
          <view class="radar-head">
            <view class="radar-title">行测模块状态</view>
            <view class="radar-note">综合正确率、用时、稳定掌握和复测表现，不等同于卷面分。</view>
          </view>
          <ability-radar wx:if="{{radarPoints.length >= 3}}" points="{{radarPoints}}" />
          <view wx:else class="ability-empty">至少三个模块产生真实作答记录后，才会形成分布图。</view>
          <view wx:if="{{xingceModules.length}}" class="radar-summary">模块状态来自真实作答、用时与间隔复测记录。</view>
        </view>

        <view class="module-list">
          <button
            wx:for="{{xingceModules}}"
            wx:key="moduleKey"
            hover-class="item--hover"
            class="module-row"
            data-track="{{item.track}}"
            data-key="{{item.moduleKey}}"
            bindtap="openModule"
          >
            <text class="module-name">{{item.displayName}}</text>
            <view class="module-side">
              <text class="module-metric">{{item.metricLabel}}</text>
              <text class="module-state module-state--{{item.statusTone}}">{{item.readinessLabel}}</text>
            </view>
          </button>
          <view wx:if="{{!xingceModules.length}}" class="ability-card ability-empty">完成真实行测作答后，这里会按六个考试模块形成画像。</view>
        </view>
      </block>

      <block wx:else>
        <view class="module-list essay-module-list">
          <button
            wx:for="{{essayModules}}"
            wx:key="moduleKey"
            hover-class="item--hover"
            class="module-row essay-module-row"
            data-track="{{item.track}}"
            data-key="{{item.moduleKey}}"
            bindtap="openModule"
          >
            <view>
              <view class="module-name">{{item.displayName}}</view>
              <view class="essay-evidence">已有效作答 {{item.evidenceCount}} 次</view>
            </view>
            <view class="module-side">
              <text wx:if="{{item.dueCount}}" class="verify-chip">需再次验证</text>
              <text class="module-state module-state--{{item.statusTone}}">{{item.readinessLabel}}</text>
            </view>
          </button>
          <view wx:if="{{!essayModules.length}}" class="ability-card ability-empty">完成真实申论作答和改写后，这里会形成模块画像。</view>
        </view>
      </block>

      <view class="patterns-section">
        <view class="patterns-title">最近反复出现的问题</view>
        <view class="pattern-list">
          <button
            wx:for="{{profile.errorPatterns}}"
            wx:key="patternId"
            hover-class="item--hover"
            class="pattern-card"
            data-id="{{item.patternId}}"
            bindtap="openPattern"
          >
            <view class="pattern-name">{{item.displayName}}</view>
            <view class="pattern-meta">
              <view class="pattern-pills">
                <text class="pattern-pill">出现 {{item.occurrenceCount}} 次</text>
                <text wx:if="{{item.counterevidenceCount}}" class="pattern-pill">有相反表现</text>
              </view>
              <text class="pattern-next">查看与复测</text>
            </view>
          </button>
          <view wx:if="{{!profile.errorPatterns.length}}" class="ability-card ability-empty">完成错题复盘并确认原因后，这里才会沉淀可复测的问题。</view>
        </view>
      </view>

      <view wx:if="{{profile.decisionSummary.reviewDueCount}}" class="review-warning">
        {{profile.decisionSummary.reviewDueCount}} 个学习取舍已经到复评时间，需要重新确认。
      </view>

      <view class="ability-card coach-action">
        <view class="coach-action__aurora"></view>
        <view class="coach-action__content">
          <view class="coach-action__heading">
            <image class="icon icon--sparkles" src="/assets/icons/ability/sparkles-indigo.png" mode="aspectFit" />
            <view class="coach-action__title">岸岸行动建议</view>
          </view>
          <view class="coach-action__copy">目前最值得优先修复的模块已在上方标出。需要岸岸结合今天的安排解释一下吗？</view>
          <button hover-class="item--hover" class="coach-action__button" bindtap="openCompanion">带着当前能力问岸岸</button>
        </view>
      </view>
    </block>
  </view>
</view>
