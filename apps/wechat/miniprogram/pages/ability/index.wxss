.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

/* 浅色系导航 */
.nav {
  padding: 0 32rpx 24rpx;
  background: var(--bg);
}

.nav__title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding-top: 20rpx;
}

.nav__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 估分卡 */
.score {
  margin: 8rpx 32rpx 0;
  padding: 34rpx;
  border-radius: var(--r-lg);
}

.score__cap {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: var(--ink-3);
}

.score__line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 16rpx;
}

.score__num {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1;
}

.score__unit {
  font-size: 26rpx;
  color: var(--ink-3);
}

.score__tag {
  margin-left: 8rpx;
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
}

.score__tag--high {
  color: var(--green);
  border-color: rgba(13, 159, 110, 0.4);
  background: rgba(13, 159, 110, 0.08);
}

.score__tag--medium {
  color: var(--cyan);
  border-color: rgba(14, 185, 206, 0.4);
  background: rgba(14, 185, 206, 0.08);
}

.score__tag--low,
.score__tag--unavailable {
  color: var(--amber);
  border-color: rgba(217, 127, 6, 0.4);
  background: rgba(217, 127, 6, 0.08);
}

.score__empty-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.score__empty-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}

.score__dataline {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 六模块 */
.section {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.modules {
  padding: 8rpx 28rpx;
}

.module {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.module:last-child {
  border-bottom: none;
}

.module__name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.module__bar {
  flex: 1;
  height: 16rpx;
  background: rgba(16, 19, 27, 0.06);
  border-radius: 999rpx;
  overflow: hidden;
}

.module__fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--grad-main);
}

.module__val {
  width: 72rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
}

.module__pct {
  font-size: 18rpx;
  color: var(--ink-3);
  font-weight: 400;
}

.module__sample {
  width: 84rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 20rpx;
  color: var(--ink-3);
}

.foot-note {
  margin-top: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}

.demo-badge {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  z-index: 10;
  font-size: 20rpx;
  color: var(--amber);
  background: rgba(217, 127, 6, 0.1);
  border: 1rpx solid rgba(217, 127, 6, 0.4);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
