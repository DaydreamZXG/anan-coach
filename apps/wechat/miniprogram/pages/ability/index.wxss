.ability-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.ability-content {
  display: flex;
  box-sizing: border-box;
  min-height: calc(100vh - 64px);
  flex-direction: column;
  gap: 48rpx;
  padding: 0 var(--figma-page-inset)
    calc(
      var(--figma-bottom-navigation-height) + var(--figma-space-32) +
        env(safe-area-inset-bottom)
    );
}

.card-heading,
.card-heading__main,
.text-action,
.goal-metrics,
.overview-row,
.overview-scores,
.module-row,
.module-side,
.pattern-meta,
.pattern-pills,
.coach-action__heading {
  display: flex;
  align-items: center;
}

.ability-title {
  color: var(--ink);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.4;
}

.ability-subtitle {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 500;
}

.ability-updated {
  margin-top: 24rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
}

.ability-card {
  box-sizing: border-box;
  flex: none;
  padding: 48rpx;
  border-radius: 64rpx;
  background: var(--color-surface);
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.04);
}

.card-heading {
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.card-heading__main {
  min-width: 0;
  gap: 16rpx;
}

.card-title {
  flex: none;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.goal-name {
  max-width: 240rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-action {
  width: auto;
  flex: none;
  gap: 2rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 500;
}

.icon { display: block; flex: none; }
.icon--chevron { width: 24rpx; height: 24rpx; }
.icon--sparkles { width: 32rpx; height: 32rpx; }

.goal-metrics {
  gap: 16rpx;
}

.goal-metric {
  min-width: 0;
  flex: 1;
  padding: 24rpx 2rpx;
  border-radius: 32rpx;
  background: var(--bg);
  text-align: center;
}

.metric-label {
  overflow: hidden;
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-value {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-boundary {
  margin-top: 32rpx;
  color: var(--ink-3);
  font-size: 20rpx;
  text-align: center;
}

.goal-boundary--pending { color: var(--figma-color-warning); }

.overview-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.overview-card .card-heading { margin-bottom: 0; }

.status-chip {
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
}

.overview-row {
  align-items: flex-end;
  gap: 48rpx;
  margin-top: 8rpx;
}

.overview-total {
  position: relative;
}

.overview-total::before {
  position: absolute;
  background: linear-gradient(90deg, var(--primary), var(--color-ai-violet));
  filter: blur(40rpx);
  opacity: 0.15;
  content: "";
  inset: 0;
}

.overview-total__value {
  position: relative;
  margin-top: 2rpx;
  /* Approved Figma ability-range gradient; this is the sole page-level color exception. */
  background: linear-gradient(90deg, #4f39f6, #9810fa);
  background-clip: text;
  color: transparent;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  -webkit-background-clip: text;
}

.overview-scores {
  align-items: flex-end;
  gap: 40rpx;
  padding-bottom: 12rpx;
}

.overview-score__value {
  margin-top: 2rpx;
  color: var(--color-ink-secondary);
  font-size: 32rpx;
  font-weight: 700;
}

.subject-tabs {
  display: flex;
  width: 320rpx;
  flex: none;
  gap: 16rpx;
  margin: 16rpx auto 0;
  padding: 8rpx;
  border-radius: 32rpx;
  background: rgba(243, 244, 246, 0.5);
}

.subject-tab {
  min-height: 52rpx;
  flex: 1;
  border-radius: 24rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 700;
}

.subject-tab--active {
  background: var(--color-surface);
  color: var(--ink);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.radar-head { margin-bottom: 32rpx; }

.radar-title {
  margin-bottom: 2rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.radar-note {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 500;
}

.radar-summary {
  margin-top: 16rpx;
  padding: 0 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.625;
  text-align: center;
}

.module-list,
.pattern-list {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: 24rpx;
}

.module-row {
  width: 100%;
  min-height: 104rpx;
  justify-content: space-between;
  gap: 20rpx;
  padding: 32rpx 40rpx;
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
  text-align: left;
}

.module-name {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.module-side {
  min-width: 0;
  justify-content: flex-end;
  gap: 24rpx;
}

.module-metric {
  max-width: 230rpx;
  overflow: hidden;
  color: var(--color-ink-secondary);
  font-size: 26rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.module-state,
.verify-chip {
  flex: none;
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--line);
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
}

.module-state--primary { background: var(--primary-soft); color: var(--primary); }
.module-state--warning { background: var(--figma-color-warning-soft); color: var(--figma-color-warning); }
.verify-chip { background: var(--color-danger-soft); color: var(--danger); }

.essay-module-list { margin-top: 0; }
.essay-module-row { min-height: 112rpx; }

.essay-evidence {
  margin-top: 2rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 500;
}

.patterns-section {
  flex: none;
  margin-top: 16rpx;
}

.patterns-title {
  margin: 0 0 32rpx 8rpx;
  color: var(--ink);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.pattern-card {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx;
  border-radius: 48rpx;
  background: var(--color-surface);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
  text-align: left;
}

.pattern-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.625;
}

.pattern-meta {
  justify-content: space-between;
  gap: 16rpx;
}

.pattern-pills { gap: 16rpx; }

.pattern-pill {
  padding: 4rpx 16rpx;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 500;
}

.pattern-next {
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
}

.ability-empty {
  padding: 54rpx 30rpx;
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.review-warning {
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: 21rpx;
  line-height: 1.55;
}

.coach-action {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(238, 242, 255, 0.5);
}

.coach-action__aurora {
  position: absolute;
  background: linear-gradient(135deg, var(--primary), var(--color-ai-violet) 52%, var(--color-ai-pink));
  opacity: 0.02;
  inset: 0;
}

.coach-action__content { position: relative; z-index: 1; }

.coach-action__heading {
  gap: 16rpx;
}

.coach-action__title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
}

.coach-action__copy {
  margin-top: 32rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.625;
}

.coach-action__button {
  width: 100%;
  min-height: 72rpx;
  margin-top: 32rpx;
  border: 1rpx solid var(--primary-soft);
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 700;
}

@media (min-width: 768px) {
  .ability-content {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
  }
}
