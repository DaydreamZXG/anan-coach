.statusbar { height: calc(env(safe-area-inset-top, 40rpx) + 24rpx); }
.page-title { display: block; margin: 8rpx 0 28rpx; }

/* 总估分 */
.overall { margin-bottom: 32rpx; }
.overall-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.overall-score { display: flex; align-items: baseline; gap: 6rpx; margin-top: 6rpx; }
.overall-num { font-size: 76rpx; font-weight: 700; color: var(--primary); line-height: 1; }
.overall-unit { font-size: 28rpx; color: var(--ink-2); }
.confidence-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
}
.conf-label { font-size: 22rpx; color: var(--ink-3); }
.conf-value { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.conf-high { background: var(--good-soft); }
.conf-high .conf-value { color: var(--good); }
.conf-low { background: #fdecec; }
.conf-low .conf-value { color: var(--danger); }
.conf-unavailable .conf-value { color: var(--ink-3); }
.overall-dataline {
  display: block;
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.overall-reason { display: block; margin-bottom: 24rpx; }
.overall-cta { width: 100%; }

/* 分区标题 */
.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 16rpx;
  gap: 16rpx;
}

/* 能力地形 */
.terrain { margin-bottom: 32rpx; }
.module { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.module:last-child { border-bottom: none; padding-bottom: 4rpx; }
.module:first-child { padding-top: 4rpx; }
.module-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.module-name { font-size: 30rpx; font-weight: 600; }
.module-meta { display: flex; align-items: baseline; gap: 16rpx; }
.module-acc { font-size: 30rpx; font-weight: 700; color: var(--primary); }
.bar {
  position: relative;
  height: 16rpx;
  background: var(--bg);
  border-radius: 999rpx;
}
.bar-band {
  position: absolute;
  top: 0;
  height: 16rpx;
  background: #d7dde5;
  border-radius: 999rpx;
}
.bar-point {
  position: absolute;
  top: -6rpx;
  width: 28rpx;
  height: 28rpx;
  margin-left: -14rpx;
  background: var(--primary);
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
}
.module-hint { display: block; margin-top: 12rpx; color: #c98a3f; }

/* 知识卡广场 */
.community {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}
.community-body { display: flex; flex-direction: column; gap: 6rpx; }
.community-title { font-size: 32rpx; font-weight: 600; }
.community-arrow { font-size: 44rpx; color: var(--ink-3); }

/* 报告 */
.reports { padding: 0 28rpx; }
.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}
.report-border { border-bottom: 1rpx solid var(--line); }
.report-body { display: flex; flex-direction: column; gap: 4rpx; }
.report-title { font-size: 30rpx; font-weight: 600; }
.report-arrow { font-size: 40rpx; color: var(--ink-3); }

.demo-tip { text-align: center; margin-top: 24rpx; }
.skeleton-card { height: 280rpx; border-radius: var(--radius); background: #eef0f3; margin-bottom: 24rpx; }
