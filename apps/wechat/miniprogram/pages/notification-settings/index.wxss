.coach-settings-page {
  padding-bottom: calc(108 * var(--rpx));
}
.coach-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(2 * var(--rpx)) calc(8 * var(--rpx));
}
.coach-hero__copy {
  min-width: 0;
}
.coach-hero .s9-title {
  margin-top: calc(8 * var(--rpx));
  font-size: var(--text-title);
}
.coach-hero .s9-subtitle {
  max-width: calc(560 * var(--rpx));
}
.coach-state {
  display: block;
  margin-top: calc(32 * var(--rpx));
}
.master-card {
  margin-top: calc(28 * var(--rpx));
}
.setting-row,
.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  min-height: calc(104 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--color-line);
  background: var(--color-surface);
}
.setting-row--top {
  min-height: calc(92 * var(--rpx));
  padding: 0;
  border: 0;
  background: transparent;
}
.setting-row:last-child,
.history-row:last-child {
  border-bottom: 0;
}
.setting-copy {
  min-width: 0;
}
.setting-title {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 800;
}
.setting-description {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.45;
}
.timing-card {
  padding-bottom: calc(28 * var(--rpx));
}
.time-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
}
.time-field {
  padding: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: rgba(244, 248, 247, 0.82);
}
.time-label {
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.time-value {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.limit-row,
.quiet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}
.limit-input {
  box-sizing: border-box;
  width: calc(100 * var(--rpx));
  height: calc(72 * var(--rpx));
  padding: 0 calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-16);
  background: var(--color-surface);
  text-align: center;
}
.quiet-head {
  padding-top: calc(24 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--color-line);
}
.quiet-grid {
  margin-top: calc(20 * var(--rpx));
}
.save-button {
  margin-top: calc(28 * var(--rpx));
}
.grant-status {
  display: flex;
  align-items: center;
  gap: calc(20 * var(--rpx));
}
.grant-count {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(76 * var(--rpx));
  height: calc(76 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-ink);
  font-size: var(--text-title-sm);
  font-weight: 800;
}
.grant-last {
  margin: calc(20 * var(--rpx)) 0 calc(24 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
}
.wechat-setting-button {
  margin-top: calc(16 * var(--rpx));
}
.template-blocked {
  padding: calc(8 * var(--rpx)) 0;
}
.history-state {
  flex: 0 0 auto;
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}
.fact-note {
  margin-top: calc(16 * var(--rpx));
  padding: 0 calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.coach-message {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.5;
}
.disable-button {
  margin-top: calc(28 * var(--rpx));
  padding: 0;
  background: transparent;
  color: var(--color-danger);
  font-size: var(--text-caption);
  font-weight: 800;
}
@media (min-width: 700px) {
  .coach-hero .s9-title {
    font-size: var(--text-title-lg);
  }
  .time-grid {
    gap: calc(20 * var(--rpx));
  }
}
