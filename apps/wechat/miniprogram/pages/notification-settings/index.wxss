.coach-settings-page {
  padding-bottom: 108rpx;
}
.coach-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 2rpx 8rpx;
}
.coach-hero__copy {
  min-width: 0;
}
.coach-hero .s9-title {
  margin-top: 8rpx;
  font-size: 40rpx;
}
.coach-hero .s9-subtitle {
  max-width: 560rpx;
}
.coach-state {
  display: block;
  margin-top: 30rpx;
}
.master-card {
  margin-top: 26rpx;
}
.setting-row,
.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--color-line);
  background: var(--color-surface);
}
.setting-row--top {
  min-height: 92rpx;
  padding: 0;
  border: 0;
  background: transparent;
}
.setting-row:last-child,
.history-row:last-child {
  border-bottom: 0;
}
.setting-copy {
  min-width: 0;
}
.setting-title {
  color: var(--color-ink);
  font-size: 25rpx;
  font-weight: 800;
}
.setting-description {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 21rpx;
  line-height: 1.45;
}
.timing-card {
  padding-bottom: 28rpx;
}
.time-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.time-field {
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 20rpx;
  background: rgba(244, 248, 247, 0.82);
}
.time-label {
  color: var(--color-muted);
  font-size: 20rpx;
}
.time-value {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 800;
}
.limit-row,
.quiet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}
.limit-input {
  box-sizing: border-box;
  width: 100rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-line-strong);
  border-radius: 18rpx;
  background: var(--color-surface);
  text-align: center;
}
.quiet-head {
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-line);
}
.quiet-grid {
  margin-top: 18rpx;
}
.save-button {
  margin-top: 28rpx;
}
.grant-status {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.grant-count {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 34rpx;
  font-weight: 900;
}
.grant-last {
  margin: 18rpx 0 22rpx;
  color: var(--color-ink-secondary);
  font-size: 22rpx;
}
.wechat-setting-button {
  margin-top: 14rpx;
}
.template-blocked {
  padding: 8rpx 0;
}
.history-state {
  flex: 0 0 auto;
  color: var(--color-primary-deep);
  font-size: 21rpx;
  font-weight: 750;
}
.fact-note {
  margin-top: 16rpx;
  padding: 0 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.55;
}
.coach-message {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: 22rpx;
  line-height: 1.5;
}
.disable-button {
  margin-top: 28rpx;
  padding: 0;
  background: transparent;
  color: var(--color-danger);
  font-size: 23rpx;
  font-weight: 800;
}
@media (min-width: 700px) {
  .coach-hero .s9-title {
    font-size: 44rpx;
  }
  .time-grid {
    gap: 20rpx;
  }
}
