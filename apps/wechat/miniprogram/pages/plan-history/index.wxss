.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.ph { display: flex; flex-direction: column; min-height: 100vh; }
.ph-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.ph-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.ph-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }
.ph-loading { padding: 120rpx 0; text-align: center; }
.ph-body { flex: 1; min-height: 0; }
.ph-empty { padding: 160rpx 32rpx; text-align: center; }
.ph-entry { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 20rpx; }
.ph-entry-head { display: flex; justify-content: space-between; align-items: center; }
.ph-date { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.ph-meta { display: flex; align-items: center; gap: 16rpx; }
.ph-mode {
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx; padding: 4rpx 16rpx;
}
.ph-mode.is-mock { color: #b45309; background: #fef3e2; }
.ph-mode.is-recovery { color: var(--good); background: var(--good-soft); }
.ph-mode.is-rest { color: var(--ink-3); background: var(--bg); }
.ph-headline { font-size: 28rpx; line-height: 1.6; color: var(--ink-2); }
.demo-tip { text-align: center; padding: 16rpx 0 calc(env(safe-area-inset-bottom) + 16rpx); }
