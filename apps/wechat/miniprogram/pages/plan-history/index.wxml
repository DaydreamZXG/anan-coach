<view class="page ph">
  <safe-top />
  <view class="ph-nav">
    <text class="ph-back" bindtap="onBack">‹</text>
    <text class="ph-title">计划历史</text>
  </view>

  <view wx:if="{{loading}}" class="ph-loading text-2">正在翻记录…</view>

  <scroll-view wx:else class="ph-body" scroll-y>
    <view class="ph-empty" wx:if="{{!entries.length}}">
      <text class="text-2">还没有历史记录，走过的每一天都会记在这里</text>
    </view>
    <view class="card ph-entry" wx:for="{{entries}}" wx:key="planVersionId">
      <view class="ph-entry-head">
        <text class="ph-date">{{item.dateLabel}}</text>
        <view class="ph-meta">
          <text class="ph-mode {{item.modeClass}}">{{item.modeLabel}}</text>
          <text class="text-3 num">{{item.minutes}} 分钟</text>
        </view>
      </view>
      <text class="ph-headline">{{item.headline}}</text>
    </view>
    <view wx:if="{{usingDemo}}" class="demo-tip text-3">演示记录（后端未连接）</view>
  </scroll-view>
</view>
