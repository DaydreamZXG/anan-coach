<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav__back" hover-class="is-pressed" bind:tap="onBack">‹</view>
    <view class="nav__text">
      <view class="nav__title">计划历史</view>
      <view class="nav__sub">每次调整都留痕，回头看变了什么、为什么</view>
    </view>
  </view>

  <state-view wx:if="{{viewState === 'loading'}}" type="loading" title="正在读取变更记录…" />
  <state-view
    wx:elif="{{viewState === 'error'}}"
    type="error"
    title="变更记录没有加载成功"
    desc="{{errorDesc}}"
    request-id="{{requestId}}"
    action-text="重新加载"
    bind:action="onRetry"
  />

  <block wx:else>
    <view wx:if="{{items.length === 0}}" class="empty">
      <view class="empty__glyph">·</view>
      <view class="empty__text">还没有计划。填完信息和可用时间，就给你排第一版。</view>
    </view>

    <view wx:for="{{items}}" wx:key="planVersionId" class="card entry">
      <view class="entry__row">
        <view class="entry__main">
          <view class="entry__tags">
            <view class="entry__pill">v{{item.versionNo}} · {{item.dayModeLabel}}</view>
          </view>
          <view class="entry__headline">{{item.headline}}</view>
        </view>
        <view class="entry__time">{{item.generatedLabel}}</view>
      </view>
      <view class="entry__metrics">
        <view class="entry__metric">
          <text class="entry__k">任务</text>
          <text class="entry__v">{{item.taskCount}}</text>
        </view>
        <view class="entry__metric">
          <text class="entry__k">分钟</text>
          <text class="entry__v">{{item.scheduledMinutes}}</text>
        </view>
      </view>
      <view class="entry__note">变更原因：{{item.reasonLabel}}</view>
      <view class="entry__note">变化输入：{{item.changedInputLabel}}</view>
    </view>
  </block>
</view>
