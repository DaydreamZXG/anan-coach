<view class="s9-page brain-page">
  <view class="brain-hero"><view class="brain-kicker">计划变更记录</view><view class="brain-title">每次变化，都能解释为什么</view><view class="brain-copy">计划的每次调整都留痕，回头看看变了什么。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="变更记录没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{status === 'ready'}}">
    <view wx:if="{{!items.length}}" class="brain-card brain-empty">还没有计划。填完信息和可用时间，就给你排第一版。</view>
    <view wx:for="{{items}}" wx:key="planVersionId" class="brain-card history-card">
      <view class="brain-row"><view><view class="brain-pill">{{item.editionLabel}} · {{item.dayModeLabel}}</view><view class="brain-value">{{item.headline}}</view></view><view class="brain-section-meta">{{item.generatedLabel}}</view></view>
      <view class="brain-grid"><view class="brain-metric"><view class="brain-label">任务</view><text class="brain-metric__value type-data">{{item.taskCount}}</text></view><view class="brain-metric"><view class="brain-label">学习时间</view><text class="brain-metric__value type-data">{{item.scheduledDurationLabel}}</text></view></view>
      <view class="brain-note">为什么调整：{{item.reasonLabel}}</view><view class="brain-note">本次变化：{{item.changedInputLabel}}</view>
    </view>
  </block>
</view>
