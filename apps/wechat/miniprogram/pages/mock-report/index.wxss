.statusbar { height: calc(env(safe-area-inset-top) + 24rpx); }
.mreport { display: flex; flex-direction: column; min-height: 100vh; }

.mr-nav { display: flex; align-items: center; gap: 20rpx; padding: 16rpx 8rpx; }
.mr-back { font-size: 56rpx; color: var(--ink-2); line-height: 1; padding: 0 16rpx; }
.mr-title { flex: 1; font-size: 32rpx; font-weight: 600; color: var(--ink); }

.mr-loading { padding: 120rpx 0; text-align: center; }
.mr-body { flex: 1; min-height: 0; }

.mr-score { display: flex; flex-direction: column; align-items: center; gap: 8rpx; margin-bottom: 24rpx; }
.mr-score-num { font-size: 96rpx; font-weight: 700; color: var(--primary); line-height: 1.2; }

.mr-section-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }

.mr-modules { display: flex; flex-direction: column; gap: 28rpx; margin-bottom: 24rpx; }
.mr-mod { display: flex; flex-direction: column; gap: 12rpx; }
.mr-mod-head { display: flex; justify-content: space-between; align-items: center; }
.mr-mod-name { font-size: 28rpx; color: var(--ink); }
.mr-mod-meta { display: flex; align-items: center; gap: 16rpx; }
.mr-change { font-size: 24rpx; color: var(--ink-3); }
.mr-change.is-up { color: var(--good); }
.mr-change.is-down { color: var(--danger); }
.mr-track { height: 12rpx; background: var(--bg); border-radius: 999rpx; overflow: hidden; }
.mr-fill { height: 100%; background: var(--primary); border-radius: 999rpx; }

.mr-clusters { display: flex; flex-direction: column; gap: 28rpx; margin-bottom: 24rpx; }
.mr-cluster { display: flex; flex-direction: column; gap: 10rpx; }
.mr-cluster-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.mr-cluster-path { flex: 1; font-size: 27rpx; color: var(--ink); }
.mr-wrong { font-size: 24rpx; color: var(--danger); flex-shrink: 0; }
.mr-fix { font-size: 26rpx; line-height: 1.6; color: var(--ink-2); }

.mr-anan {
  display: flex; gap: 20rpx; align-items: flex-start;
  background: var(--warm-soft);
  border: 1rpx solid #f1dcc6;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.anan-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--warm); color: #fff;
  font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mr-anan-text { flex: 1; font-size: 28rpx; line-height: 1.6; color: #5c4a35; }

.mr-foot { padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 24rpx); }
.mr-foot-btn { width: 100%; }

.demo-tip { text-align: center; padding-bottom: 16rpx; }
