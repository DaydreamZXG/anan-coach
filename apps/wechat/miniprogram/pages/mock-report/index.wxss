.page {
  min-height: 100vh;
  background: var(--bg);
}

.is-pressed {
  opacity: 0.75;
}

.foot-space {
  height: 120rpx;
}

/* ── 顶部导航 ── */
.nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 32rpx 22rpx;
}

.nav__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink-2);
  line-height: 1;
  flex-shrink: 0;
}

.nav__title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0.02em;
}

.nav__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ── 成绩 hero ── */
.hero {
  margin: 8rpx 32rpx 0;
  background: var(--grad-space);
  border-radius: var(--r-lg);
  padding: 40rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(16, 19, 27, 0.32);
}

.hero__cap {
  font-size: 20rpx;
  letter-spacing: 0.2em;
  color: rgba(255, 255, 255, 0.55);
}

.hero__pct {
  margin-top: 12rpx;
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.hero__pct-unit {
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 12rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero__range {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.hero__score {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.hero__hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* ── 正文 ── */
.body {
  padding: 32rpx 0 0;
}

.metric-note {
  margin: 0 32rpx 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.section-head {
  margin: 28rpx 32rpx 24rpx;
}

/* 模块表现 */
.mlist {
  margin: 0 32rpx;
  overflow: hidden;
}

.mrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.mrow:last-child {
  border-bottom: none;
}

.mrow__main {
  flex: 1;
  min-width: 0;
}

.mrow__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.mrow__data {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.mrow__side {
  flex-shrink: 0;
  text-align: right;
}

.mrow__acc {
  font-size: 32rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.mrow__change {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.mrow__change--up {
  color: var(--green);
}

.mrow__change--down {
  color: var(--red);
}

/* 错因聚类 */
.cluster {
  margin: 0 32rpx 20rpx;
  padding: 26rpx 28rpx;
}

.cluster__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cluster__path {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.cluster__count {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--red);
  background: rgba(224, 82, 82, 0.08);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.cluster__fix {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* 下周安排 */
.next {
  margin: 28rpx 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: var(--r-md);
  background: rgba(91, 95, 244, 0.06);
  border: 1rpx solid rgba(91, 95, 244, 0.18);
}

.next__title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--indigo);
}

.next__copy {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
}

/* 操作区 */
.actions {
  margin: 40rpx 32rpx 0;
}

.actions__gap {
  height: 20rpx;
}

/* ── 未交卷引导 ── */
.gate {
  padding: 40rpx 32rpx 0;
}

.gate__card {
  padding: 36rpx 32rpx;
}

.gate__mark {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(217, 127, 6, 0.12);
  color: var(--amber);
  font-size: 20rpx;
  font-weight: 700;
}

.gate__title {
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.gate__copy {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
}
