<task-shell
  title="{{capability ? capability.title : '申论任务'}}"
  modeLabel="{{capability ? capability.modeLabel : '申论 Agent'}}"
  current="{{hasSavedEvidence ? 1 : 0}}"
  total="1"
  elapsedLabel="{{elapsedLabel}}"
  syncLabel="{{reviewDisplay.state === 'waiting_quota' ? '答案已保存 · 等待额度' : reviewDisplay.state === 'queued' || reviewDisplay.state === 'running' ? '答案已保存 · 评阅中' : hasSavedEvidence ? '已保存真实版本' : submissionStatus === 'submitting' ? '正在写入版本' : '尚未保存本次修改'}}"
  materialAvailable="{{status === 'ready'}}"
  answerSheetAvailable="{{capability ? capability.stage === 'essay_drafting' : false}}"
  toolsAvailable="{{false}}"
  footerAvailable="{{status === 'ready' && canSubmit}}"
  bindexit="exit"
  bindmaterial="openMaterial"
  bindanswersheet="openAnswerSheet"
>
  <view wx:if="{{status === 'loading'}}" class="page-state">
    <state-view state="loading" />
  </view>

  <view wx:elif="{{status === 'error'}}" class="page-state">
    <state-view
      state="error"
      title="{{errorTitle}}"
      description="{{errorMessage}}"
      actionText="重新加载"
      bindaction="retry"
    />
  </view>

  <view wx:elif="{{status === 'unavailable'}}" class="page-state">
    <view class="capability-state card">
      <view class="capability-mark">证据能力门禁</view>
      <view class="capability-title">{{errorTitle}}</view>
      <view class="capability-copy">{{errorMessage}}</view>
      <button wx:if="{{showLoginAction}}" class="secondary-button capability-action" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <view wx:elif="{{status === 'ready' && workspace && view}}" class="essay-workspace {{draftLocked ? 'essay-workspace--locked' : ''}}">
    <view class="workspace-hero">
      <view class="hero-glow"></view>
      <view class="hero-eyebrow">申论学习工作台</view>
      <view class="hero-title">{{capability.title}}</view>
      <view class="hero-meta">
        <view class="hero-meta__item">{{view.questionTypeLabel}}</view>
        <view class="hero-meta__item"><text class="type-data">{{view.wordLimit}}</text> 字</view>
        <view class="hero-meta__item"><text class="type-data">{{view.maximumScore}}</text> 分</view>
      </view>
      <view class="hero-version">{{view.currentVersionLabel}}</view>
    </view>

    <scroll-view class="workbench-nav" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="workbench-nav-inner">
        <button wx:for="{{workbenchLinks}}" wx:key="url" class="workbench-nav-chip" data-url="{{item.url}}" bindtap="openWorkbench">{{item.label}}</button>
      </view>
    </scroll-view>

    <view class="rubric-note {{workspace.rubricAvailability.status === 'published' ? 'rubric-note--ready' : ''}}">
      <view class="rubric-note-title">{{view.rubricStatusLabel}}</view>
      <view class="rubric-note-copy">{{view.rubricStatusDetail}}</view>
    </view>

    <view class="essay-workbench-grid">
      <view class="essay-context-pane">
    <view class="section-heading">
      <view class="section-title">题干与要求</view>
      <view class="section-meta">作答约束</view>
    </view>
    <view class="prompt-card card">
      <view class="prompt-text">{{view.prompt}}</view>
      <view class="requirement-box">
        <view class="requirement-label">作答要求</view>
        <view>{{view.requirements}}</view>
      </view>
    </view>

    <view class="section-heading material-heading">
      <view>
        <view class="section-title">给定材料</view>
        <view class="section-meta material-source">{{view.materialSourceLabel}} · {{view.segments.length}} 段</view>
      </view>
    </view>
    <scroll-view class="material-directory" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="material-directory-inner">
        <button
          wx:for="{{view.directory}}"
          wx:key="materialOrder"
          class="directory-chip"
          data-anchor="{{item.firstAnchorId}}"
          bindtap="scrollToMaterial"
        >
          <text>{{item.label}}</text>
          <text class="directory-chip__count type-data">{{item.segmentCount}} 段</text>
        </button>
      </view>
    </scroll-view>

    <view class="material-paper">
      <view
        wx:for="{{view.segments}}"
        wx:key="segmentId"
        id="{{item.anchorId}}"
        class="material-segment"
      >
        <view class="segment-index type-data">{{index + 1}}</view>
        <view class="segment-body">
          <view class="segment-label">{{item.directoryLabel}} · {{item.paragraphLabel}}</view>
          <view class="segment-text">{{item.text}}</view>
        </view>
      </view>
    </view>
      </view>

      <view class="essay-action-pane">
    <view class="section-heading">
      <view>
        <view class="section-title">本阶段作业</view>
        <view class="section-meta form-evidence-label">提交后写入不可变学习版本</view>
      </view>
    </view>

    <view wx:if="{{blockingReason}}" class="blocking-note">
      <view class="blocking-title">当前阶段不可提交</view>
      <view class="blocking-note__copy">{{blockingReason}}</view>
    </view>

    <block wx:if="{{capability.stage === 'essay_material_reading'}}">
      <view class="form-card card">
        <view class="field-label">整组材料的核心主题</view>
        <textarea
          class="essay-textarea essay-textarea--compact"
          value="{{overallTheme}}"
          maxlength="1000"
          placeholder="用一句话说清整组材料围绕什么问题展开。"
          bindinput="inputOverallTheme"
        ></textarea>
      </view>
      <view wx:for="{{materialAnnotations}}" wx:key="segmentId" class="annotation-card card">
        <view class="form-index-row">
          <view class="form-index type-data">{{index + 1}}</view>
          <view>
            <view class="form-item-title">{{item.label}}</view>
            <view class="caption">与上方材料段落一一绑定</view>
          </view>
        </view>
        <view class="field-label">段落主旨</view>
        <textarea
          class="essay-textarea essay-textarea--compact"
          value="{{item.paragraphSummary}}"
          maxlength="500"
          data-index="{{index}}"
          data-field="paragraphSummary"
          placeholder="这一段在说什么？"
          bindinput="inputMaterialField"
        ></textarea>
        <view class="field-label">涉及对象 / 主体</view>
        <input
          class="essay-input"
          value="{{item.subjectsText}}"
          maxlength="200"
          data-index="{{index}}"
          data-field="subjectsText"
          placeholder="用顿号分隔，如：基层干部、群众"
          bindinput="inputMaterialField"
        />
        <view class="field-label">可引用原文 <text class="field-optional">选填</text></view>
        <textarea
          class="essay-textarea essay-textarea--quote"
          value="{{item.evidenceQuote}}"
          maxlength="500"
          data-index="{{index}}"
          data-field="evidenceQuote"
          placeholder="摘录最能支撑你判断的原文。"
          bindinput="inputMaterialField"
        ></textarea>
      </view>
    </block>

    <block wx:elif="{{capability.stage === 'essay_point_extraction'}}">
      <view wx:for="{{points}}" wx:key="pointId" class="point-card card">
        <view class="form-index-row">
          <view class="form-index type-data">{{index + 1}}</view>
          <view class="form-item-title">要点 {{index + 1}}</view>
          <button class="text-danger" data-index="{{index}}" bindtap="removePoint">删除</button>
        </view>
        <view class="field-label">要点类型</view>
        <picker
          range="{{pointCategoryLabels}}"
          value="{{item.categoryIndex}}"
          data-index="{{index}}"
          bindchange="changePointCategory"
        >
          <view class="essay-select">{{pointCategoryLabels[item.categoryIndex]}} <text>›</text></view>
        </picker>
        <view class="field-label">要点表达</view>
        <textarea
          class="essay-textarea essay-textarea--compact"
          value="{{item.statement}}"
          maxlength="1000"
          data-index="{{index}}"
          placeholder="压缩为可直接进入答案的规范表达。"
          bindinput="inputPointStatement"
        ></textarea>
        <view class="field-label">材料出处 <text class="field-hint">至少选 1 段</text></view>
        <checkbox-group data-index="{{index}}" bindchange="changePointSources">
          <label wx:for="{{item.sourceOptions}}" wx:for-item="segment" wx:key="segmentId" class="source-option">
            <checkbox value="{{segment.segmentId}}" checked="{{segment.checked}}" color="#00978B" />
            <view>
              <view class="source-label">{{segment.directoryLabel}} · {{segment.paragraphLabel}}</view>
              <view class="source-preview">{{segment.text}}</view>
            </view>
          </label>
        </checkbox-group>
      </view>
      <button class="secondary-button add-button" bindtap="addPoint">＋ 添加要点</button>
    </block>

    <block wx:elif="{{capability.stage === 'essay_outlining'}}">
      <view class="form-card card">
        <view class="field-label">总论点 <text class="field-optional">选填</text></view>
        <textarea
          class="essay-textarea essay-textarea--compact"
          value="{{thesis}}"
          maxlength="1000"
          placeholder="文章写作或综合分析题可先确定中心论点。"
          bindinput="inputThesis"
        ></textarea>
      </view>
      <view wx:for="{{outlineSections}}" wx:key="sectionId" class="outline-card card">
        <view class="form-index-row">
          <view class="form-index type-data">{{index + 1}}</view>
          <view class="form-item-title">段落 {{index + 1}}</view>
          <button class="text-danger" data-index="{{index}}" bindtap="removeOutlineSection">删除</button>
        </view>
        <view class="field-grid">
          <view>
            <view class="field-label">小标题 / 功能</view>
            <input class="essay-input" value="{{item.heading}}" maxlength="300" data-index="{{index}}" data-field="heading" placeholder="这一段承担什么功能" bindinput="inputOutlineField" />
          </view>
          <view class="planned-words">
            <view class="field-label">预计字数</view>
            <input class="essay-input type-data" type="number" value="{{item.plannedWordsText}}" data-index="{{index}}" data-field="plannedWordsText" placeholder="120" bindinput="inputOutlineField" />
          </view>
        </view>
        <view class="field-label">中心论述</view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{item.argument}}" maxlength="1000" data-index="{{index}}" data-field="argument" placeholder="写清这一段要论证的核心内容。" bindinput="inputOutlineField"></textarea>
        <view class="field-label">支撑要点 <text class="field-hint">至少选 1 个</text></view>
        <checkbox-group data-index="{{index}}" bindchange="changeOutlineSources">
          <label wx:for="{{item.pointOptions}}" wx:for-item="point" wx:key="pointId" class="point-option">
            <checkbox value="{{point.pointId}}" checked="{{point.checked}}" color="#00978B" />
            <view>{{point.label}}</view>
          </label>
        </checkbox-group>
      </view>
      <button class="secondary-button add-button" bindtap="addOutlineSection">＋ 添加段落</button>
    </block>

    <block wx:elif="{{capability.stage === 'essay_drafting'}}">
      <block wx:if="{{draftAvailable}}">
        <view class="drafting-guide card">
        <view class="review-guide-title drafting-guide__line">正式作答版本</view>
        <view class="drafting-guide__line">一次提交会在同一事务中写入作答、结构化复盘，并完成对应的今日申论任务。</view>
        <view class="drafting-guide__line">任一版本或证据不一致都会整笔回滚；提交成功后才会另行排队证据化 AI 评阅。</view>
        </view>

        <view class="drafting-card card">
        <view class="drafting-meta-grid">
          <view>
            <view class="field-label">作答场景</view>
            <picker range="{{sourceContextLabels}}" value="{{drafting.sourceContextIndex}}" bindchange="changeDraftingSourceContext">
              <view class="essay-select">{{sourceContextLabels[drafting.sourceContextIndex]}} <text>›</text></view>
            </picker>
          </view>
          <view>
            <view class="field-label">计时状态</view>
            <picker range="{{timedStatusLabels}}" value="{{drafting.timedStatusIndex}}" bindchange="changeDraftingTimedStatus">
              <view class="essay-select">{{timedStatusLabels[drafting.timedStatusIndex]}} <text>›</text></view>
            </picker>
          </view>
        </view>
        <view class="field-label">答案录入来源</view>
        <picker range="{{answerSourceTypeLabels}}" value="{{drafting.sourceTypeIndex}}" bindchange="changeDraftingSourceType">
          <view class="essay-select">{{answerSourceTypeLabels[drafting.sourceTypeIndex]}} <text>›</text></view>
        </picker>
        <view wx:if="{{drafting.sourceType === 'ocr_confirmed'}}" class="source-confirmation-note">
          OCR 必须由本页上传原图、逐段核对并确认；手工选择来源不能绕过证据校验。
        </view>
        <view wx:if="{{drafting.sourceType === 'ocr_confirmed'}}" class="handwriting-card">
          <view class="handwriting-title">手写答案识别</view>
          <view class="handwriting-actions">
            <button class="secondary-action handwriting-action" data-source="camera" bindtap="chooseHandwritingImage">拍照识别</button>
            <button class="secondary-action handwriting-action" data-source="album" bindtap="chooseHandwritingImage">选择原图</button>
          </view>
          <image wx:if="{{handwriting.localImagePath}}" class="handwriting-original" src="{{handwriting.localImagePath}}" mode="widthFix"></image>
          <view wx:if="{{handwriting.phase === 'uploading'}}" class="field-help">上传与识别 {{handwriting.progressPercent}}%</view>
          <view wx:if="{{handwriting.message}}" class="source-confirmation-note">{{handwriting.message}}</view>
          <view wx:for="{{handwriting.spans}}" wx:key="spanId" class="handwriting-span">
            <view class="handwriting-span-meta">第 {{item.box.pageNo}} 页 · 置信度 {{item.confidenceLabel}}</view>
            <textarea class="essay-textarea essay-textarea--compact" value="{{item.text}}" maxlength="10000" data-span-id="{{item.spanId}}" bindinput="inputHandwritingSpan"></textarea>
            <button class="span-confirm {{item.checked ? 'span-confirm--checked' : ''}}" data-span-id="{{item.spanId}}" bindtap="toggleHandwritingSpan">{{item.checked ? '已逐字核对' : '核对这一段'}}</button>
          </view>
          <button wx:if="{{handwriting.phase === 'review' || handwriting.phase === 'error'}}" class="primary-action" bindtap="confirmHandwriting">确认全部 OCR 文本</button>
        </view>
        <view wx:if="{{drafting.timedStatus === 'timed'}}">
          <view class="field-label">实际作答分钟 <text class="field-optional">选填</text></view>
          <input
            class="essay-input type-data"
            type="number"
            value="{{drafting.elapsedMinutesText}}"
            data-field="elapsedMinutesText"
            placeholder="纸笔作答请填；留空按本页计时"
            bindinput="inputDraftingField"
          />
          <view class="field-help">本页已计时 {{elapsedLabel}}</view>
        </view>
        </view>

        <view id="drafting-answer" class="drafting-card card">
        <view class="field-label">我的答案 <text class="field-hint">{{drafting.answerText.length}} / 10000</text></view>
        <textarea
          class="essay-textarea essay-answer-textarea"
          value="{{drafting.answerText}}"
          maxlength="10000"
          data-field="answerText"
          placeholder="按题干要求完成整篇答案。AI 只评阅这一个不可变答案版本。"
          bindinput="inputDraftingField"
        ></textarea>
        </view>

        <view class="drafting-card card">
        <view class="review-guide-title">作答过程快照</view>
        <view class="field-label">我是怎么找点的 <text class="field-optional">选填</text></view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{drafting.pointFindingText}}" maxlength="3000" data-field="pointFindingText" placeholder="哪些材料句被你当成要点，为什么？" bindinput="inputDraftingField"></textarea>
        <view class="field-label">我的结构 / 提纲 <text class="field-optional">选填</text></view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{drafting.outlineText}}" maxlength="3000" data-field="outlineText" placeholder="写下本次答案的层次安排。" bindinput="inputDraftingField"></textarea>
        </view>
      </block>
      <view wx:else class="saved-answer-note card">
        当前工作区已存在不可变答案版本。本页不会伪造恢复正文；你可以补齐结构化复盘，并用同一个原子命令确认该答案、复盘和计划任务。
      </view>

      <view class="drafting-card card">
        <view class="review-guide-title">即时结构化复盘</view>
        <view class="field-help">这部分会进入 AI 学习大脑，不是评阅后的标准答案总结。</view>
        <view class="field-label">我当时怎么想 <text class="field-hint">必填</text></view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{drafting.userThought}}" maxlength="3000" data-field="userThought" placeholder="记录真实判断、犹豫和取舍，不要事后改成标准答案。" bindinput="inputDraftingField"></textarea>
        <view class="field-label">主要问题来源 <text class="field-hint">至少选 1 项</text></view>
        <checkbox-group class="reflection-cause-grid" bindchange="changeReflectionCauses">
          <label wx:for="{{reflectionCauseOptions}}" wx:key="code" class="reflection-cause-option {{item.checked ? 'reflection-cause-option--checked' : ''}}">
            <checkbox value="{{item.code}}" checked="{{item.checked}}" color="#00978B" />
            <text>{{item.label}}</text>
          </label>
        </checkbox-group>
        <view class="field-label">下一次我具体改什么 <text class="field-hint">必填</text></view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{drafting.whatIWillChange}}" maxlength="3000" data-field="whatIWillChange" placeholder="写成可执行动作，例如：先归并同类事实，再写上位概念。" bindinput="inputDraftingField"></textarea>
        <view class="field-label">怎么验证改法有效 <text class="field-hint">必填</text></view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{drafting.verificationPlan}}" maxlength="2000" data-field="verificationPlan" placeholder="例如：下一道同题型逐点核对材料覆盖和概念层级。" bindinput="inputDraftingField"></textarea>

        <view class="voice-panel">
          <view class="voice-heading">
            <view>
              <view class="field-label voice-title">语音复盘 <text class="field-optional">选填</text></view>
              <view class="field-help">{{voiceSummary.segmentCountLabel}} · {{voiceSummary.totalSizeLabel}}，仅提交通过安全检查的服务端版本。</view>
            </view>
            <button wx:if="{{!voiceRecording}}" class="voice-button" disabled="{{!voiceSummary.canRecord}}" bindtap="startVoiceRecording">录一段</button>
            <button wx:else class="voice-button voice-button--recording" bindtap="stopVoiceRecording">结束录音</button>
          </view>
          <view wx:for="{{voiceSegmentViews}}" wx:key="segmentId" class="voice-segment voice-segment--{{item.stateTone}}">
            <view>
              <view class="voice-segment-title">{{item.sequenceLabel}} · {{item.durationLabel}} · {{item.sizeLabel}}</view>
              <view class="voice-state">{{item.stateLabel}}</view>
              <view wx:if="{{item.failureMessage}}" class="voice-failure">{{item.failureMessage}}</view>
            </view>
            <view class="voice-actions">
              <button class="voice-link" data-segment-id="{{item.segmentId}}" disabled="{{!item.canOperate}}" bindtap="playVoiceSegment">{{voicePlayingSegmentId === item.segmentId ? '停止' : '试听'}}</button>
              <button class="voice-link voice-link--danger" data-segment-id="{{item.segmentId}}" disabled="{{!item.canOperate}}" bindtap="removeVoiceSegment">删除</button>
            </view>
          </view>
          <button wx:if="{{voiceSummary.hasUnready}}" class="secondary-button voice-upload" disabled="{{submissionStatus === 'submitting'}}" bindtap="uploadVoiceSegments">上传并等待安全检查</button>
        </view>
      </view>

      <view wx:if="{{reviewDisplay.state !== 'idle'}}" class="review-status-card review-status-card--{{reviewDisplay.state}}">
        <view class="review-status-mark">{{reviewDisplay.state === 'waiting_quota' ? '等待额度' : reviewDisplay.state === 'queued' ? '排队中' : reviewDisplay.state === 'running' ? '核对中' : reviewDisplay.state === 'completed' ? '已完成' : reviewDisplay.state === 'blocked' ? '证据阻断' : '未形成'}}</view>
        <view class="review-status-title">{{reviewDisplay.title}}</view>
        <view class="review-status-copy">{{reviewDisplay.message}}</view>
        <button
          wx:if="{{canRegenerateReview}}"
          class="review-regenerate-button {{submissionStatus === 'submitting' ? 'review-regenerate-button--disabled' : ''}}"
          loading="{{submissionStatus === 'submitting'}}"
          disabled="{{submissionStatus === 'submitting'}}"
          bindtap="regenerateGroundedReview"
        >重新生成完整评阅</button>
      </view>

      <view wx:if="{{reviewDisplay.result}}" class="grounded-review">
        <view class="score-card">
          <view class="score-eyebrow">AI 训练估分区间</view>
          <view class="score-row">
            <view class="score-range type-data">{{reviewDisplay.result.trainingEstimateLabel}}</view>
            <view class="score-maximum">/ {{reviewDisplay.result.maximumLabel}} 分</view>
          </view>
          <view class="score-recommended">建议观察点 <text class="type-data">{{reviewDisplay.result.recommendedLabel}}</text> 分</view>
          <view class="confidence-badge {{reviewDisplay.result.confidenceLow ? 'confidence-badge--low' : ''}}">{{reviewDisplay.result.confidenceLabel}}</view>
          <view wx:for="{{reviewDisplay.result.confidenceReasons}}" wx:key="*this" class="confidence-reason">· {{item}}</view>
          <view class="score-disclaimer">训练估分不进入岗位差距或正式能力分；需经标准卷或正式成绩验证。</view>
        </view>

        <view class="section-heading review-section-heading">
          <view class="section-title">分维度证据</view>
          <view class="section-meta">区间而非单点分</view>
        </view>
        <view wx:for="{{reviewDisplay.result.dimensions}}" wx:key="criterionCode" class="dimension-card card">
          <view class="dimension-heading">
            <view class="form-item-title">{{item.label}}</view>
            <view class="dimension-score type-data">{{item.scoreRangeLabel}} / {{item.maximumLabel}}</view>
          </view>
          <view class="dimension-rationale">{{item.rationale}}</view>
          <view wx:if="{{item.answerEvidence.length}}" class="evidence-quote">
            <view class="evidence-quote-label">答案原句</view>
            <view wx:for="{{item.answerEvidence}}" wx:for-item="quote" wx:key="*this">“{{quote}}”</view>
          </view>
          <view wx:if="{{item.materialEvidence.length}}" class="evidence-quote evidence-quote--material">
            <view class="evidence-quote-label">材料原句</view>
            <view wx:for="{{item.materialEvidence}}" wx:for-item="quote" wx:key="*this">“{{quote}}”</view>
          </view>
        </view>

        <view class="section-heading review-section-heading">
          <view class="section-title">最该修正的问题</view>
          <view class="section-meta">答案证据 × 材料证据</view>
        </view>
        <view wx:for="{{reviewDisplay.result.findings}}" wx:key="findingId" class="finding-card card finding-card--{{item.severity}}">
          <view class="finding-heading">
            <view class="finding-tags">
              <view class="pill">{{item.typeLabel}}</view>
              <view class="pill severity-pill severity-pill--{{item.severity}}">{{item.severityLabel}}</view>
            </view>
          </view>
          <view class="finding-label">问题诊断</view>
          <view class="finding-diagnosis">{{item.diagnosis}}</view>
          <view class="finding-label">下一步动作</view>
          <view class="finding-action">{{item.action}}</view>
          <view wx:if="{{item.answerEvidenceRefs.length}}" class="evidence-quote">
            <view class="evidence-quote-label">答案原句</view>
            <view>“{{item.answerEvidenceSummary}}”</view>
          </view>
          <view wx:if="{{item.materialEvidenceRefs.length}}" class="evidence-quote evidence-quote--material">
            <view class="evidence-quote-label">材料原句</view>
            <view>“{{item.materialEvidenceSummary}}”</view>
          </view>
        </view>
        <view class="review-audit">审计版本：{{reviewDisplay.result.auditLabel}} · {{reviewDisplay.result.reviewVersionId}}</view>
      </view>
    </block>

    <block wx:elif="{{capability.stage === 'essay_rewrite' && rewriteDraft}}">
      <view class="closure-guide card">
        <view class="review-guide-title closure-guide__line">二次改写版本</view>
        <view class="closure-guide__line">本次只回应你在问题决策版本中明确认可的问题。</view>
        <view class="closure-guide__line">新答案、逐条修正证据和掌握状态由 essay-rewrite-writer@v2 同步写入。</view>
      </view>
      <view class="closure-card card">
        <view class="field-label">答案录入来源</view>
        <picker range="{{closureSourceTypeLabels}}" value="{{rewriteDraft.sourceTypeIndex}}" bindchange="changeRewriteSourceType">
          <view class="essay-select">{{closureSourceTypeLabels[rewriteDraft.sourceTypeIndex]}} <text>›</text></view>
        </picker>
        <view wx:if="{{rewriteDraft.sourceType === 'ocr_confirmed'}}" class="handwriting-card">
          <view class="handwriting-title">上传改写手稿</view>
          <view class="handwriting-actions">
            <button class="secondary-action handwriting-action" data-source="camera" bindtap="chooseHandwritingImage">拍照识别</button>
            <button class="secondary-action handwriting-action" data-source="album" bindtap="chooseHandwritingImage">选择原图</button>
          </view>
          <image wx:if="{{handwriting.localImagePath}}" class="handwriting-original" src="{{handwriting.localImagePath}}" mode="widthFix"></image>
          <view wx:if="{{handwriting.message}}" class="source-confirmation-note">{{handwriting.message}}</view>
          <view wx:for="{{handwriting.spans}}" wx:key="spanId" class="handwriting-span">
            <view class="handwriting-span-meta">第 {{item.box.pageNo}} 页 · 置信度 {{item.confidenceLabel}}</view>
            <textarea class="essay-textarea essay-textarea--compact" value="{{item.text}}" data-span-id="{{item.spanId}}" bindinput="inputHandwritingSpan"></textarea>
            <button class="span-confirm {{item.checked ? 'span-confirm--checked' : ''}}" data-span-id="{{item.spanId}}" bindtap="toggleHandwritingSpan">{{item.checked ? '已逐字核对' : '核对这一段'}}</button>
          </view>
          <button wx:if="{{handwriting.phase === 'review' || handwriting.phase === 'error'}}" class="primary-action" bindtap="confirmHandwriting">确认全部 OCR 文本</button>
        </view>
        <view class="field-label">改写后答案 <text class="field-hint">{{rewriteDraft.answerText.length}} / 10000</text></view>
        <textarea class="essay-textarea essay-answer-textarea" value="{{rewriteDraft.answerText}}" maxlength="10000" data-field="answerText" placeholder="写入完整新答案，不覆盖原答案版本。" bindinput="inputRewriteField"></textarea>
        <view class="field-label">本次改写思路 <text class="field-optional">选填</text></view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{rewriteDraft.userThought}}" maxlength="3000" data-field="userThought" placeholder="你如何调整找点、概括或结构？" bindinput="inputRewriteField"></textarea>
      </view>
      <view wx:for="{{rewriteDraft.resolutions}}" wx:key="findingId" class="closure-card card">
        <view class="closure-finding-index">问题 {{index + 1}}</view>
        <view class="finding-diagnosis">{{item.diagnosis}}</view>
        <view class="finding-action">建议动作：{{item.action}}</view>
        <view class="field-label">修正结果</view>
        <picker range="{{findingResolutionLabels}}" value="{{item.statusIndex}}" data-index="{{index}}" bindchange="changeRewriteResolution">
          <view class="essay-select">{{findingResolutionLabels[item.statusIndex]}} <text>›</text></view>
        </picker>
        <view class="field-label">新答案中的证据</view>
        <textarea class="essay-textarea essay-textarea--compact" value="{{item.learnerEvidence}}" maxlength="2000" data-index="{{index}}" placeholder="指出你改了哪句、哪个要点或哪一层结构。" bindinput="inputRewriteEvidence"></textarea>
      </view>
    </block>

    <block wx:elif="{{capability.stage === 'essay_transfer'}}">
      <view class="closure-guide card">
        <view class="review-guide-title closure-guide__line">新题迁移验证</view>
        <view class="closure-guide__line">当前题目与材料由规划冻结，作答、评阅和问题决策都建立新版本。</view>
        <view class="closure-guide__line">只能明确选择源评阅与新评阅的共同评分维度，不会猜测验证项。</view>
      </view>

      <block wx:if="{{transferDraft.phase === 'drafting'}}">
        <view class="closure-card card">
          <view class="field-label">答案录入来源</view>
          <picker range="{{closureSourceTypeLabels}}" value="{{transferDraft.sourceTypeIndex}}" bindchange="changeTransferSourceType">
            <view class="essay-select">{{closureSourceTypeLabels[transferDraft.sourceTypeIndex]}} <text>›</text></view>
          </picker>
          <view wx:if="{{transferDraft.sourceType === 'ocr_confirmed'}}" class="handwriting-card">
            <view class="handwriting-title">上传迁移题手稿</view>
            <view class="handwriting-actions">
              <button class="secondary-action handwriting-action" data-source="camera" bindtap="chooseHandwritingImage">拍照识别</button>
              <button class="secondary-action handwriting-action" data-source="album" bindtap="chooseHandwritingImage">选择原图</button>
            </view>
            <image wx:if="{{handwriting.localImagePath}}" class="handwriting-original" src="{{handwriting.localImagePath}}" mode="widthFix"></image>
            <view wx:if="{{handwriting.message}}" class="source-confirmation-note">{{handwriting.message}}</view>
            <view wx:for="{{handwriting.spans}}" wx:key="spanId" class="handwriting-span">
              <view class="handwriting-span-meta">第 {{item.box.pageNo}} 页 · 置信度 {{item.confidenceLabel}}</view>
              <textarea class="essay-textarea essay-textarea--compact" value="{{item.text}}" data-span-id="{{item.spanId}}" bindinput="inputHandwritingSpan"></textarea>
              <button class="span-confirm {{item.checked ? 'span-confirm--checked' : ''}}" data-span-id="{{item.spanId}}" bindtap="toggleHandwritingSpan">{{item.checked ? '已逐字核对' : '核对这一段'}}</button>
            </view>
            <button wx:if="{{handwriting.phase === 'review' || handwriting.phase === 'error'}}" class="primary-action" bindtap="confirmHandwriting">确认全部 OCR 文本</button>
          </view>
          <view class="field-label">实际作答分钟 <text class="field-optional">选填</text></view>
          <input class="essay-input type-data" type="number" value="{{transferDraft.elapsedMinutesText}}" data-field="elapsedMinutesText" placeholder="留空按本页计时" bindinput="inputTransferField" />
          <view class="field-label">新题答案 <text class="field-hint">{{transferDraft.answerText.length}} / 10000</text></view>
          <textarea class="essay-textarea essay-answer-textarea" value="{{transferDraft.answerText}}" maxlength="10000" data-field="answerText" placeholder="只作答当前新题，不复用源题答案。" bindinput="inputTransferField"></textarea>
          <view class="field-label">作答时的真实思路 <text class="field-optional">选填</text></view>
          <textarea class="essay-textarea essay-textarea--compact" value="{{transferDraft.userThought}}" maxlength="3000" data-field="userThought" placeholder="记录你如何尝试迁移上次的改法。" bindinput="inputTransferField"></textarea>
        </view>
      </block>

      <view wx:elif="{{transferDraft.phase === 'review_queued' || transferDraft.phase === 'attempt_saved' || transferDraft.phase === 'answer_saved'}}" class="review-status-card review-status-card--running">
        <view class="review-status-mark">新题证据链执行中</view>
        <view class="review-status-title">作答草稿与已写入版本指针已按账号和规划任务保存</view>
        <view class="review-status-copy">页面重载后会从已确认的作答、答案或评阅 job 继续，不会重新造一条证据链。</view>
      </view>

      <block wx:elif="{{transferDraft.phase === 'review_ready' || transferDraft.phase === 'decision_saved'}}">
        <view class="closure-card card">
          <view class="review-guide-title">明确选择迁移验证维度</view>
          <checkbox-group bindchange="changeTransferCriteria">
            <label wx:for="{{criterionOptions}}" wx:key="criterionCode" class="criterion-option {{item.checked ? 'criterion-option--checked' : ''}}">
              <checkbox value="{{item.criterionCode}}" checked="{{item.checked}}" color="#00978B" />
              <view>{{item.label}} <text class="type-data">{{item.criterionCode}}</text></view>
            </label>
          </checkbox-group>
        </view>
        <view wx:for="{{transferDraft.decisions}}" wx:key="findingId" class="closure-card card">
          <view class="closure-finding-index">新题问题 {{index + 1}}</view>
          <view class="finding-diagnosis">{{item.diagnosis}}</view>
          <view class="finding-action">建议动作：{{item.action}}</view>
          <view class="field-label">我的决定</view>
          <picker range="{{findingDecisionLabels}}" value="{{item.decisionIndex}}" data-index="{{index}}" bindchange="changeTransferDecision">
            <view class="essay-select">{{findingDecisionLabels[item.decisionIndex]}} <text>›</text></view>
          </picker>
          <view wx:if="{{item.decision === 'rejected' || item.decision === 'uncertain'}}">
            <view class="field-label">理由</view>
            <textarea class="essay-textarea essay-textarea--compact" value="{{item.learnerReason}}" maxlength="2000" data-index="{{index}}" data-field="learnerReason" placeholder="写明你不认可或存疑的证据。" bindinput="inputTransferDecisionField"></textarea>
          </view>
          <view wx:if="{{item.decision === 'uncertain'}}">
            <view class="field-label">待追问内容</view>
            <textarea class="essay-textarea essay-textarea--compact" value="{{item.followUpQuestion}}" maxlength="1000" data-index="{{index}}" data-field="followUpQuestion" placeholder="需要核对什么材料或评分规则？" bindinput="inputTransferDecisionField"></textarea>
          </view>
        </view>
        <view class="closure-card card">
          <view class="field-label">我对新题评阅的理解</view>
          <textarea class="essay-textarea essay-textarea--compact" value="{{transferDraft.learnerUnderstanding}}" maxlength="3000" data-field="learnerUnderstanding" placeholder="用自己的话总结，不默认认可 AI 结论。" bindinput="inputTransferField"></textarea>
        </view>
      </block>
    </block>

    <block wx:elif="{{capability.stage === 'essay_review'}}">
      <view class="review-guide card">
        <view class="review-guide-title">确认规则</view>
        <view>1. 对本版每个评阅问题逐条选择认可、不认可或存疑。</view>
        <view>2. 仅从“认可”的问题中选择 <text class="type-data">1–3</text> 个本次优先修正项。</view>
        <view>3. 用自己的话说清理解，AI 结论不会被默认认可。</view>
      </view>
      <view wx:for="{{view.findings}}" wx:key="findingId" class="finding-card card finding-card--{{item.severity}}">
          <view class="finding-heading">
            <view class="finding-tags">
              <view class="pill">{{item.typeLabel}}</view>
              <view class="pill severity-pill severity-pill--{{item.severity}}">{{item.severityLabel}}</view>
            </view>
            <picker range="{{findingDecisionLabels}}" value="{{item.decisionIndex}}" data-index="{{index}}" bindchange="changeReviewFindingDecision">
              <view class="essay-select">{{findingDecisionLabels[item.decisionIndex]}} <text>›</text></view>
            </picker>
          </view>
          <view class="finding-label">问题诊断</view>
          <view class="finding-diagnosis">{{item.diagnosis}}</view>
          <view class="finding-label">修正动作</view>
          <view class="finding-action">{{item.action}}</view>
          <view wx:if="{{item.answerEvidenceRefs.length}}" class="evidence-quote">
            <view class="evidence-quote-label">原答案证据</view>
            <view>“{{item.answerEvidenceSummary}}”</view>
          </view>
          <view wx:if="{{item.materialEvidenceRefs.length}}" class="evidence-quote evidence-quote--material">
            <view class="evidence-quote-label">材料证据</view>
            <view>“{{item.materialEvidenceSummary}}”</view>
          </view>
          <view wx:if="{{item.decision === 'rejected' || item.decision === 'uncertain'}}" class="field-label">我的理由</view>
          <textarea wx:if="{{item.decision === 'rejected' || item.decision === 'uncertain'}}" class="essay-textarea essay-textarea--compact" value="{{item.learnerReason}}" maxlength="2000" data-index="{{index}}" data-field="learnerReason" placeholder="指出你不认可或存疑的具体证据。" bindinput="inputReviewFindingDecisionField"></textarea>
          <view wx:if="{{item.decision === 'uncertain'}}" class="field-label">待追问内容</view>
          <textarea wx:if="{{item.decision === 'uncertain'}}" class="essay-textarea essay-textarea--compact" value="{{item.followUpQuestion}}" maxlength="1000" data-index="{{index}}" data-field="followUpQuestion" placeholder="写下需要 AI 或老师继续解释的问题。" bindinput="inputReviewFindingDecisionField"></textarea>
      </view>
      <view class="form-card card">
        <view class="field-label">本次优先修正 <text class="field-hint">选 1–3 个</text></view>
        <checkbox-group bindchange="changePriorityFindings">
          <label wx:for="{{view.findings}}" wx:key="findingId" class="priority-option {{item.priorityDisabled ? 'priority-option--disabled' : ''}}">
            <checkbox value="{{item.findingId}}" disabled="{{item.priorityDisabled}}" checked="{{item.priority}}" color="#8b5cf6" />
            <view>{{item.typeLabel}} · {{item.diagnosis}}</view>
          </label>
        </checkbox-group>
        <view class="field-label">我的理解</view>
        <textarea class="essay-textarea" value="{{review.learnerUnderstanding}}" maxlength="3000" placeholder="例如：我不是没看到这句材料，而是把现象当成了原因……" bindinput="inputLearnerUnderstanding"></textarea>
      </view>
    </block>

    <view wx:if="{{closureResult}}" class="closure-result closure-result--{{closureResult.statusTone}} card">
      <view class="closure-result-mark">{{closureResult.statusLabel}}</view>
      <view class="closure-result-mastery">掌握状态：{{closureResult.masteryLabel}}</view>
      <view class="closure-result-version type-data">{{closureResult.versionId}}</view>
      <view class="closure-result-planning">{{closureResult.planningMessage}}</view>
    </view>

    <view wx:if="{{submissionMessage}}" class="submission-message submission-message--{{submissionStatus}}">
      {{submissionMessage}}
    </view>
      </view>
    </view>
  </view>

  <view slot="footer" class="footer-content">
    <view wx:if="{{submissionMessage}}" class="footer-message">{{submissionMessage}}</view>
    <button
      class="primary-button submit-button {{!canSubmit || submissionStatus === 'submitting' ? 'submit-button--disabled' : ''}}"
      loading="{{submissionStatus === 'submitting'}}"
      disabled="{{!canSubmit || submissionStatus === 'submitting'}}"
      bindtap="submitStage"
    >
      {{submissionStatus === 'submitting' ? (capability.stage === 'essay_drafting' ? '正在原子提交…' : '正在写入…') : capability.stage === 'essay_drafting' ? (draftAvailable ? '提交作答与复盘' : '确认答案并提交复盘') : capability.stage === 'essay_rewrite' ? '提交改写与修正证据' : capability.stage === 'essay_transfer' ? (transferDraft.phase === 'drafting' ? '提交新题作答' : '提交迁移决策与验证') : hasSavedEvidence ? '保存新版本' : '提交本阶段证据'}}
    </button>
  </view>
</task-shell>
