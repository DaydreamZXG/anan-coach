.coach-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.coach-content {
  box-sizing: border-box;
  padding: 0 calc(40 * var(--rpx))
    max(calc(376 * var(--rpx)), calc(calc(312 * var(--rpx)) + env(safe-area-inset-bottom)));
}

.coach-header {
  margin-bottom: calc(48 * var(--rpx));
}
.coach-title {
  font-size: var(--text-hero);
  font-weight: 800;
  letter-spacing: calc(-1.4 * var(--rpx));
  line-height: calc(78.4 * var(--rpx));
}
.coach-subtitle {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: calc(39 * var(--rpx));
}
.coach-scroll {
  display: flex;
  flex-direction: column;
  gap: calc(40 * var(--rpx));
}

.coach-core,
.coach-card,
.answer-card {
  box-sizing: border-box;
  border: calc(1 * var(--rpx)) solid rgba(240, 242, 246, 0.8);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.coach-core {
  position: relative;
  overflow: hidden;
  padding: calc(48 * var(--rpx));
  background:
    linear-gradient(
      145.6deg,
      rgba(97, 95, 255, 0.03),
      rgba(173, 70, 255, 0.03) 50%,
      rgba(246, 51, 154, 0.03)
    ),
    var(--color-surface);
  text-align: center;
}

.coach-orb-slot,
.coach-core__copy,
.context-chips {
  position: relative;
}

.coach-orb-slot {
  display: flex;
  width: calc(128 * var(--rpx));
  height: calc(128 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: var(--radius-48);
  background: var(--figma-gradient-ai);
  box-shadow: var(--shadow-ai);
}

.coach-orb {
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
}

.coach-core__copy {
  max-width: calc(604 * var(--rpx));
  margin: calc(24 * var(--rpx)) auto 0;
  font-size: var(--text-section);
  font-weight: 500;
  line-height: calc(45 * var(--rpx));
  overflow-wrap: anywhere;
  white-space: normal;
}

.context-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: calc(16 * var(--rpx));
  margin-top: calc(48 * var(--rpx));
}

.context-chip {
  min-height: calc(61 * var(--rpx));
  margin: 0;
  padding: 0 calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: calc(61 * var(--rpx));
}

.context-chip::after,
.launch-context__close::after,
.primary-soft-action::after,
.secondary-action::after,
.suggestion-pill::after,
.progress-row::after,
.answer-action::after,
.composer-send::after {
  border: 0;
}

.launch-context {
  padding: calc(28 * var(--rpx)) calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
  border-radius: var(--radius-32);
  background: linear-gradient(135deg, rgba(238, 242, 255, 0.94), rgba(250, 245, 255, 0.94));
}

.launch-context__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.launch-context__source {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}

.launch-context__close {
  width: calc(46 * var(--rpx));
  height: calc(46 * var(--rpx));
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: rgba(255, 255, 255, 0.7);
  color: var(--ink-3);
  font-size: var(--text-section);
  line-height: calc(44 * var(--rpx));
}

.launch-context__title {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.45;
}

.launch-context__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.semantic-state {
  display: flex;
  align-items: center;
  gap: calc(12 * var(--rpx));
  padding: 0 calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.semantic-dot {
  width: calc(11 * var(--rpx));
  height: calc(11 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary);
}
.state-evidence_insufficient .semantic-dot,
.state-provider_pending .semantic-dot {
  background: var(--figma-color-warning);
}
.state-permission_denied .semantic-dot,
.state-security_blocked .semantic-dot,
.state-failed .semantic-dot {
  background: var(--danger);
}
.state-quota_exhausted .semantic-dot {
  background: var(--color-ai-violet);
}

.coach-card {
  padding: calc(48 * var(--rpx));
}
.insight-card {
  border-color: var(--primary-soft);
}
.insight-heading {
  display: flex;
  align-items: center;
  gap: calc(16 * var(--rpx));
  font-size: var(--text-section);
  font-weight: 700;
  line-height: calc(42 * var(--rpx));
}
.insight-icon {
  width: calc(32 * var(--rpx));
  height: calc(32 * var(--rpx));
}
.coach-card__title {
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.45;
}
.coach-card__copy {
  margin-top: calc(24 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  line-height: calc(45.5 * var(--rpx));
}
.insight-copy {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.insight-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(24 * var(--rpx));
  margin-top: calc(40 * var(--rpx));
}

.primary-soft-action,
.secondary-action {
  box-sizing: border-box;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: calc(90 * var(--rpx));
  margin: 0 !important;
  padding: 0 !important;
  border-radius: var(--radius-24) !important;
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(90 * var(--rpx)) !important;
}

.primary-soft-action {
  background: var(--color-primary-soft) !important;
  color: var(--color-primary) !important;
}
.secondary-action {
  background: var(--line) !important;
  color: var(--color-ink-secondary) !important;
}
.coach-error .secondary-action {
  margin-top: calc(28 * var(--rpx)) !important;
}
.ask-error-card {
  border-color: var(--color-danger-soft);
}
.context-notice {
  border-color: var(--figma-color-warning-soft);
}
.context-source-list {
  display: flex;
  flex-direction: column;
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}
.context-source-row {
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
}
.context-source-row__label {
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  font-weight: 700;
}
.context-source-row__message {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.context-retry-actions {
  display: flex;
  flex-direction: column;
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}
.request-id {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}

.loading-line {
  height: calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: linear-gradient(90deg, var(--line), var(--color-surface), var(--line));
  background-size: 300% 100%;
}
.loading-line--short {
  width: 64%;
  margin-top: calc(20 * var(--rpx));
}
.section-label {
  margin: 0 calc(8 * var(--rpx)) calc(16 * var(--rpx));
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: calc(39.2 * var(--rpx));
}
.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
}

.suggestion-pill {
  width: auto !important;
  min-width: 0 !important;
  min-height: calc(79 * var(--rpx));
  margin: 0 !important;
  padding: 0 calc(32 * var(--rpx)) !important;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface) !important;
  box-shadow: var(--shadow-crisp) !important;
  color: var(--color-ink-secondary) !important;
  font-size: var(--text-body);
  font-weight: 500;
  line-height: calc(79 * var(--rpx)) !important;
  text-align: left;
}

.progress-section {
  display: flex;
  flex-direction: column;
  gap: calc(24 * var(--rpx));
  padding-top: calc(16 * var(--rpx));
}
.progress-row {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  box-sizing: border-box;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: calc(116 * var(--rpx));
  margin: 0 !important;
  padding: 0 calc(40 * var(--rpx)) !important;
  border: 0;
  border-radius: var(--radius-40) !important;
  background: var(--color-surface) !important;
  color: var(--color-ink) !important;
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.35 !important;
  text-align: left;
}
.progress-row__meta {
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
}

.ask-bubble-row {
  display: flex;
  justify-content: flex-end;
}
.ask-bubble {
  max-width: 82%;
  padding: calc(24 * var(--rpx)) calc(30 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
  border-radius: var(--radius-32) var(--radius-32) var(--radius-8) var(--radius-32);
  background: var(--color-primary-soft);
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.thinking-card {
  display: flex;
  align-items: center;
  gap: calc(24 * var(--rpx));
}

.thinking-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  border-radius: var(--radius-24);
  background: linear-gradient(
    135deg,
    var(--color-primary),
    var(--color-ai-violet),
    var(--color-ai-pink)
  );
  color: var(--color-surface);
  font-size: var(--text-body-lg);
}

.answer-card {
  padding: calc(40 * var(--rpx));
}
.answer-header,
.answer-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}
.answer-title,
.answer-section-title,
.citation-title {
  font-size: var(--text-body);
  font-weight: 700;
}
.answer-meta,
.citation-version,
.citation-copy,
.limitation-item {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.answer-type {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(12 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.answer-copy {
  margin-top: calc(28 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.78;
  white-space: pre-wrap;
}

.decision-boundary {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.answer-section-head {
  margin-top: calc(32 * var(--rpx));
  padding-top: calc(28 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--line);
}
.answer-section-count {
  color: var(--ink-3);
  font-size: var(--text-micro);
}
.citation-row {
  margin-top: calc(20 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--bg);
}
.citation-summary-list {
  margin-top: calc(18 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--line);
}
.citation-summary-item {
  display: flex;
  align-items: flex-start;
  gap: calc(12 * var(--rpx));
  padding: calc(14 * var(--rpx)) 0;
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.citation-summary-item + .citation-summary-item {
  border-top: calc(1 * var(--rpx)) solid var(--line);
}
.citation-summary-mark {
  flex: none;
  width: calc(8 * var(--rpx));
  height: calc(8 * var(--rpx));
  margin-top: calc(11 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary);
}
.citation-summary-copy {
  min-width: 0;
}
.limitations {
  margin-top: calc(28 * var(--rpx));
}
.action-list {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}

.answer-action {
  width: auto;
  min-height: calc(68 * var(--rpx));
  margin: 0;
  padding: 0 calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--primary-soft);
  color: var(--color-primary);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: calc(68 * var(--rpx));
}
.quota-note {
  margin-top: calc(24 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.companion-composer {
  position: fixed;
  transition: transform 0.2s ease-out;
  z-index: 80;
  right: 0;
  bottom: max(calc(180 * var(--rpx)), calc(calc(116 * var(--rpx)) + env(safe-area-inset-bottom)));
  left: 0;
  box-sizing: border-box;
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx)) calc(48 * var(--rpx));
  background: transparent;
  pointer-events: none;
}

.composer-surface {
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(112 * var(--rpx));
  gap: calc(12 * var(--rpx));
  padding: calc(2 * var(--rpx)) calc(16 * var(--rpx)) calc(2 * var(--rpx)) calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-capsule);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
  pointer-events: auto;
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-height: calc(108 * var(--rpx));
  max-height: calc(156 * var(--rpx));
  padding: calc(28 * var(--rpx)) 0;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 500;
  line-height: calc(48 * var(--rpx));
}

.composer-send {
  display: flex;
  flex: 0 0 calc(80 * var(--rpx)) !important;
  width: calc(80 * var(--rpx)) !important;
  min-width: calc(80 * var(--rpx)) !important;
  max-width: calc(80 * var(--rpx)) !important;
  height: calc(80 * var(--rpx)) !important;
  min-height: calc(80 * var(--rpx)) !important;
  max-height: calc(80 * var(--rpx)) !important;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--color-ink) !important;
  color: var(--color-surface) !important;
  line-height: calc(80 * var(--rpx)) !important;
  box-shadow: var(--shadow-crisp);
}
.composer-send--disabled {
  opacity: 0.42;
}
.composer-send__icon {
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
}

@media (min-width: 768px) {
  .coach-page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }
  .coach-content {
    padding: 0 36px max(188px, calc(156px + env(safe-area-inset-bottom)));
  }
  .coach-title {
    font-size: 34px;
  }
  .coach-subtitle,
  .coach-card__copy,
  .answer-copy {
    font-size: 16px;
  }
  .coach-core,
  .coach-card,
  .answer-card {
    border-radius: 26px;
  }
  .coach-core {
    padding: 30px 26px 24px;
  }
  .coach-card,
  .answer-card {
    padding: 24px;
  }
  .coach-card__title,
  .answer-title,
  .answer-section-title,
  .citation-title {
    font-size: 18px;
  }
  .context-chip,
  .context-evidence,
  .semantic-state,
  .request-id,
  .progress-row__meta,
  .answer-meta,
  .citation-version,
  .citation-copy,
  .limitation-item,
  .quota-note {
    font-size: 13px;
  }
  .companion-composer {
    right: 50%;
    bottom: max(90px, calc(58px + env(safe-area-inset-bottom)));
    left: auto;
    width: min(100%, 760px);
    padding-right: 36px;
    padding-left: 36px;
    background: transparent;
    pointer-events: none;
    transform: translateX(50%);
  }
  .composer-surface {
    pointer-events: auto;
  }
}
