.coach-page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
}

.coach-content {
  box-sizing: border-box;
  padding: 0 40rpx max(376rpx, calc(312rpx + env(safe-area-inset-bottom)));
}

.coach-header {
  margin-bottom: 48rpx;
}
.coach-title {
  font-size: var(--text-hero);
  font-weight: 800;
  letter-spacing: -1.4rpx;
  line-height: 78.4rpx;
}
.coach-subtitle {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 39rpx;
}
.coach-scroll {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.coach-core,
.coach-card,
.answer-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(240, 242, 246, 0.8);
  border-radius: var(--radius-64);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.coach-core {
  position: relative;
  overflow: hidden;
  padding: 48rpx;
  background:
    linear-gradient(
      145.6deg,
      rgba(97, 95, 255, 0.03),
      rgba(173, 70, 255, 0.03) 50%,
      rgba(246, 51, 154, 0.03)
    ),
    var(--color-surface);
  text-align: center;
}

.coach-orb-slot,
.coach-core__copy,
.context-chips {
  position: relative;
}

.coach-orb-slot {
  display: flex;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: var(--radius-48);
  background: var(--figma-gradient-ai);
  box-shadow: var(--shadow-ai);
}

.coach-orb {
  width: 64rpx;
  height: 64rpx;
}

.coach-core__copy {
  max-width: 604rpx;
  margin: 24rpx auto 0;
  font-size: var(--text-section);
  font-weight: 500;
  line-height: 45rpx;
  white-space: nowrap;
}

.context-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-top: 48rpx;
}

.context-chip {
  min-height: 61rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 61rpx;
}

.context-chip::after,
.launch-context__close::after,
.primary-soft-action::after,
.secondary-action::after,
.suggestion-pill::after,
.progress-row::after,
.answer-action::after,
.composer-send::after {
  border: 0;
}

.launch-context {
  padding: 28rpx 28rpx;
  border: 1rpx solid var(--color-primary-soft-strong);
  border-radius: var(--radius-32);
  background: linear-gradient(135deg, rgba(238, 242, 255, 0.94), rgba(250, 245, 255, 0.94));
}

.launch-context__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.launch-context__source {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}

.launch-context__close {
  width: 46rpx;
  height: 46rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: rgba(255, 255, 255, 0.7);
  color: var(--ink-3);
  font-size: var(--text-section);
  line-height: 44rpx;
}

.launch-context__title {
  margin-top: 12rpx;
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.45;
}

.launch-context__copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.semantic-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.semantic-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
.state-evidence_insufficient .semantic-dot,
.state-provider_pending .semantic-dot {
  background: var(--figma-color-warning);
}
.state-permission_denied .semantic-dot,
.state-security_blocked .semantic-dot,
.state-failed .semantic-dot {
  background: var(--danger);
}
.state-quota_exhausted .semantic-dot {
  background: var(--color-ai-violet);
}

.coach-card {
  padding: 48rpx;
}
.insight-card {
  border-color: var(--primary-soft);
}
.insight-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 42rpx;
}
.insight-icon {
  width: 32rpx;
  height: 32rpx;
}
.coach-card__title {
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.45;
}
.coach-card__copy {
  margin-top: 24rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  line-height: 45.5rpx;
}
.insight-copy {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.insight-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 40rpx;
}

.primary-soft-action,
.secondary-action {
  box-sizing: border-box;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: 90rpx;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: var(--radius-24) !important;
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 90rpx !important;
}

.primary-soft-action {
  background: var(--color-primary-soft) !important;
  color: var(--color-primary) !important;
}
.secondary-action {
  background: var(--line) !important;
  color: var(--color-ink-secondary) !important;
}
.coach-error .secondary-action {
  margin-top: 28rpx !important;
}
.request-id {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}

.loading-line {
  height: 24rpx;
  border-radius: var(--radius-capsule);
  background: linear-gradient(90deg, var(--line), var(--color-surface), var(--line));
  background-size: 300% 100%;
}
.loading-line--short {
  width: 64%;
  margin-top: 20rpx;
}
.section-label {
  margin: 0 8rpx 16rpx;
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 39.2rpx;
}
.suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.suggestion-pill {
  width: auto !important;
  min-width: 0 !important;
  min-height: 79rpx;
  margin: 0 !important;
  padding: 0 32rpx !important;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface) !important;
  box-shadow: var(--shadow-crisp) !important;
  color: var(--color-ink-secondary) !important;
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 79rpx !important;
  text-align: left;
}

.progress-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 16rpx;
}
.progress-row {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  box-sizing: border-box;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  min-height: 116rpx;
  margin: 0 !important;
  padding: 0 40rpx !important;
  border: 0;
  border-radius: var(--radius-40) !important;
  background: var(--color-surface) !important;
  color: var(--color-ink) !important;
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.35 !important;
  text-align: left;
}
.progress-row__meta {
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
}

.question-preview {
  padding: 28rpx 32rpx;
  border-radius: var(--radius-32);
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-caption);
  line-height: 1.6;
}
.question-preview__label {
  margin-bottom: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
}
.thinking-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.thinking-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-24);
  background: linear-gradient(
    135deg,
    var(--color-primary),
    var(--color-ai-violet),
    var(--color-ai-pink)
  );
  color: var(--color-surface);
  font-size: var(--text-body-lg);
}

.answer-card {
  padding: 40rpx;
}
.answer-header,
.answer-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.answer-title,
.answer-section-title,
.citation-title {
  font-size: var(--text-body);
  font-weight: 700;
}
.answer-meta,
.citation-version,
.citation-copy,
.limitation-item {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.answer-type {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.answer-copy {
  margin-top: 28rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.78;
  white-space: pre-wrap;
}

.decision-boundary {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  line-height: 1.6;
}

.answer-section-head {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}
.answer-section-count {
  color: var(--ink-3);
  font-size: var(--text-micro);
}
.citation-row {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-24);
  background: var(--bg);
}
.limitations {
  margin-top: 28rpx;
}
.action-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.answer-action {
  width: auto;
  min-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: var(--radius-24);
  background: var(--primary-soft);
  color: var(--color-primary);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 68rpx;
}
.quota-note {
  margin-top: 24rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.companion-composer {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: max(180rpx, calc(116rpx + env(safe-area-inset-bottom)));
  left: 0;
  box-sizing: border-box;
  padding: 32rpx 40rpx 48rpx;
  background: var(--bg);
}

.composer-surface {
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  gap: 12rpx;
  padding: 2rpx 16rpx 2rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-capsule);
  background: var(--color-surface);
  box-shadow: var(--shadow-card-strong);
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-height: 108rpx;
  max-height: 156rpx;
  padding: 28rpx 0;
  color: var(--ink);
  font-size: var(--text-section);
  font-weight: 500;
  line-height: 48rpx;
}

.composer-send {
  display: flex;
  flex: 0 0 80rpx !important;
  width: 80rpx !important;
  min-width: 80rpx !important;
  max-width: 80rpx !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  max-height: 80rpx !important;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 50% !important;
  background: var(--color-ink) !important;
  color: var(--color-surface) !important;
  line-height: 80rpx !important;
  box-shadow: var(--shadow-crisp);
}
.composer-send--disabled {
  opacity: 0.42;
}
.composer-send__icon {
  width: 36rpx;
  height: 36rpx;
}

@media (min-width: 768px) {
  .coach-page {
    width: 100%;
    max-width: calc(760px + var(--layout-tab-rail));
    margin: 0 auto;
    padding-left: var(--layout-tab-rail);
  }
  .coach-content {
    padding: 0 36px max(188px, calc(156px + env(safe-area-inset-bottom)));
  }
  .coach-title {
    font-size: 34px;
  }
  .coach-subtitle,
  .coach-card__copy,
  .answer-copy {
    font-size: 16px;
  }
  .coach-core,
  .coach-card,
  .answer-card {
    border-radius: 26px;
  }
  .coach-core {
    padding: 30px 26px 24px;
  }
  .coach-card,
  .answer-card {
    padding: 24px;
  }
  .coach-card__title,
  .answer-title,
  .answer-section-title,
  .citation-title {
    font-size: 18px;
  }
  .context-chip,
  .context-evidence,
  .semantic-state,
  .request-id,
  .progress-row__meta,
  .answer-meta,
  .citation-version,
  .citation-copy,
  .limitation-item,
  .quota-note {
    font-size: 13px;
  }
  .companion-composer {
    right: 50%;
    bottom: max(90px, calc(58px + env(safe-area-inset-bottom)));
    left: auto;
    width: min(100%, 760px);
    padding-right: 36px;
    padding-left: 36px;
    transform: translateX(50%);
  }
}
