.ink-pad {
  overflow: hidden;
  border: 1rpx solid rgba(0, 151, 139, 0.18);
  border-radius: 22rpx;
  background: #fbfdfc;
}
.ink-canvas {
  width: 100%;
  height: 310rpx;
  background-image: linear-gradient(rgba(0, 151, 139, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 151, 139, 0.06) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}
.ink-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  border-top: 1rpx solid rgba(41, 73, 65, 0.08);
}
.ink-clear,
.ink-recognize {
  flex: 1;
  margin: 0;
  border-radius: 16rpx;
  font-size: 23rpx;
  line-height: 72rpx;
}
.ink-clear {
  color: #52635f;
  background: #edf3f1;
}
.ink-recognize {
  color: #fff;
  background: #00978b;
}
.ink-clear::after,
.ink-recognize::after {
  border: 0;
}
