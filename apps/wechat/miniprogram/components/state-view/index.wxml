<view class="state state--{{type}}">
  <block wx:if="{{type === 'loading'}}">
    <view class="state__dots">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
    <view class="state__title state__title--muted">{{title || '正在读取…'}}</view>
  </block>

  <block wx:else>
    <view class="state__badge state__badge--{{type}}">
      <view class="state__badge-dot"></view>
    </view>
    <view class="state__title">{{title}}</view>
    <view wx:if="{{desc}}" class="state__desc">{{desc}}</view>
    <view wx:if="{{requestId}}" class="state__rid">编号 {{requestId}}</view>
    <view wx:if="{{actionText}}" class="state__action">
      <ui-button variant="{{type === 'error' ? 'primary' : 'ghost'}}" size="sm" bind:tap="onAction">{{actionText}}</ui-button>
    </view>
  </block>
</view>
