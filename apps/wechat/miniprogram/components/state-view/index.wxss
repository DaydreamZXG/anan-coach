.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
  text-align: center;
}

.state__dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.state__dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--grad-main);
  animation: state-breathe 1.4s ease-in-out infinite;
}

.state__dots .dot:nth-child(2) {
  animation-delay: 0.18s;
}

.state__dots .dot:nth-child(3) {
  animation-delay: 0.36s;
}

@keyframes state-breathe {
  0%, 100% {
    opacity: 0.25;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.state__badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.state__badge-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.state__badge--empty {
  background: rgba(91, 95, 244, 0.08);
}

.state__badge--empty .state__badge-dot {
  background: var(--indigo);
  opacity: 0.6;
}

.state__badge--error {
  background: rgba(224, 82, 82, 0.08);
}

.state__badge--error .state__badge-dot {
  background: var(--red);
}

.state__badge--partial {
  background: rgba(217, 127, 6, 0.1);
}

.state__badge--partial .state__badge-dot {
  background: var(--amber);
}

.state__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.5;
}

.state__title--muted {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--ink-3);
}

.state__desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.8;
  max-width: 480rpx;
}

.state__rid {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.state__action {
  margin-top: 32rpx;
}
