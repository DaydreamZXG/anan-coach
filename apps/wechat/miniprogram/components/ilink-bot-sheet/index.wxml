<ui-sheet
  visible="{{visible}}"
  title="微信里的岸岸"
  copy="连接当前账号后，可以直接问岸岸、发送裁剪好的题目图片，或查看今天的安排。"
  show-close
  max-height="84vh"
  bindclose="close"
>
  <view class="bot-sheet">
    <view wx:if="{{status === 'loading'}}" class="bot-state">正在核对连接状态…</view>

    <view wx:elif="{{status === 'error'}}" class="bot-error">
      <view class="bot-error__title">微信岸岸没有连接完成</view>
      <view class="bot-error__copy">{{errorMessage}}</view>
      <view wx:if="{{requestId}}" class="bot-error__request">问题编号 · {{requestId}}</view>
      <button hover-class="item--hover" class="bot-secondary" bindtap="load">重新读取</button>
    </view>

    <block wx:elif="{{view}}">
      <view wx:if="{{view.linkState === 'bound'}}" class="bot-connected">
        <view class="bot-connected__title">● 微信岸岸已连接</view>
        <view class="bot-connected__copy">{{view.usageCopy}}</view>
        <view class="bot-evidence">{{view.evidenceCopy}}</view>
      </view>

      <view wx:elif="{{view.linkState === 'pending' && view.bindingCode}}" class="bot-code-card">
        <view class="bot-code-label">把连接码发给微信里的岸岸 Bot</view>
        <view class="bot-code type-data">{{view.bindingCode}}</view>
        <view class="bot-code-copy">发送成功后回到这里重新读取，连接状态会自动按当前账号核对。</view>
        <button hover-class="item--hover" class="bot-primary tap-tactile" bindtap="copyCode">复制连接码</button>
        <button hover-class="item--hover" class="bot-secondary" loading="{{writing}}" disabled="{{writing}}" bindtap="replace">换一个连接码</button>
      </view>

      <view wx:elif="{{view.linkState === 'pending'}}" class="bot-error">
        <view class="bot-error__title">连接码已过期</view>
        <view class="bot-error__copy">重新生成一个连接码，再发给微信里的岸岸即可继续连接。</view>
        <button hover-class="item--hover" class="bot-primary tap-tactile" loading="{{writing}}" disabled="{{writing}}" bindtap="replace">重新生成连接码</button>
      </view>

      <button
        wx:elif="{{view.linkState === 'unbound' || view.linkState === 'revoked'}}"
        hover-class="item--hover"
        class="bot-primary tap-tactile"
        loading="{{writing}}"
        disabled="{{writing}}"
        bindtap="issue"
      >生成连接码</button>

      <button wx:if="{{view.linkState === 'bound'}}" hover-class="item--hover" class="bot-secondary" bindtap="load">重新读取状态</button>
      <button wx:if="{{view.linkId && view.linkState !== 'revoked'}}" hover-class="item--hover" class="bot-danger" loading="{{writing}}" disabled="{{writing}}" bindtap="revoke">解除连接</button>
    </block>
  </view>
</ui-sheet>
