<ui-sheet
  visible="{{visible}}"
  title="微信里的岸岸"
  copy="用微信扫码连接当前账号后，可以直接问岸岸、发送题目图片，或查看今天的安排。"
  show-close
  max-height="84vh"
  bindclose="close"
>
  <view class="bot-sheet">
    <view wx:if="{{status === 'loading'}}" class="bot-state">正在核对连接状态…</view>

    <view wx:elif="{{status === 'error'}}" class="bot-error">
      <view class="bot-error__title">微信岸岸没有连接完成</view>
      <view class="bot-error__copy">{{errorMessage}}</view>
      <view wx:if="{{requestId}}" class="bot-error__request">问题编号 · {{requestId}}</view>
      <button hover-class="item--hover" class="bot-secondary" bindtap="load">重新读取</button>
    </view>

    <block wx:elif="{{view}}">
      <view wx:if="{{view.state === 'connected'}}" class="bot-connected">
        <view class="bot-connected__title">● 微信岸岸已连接</view>
        <view class="bot-connected__copy">{{view.usageCopy}}</view>
        <view class="bot-evidence">连接仅对当前岸岸账号生效，解除后微信入口会立即停止读取学习记录。</view>
      </view>

      <view wx:elif="{{(view.state === 'waiting_scan' || view.state === 'scanned') && view.qrImageDataUrl}}" class="bot-qr-card bot-qr-card--{{view.state}}">
        <view class="bot-status-row">
          <view class="bot-status-dot bot-status-dot--{{view.state}}"></view>
          <view class="bot-status-copy">{{view.statusCopy}}</view>
        </view>
        <view class="bot-qr-frame">
          <image
            class="bot-qr-image"
            src="{{view.qrImageDataUrl}}"
            mode="aspectFit"
            show-menu-by-longpress
            aria-label="微信岸岸连接二维码"
          />
        </view>
        <view class="bot-qr-copy">{{view.usageCopy}}</view>
        <view class="bot-step-list">
          <view class="bot-step"><text class="bot-step__index">1</text><text>长按识别二维码，或用另一台设备扫码</text></view>
          <view class="bot-step"><text class="bot-step__index">2</text><text>在微信里确认连接，本页会自动更新</text></view>
        </view>
        <button wx:if="{{view.state === 'scanned'}}" hover-class="item--hover" class="bot-primary tap-tactile" loading="{{polling}}" disabled="{{polling}}" bindtap="poll">我已在微信确认</button>
        <button wx:else hover-class="item--hover" class="bot-secondary" loading="{{writing}}" disabled="{{writing}}" bindtap="replace">换一个二维码</button>
      </view>

      <view wx:elif="{{view.state === 'waiting_scan' || view.state === 'scanned' || view.state === 'reauth_required'}}" class="bot-error">
        <view class="bot-error__title">{{view.statusCopy}}</view>
        <view class="bot-error__copy">{{view.usageCopy}}</view>
        <button hover-class="item--hover" class="bot-primary tap-tactile" loading="{{writing}}" disabled="{{writing}}" bindtap="replace">重新生成二维码</button>
      </view>

      <button
        wx:elif="{{view.state === 'unbound' || view.state === 'revoked'}}"
        hover-class="item--hover"
        class="bot-primary tap-tactile"
        loading="{{writing}}"
        disabled="{{writing}}"
        bindtap="issue"
      >生成微信扫码二维码</button>

      <button wx:if="{{view.state === 'connected'}}" hover-class="item--hover" class="bot-secondary" bindtap="load">重新读取状态</button>
      <button wx:if="{{view.state === 'connected' || view.state === 'reauth_required'}}" hover-class="item--hover" class="bot-danger" loading="{{writing}}" disabled="{{writing}}" bindtap="revoke">解除连接</button>
    </block>
  </view>
</ui-sheet>
