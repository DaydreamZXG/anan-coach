.bot-sheet {
  padding-top: calc(28 * var(--rpx));
}

.bot-state,
.bot-error,
.bot-connected {
  box-sizing: border-box;
  width: 100%;
  padding: calc(28 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.55;
}

.bot-error {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.bot-error__title,
.bot-connected__title {
  color: inherit;
  font-size: var(--text-body-lg);
  font-weight: 800;
}

.bot-error__copy,
.bot-connected__copy {
  margin-top: calc(12 * var(--rpx));
}

.bot-error__request {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}

.bot-connected {
  background: var(--good-soft);
  color: var(--good);
}

.bot-qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: calc(20 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
}

.bot-qr-image {
  width: calc(360 * var(--rpx));
  height: calc(360 * var(--rpx));
  border-radius: var(--radius-24);
}

.bot-qr-title {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-align: center;
}

.bot-qr-copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.55;
  text-align: center;
}

.bot-primary,
.bot-secondary,
.bot-danger {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(88 * var(--rpx));
  margin: calc(20 * var(--rpx)) 0 0;
  padding: 0 calc(28 * var(--rpx));
  border: 0;
  border-radius: var(--radius-capsule);
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: calc(88 * var(--rpx));
  text-align: center;
}

.bot-primary {
  background: var(--ink);
  color: var(--color-surface);
}

.bot-secondary {
  border: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface);
  color: var(--ink);
}

.bot-danger {
  background: transparent;
  color: var(--danger);
}

.bot-primary::after,
.bot-secondary::after,
.bot-danger::after {
  border: 0;
}

@media (min-width: 768px) {
  .bot-qr-image {
    width: 300px;
    height: 300px;
  }
}
