.bot-sheet {
  padding-top: calc(28 * var(--rpx));
}

.bot-state,
.bot-error,
.bot-connected {
  box-sizing: border-box;
  width: 100%;
  padding: calc(28 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--bg);
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.55;
}

.bot-error {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.bot-error__title,
.bot-connected__title {
  color: inherit;
  font-size: var(--text-body-lg);
  font-weight: 800;
}

.bot-error__copy,
.bot-connected__copy {
  margin-top: calc(12 * var(--rpx));
}

.bot-error__request {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-family: var(--font-family-data);
  font-size: var(--text-micro);
}

.bot-connected {
  background: var(--good-soft);
  color: var(--good);
}

.bot-qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: calc(20 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
}

.bot-status-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(12 * var(--rpx));
}

.bot-status-dot {
  width: calc(14 * var(--rpx));
  height: calc(14 * var(--rpx));
  flex: none;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 0 0 calc(8 * var(--rpx)) var(--color-primary-soft);
}

.bot-status-dot--scanned {
  background: var(--color-success);
  box-shadow: 0 0 0 calc(8 * var(--rpx)) var(--color-success-soft);
}

.bot-status-copy {
  color: var(--ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
  text-align: center;
}

.bot-qr-frame {
  display: flex;
  width: calc(420 * var(--rpx));
  max-width: 76vw;
  aspect-ratio: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin-top: calc(28 * var(--rpx));
  padding: calc(18 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-24);
  background: var(--surface);
  box-shadow: var(--shadow-crisp);
}

.bot-qr-image {
  width: 100%;
  height: 100%;
}

.bot-qr-copy,
.bot-evidence {
  margin-top: calc(20 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.55;
  text-align: center;
}

.bot-step-list {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx));
  box-sizing: border-box;
  border-radius: var(--radius-24);
  background: var(--bg);
}

.bot-step {
  display: flex;
  align-items: center;
  gap: calc(14 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.45;
}

.bot-step__index {
  display: flex;
  width: calc(34 * var(--rpx));
  height: calc(34 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-family: var(--font-family-data);
  font-weight: 800;
}

.bot-evidence {
  color: var(--ink-3);
  text-align: left;
}

.bot-primary,
.bot-secondary,
.bot-danger {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(88 * var(--rpx));
  margin: calc(20 * var(--rpx)) 0 0;
  padding: 0 calc(28 * var(--rpx));
  border: 0;
  border-radius: var(--radius-capsule);
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: calc(88 * var(--rpx));
  text-align: center;
}

.bot-primary {
  background: var(--ink);
  color: var(--color-surface);
}

.bot-secondary {
  border: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface);
  color: var(--ink);
}

.bot-danger {
  background: transparent;
  color: var(--danger);
}

.bot-primary::after,
.bot-secondary::after,
.bot-danger::after {
  border: 0;
}

@media (min-width: 600px) {
  .bot-qr-frame {
    width: 220px;
    max-width: 220px;
    padding: 10px;
    border-radius: 18px;
  }

  .bot-qr-card {
    padding: 24px;
  }
}
