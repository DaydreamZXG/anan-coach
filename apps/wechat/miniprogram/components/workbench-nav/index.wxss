.workbench-nav-placeholder {
  width: 100%;
}

.workbench-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  background: #f7f9fc;
}

.workbench-nav__back {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #111827;
  font-size: 54rpx;
  font-weight: 400;
}

.workbench-nav__title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.item--hover {
  opacity: 0.6;
}
