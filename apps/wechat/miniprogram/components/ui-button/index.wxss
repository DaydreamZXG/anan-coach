.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  line-height: 1;
  padding: 0 48rpx;
  height: 96rpx;
  transition: transform 0.1s ease, opacity 0.15s ease;
}

.btn::after {
  border: none;
}

.btn--md {
  height: 96rpx;
  padding: 0 48rpx;
  font-size: 26rpx;
}

.btn--sm {
  height: 72rpx;
  padding: 0 36rpx;
  font-size: 24rpx;
  border-radius: 22rpx;
}

.btn--block {
  display: flex;
  width: 100%;
}

.btn--primary {
  color: #ffffff;
  background: var(--grad-main);
  box-shadow: var(--shadow-glow);
}

.btn--ghost {
  color: var(--ink);
  background: var(--surface);
  border: 1rpx solid rgba(16, 19, 27, 0.14);
  box-shadow: 0 2rpx 6rpx rgba(16, 19, 27, 0.05);
}

.btn--pressed {
  transform: translateY(2rpx) scale(0.99);
  opacity: 0.92;
}

.is-disabled {
  opacity: 0.45;
}

.btn__spinner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: btn-spin 0.8s linear infinite;
}

.btn--ghost .btn__spinner {
  border-color: rgba(16, 19, 27, 0.15);
  border-top-color: var(--ink);
}

@keyframes btn-spin {
  to {
    transform: rotate(360deg);
  }
}
