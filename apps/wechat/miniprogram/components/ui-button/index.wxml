<button
  class="btn btn--{{variant}} btn--{{size}} {{block ? 'btn--block' : ''}} {{disabled || loading ? 'is-disabled' : ''}}"
  hover-class="{{disabled || loading ? 'none' : 'btn--pressed'}}"
  disabled="{{disabled || loading}}"
  bind:tap="onTap"
>
  <view wx:if="{{loading}}" class="btn__spinner"></view>
  <slot></slot>
</button>
