/* 计划依据页：骨架与卡片全部来自 s9；这里只保留证据列表、
 * 因子网格与步骤时间线等页面特有节点。 */

.judgment-heading {
  display: flex;
  align-items: center;
  gap: calc(16 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-body);
  font-weight: 800;
}

.judgment-spark {
  font-size: var(--text-section);
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: calc(20 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}

.evidence-item {
  display: flex;
  align-items: flex-start;
  gap: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 500;
  line-height: 1.6;
}

.evidence-dot {
  width: calc(12 * var(--rpx));
  height: calc(12 * var(--rpx));
  flex: none;
  margin-top: calc(16 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary-bright);
}

.basis-detail {
  margin-top: calc(32 * var(--rpx));
}

.factor-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  padding: calc(24 * var(--rpx));
  border-radius: var(--radius-40);
  background: var(--bg);
}

.factor-item {
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-surface);
}

.factor-label {
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.factor-value {
  margin-top: calc(8 * var(--rpx));
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.factor-item--primary .factor-value {
  color: var(--color-ink);
}

.factor-item--warning .factor-value {
  color: var(--figma-color-warning-deep);
}

.invalidation-block {
  margin-top: calc(24 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border-radius: var(--radius-32);
  background: var(--bg);
}

.invalidation-title {
  font-size: var(--text-caption);
  font-weight: 700;
}

.invalidation-item {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.55;
}

button.basis-toggle {
  display: inline-flex;
  width: auto;
  align-items: center;
  gap: calc(8 * var(--rpx));
  margin-top: calc(32 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: rgba(238, 242, 255, 0.5);
  color: var(--primary);
  font-size: var(--text-body);
  font-weight: 700;
}

.basis-toggle__arrow--open {
  display: inline-block;
  transform: rotate(180deg);
}

.steps-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: calc(40 * var(--rpx));
}

.steps-line {
  position: absolute;
  top: calc(64 * var(--rpx));
  bottom: calc(64 * var(--rpx));
  left: calc(51 * var(--rpx));
  width: calc(2 * var(--rpx));
  background: var(--line);
}

.step-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: calc(28 * var(--rpx));
}

.step-number {
  display: flex;
  width: calc(40 * var(--rpx));
  height: calc(40 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--ink);
  color: var(--color-surface);
  font-size: var(--text-micro);
  font-weight: 700;
  box-shadow: var(--shadow-crisp);
}

.step-number--active {
  background: var(--primary);
  box-shadow: var(--shadow-ai);
}

.step-title {
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.step-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.6;
}

.criteria-card {
  display: flex;
  flex-direction: column;
  gap: calc(28 * var(--rpx));
  overflow: hidden;
  padding-bottom: 0;
}

.criteria-row {
  display: flex;
  align-items: flex-start;
  gap: calc(20 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.5;
}

.criteria-check {
  color: var(--good);
  font-size: var(--text-section);
  font-weight: 800;
}

.criteria-boundary {
  margin: 0 calc(-32 * var(--rpx));
  padding: calc(32 * var(--rpx));
  background: rgba(249, 250, 251, 0.68);
  color: var(--ink-2);
  font-size: var(--text-body);
  font-weight: 500;
  line-height: 1.6;
}

.basis-empty {
  text-align: center;
}

.basis-footer__links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: calc(24 * var(--rpx));
  padding: 0 calc(32 * var(--rpx));
}

button.basis-link {
  width: auto;
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.basis-link--anan {
  color: var(--primary);
}

.basis-footer__divider {
  width: calc(1 * var(--rpx));
  height: calc(24 * var(--rpx));
  background: var(--figma-color-line-emphasis);
}
