/*
 * reduce-motion 探针：不参与视觉，只把系统"减少动效"读进逻辑层。
 * 高度是检测标记而非视觉尺寸，保持 px 字面量以获得确定的测量值。
 */
.count-up__probe {
  position: fixed;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
  visibility: hidden;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .count-up__probe {
    height: 1px;
  }
}
