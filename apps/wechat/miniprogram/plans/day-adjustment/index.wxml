<view class="s9-screen">
  <workbench-nav id="runtime-workbench-nav" title="调整今天" back-behavior="emit" bind:back="exit" />

  <view class="s9-body s9-body--with-dock adjustment-content">
    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="今天的安排没加载出来"
      description="{{errorMessage}}"
      request-id="{{requestId}}"
      action-text="再试一次"
      bind:action="retry"
    />

    <block wx:elif="{{status === 'ready' && dashboard}}">
      <block wx:if="{{step === 'edit'}}">
        <view class="s9-hero">
          <view class="s9-title">今天变了，计划也可以跟着变</view>
          <view class="s9-subtitle">告诉岸岸还剩多少时间，先保住最值得做的。</view>
        </view>

        <view class="s9-stack">
          <view class="s9-card current-card">
            <view class="current-card__label">当前安排</view>
            <view class="current-card__chips">
              <view class="current-chip current-chip--blue">{{currentDurationLabel === '今天不安排' ? currentDurationLabel : '共 ' + currentDurationLabel}}</view>
              <view class="current-chip">{{currentTaskCount > 0 ? currentTaskCount + ' 项任务' : '暂无任务'}}</view>
            </view>
            <view wx:if="{{currentTaskCount > 0}}" class="current-card__focus">当前重点：<text class="current-card__focus-value">{{currentFocus}}</text></view>
            <view wx:else class="current-card__focus">当前没有待完成任务；修改可用时间后，岸岸会重新给你安排。</view>
          </view>
        </view>

        <view class="s9-section">
          <view class="s9-section-head">
            <view>
              <view class="s9-section-title">今天重点练什么</view>
              <view class="focus-caption">选“综合安排”时，岸岸继续兼顾行测与申论。</view>
            </view>
          </view>
          <view class="s9-card focus-card">
            <view class="focus-options">
              <button
                hover-class="item--hover"
                wx:for="{{focusOptions}}"
                wx:key="value"
                class="control-center focus-option {{preferredTrack === item.track && (item.track !== 'xingce' || preferredXingceModule === item.value) ? 'focus-option--active' : ''}}"
                data-value="{{item.value}}"
                disabled="{{previewing || submitting}}"
                bindtap="chooseFocus"
              >{{item.label}}</button>
            </view>
            <button
              wx:if="{{preferredXingceModule}}"
              hover-class="item--hover"
              class="focus-only {{xingceOnly ? 'focus-only--active' : ''}}"
              disabled="{{previewing || submitting}}"
              bindtap="toggleXingceOnly"
            >
              <view class="focus-only__check">{{xingceOnly ? '✓' : ''}}</view>
              <view>
                <view class="focus-only__title">今天只练这一项</view>
                <view class="focus-only__copy">开启后，今天不再混排其他模块和申论。</view>
              </view>
            </button>
          </view>
        </view>

        <view class="s9-section">
          <view class="s9-section-head"><view class="s9-section-title">今天还能学多久</view></view>
          <view class="s9-card time-card">
            <view class="time-stepper">
              <button
                hover-class="item--hover"
                class="stepper-button {{minutes === 0 || previewing || submitting ? 'control-disabled' : ''}}"
                data-delta="-{{minutesStep}}"
                disabled="{{minutes === 0 || previewing || submitting}}"
                bindtap="adjustMinutes"
              >
                <view class="minus-icon"></view>
              </button>
              <view class="time-value">
                <text class="time-value__number">{{selectedDurationLabel}}</text>
              </view>
              <button
                hover-class="item--hover"
                class="stepper-button {{minutes >= 720 || previewing || submitting ? 'control-disabled' : ''}}"
                data-delta="{{minutesStep}}"
                disabled="{{minutes >= 720 || previewing || submitting}}"
                bindtap="adjustMinutes"
              >
                <view class="plus-icon"></view>
              </button>
            </view>
            <view class="time-presets">
              <button
                hover-class="item--hover"
                wx:for="{{timePresets}}"
                wx:key="minutes"
                class="control-center time-preset {{minutes === item.minutes ? 'time-preset--active' : ''}}"
                data-minutes="{{item.minutes}}"
                disabled="{{previewing || submitting}}"
                bindtap="chooseMinutes"
              >{{item.label}}</button>
            </view>
          </view>
        </view>

        <view class="s9-section">
          <view class="s9-section-head"><view class="s9-section-title">现在的精力</view></view>
          <view class="energy-options">
            <button
              hover-class="item--hover"
              wx:for="{{energyOptions}}"
              wx:key="value"
              class="control-center energy-option {{energy === item.value ? 'energy-option--active' : ''}}"
              data-value="{{item.value}}"
              disabled="{{previewing || submitting}}"
              bindtap="chooseEnergy"
            >{{item.label}}</button>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="s9-hero">
          <view class="s9-title">调整预览</view>
        </view>

        <view class="s9-stack">
          <view class="suggestion-card">
            <view class="suggestion-card__aurora"></view>
            <view class="suggestion-card__content">
              <view class="suggestion-card__heading"><text class="suggestion-card__spark">✦</text><view>岸岸建议</view></view>
              <view class="suggestion-card__headline">{{previewHeadline}}</view>
              <view class="suggestion-card__copy">{{previewRationale}}</view>
            </view>
          </view>
        </view>

        <view class="s9-section">
          <view class="s9-section-head"><view class="s9-section-title">本次变动明细</view></view>
          <view wx:if="{{previewChanges.length}}" class="change-list">
            <view wx:for="{{previewChanges}}" wx:key="id" class="s9-card change-card change-card--{{item.tone}}">
              <view class="change-card__top">
                <view class="change-tag change-tag--{{item.tone}}">{{item.label}}</view>
                <view class="change-duration type-data">{{item.duration}}</view>
              </view>
              <view class="change-title">{{item.title}}</view>
              <view class="change-copy">{{item.description}}</view>
            </view>
          </view>
          <view wx:else class="s9-card change-empty">任务内容不变，只更新今天的时间和状态。</view>
        </view>

        <view class="s9-stack">
          <view class="s9-card impact-card">
            <image class="impact-card__icon" src="/assets/icons/today/target-muted.png" mode="aspectFit" />
            <view>
              <view class="impact-card__title">对目标节奏的影响</view>
              <view class="impact-card__copy">{{previewImpact}}</view>
            </view>
          </view>

          <view class="adjustment-note">
            <view class="adjustment-note__icon">i</view>
            <view>没完成的内容不会硬留到明天。确认后，岸岸会按你现在的时间重新排今天。</view>
          </view>
        </view>
      </block>

      <view wx:if="{{errorMessage}}" class="s9-inline-error">{{errorMessage}}</view>
    </block>
  </view>

  <view wx:if="{{status === 'ready' && dashboard}}" class="s9-action-dock">
    <button
      hover-class="item--hover"
      wx:if="{{step === 'edit'}}"
      class="s9-primary-button tap-tactile {{previewing || submitting ? 's9-primary-button--disabled' : ''}}"
      loading="{{previewing}}"
      disabled="{{previewing || submitting}}"
      bindtap="generatePreview"
    >生成调整预览</button>
    <view wx:else class="s9-action-row">
      <button
        hover-class="item--hover"
        class="s9-secondary-button {{submitting ? 'control-disabled' : ''}}"
        disabled="{{submitting}}"
        bindtap="backToEdit"
      >返回修改</button>
      <button
        hover-class="item--hover"
        class="s9-primary-button tap-tactile {{submitting ? 's9-primary-button--disabled' : ''}}"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="confirmAdjustment"
      >确认今天这样安排</button>
    </view>
  </view>
</view>
