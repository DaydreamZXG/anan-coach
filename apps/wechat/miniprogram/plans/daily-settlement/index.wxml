<view class="s9-screen">
  <workbench-nav id="runtime-workbench-nav" title="今日结算" back-behavior="emit" bind:back="exit" />

  <view class="s9-body s9-body--with-dock settlement-content">
    <state-view wx:if="{{status === 'loading'}}" state="loading" />
    <state-view
      wx:elif="{{status === 'error'}}"
      state="error"
      title="结算没有加载成功"
      description="{{errorMessage}}"
      request-id="{{requestId}}"
      action-text="重新加载"
      bind:action="retry"
    />

    <block wx:elif="{{settlement}}">
      <view class="s9-hero fade-slide-in">
        <view class="s9-title">今天到这里，看看真正留下了什么</view>
        <view class="s9-subtitle">不比刷了多少，只看哪些变化值得带到明天。</view>
      </view>

      <view class="settlement-metrics fade-slide-in fade-slide-in--2">
        <view class="settlement-metric">
          <view class="metric-label">原计划</view>
          <view class="metric-value">{{scheduledLabel}}</view>
        </view>
        <view class="settlement-metric settlement-metric--actual">
          <view class="metric-label">实际学习</view>
          <view class="metric-value">{{elapsedLabel}}</view>
        </view>
        <view class="settlement-metric">
          <view class="metric-label">完成</view>
          <view class="metric-value">{{completionLabel}}</view>
        </view>
      </view>
      <view class="variance-label fade-slide-in fade-slide-in--2">{{varianceLabel}}</view>

      <view class="s9-section fade-slide-in fade-slide-in--3">
        <view class="section-heading">
          <view class="section-heading__mark">◎</view>
          <view>今天确认了什么</view>
        </view>
        <view wx:if="{{hasSummary}}" class="s9-card confirmation-card">
          <view class="settlement-summary">{{settlement.summary}}</view>
          <view class="evidence-note">
            <text>完成 {{settlement.completedTaskCount}} 项 · 累计 </text><count-up value="{{settlement.elapsedMinutes}}" /><text> 分钟 · 来自今天的真实记录</text>
          </view>
        </view>
        <view wx:else class="s9-card">
          <view class="s9-card-title">今天还没有形成可确认的变化</view>
          <view class="s9-card-copy">当前没有结算总结。回到今日页完成任务后，再来查看真实记录。</view>
        </view>
      </view>

      <view wx:if="{{settlement.newRisks.length}}" class="s9-section fade-slide-in fade-slide-in--3">
        <view class="section-heading section-heading--warning">
          <view class="section-heading__mark">!</view>
          <view>今天新发现的问题</view>
        </view>
        <view class="s9-card risk-card">
          <view wx:for="{{settlement.newRisks}}" wx:key="*this" class="risk-item">{{item}}</view>
        </view>
      </view>

      <view class="s9-section fade-slide-in fade-slide-in--3">
        <view class="section-heading">
          <view class="section-heading__mark">○</view>
          <view>没完成的这一项</view>
        </view>
        <view wx:if="{{primaryOpenTask}}" class="s9-card">
          <view class="s9-card-title">{{primaryOpenTask.title}}</view>
          <view class="unfinished-meta">
            {{primaryOpenTask.trackLabel}} · 计划 {{primaryOpenTask.plannedLabel}} ·
            {{primaryOpenTask.statusLabel}}
          </view>
          <view class="unfinished-note">没有完成的任务不会自动变成学习欠账。</view>
          <view wx:if="{{additionalOpenTaskCount > 0}}" class="unfinished-more">
            另外还有 {{additionalOpenTaskCount}} 项未完成，可在今日页查看。
          </view>
        </view>
        <view wx:else class="s9-card">
          <view class="s9-card-title">今天没有未完成的任务</view>
          <view class="s9-card-copy">已安排任务都已闭环，可以直接结束今天。</view>
        </view>
      </view>

      <view class="s9-section fade-slide-in fade-slide-in--3">
        <view class="section-heading">
          <view class="section-heading__mark">↗</view>
          <view>明天从哪里开始</view>
        </view>
        <view class="s9-card tomorrow-card">
          <view class="s9-card-title">明天的第一项还没有生成</view>
          <view class="s9-card-copy">
            新的日计划形成后会显示在今日页；现在可以先查看本周安排。
          </view>
          <button hover-class="item--hover" class="tomorrow-card__action" bindtap="openWeeklyPlan">查看本周计划</button>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{settlement}}" class="s9-action-dock settlement-dock">
    <button hover-class="item--hover" class="s9-primary-button settlement-primary tap-tactile" bindtap="returnToday" disabled="{{closing}}">
      {{closing ? '正在收好今天…' : '确认结算，结束今天'}}
    </button>
    <button hover-class="item--hover" class="settlement-companion" bindtap="askAnan">
      带着今天的结果问岸岸 <text>✦</text>
    </button>
  </view>

  <view wx:if="{{closing}}" class="settlement-ritual motion-mask" catchtouchmove="preventMove" catchtap="preventMove">
    <view class="settlement-ritual__sheet motion-sheet">
      <view class="settlement-seal {{closingHasActivity ? '' : 'settlement-seal--quiet'}} check-pop">
        <view class="settlement-seal__date">{{closingDate}}</view>
        <view class="settlement-seal__rule"></view>
        <view class="settlement-seal__word">收卷</view>
      </view>
      <view class="settlement-ritual__eyebrow">今日记录已确认</view>
      <view class="settlement-ritual__title">{{closingTitle}}</view>
      <view class="settlement-ritual__copy">{{closingCopy}}</view>
      <view class="settlement-ritual__meta">{{closingMeta}}</view>
      <view class="settlement-ritual__hint">即将回到今日</view>
    </view>
  </view>
</view>
