/* 今日结算：骨架、卡片与操作坞来自 s9；保留三格指标、
 * 分节标记与结算专属按钮。 */

.tomorrow-card__action::after,
.settlement-companion::after {
  border: 0;
}

.settlement-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--figma-space-12);
  margin-top: var(--figma-space-32);
}

.settlement-metric {
  box-sizing: border-box;
  min-width: 0;
  padding: var(--figma-space-20) var(--figma-space-12);
  border-radius: var(--figma-radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.settlement-metric--actual {
  background: var(--color-primary-soft);
}

.metric-label {
  color: var(--color-faint);
  font-size: var(--text-caption);
}

.metric-value {
  margin-top: var(--figma-space-8);
  overflow: hidden;
  font-size: var(--text-body-lg);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settlement-metric--actual .metric-label,
.settlement-metric--actual .metric-value {
  color: var(--color-ink);
}

.variance-label {
  margin-top: var(--figma-space-10);
  color: var(--color-faint);
  font-size: var(--text-caption);
  text-align: center;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: var(--figma-space-8);
  margin-bottom: calc(20 * var(--rpx));
  padding-left: var(--figma-space-4);
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.5 * var(--rpx));
}

.section-heading__mark {
  display: flex;
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
  align-items: center;
  justify-content: center;
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 800;
}

.section-heading--warning .section-heading__mark {
  color: var(--color-warning);
}

.confirmation-card {
  position: relative;
  overflow: hidden;
}

.settlement-summary {
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.65;
}

.evidence-note {
  margin-top: var(--figma-space-16);
  padding: var(--figma-space-12);
  border-radius: var(--figma-radius-xsmall);
  background: var(--figma-color-cyan-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.risk-card {
  border: calc(1 * var(--rpx)) solid var(--figma-color-warning-soft);
}

.risk-item {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 600;
  line-height: 1.65;
}

.risk-item + .risk-item {
  margin-top: var(--figma-space-10);
  padding-top: var(--figma-space-10);
  border-top: calc(1 * var(--rpx)) solid var(--color-line);
}

.unfinished-meta {
  margin-top: var(--figma-space-4);
  color: var(--color-faint);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.unfinished-note,
.unfinished-more {
  margin-top: var(--figma-space-16);
  padding: var(--figma-space-12);
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-canvas);
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.unfinished-more {
  margin-top: var(--figma-space-8);
}

.tomorrow-card {
  border: calc(1 * var(--rpx)) solid var(--color-primary-soft-strong);
  background: var(--color-primary-soft);
}

button.tomorrow-card__action {
  display: inline-flex;
  width: auto;
  align-items: center;
  justify-content: center;
  min-height: calc(68 * var(--rpx));
  margin: var(--figma-space-16) 0 0;
  padding: 0 var(--figma-space-16);
  border: 0;
  border-radius: var(--figma-radius-small);
  background: var(--color-surface);
  color: var(--color-primary-deep);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: calc(68 * var(--rpx));
}

button.settlement-primary {
  width: 100%;
}

.settlement-dock {
  background: var(--color-canvas);
  box-shadow: 0 calc(-12 * var(--rpx)) calc(32 * var(--rpx)) rgb(15 23 42 / 6%);
}

button.settlement-companion {
  width: 100%;
  min-height: calc(60 * var(--rpx));
  margin: calc(12 * var(--rpx)) 0 0;
  border: 0;
  background: none;
  color: var(--color-primary);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(60 * var(--rpx));
  pointer-events: auto;
  text-align: center;
}

.settlement-ritual {
  position: fixed;
  z-index: var(--z-overlay);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(48 * var(--rpx));
  background: var(--color-mask-strong);
  inset: 0;
}

.settlement-ritual__sheet {
  box-sizing: border-box;
  width: 100%;
  max-width: calc(590 * var(--rpx));
  padding: calc(54 * var(--rpx)) calc(44 * var(--rpx)) calc(40 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-a84);
  border-radius: calc(48 * var(--rpx));
  background: var(--color-surface-a96);
  box-shadow: var(--shadow-overlay);
  text-align: center;
}

.settlement-seal {
  display: flex;
  box-sizing: border-box;
  width: calc(150 * var(--rpx));
  height: calc(150 * var(--rpx));
  align-items: center;
  justify-content: center;
  flex-direction: column;
  margin: 0 auto calc(34 * var(--rpx));
  border: calc(4 * var(--rpx)) solid var(--color-primary-deep);
  border-radius: 50%;
  color: var(--color-primary-deep);
  transform: rotate(-4deg);
}

.settlement-seal--quiet {
  border-color: var(--color-muted);
  color: var(--color-muted);
}

.settlement-seal__date {
  font-size: var(--text-caption);
  font-weight: 800;
  letter-spacing: calc(2 * var(--rpx));
}

.settlement-seal__rule {
  width: calc(72 * var(--rpx));
  height: calc(2 * var(--rpx));
  margin: calc(8 * var(--rpx)) 0 calc(7 * var(--rpx));
  background: currentColor;
}

.settlement-seal__word {
  font-size: var(--text-body-lg);
  font-weight: 800;
  letter-spacing: calc(6 * var(--rpx));
  text-indent: calc(6 * var(--rpx));
}

.settlement-ritual__eyebrow {
  color: var(--color-primary-deep);
  font-size: var(--text-caption);
  font-weight: 700;
  letter-spacing: calc(2 * var(--rpx));
}

.settlement-ritual__title {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-ink);
  font-size: calc(42 * var(--rpx));
  font-weight: 800;
  letter-spacing: calc(-1 * var(--rpx));
}

.settlement-ritual__copy {
  margin-top: calc(20 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-body);
  line-height: 1.75;
}

.settlement-ritual__meta {
  margin-top: calc(28 * var(--rpx));
  padding: calc(14 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--figma-radius-xsmall);
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.settlement-ritual__hint {
  margin-top: calc(20 * var(--rpx));
  color: var(--color-faint);
  font-size: var(--text-micro);
}

@media (min-width: 600px) {
  .settlement-ritual__sheet {
    max-width: 520px;
    padding: 42px 52px 34px;
  }

  .settlement-seal {
    width: 92px;
    height: 92px;
    margin-bottom: 26px;
  }

  .settlement-ritual__title {
    font-size: 28px;
  }
}
