<view class="s9-page workbench-page">
  <view class="workbench-hero">
    <view class="workbench-kicker">评分的门道</view>
    <view class="workbench-title essay-evidence-title"><text class="essay-evidence-title__phrase">为什么这样评，</text><text class="essay-evidence-title__phrase">逐条说清楚</text></view>
    <view class="workbench-copy">哪句得分、哪句扣分，对照材料原文和你的作答，一条条说清楚。</view>
  </view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="没加载出来" description="{{errorMessage}}" request-id="{{requestId}}" action-text="{{retryAllowed ? '重新加载' : ''}}" bind:action="retryLoad" />
  <block wx:elif="{{review && view}}">
    <view class="workbench-card"><view class="workbench-grid"><view class="workbench-metric"><view class="workbench-meta">踩中要点</view><text class="workbench-metric__value">{{view.coveredPoints}} / {{view.totalPoints}}</text></view><view class="workbench-metric"><view class="workbench-meta">把握</view><text class="workbench-metric__value">{{view.confidenceLabel}}</text></view></view></view>
    <view wx:for="{{view.dimensions}}" wx:key="criterionCode" class="workbench-card"><view class="workbench-row-title">{{item.label}}</view><view class="dimension-bar"><view class="dimension-bar-fill" style="width: {{item.percent}}%"></view></view><view class="workbench-note">{{item.rationale}}</view><view class="evidence-quote">你的原文：{{item.answerQuote || '无'}}</view><view class="evidence-quote">材料原文：{{item.materialQuote || '无'}}</view></view>
    <view class="workbench-card"><view class="workbench-section-title">这次评分用了什么</view><view class="workbench-meta">评的是你确认过的答案，用的是题目材料和统一的评分规则；之后你再改，这次结果不会悄悄变。</view></view>
  </block>
</view>
