@import "../../features/external-learning/page-shell.wxss";

.packets-state-view {
  display: block;
  margin-top: calc(32 * var(--rpx));
}

.content-row,
.packet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.content-row {
  min-height: calc(98 * var(--rpx));
  box-sizing: border-box;
  margin-top: calc(12 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
}

.content-row--selected {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.content-title {
  font-weight: 800;
}

.content-check {
  color: var(--color-muted);
  font-size: var(--text-section);
  font-weight: 800;
}

.packet-head {
  align-items: flex-start;
}

.packet-meta {
  display: grid;
  gap: calc(8 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  word-break: break-all;
}

.packet-actions {
  display: flex;
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}

.packet-action {
  min-height: calc(70 * var(--rpx));
  display: flex;
  align-items: center;
  padding: 0 calc(24 * var(--rpx));
  border-radius: var(--radius-control);
  background: var(--color-ink);
  color: var(--color-on-primary);
  font-size: var(--text-caption);
  font-weight: 800;
}

.packet-action--secondary {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}
