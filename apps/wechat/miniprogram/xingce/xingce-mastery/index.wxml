<view class="s9-page mastery-page">
  <view class="mastery-hero">
    <view class="hero-eyebrow">行测学习记录</view>
    <view class="hero-title">真正掌握，要经得住隔天再测</view>
    <view class="hero-copy">刷题量说了不算——隔天还会做、换个皮还会做，才算数。</view>
    <view wx:if="{{generatedAtLabel}}" class="hero-updated type-data">{{generatedAtLabel}}</view>
  </view>

  <button hover-class="item--hover" class="favorites-entry" bindtap="openFavorites">
    <view class="favorites-entry__copy">
      <view class="favorites-entry__title">收藏题目</view>
      <view class="favorites-entry__description">长期保存、跨设备找回；不占用错题与掌握分组</view>
    </view>
    <view class="favorites-entry__arrow" aria-hidden="true">›</view>
  </button>

  <view class="bucket-tabs" role="tablist" aria-label="错题与掌握分组">
    <view hover-class="item--hover"
      wx:for="{{tabs}}"
      wx:key="bucket"
      class="bucket-tab {{item.active ? 'bucket-tab--active' : ''}}"
      role="tab"
      aria-selected="{{item.active}}"
      data-bucket="{{item.bucket}}"
      bindtap="selectBucket"
    >
      <text>{{item.label}}</text>
      <text class="bucket-count type-data">{{item.count}}</text>
    </view>
  </view>

  <state-view wx:if="{{status === 'loading'}}" custom-class="mastery-state-view" state="loading" title="正在加载掌握队列" description="已同步最新数据。" />

  <state-view
    wx:elif="{{status === 'error'}}"
    custom-class="mastery-state-view"
    state="error"
    title="{{errorTitle}}"
    description="{{errorMessage}}"
    request-id="{{requestId}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <view wx:elif="{{status === 'unavailable'}}" class="account-gate">
    <state-view custom-class="mastery-state-view" state="error" title="{{errorTitle}}" description="{{errorMessage}}" />
    <ui-button wx:if="{{showLoginAction}}" custom-class="mastery-state-action" label="重新登录" bind:action="goLogin" />
  </view>

  <block wx:else>
    <view wx:if="{{activeBucket === 'invalidated'}}" class="withdrawn-notice">
      <view class="notice-title">内容已撤回，不再污染掌握判断</view>
      <view class="notice-copy">这里仅保留撤回事实和历史记录；撤回项目不会进入复盘、复测或稳定掌握统计。</view>
    </view>

    <view wx:if="{{partialErrorMessage}}" class="partial-warning">
      <view>{{partialErrorMessage}}</view>
    <view wx:if="{{partialRequestId}}" class="type-data">问题编号 · {{partialRequestId}}</view>
      <button hover-class="item--hover" class="warning-action" bindtap="retryLoadMore">按原游标重试</button>
    </view>

    <state-view wx:if="{{!items.length}}" custom-class="mastery-state-view" state="empty" title="{{emptyTitle}}" description="{{emptyDescription}}" />

    <view class="mastery-grid">
    <view wx:for="{{items}}" wx:key="itemId" class="mastery-card {{item.invalidated ? 'mastery-card--invalidated' : ''}}">
      <view class="card-head">
        <view class="card-title-wrap">
          <view class="card-title">{{item.title}}</view>
          <view class="card-stage">{{item.stageLabel}}</view>
        </view>
        <view class="state-pill state-pill--{{item.bucket}}">{{item.stateLabel}}</view>
      </view>
      <view class="evidence-row">
        <text>{{item.dateLabel}}</text>
        <text>{{item.questionLabel}}</text>
        <text>{{item.evidenceLabel}}</text>
      </view>
      <view wx:if="{{item.invalidated}}" class="invalidated-copy">这道题已下线，还能看到当时的记录，但不再计入能力分析。</view>
      <button hover-class="item--hover"
        wx:if="{{item.actionAvailable}}"
        class="card-action {{item.actionState === 'awaiting_plan' ? 'card-action--secondary' : ''}}"
        data-itemid="{{item.itemId}}"
        bindtap="openItem"
      >{{item.actionLabel}}</button>
    </view>
    </view>

    <view wx:if="{{items.length}}" class="pagination">
      <button hover-class="item--hover" wx:if="{{hasMore && !loadingMore && !partialErrorMessage}}" class="load-more" bindtap="loadMore">加载更多</button>
      <view wx:elif="{{loadingMore}}" class="page-note">正在读取下一页记录…</view>
      <view wx:elif="{{!hasMore}}" class="page-note">已显示当前分组全部记录</view>
    </view>
  </block>
</view>
