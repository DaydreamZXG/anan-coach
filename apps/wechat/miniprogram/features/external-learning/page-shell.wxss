.external-page {
  padding-bottom: calc(96 * var(--rpx));
}

.external-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(4 * var(--rpx)) calc(28 * var(--rpx));
  color: var(--color-ink);
}

.external-hero__copy {
  flex: 1;
  min-width: 0;
}

.external-eyebrow {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: calc(2 * var(--rpx));
}

.external-title {
  margin-top: calc(12 * var(--rpx));
  font-size: var(--text-title-lg);
  font-weight: 800;
  line-height: 1.25;
}

.external-subtitle {
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.65;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
  margin: calc(40 * var(--rpx)) calc(4 * var(--rpx)) calc(20 * var(--rpx));
}

.section-head__title {
  font-size: var(--text-section);
  font-weight: 800;
}

.section-head__meta {
  color: var(--color-muted);
  font-size: var(--text-micro);
  text-align: right;
}

.external-card {
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.external-card + .external-card {
  margin-top: calc(20 * var(--rpx));
}

.card-title {
  font-size: var(--text-section);
  font-weight: 800;
}

.card-copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
}

.choice {
  min-height: calc(72 * var(--rpx));
  box-sizing: border-box;
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.choice--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.action-stack {
  display: grid;
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}

.inline-note,
.inline-error,
.inline-success,
.inline-warning {
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-compact);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.inline-note {
  background: var(--color-primary-soft);
  color: var(--color-muted);
}

.inline-error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.inline-warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.inline-success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.inline-link {
  margin-top: calc(12 * var(--rpx));
  font-weight: 800;
  text-decoration: underline;
}

.delivery-strip {
  display: grid;
  gap: calc(8 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-compact);
  background: var(--color-surface-glass);
  color: var(--color-muted);
  font-size: var(--text-micro);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: calc(42 * var(--rpx));
  padding: 0 calc(16 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
}

.status-pill--processing {
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}

.status-pill--success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-pill--danger {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.status-pill--warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.progress-track {
  overflow: hidden;
  height: calc(14 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-primary-soft);
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.field-label {
  display: block;
  margin: calc(24 * var(--rpx)) 0 calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.text-input,
.text-area {
  box-sizing: border-box;
  width: 100%;
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
  color: var(--color-ink);
  font-size: var(--text-body-lg);
}

.text-input {
  min-height: calc(84 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
}

.text-area {
  min-height: calc(180 * var(--rpx));
  padding: calc(24 * var(--rpx));
  line-height: 1.55;
}

.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  background: var(--color-mask-strong);
}

.confirmation-sheet {
  position: fixed;
  z-index: 91;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 84vh;
  padding: calc(34 * var(--rpx)) calc(28 * var(--rpx))
    calc(calc(34 * var(--rpx)) + env(safe-area-inset-bottom));
  border-radius: var(--radius-40) var(--radius-40) 0 0;
  background: var(--color-surface);
  box-shadow: var(--shadow-overlay);
}

.sheet-title {
  font-size: var(--text-title-sm);
  font-weight: 800;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: calc(16 * var(--rpx));
  margin-top: calc(28 * var(--rpx));
}

@media (min-width: 768px) {
  .external-page:not(.page) {
    box-sizing: border-box;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 32px calc(72px + env(safe-area-inset-bottom));
  }

  .external-hero {
    gap: 18px;
    padding: 12px 4px 20px;
  }

  .external-eyebrow,
  .section-head__meta,
  .status-pill,
  .delivery-strip {
    font-size: 13px;
  }

  .external-title {
    font-size: 34px;
  }

  .external-subtitle,
  .card-copy,
  .choice,
  .inline-note,
  .inline-error,
  .inline-success,
  .inline-warning,
  .field-label,
  .text-input,
  .text-area {
    font-size: 16px;
  }

  .external-card {
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .card-title,
  .section-head__title {
    font-size: 20px;
  }

  .confirmation-sheet {
    right: 50%;
    bottom: 24px;
    left: auto;
    width: calc(100% - 64px);
    max-width: 680px;
    padding: 24px;
    border-radius: 24px;
    transform: translateX(50%);
  }
}

@media (min-width: 1024px) {
  .external-page:not(.page) {
    max-width: 1040px;
    padding-right: 40px;
    padding-left: 40px;
  }
}
