.external-page {
  padding-bottom: 96rpx;
}

.external-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 4rpx 28rpx;
  color: var(--color-ink);
}

.external-hero__copy {
  flex: 1;
  min-width: 0;
}

.external-eyebrow {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.external-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.external-subtitle {
  margin-top: 14rpx;
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  line-height: 1.65;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 40rpx 4rpx 18rpx;
}

.section-head__title {
  font-size: var(--font-section);
  font-weight: 800;
}

.section-head__meta {
  color: var(--color-muted);
  font-size: var(--font-caption);
  text-align: right;
}

.external-card {
  padding: 30rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.external-card + .external-card {
  margin-top: 18rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
}

.card-copy {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.choice {
  min-height: 72rpx;
  box-sizing: border-box;
  padding: 18rpx 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  font-weight: 700;
}

.choice--active {
  border-color: rgba(0, 151, 139, 0.45);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.action-stack {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.inline-note,
.inline-error,
.inline-success,
.inline-warning {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: var(--radius-compact);
  font-size: 23rpx;
  line-height: 1.55;
}

.inline-note {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.inline-error {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.inline-warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.inline-success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.inline-link {
  margin-top: 10rpx;
  font-weight: 800;
  text-decoration: underline;
}

.delivery-strip {
  display: grid;
  gap: 6rpx;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-compact);
  background: var(--color-surface-glass);
  color: var(--color-muted);
  font-size: 21rpx;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface-soft);
  color: var(--color-muted);
  font-size: 21rpx;
  font-weight: 800;
}

.status-pill--processing {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.status-pill--success {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.status-pill--danger {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.status-pill--warning {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.progress-track {
  overflow: hidden;
  height: 14rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: var(--color-primary-soft);
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.field-label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: var(--color-ink-secondary);
  font-size: 24rpx;
  font-weight: 750;
}

.text-input,
.text-area {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-control);
  background: var(--color-surface-soft);
  color: var(--color-ink);
  font-size: 27rpx;
}

.text-input {
  min-height: 84rpx;
  padding: 0 22rpx;
}

.text-area {
  min-height: 180rpx;
  padding: 22rpx;
  line-height: 1.55;
}

.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  background: rgba(17, 20, 38, 0.52);
}

.confirmation-sheet {
  position: fixed;
  z-index: 91;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 84vh;
  padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: var(--color-surface);
  box-shadow: 0 -20rpx 70rpx rgba(17, 20, 38, 0.22);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

@media (min-width: 768px) {
  .external-page:not(.page) {
    box-sizing: border-box;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 32px calc(72px + env(safe-area-inset-bottom));
  }

  .external-hero {
    gap: 18px;
    padding: 12px 4px 20px;
  }

  .external-eyebrow,
  .section-head__meta,
  .status-pill,
  .delivery-strip {
    font-size: 13px;
  }

  .external-title {
    font-size: 34px;
  }

  .external-subtitle,
  .card-copy,
  .choice,
  .inline-note,
  .inline-error,
  .inline-success,
  .inline-warning,
  .field-label,
  .text-input,
  .text-area {
    font-size: 16px;
  }

  .external-card {
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .card-title,
  .section-head__title {
    font-size: 20px;
  }

  .confirmation-sheet {
    right: 50%;
    bottom: 24px;
    left: auto;
    width: calc(100% - 64px);
    max-width: 680px;
    padding: 24px;
    border-radius: 24px;
    transform: translateX(50%);
  }
}

@media (min-width: 1024px) {
  .external-page:not(.page) {
    max-width: 1040px;
    padding-right: 40px;
    padding-left: 40px;
  }
}
