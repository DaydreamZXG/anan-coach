.community-page {
  padding-bottom: calc(96 * var(--rpx));
}

.community-hero {
  position: relative;
  overflow: hidden;
  padding: calc(20 * var(--rpx)) calc(4 * var(--rpx)) calc(28 * var(--rpx));
  color: var(--color-ink);
}

.community-hero::after {
  position: absolute;
  top: calc(-104 * var(--rpx));
  right: calc(-76 * var(--rpx));
  width: calc(270 * var(--rpx));
  height: calc(270 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-a16);
  border-radius: 50%;
  background: var(--color-primary-a08);
  content: "";
}

.hero-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: calc(2 * var(--rpx));
}

.hero-title {
  margin-top: calc(16 * var(--rpx));
  max-width: calc(650 * var(--rpx));
  font-size: var(--text-title-lg);
  font-weight: 800;
}

.hero-copy {
  max-width: calc(570 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.7;
}

.privacy-strip {
  display: flex;
  align-items: flex-start;
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-a16);
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.privacy-dot {
  width: calc(12 * var(--rpx));
  height: calc(12 * var(--rpx));
  flex: none;
  margin-top: calc(12 * var(--rpx));
  border-radius: 50%;
  background: var(--color-cyan);
  box-shadow: 0 0 0 calc(7 * var(--rpx)) var(--color-primary-a08);
}

.community-section,
.community-card {
  margin-top: calc(24 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-community);
}

.section-label {
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: calc(1.5 * var(--rpx));
}

.section-title {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.45;
}

.section-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.field-label {
  display: block;
  margin: calc(24 * var(--rpx)) 0 calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.text-input,
.text-area {
  box-sizing: border-box;
  width: 100%;
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: 1.65;
}

.text-input {
  min-height: calc(84 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
}

.text-area {
  min-height: calc(190 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(12 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
}

.choice-card {
  min-height: calc(96 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
}

.choice-card--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.choice-title {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 800;
}

.choice-copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.45;
}

.boundary-note,
.warning-note,
.success-note {
  margin-top: calc(20 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.boundary-note {
  background: var(--color-primary-soft);
  color: var(--color-muted);
}

.warning-note {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.success-note {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.fixed-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

button.action-button.action-button {
  width: 100%;
  min-height: calc(80 * var(--rpx));
  margin: calc(24 * var(--rpx)) 0 0;
  border: 0;
  border-radius: var(--radius-24);
  background: var(--color-ink);
  color: var(--color-surface);
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: calc(80 * var(--rpx));
}

.action-button--disabled {
  background: var(--color-line-strong);
  color: var(--ink-3);
}

.secondary-button {
  background: var(--color-surface);
  color: var(--color-primary);
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
}

.danger-button {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.community-state-view {
  display: block;
  margin-top: calc(28 * var(--rpx));
}

.request-id {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-faint);
  font-size: var(--text-micro);
}
