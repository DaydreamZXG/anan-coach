.community-page {
  padding-bottom: 96rpx;
}

.community-hero {
  position: relative;
  overflow: hidden;
  padding: 20rpx 4rpx 28rpx;
  color: var(--color-ink);
}

.community-hero::after {
  position: absolute;
  top: -104rpx;
  right: -76rpx;
  width: 270rpx;
  height: 270rpx;
  border: 1rpx solid var(--color-primary-a16);
  border-radius: 50%;
  background: var(--color-primary-a08);
  content: "";
}

.hero-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 16rpx;
  max-width: 650rpx;
  font-size: var(--text-title-lg);
  font-weight: 800;
}

.hero-copy {
  max-width: 570rpx;
  margin-top: 16rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.7;
}

.privacy-strip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 20rpx;
  border: 1rpx solid var(--color-primary-a16);
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  line-height: 1.55;
}

.privacy-dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--color-cyan);
  box-shadow: 0 0 0 7rpx var(--color-primary-a08);
}

.community-section,
.community-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-community);
}

.section-label {
  color: var(--color-faint);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.section-title {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 800;
  line-height: 1.45;
}

.section-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.field-label {
  display: block;
  margin: 24rpx 0 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.text-input,
.text-area {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  color: var(--color-ink);
  font-size: var(--text-body);
  line-height: 1.65;
}

.text-input {
  min-height: 84rpx;
  padding: 0 24rpx;
}

.text-area {
  min-height: 190rpx;
  padding: 20rpx 24rpx;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.choice-card {
  min-height: 96rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
}

.choice-card--active {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.choice-title {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 800;
}

.choice-copy {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.45;
}

.boundary-note,
.warning-note,
.success-note {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-24);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.boundary-note {
  background: var(--color-primary-soft);
  color: var(--color-muted);
}

.warning-note {
  background: var(--color-warning-soft);
  color: var(--color-warning);
}

.success-note {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.fixed-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

button.action-button.action-button {
  width: 100%;
  min-height: 80rpx;
  margin: 24rpx 0 0;
  border: 0;
  border-radius: var(--radius-24);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: 80rpx;
}

.action-button--disabled {
  background: var(--color-line-strong);
  color: var(--ink-3);
}

.secondary-button {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.danger-button {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.community-state-view {
  display: block;
  margin-top: 28rpx;
}

.request-id {
  margin-top: 12rpx;
  color: var(--color-faint);
  font-size: var(--text-micro);
}
