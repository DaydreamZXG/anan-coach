.brain-page {
  position: relative;
}

.brain-hero {
  position: relative;
  margin: 16rpx 0 28rpx;
}

.brain-hero::after {
  display: none;
}

.brain-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--radius-12);
  background: var(--primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: 0;
}

.brain-title {
  margin-top: 20rpx;
  font-size: var(--text-title-lg);
  font-weight: 800;
  letter-spacing: -1.8rpx;
  line-height: 1.28;
}

.brain-copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: var(--text-body);
  line-height: 1.58;
}

.brain-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-40);
  background: var(--color-surface);
  box-shadow: var(--shadow-brain-card);
}

.brain-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
}

.brain-section-title {
  font-size: var(--text-body-lg);
  font-weight: 800;
}
.brain-section-meta {
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.brain-label {
  color: var(--ink-3);
  font-size: var(--text-micro);
}
.brain-value {
  margin-top: 8rpx;
  font-size: var(--text-section);
  font-weight: 800;
}
.brain-note {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: var(--text-micro);
  line-height: 1.65;
}

.brain-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.brain-row:last-child {
  border-bottom: 0;
}
.brain-row-main {
  min-width: 0;
  flex: 1;
}
.brain-row-title {
  font-size: var(--text-caption);
  font-weight: 800;
  line-height: 1.45;
}
.brain-row-copy {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.brain-arrow {
  color: var(--color-muted);
  font-size: var(--text-title-sm);
}

.brain-pill {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.brain-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.brain-metric {
  padding: 20rpx;
  border-radius: var(--radius-24);
  background: var(--bg);
}
.brain-metric__value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--text-body-lg);
}

.brain-action {
  width: 100%;
  margin-top: 24rpx;
  min-height: 96rpx;
  border-radius: var(--radius-control);
  background: var(--color-ink);
  color: var(--color-surface);
  font-size: var(--text-body-lg);
  font-weight: 800;
}

.brain-action--secondary {
  background: var(--primary-soft);
  color: var(--color-primary);
}

.brain-action::after,
.brain-secondary::after {
  border: 0;
}

.brain-secondary {
  min-height: 72rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-primary-soft-strong);
  border-radius: var(--radius-control);
  background: var(--primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
}
.brain-warning {
  margin-top: 16rpx;
  padding: 20rpx 20rpx;
  border-radius: var(--radius-16);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-micro);
  line-height: 1.6;
}
.brain-empty {
  text-align: center;
  color: var(--color-muted);
  line-height: 1.7;
}
.brain-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
  font-size: var(--text-caption);
  line-height: 1.6;
}

@media (min-width: 768px) {
  .brain-page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 32px 72px;
  }

  .brain-hero {
    margin: 10px 0 20px;
  }

  .brain-kicker,
  .brain-section-meta,
  .brain-label,
  .brain-pill,
  .brain-row-copy,
  .brain-note {
    font-size: 13px;
  }

  .brain-title {
    margin-top: 14px;
    font-size: 36px;
  }

  .brain-copy,
  .brain-row-title,
  .brain-empty,
  .brain-warning,
  .brain-textarea {
    font-size: 16px;
  }

  .brain-card {
    margin-top: 16px;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .brain-section-title,
  .brain-value {
    font-size: 20px;
  }

  .brain-grid {
    gap: 12px;
  }

  .brain-action {
    min-height: 52px;
    margin-top: 16px;
    font-size: 17px;
  }
}

@media (min-width: 1024px) {
  .brain-page {
    max-width: 1120px;
    padding-right: 40px;
    padding-left: 40px;
  }

  .brain-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
