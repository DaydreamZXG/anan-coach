.workbench-page {
  padding-bottom: calc(calc(112 * var(--rpx)) + env(safe-area-inset-bottom));
}

.workbench-hero {
  margin-bottom: calc(24 * var(--rpx));
  padding: calc(16 * var(--rpx)) 0 calc(28 * var(--rpx));
  color: var(--color-ink);
}

.workbench-kicker {
  margin-bottom: calc(12 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: calc(1 * var(--rpx));
}

.workbench-title {
  max-width: calc(650 * var(--rpx));
  font-size: var(--text-title-lg);
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: calc(-1 * var(--rpx));
}

.workbench-copy {
  margin-top: calc(20 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.7;
}

.workbench-card {
  margin-top: calc(20 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.workbench-section-title,
.workbench-row-title {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.workbench-note,
.workbench-text {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body-lg);
  line-height: 1.72;
  white-space: pre-wrap;
}

.workbench-meta {
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.5;
}

.workbench-pill {
  display: inline-flex;
  margin-bottom: calc(16 * var(--rpx));
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-capsule);
  color: var(--color-ink-secondary);
  background: var(--color-surface-soft);
  font-size: var(--text-micro);
  font-weight: 700;
}

.workbench-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.workbench-metric {
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
}

.workbench-metric__value {
  display: block;
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-section);
}

.workbench-action {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(88 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  color: var(--color-surface);
  border: 0;
  border-radius: var(--radius-capsule);
  background: var(--color-action);
  box-shadow: var(--shadow-primary-soft);
  font-size: var(--text-body-lg);
  font-weight: 700;
  line-height: 1.4;
}

.workbench-action--disabled {
  color: var(--color-faint);
  background: var(--color-line-strong);
}

.workbench-secondary-action {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(88 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  color: var(--color-primary-deep);
  border: calc(2 * var(--rpx)) solid var(--color-primary-a24);
  border-radius: var(--radius-capsule);
  background: var(--color-primary-soft);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: 1.4;
}

.workbench-secondary-action--disabled {
  color: var(--color-faint);
  border-color: var(--color-line-strong);
  background: var(--color-surface-soft);
}

.evidence-quote {
  margin-top: calc(16 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(20 * var(--rpx));
  border-left: calc(6 * var(--rpx)) solid var(--color-primary);
  border-radius: 0 var(--radius-12) var(--radius-12) 0;
  color: var(--color-ink-secondary);
  background: var(--color-primary-soft);
  font-size: var(--text-body);
  line-height: 1.65;
}

.dimension-bar {
  height: calc(12 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  overflow: hidden;
  border-radius: var(--radius-capsule);
  background: var(--color-primary-a08);
}

.dimension-bar-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.diff-equal,
.diff-delete,
.diff-insert {
  white-space: pre-wrap;
}

.diff-delete {
  color: var(--danger);
  background: var(--color-danger-soft);
  text-decoration: line-through;
}

.diff-insert {
  color: var(--good);
  background: var(--good-soft);
}

@media (min-width: 768px) {
  .workbench-page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 32px calc(72px + env(safe-area-inset-bottom));
  }

  .workbench-hero {
    margin-bottom: 18px;
    padding: 10px 0 18px;
  }

  .workbench-kicker,
  .workbench-meta,
  .workbench-pill {
    font-size: 13px;
  }

  .workbench-title {
    max-width: 680px;
    font-size: 34px;
    letter-spacing: -0.5px;
  }

  .workbench-copy,
  .workbench-note,
  .workbench-text,
  .evidence-quote {
    font-size: 16px;
  }

  .workbench-card {
    margin-top: 16px;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .workbench-section-title,
  .workbench-row-title {
    font-size: 20px;
  }

  .workbench-grid {
    gap: 12px;
    margin-top: 14px;
  }

  .workbench-action,
  .workbench-secondary-action {
    margin-top: 16px;
    font-size: 17px;
  }
}

@media (min-width: 1024px) {
  .workbench-page {
    max-width: 1120px;
    padding-right: 40px;
    padding-left: 40px;
  }

  .workbench-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
