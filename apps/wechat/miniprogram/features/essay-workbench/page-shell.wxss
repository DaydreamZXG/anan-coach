.workbench-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--color-ink);
  background: var(--color-canvas);
}

.workbench-hero {
  margin-bottom: 24rpx;
  padding: 14rpx 0 26rpx;
  color: var(--color-ink);
}

.workbench-kicker {
  margin-bottom: 12rpx;
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 760;
  letter-spacing: 1rpx;
}

.workbench-title {
  max-width: 650rpx;
  font-size: 46rpx;
  font-weight: 820;
  line-height: 1.28;
  letter-spacing: -1rpx;
}

.workbench-copy {
  margin-top: 18rpx;
  color: var(--color-ink-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.workbench-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.workbench-section-title,
.workbench-row-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 750;
}

.workbench-note,
.workbench-text {
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: 27rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.workbench-meta {
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.workbench-pill {
  display: inline-flex;
  margin-bottom: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
  font-size: 22rpx;
  font-weight: 700;
}

.workbench-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.workbench-metric {
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--color-surface-soft);
}

.workbench-metric__value {
  display: block;
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 30rpx;
}

.workbench-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  color: var(--color-surface);
  border: 0;
  border-radius: 999rpx;
  background: var(--color-action);
  box-shadow: var(--shadow-primary-soft);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.workbench-action--disabled {
  color: var(--color-faint);
  background: var(--color-line-strong);
}

.workbench-secondary-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  color: var(--color-primary-deep);
  border: 2rpx solid var(--color-primary-a24);
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.workbench-secondary-action--disabled {
  color: var(--color-faint);
  border-color: var(--color-line-strong);
  background: var(--color-surface-soft);
}

.evidence-quote {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid var(--color-primary);
  border-radius: 0 14rpx 14rpx 0;
  color: var(--color-ink-secondary);
  background: var(--color-primary-soft);
  font-size: 25rpx;
  line-height: 1.65;
}

.dimension-bar {
  height: 12rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--color-primary-a08);
}

.dimension-bar-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.diff-equal,
.diff-delete,
.diff-insert {
  white-space: pre-wrap;
}

.diff-delete {
  color: var(--danger);
  background: var(--color-danger-soft);
  text-decoration: line-through;
}

.diff-insert {
  color: var(--good);
  background: var(--good-soft);
}

@media (min-width: 768px) {
  .workbench-page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 32px calc(72px + env(safe-area-inset-bottom));
  }

  .workbench-hero {
    margin-bottom: 18px;
    padding: 10px 0 18px;
  }

  .workbench-kicker,
  .workbench-meta,
  .workbench-pill {
    font-size: 13px;
  }

  .workbench-title {
    max-width: 680px;
    font-size: 34px;
    letter-spacing: -0.5px;
  }

  .workbench-copy,
  .workbench-note,
  .workbench-text,
  .evidence-quote {
    font-size: 16px;
  }

  .workbench-card {
    margin-top: 16px;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .workbench-section-title,
  .workbench-row-title {
    font-size: 20px;
  }

  .workbench-grid {
    gap: 12px;
    margin-top: 14px;
  }

  .workbench-action,
  .workbench-secondary-action {
    margin-top: 16px;
    font-size: 17px;
  }
}

@media (min-width: 1024px) {
  .workbench-page {
    max-width: 1120px;
    padding-right: 40px;
    padding-left: 40px;
  }

  .workbench-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
