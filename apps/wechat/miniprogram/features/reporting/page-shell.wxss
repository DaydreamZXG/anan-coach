.report-chip {
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-weight: 700;
}
.report-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: calc(1 * var(--rpx));
}
.report-banner {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-caption);
  line-height: 1.55;
}
.report-conclusion {
  margin-top: calc(24 * var(--rpx));
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-primary-a24);
  border-radius: var(--radius-32);
  background: var(--color-primary-soft);
  box-shadow: var(--shadow-card);
}
.report-conclusion__label {
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: calc(1 * var(--rpx));
}
.report-conclusion__headline {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.45;
}
.report-conclusion__detail,
.report-next {
  margin-top: calc(12 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  line-height: 1.65;
}
.report-next {
  padding-top: calc(16 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--color-primary-a16);
  color: var(--color-ink-secondary);
}
.report-next--meta {
  margin-top: calc(4 * var(--rpx));
  padding-top: 0;
  border-top: 0;
  color: var(--color-muted);
}
button.report-next-action {
  width: 100%;
  min-height: calc(88 * var(--rpx));
  margin: calc(20 * var(--rpx)) 0 0;
  border-radius: var(--radius-24);
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: var(--text-body);
  font-weight: 700;
  line-height: calc(88 * var(--rpx));
}
.report-next-action::after {
  border: 0;
}
.report-next-action--anan {
  background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-primary) 100%);
  box-shadow: var(--shadow-primary-soft);
}
.report-next-action--secondary {
  margin-top: calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface);
  color: var(--color-primary);
  box-shadow: none;
}
.report-chart-list {
  display: grid;
  gap: calc(24 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}
.report-chart-empty {
  margin-top: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx)) calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-24);
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: var(--text-caption);
  line-height: 1.65;
  text-align: center;
}
.report-state {
  margin-top: calc(24 * var(--rpx));
}

@media (min-width: 768px) {
  .report-kicker,
  .report-conclusion__label {
    font-size: 13px;
  }

  .report-banner,
  .report-conclusion__detail,
  .report-next {
    font-size: 16px;
  }

  .report-conclusion {
    margin-top: 18px;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .report-conclusion__headline {
    font-size: 22px;
  }

  .report-next-action {
    min-height: 50px;
    margin-top: 16px;
    border-radius: 14px;
    font-size: 16px;
    line-height: 50px;
  }

  .report-chart-list {
    gap: 16px;
    margin-top: 16px;
  }
}

@media (min-width: 1024px) {
  .report-chart-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
