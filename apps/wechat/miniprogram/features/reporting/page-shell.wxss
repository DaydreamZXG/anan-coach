.report-page { box-sizing: border-box; min-height: 100vh; padding: 30rpx 32rpx calc(112rpx + env(safe-area-inset-bottom)); background: var(--color-canvas); }
.report-hero { padding: 16rpx 4rpx 26rpx; color: var(--color-ink); }
.report-kicker { color: var(--color-primary); font-size: 21rpx; font-weight: 760; letter-spacing: 1rpx; }
.report-title { max-width: 650rpx; margin-top: 14rpx; font-size: 46rpx; font-weight: 820; line-height: 1.28; }
.report-copy { margin-top: 16rpx; color: var(--color-ink-secondary); font-size: 25rpx; line-height: 1.68; }
.report-meta { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 22rpx; }
.report-meta__item { padding: 9rpx 16rpx; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary-deep); font-size: 20rpx; }
.report-banner { margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #fff4e7; color: #8a541d; font-size: 24rpx; line-height: 1.55; }
.report-conclusion { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid rgba(0,151,139,.28); border-radius: 28rpx; background: var(--color-primary-soft); box-shadow: var(--shadow-card); }
.report-conclusion__label { color: var(--color-primary); font-size: 21rpx; font-weight: 700; letter-spacing: 1rpx; }
.report-conclusion__headline { margin-top: 12rpx; color: var(--color-ink); font-size: 33rpx; font-weight: 720; line-height: 1.45; }
.report-conclusion__detail, .report-next { margin-top: 12rpx; color: var(--color-ink-secondary); font-size: 24rpx; line-height: 1.65; }
.report-next { padding-top: 16rpx; border-top: 1rpx solid rgba(0,151,139,.14); color: var(--color-ink-secondary); }
.report-next-action { width: 100%; min-height: 88rpx; margin: 20rpx 0 0; border-radius: 22rpx; background: var(--color-primary); color: #ffffff; font-size: 25rpx; font-weight: 760; line-height: 88rpx; }
.report-next-action::after { border: 0; }
.report-chart-list { display: grid; gap: 22rpx; margin-top: 22rpx; }
.report-state { margin-top: 24rpx; }

@media (min-width: 768px) {
  .report-page {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 32px calc(72px + env(safe-area-inset-bottom));
  }

  .report-hero {
    padding: 10px 4px 20px;
  }

  .report-kicker,
  .report-meta__item,
  .report-conclusion__label {
    font-size: 13px;
  }

  .report-title {
    max-width: 680px;
    font-size: 34px;
  }

  .report-copy,
  .report-banner,
  .report-conclusion__detail,
  .report-next {
    font-size: 16px;
  }

  .report-conclusion {
    margin-top: 18px;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
  }

  .report-conclusion__headline {
    font-size: 22px;
  }

  .report-next-action {
    min-height: 50px;
    margin-top: 16px;
    border-radius: 14px;
    font-size: 16px;
    line-height: 50px;
  }

  .report-chart-list {
    gap: 16px;
    margin-top: 16px;
  }
}

@media (min-width: 1024px) {
  .report-page {
    max-width: 1120px;
    padding-right: 40px;
    padding-left: 40px;
  }

  .report-chart-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
