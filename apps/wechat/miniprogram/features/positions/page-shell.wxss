  color: var(--color-ink-secondary);
}

.sheet-button--primary {
  background: var(--color-ink);
  color: var(--color-surface);
}

.evidence-sheet__card {
  margin-top: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--bg);
}

.evidence-sheet__label {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.evidence-sheet__copy,
.evidence-sheet__note {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  line-height: 1.62;
}

.evidence-sheet__note {
  padding: 0 calc(8 * var(--rpx));
}

button.context-card__link,
button.text-action,
button.evidence-link,
button.compare-link,
button.compare-corner,
button.secondary-pill,
button.compact-action-card__button,
button.quiet-action,
button.comparison-dock__clear,
button.comparison-dock__action,
button.filter-pill,
button.requirement-confirm__button,
button.detail-actions__compare-link,
button.choice {
  width: auto;
}

button.list-status--button,
button.anan-context-action,
button.comparison-choose,
button.goal-primary-button,
button.goal-quiet-button {
  width: 100%;
}

button.detail-actions__compare {
  width: calc(280 * var(--rpx));
}

button.detail-actions__primary,
button.sheet-button {
  width: auto;
}

button.sheet-close {
  width: calc(64 * var(--rpx));
}

@media (min-width: 700px) {
  .position-content,
  .position-search-panel {
    width: 100%;
    max-width: 1180px;
    margin-right: auto;
    margin-left: auto;
  }

  .position-content {
    padding-right: 40px;
    padding-left: 40px;
  }

  .position-card-grid,
  .discovery-list,
  .all-position-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .comparison-track {
    justify-content: center;
  }

  .detail-actions {
    right: 50%;
    left: auto;
    width: min(860px, 100%);
    transform: translateX(50%);
  }

  .position-sheet {
    right: 50%;
    left: auto;
    width: min(720px, 100%);
    transform: translateX(50%);
  }
}

/* 平板：对比列加宽居中，不再是 166px 小卡贴左。 */
@media (min-width: 1024px) {
  .position-content--compare {
    max-width: 1100px;
  }

  .comparison-track {
    justify-content: center;
    gap: 24px;
  }

  .comparison-column {
    width: 340px;
    min-height: auto;
    padding: 24px;
  }
}
