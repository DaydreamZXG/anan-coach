/* Bottom sheets */
.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  background: var(--color-mask-soft);
}

.position-sheet {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 88vh;
  overflow-y: auto;
  padding: calc(12 * var(--rpx)) calc(40 * var(--rpx))
    calc(calc(40 * var(--rpx)) + env(safe-area-inset-bottom));
  border-radius: var(--radius-64) var(--radius-64) 0 0;
  background: var(--color-surface);
  box-shadow: var(--shadow-dock-strong);
}

.sheet-handle {
  width: calc(80 * var(--rpx));
  height: calc(10 * var(--rpx));
