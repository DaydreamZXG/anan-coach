  font-size: var(--text-micro);
  font-weight: 700;
}

.sheet-title {
  color: var(--color-ink);
  font-size: var(--text-title);
  font-weight: 700;
}

.sheet-close {
  width: calc(64 * var(--rpx));
  height: calc(64 * var(--rpx));
  flex: none;
  border-radius: 50%;
  background: var(--bg);
