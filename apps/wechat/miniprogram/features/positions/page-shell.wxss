.position-page,
.position-screen {
  position: relative;
}

.position-screen {
  overflow: hidden;
}

.position-screen--dock {
  padding-bottom: calc(calc(170 * var(--rpx)) + env(safe-area-inset-bottom));
}

.position-screen--detail {
  padding-bottom: calc(calc(260 * var(--rpx)) + env(safe-area-inset-bottom));
}

.position-content {
  box-sizing: border-box;
  padding: calc(8 * var(--rpx)) calc(40 * var(--rpx)) calc(80 * var(--rpx));
}

.position-content--workspace {
  padding-top: calc(32 * var(--rpx));
}

.position-content--list {
  padding-top: calc(32 * var(--rpx));
}

.position-content--detail {
  padding-bottom: calc(24 * var(--rpx));
}

.position-content--compare {
  padding: calc(32 * var(--rpx)) 0 calc(64 * var(--rpx));
}

.profile-context-card,
.discovery-card,
.all-position-card,
.requirement-summary-card,
.score-judgement-card,
.goal-preview-card {
  box-sizing: border-box;
  border: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface);
  box-shadow: var(--figma-shadow-surface);
}

.profile-context-card {
  position: relative;
  overflow: hidden;
  margin-bottom: calc(64 * var(--rpx));
  padding: calc(40 * var(--rpx));
  border-radius: var(--radius-48);
}

.context-orb,
.score-orb {
  position: absolute;
  border-radius: 50%;
  background: var(--primary-soft);
  filter: blur(calc(36 * var(--rpx)));
  pointer-events: none;
}

.context-orb {
  top: calc(-64 * var(--rpx));
  right: calc(-36 * var(--rpx));
  width: calc(256 * var(--rpx));
  height: calc(256 * var(--rpx));
}

.context-card__body,
.score-judgement-card__body {
  position: relative;
  z-index: 1;
}

.context-card__kicker {
  margin-bottom: calc(24 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
}

.context-chips,
.position-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: calc(16 * var(--rpx));
}

.context-chip,
.position-tag {
  display: inline-flex;
  box-sizing: border-box;
  min-height: calc(48 * var(--rpx));
  padding: calc(8 * var(--rpx)) calc(20 * var(--rpx));
  align-items: center;
  border-radius: var(--radius-12);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.35;
}

.context-card__divider {
  height: calc(1 * var(--rpx));
  margin: calc(24 * var(--rpx)) 0;
  background: var(--line);
}

.context-card__summary,
.context-card__count,
.position-card__actions,
.all-position-card__top,
.all-position-card__footer,
.all-position-card__facts,
.comparison-dock,
.detail-actions__row,
.anan-context-action,
.score-line,
.fit-summary,
.requirement-row,
.requirement-confirm,
.sheet-header,
.sheet-subhead,
.history-row,
.choice-row,
.score-inputs,
.date-row,
.sheet-actions,
.goal-impact-row {
  display: flex;
  align-items: center;
}

.context-card__summary {
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.context-card__count {
  min-width: 0;
  flex: 1;
  gap: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 500;
}

.context-card__number {
  color: var(--color-ink);
  font-weight: 700;
}

.sparkle-mark {
  flex: none;
  color: var(--color-muted);
  font-size: var(--text-body-lg);
}

.context-card__link,
.text-action,
.evidence-link,
.goal-quiet-button,
.detail-actions__compare-link {
  width: auto;
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 1.4;
}

.context-card__link {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--primary-soft);
  white-space: nowrap;
}

.tiny-chevron {
  font-size: var(--text-body-lg);
}

.position-section-title,
.detail-section-title {
  margin: 0 calc(2 * var(--rpx)) calc(24 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
}

.position-section-title:not(:first-child) {
  margin-top: calc(56 * var(--rpx));
}

.discovery-list,
.all-position-list {
  display: flex;
  flex-direction: column;
  gap: calc(32 * var(--rpx));
}

.discovery-card {
  overflow: hidden;
  padding: calc(40 * var(--rpx));
  border-radius: var(--radius-48);
}

.discovery-card--primary {
  background:
    radial-gradient(circle at 100% 0, var(--color-primary-a11), transparent 36%),
    var(--color-surface);
}

.position-card__eyebrow,
.all-position-card__department,
.comparison-column__department {
  overflow: hidden;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.position-card__title {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  letter-spacing: calc(-0.5 * var(--rpx));
  line-height: 1.4;
}

.position-tag-row {
  margin-top: calc(24 * var(--rpx));
}

.position-tag {
  min-height: calc(40 * var(--rpx));
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
}

.position-tag--success {
  background: var(--good-soft);
  color: var(--good);
}

.position-tag--warning {
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
}

.position-tag--danger {
  background: var(--color-danger-soft);
  color: var(--danger);
}

.position-tag--muted {
  background: var(--line);
  color: var(--ink-2);
}

.position-tag--primary {
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}

.position-insight {
  display: flex;
  margin-top: calc(28 * var(--rpx));
  padding: calc(24 * var(--rpx));
  align-items: flex-start;
  gap: calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--primary-soft);
  border-radius: var(--radius-32);
  background: var(--color-primary-soft-a52);
}

.position-insight--cyan {
  border-color: var(--figma-color-cyan-soft);
  background: var(--color-cyan-soft-a58);
}

.position-insight__mark {
  flex: none;
  color: var(--color-primary-bright);
  font-size: var(--text-caption);
}

.position-insight--cyan .position-insight__mark {
  color: var(--figma-color-cyan-deep);
}

.position-insight__copy {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.58;
}

.position-card__actions {
  margin-top: calc(28 * var(--rpx));
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.compare-link,
.compare-corner {
  width: auto;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 700;
}

.compare-link--selected,
.compare-corner--selected {
  color: var(--primary);
}

.position-card__open {
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 600;
}

.position-inline-alert,
.position-success-message,
.position-empty-card,
.compact-action-card {
  box-sizing: border-box;
  margin-top: calc(24 * var(--rpx));
  padding: calc(24 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-32);
  font-size: var(--text-caption);
  line-height: 1.55;
}

.position-inline-alert {
  border: calc(1 * var(--rpx)) solid var(--figma-color-warning-soft);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
}

.position-success-message {
  border: calc(1 * var(--rpx)) solid var(--good-soft);
  background: var(--good-soft);
  color: var(--good);
}

.position-empty-card {
  padding: calc(48 * var(--rpx)) calc(40 * var(--rpx));
  background: var(--color-surface);
  text-align: center;
}

.position-empty-card__title {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}

.position-empty-card__copy {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
}

.secondary-pill {
  width: auto;
  margin: calc(28 * var(--rpx)) auto 0;
  padding: calc(20 * var(--rpx)) calc(32 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--line);
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.compact-action-card {
  display: flex;
  margin-top: calc(40 * var(--rpx));
  align-items: center;
  justify-content: space-between;
  gap: calc(24 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  background: var(--color-surface);
}

.compact-action-card__title {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.compact-action-card__copy {
  margin-top: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
}

.compact-action-card__button {
  width: auto;
  flex: none;
  padding: calc(16 * var(--rpx)) calc(24 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--text-caption);
  font-weight: 700;
}

.quiet-actions {
  display: flex;
  margin-top: calc(28 * var(--rpx));
  justify-content: center;
  gap: calc(40 * var(--rpx));
}

.quiet-action {
  width: auto;
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 600;
}

.comparison-dock {
  position: fixed;
  z-index: 40;
  right: calc(24 * var(--rpx));
  bottom: calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  left: calc(24 * var(--rpx));
  box-sizing: border-box;
  min-height: calc(112 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx)) calc(20 * var(--rpx)) calc(28 * var(--rpx));
  gap: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-32);
  background: var(--color-surface-a95);
  box-shadow: var(--figma-shadow-elevated);
}

.comparison-dock__summary {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.comparison-dock__title {
  color: var(--color-ink);
  font-size: var(--text-body);
  font-weight: 700;
}

.comparison-dock__note {
  margin-top: calc(3 * var(--rpx));
  overflow: hidden;
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comparison-dock__clear,
.comparison-dock__action {
  width: auto;
  flex: none;
  font-size: var(--text-caption);
  font-weight: 700;
}

.comparison-dock__clear {
  color: var(--ink-3);
}

.comparison-dock__action {
  padding: calc(20 * var(--rpx)) calc(32 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-ink);
  color: var(--color-surface);
}

.comparison-dock__action--disabled {
  background: var(--color-line-strong);
  color: var(--ink-3);
}

/* 全部岗位 */
.position-search-panel {
  position: relative;
  z-index: 10;
  box-sizing: border-box;
  padding: calc(32 * var(--rpx)) calc(40 * var(--rpx)) calc(24 * var(--rpx));
  border-bottom: calc(1 * var(--rpx)) solid var(--line);
  background: var(--color-surface);
  box-shadow: var(--figma-shadow-surface);
}

.position-search-input {
  display: flex;
  box-sizing: border-box;
  height: calc(80 * var(--rpx));
  padding: 0 calc(24 * var(--rpx));
  align-items: center;
  gap: calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-capsule);
  background: var(--bg);
}

.search-mark {
  position: relative;
  box-sizing: border-box;
  width: calc(26 * var(--rpx));
  height: calc(26 * var(--rpx));
  flex: none;
  border: calc(3 * var(--rpx)) solid var(--ink-3);
  border-radius: 50%;
}

.search-mark::after {
  position: absolute;
  right: calc(-8 * var(--rpx));
  bottom: calc(-6 * var(--rpx));
  width: calc(10 * var(--rpx));
  height: calc(3 * var(--rpx));
  background: var(--ink-3);
  content: "";
  transform: rotate(45deg);
  transform-origin: left center;
}

.position-search-input__control {
  min-width: 0;
  height: calc(72 * var(--rpx));
  flex: 1;
  color: var(--color-ink);
  font-size: var(--text-body-lg);
}

.filter-strip {
  width: 100%;
  margin-top: calc(20 * var(--rpx));
  white-space: nowrap;
}

.filter-pill {
  display: inline-flex;
  box-sizing: border-box;
  height: calc(58 * var(--rpx));
  margin-right: calc(16 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  align-items: center;
  gap: calc(12 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--line);
  border-radius: var(--radius-capsule);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
  vertical-align: top;
}

.filter-pill__input {
  width: calc(86 * var(--rpx));
  height: calc(54 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 600;
}

.filter-pill__input--year {
  width: calc(84 * var(--rpx));
}

.filter-pill--action {
  background: var(--color-ink);
  color: var(--color-surface);
}

.filter-pill--quiet {
  background: var(--color-surface);
  color: var(--ink-3);
}

.all-position-card {
  position: relative;
  overflow: hidden;
  padding: calc(40 * var(--rpx)) calc(40 * var(--rpx)) calc(32 * var(--rpx));
  border-radius: var(--radius-40);
}

.all-position-card__top,
.all-position-card__footer {
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.all-position-card__department {
  min-width: 0;
  flex: 1;
}

.all-position-card__location {
  flex: none;
  padding: calc(4 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--color-surface-soft);
  color: var(--ink-3);
  font-size: var(--text-micro);
  font-weight: 700;
}

.all-position-card__title {
  margin: calc(12 * var(--rpx)) 0 calc(28 * var(--rpx));
  padding-right: calc(100 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 1.45;
}

.all-position-card__footer {
  padding-top: calc(24 * var(--rpx));
  border-top: calc(1 * var(--rpx)) solid var(--color-surface-soft);
}

.all-position-card__facts {
  gap: calc(16 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-micro);
  font-weight: 500;
}

.fact-dot {
  width: calc(6 * var(--rpx));
  height: calc(6 * var(--rpx));
  border-radius: 50%;
  background: var(--figma-color-line-emphasis);
}

.all-position-card__score {
  color: var(--color-ink);
  font-size: var(--text-micro);
  font-weight: 700;
}

.compare-corner {
  position: absolute;
  top: calc(86 * var(--rpx));
  right: calc(36 * var(--rpx));
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--bg);
}

.compare-corner--selected {
  background: var(--primary-soft);
}

.list-status {
  padding: calc(40 * var(--rpx)) 0 calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  text-align: center;
}

.list-status--button {
  width: 100%;
  color: var(--primary);
  font-weight: 700;
}

/* 岗位详情 */
.detail-heading {
  margin-bottom: calc(48 * var(--rpx));
}

.detail-heading__location {
  display: inline-flex;
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--color-line-strong-a56);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.detail-heading__title {
  margin-top: calc(20 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-title-lg);
  font-weight: 700;
  letter-spacing: calc(-1 * var(--rpx));
  line-height: 1.3;
}

.detail-heading__department {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-body-lg);
  font-weight: 500;
}

.detail-section-title {
  margin-top: calc(48 * var(--rpx));
}

.requirement-summary-card {
  overflow: hidden;
  padding: calc(8 * var(--rpx)) calc(40 * var(--rpx));
  border-radius: var(--radius-48);
}

.requirement-row {
  padding: calc(32 * var(--rpx)) 0;
  align-items: flex-start;
  gap: calc(24 * var(--rpx));
}

.requirement-row__icon {
  display: flex;
  box-sizing: border-box;
  width: calc(36 * var(--rpx));
  height: calc(36 * var(--rpx));
  flex: none;
  align-items: center;
  justify-content: center;
  border: calc(3 * var(--rpx)) solid currentColor;
  border-radius: 50%;
  color: var(--figma-color-warning);
  font-size: var(--text-micro);
  font-weight: 800;
  line-height: 1;
}

.requirement-row__icon--success {
  color: var(--good);
}

.requirement-row__icon--danger {
  color: var(--danger);
}

.requirement-row__icon--warning {
  color: var(--figma-color-warning);
}

.requirement-row__main {
  min-width: 0;
  flex: 1;
}

.requirement-row__title {
  color: var(--color-ink);
  font-size: var(--text-body-lg);
  font-weight: 700;
}

.requirement-row__copy {
  margin-top: calc(4 * var(--rpx));
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 500;
  line-height: 1.55;
}

.requirement-row__evidence,
.requirement-row__saving {
  margin-top: calc(12 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-micro);
  line-height: 1.5;
}

.requirement-row__saving {
  color: var(--color-muted);
}

.requirement-divider {
  height: calc(1 * var(--rpx));
  margin-left: calc(64 * var(--rpx));
  background: var(--line);
}

.requirement-confirm {
  flex-wrap: wrap;
  gap: calc(12 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
}

.requirement-confirm__button {
  width: auto;
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--bg);
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
  font-weight: 700;
}

.score-judgement-card {
  position: relative;
  overflow: hidden;
  padding: calc(48 * var(--rpx));
  border-radius: var(--radius-48);
}

.score-orb {
  top: calc(-96 * var(--rpx));
  right: calc(-64 * var(--rpx));
  width: calc(260 * var(--rpx));
  height: calc(260 * var(--rpx));
}

.score-line {
  align-items: flex-end;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}

.score-line__label {
  margin-bottom: calc(8 * var(--rpx));
  color: var(--ink-3);
  font-size: var(--text-caption);
  font-weight: 700;
}

.score-line__value {
  color: var(--color-ink);
  font-family: var(--font-family-data);
  font-size: var(--text-hero);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  line-height: 1.1;
}

.score-gap-pill {
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-12);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning);
  font-size: var(--text-micro);
  font-weight: 700;
}

.score-gap-pill--success {
  background: var(--good-soft);
  color: var(--good);
}

.score-gap-pill--muted {
  background: var(--line);
  color: var(--ink-2);
}

.fit-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(16 * var(--rpx));
  margin-top: calc(48 * var(--rpx));
}

.fit-summary__item {
  display: flex;
  min-width: 0;
  padding: calc(24 * var(--rpx)) calc(12 * var(--rpx));
  flex-direction: column;
  align-items: center;
  border-radius: var(--radius-24);
  background: var(--bg);
  text-align: center;
}

.fit-summary__label {
