.onboarding-scroll-content.onboarding-scroll-content {
  padding-bottom: calc(352rpx + env(safe-area-inset-bottom));
}

.onboarding-action-dock {
  display: grid;
  gap: 12rpx;
}

button.onboarding-save-action {
  display: flex;
  width: 100%;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: var(--figma-radius-pill);
  background: transparent;
  color: var(--ink-2);
  font-size: var(--text-caption);
  font-weight: 600;
  line-height: 1.4;
}

button.onboarding-save-action::after {
  border: 0;
}

button.onboarding-save-action[disabled] {
  color: var(--ink-3);
}

/* 平板层：滚动内容限可读宽，与全局 responsive 层同断点。 */
@media (min-width: 768px) {
  .onboarding-scroll-content.onboarding-scroll-content {
    width: 100%;
    max-width: var(--layout-readable-max);
    margin-right: auto;
    margin-left: auto;
  }
}
