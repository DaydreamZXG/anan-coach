.report-chart {
  box-sizing: border-box;
  padding: calc(28 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line);
  border-radius: var(--radius-32);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}
.report-chart__head,
.report-chart__row-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: calc(20 * var(--rpx));
}
.report-chart__title {
  color: var(--color-ink);
  font-size: var(--text-section);
  font-weight: 700;
}
.report-chart__meta,
.report-chart__definition,
.report-chart__row-copy,
.report-chart__partial {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.55;
}
.report-chart__evidence {
  flex: none;
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--radius-capsule);
  background: var(--color-primary-soft);
  color: var(--color-muted);
  font-size: var(--text-micro);
}
.report-chart__plot {
  margin-top: calc(24 * var(--rpx));
}
.report-chart__row + .report-chart__row {
  margin-top: calc(24 * var(--rpx));
}
.report-chart__label {
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  font-weight: 600;
}
.report-chart__value {
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
}
.report-chart__rail {
  height: calc(12 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
  overflow: hidden;
  border-radius: var(--radius-capsule);
  background: var(--color-primary-a08);
}
.report-chart__bar {
  height: 100%;
  border-radius: inherit;
}
.report-chart__bar--primary {
  background: var(--color-primary);
}
.report-chart__bar--warning {
  background: var(--gradient-warning);
}
.report-chart__bar--neutral {
  background: var(--color-faint);
}
.report-chart__summary {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
  font-size: var(--text-body);
  line-height: 1.6;
}
.report-chart__empty {
  margin-top: calc(24 * var(--rpx));
  padding: calc(32 * var(--rpx)) calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--color-surface-soft);
  color: var(--color-faint);
  text-align: center;
}
.report-chart__partial {
  color: var(--color-warning-deep);
}
