<view class="s9-page report-page">
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="报告没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{report}}">
    <view class="s9-hero"><view class="report-kicker">{{report.title}}</view><view class="s9-title">{{kind === 'single_set' ? '这一组题，暴露了什么' : kind === 'position_gap' ? '离目标岗位，还差在哪里' : '这周有什么变化'}}</view><view class="s9-subtitle">只看做了什么、哪里变了、下一步做什么。</view><view class="s9-chip-row"><view class="s9-chip report-chip">{{generatedAtLabel}}</view><view class="s9-chip report-chip">{{evidenceCount}} 条学习记录</view></view></view>
    <view class="report-layout">
      <view wx:if="{{partial}}" class="report-banner">记录还不完整，先展示已经确认的部分。</view>
      <state-view wx:if="{{empty}}" class="report-state" state="empty" title="还没有这类记录" description="完成对应任务后，报告会按当时的记录生成。" />
      <view class="report-conclusion"><view class="report-conclusion__label">先看结论</view><view class="report-conclusion__headline">{{report.conclusion.headline}}</view><view class="report-next">{{report.conclusion.nextAction}}</view><view wx:if="{{planEvidenceCount}}" class="report-next report-next--meta">今日计划已参考 {{planEvidenceCount}} 条记录</view><button hover-class="item--hover" class="report-next-action report-next-action--anan tap-tactile" bindtap="askAnan">问岸岸下一步怎么做</button><button hover-class="item--hover" class="report-next-action report-next-action--secondary" bindtap="openNextAction">回到今日计划</button></view>
      <view class="report-chart-list"><report-chart wx:for="{{report.charts}}" wx:key="chartId" chart="{{item}}" /></view>
      <view wx:if="{{!report.charts.length}}" class="report-chart-empty">这类记录还不足以形成趋势图。完成两次以上同类训练后，再回来比较变化。</view>
    </view>
  </block>
</view>
