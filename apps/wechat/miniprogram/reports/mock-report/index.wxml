<view class="s9-page report-page">
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="模考报告没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{report}}">
    <view class="s9-hero"><view class="report-kicker">{{report.title}}</view><view class="s9-title">分数只是结果，失分结构才决定下一步</view><view class="s9-subtitle">按模块、时间和错误原因拆解，不用一次成绩替代长期判断。</view><view class="s9-chip-row"><view class="s9-chip report-chip">{{generatedAtLabel}}</view><view class="s9-chip report-chip">{{evidenceCount}} 条学习记录</view><view class="s9-chip report-chip">数据已核对</view></view></view>
    <view class="report-layout">
      <view wx:if="{{partial}}" class="report-banner">这份报告数据不全，只展示已有的部分。</view>
      <state-view wx:if="{{empty}}" class="report-state" state="empty" title="还没有完整的模考记录" description="交卷后才会生成模块表现、速度与错因图。" />
      <view class="report-conclusion"><view class="report-conclusion__label">当前结论</view><view class="report-conclusion__headline">{{report.conclusion.headline}}</view><view class="report-conclusion__detail">{{report.conclusion.detail}}</view><view class="report-next">{{report.conclusion.nextAction}}</view><view class="report-next report-next--meta">已用 {{planEvidenceCount}} 条记录更新计划</view><button hover-class="item--hover" class="report-next-action report-next-action--anan" bindtap="askAnan">带着这份报告问岸岸</button><button hover-class="item--hover" class="report-next-action report-next-action--secondary" bindtap="openNextAction">回到今日计划</button></view>
      <view class="report-chart-list"><report-chart wx:for="{{report.charts}}" wx:key="chartId" chart="{{item}}" /></view>
    </view>
  </block>
</view>
