/* 外部模考单：骨架、卡片与按钮来自 s9；保留识别核对表单、
 * 回执网格与成功态等页面特有节点。 */

.external-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  letter-spacing: calc(1 * var(--rpx));
}

.progress {
  height: calc(14 * var(--rpx));
  margin-top: calc(20 * var(--rpx));
  overflow: hidden;
  border-radius: var(--radius-capsule);
  background: var(--color-surface-soft);
}

.progress-bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
  transition: width var(--motion-slow) var(--ease-out);
}

@media (prefers-reduced-motion: reduce) {
  .progress-bar {
    transition-duration: 0.01ms;
  }
}

.source-image {
  width: 100%;
  margin-top: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
}

.span-card--checked {
  border-color: var(--color-primary-a24);
  background: var(--color-primary-soft);
}

.span-head {
  display: flex;
  justify-content: space-between;
  color: var(--color-ink-secondary);
  font-size: var(--text-micro);
}

.confidence {
  color: var(--ink-2);
}

.form-control,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  margin-top: calc(12 * var(--rpx));
  padding: calc(20 * var(--rpx)) calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--color-line-strong);
  border-radius: var(--radius-16);
  background: var(--bg);
  font-size: var(--text-body);
}

.form-textarea {
  min-height: calc(130 * var(--rpx));
}

.form-control--error {
  border-color: var(--color-danger);
  background: var(--color-danger-soft);
}

.form-error {
  margin-top: calc(18 * var(--rpx));
  color: var(--color-danger);
  font-size: var(--text-caption);
  line-height: 1.5;
}

button.check-button {
  min-height: calc(80 * var(--rpx));
  margin-top: calc(16 * var(--rpx));
  border-radius: var(--radius-24);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--text-body);
  line-height: calc(80 * var(--rpx));
}

.field {
  margin-top: calc(24 * var(--rpx));
}

.field-label {
  color: var(--color-ink-secondary);
  font-size: var(--text-caption);
  font-weight: 600;
}

.chip-row {
  display: flex;
  gap: calc(16 * var(--rpx));
  margin-top: calc(12 * var(--rpx));
}

.chip {
  flex: 1;
  padding: calc(12 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--ink-2);
  font-size: var(--text-micro);
}

.chip--active {
  background: var(--color-primary);
  color: var(--color-surface);
}

.score-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(12 * var(--rpx));
}

.boundary-note {
  margin-top: calc(24 * var(--rpx));
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--figma-color-warning-soft);
  color: var(--figma-color-warning-deep);
  font-size: var(--text-caption);
  line-height: 1.6;
}

.receipt-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: calc(16 * var(--rpx));
  margin-top: calc(24 * var(--rpx));
}

.receipt-cell {
  padding: calc(20 * var(--rpx));
  border-radius: var(--radius-16);
  background: var(--figma-color-warning-soft);
}

.receipt-label,
.receipt-value {
  display: block;
}

.receipt-label {
  color: var(--color-faint);
  font-size: var(--text-micro);
}

.receipt-value {
  margin-top: calc(8 * var(--rpx));
  color: var(--color-ink);
  font-size: var(--text-caption);
}

.success-card {
  text-align: center;
}

.success-mark {
  width: calc(84 * var(--rpx));
  height: calc(84 * var(--rpx));
  margin: 0 auto calc(12 * var(--rpx));
  border-radius: 50%;
  background: var(--good-soft);
  color: var(--good);
  font-size: var(--text-title-lg);
  line-height: calc(84 * var(--rpx));
}

.success-pill {
  display: inline-block;
  margin-top: calc(20 * var(--rpx));
  padding: calc(8 * var(--rpx)) calc(16 * var(--rpx));
  border-radius: var(--figma-radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-ink-secondary);
}

.success-impact {
  margin-top: calc(16 * var(--rpx));
  color: var(--color-ink-secondary);
}

.link-action {
  margin: calc(16 * var(--rpx)) auto 0;
  padding: calc(12 * var(--rpx)) calc(20 * var(--rpx));
  background: transparent;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.4;
}

.link-action::after {
  border: 0;
}

.error-card {
  color: var(--danger);
  line-height: 1.6;
}

.request-id {
  margin: calc(12 * var(--rpx)) 0;
  color: var(--ink-2);
  font-size: var(--text-micro);
}
