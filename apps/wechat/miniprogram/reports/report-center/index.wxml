<view class="s9-page">
  <view class="s9-hero"><view class="center-kicker">模考与报告</view><view class="s9-title">所有成绩，最后都要变成下一步</view><view class="s9-subtitle">模考、外部成绩和周报告统一归档，分数口径分得清。</view></view>
  <state-view wx:if="{{status === 'loading'}}" state="loading" />
  <state-view wx:elif="{{status === 'error'}}" state="error" title="报告中心没有加载成功" description="{{errorMessage}}" request-id="{{requestId}}" action-text="重新加载" bind:action="retry" />
  <block wx:elif="{{center}}">
    <view class="center-time">数据生成于 {{generatedAtLabel}}</view>
    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">自有标准卷</view><view class="s9-section-meta">题目已定稿 · 综合表现分</view></view>
      <view wx:if="{{papers.length}}" class="paper-list">
        <view hover-class="item--hover" wx:for="{{papers}}" wx:key="paperVersionId" class="s9-card paper-card" data-index="{{index}}" bindtap="openPaper"><view class="paper-top"><view class="paper-status">{{item.statusLabel}}</view><view class="paper-version">评分标准已固定</view></view><view class="paper-title">{{item.title}}</view><view class="paper-meta">{{item.questionCount}} 题 · {{item.durationMinutes}} 分钟</view><view class="paper-definition">{{item.metricDefinition}}</view><view class="paper-action">{{item.actionLabel}} →</view></view>
      </view>
      <view wx:else class="s9-card paper-card"><view class="paper-title">本周标准卷还未领取</view><view class="paper-definition">开始后题目和评分标准就定下来了。</view></view>
      <view class="s9-empty-space"></view>
      <button hover-class="item--hover" class="s9-primary-button tap-tactile" loading="{{startingMock}}" bindtap="startWeeklyMock">{{papers.length ? '领取 / 恢复本周标准卷' : '开始本周标准卷'}}</button>
    </view>
    <view class="s9-stack">
      <view hover-class="item--hover" class="s9-card external-card" bindtap="openExternalScore"><view><view class="center-kicker">外部模考单</view><view class="external-title">上传粉笔等平台的模考成绩截图</view><view class="external-copy">先核对识别文字，再确认成绩信息；没有确认的内容不会影响能力判断。</view></view><view class="external-arrow">›</view></view>
      <view wx:if="{{center.latestExternalReport}}" class="s9-card"><view class="latest-label">最近确认的外部成绩</view><view class="latest-title">{{center.latestExternalReport.platformName}} · {{center.latestExternalReport.examName}}</view><view class="latest-meta">{{center.latestExternalReport.totalScore || '双科未完整'}} · {{center.latestExternalReport.confirmationMessage}}</view></view>
    </view>
    <view class="s9-section">
      <view class="s9-section-head"><view class="s9-section-title">正式报告</view><view class="s9-section-meta">5 个维度看进步</view></view>
      <view class="report-grid"><view hover-class="item--hover" wx:for="{{center.reportCards}}" wx:key="reportKind" class="s9-card report-card report-card--{{item.state}}" data-index="{{index}}" bindtap="openReport"><view class="report-card__state">{{item.state === 'ready' ? '已就绪' : item.state === 'partial' ? '数据还不完整' : '待积累'}}</view><view class="report-card__title">{{item.title}}</view><view class="report-card__copy">{{item.subtitle}}</view><view class="report-card__arrow">查看 →</view></view></view>
    </view>
  </block>
</view>
