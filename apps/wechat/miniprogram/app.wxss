@import "design-system/tokens/index.wxss";
@import "design-system/primitives/index.wxss";
@import "design-system/stage9/screen.wxss";
@import "design-system/responsive/index.wxss";

page {
  --bg: #f7f9fc;
  --surface: #ffffff;
  --ink: #101828;
  --ink-2: #6a7282;
  --ink-3: #99a1af;
  --line: #f3f4f6;
  --primary: #615fff;
  --primary-deep: #4f39f6;
  --primary-soft: #eef2ff;
  --accent: #ad46ff;
  --accent-soft: #f5f3ff;
  --warm: #615fff;
  --warm-soft: #eef2ff;
  --good: #00a63e;
  --good-soft: #ecfdf5;
  --danger: #fb2c36;
  --shadow: 0 16rpx 60rpx rgba(17, 24, 39, 0.04);
  --radius: 64rpx;
  --radius-sm: 48rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
    "Helvetica Neue", "PingFang SC", Arial, sans-serif;
  font-size: 32rpx;
  line-height: 1.5;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  border: none;
  box-shadow: var(--shadow);
}

.h1 { font-size: 44rpx; font-weight: 700; line-height: 1.3; color: var(--ink); }
.h2 { font-size: 34rpx; font-weight: 700; line-height: 1.4; color: var(--ink); }
.text-2 { font-size: 28rpx; color: var(--ink-2); }
.text-3 { font-size: 24rpx; color: var(--ink-3); }
.num {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn::after { border: none; }
.btn-primary { background: var(--color-action); color: #ffffff; box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1); }
.btn-primary:active { background: var(--color-action-deep); }
.btn-ghost { background: var(--primary-soft); color: var(--primary); }
.btn-warm { background: var(--accent); color: #ffffff; }

/* 平板/大屏适配:内容列限宽居中,具体页面再用双栏网格 */
@media (min-width: 700px) {
  .page {
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 40px;
    padding-right: 40px;
  }
}

/* --- Global Tactile & Physics Animations --- */

/* Clickable Tactile Feedback */
.item--hover {
  transform: scale(0.96) translateY(2rpx);
  filter: brightness(0.96);
  opacity: 0.88;
}

.tap-tactile {
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1.1), box-shadow 0.2s ease, opacity 0.2s ease;
}

.tap-tactile:active {
  transform: scale(0.96) translateY(2rpx);
  opacity: 0.9;
}

/* Stagger Entry Animators */
@keyframes slideUpFade {
  0% {
    opacity: 0;
    transform: translateY(36rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-slide-in {
  opacity: 0;
  animation: slideUpFade 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Shimmer Light Sweep for dynamic highlights */
@keyframes glowShimmer {
  0% {
    background-position: -150% 0;
  }
  100% {
    background-position: 150% 0;
  }
}

.shimmer-sweep {
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 100%);
  background-size: 200% 100%;
  animation: glowShimmer 2.5s infinite linear;
}

/* Aurora background scrolling animation */
@keyframes auroraScroll {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* Pulsing highlight animation for key steps */
@keyframes pulseGlowRing {
  0% {
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4);
  }
  70% {
    box-shadow: 0 0 0 20rpx rgba(99, 102, 241, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(99, 102, 241, 0);
  }
}

.pulse-ring {
  animation: pulseGlowRing 2s infinite cubic-bezier(0.16, 1, 0.3, 1);
}
