/**
 * 设计系统 · 冷静工具层 + 暖色岸岸
 * 原则:暖色(--warm)只允许出现在岸岸相关的界面元素上。
 * 颜色即信息:暖色出现 = 有人在陪你。
 */
page {
  --bg: #f5f6f8;
  --surface: #ffffff;
  --ink: #1a2330;
  --ink-2: #66707d;
  --ink-3: #9aa3ae;
  --line: #e9ecf0;
  --primary: #2b6cb0;
  --primary-soft: #eaf1f8;
  --warm: #e8833a;
  --warm-soft: #fbf0e6;
  --good: #2f9e62;
  --good-soft: #e9f5ee;
  --danger: #d64545;
  --radius: 24rpx;
  --radius-sm: 16rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "MiSans", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 32rpx;
  border: 1rpx solid var(--line);
}

.h1 { font-size: 44rpx; font-weight: 600; line-height: 1.3; color: var(--ink); }
.h2 { font-size: 34rpx; font-weight: 600; line-height: 1.4; color: var(--ink); }
.text-2 { font-size: 28rpx; color: var(--ink-2); }
.text-3 { font-size: 24rpx; color: var(--ink-3); }
.num {
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-sm);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #ffffff; }
.btn-ghost { background: var(--surface); color: var(--ink); border: 1rpx solid var(--line); }
.btn-warm { background: var(--warm); color: #ffffff; }
