@import "design-system/tokens/index.wxss";
@import "design-system/primitives/index.wxss";
@import "design-system/stage9/screen.wxss";
@import "design-system/responsive/index.wxss";

page {
  --bg: var(--color-canvas);
  --surface: var(--color-surface);
  --ink: var(--color-ink);
  --ink-2: var(--color-muted);
  --ink-3: var(--color-faint);
  --line: var(--color-line);
  --primary: var(--color-primary);
  --primary-deep: var(--color-primary-deep);
  --primary-soft: var(--color-primary-soft);
  --accent: var(--color-ai-violet);
  --accent-soft: var(--color-primary-soft);
  --warm: var(--color-primary);
  --warm-soft: var(--color-primary-soft);
  --good: var(--color-success);
  --good-soft: var(--color-success-soft);
  --danger: var(--color-danger);
  --shadow: var(--shadow-card-strong);
  --radius: var(--radius-card);
  --radius-sm: var(--figma-radius-card);

  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-family-ui);
  font-size: var(--figma-font-body-large);
  line-height: 1.5;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--figma-page-inset);
  padding-bottom: calc(
    var(--figma-bottom-navigation-height) + var(--figma-space-10) +
      env(safe-area-inset-bottom)
  );
  display: flex;
  flex-direction: column;
}

/* The phone Design File remains the visual source; tablet only constrains width. */
@media (min-width: 700px) {
  .page {
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 40px;
    padding-right: 40px;
  }
}
