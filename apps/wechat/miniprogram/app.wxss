@import "design-system/tokens/index.wxss";
@import "design-system/primitives/index.wxss";
@import "design-system/stage9/screen.wxss";
@import "design-system/responsive/index.wxss";

page {
  min-height: 100%;
  background: var(--color-canvas);
  color: var(--color-ink);
  font-family: var(--font-family-reading);
  font-synthesis: none;
  font-size: 28rpx;
}

.type-data {
  font-family: var(--font-family-data);
  font-variant-numeric: tabular-nums;
}

button,
input,
textarea {
  font-family: var(--font-family-ui);
  font-synthesis: none;
}

button::after {
  border: 0;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
}
