/* Figma 72:2 InkLayer：铺满宿主容器；static/replay 模式触摸穿透。 */
.annotation-layer {
  position: absolute;
  z-index: 5;
  inset: 0;
  pointer-events: none;
}

.annotation-layer--annotate {
  pointer-events: auto;
}

.annotation-layer__canvas {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.annotation-layer__capture {
  position: absolute;
  inset: 0;
}

/* Figma 72:3：批注中 · 自动保存 */
.annotation-layer__badge {
  position: absolute;
  top: calc(24 * var(--rpx));
  right: calc(28 * var(--rpx));
  display: flex;
  height: calc(56 * var(--rpx));
  align-items: center;
  gap: calc(16 * var(--rpx));
  padding: 0 calc(20 * var(--rpx));
  border: calc(1 * var(--rpx)) solid rgb(79 57 246 / 10%);
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: var(--color-surface-soft);
  font-size: var(--text-micro);
  font-weight: 700;
}

.annotation-layer__badge-dot {
  width: calc(14 * var(--rpx));
  height: calc(14 * var(--rpx));
  border-radius: 50%;
  background: var(--color-primary-deep);
}

.annotation-layer__lasso-bar {
  position: absolute;
  bottom: calc(200 * var(--rpx));
  left: 50%;
  display: flex;
  align-items: center;
  gap: calc(20 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(16 * var(--rpx)) calc(12 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  color: var(--figma-color-on-dark);
  background: rgb(16 24 40 / 88%);
  font-size: var(--text-micro);
  transform: translateX(-50%);
}

.annotation-layer__lasso-delete {
  margin: 0;
  padding: calc(8 * var(--rpx)) calc(20 * var(--rpx));
  border: 0;
  border-radius: var(--radius-capsule);
  color: var(--figma-color-on-dark);
  background: var(--figma-color-danger);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.4;
}

/* Figma 72:18：批注工具栏（h72 r24 白底描边投影，固定底部）。 */
.annotation-layer__toolbar {
  position: absolute;
  right: calc(24 * var(--rpx));
  bottom: calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  left: calc(24 * var(--rpx));
  box-sizing: border-box;
  display: flex;
  height: calc(144 * var(--rpx));
  align-items: center;
  gap: calc(8 * var(--rpx));
  padding: calc(16 * var(--rpx)) calc(12 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-line);
  border-radius: var(--radius-48);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-elevated);
}

/* Figma 72:19：43×56 工具。 */
.annotation-layer__tool {
  box-sizing: border-box;
  display: flex;
  width: calc(86 * var(--rpx));
  min-width: calc(86 * var(--rpx));
  height: calc(112 * var(--rpx));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(2 * var(--rpx));
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: transparent;
}

.annotation-layer__tool--active {
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.annotation-layer__tool-glyph {
  font-size: var(--text-title-sm);
  line-height: calc(44 * var(--rpx));
}

.annotation-layer__tool-label {
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: calc(24 * var(--rpx));
}

/* Figma 72:34：撤销圆钮。 */
.annotation-layer__undo {
  box-sizing: border-box;
  display: flex;
  width: calc(76 * var(--rpx));
  min-width: calc(76 * var(--rpx));
  height: calc(76 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: var(--radius-40);
  color: var(--color-ink-secondary);
  background: var(--figma-color-canvas);
  font-size: var(--text-title-sm);
  line-height: 1;
}

/* Figma 72:36：完成。 */
.annotation-layer__done {
  box-sizing: border-box;
  display: flex;
  width: calc(132 * var(--rpx));
  min-width: calc(132 * var(--rpx));
  height: calc(96 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--figma-color-on-dark);
  background: var(--color-primary-deep);
  font-size: var(--text-body);
  font-weight: 700;
}

.annotation-layer__tool::after,
.annotation-layer__undo::after,
.annotation-layer__done::after,
.annotation-layer__lasso-delete::after {
  border: 0;
}
