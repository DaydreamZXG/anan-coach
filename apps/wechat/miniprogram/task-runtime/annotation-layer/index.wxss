/* Figma 72:2 InkLayer：铺满宿主容器；static/replay 模式触摸穿透。 */
.annotation-layer {
  position: absolute;
  z-index: 5;
  inset: 0;
  pointer-events: none;
}

.annotation-layer--annotate {
  pointer-events: auto;
}

.annotation-layer__canvas {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.annotation-layer__capture {
  position: absolute;
  inset: 0;
}

/* Figma 72:3：批注中 · 自动保存 */
.annotation-layer__badge {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  display: flex;
  height: 56rpx;
  align-items: center;
  gap: 16rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgb(79 57 246 / 10%);
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: var(--color-surface-soft);
  font-size: var(--text-micro);
  font-weight: 700;
}

.annotation-layer__badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary-deep);
}

.annotation-layer__lasso-bar {
  position: absolute;
  bottom: 200rpx;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 16rpx 12rpx 28rpx;
  border-radius: var(--radius-capsule);
  color: var(--figma-color-on-dark);
  background: rgb(16 24 40 / 88%);
  font-size: var(--text-micro);
  transform: translateX(-50%);
}

.annotation-layer__lasso-delete {
  margin: 0;
  padding: 8rpx 20rpx;
  border: 0;
  border-radius: var(--radius-capsule);
  color: var(--figma-color-on-dark);
  background: var(--figma-color-danger);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.4;
}

/* Figma 72:18：批注工具栏（h72 r24 白底描边投影，固定底部）。 */
.annotation-layer__toolbar {
  position: absolute;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  box-sizing: border-box;
  display: flex;
  height: 144rpx;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--radius-48);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-elevated);
}

/* Figma 72:19：43×56 工具。 */
.annotation-layer__tool {
  box-sizing: border-box;
  display: flex;
  width: 86rpx;
  min-width: 86rpx;
  height: 112rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: transparent;
}

.annotation-layer__tool--active {
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.annotation-layer__tool-glyph {
  font-size: var(--text-title-sm);
  line-height: 44rpx;
}

.annotation-layer__tool-label {
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 24rpx;
}

/* Figma 72:34：撤销圆钮。 */
.annotation-layer__undo {
  box-sizing: border-box;
  display: flex;
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: var(--radius-40);
  color: var(--color-ink-secondary);
  background: var(--figma-color-canvas);
  font-size: var(--text-title-sm);
  line-height: 1;
}

/* Figma 72:36：完成。 */
.annotation-layer__done {
  box-sizing: border-box;
  display: flex;
  width: 132rpx;
  min-width: 132rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--figma-color-on-dark);
  background: var(--color-primary-deep);
  font-size: var(--text-body);
  font-weight: 700;
}

.annotation-layer__tool::after,
.annotation-layer__undo::after,
.annotation-layer__done::after,
.annotation-layer__lasso-delete::after {
  border: 0;
}
