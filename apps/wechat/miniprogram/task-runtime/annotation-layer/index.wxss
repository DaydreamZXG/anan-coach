/* Figma 72:2 InkLayer：铺满宿主容器；static/replay 模式触摸穿透。 */
.annotation-layer {
  position: absolute;
  z-index: 5;
  inset: 0;
  pointer-events: none;
}

.annotation-layer--annotate {
  pointer-events: auto;
}

.annotation-layer__canvas {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.annotation-layer__capture {
  position: absolute;
  inset: 0;
}

.annotation-layer__lasso-bar {
  position: absolute;
  bottom: calc(200 * var(--rpx));
  left: 50%;
  display: flex;
  align-items: center;
  gap: calc(20 * var(--rpx));
  padding: calc(12 * var(--rpx)) calc(16 * var(--rpx)) calc(12 * var(--rpx)) calc(28 * var(--rpx));
  border-radius: var(--radius-capsule);
  color: var(--figma-color-on-dark);
  background: rgb(16 24 40 / 88%);
  font-size: var(--text-micro);
  transform: translateX(-50%);
}

.annotation-layer__lasso-delete {
  margin: 0;
  padding: calc(8 * var(--rpx)) calc(20 * var(--rpx));
  border: 0;
  border-radius: var(--radius-capsule);
  color: var(--figma-color-on-dark);
  background: var(--figma-color-danger);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 1.4;
}

/* 两行草稿工具栏：第一行选择操作方式，第二行完成低频管理动作。 */
.annotation-layer__toolbar {
  position: absolute;
  right: calc(24 * var(--rpx));
  bottom: calc(calc(24 * var(--rpx)) + env(safe-area-inset-bottom));
  left: calc(24 * var(--rpx));
  box-sizing: border-box;
  display: grid;
  gap: calc(8 * var(--rpx));
  padding: calc(16 * var(--rpx));
  border: calc(1 * var(--rpx)) solid var(--figma-color-line);
  border-radius: var(--radius-32);
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-elevated);
}

.annotation-layer__tools {
  display: grid;
  gap: calc(8 * var(--rpx));
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.annotation-layer__tool {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  height: calc(88 * var(--rpx));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(2 * var(--rpx));
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: transparent;
}

.annotation-layer__tool--active {
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.annotation-layer__tool-glyph {
  font-size: var(--text-title-sm);
  line-height: calc(44 * var(--rpx));
}

.annotation-layer__tool-label {
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: calc(24 * var(--rpx));
}

.annotation-layer__actions {
  display: grid;
  gap: calc(8 * var(--rpx));
  grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.35fr);
}

.annotation-layer__secondary-action {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  height: calc(72 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-16);
  color: var(--color-ink-secondary);
  background: var(--figma-color-canvas);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: normal;
}

.annotation-layer__secondary-action--danger {
  color: var(--color-danger);
}

.annotation-layer__done {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  height: calc(72 * var(--rpx));
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-16);
  color: var(--figma-color-on-dark);
  background: var(--color-primary-deep);
  font-size: var(--text-caption);
  font-weight: 700;
}

.annotation-layer__tool::after,
.annotation-layer__secondary-action::after,
.annotation-layer__done::after,
.annotation-layer__lasso-delete::after {
  border: 0;
}
