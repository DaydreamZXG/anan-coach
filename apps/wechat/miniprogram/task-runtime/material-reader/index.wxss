.material-reader__entry {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 20rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--color-line, rgba(51, 60, 105, 0.13));
  border-radius: 18rpx;
  background: var(--color-surface, #ffffff);
  text-align: left;
}

.material-reader__entry::after,
.material-reader__header-action::after,
.material-reader__tool::after,
.material-reader__eye-care::after {
  border: 0;
}

.material-reader__entry-title {
  color: var(--color-ink, #20243a);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.4;
}

.material-reader__entry-meta,
.material-reader__position {
  margin-top: 5rpx;
  color: var(--color-muted, #69708f);
  font-size: 20rpx;
  line-height: 1.4;
}

.material-reader__entry-action {
  color: var(--color-primary, #4e5ac7);
  font-size: 23rpx;
  font-weight: 700;
}

.material-reader__backdrop {
  position: fixed;
  z-index: 80;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(20, 24, 45, 0.4);
}

.material-reader__backdrop--drawer,
.material-reader__backdrop--fullscreen {
  top: 0;
}

.material-reader__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  overflow: hidden;
  flex-direction: column;
  background: var(--color-canvas, #f7f8fc);
  color: var(--color-ink, #20243a);
}

.material-reader__panel--drawer {
  height: 72vh;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -18rpx 60rpx rgba(21, 27, 62, 0.16);
}

.material-reader__panel--fullscreen {
  top: 0;
  height: 100vh;
}

.material-reader__panel--eye_care {
  background: #eeeada;
}

.material-reader__grabber {
  flex: none;
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 4rpx;
  border-radius: 999rpx;
  background: rgba(77, 84, 117, 0.2);
}

.material-reader__header {
  display: flex;
  flex: none;
  min-height: 84rpx;
  padding: 10rpx 22rpx 14rpx 28rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid var(--color-line, rgba(51, 60, 105, 0.13));
}

.material-reader__heading {
  flex: 1;
  min-width: 0;
}

.material-reader__title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-reader__header-action,
.material-reader__tool,
.material-reader__eye-care {
  min-height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: rgba(78, 90, 199, 0.08);
  color: var(--color-primary, #4e5ac7);
  font-size: 21rpx;
  line-height: 56rpx;
}

.material-reader__toolbar {
  display: flex;
  flex: none;
  overflow-x: auto;
  padding: 12rpx 20rpx;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid var(--color-line, rgba(51, 60, 105, 0.13));
  background: rgba(255, 255, 255, 0.74);
}

.material-reader__panel--eye_care .material-reader__toolbar {
  background: rgba(244, 240, 223, 0.82);
}

.material-reader__tool-group {
  display: flex;
  flex: none;
  align-items: center;
  gap: 6rpx;
}

.material-reader__tool {
  width: 56rpx;
  padding: 0;
}

.material-reader__tool-value {
  min-width: 72rpx;
  color: var(--color-muted, #69708f);
  font-family: var(--font-family-data, monospace);
  font-size: 19rpx;
  text-align: center;
}

.material-reader__eye-care {
  flex: none;
}

.material-reader__eye-care--active {
  background: #dce4c7;
  color: #3e5c35;
  font-weight: 700;
}

.material-reader__scroll {
  flex: 1;
  min-height: 0;
}

.material-reader__scroll--drawer {
  height: calc(72vh - 190rpx - env(safe-area-inset-bottom));
}

.material-reader__scroll--fullscreen {
  height: calc(100vh - 190rpx - env(safe-area-inset-bottom));
}

.material-reader__content {
  padding: 28rpx var(--space-page-x, 28rpx) calc(48rpx + env(safe-area-inset-bottom));
}
