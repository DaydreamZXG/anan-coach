@import "../../design-system/primitives/interaction.wxss";

.material-reader__inline {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--figma-radius-card);
  background: var(--color-surface);
}

.material-reader__inline--eye_care {
  background: var(--good-soft);
}

.material-reader__inline-header {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 20rpx 16rpx 24rpx;
  border-bottom: 1rpx solid var(--color-line);
  text-align: left;
}

.material-reader__inline-heading {
  min-width: 0;
}

.material-reader__inline-kicker {
  color: var(--color-muted);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 28rpx;
}

.material-reader__inline-expand {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 50%;
  background: var(--color-surface-soft);
}

.material-reader__inline-expand::after,
.material-reader__header-action::after,
.material-reader__tool::after,
.material-reader__eye-care::after {
  border: 0;
}

.material-reader__inline-chevron {
  width: 16rpx;
  height: 16rpx;
  transform: rotate(45deg);
  border-top: 3rpx solid var(--color-muted);
  border-left: 3rpx solid var(--color-muted);
  border-radius: 2rpx;
}

.material-reader__entry-title {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-ink);
  font-size: var(--text-caption);
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-reader__position {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--text-micro);
  line-height: 1.4;
}

.material-reader__inline-scroll {
  height: min(560rpx, 42vh);
}

.material-reader__inline-content {
  box-sizing: border-box;
  padding: 24rpx;
}

/* Figma 2:74：白底 + 极浅投影，不再画边框和圆角。 */
.material-reader--answering .material-reader__inline {
  border: 0;
  border-radius: 0;
  background: var(--figma-color-surface);
  box-shadow: var(--shadow-soft);
}

/*
 * Figma 2:75：固定 294.7px 高、内距 20px 的纵向滚动容器。
 * 设计稿基准机型为 390×844；min(…, 35vh) 让更矮的机型按比例收缩，
 * 保证题目区与固定底栏始终可达。
 */
.material-reader__inline-scroll--answering {
  box-sizing: border-box;
  max-height: min(589rpx, 35vh);
}

/*
 * 内距放在内层，避免 scroll-view 自带 padding 时算错内容高度。
 * 顶部 16px 对应 Figma 2:83 段落相对材料标题行的 pt-16。
 */
.material-reader__inline-body--answering {
  box-sizing: border-box;
  padding: 32rpx 40rpx 40rpx;
}

.material-reader__inline-content--answering {
  padding: 0;
}

@media (min-width: 768px) {
  .material-reader--answering .material-reader__inline {
    border: 1px solid var(--color-line);
    border-radius: 18px;
  }

  .material-reader__inline-scroll--answering {
    max-height: min(295px, 34vh);
  }

  .material-reader__inline-body--answering {
    padding: 16px 20px 20px;
  }
}

/*
 * Figma 80:2 · 沉浸阅读全屏面。
 * 导航行与胶囊共行（只避让实测胶囊矩形），正文卡独立滚动，
 * 工具坞浮在底部。所有几何取自 81:* 节点（px×2 → rpx）。
 */
.material-reader__surface {
  position: fixed;
  z-index: var(--z-overlay);
  inset: 0;
  display: flex;
  flex-direction: column;
  padding-top: var(--reader-status-bar, 0);
  background: var(--figma-color-canvas);
  color: var(--color-ink);
}

.material-reader__surface--eye_care {
  background: var(--good-soft);
}

/* Figma 81:3：58px 白色导航行，底部 1px 分隔线。 */
.material-reader__nav {
  position: relative;
  display: flex;
  height: 116rpx;
  flex: none;
  align-items: center;
  gap: 24rpx;
  padding: 0 var(--reader-capsule-reserve, 0) 0 28rpx;
  border-bottom: 1rpx solid var(--figma-color-line);
  background: var(--figma-color-surface);
}

/* Figma 81:5：38px 圆形返回键。 */
.material-reader__back {
  box-sizing: border-box;
  display: flex;
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 0 8rpx;
  border: 0;
  border-radius: var(--radius-40);
  color: var(--color-ink);
  background: var(--figma-color-canvas);
  font-size: var(--text-stat);
  font-weight: 500;
  line-height: 1;
}

.material-reader__back::after,
.material-reader__dock-tool::after,
.material-reader__dock-return::after {
  border: 0;
}

.material-reader__nav-heading {
  min-width: 0;
  flex: 1;
}

/* Figma 81:7 / 81:8 */
.material-reader__nav-title {
  overflow: hidden;
  color: var(--figma-color-ink);
  font-size: var(--text-section);
  font-weight: 700;
  line-height: 48rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-reader__nav-subtitle {
  overflow: hidden;
  color: var(--figma-color-muted);
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-reader__body-scroll {
  min-height: 0;
  flex: 1;
}

/* Figma 81:11：白色正文卡，r26，边框 line；底部给工具坞留出空间。 */
.material-reader__body {
  box-sizing: border-box;
  margin: 24rpx 24rpx calc(200rpx + env(safe-area-inset-bottom));
  padding: 32rpx 32rpx 56rpx;
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--radius-48);
  background: var(--figma-color-surface);
}

.material-reader__surface--eye_care .material-reader__body {
  background: var(--color-surface-soft);
}

/* Figma 81:12 */
.material-reader__section-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: var(--color-surface-soft);
  font-size: var(--text-micro);
  font-weight: 700;
  line-height: 32rpx;
}

/* Figma 81:14 */
.material-reader__body-title {
  margin-top: 28rpx;
  color: var(--figma-color-ink);
  font-size: var(--text-title-sm);
  font-weight: 700;
  line-height: 52rpx;
}

.material-reader__content {
  padding: 24rpx 0 0;
}

/* Figma 81:36：已读进度浮标。 */
.material-reader__progress {
  position: absolute;
  right: 46rpx;
  bottom: calc(196rpx + env(safe-area-inset-bottom));
  display: flex;
  height: 56rpx;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: rgb(247 249 252 / 96%);
  font-size: var(--text-micro);
  font-weight: 700;
}

.material-reader__progress-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-primary-deep);
}

/* Figma 81:39：浮动工具坞。 */
.material-reader__dock {
  position: absolute;
  right: 24rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  box-sizing: border-box;
  display: flex;
  height: 128rpx;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--figma-color-line);
  border-radius: var(--radius-40);
  background: rgb(255 255 255 / 98%);
  box-shadow: var(--shadow-elevated);
}

/* Figma 81:40：52×50 工具，字形 + 8.5px 标签。 */
.material-reader__dock-tool {
  box-sizing: border-box;
  display: flex;
  width: 104rpx;
  min-width: 104rpx;
  height: 100rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--radius-32);
  color: var(--color-ink-secondary);
  background: transparent;
}

.material-reader__dock-tool--active {
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.material-reader__dock-glyph {
  font-size: var(--text-section);
  font-weight: 600;
  line-height: 36rpx;
}

.material-reader__dock-label {
  font-size: var(--text-micro);
  font-weight: 600;
  line-height: 26rpx;
}

/* Figma 88:2：深色「回到第 N 题」。 */
.material-reader__dock-return {
  box-sizing: border-box;
  display: flex;
  height: 92rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: var(--radius-48);
  color: var(--figma-color-on-dark);
  background: var(--ink);
  font-size: var(--text-body);
  font-weight: 600;
  white-space: nowrap;
}
