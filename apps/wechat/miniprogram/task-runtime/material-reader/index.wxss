@import "../../design-system/primitives/interaction.wxss";

.material-reader__inline {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border: 1rpx solid var(--color-line);
  border-radius: var(--figma-radius-card);
  background: var(--color-surface);
}

.material-reader__inline--eye_care {
  background: var(--good-soft);
}

.material-reader__inline-header {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 20rpx 14rpx 24rpx;
  border-bottom: 1rpx solid var(--color-line);
  text-align: left;
}

.material-reader__inline-heading {
  min-width: 0;
}

.material-reader__inline-kicker {
  color: var(--color-primary);
  font-size: 19rpx;
  font-weight: 760;
  line-height: 28rpx;
}

.material-reader__inline-expand {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 50%;
  background: var(--color-surface-soft);
}

.material-reader__inline-expand::after,
.material-reader__header-action::after,
.material-reader__tool::after,
.material-reader__eye-care::after {
  border: 0;
}

.material-reader__inline-chevron {
  width: 16rpx;
  height: 16rpx;
  transform: rotate(45deg);
  border-top: 3rpx solid var(--color-muted);
  border-left: 3rpx solid var(--color-muted);
  border-radius: 2rpx;
}

.material-reader__entry-title {
  overflow: hidden;
  margin-top: 2rpx;
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-reader__position {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.material-reader__inline-scroll {
  height: min(560rpx, 42vh);
}

.material-reader__inline-content {
  box-sizing: border-box;
  padding: 24rpx;
}

.material-reader__backdrop {
  position: fixed;
  z-index: var(--z-overlay);
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--color-mask);
}

.material-reader__backdrop--drawer,
.material-reader__backdrop--fullscreen {
  top: 0;
}

.material-reader__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  overflow: hidden;
  flex-direction: column;
  background: var(--color-canvas);
  color: var(--color-ink);
}

.material-reader__panel--drawer {
  height: 72vh;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: var(--shadow-reader);
}

.material-reader__panel--fullscreen {
  top: 0;
  height: 100vh;
}

.material-reader__panel--eye_care {
  background: var(--color-line-strong);
}

.material-reader__grabber {
  flex: none;
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 4rpx;
  border-radius: 999rpx;
  background: var(--color-line-strong);
}

.material-reader__header {
  display: flex;
  flex: none;
  min-height: 84rpx;
  padding: 10rpx 22rpx 14rpx 28rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid var(--color-line);
}

.material-reader__heading {
  flex: 1;
  min-width: 0;
}

.material-reader__title {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-reader__header-action,
.material-reader__tool,
.material-reader__eye-care {
  min-height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--color-primary-a08);
  color: var(--color-primary);
  font-size: 21rpx;
  line-height: 56rpx;
}

.material-reader__toolbar {
  display: flex;
  flex: none;
  overflow-x: auto;
  padding: 12rpx 20rpx;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid var(--color-line);
  background: var(--color-surface-a74);
}

.material-reader__panel--eye_care .material-reader__toolbar {
  background: var(--color-surface-soft-a82);
}

.material-reader__tool-group {
  display: flex;
  flex: none;
  align-items: center;
  gap: 6rpx;
}

.material-reader__tool {
  width: 56rpx;
  padding: 0;
}

.material-reader__tool-value {
  min-width: 72rpx;
  color: var(--color-muted);
  font-family: var(--font-family-data, monospace);
  font-size: 19rpx;
  text-align: center;
}

.material-reader__eye-care {
  flex: none;
}

.material-reader__eye-care--active {
  background: var(--good-soft);
  color: var(--good);
  font-weight: 700;
}

.material-reader__scroll {
  flex: 1;
  min-height: 0;
}

.material-reader__scroll--drawer {
  height: calc(72vh - 190rpx - env(safe-area-inset-bottom));
}

.material-reader__scroll--fullscreen {
  height: calc(100vh - 190rpx - env(safe-area-inset-bottom));
}

.material-reader__content {
  padding: 28rpx var(--space-page-x, 28rpx) calc(48rpx + env(safe-area-inset-bottom));
}
