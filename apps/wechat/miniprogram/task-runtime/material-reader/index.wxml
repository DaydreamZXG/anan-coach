<view class="material-reader">
  <button
    wx:if="{{readerMode === 'question_first'}}"
    class="material-reader__entry"
    bindtap="openDrawer"
  >
    <view>
      <view class="material-reader__entry-title">{{title}}</view>
      <view class="material-reader__entry-meta">从上次位置继续 · {{zoomPercent}}%</view>
    </view>
    <text class="material-reader__entry-action">查看材料</text>
  </button>

  <view hover-class="item--hover"
    wx:else
    class="material-reader__backdrop material-reader__backdrop--{{readerMode}}"
    catchtap="returnToQuestion"
  >
    <view hover-class="item--hover"
      class="material-reader__panel material-reader__panel--{{readerMode}} material-reader__panel--{{preferences.colorMode}}"
      catchtap="stopPropagation"
    >
      <view class="material-reader__grabber"></view>
      <view class="material-reader__header">
        <view class="material-reader__heading">
          <view class="material-reader__title">{{title}}</view>
          <view class="material-reader__position">位置已记录 · {{zoomPercent}}%</view>
        </view>
        <button
          wx:if="{{readerMode === 'drawer'}}"
          class="material-reader__header-action"
          bindtap="openFullscreen"
        >
          全屏
        </button>
        <button
          wx:else
          class="material-reader__header-action"
          bindtap="openDrawer"
        >
          收起
        </button>
        <button class="material-reader__header-action" bindtap="returnToQuestion">回到题目</button>
      </view>

      <view class="material-reader__toolbar">
        <view class="material-reader__tool-group">
          <button class="material-reader__tool" aria-label="缩小材料" bindtap="decreaseZoom">−</button>
          <text class="material-reader__tool-value">{{zoomPercent}}%</text>
          <button class="material-reader__tool" aria-label="放大材料" bindtap="increaseZoom">＋</button>
        </view>
        <view class="material-reader__tool-group">
          <button class="material-reader__tool" aria-label="减小字号" bindtap="decreaseFont">A−</button>
          <text class="material-reader__tool-value">{{fontPercent}}%</text>
          <button class="material-reader__tool" aria-label="增大字号" bindtap="increaseFont">A＋</button>
        </view>
        <button
          class="material-reader__eye-care {{eyeCare ? 'material-reader__eye-care--active' : ''}}"
          bindtap="toggleEyeCare"
        >
          护眼
        </button>
      </view>

      <scroll-view
        class="material-reader__scroll material-reader__scroll--{{readerMode}}"
        scroll-y
        enhanced
        show-scrollbar
        scroll-top="{{position.scrollTop}}"
        scroll-into-view="{{scrollIntoView}}"
        bindscroll="onScroll"
      >
        <view class="material-reader__content">
          <content-renderer
            blocks="{{blocks}}"
            anchors="{{anchors}}"
            zoom="{{position.zoom}}"
            preferences="{{preferences}}"
            freeze-first-column
            freeze-header
            bindanchorchange="onAnchorChange"
            bindzoomchange="onZoomChange"
          />
        </view>
      </scroll-view>
    </view>
  </view>
</view>
