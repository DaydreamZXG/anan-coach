@import "../../design-system/primitives/interaction.wxss";

.content-renderer {
  --content-ink: var(--color-ink);
  --content-muted: var(--color-muted);
  --content-line: var(--color-line);
  --content-surface: var(--color-surface);
  color: var(--content-ink);
}

.content-renderer--eye_care {
  --content-ink: var(--color-ink-secondary);
  --content-muted: var(--ink-2);
  --content-line: var(--color-line-strong);
  --content-surface: var(--color-surface-soft);
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--color-surface-soft);
}

.content-block + .content-block {
  margin-top: 28rpx;
}

.content-paragraph {
  display: block;
  color: var(--content-ink);
  font-size: calc(30rpx * var(--content-font-scale));
  line-height: 1.78;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.content-formula {
  display: flex;
  max-width: 100%;
  overflow-x: auto;
  align-items: center;
}

.content-formula--block {
  justify-content: center;
  padding: 18rpx 0;
}

.content-formula__image {
  flex: none;
  max-width: none;
}

.content-formula__expression {
  box-sizing: border-box;
  display: block;
  min-width: min-content;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: var(--color-primary-a08);
  font-family: var(--font-family-data, monospace);
  font-size: calc(25rpx * var(--content-font-scale));
  line-height: 1.55;
  white-space: nowrap;
}

.content-accessible-text {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}

.content-asset {
  overflow: hidden;
  border: 1rpx solid var(--content-line);
  border-radius: 18rpx;
  background: var(--content-surface);
}

.content-asset__image {
  display: block;
  width: 100%;
}

.content-asset__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 22rpx;
}

.content-caption {
  flex: 1;
  color: var(--content-muted);
  font-size: calc(24rpx * var(--content-font-scale));
  line-height: 1.55;
}

.content-graph .content-caption {
  padding: 18rpx 22rpx 8rpx;
}

.content-source {
  padding: 0 22rpx 18rpx;
  color: var(--content-muted);
  font-size: 20rpx;
}

.content-graph__ocr {
  margin: 0 22rpx 18rpx auto;
}

.content-link,
.content-table__zoom-button {
  min-height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--color-primary-a08);
  color: var(--color-primary);
  font-size: 22rpx;
  line-height: 56rpx;
}

.content-link::after,
.content-table__zoom-button::after {
  border: 0;
}

.content-table-card {
  border: 1rpx solid var(--content-line);
  border-radius: 18rpx;
  background: var(--content-surface);
}

.content-table__header {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 12rpx 16rpx 12rpx 22rpx;
  border-bottom: 1rpx solid var(--content-line);
}

.content-table__caption {
  flex: 1;
  font-size: calc(24rpx * var(--content-font-scale));
  font-weight: 700;
  line-height: 1.45;
}

.content-table__zoom {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.content-table__zoom-button {
  width: 56rpx;
  padding: 0;
  font-size: 28rpx;
}

.content-table__zoom-value {
  min-width: 76rpx;
  color: var(--content-muted);
  font-family: var(--font-family-data, monospace);
  font-size: 20rpx;
  text-align: center;
}

.content-table__scroll {
  width: 100%;
  max-height: 70vh;
}

.content-table__grid {
  position: relative;
  display: grid;
}

.content-table__cell {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx;
  border-right: 1rpx solid var(--content-line);
  border-bottom: 1rpx solid var(--content-line);
  background: var(--content-surface);
  font-size: calc(23rpx * var(--content-font-scale));
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.content-table__cell--header {
  background: var(--color-surface-soft);
  font-weight: 700;
}

.content-renderer--eye_care .content-table__cell--header {
  background: var(--color-line-strong);
}

.content-table__cell--frozen-column {
  position: sticky;
  z-index: 3;
  left: var(--content-sticky-left);
  box-shadow: 8rpx 0 12rpx var(--color-surface-soft);
}

.content-table__cell--frozen-header {
  position: sticky;
  z-index: 4;
  top: var(--content-sticky-top);
  box-shadow: 0 8rpx 12rpx var(--color-surface-soft);
}

.content-table__cell--frozen-column.content-table__cell--frozen-header {
  z-index: 5;
}
