@import "../../design-system/primitives/interaction.wxss";

.content-renderer {
  --content-ink: var(--color-ink);
  --content-muted: var(--color-muted);
  --content-line: var(--color-line);
  --content-surface: var(--color-surface);
  color: var(--content-ink);
}

.content-renderer--eye_care {
  --content-ink: var(--color-ink-secondary);
  --content-muted: var(--ink-2);
  --content-line: var(--color-line-strong);
  --content-surface: var(--color-surface-soft);
  padding: 20rpx;
  border-radius: var(--radius-24);
  background: var(--color-surface-soft);
}

.content-block + .content-block {
  margin-top: 28rpx;
}

/* Figma 81:16/81:35：沉浸阅读的段落浅灰序号。 */
.content-renderer--numbered {
  counter-reset: content-paragraph;
}

.content-renderer--numbered .content-block--paragraph {
  position: relative;
  padding-left: 32rpx;
}

.content-renderer--numbered .content-block--paragraph::before {
  position: absolute;
  top: 6rpx;
  left: 0;
  color: var(--figma-color-faint);
  content: counter(content-paragraph);
  counter-increment: content-paragraph;
  font-size: var(--text-micro);
  font-weight: 500;
  line-height: 30rpx;
}

.content-paragraph {
  display: block;
  color: var(--content-ink);
  font-size: calc(30rpx * var(--content-font-scale));
  /* 行距档位（Figma 81:43）作用于正文段落。 */
  line-height: calc(1.78 * var(--content-line-spacing, 1));
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  /* 选项等短文本由宿主设 --content-text-wrap: balance 消除孤行；不支持的内核自动回退。 */
  text-wrap: var(--content-text-wrap, wrap);
}

/* Figma 84:156：画词选中片段的青色高亮。 */
.content-segment--selected {
  border-radius: var(--radius-12);
  background: rgb(0 184 219 / 18%);
}

.content-formula {
  display: flex;
  max-width: 100%;
  overflow-x: auto;
  align-items: center;
}

.content-formula--block {
  justify-content: center;
  padding: 20rpx 0;
}

.content-formula__image {
  flex: none;
  max-width: none;
}

.content-formula__expression {
  box-sizing: border-box;
  display: block;
  min-width: min-content;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-12);
  background: var(--color-primary-a08);
  font-family: var(--font-family-data, monospace);
  font-size: calc(25rpx * var(--content-font-scale));
  line-height: 1.55;
  white-space: nowrap;
}

.content-accessible-text {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}

.content-asset {
  overflow: hidden;
  border: 1rpx solid var(--content-line);
  border-radius: var(--radius-16);
  background: var(--content-surface);
}

.content-asset__image {
  display: block;
  width: 100%;
}

.content-asset__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.content-caption {
  flex: 1;
  color: var(--content-muted);
  font-size: calc(24rpx * var(--content-font-scale));
  line-height: 1.55;
}

.content-graph .content-caption {
  padding: 20rpx 24rpx 8rpx;
}

.content-source {
  padding: 0 24rpx 20rpx;
  color: var(--content-muted);
  font-size: var(--text-micro);
}

.content-graph__ocr {
  margin: 0 24rpx 20rpx auto;
}

.content-link,
.content-table__zoom-button {
  min-height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: var(--radius-12);
  background: var(--color-primary-a08);
  color: var(--color-primary);
  font-size: var(--text-micro);
  line-height: 56rpx;
}

.content-link::after,
.content-table__zoom-button::after {
  border: 0;
}

.content-table-card {
  border: 1rpx solid var(--content-line);
  border-radius: var(--radius-16);
  background: var(--content-surface);
}

.content-table__header {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 16rpx 12rpx 24rpx;
  border-bottom: 1rpx solid var(--content-line);
}

.content-table__caption {
  flex: 1;
  font-size: calc(24rpx * var(--content-font-scale));
  font-weight: 700;
  line-height: 1.45;
}

.content-table__zoom {
  display: flex;
  flex: none;
  align-items: center;
  gap: 8rpx;
}

.content-table__zoom-button {
  width: 56rpx;
  padding: 0;
  font-size: var(--text-body-lg);
}

.content-table__zoom-value {
  min-width: 76rpx;
  color: var(--content-muted);
  font-family: var(--font-family-data, monospace);
  font-size: var(--text-micro);
  text-align: center;
}

.content-table__scroll {
  width: 100%;
  max-height: 70vh;
}

.content-table__grid {
  position: relative;
  display: grid;
}

.content-table__cell {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-right: 1rpx solid var(--content-line);
  border-bottom: 1rpx solid var(--content-line);
  background: var(--content-surface);
  font-size: calc(23rpx * var(--content-font-scale));
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.content-table__cell--header {
  background: var(--color-surface-soft);
  font-weight: 700;
}

.content-renderer--eye_care .content-table__cell--header {
  background: var(--color-line-strong);
}

.content-table__cell--frozen-column {
  position: sticky;
  z-index: 3;
  left: var(--content-sticky-left);
  box-shadow: 8rpx 0 12rpx var(--color-surface-soft);
}

.content-table__cell--frozen-header {
  position: sticky;
  z-index: 4;
  top: var(--content-sticky-top);
  box-shadow: 0 8rpx 12rpx var(--color-surface-soft);
}

.content-table__cell--frozen-column.content-table__cell--frozen-header {
  z-index: 5;
}
