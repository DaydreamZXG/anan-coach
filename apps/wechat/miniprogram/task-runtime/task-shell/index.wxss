.task-shell {
  --task-toolbar-surface: rgba(255, 255, 255, 0.92);
  --task-toolbar-control: #f0f3f2;
  --task-toolbar-line: #dde6e3;
  --task-toolbar-ink: #354541;
  --task-toolbar-brand: #00978b;
  --task-toolbar-brand-soft: #e7f7f3;
  box-sizing: border-box;
  min-height: 100vh;
  padding: calc(16rpx + env(safe-area-inset-top)) var(--space-page-x) 150rpx;
  background: var(--color-canvas);
}

.task-shell--no-footer {
  padding-bottom: 56rpx;
}

.task-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin: 0 calc(var(--space-page-x) * -1);
  padding: 18rpx var(--space-page-x);
  background: var(--task-toolbar-surface);
  box-shadow: 0 20rpx 68rpx rgba(32, 67, 58, 0.08);
}

.task-header-actions {
  display: flex;
  flex: 0 1 auto;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.task-header-button,
.task-question-control,
.task-timer-control,
.task-tool-button {
  box-sizing: border-box;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--task-toolbar-line);
  color: var(--task-toolbar-ink);
  background: var(--task-toolbar-control);
  line-height: normal;
}

.task-header-button::after,
.task-question-control::after,
.task-timer-control::after,
.task-tool-button::after {
  border: 0;
}

.task-header-button {
  display: flex;
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.task-header-button--back {
  flex: none;
  border: 0;
  border-radius: 24rpx;
}

.task-header-button--material {
  color: var(--task-toolbar-brand);
  background: var(--task-toolbar-brand-soft);
}

.task-question-control,
.task-timer-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
}

.task-question-control {
  flex: 0 0 164rpx;
  width: 164rpx;
  min-width: 164rpx;
  max-width: 164rpx;
  height: 72rpx;
  padding: 0 10rpx;
}

.task-timer-control {
  flex: 0 0 184rpx;
  width: 184rpx;
  min-width: 184rpx;
  max-width: 184rpx;
  height: 72rpx;
  padding: 0 16rpx;
  color: var(--task-toolbar-brand);
  background: var(--task-toolbar-brand-soft);
}

.task-timer-control--paused {
  border-color: rgba(226, 165, 66, 0.42);
  color: #9b6818;
  background: #fff4df;
}

.task-timer-control--read-only {
  flex: 0 0 auto;
  width: auto;
  min-width: 132rpx;
  max-width: none;
}

.task-progress-label,
.task-timer {
  flex: none;
  font-family: var(--font-family-data);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  white-space: nowrap;
}

.task-progress-label {
  color: #17211f;
  font-size: 22rpx;
}

.task-timer {
  font-size: 24rpx;
}

.task-sync-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--task-toolbar-brand);
}

.task-sync-dot--saving {
  background: #e2a542;
}

.task-sync-dot--pending {
  background: #8a9894;
}

.task-sync-dot--error {
  background: #c94f58;
}

.task-icon {
  position: relative;
  display: block;
  flex: none;
  width: 32rpx;
  height: 32rpx;
  color: currentcolor;
}

.task-icon--back::before {
  position: absolute;
  top: 8rpx;
  left: 10rpx;
  width: 14rpx;
  height: 14rpx;
  transform: rotate(45deg);
  border-bottom: 3rpx solid currentcolor;
  border-left: 3rpx solid currentcolor;
  border-radius: 2rpx;
  content: "";
}

.task-icon--material {
  box-sizing: border-box;
  border: 3rpx solid currentcolor;
  border-radius: 7rpx;
}

.task-icon-material-line {
  position: absolute;
  left: 7rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentcolor;
}

.task-icon-material-line--one {
  top: 8rpx;
  width: 16rpx;
}

.task-icon-material-line--two {
  top: 14rpx;
  width: 16rpx;
}

.task-icon-material-line--three {
  top: 20rpx;
  width: 11rpx;
}

.task-icon--grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5rpx;
}

.task-icon--grid .task-icon__shape {
  box-sizing: border-box;
  border: 3rpx solid currentcolor;
  border-radius: 4rpx;
}

.task-icon-draft-pencil {
  position: absolute;
  top: 5rpx;
  left: 14rpx;
  width: 7rpx;
  height: 23rpx;
  transform: rotate(45deg);
  border: 3rpx solid currentcolor;
  border-radius: 4rpx;
}

.task-icon-draft-line {
  position: absolute;
  right: 2rpx;
  bottom: 3rpx;
  left: 2rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentcolor;
}

.task-icon--pause {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
}

.task-icon--pause .task-icon__shape {
  width: 3rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: currentcolor;
}

.task-icon--play::before {
  position: absolute;
  top: 5rpx;
  left: 9rpx;
  width: 0;
  height: 0;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 17rpx solid currentcolor;
  content: "";
}

.task-content {
  min-height: 520rpx;
  padding-top: 30rpx;
}

.task-footer {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx var(--space-page-x) calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-line);
  background: var(--color-surface-glass);
  box-shadow: 0 -12rpx 36rpx rgba(32, 67, 58, 0.08);
}

.task-tool-button {
  flex: none;
  width: 84rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-compact);
  color: var(--color-muted);
  background: var(--color-surface);
  font-size: 22rpx;
  line-height: 68rpx;
}

.task-footer-main {
  flex: 1;
  min-width: 0;
}

@media (min-width: 768px) {
  .task-shell {
    width: 100%;
    max-width: var(--layout-workbench-max);
    margin: 0 auto;
    padding: calc(12px + env(safe-area-inset-top)) var(--layout-tablet-gutter) 104px;
  }

  .task-shell--no-footer {
    padding-bottom: 40px;
  }

  .task-header {
    min-height: 48px;
    margin: 0 calc(var(--layout-tablet-gutter) * -1);
    padding: 10px var(--layout-tablet-gutter);
    box-shadow: 0 10px 32px rgba(32, 67, 58, 0.08);
  }

  .task-header-actions {
    gap: 6px;
  }

  .task-header-button,
  .task-question-control,
  .task-timer-control,
  .task-tool-button {
    min-height: 48px;
    border-width: 1px;
  }

  .task-header-button {
    flex-basis: 48px;
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    height: 48px;
  }

  .task-header-button--back {
    border-radius: 14px;
  }

  .task-question-control {
    flex-basis: 112px;
    width: 112px;
    min-width: 112px;
    max-width: 112px;
    height: 48px;
    padding: 0 8px;
  }

  .task-timer-control {
    flex-basis: 128px;
    width: 128px;
    min-width: 128px;
    max-width: 128px;
    height: 48px;
    padding: 0 10px;
  }

  .task-timer-control--read-only {
    width: auto;
    min-width: 92px;
  }

  .task-progress-label {
    font-size: 14px;
  }

  .task-timer {
    font-size: 15px;
  }

  .task-sync-dot {
    width: 6px;
    height: 6px;
  }

  .task-icon {
    width: 22px;
    height: 22px;
  }

  .task-icon--back::before {
    top: 5px;
    left: 7px;
    width: 10px;
    height: 10px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .task-icon--material {
    border-width: 2px;
    border-radius: 4px;
  }

  .task-icon-material-line {
    left: 5px;
    height: 2px;
  }

  .task-icon-material-line--one {
    top: 5px;
    width: 10px;
  }

  .task-icon-material-line--two {
    top: 9px;
    width: 10px;
  }

  .task-icon-material-line--three {
    top: 13px;
    width: 7px;
  }

  .task-icon--grid {
    gap: 3px;
  }

  .task-icon--grid .task-icon__shape {
    border-width: 2px;
    border-radius: 3px;
  }

  .task-icon-draft-pencil {
    top: 3px;
    left: 9px;
    width: 5px;
    height: 16px;
    border-width: 2px;
    border-radius: 3px;
  }

  .task-icon-draft-line {
    height: 2px;
  }

  .task-icon--pause {
    gap: 4px;
  }

  .task-icon--pause .task-icon__shape {
    width: 2px;
    height: 15px;
  }

  .task-icon--play::before {
    top: 4px;
    left: 7px;
    border-top-width: 7px;
    border-bottom-width: 7px;
    border-left-width: 11px;
  }

  .task-content {
    min-height: 420px;
    padding-top: 24px;
  }

  .task-footer {
    right: auto;
    left: 50%;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--layout-workbench-max);
    gap: 14px;
    padding: 12px var(--layout-tablet-gutter) calc(12px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
  }

  .task-tool-button {
    width: 64px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 46px;
  }
}

@media (min-width: 1024px) {
  .task-shell {
    padding-right: var(--layout-wide-gutter);
    padding-left: var(--layout-wide-gutter);
  }

  .task-header {
    margin-right: calc(var(--layout-wide-gutter) * -1);
    margin-left: calc(var(--layout-wide-gutter) * -1);
    padding-right: var(--layout-wide-gutter);
    padding-left: var(--layout-wide-gutter);
  }

  .task-footer {
    padding-right: var(--layout-wide-gutter);
    padding-left: var(--layout-wide-gutter);
  }
}
