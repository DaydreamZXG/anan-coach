{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "vitest/globals"],
    "lib": ["ES2022"]
  },
  "include": ["miniprogram/**/*.ts", "tests/**/*.ts"]
}
