{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "zhus-d3gkwjeltb8e1ffd7",
  "region": "ap-shanghai",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "hunyuan-essay-grader",
      "description": "Closed Hunyuan candidate transport; learner scoring activation is separately governed",
      "type": "Event",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 120,
      "memorySize": 512,
      "installDependency": true,
      "isWaitInstall": true,
      "ignore": ["node_modules", "node_modules/**/*", "runtime.test.js"],
      "envVariables": {
        "HUNYUAN_PROVIDER": "hunyuan-exp",
        "HUNYUAN_MODEL": "hunyuan-2.0-instruct-20251111",
        "HUNYUAN_MAX_INPUT_BYTES": "196608",
        "HUNYUAN_MAX_OUTPUT_BYTES": "262144"
      }
    }
  ]
}
