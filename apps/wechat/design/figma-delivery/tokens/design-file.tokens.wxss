  --figma-color-device-frame: #111827;
  --figma-color-on-dark: #ffffff;

  --figma-gradient-ai: linear-gradient(135deg, #615fff 0%, #ad46ff 50%, #f6339a 100%);
  --figma-gradient-dark: linear-gradient(127.42deg, #1e2939 0%, #101828 100%);
  --figma-gradient-login-halo-top: linear-gradient(
