    135deg,
    rgba(190, 219, 255, 0.4) 0%,
    rgba(150, 247, 228, 0.4) 100%
  );

  --figma-space-2: 4rpx;
  --figma-space-4: 8rpx;
  --figma-space-6: 12rpx;
  --figma-space-8: 16rpx;
  --figma-space-10: 20rpx;
  --figma-space-12: 24rpx;
  --figma-space-16: 32rpx;
  --figma-space-20: 40rpx;
  --figma-space-24: 48rpx;
  --figma-space-32: 64rpx;
  --figma-space-40: 80rpx;
  --figma-space-48: 96rpx;

  --figma-page-inset: 40rpx;
  --figma-card-padding: 48rpx;
  --figma-card-padding-compact: 32rpx;
  --figma-section-gap: 48rpx;
  --figma-content-gap: 40rpx;
  --figma-status-bar-height: 90rpx;
  --figma-bottom-navigation-height: 180rpx;

  --figma-radius-device-outer: 112rpx;
  --figma-radius-device-inner: 96rpx;
  --figma-radius-card-xlarge: 72rpx;
  --figma-radius-card-large: 64rpx;
  --figma-radius-card-medium: 60rpx;
  --figma-radius-card: 48rpx;
