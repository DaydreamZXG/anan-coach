  --figma-radius-compact: 32rpx;
  --figma-radius-small: 24rpx;
  --figma-radius-xsmall: 16rpx;
  --figma-radius-pill: 9999px;

  --figma-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial,
    sans-serif;
  --figma-font-display: 108rpx;
  --figma-font-display-compact: 72rpx;
  --figma-font-title-xlarge: 64rpx;
  --figma-font-page-title: 56rpx;
  --figma-font-hero-title: 52rpx;
  --figma-font-title-large: 48rpx;
  --figma-font-title: 40rpx;
  --figma-font-title-small: 36rpx;
  --figma-font-body-large: 32rpx;
  --figma-font-body: 28rpx;
  --figma-font-body-compact: 26rpx;
  --figma-font-caption: 24rpx;
  --figma-font-micro: 22rpx;
  --figma-font-tab: 20rpx;
  --figma-font-minimum: 18rpx;

  --figma-shadow-surface: 0 8rpx 20rpx rgba(0, 0, 0, 0.02);
  --figma-shadow-card: 0 16rpx 30rpx rgba(0, 0, 0, 0.04);
  --figma-shadow-elevated: 0 16rpx 30rpx rgba(0, 0, 0, 0.12);
  --figma-shadow-card-strong: 0 16rpx 60rpx rgba(0, 0, 0, 0.06);
  --figma-shadow-device: 0 120rpx 240rpx rgba(0, 0, 0, 0.2);
