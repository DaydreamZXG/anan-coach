  --figma-color-primary: #615fff;
  --figma-color-primary-deep: #4f39f6;
  --figma-color-primary-bright: #7c86ff;
  --figma-color-primary-soft: #eef2ff;
  --figma-color-primary-soft-strong: #e0e7ff;
  --figma-color-ai-violet: #ad46ff;
  --figma-color-ai-pink: #f6339a;

  --figma-color-cyan: #00d3f3;
  --figma-color-cyan-deep: #00b8db;
  --figma-color-cyan-dark: #0092b8;
  --figma-color-cyan-soft: #ecfeff;
  --figma-color-cyan-soft-strong: #cefafe;
  --figma-color-warning: #ff6900;
  --figma-color-warning-deep: #f54900;
  --figma-color-warning-soft: #fff7ed;
  --figma-color-success: #00a63e;
  --figma-color-success-bright: #00c950;
  --figma-color-success-soft: #f0fdf4;
  --figma-color-danger: #fb2c36;
